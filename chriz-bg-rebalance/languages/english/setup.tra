// chriz-bg-rebalance — English

// Component names (match DESIGNATED numbers)
@100 = ~SCS: Telekinetic Storm — restore save vs. spell for half damage (+ bypass Mirror Image)~
@101 = ~SCS: Adventurer's Mart — restore the five Freedom scrolls (spell tweak orphaned in v35)~
@400 = ~Cleric of Tempus: weapon training — axe, longsword, crossbow, and two-pip mastery~
@401 = ~Cleric of Tempus: Holy Power — automatic semantic detection (recommended)~
@402 = ~Cleric of Tempus: Holy Power — force true-doubling compatibility~
@403 = ~Cleric of Tempus: Holy Power — force additive compatibility~
@404 = ~Cleric of Tempus: Chaos of Battle — one announced battle tide per cast~
@405 = ~Cleric of Tempus: Divination toll — Tempus grants no future sight~

// Component groups
@1100 = ~SCS adjustments~
@1200 = ~Spell Revisions adjustments~
@1300 = ~Cross-cutting audits~
@1400 = ~Class and kit revisions~
@1401 = ~Cleric of Tempus: Holy Power compatibility~

// Game-facing strings (component 404 announce lines; the only TLK additions
// this mod makes)
@4041 = ~Tide of Battle: Onslaught!~
@4042 = ~Tide of Battle: Bulwark!~
@4043 = ~Tide of Battle: Fortune!~

