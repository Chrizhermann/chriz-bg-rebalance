@110 = ~EEex + SCS: Apex Dragons — lethal claws and bites (can cause permanent death)~
@111 = ~SCS: five dragon encounters — wing buffet at most once per 18 seconds~
@120 = ~SCS + Spell Revisions: repair false weapon-protection semantics~
@121 = ~EEex + SCS: ambient caster readiness and one honest first-contact defense~
