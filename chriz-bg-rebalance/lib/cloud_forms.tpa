// Component 320 owns the combat forms' damage-resistance packages and MR,
// and the private combat-mist donor/link. Other mechanics, poison, regeneration,
// normal creatures and death/quest escapes remain outside this component.
// Profiles are the documented provider outputs, not tests of installed values.
DEFINE_PATCH_MACRO cbr_cloud_layout
BEGIN
  SET cf_readable = BUFFER_LENGTH >= 0x72
  PATCH_IF cf_readable BEGIN
    READ_LONG 0x64 cf_ab
    READ_SHORT 0x68 cf_nab
    READ_LONG 0x6a cf_fx
    READ_SHORT 0x6e cf_first
    READ_SHORT 0x70 cf_count
    SET cf_total = cf_first + cf_count
    SET cf_readable = (cf_nab = 0 OR (cf_ab >= 0x72
      AND cf_ab + cf_nab * cf_kind <= BUFFER_LENGTH))
    FOR (cf_h = 0; cf_readable AND cf_h < cf_nab; ++cf_h) BEGIN
      READ_SHORT (cf_ab + cf_h * cf_kind + 0x1e) cf_n
      READ_SHORT (cf_ab + cf_h * cf_kind + 0x20) cf_i
      SET cf_total = (cf_total > cf_i + cf_n ? cf_total : cf_i + cf_n)
    END
    SET cf_readable = cf_readable AND (cf_total = 0 OR (cf_fx >= 0x72
      AND cf_fx + cf_total * 0x30 <= BUFFER_LENGTH))
    PATCH_IF cf_readable AND cf_total > 0 AND cf_nab > 0 BEGIN
      SET cf_readable = cf_fx + cf_total * 0x30 <= cf_ab
        OR cf_fx >= cf_ab + cf_nab * cf_kind
    END
  END
END

// The current buffer is one effect slice. Keep foreign effects in their order,
// replace owned records at their first position, and supply missing records.
DEFINE_PATCH_MACRO cbr_cloud_slice
BEGIN
  PATCH_CLEAR_ARRAY cf_seen
  PATCH_PHP_EACH cf_value AS cf_op => cf_unused BEGIN SET $cf_seen(~%cf_op%~) = 0 END
  SET cf_slice_size = BUFFER_LENGTH
  FOR (cf_at = 0; cf_at < cf_slice_size; cf_at += 0x30) BEGIN
    READ_SHORT cf_at cf_op
    READ_LONG (cf_at + 8) cf_p2
    SET cf_owned = (cf_op >= 27 AND cf_op <= 31) OR (cf_op >= 84 AND cf_op <= 89)
      OR cf_op = 166 OR cf_op = 208 OR cf_op = 120 OR (cf_op = 101 AND cf_p2 = 12)
      OR (cf_vampire AND cf_op = 135)
    PATCH_IF cf_owned BEGIN
      PATCH_IF cf_deliver AND VARIABLE_IS_SET $cf_value(~%cf_op%~)
        AND $cf_value(~%cf_op%~) >= 0 AND $cf_seen(~%cf_op%~) = 0 BEGIN
        SET $cf_seen(~%cf_op%~) = 1
        LPM cbr_cloud_write_effect
      END ELSE BEGIN
        DELETE_BYTES cf_at 0x30
        SET cf_slice_size -= 0x30
        SET cf_at -= 0x30
      END
    END
  END
  PATCH_IF cf_deliver BEGIN
    PATCH_PHP_EACH cf_value AS cf_op => cf_unused BEGIN
      PATCH_IF $cf_value(~%cf_op%~) >= 0 AND $cf_seen(~%cf_op%~) = 0 BEGIN
        SET cf_at = cf_slice_size
        INSERT_BYTES cf_at 0x30
        SET cf_slice_size += 0x30
        LPM cbr_cloud_write_effect
      END
    END
  END
END

DEFINE_PATCH_MACRO cbr_cloud_write_effect
BEGIN
  // All delivery fields of the owned package are authored, including saves,
  // probability and duration. Changed or duplicate donor effects cannot gate it.
  FOR (cf_zero = 0; cf_zero < 0x30; cf_zero += 4) BEGIN WRITE_LONG (cf_at + cf_zero) 0 END
  WRITE_SHORT cf_at cf_op
  WRITE_BYTE (cf_at + 2) 1
  WRITE_LONG (cf_at + 4) $cf_value(~%cf_op%~)
  WRITE_LONG (cf_at + 8) (cf_op = 166 ? cf_mr_mode : (cf_op = 135 ? 0 : 1))
  WRITE_BYTE (cf_at + 12) (cf_kind = 56 ? 2 : 0)
  WRITE_LONG (cf_at + 14) cf_duration
  WRITE_BYTE (cf_at + 18) 100
  PATCH_IF cf_op = 135 BEGIN WRITE_ASCII (cf_at + 20) ~CBRGAS75~ #8 END
END

DEFINE_PATCH_FUNCTION cbr_cloud_patch_effects
  STR_VAR profile = ~~
  RET cf_readable
BEGIN
  SET cf_kind = 40
  SET cf_duration = 18
  SET cf_mr_mode = 0
  SET cf_vampire = (~%profile%~ STRING_EQUAL_CASE ~DW#VMGAS~)
  PATCH_IF (~%profile%~ STRING_EQUAL_CASE ~DVGASFRM~)
    OR (~%profile%~ STRING_EQUAL_CASE ~FINBODGF~) BEGIN
    SET cf_kind = 56 SET cf_duration = 0
  END
  PATCH_IF (~%profile%~ STRING_EQUAL_CASE ~OHGASFRM~) BEGIN SET cf_duration = 20 END
  PATCH_CLEAR_ARRAY cf_value
  PATCH_FOR_EACH cf_op IN 27 28 29 30 31 84 85 86 87 88 89 135 166 BEGIN SET $cf_value(~%cf_op%~) = (0 - 1) END
  PATCH_IF cf_vampire BEGIN
    SET $cf_value(~135~) = 0
  END ELSE BEGIN
    PATCH_FOR_EACH cf_op IN 27 28 31 86 87 88 89 BEGIN SET $cf_value(~%cf_op%~) = 75 END
    PATCH_IF cf_kind = 56 BEGIN
      SET $cf_value(~29~) = 75 SET $cf_value(~30~) = 75 SET $cf_value(~166~) = 0
    END ELSE BEGIN
      // These EE combat spells leave fire/electricity open. Do not add channels
      // to them merely because some other provider's cloud covers those types.
      SET $cf_value(~85~) = 75
    END
    PATCH_IF (~%profile%~ STRING_EQUAL_CASE ~FINBODGF~) BEGIN
      SET $cf_value(~30~) = 50 SET $cf_value(~84~) = 50 SET $cf_value(~85~) = 75
      SET cf_mr_mode = 1
    END
  END
  LPM cbr_cloud_layout
  PATCH_IF cf_readable BEGIN
    SPRINT cf_global ~~
    PATCH_IF cf_count > 0 BEGIN READ_ASCII (cf_fx + cf_first * 0x30) cf_global (cf_count * 0x30) END
    FOR (cf_h = 0; cf_h < cf_nab; ++cf_h) BEGIN
      READ_ASCII (cf_ab + cf_h * cf_kind) $cf_header(~%cf_h%~) (cf_kind)
      READ_SHORT (cf_ab + cf_h * cf_kind + 0x1e) cf_n
      READ_SHORT (cf_ab + cf_h * cf_kind + 0x20) cf_i
      SPRINT $cf_effects(~%cf_h%~) ~~
      PATCH_IF cf_n > 0 BEGIN
        READ_ASCII (cf_fx + cf_i * 0x30) $cf_effects(~%cf_h%~) (cf_n * 0x30)
      END
    END
    PATCH_IF cf_kind = 40 AND cf_nab = 0 BEGIN
      SET cf_nab = 1
      INNER_PATCH_SAVE $cf_header(~0~) ~~ BEGIN
        INSERT_BYTES 0 0x28 WRITE_BYTE 0 1 WRITE_BYTE 0x0c 1 WRITE_BYTE 0x0d 1
        WRITE_SHORT 0x10 1 WRITE_SHORT 0x26 1
      END
      SPRINT $cf_effects(~0~) ~~
    END
    DELETE_BYTES 0x72 (BUFFER_LENGTH - 0x72)
    INSERT_BYTES 0x72 (cf_nab * cf_kind)
    PATCH_IF cf_kind = 56 BEGIN WRITE_ASCII 0 ~ITM V1  ~ #8 END
    ELSE BEGIN WRITE_ASCII 0 ~SPL V1  ~ #8 END
    WRITE_LONG 0x64 0x72 WRITE_SHORT 0x68 cf_nab
    SET cf_fx = BUFFER_LENGTH
    WRITE_LONG 0x6a cf_fx WRITE_SHORT 0x6e 0
    SET cf_deliver = cf_kind = 56
    INNER_PATCH_SAVE cf_global ~%cf_global%~ BEGIN
      LPM cbr_cloud_slice SET cf_bytes = cf_slice_size
    END
    INSERT_BYTES cf_fx cf_bytes WRITE_ASCIIE cf_fx ~%cf_global%~ (cf_bytes)
    SET cf_out = cf_bytes / 0x30 WRITE_SHORT 0x70 cf_out
    FOR (cf_h = 0; cf_h < cf_nab; ++cf_h) BEGIN
      SET cf_at_header = 0x72 + cf_h * cf_kind
      SPRINT cf_raw $cf_header(~%cf_h%~)
      WRITE_ASCIIE cf_at_header ~%cf_raw%~ (cf_kind)
      SPRINT cf_raw $cf_effects(~%cf_h%~)
      SET cf_deliver = cf_kind = 40
      INNER_PATCH_SAVE cf_raw ~%cf_raw%~ BEGIN
        LPM cbr_cloud_slice SET cf_bytes = cf_slice_size
      END
      SET cf_dest = cf_fx + cf_out * 0x30 INSERT_BYTES cf_dest cf_bytes
      WRITE_ASCIIE cf_dest ~%cf_raw%~ (cf_bytes)
      WRITE_SHORT (cf_at_header + 0x1e) (cf_bytes / 0x30)
      WRITE_SHORT (cf_at_header + 0x20) cf_out
      SET cf_out += cf_bytes / 0x30
    END
  END ELSE BEGIN
    PATCH_PRINT ~Cloud forms: %SOURCE_FILE% has unreadable tables; leaving this file unchanged.~
  END
END

DEFINE_PATCH_FUNCTION cbr_cloud_donor
  RET cf_readable
BEGIN
  SET cf_readable = BUFFER_LENGTH >= 0x2d4
  PATCH_IF cf_readable BEGIN
    READ_BYTE 0x33 cf_effver
    READ_LONG 0x2c4 cf_effoff
    READ_LONG 0x2c8 cf_effcount
    SET cf_stride = (cf_effver = 0 ? 48 : 264)
    SET cf_readable = cf_effcount = 0 OR (cf_effoff >= 0x2d4
      AND cf_effoff + cf_effcount * cf_stride <= BUFFER_LENGTH)
  END
  PATCH_IF cf_readable BEGIN
    WRITE_ASCII 0 ~CRE V1.0~ #8
    FOR (cf_at = 0x59; cf_at <= 0x63; ++cf_at) BEGIN WRITE_BYTE cf_at (cf_at = 0x5d ? 0 : 75) END
    // The private donor's header supplies resistance. Remove competing defense
    // effects there, preserving poison, scripts, inventory and other CRE fields.
    FOR (cf_i = cf_effcount - 1; cf_i >= 0; --cf_i) BEGIN
      SET cf_at = cf_effoff + cf_i * cf_stride
      PATCH_IF cf_effver = 0 BEGIN
        READ_SHORT cf_at cf_op READ_LONG (cf_at + 8) cf_p2
      END ELSE BEGIN
        READ_LONG (cf_at + 8) cf_op READ_LONG (cf_at + 24) cf_p2
      END
      PATCH_IF (cf_op >= 27 AND cf_op <= 31) OR (cf_op >= 84 AND cf_op <= 89)
        OR cf_op = 166 OR cf_op = 208 OR cf_op = 120 OR (cf_op = 101 AND cf_p2 = 12) BEGIN
        DELETE_BYTES cf_at cf_stride
        SET cf_effcount -= 1
        PATCH_FOR_EACH cf_ptr IN 0x2a0 0x2a8 0x2b0 0x2b8 0x2bc BEGIN
          READ_LONG cf_ptr cf_offset
          PATCH_IF cf_offset > cf_at BEGIN WRITE_LONG cf_ptr (cf_offset - cf_stride) END
        END
      END
    END
    WRITE_LONG 0x2c8 cf_effcount
  END ELSE BEGIN
    PATCH_PRINT ~Cloud forms: %SOURCE_FILE% has unreadable creature tables; leaving the combat-mist branch unchanged.~
  END
END

DEFINE_ACTION_FUNCTION cbr_cloud_descriptions
BEGIN
  // Complete English SR output, from arcane.tra @750 / @752 with the existing
  // cloud sentence change. No installed text is read or matched.
  OUTER_SPRINT cf_efreet_text ~Summon Efreeti
Level: 7
School: Conjuration
Range: Long
Duration: 8 rounds + 1 round/level
Casting Time: 1 round
Area of Effect: Special
Saving Throw: None

With this spell, the conjurer can cajole an efreeti, a massive genie with powerful abilities, to leave the Elemental Plane of Fire and enter the Prime Material Plane. The gated genie is immune to Banishment and has access to several spell-like abilities which can be cast instantly as a 10th level caster. Once per day an efreeti can turn into gaseous form, becoming 75% resistant to physical, elemental and magic damage while retaining poison immunity for a short time. The genie will generally use this ability when badly injured, to either regenerate before attacking again, or to leave the battlefield avoiding further damage. The efreeti will serve for the duration indicated above, attacking the enemies of the conjurer until the duration of the spell runs out.

Efreeti (10 Hit Dice):
STR 19, DEX 17, CON 16, INT 13, WIS 14, CHA 15; AL Lawful Evil
HP 98, AC 1, THAC0 5, Saving Throws 8/11/8/11/11
2 Attacks Per Round, 1d8+10 Slashing +1d6 Fire Damage (Scimitar +2)

Special Qualities:
Fire Resistance 100%

Memorized Spells:
1. Burning Hands, Magic Missile (x2), Shield
2. Agannazar's Scorcher, Invisibility (x2)
3. Fireball (x3)
4. Fire Shield (x2)
5. Conjure Lesser Fire Elemental~
  OUTER_SPRINT cf_djinni_text ~Summon Djinni
Level: 7
School: Conjuration
Range: Long
Duration: 8 rounds + 1 round/level
Casting Time: 1 round
Area of Effect: Special
Saving Throw: None

With this spell, the conjurer can cajole a djinni, a massive genie with powerful abilities, to leave the Elemental Plane of Air and enter the Prime Material Plane. The gated genie is immune to Banishment and has access to several spell-like abilities which can be cast instantly as a 10th level caster. Once per day a djinni can turn into gaseous form, becoming 75% resistant to physical, elemental and magic damage while retaining poison immunity for a short time. The genie will generally use this ability when badly injured, to either regenerate before attacking again, or to leave the battlefield avoiding further damage. The djinni will serve for the duration indicated above, attacking the enemies of the conjurer until the duration of the spell runs out.

Djinni (10 Hit Dice):
STR 17, DEX 19, CON 15, INT 14, WIS 14, CHA 15; AL Chaotic Good
HP 89, AC 0, THAC0 7, Saving Throws 11/7/11/7/7
3 Attacks Per Round, 1d8+5 Slashing Damage (Scimitar +2)

Memorized Spells:
1. Magic Missile (x3), Shield
2. Invisibility (x2), Mirror Image
3. Haste, Lightning Bolt (x2)
4. Improved Invisibility, Minor Globe of Invulnerability
5. Conjure Lesser Air Elemental~
  ACTION_IF FILE_EXISTS_IN_GAME ~DVGASFRM.ITM~ BEGIN
    ACTION_IF ~%EE_LANGUAGE%~ STRING_EQUAL_CASE ~en_us~ BEGIN
      ACTION_IF FILE_EXISTS_IN_GAME ~SPELL.IDS~ BEGIN
        CLEAR_IDS_MAP
        ACTION_FOR_EACH cf_symbol IN ~WIZARD_SUMMON_EFREET~ ~WIZARD_SUMMON_DJINNI~ BEGIN
          OUTER_SET cf_id = IDS_OF_SYMBOL (~spell~ ~%cf_symbol%~)
          ACTION_IF cf_id >= 2000 AND cf_id <= 2999 BEGIN
            OUTER_SET cf_slot = cf_id - 2000
            OUTER_SPRINT cf_spell ~SPWI%cf_slot%~
            ACTION_IF cf_slot < 10 BEGIN OUTER_SPRINT cf_spell ~SPWI00%cf_slot%~ END
            ELSE ACTION_IF cf_slot < 100 BEGIN OUTER_SPRINT cf_spell ~SPWI0%cf_slot%~ END
            ACTION_IF FILE_EXISTS_IN_GAME ~%cf_spell%.SPL~ BEGIN
              ACTION_IF (~%cf_symbol%~ STRING_EQUAL ~WIZARD_SUMMON_EFREET~) BEGIN
                OUTER_SPRINT cf_description ~%cf_efreet_text%~
              END ELSE BEGIN OUTER_SPRINT cf_description ~%cf_djinni_text%~ END
              COPY_EXISTING ~%cf_spell%.SPL~ ~override~
                PATCH_IF BUFFER_LENGTH >= 0x54 BEGIN
                  SAY UNIDENTIFIED_DESC ~%cf_description%~
                END ELSE BEGIN PATCH_PRINT ~Cloud forms: %SOURCE_FILE% has an unreadable description field; leaving this file unchanged.~ END
              BUT_ONLY
            END ELSE BEGIN PRINT ~Cloud forms: %cf_spell%.SPL is absent; continuing.~ END
          END ELSE BEGIN PRINT ~Cloud forms: %cf_symbol% has no installed wizard identity; continuing.~ END
        END
      END ELSE BEGIN PRINT ~Cloud forms: SPELL.IDS is absent; summon descriptions have no resolved targets.~ END
    END ELSE BEGIN PRINT ~Cloud forms: no translation for this language; retaining summon descriptions.~ END
  END
END

DEFINE_ACTION_FUNCTION cbr_install_cloud_forms
BEGIN
  ACTION_FOR_EACH cf_resource IN ~DVGASFRM~ ~OHBEGASF~ ~BDGASFOR~ ~OHGASFRM~ ~FINBODGF~ BEGIN
    OUTER_SPRINT cf_ext ~SPL~
    ACTION_IF (~%cf_resource%~ STRING_EQUAL ~DVGASFRM~)
      OR (~%cf_resource%~ STRING_EQUAL ~FINBODGF~) BEGIN OUTER_SPRINT cf_ext ~ITM~ END
    ACTION_IF FILE_EXISTS_IN_GAME ~%cf_resource%.%cf_ext%~ BEGIN
      COPY_EXISTING ~%cf_resource%.%cf_ext%~ ~override~
        LPF cbr_cloud_patch_effects STR_VAR profile = EVAL ~%cf_resource%~ END
      BUT_ONLY
    END ELSE BEGIN PRINT ~Cloud forms: %cf_resource%.%cf_ext% is absent; continuing.~ END
  END
  ACTION_IF FILE_EXISTS_IN_GAME ~DW#VMGAS.SPL~ BEGIN
    ACTION_IF FILE_EXISTS_IN_GAME ~GASFORM4.CRE~ BEGIN
      OUTER_SET cf_donor_ready = 0
      COPY_EXISTING ~GASFORM4.CRE~ ~override~
        READ_ASCII 0 cf_original (BUFFER_LENGTH)
        INNER_PATCH_SAVE cf_clone ~%cf_original%~ BEGIN
          LPF cbr_cloud_donor RET cf_donor_ready = cf_readable END
        END
      BUT_ONLY
      ACTION_IF cf_donor_ready BEGIN
        // This namespace belongs to the component. Replace any previous copy.
        COPY_EXISTING ~GASFORM4.CRE~ ~override/CBRGAS75.CRE~
          DELETE_BYTES 0 BUFFER_LENGTH
          INSERT_BYTES 0 (STRING_LENGTH ~%cf_clone%~)
          WRITE_ASCIIE 0 ~%cf_clone%~ (STRING_LENGTH ~%cf_clone%~)
        COPY_EXISTING ~DW#VMGAS.SPL~ ~override~
          LPF cbr_cloud_patch_effects STR_VAR profile = ~DW#VMGAS~ END
        BUT_ONLY
      END
    END ELSE BEGIN PRINT ~Cloud forms: GASFORM4.CRE is absent; the combat-mist branch has no donor.~ END
  END ELSE BEGIN PRINT ~Cloud forms: DW#VMGAS.SPL is absent; continuing.~ END
  LAF cbr_cloud_descriptions END
  PRINT ~Combat cloud forms: wrote the owned 75% damage-resistance packages and removed cloud-granted magic resistance. Poison, regeneration and scripted escapes remain outside this patch.~
END
