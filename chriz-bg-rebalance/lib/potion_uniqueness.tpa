DEFINE_PATCH_FUNCTION cbr_pu_read_layout
  INT_VAR stride = 0x38 log_errors = 1
  RET ab na fx eq_first eq_count readable
BEGIN
  SET ab = 0 SET na = 0 SET fx = 0 SET eq_first = 0 SET eq_count = 0
  SET readable = BUFFER_LENGTH >= 0x72
  PATCH_IF readable BEGIN
    READ_LONG 0x64 ab READ_SHORT 0x68 na READ_LONG 0x6a fx
    READ_SHORT 0x6e eq_first READ_SHORT 0x70 eq_count
    SET readable = (na = 0 OR (ab >= 0x72 AND ab <= BUFFER_LENGTH
      AND na <= (BUFFER_LENGTH - ab) / stride)) AND fx >= 0x72 AND fx <= BUFFER_LENGTH
    PATCH_IF readable BEGIN
      SET available = (BUFFER_LENGTH - fx) / 0x30
      PATCH_IF eq_count > 0 AND eq_first + eq_count > available BEGIN SET readable = 0 END
      FOR (a = 0; a < na; ++a) BEGIN
        READ_SHORT (ab + a * stride + 0x1e) n
        READ_SHORT (ab + a * stride + 0x20) first
        PATCH_IF n > 0 AND first + n > available BEGIN SET readable = 0 END
      END
      // Tables may be in either order, but referenced records cannot overlap.
      PATCH_IF na > 0 AND fx >= ab AND fx < ab + na * stride BEGIN SET readable = 0 END
      PATCH_IF na > 0 AND fx < ab BEGIN
        PATCH_IF eq_count > 0 AND fx + (eq_first + eq_count) * 0x30 > ab BEGIN SET readable = 0 END
        FOR (a = 0; a < na; ++a) BEGIN
          READ_SHORT (ab + a * stride + 0x1e) n READ_SHORT (ab + a * stride + 0x20) first
          PATCH_IF n > 0 AND fx + (first + n) * 0x30 > ab BEGIN SET readable = 0 END
        END
      END
    END
  END
  PATCH_IF NOT readable AND log_errors BEGIN
    PATCH_PRINT ~Potion uniqueness: %SOURCE_FILE% has unreadable resource bounds; leaving this file alone.~
  END
END


DEFINE_PATCH_FUNCTION cbr_pu_table_read
  RET cbr_t_cols cbr_t_rows cbr_t_default
  RET_ARRAY cbr_t_head cbr_t_cell
BEGIN
  CLEAR_ARRAY cbr_t_head CLEAR_ARRAY cbr_t_cell CLEAR_ARRAY cbr_t_line CLEAR_ARRAY cbr_t_width
  SET line = 0
  READ_ASCII 0 source (BUFFER_LENGTH)
  INNER_PATCH ~%source%~ BEGIN
    REPLACE_EVALUATE ~[^%LNL%%MNL%]+~ BEGIN
      SPRINT content ~%MATCH0%~
      SET token = 0
      INNER_PATCH ~%content%~ BEGIN
        REPLACE_TEXTUALLY ~//.*~ ~~
        REPLACE_EVALUATE ~[^ %TAB%%LNL%%MNL%]+~ BEGIN
          SPRINT $cbr_t_line(~%line%~ ~%token%~) ~%MATCH0%~
          SET token += 1
        END ~%MATCH0%~
      END
      PATCH_IF token > 0 BEGIN SET $cbr_t_width(~%line%~) = token SET line += 1 END
    END ~%MATCH0%~
  END
  SPRINT cbr_t_default ~0~
  PATCH_IF line > 1 BEGIN SPRINT cbr_t_default $cbr_t_line(~1~ ~0~) END
  SET cbr_t_cols = 1 SET cbr_t_rows = 0
  PATCH_IF line > 2 BEGIN
    SET cbr_t_cols = $cbr_t_width(~2~) + 1
    FOR (c = 1; c < cbr_t_cols; ++c) BEGIN
      SET j = c - 1 SPRINT $cbr_t_head(~%c%~) $cbr_t_line(~2~ ~%j%~)
    END
    SET cbr_t_rows = line - 3
    FOR (r = 0; r < cbr_t_rows; ++r) BEGIN
      SET l = r + 3
      PATCH_IF $cbr_t_width(~%l%~) > cbr_t_cols BEGIN
        FOR (c = cbr_t_cols; c < $cbr_t_width(~%l%~); ++c) BEGIN SPRINT $cbr_t_head(~%c%~) ~CBR_COLUMN_%c%~ END
        SET cbr_t_cols = $cbr_t_width(~%l%~)
      END
    END
    FOR (r = 0; r < cbr_t_rows; ++r) BEGIN
      SET l = r + 3
      FOR (c = 0; c < cbr_t_cols; ++c) BEGIN
        SPRINT $cbr_t_cell(~%r%~ ~%c%~) ~%cbr_t_default%~
        PATCH_IF c < $cbr_t_width(~%l%~) BEGIN SPRINT $cbr_t_cell(~%r%~ ~%c%~) $cbr_t_line(~%l%~ ~%c%~) END
      END
    END
  END
END

DEFINE_PATCH_FUNCTION cbr_pu_table_write
BEGIN
  SPRINT output ~2DA V1.0%WNL%%cbr_t_default%%WNL%~
  FOR (c = 1; c < cbr_t_cols; ++c) BEGIN
    SPRINT value $cbr_t_head(~%c%~) SPRINT output ~%output% %value%~
  END
  SPRINT output ~%output%%WNL%~
  FOR (r = 0; r < cbr_t_rows; ++r) BEGIN
    FOR (c = 0; c < cbr_t_cols; ++c) BEGIN
      SPRINT value $cbr_t_cell(~%r%~ ~%c%~) SPRINT output ~%output%%value% ~
    END
    SPRINT output ~%output%%WNL%~
  END
  DELETE_BYTES 0 BUFFER_LENGTH INSERT_BYTES 0 (STRING_LENGTH ~%output%~) WRITE_ASCIIE 0 ~%output%~
END

DEFINE_PATCH_FUNCTION cbr_pu_normalize_2da
  STR_VAR required = ~~
BEGIN
  LPF cbr_pu_table_read RET cbr_t_cols cbr_t_rows cbr_t_default RET_ARRAY cbr_t_head cbr_t_cell END
  SET changed = 0
  // Padding short rows and adding named columns makes subsequent address reads safe.
  COUNT_2DA_COLS width
  COUNT_2DA_ROWS cbr_t_cols complete_rows
  PATCH_IF width != cbr_t_cols OR complete_rows != cbr_t_rows BEGIN SET changed = 1 END
  INNER_PATCH ~%required%~ BEGIN
    REPLACE_EVALUATE ~[^ ]+~ BEGIN
      SPRINT required_name ~%MATCH0%~ SET found = 0
      FOR (c = 1; c < cbr_t_cols; ++c) BEGIN
        SPRINT name $cbr_t_head(~%c%~)
        PATCH_IF ~%name%~ STRING_EQUAL_CASE ~%required_name%~ BEGIN SET found = 1 END
      END
      PATCH_IF NOT found BEGIN
        SET c = cbr_t_cols SPRINT $cbr_t_head(~%c%~) ~%required_name%~
        FOR (r = 0; r < cbr_t_rows; ++r) BEGIN SPRINT $cbr_t_cell(~%r%~ ~%c%~) ~%cbr_t_default%~ END
        SET cbr_t_cols += 1 SET changed = 1
      END
    END ~%MATCH0%~
  END
  PATCH_IF changed BEGIN LPF cbr_pu_table_write END END
END

DEFINE_PATCH_FUNCTION cbr_pu_named_column
  STR_VAR name = ~~ required = ~~
  RET data_column
BEGIN
  LPF cbr_pu_normalize_2da STR_VAR required = EVAL ~%required% %name%~ END
  LPF cbr_pu_table_read RET cbr_t_cols cbr_t_rows cbr_t_default RET_ARRAY cbr_t_head cbr_t_cell END
  SET data_column = 1
  FOR (c = cbr_t_cols - 1; c >= 1; --c) BEGIN
    SPRINT header $cbr_t_head(~%c%~)
    PATCH_IF ~%header%~ STRING_EQUAL_CASE ~%name%~ BEGIN SET data_column = c END
  END
END


// Components 330/331 (potion uniqueness) and 332 (Heroism family).
// Design and evidence: research/2026-10-14-potion-uniqueness-heroism-family.md
//
// Every original effect stays in its own item or spell. A potion type either
// refreshes (one opcode 321 per type resref, before the dose) or keeps its first
// dose (opcode 324 guard on a private spell state first in each delivery batch,
// opcode 328 marker last). Potions are grouped by what their drink abilities do,
// by declared item identity; SCS's named copies share their original's type.
// Changed payloads never veto the owned control records.
//
// WeiDU keeps array variables after CLEAR_ARRAY, and several components can run
// in one WeiDU session, so membership arrays store the call's generation number
// instead of 1.

DEFINE_ACTION_MACRO cbr_pu_tables
BEGIN
  // Presentation only: never part of a potion's identity or a "bonus".
  ACTION_DEFINE_ASSOCIATIVE_ARRAY cbr_pu_cosmetic BEGIN
    7 => 1   8 => 1   9 => 1   50 => 1  51 => 1  52 => 1  61 => 1  65 => 1
    66 => 1  139 => 1 140 => 1 141 => 1 142 => 1 169 => 1 174 => 1 215 => 1
    240 => 1 267 => 1 287 => 1 291 => 1 296 => 1 327 => 1 330 => 1
  END
END

// Bounds-checked ITM/SPL table layout. Sets pu_ok, pu_absz, pu_ab, pu_nab, pu_fx.
DEFINE_PATCH_MACRO cbr_pu_layout
BEGIN
  SET pu_absz=(item_mode ? 0x38 : 0x28)
  PATCH_IF BUFFER_LENGTH>=3 BEGIN
    READ_ASCII 0 format (3)
    PATCH_IF ~%format%~ STR_EQ ~SPL~ BEGIN SET pu_absz=0x28 END
    PATCH_IF ~%format%~ STR_EQ ~ITM~ BEGIN SET pu_absz=0x38 END
  END
  LPF cbr_pu_read_layout INT_VAR stride=pu_absz RET pu_ab=ab pu_nab=na pu_fx=fx pu_ok=readable END
END


DEFINE_PATCH_MACRO cbr_pu_is_potion
BEGIN
  SET pu_member = 0
  PATCH_IF (VARIABLE_IS_SET $cbr_pu_potion(~%res%~)) BEGIN
    PATCH_IF ($cbr_pu_potion(~%res%~) = cbr_pu_gen) BEGIN SET pu_member = 1 END
  END
END

// pu_member = 1 when res is a Heroism family spell of this call.
DEFINE_PATCH_MACRO cbr_pu_is_family
BEGIN
  SET pu_member = 0
  PATCH_IF (VARIABLE_IS_SET $cbr_pu_family_spell(~%res%~)) BEGIN
    PATCH_IF ($cbr_pu_family_spell(~%res%~) = cbr_pu_gen) BEGIN SET pu_member = 1 END
  END
END

// Reads effect pu_i of the slice at fx_base and classifies it.
// Context: pu_own (this resource), item_mode (1 = potion rules, 0 = spell rules).
// A control is a refresh/guard opcode naming this resource or, for potions,
// another potion, or for spells another family spell; any opcode 321 in a spell
// is one too (Heroism copies may name each other). Controls never count as
// gameplay.
DEFINE_PATCH_MACRO cbr_pu_read_effect
BEGIN
  SET at = fx_base + pu_i * 0x30
  READ_SHORT at op
  READ_BYTE  (at + 0x02) tg
  READ_BYTE  (at + 0x03) pw
  READ_LONG  (at + 0x04) p1
  READ_LONG  (at + 0x08) p2
  READ_BYTE  (at + 0x0c) tm
  READ_BYTE  (at + 0x0d) rs
  READ_LONG  (at + 0x0e) du
  READ_BYTE  (at + 0x12) pr1
  READ_BYTE  (at + 0x13) pr2
  READ_ASCII (at + 0x14) res (8) NULL
  TO_UPPER res
  READ_LONG  (at + 0x1c) dn
  READ_LONG  (at + 0x20) ds
  READ_LONG  (at + 0x24) sv
  READ_LONG  (at + 0x28) sb
  READ_LONG  (at + 0x2c) sp
  SET is_cos = VARIABLE_IS_SET $cbr_pu_cosmetic(~%op%~)
  SET is_marker = ((op = 282) OR (op = 328))
  SET is_link = ((op = 146) OR (op = 148) OR (op = 326))
  SET is_timed = (((tm = 0) OR (tm = 3) OR (tm = 6) OR (tm = 10)) AND (du > 0))
  SET is_ctrl = 0
  PATCH_IF ((op = 321) OR (op = 324) OR (op = 318) OR (op = 206)) BEGIN
    PATCH_IF (~%res%~ STR_EQ ~%pu_own%~) BEGIN
      SET is_ctrl = 1
    END ELSE PATCH_IF item_mode BEGIN
      LPM cbr_pu_is_potion
      SET is_ctrl = pu_member
    END ELSE PATCH_IF (op = 321) BEGIN
      SET is_ctrl = 1
    END ELSE BEGIN
      LPM cbr_pu_is_family
      SET is_ctrl = pu_member
    END
  END
  SET is_game = ((NOT is_cos) AND (NOT is_marker) AND (NOT is_ctrl))
END

DEFINE_PATCH_MACRO cbr_pu_reset_facts
BEGIN
  SET f_timed = 0
  SET f_hp = 0
  SET f_int = 0
  SET f_instant = 0
  SET f_badkf = 0
  SET f_dur = 0
  SET f_rs = 1
  SET f_pw = 0
  SET f_rspw = 0
  SPRINT f_wards ~ ~
  SPRINT f_links ~ ~
END

// Facts of one gameplay effect (see cbr_pu_collect_slice).
DEFINE_PATCH_MACRO cbr_pu_effect_facts
BEGIN
  PATCH_IF is_link AND follow_links AND NOT (~%res%~ STR_EQ ~~) BEGIN
    PATCH_IF FILE_EXISTS_IN_GAME ~%res%.SPL~ BEGIN
      PATCH_IF (INDEX (CASE_INSENSITIVE EXACT_MATCH ~ %res% ~ ~%f_links%~))<0 BEGIN SPRINT f_links ~%f_links%%res% ~ END
    END ELSE BEGIN PATCH_PRINT ~Potion uniqueness: optional linked spell %res% is absent; this branch ends.~ END
  END ELSE PATCH_IF is_timed BEGIN
    SET f_timed=1 PATCH_IF du>f_dur BEGIN SET f_dur=du END
    PATCH_IF op=18 BEGIN SET f_hp=1 SET f_rs=rs SET f_pw=pw SET f_rspw=2 END
    ELSE PATCH_IF f_rspw<1 BEGIN SET f_rs=rs SET f_pw=pw SET f_rspw=1 END
    PATCH_IF op=19 BEGIN SET f_int=1 END
  END ELSE BEGIN SET f_instant=1 END
END


DEFINE_PATCH_MACRO cbr_pu_collect_slice
BEGIN
  SPRINT pu_sigab ~~
  FOR (pu_i=0;pu_i<fx_n;++pu_i) BEGIN
    LPM cbr_pu_read_effect
    PATCH_IF is_game BEGIN LPM cbr_pu_effect_facts END
  END
END


DEFINE_PATCH_MACRO cbr_pu_collect_spell
BEGIN
  LPM cbr_pu_reset_facts
  SPRINT pu_sig ~~
  FOR (pu_a = 0; pu_ok AND (pu_a < pu_nab); ++pu_a) BEGIN
    READ_SHORT (pu_ab + pu_a * 0x28 + 0x1e) fx_n
    READ_SHORT (pu_ab + pu_a * 0x28 + 0x20) pu_first
    SET fx_base = pu_fx + pu_first * 0x30
    LPM cbr_pu_collect_slice
    SPRINT pu_sig ~%pu_sig%%pu_sigab%|~
  END
END

// Delivery batches carrying the buff in one ability (bit 1 = effect target 1,
// bit 2 = target 2), plus that ability's longest bonus and its power/dispel
// byte. A spell cast on someone else delivers its buff with target 2; its
// target-1 effects belong to the caster.
DEFINE_PATCH_MACRO cbr_pu_ability_paths
BEGIN
  SET pu_paths = 0
  SET ab_dur = 0
  SET ab_rs = 1
  SET ab_pw = 0
  SET ab_rspw = 0
  FOR (pu_i = 0; pu_i < fx_n; ++pu_i) BEGIN
    LPM cbr_pu_read_effect
    PATCH_IF is_game BEGIN
      SET on_buff = 1
      PATCH_IF (tg = 2) BEGIN
        SET pu_paths = pu_paths BOR 2
      END ELSE PATCH_IF ((tg = 1) AND self_ability) BEGIN
        SET pu_paths = pu_paths BOR 1
      END ELSE BEGIN
        SET on_buff = 0
      END
      PATCH_IF (on_buff AND is_timed AND (NOT is_link) AND (tm = 0)) BEGIN
        PATCH_IF (du > ab_dur) BEGIN SET ab_dur = du END
        PATCH_IF ((op = 18) AND (ab_rspw < 2)) BEGIN
          SET ab_rs = rs SET ab_pw = pw SET ab_rspw = 2
        END ELSE PATCH_IF (ab_rspw < 1) BEGIN
          SET ab_rs = rs SET ab_pw = pw SET ab_rspw = 1
        END
      END
    END
  END
END

// Keep first: a guard first in each batch that carries the buff, the marker
// after everything. Context: pu_own, item_mode, kf_state, kf_row and, for
// potions, kf_dur/kf_rs/kf_pw (type-wide, linked spell included). A guard or
// marker that is already present is not added again.

DEFINE_PATCH_MACRO cbr_pu_rebuild
BEGIN
  LPM cbr_pu_layout
  PATCH_IF pu_ok BEGIN
    READ_ASCII 0 pu_head (0x72) READ_SHORT 0x6e eq_first READ_SHORT 0x70 eq_count
    SPRINT pu_output_effects ~~
    PATCH_IF eq_count>0 BEGIN READ_ASCII (pu_fx+eq_first*0x30) pu_output_effects (eq_count*0x30) END
    SPRINT pu_output_abilities ~~ SET pu_out=eq_count SET pu_end=0x72
    PATCH_IF pu_nab>0 BEGIN SET pu_end=pu_ab+pu_nab*pu_absz END
    PATCH_IF eq_count>0 AND pu_fx+(eq_first+eq_count)*0x30>pu_end BEGIN SET pu_end=pu_fx+(eq_first+eq_count)*0x30 END
    SET pu_fits=1
    PATCH_IF pu_nab=0 BEGIN
      INNER_PATCH_SAVE empty_ability ~........................................................~ BEGIN
        DELETE_BYTES pu_absz (0x38 - pu_absz)
        FOR (j=0;j<pu_absz;++j) BEGIN WRITE_BYTE j 0 END
        WRITE_BYTE 0 (item_mode ? 3 : 1) WRITE_BYTE 0xc (item_mode ? 5 : 1)
      END
      SPRINT $pu_ability(~0~) ~%empty_ability%~ SPRINT $pu_slice(~0~) ~~ SET pu_nab=1
    END ELSE BEGIN
      FOR (pu_a=0;pu_a<pu_nab;++pu_a) BEGIN
        READ_ASCII (pu_ab+pu_a*pu_absz) $pu_ability(~%pu_a%~) (pu_absz)
        READ_SHORT (pu_ab+pu_a*pu_absz+0x1e) count READ_SHORT (pu_ab+pu_a*pu_absz+0x20) first
        SPRINT $pu_slice(~%pu_a%~) ~~
        PATCH_IF count>0 BEGIN READ_ASCII (pu_fx+first*0x30) $pu_slice(~%pu_a%~) (count*0x30) END
        PATCH_IF count>0 AND pu_fx+(first+count)*0x30>pu_end BEGIN SET pu_end=pu_fx+(first+count)*0x30 END
      END
    END
    PATCH_IF item_mode BEGIN
      SET has_drink=0
      FOR (pu_a=0;pu_a<pu_nab;++pu_a) BEGIN
        SPRINT ability $pu_ability(~%pu_a%~)
        INNER_PATCH ~%ability%~ BEGIN READ_BYTE 0xc target PATCH_IF target=5 OR target=7 BEGIN SET has_drink=1 END END
      END
      PATCH_IF NOT has_drink BEGIN
        SPRINT ability $pu_ability(~0~)
        INNER_PATCH_SAVE ability ~%ability%~ BEGIN WRITE_BYTE 0 3 WRITE_BYTE 0xc 5 END
        SPRINT $pu_ability(~%pu_nab%~) ~%ability%~ SPRINT $pu_slice(~%pu_nab%~) $pu_slice(~0~) SET pu_nab+=1
      END
    END
    SPRINT pu_tail ~~ PATCH_IF pu_end<BUFFER_LENGTH BEGIN READ_ASCII pu_end pu_tail (BUFFER_LENGTH - pu_end) END
    FOR (pu_a=0;pu_a<pu_nab;++pu_a) BEGIN
      SPRINT ability $pu_ability(~%pu_a%~) SPRINT input $pu_slice(~%pu_a%~) SPRINT result ~~
      INNER_PATCH ~%ability%~ BEGIN READ_BYTE 0xc ability_target END
      PATCH_IF NOT item_mode OR ability_target=5 OR ability_target=7 BEGIN
        SPRINT before ~~ SPRINT payload ~~ SPRINT always ~~ SET paths=0 SET ab_dur=0 SET ab_rs=1 SET ab_pw=0 SET leading=1
        INNER_PATCH ~%input%~ BEGIN
          SET fx_base=0 SET fx_n=BUFFER_LENGTH/0x30
          FOR (pu_i=0;pu_i<fx_n;++pu_i) BEGIN
            LPM cbr_pu_read_effect READ_ASCII at record (0x30) SET owned=0
            PATCH_IF pu_mode=1 BEGIN
              PATCH_IF op=324 AND ~%res%~ STR_EQ ~%pu_own%~ BEGIN
                SET owned=1
                PATCH_IF p1!=kf_state AND VARIABLE_IS_SET $cbr_pu_state_used(~%p1%~) BEGIN SET owned=0 END
              END
              PATCH_IF op=328 AND p2=kf_state BEGIN SET owned=1 END
            END ELSE PATCH_IF op=321 BEGIN
              PHP_EACH cbr_pu_refs AS candidate => ignored BEGIN PATCH_IF ~%res%~ STRING_EQUAL_CASE ~%candidate%~ BEGIN SET owned=1 END END
            END
            // Our stacking rule replaces lasting native wards. Instant checks
            // such as Oil of Speed's haste-immunity gate remain independent.
            PATCH_IF is_ctrl AND du>0 AND (op=206 OR op=318 OR op=324) BEGIN SET owned=1 END
            PATCH_IF NOT owned BEGIN
              PATCH_IF is_game BEGIN
                PATCH_IF tg>0 AND tg<10 BEGIN SET paths=paths BOR (1 BLSL tg) END
                PATCH_IF is_timed BEGIN PATCH_IF du>ab_dur BEGIN SET ab_dur=du END SET ab_rs=rs SET ab_pw=pw END
              END
              PATCH_IF pu_mode=1 AND is_game AND NOT is_timed AND NOT is_link BEGIN SPRINT always ~%always%%record%~ END
              ELSE PATCH_IF pu_mode=0 AND leading AND is_ctrl BEGIN SPRINT before ~%before%%record%~ END ELSE BEGIN SPRINT payload ~%payload%%record%~ END
              PATCH_IF NOT is_ctrl AND NOT is_cos BEGIN SET leading=0 END
            END
          END
        END
        PATCH_IF pu_mode=1 BEGIN
          PATCH_IF item_mode BEGIN SET ab_dur=kf_dur SET ab_rs=kf_rs SET ab_pw=kf_pw END
          PATCH_IF ab_dur<=0 BEGIN SET ab_dur=600 END
          PATCH_IF paths=0 BEGIN SET paths=(item_mode ? 2 : 4) END
          SET last_target=1 SPRINT result ~%always%~
          FOR (tg=1;tg<10;++tg) BEGIN
            PATCH_IF (paths BAND (1 BLSL tg))!=0 BEGIN
              INNER_PATCH_SAVE record ~................................................~ BEGIN
                FOR (j=0;j<0x30;++j) BEGIN WRITE_BYTE j 0 END
                WRITE_SHORT 0 324 WRITE_BYTE 2 tg WRITE_BYTE 3 ab_pw WRITE_LONG 4 kf_state WRITE_LONG 8 kf_row
                WRITE_BYTE 0xd 2 WRITE_BYTE 0x12 100 WRITE_ASCIIE 0x14 ~%pu_own%~ #8
              END
              SPRINT result ~%result%%record%~ SET last_target=tg
            END
          END
          SPRINT result ~%result%%payload%~
          INNER_PATCH_SAVE record ~................................................~ BEGIN
            FOR (j=0;j<0x30;++j) BEGIN WRITE_BYTE j 0 END
            WRITE_SHORT 0 328 WRITE_BYTE 2 last_target WRITE_BYTE 3 ab_pw WRITE_LONG 8 kf_state
            WRITE_LONG 0xe ab_dur WRITE_BYTE 0xd (2 BOR (ab_rs BAND 1)) WRITE_BYTE 0x12 100 WRITE_LONG 0x2c 1
          END
          SPRINT result ~%result%%record%~
        END ELSE BEGIN
          SPRINT result ~%before%~
          PHP_EACH cbr_pu_refs AS candidate => ignored BEGIN
            INNER_PATCH_SAVE record ~................................................~ BEGIN
              FOR (j=0;j<0x30;++j) BEGIN WRITE_BYTE j 0 END
              WRITE_SHORT 0 321 WRITE_BYTE 2 1 WRITE_LONG 8 2 WRITE_BYTE 0xc 1 WRITE_BYTE 0xd 2 WRITE_BYTE 0x12 100 WRITE_ASCIIE 0x14 ~%candidate%~ #8
            END
            SPRINT result ~%result%%record%~
          END
          SPRINT result ~%result%%payload%~
        END
      END ELSE BEGIN SPRINT result ~%input%~ END
      SET count=STRING_LENGTH ~%result%~/0x30
      PATCH_IF pu_out>0xffff OR count>0xffff BEGIN SET pu_fits=0 END
      INNER_PATCH_SAVE ability ~%ability%~ BEGIN WRITE_SHORT 0x1e count WRITE_SHORT 0x20 pu_out END
      SPRINT pu_output_abilities ~%pu_output_abilities%%ability%~ SPRINT pu_output_effects ~%pu_output_effects%%result%~ SET pu_out+=count
    END
    PATCH_IF pu_fits BEGIN
      SPRINT result ~%pu_head%%pu_output_abilities%%pu_output_effects%%pu_tail%~
      DELETE_BYTES 0 BUFFER_LENGTH INSERT_BYTES 0 (STRING_LENGTH ~%result%~) WRITE_ASCIIE 0 ~%result%~
      WRITE_LONG 0x64 0x72 WRITE_SHORT 0x68 pu_nab WRITE_LONG 0x6a (0x72+pu_nab*pu_absz) WRITE_SHORT 0x6e 0
    END ELSE BEGIN PATCH_PRINT ~Potion uniqueness: %SOURCE_FILE% cannot address the new slices; only this resource is unchanged.~ END
  END
END

DEFINE_PATCH_MACRO cbr_pu_patch_keep_first
BEGIN
  SET pu_mode=1 LPM cbr_pu_rebuild
END


DEFINE_PATCH_MACRO cbr_pu_patch_refresh
BEGIN
  SET pu_mode=0 LPM cbr_pu_rebuild
END


<<<<<<<< cbr_pu_empty_ids
IDS V1.0
>>>>>>>>
<<<<<<<< cbr_pu_empty_prot
2DA V1.0
0
 STAT VALUE RELATION
>>>>>>>>
DEFINE_ACTION_MACRO cbr_pu_allocate_state
BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME ~SPLSTATE.IDS~ BEGIN COPY_EXISTING ~SPLSTATE.IDS~ ~override~ END ELSE BEGIN COPY ~cbr_pu_empty_ids~ ~override/SPLSTATE.IDS~ END
  COPY ~override/SPLSTATE.IDS~ ~override/SPLSTATE.IDS~
    FOR (i = 0; i < 256; ++i) BEGIN SET $cbr_pu_used(~%i%~) = 0 END
    SET own_value = (0 - 1)
    PATCH_CLEAR_ARRAY cbr_pu_state_used
    READ_ASCII 0 contents (BUFFER_LENGTH)
    INNER_PATCH ~%contents%~ BEGIN
      REPLACE_EVALUATE
        ~^[ %TAB%]*\([^ %TAB%%WNL%%MNL%%LNL%]+\)[ %TAB%]+\([^ %TAB%%WNL%%MNL%%LNL%]+\)~
      BEGIN
        PATCH_IF IS_AN_INT ~%MATCH1%~ BEGIN
          SET value = MATCH1
          PATCH_IF (~%MATCH2%~ STRING_MATCHES_REGEXP ~CBR_POTION_.*\|CBR_HEROISM_FAMILY~)=0 AND value>=0 AND value<=255 BEGIN SET $cbr_pu_state_used(~%value%~)=1 END
          PATCH_IF value >= 0 AND value <= 255 BEGIN
            PATCH_IF ~%MATCH2%~ STRING_EQUAL_CASE ~%kf_symbol%~ BEGIN
              PATCH_IF own_value < 0 BEGIN SET own_value = value END
            END ELSE BEGIN SET $cbr_pu_used(~%value%~) = 1 END
          END
        END
      END ~~
    END
    // Reading allocated numbers chooses an address; it never vetoes our symbol.
    SET kf_state = (0 - 1)
    PATCH_IF own_value >= 0 BEGIN
      SET kf_state = own_value
    END
    FOR (i = 240; i >= 0 AND kf_state < 0; --i) BEGIN
      PATCH_IF NOT $cbr_pu_used(~%i%~) BEGIN SET kf_state = i END
    END
    // If every engine bit is named, our decided marker owns the preferred bit.
    FOR (i=255;i>240 AND kf_state<0;--i) BEGIN PATCH_IF NOT $cbr_pu_used(~%i%~) BEGIN SET kf_state=i END END
    FOR (i=240;i>=0 AND kf_state<0;--i) BEGIN PATCH_IF NOT VARIABLE_IS_SET $cbr_pu_state_used(~%i%~) BEGIN SET kf_state=i END END
    PATCH_IF kf_state<0 BEGIN SET kf_state=240 END
    SET $cbr_pu_state_used(~%kf_state%~)=1
    SET written = 0
    REPLACE_EVALUATE CASE_INSENSITIVE
      ~^[ %TAB%]*[^ %TAB%%WNL%%MNL%%LNL%]+[ %TAB%]+%kf_symbol%\b[^%WNL%%MNL%%LNL%]*~
    BEGIN
      SPRINT row ~~
      PATCH_IF NOT written BEGIN
        SPRINT row ~%kf_state% %kf_symbol%~
        SET written = 1
      END
    END ~%row%~
    PATCH_IF NOT written BEGIN
      SPRINT row ~%kf_state% %kf_symbol%%LNL%~
      PATCH_IF BUFFER_LENGTH > 0 BEGIN
        READ_BYTE (BUFFER_LENGTH - 1) last
        PATCH_IF last != 10 AND last != 13 BEGIN SPRINT row ~%LNL%%row%~ END
      END
      SET at = BUFFER_LENGTH
      INSERT_BYTES at (STRING_LENGTH ~%row%~)
      WRITE_ASCIIE at ~%row%~
    END
  BUT_ONLY
  CLEAR_IDS_MAP

  ACTION_IF NOT FILE_EXISTS_IN_GAME ~SPLPROT.2DA~ BEGIN COPY ~cbr_pu_empty_prot~ ~override/SPLPROT.2DA~ END
  COPY_EXISTING ~SPLPROT.2DA~ ~override~
    LPF cbr_pu_named_column STR_VAR name=~STAT~ required=~VALUE RELATION~ RET sc=data_column END
    LPF cbr_pu_named_column STR_VAR name=~VALUE~ RET vc=data_column END
    LPF cbr_pu_named_column STR_VAR name=~RELATION~ RET rc=data_column END
    LPF cbr_pu_table_read RET cbr_t_cols cbr_t_rows cbr_t_default RET_ARRAY cbr_t_head cbr_t_cell END
    SET kf_row=(0 - 1)
    SPRINT result ~2DA V1.0%WNL%0%WNL% STAT VALUE RELATION%WNL%~
    FOR (r=0;r<cbr_t_rows;++r) BEGIN
      SPRINT label $cbr_t_cell(~%r%~ ~0~) SPRINT stat $cbr_t_cell(~%r%~ ~%sc%~) SPRINT value $cbr_t_cell(~%r%~ ~%vc%~) SPRINT relation $cbr_t_cell(~%r%~ ~%rc%~)
      PATCH_IF ~%label%~ STRING_EQUAL_CASE ~CBR_SPLSTATE_ACTIVE~ BEGIN SPRINT stat ~274~ SPRINT value ~-1~ SPRINT relation ~1~ SET kf_row=r END
      PATCH_IF IS_AN_INT ~%stat%~ AND IS_AN_INT ~%value%~ AND IS_AN_INT ~%relation%~ BEGIN PATCH_IF stat=274 AND value=(0 - 1) AND relation=1 AND kf_row<0 BEGIN SET kf_row=r END END
      SPRINT result ~%result%%label% %stat% %value% %relation%%WNL%~
    END
    PATCH_IF kf_row<0 BEGIN SET kf_row=cbr_t_rows SPRINT result ~%result%CBR_SPLSTATE_ACTIVE 274 -1 1%WNL%~ END
    PATCH_IF sc!=1 OR vc!=2 OR rc!=3 OR cbr_t_cols!=4 OR kf_row>=cbr_t_rows OR (INDEX_BUFFER (CASE_INSENSITIVE ~CBR_SPLSTATE_ACTIVE~))>=0 BEGIN
      DELETE_BYTES 0 BUFFER_LENGTH INSERT_BYTES 0 (STRING_LENGTH ~%result%~) WRITE_ASCIIE 0 ~%result%~
    END
    BUT_ONLY
END


DEFINE_PATCH_MACRO cbr_pu_fix_description
BEGIN
  PATCH_IF BUFFER_LENGTH>=0x72 BEGIN
    PATCH_IF ~%EE_LANGUAGE%~ STRING_EQUAL_CASE ~en_us~ BEGIN
      SPRINT description ~Heroism
(Enchantment/Charm)

Level: 2
Range: Visual range of the caster
Duration: 2 hours
Casting Time: 2
Area of Effect: Special
Saving Throw: None

For the next two hours, the targeted creature is blessed with an enchantment which increases their competence, granting them a +10% bonus to their Hit Points, and setting their THAC0 to 90% of their base.~
      PATCH_IF ~%pu_description_kind%~ STR_EQ ~greater~ BEGIN SPRINT description ~Greater Heroism
(Enchantment/Charm)

Level: 5
Range: Visual range of the caster
Duration: 2 hours
Casting Time: 2
Area of Effect: 1 creature
Saving Throw: None

This is a more powerful version of the Heroism spell. For the next two hours, the targeted creature is blessed with an enchantment which increases their competence, granting them a +15% bonus to their Hit Points, setting their THAC0 to 85% of their base, and gaining a +2 bonus to all their Saving Throws. This spell, Heroism and the Potion of Heroism are non-cumulative: while one of them is active on a creature, the others have no effect on it until it ends.~ END
      SET new_ref=RESOLVE_STR_REF (~%description%~) WRITE_LONG (item_mode ? 0x54 : 0x50) new_ref
    END ELSE BEGIN PATCH_PRINT ~Potion uniqueness: no %EE_LANGUAGE% translation; existing text retained for %SOURCE_FILE%.~ END
  END
END


DEFINE_ACTION_FUNCTION cbr_install_potion_uniqueness
  INT_VAR
    potions = 0
    genius_exempt = 0
    heroism = 0
BEGIN
  LAM cbr_pu_tables
  ACTION_IF (NOT VARIABLE_IS_SET cbr_pu_gen) BEGIN OUTER_SET cbr_pu_gen = 0 END
  OUTER_SET cbr_pu_gen = cbr_pu_gen + 1
  OUTER_SET item_mode = 1
  OUTER_SET follow_links = 1
  OUTER_SET check_paths = 0
  OUTER_SET self_ability = 1
  ACTION_CLEAR_ARRAY cbr_pu_family_spell
  ACTION_CLEAR_ARRAY cbr_pu_potion
  ACTION_CLEAR_ARRAY cbr_pu_scroll
  ACTION_CLEAR_ARRAY cbr_pu_need_spl

  // Explicit upstream copy identities, including Gallant's named copies.
  ACTION_IF heroism BEGIN
    ACTION_FOR_EACH pu_r IN C0BW202 C0BW502 C0GA202 C0GA502 BEGIN
      ACTION_IF FILE_EXISTS_IN_GAME ~%pu_r%.SPL~ BEGIN OUTER_SET $cbr_pu_family_spell(~%pu_r%~)=cbr_pu_gen END
    END
  END

  // Potions: category-9 items with an ability the user applies to themself.
  // Scrolls that teach or cast a family spell are noted for the description.
  COPY_EXISTING_REGEXP GLOB ~^.+\.itm$~ ~override~
    LPM cbr_pu_layout
    SET pu_cat = 0
    PATCH_IF (pu_ok AND (pu_absz = 0x38)) BEGIN
      READ_SHORT 0x1c pu_cat
    END
    SPRINT pu_res ~%SOURCE_RES%~ TO_UPPER pu_res
    SET known_potion=(~%pu_res%~ STRING_MATCHES_REGEXP ~\(POTN[0-9]+\|DW#PTN[0-9]+\)~)=0
    PATCH_IF pu_ok AND (pu_cat=9 OR known_potion) BEGIN SET $cbr_pu_potion(~%pu_res%~)=cbr_pu_gen END
    PATCH_IF ((pu_cat = 9) OR known_potion OR (heroism AND (pu_cat = 11))) BEGIN
      SPRINT pu_res ~%SOURCE_RES%~
      TO_UPPER pu_res
      FOR (pu_a = 0; pu_a < pu_nab; ++pu_a) BEGIN
        READ_BYTE  (pu_ab + pu_a * 0x38 + 0x0c) pu_at
        READ_SHORT (pu_ab + pu_a * 0x38 + 0x1e) pu_n
        READ_SHORT (pu_ab + pu_a * 0x38 + 0x20) pu_f
        PATCH_IF ((pu_cat = 9) AND ((pu_at = 5) OR (pu_at = 7))) BEGIN
          SET $cbr_pu_potion(~%pu_res%~) = cbr_pu_gen
        END
        PATCH_IF (pu_cat = 11) BEGIN
          FOR (pu_i = 0; pu_i < pu_n; ++pu_i) BEGIN
            READ_SHORT (pu_fx + (pu_f + pu_i) * 0x30) pu_op
            READ_ASCII (pu_fx + (pu_f + pu_i) * 0x30 + 0x14) res (8) NULL
            TO_UPPER res
            PATCH_IF ((pu_op = 146) OR (pu_op = 147) OR (pu_op = 148)) BEGIN
              LPM cbr_pu_is_family
              PATCH_IF pu_member BEGIN SPRINT $cbr_pu_scroll(~%pu_res%~) ~%res%~ END
            END
          END
        END
      END
    END
  BUT_ONLY
  ACTION_SORT_ARRAY_INDICES cbr_pu_potion LEXICOGRAPHICALLY

  // What each potion's drink abilities do: order-free signature and facts.
  ACTION_PHP_EACH cbr_pu_potion AS pu_p => pu_one BEGIN
    COPY_EXISTING ~%pu_p%.itm~ ~override~
      SPRINT pu_own ~%pu_p%~
      LPM cbr_pu_layout
      LPM cbr_pu_reset_facts
      SPRINT pu_sig ~~
      SET check_paths = 1
      FOR (pu_a = 0; pu_a < pu_nab; ++pu_a) BEGIN
        READ_BYTE  (pu_ab + pu_a * 0x38 + 0x0c) pu_at
        READ_SHORT (pu_ab + pu_a * 0x38 + 0x1e) fx_n
        READ_SHORT (pu_ab + pu_a * 0x38 + 0x20) pu_first
        PATCH_IF ((pu_at = 5) OR (pu_at = 7)) BEGIN
          SET fx_base = pu_fx + pu_first * 0x30
          LPM cbr_pu_collect_slice
          SPRINT pu_sig ~%pu_sig%%pu_sigab%|~
        END
      END
      SET check_paths = 0
      SPRINT $cbr_pu_sig(~%pu_p%~) ~%pu_sig%~
      SET $cbr_pu_timed(~%pu_p%~) = f_timed
      SET $cbr_pu_hp(~%pu_p%~) = f_hp
      SET $cbr_pu_int(~%pu_p%~) = f_int
      SET $cbr_pu_instant(~%pu_p%~) = f_instant
      SET $cbr_pu_badkf(~%pu_p%~) = f_badkf
      SET $cbr_pu_dur(~%pu_p%~) = f_dur
      SET $cbr_pu_rs(~%pu_p%~) = f_rs
      SET $cbr_pu_pw(~%pu_p%~) = f_pw
      SET $cbr_pu_rspw(~%pu_p%~) = f_rspw
      SPRINT $cbr_pu_wards(~%pu_p%~) ~%f_wards%~
      SPRINT $cbr_pu_links(~%pu_p%~) ~%f_links%~
      PATCH_IF (STRING_LENGTH ~%f_links%~ > 1) BEGIN
        INNER_PATCH ~%f_links%~ BEGIN
          REPLACE_EVALUATE ~\([^ ]+\)~ BEGIN SET $cbr_pu_need_spl(~%MATCH1%~) = 1 END ~%MATCH1%~
        END
      END
    BUT_ONLY
  END


  // Visit every linked spell once, then propagate facts through the graph.
  // Cycles terminate on resource identity; depth and payload shape do not veto.
  OUTER_SET node_count=0
  ACTION_PHP_EACH cbr_pu_need_spl AS pu_r => ignored BEGIN
    OUTER_SPRINT $cbr_pu_node(~%node_count%~) ~%pu_r%~ OUTER_SET node_count+=1
  END
  OUTER_SET follow_links=1
  OUTER_FOR (node=0;node<node_count;++node) BEGIN
    OUTER_SPRINT pu_r $cbr_pu_node(~%node%~)
    COPY_EXISTING ~%pu_r%.SPL~ ~override~
      SPRINT pu_own ~%pu_r%~ LPM cbr_pu_layout LPM cbr_pu_collect_spell
      SET $cbr_pu_spl_timed(~%pu_r%~)=f_timed SET $cbr_pu_spl_hp(~%pu_r%~)=f_hp SET $cbr_pu_spl_int(~%pu_r%~)=f_int
      SET $cbr_pu_spl_dur(~%pu_r%~)=f_dur SET $cbr_pu_spl_rs(~%pu_r%~)=f_rs SET $cbr_pu_spl_pw(~%pu_r%~)=f_pw
      SPRINT $cbr_pu_spl_links(~%pu_r%~) ~%f_links%~
      INNER_PATCH ~%f_links%~ BEGIN
        REPLACE_EVALUATE ~[^ ]+~ BEGIN
          PATCH_IF NOT VARIABLE_IS_SET $cbr_pu_need_spl(~%MATCH0%~) BEGIN
            SET $cbr_pu_need_spl(~%MATCH0%~)=1 SPRINT $cbr_pu_node(~%node_count%~) ~%MATCH0%~ SET node_count+=1
          END
        END ~%MATCH0%~
      END
      BUT_ONLY
  END
  OUTER_FOR (step=0;step<=node_count;++step) BEGIN
    ACTION_PHP_EACH cbr_pu_potion AS pu_p => ignored BEGIN
      OUTER_SPRINT links $cbr_pu_links(~%pu_p%~)
      OUTER_FOR (node=0;node<node_count;++node) BEGIN
        OUTER_SPRINT pu_r $cbr_pu_node(~%node%~)
        ACTION_IF (INDEX (CASE_INSENSITIVE EXACT_MATCH ~ %pu_r% ~ ~%links%~))>=0 BEGIN
          OUTER_SET $cbr_pu_timed(~%pu_p%~)=$cbr_pu_timed(~%pu_p%~) OR $cbr_pu_spl_timed(~%pu_r%~)
          OUTER_SET $cbr_pu_hp(~%pu_p%~)=$cbr_pu_hp(~%pu_p%~) OR $cbr_pu_spl_hp(~%pu_r%~)
          OUTER_SET $cbr_pu_int(~%pu_p%~)=$cbr_pu_int(~%pu_p%~) OR $cbr_pu_spl_int(~%pu_r%~)
          ACTION_IF $cbr_pu_spl_dur(~%pu_r%~)>$cbr_pu_dur(~%pu_p%~) BEGIN
            OUTER_SET $cbr_pu_dur(~%pu_p%~)=$cbr_pu_spl_dur(~%pu_r%~)
            OUTER_SET $cbr_pu_rs(~%pu_p%~)=$cbr_pu_spl_rs(~%pu_r%~) OUTER_SET $cbr_pu_pw(~%pu_p%~)=$cbr_pu_spl_pw(~%pu_r%~)
          END
          OUTER_SPRINT child_links $cbr_pu_spl_links(~%pu_r%~)
          OUTER_PATCH ~%child_links%~ BEGIN
            REPLACE_EVALUATE ~[^ ]+~ BEGIN
              PATCH_IF (INDEX (CASE_INSENSITIVE EXACT_MATCH ~ %MATCH0% ~ ~%links%~))<0 BEGIN SPRINT links ~%links%%MATCH0% ~ END
            END ~%MATCH0%~
          END
        END
      END
      OUTER_SPRINT $cbr_pu_links(~%pu_p%~) ~%links%~
    END
  END

  OUTER_SET pu_ntypes=0
  ACTION_PHP_EACH cbr_pu_potion AS pu_p => pu_one BEGIN
    OUTER_SPRINT pu_key ~%pu_p%~
    OUTER_PATCH_SAVE pu_key ~%pu_key%~ BEGIN REPLACE_TEXTUALLY ~^DW#PTN~ ~POTN~ END
    OUTER_SET pu_type=(0 - 1)
    OUTER_FOR (pu_j=0;pu_j<pu_ntypes;++pu_j) BEGIN
      OUTER_SPRINT other $cbr_pu_typesig(~%pu_j%~)
      ACTION_IF ~%pu_key%~ STR_EQ ~%other%~ BEGIN OUTER_SET pu_type=pu_j END
    END
    ACTION_IF pu_type<0 BEGIN OUTER_SET pu_type=pu_ntypes OUTER_SPRINT $cbr_pu_typesig(~%pu_type%~) ~%pu_key%~ OUTER_SET pu_ntypes+=1 END
    OUTER_SET $cbr_pu_type(~%pu_p%~)=pu_type
  END

  OUTER_SET pu_count_refresh = 0
  OUTER_SET pu_count_keep = 0
  OUTER_SET pu_count_family = 0
  OUTER_SET pu_heroism_type = (0 - 1)
  OUTER_SET pu_heroism_ok = 0
  OUTER_SET pu_heroism_timed = 0
  OUTER_SPRINT pu_heroism_members ~ ~
  OUTER_FOR (pu_j = 0; pu_j < pu_ntypes; ++pu_j) BEGIN
    ACTION_CLEAR_ARRAY cbr_pu_refs
    OUTER_SPRINT pu_members ~ ~
    OUTER_SPRINT pu_anchor ~~
    OUTER_SET pu_timed = 0
    OUTER_SET pu_hp = 0
    OUTER_SET pu_int = 0
    OUTER_SET pu_instant = 0
    OUTER_SET pu_badkf = 0
    OUTER_SET kf_dur = 0
    OUTER_SET kf_rs = 1
    OUTER_SET kf_pw = 0
    OUTER_SET pu_genius = 0
    OUTER_SET pu_is_heroism = 0
    OUTER_SPRINT pu_wards ~ ~
    ACTION_PHP_EACH cbr_pu_potion AS pu_p => pu_one BEGIN
      ACTION_IF ($cbr_pu_type(~%pu_p%~) = pu_j) BEGIN
        OUTER_SET $cbr_pu_refs(~%pu_p%~) = 1
        OUTER_SPRINT pu_members ~%pu_members%%pu_p% ~
        // Prefer an anchor without '#' so the state symbol stays script-safe.
        ACTION_IF ((~%pu_anchor%~ STR_EQ ~~)
          OR (((INDEX (CASE_INSENSITIVE EXACT_MATCH ~#~ ~%pu_anchor%~)) >= 0)
            AND ((INDEX (CASE_INSENSITIVE EXACT_MATCH ~#~ ~%pu_p%~)) < 0))) BEGIN
          OUTER_SPRINT pu_anchor ~%pu_p%~
        END
        OUTER_SET pu_timed = (pu_timed OR $cbr_pu_timed(~%pu_p%~))
        OUTER_SET pu_hp = (pu_hp OR $cbr_pu_hp(~%pu_p%~))
        OUTER_SET pu_int = (pu_int OR $cbr_pu_int(~%pu_p%~))
        OUTER_SET pu_instant = (pu_instant OR $cbr_pu_instant(~%pu_p%~))
        OUTER_SET pu_badkf = (pu_badkf OR $cbr_pu_badkf(~%pu_p%~))
        ACTION_IF ($cbr_pu_dur(~%pu_p%~) > kf_dur) BEGIN
          OUTER_SET kf_dur = $cbr_pu_dur(~%pu_p%~)
        END
        OUTER_SET kf_rs = $cbr_pu_rs(~%pu_p%~)
        OUTER_SET kf_pw = $cbr_pu_pw(~%pu_p%~)
        OUTER_SPRINT pu_w $cbr_pu_wards(~%pu_p%~)
        OUTER_SPRINT pu_wards ~%pu_wards%%pu_w%~
        ACTION_IF (~%pu_p%~ STR_EQ ~POTN29~) BEGIN OUTER_SET pu_genius = 1 END
        ACTION_IF (~%pu_p%~ STR_EQ ~POTN09~) BEGIN OUTER_SET pu_is_heroism = 1 END
      END
    END
    OUTER_SPRINT pu_anchor $cbr_pu_typesig(~%pu_j%~)
    OUTER_SET pu_genius = (~%pu_anchor%~ STR_EQ ~POTN29~)
    OUTER_SET pu_is_heroism = (~%pu_anchor%~ STR_EQ ~POTN09~)
    OUTER_SET pu_ward = 0
    ACTION_PHP_EACH cbr_pu_refs AS pu_p => pu_one BEGIN
      ACTION_IF ((INDEX (CASE_INSENSITIVE EXACT_MATCH ~ %pu_p% ~ ~%pu_wards%~)) >= 0) BEGIN
        OUTER_SET pu_ward = 1
      END
    END
    // Base temporary-potion identities keep their decided controls when old
    // effects are removed. Durations here are fallbacks, not equality tests.
    ACTION_MATCH ~%pu_anchor%~ WITH
      ~POTN02~ BEGIN OUTER_SET pu_timed=1 ACTION_IF kf_dur<=0 BEGIN OUTER_SET kf_dur=600 END END
      ~POTN03~ BEGIN OUTER_SET pu_timed=1 ACTION_IF kf_dur<=0 BEGIN OUTER_SET kf_dur=600 END END
      ~POTN04~ BEGIN OUTER_SET pu_timed=1 ACTION_IF kf_dur<=0 BEGIN OUTER_SET kf_dur=600 END END
      ~POTN05~ BEGIN OUTER_SET pu_timed=1 ACTION_IF kf_dur<=0 BEGIN OUTER_SET kf_dur=600 END END
      ~POTN06~ BEGIN OUTER_SET pu_timed=1 ACTION_IF kf_dur<=0 BEGIN OUTER_SET kf_dur=600 END END
      ~POTN07~ BEGIN OUTER_SET pu_timed=1 ACTION_IF kf_dur<=0 BEGIN OUTER_SET kf_dur=600 END END
      ~POTN09~ BEGIN OUTER_SET pu_timed=1 OUTER_SET pu_hp=1 ACTION_IF kf_dur<=0 BEGIN OUTER_SET kf_dur=600 END END
      ~POTN10~ BEGIN OUTER_SET pu_timed=1 ACTION_IF kf_dur<=0 BEGIN OUTER_SET kf_dur=3600 END END
      ~POTN11~ BEGIN OUTER_SET pu_timed=1 ACTION_IF kf_dur<=0 BEGIN OUTER_SET kf_dur=300 END END
      ~POTN12~ BEGIN OUTER_SET pu_timed=1 ACTION_IF kf_dur<=0 BEGIN OUTER_SET kf_dur=600 END END
      ~POTN14~ BEGIN OUTER_SET pu_timed=1 ACTION_IF kf_dur<=0 BEGIN OUTER_SET kf_dur=300 END END
      ~POTN15~ BEGIN OUTER_SET pu_timed=1 ACTION_IF kf_dur<=0 BEGIN OUTER_SET kf_dur=7200 END END
      ~POTN16~ BEGIN OUTER_SET pu_timed=1 ACTION_IF kf_dur<=0 BEGIN OUTER_SET kf_dur=7200 END END
      ~POTN18~ BEGIN OUTER_SET pu_timed=1 ACTION_IF kf_dur<=0 BEGIN OUTER_SET kf_dur=600 END END
      ~POTN19~ BEGIN OUTER_SET pu_timed=1 ACTION_IF kf_dur<=0 BEGIN OUTER_SET kf_dur=900 END END
      ~POTN21~ BEGIN OUTER_SET pu_timed=1 ACTION_IF kf_dur<=0 BEGIN OUTER_SET kf_dur=300 END END
      ~POTN22~ BEGIN OUTER_SET pu_timed=1 ACTION_IF kf_dur<=0 BEGIN OUTER_SET kf_dur=600 END END
      ~POTN23~ BEGIN OUTER_SET pu_timed=1 ACTION_IF kf_dur<=0 BEGIN OUTER_SET kf_dur=300 END END
      ~POTN24~ BEGIN OUTER_SET pu_timed=1 ACTION_IF kf_dur<=0 BEGIN OUTER_SET kf_dur=600 END END
      ~POTN28~ BEGIN OUTER_SET pu_timed=1 ACTION_IF kf_dur<=0 BEGIN OUTER_SET kf_dur=900 END END
      ~POTN29~ BEGIN OUTER_SET pu_timed=1 ACTION_IF kf_dur<=0 BEGIN OUTER_SET kf_dur=900 END END
      ~POTN30~ BEGIN OUTER_SET pu_timed=1 ACTION_IF kf_dur<=0 BEGIN OUTER_SET kf_dur=1200 END END
      ~POTN31~ BEGIN OUTER_SET pu_timed=1 ACTION_IF kf_dur<=0 BEGIN OUTER_SET kf_dur=600 END END
      ~POTN32~ BEGIN OUTER_SET pu_timed=1 ACTION_IF kf_dur<=0 BEGIN OUTER_SET kf_dur=120 END END
      ~POTN33~ BEGIN OUTER_SET pu_timed=1 ACTION_IF kf_dur<=0 BEGIN OUTER_SET kf_dur=30 END END
      ~POTN34~ BEGIN OUTER_SET pu_timed=1 ACTION_IF kf_dur<=0 BEGIN OUTER_SET kf_dur=600 END END
      ~POTN35~ BEGIN OUTER_SET pu_timed=1 ACTION_IF kf_dur<=0 BEGIN OUTER_SET kf_dur=180 END END
      ~POTN36~ BEGIN OUTER_SET pu_timed=1 ACTION_IF kf_dur<=0 BEGIN OUTER_SET kf_dur=1260 END END
      ~POTN37~ BEGIN OUTER_SET pu_timed=1 ACTION_IF kf_dur<=0 BEGIN OUTER_SET kf_dur=3600 END END
      ~POTN38~ BEGIN OUTER_SET pu_timed=1 ACTION_IF kf_dur<=0 BEGIN OUTER_SET kf_dur=60 END END
      ~POTN39~ BEGIN OUTER_SET pu_timed=1 ACTION_IF kf_dur<=0 BEGIN OUTER_SET kf_dur=1800 END END
      ~POTN41~ BEGIN OUTER_SET pu_timed=1 OUTER_SET pu_hp=1 ACTION_IF kf_dur<=0 BEGIN OUTER_SET kf_dur=240 END END
      ~POTN42~ BEGIN OUTER_SET pu_timed=1 ACTION_IF kf_dur<=0 BEGIN OUTER_SET kf_dur=180 END END
      ~POTN43~ BEGIN OUTER_SET pu_timed=1 ACTION_IF kf_dur<=0 BEGIN OUTER_SET kf_dur=1800 END END
      ~POTN44~ BEGIN OUTER_SET pu_timed=1 ACTION_IF kf_dur<=0 BEGIN OUTER_SET kf_dur=1200 END END
      ~POTN45~ BEGIN OUTER_SET pu_timed=1 ACTION_IF kf_dur<=0 BEGIN OUTER_SET kf_dur=600 END END
      ~POTN46~ BEGIN OUTER_SET pu_timed=1 ACTION_IF kf_dur<=0 BEGIN OUTER_SET kf_dur=300 END END
      ~POTN48~ BEGIN OUTER_SET pu_timed=1 ACTION_IF kf_dur<=0 BEGIN OUTER_SET kf_dur=60 END END
      ~POTN56~ BEGIN OUTER_SET pu_timed=1 ACTION_IF kf_dur<=0 BEGIN OUTER_SET kf_dur=600 END END
      ~POTN60~ BEGIN OUTER_SET pu_timed=1 ACTION_IF kf_dur<=0 BEGIN OUTER_SET kf_dur=900 END END
      DEFAULT END
    OUTER_SET pu_kf_ok=1
    ACTION_IF pu_is_heroism BEGIN
      OUTER_SET pu_heroism_type = pu_j
      OUTER_SPRINT pu_heroism_members ~%pu_members%~
      OUTER_SET pu_heroism_ok = pu_kf_ok
      OUTER_SET pu_heroism_timed = pu_timed
      OUTER_SET pu_heroism_dur = kf_dur
      OUTER_SET pu_heroism_rs = kf_rs
      OUTER_SET pu_heroism_pw = kf_pw
    END

    ACTION_IF (potions AND pu_timed) BEGIN
      ACTION_IF (genius_exempt AND pu_genius) BEGIN
        PRINT @3302
      END ELSE ACTION_IF pu_hp BEGIN
          OUTER_SPRINT kf_symbol ~CBR_POTION_%pu_anchor%~
          OUTER_PATCH_SAVE kf_symbol ~%kf_symbol%~ BEGIN
            REPLACE_TEXTUALLY ~[^A-Za-z0-9_]~ ~_~
          END
          LAM cbr_pu_allocate_state
          ACTION_PHP_EACH cbr_pu_refs AS pu_p => pu_one BEGIN
            OUTER_SPRINT pu_own ~%pu_p%~
            COPY_EXISTING ~%pu_p%.itm~ ~override~
              LPM cbr_pu_patch_keep_first
            BUT_ONLY
          END
          OUTER_SET pu_count_keep = pu_count_keep + 1
      END ELSE BEGIN
        ACTION_PHP_EACH cbr_pu_potion AS pu_p => pu_one BEGIN
          ACTION_IF $cbr_pu_type(~%pu_p%~)=pu_j BEGIN
            OUTER_SPRINT links $cbr_pu_links(~%pu_p%~)
            OUTER_PATCH ~%links%~ BEGIN REPLACE_EVALUATE ~[^ ]+~ BEGIN SET $cbr_pu_refs(~%MATCH0%~)=1 END ~%MATCH0%~ END
          END
        END
        ACTION_PHP_EACH cbr_pu_potion AS pu_p => pu_one BEGIN
          ACTION_IF $cbr_pu_type(~%pu_p%~)=pu_j BEGIN
            OUTER_SPRINT pu_own ~%pu_p%~
            COPY_EXISTING ~%pu_p%.itm~ ~override~ LPM cbr_pu_patch_refresh BUT_ONLY
          END
        END
        OUTER_SET pu_count_refresh = pu_count_refresh + 1
      END
    END
  END

  ACTION_IF potions BEGIN
    PRINT @3304
  END

  ACTION_IF heroism BEGIN
    OUTER_SPRINT kf_symbol ~CBR_HEROISM_FAMILY~
    LAM cbr_pu_allocate_state
    // The Potion of Heroism and its copies.
    ACTION_IF (pu_heroism_type >= 0) BEGIN
      ACTION_IF 1 BEGIN
        OUTER_SET kf_dur = pu_heroism_dur
        OUTER_SET kf_rs = pu_heroism_rs
        OUTER_SET kf_pw = pu_heroism_pw
        ACTION_PHP_EACH cbr_pu_potion AS pu_p => pu_one BEGIN
          ACTION_IF ((INDEX (CASE_INSENSITIVE EXACT_MATCH ~ %pu_p% ~ ~%pu_heroism_members%~)) >= 0) BEGIN
            OUTER_SPRINT pu_own ~%pu_p%~
            COPY_EXISTING ~%pu_p%.itm~ ~override~
              LPM cbr_pu_patch_keep_first
            BUT_ONLY
            OUTER_SET pu_count_family = pu_count_family + 1
          END
        END
      END
    END
    // Heroism, Greater Heroism and their copies.
    OUTER_SET item_mode = 0
    OUTER_SET follow_links = 0
    ACTION_PHP_EACH cbr_pu_family_spell AS pu_r => pu_one BEGIN
      OUTER_SPRINT pu_own ~%pu_r%~
      COPY_EXISTING ~%pu_r%.spl~ ~override~ LPM cbr_pu_patch_keep_first BUT_ONLY
      OUTER_SET pu_count_family += 1
    END
    OUTER_SET item_mode = 1
    OUTER_SET follow_links = 1

    OUTER_SPRINT pu_old_text ~This spell and Heroism are non-cumulative with each other, and the more recently applied spell will remove the effects of the other.~
    OUTER_SPRINT pu_new_text @3310
    OUTER_SET item_mode=0
    ACTION_PHP_EACH cbr_pu_family_spell AS pu_r => pu_one BEGIN
      OUTER_SPRINT pu_description_kind ~heroism~
      ACTION_IF (~%pu_r%~ STR_EQ ~C0BW502~) OR (~%pu_r%~ STR_EQ ~C0GA502~) BEGIN OUTER_SPRINT pu_description_kind ~greater~ END
      COPY_EXISTING ~%pu_r%.spl~ ~override~
        LPM cbr_pu_fix_description
      BUT_ONLY
    END
    OUTER_SET item_mode=1
    ACTION_PHP_EACH cbr_pu_scroll AS pu_r => pu_one BEGIN
      OUTER_SPRINT pu_description_kind ~heroism~
      ACTION_IF (~%pu_one%~ STR_EQ ~C0BW502~) OR (~%pu_one%~ STR_EQ ~C0GA502~) BEGIN OUTER_SPRINT pu_description_kind ~greater~ END
      COPY_EXISTING ~%pu_r%.itm~ ~override~
        LPM cbr_pu_fix_description
      BUT_ONLY
    END
    PRINT @3307
  END
END
