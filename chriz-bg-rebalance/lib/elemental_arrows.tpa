DEFINE_PATCH_FUNCTION cbr_elemental_arrow
  INT_VAR damage_type=0 elemental_size=0 remove_bonus=0 apply=1
  STR_VAR element=~~
BEGIN
  PATCH_IF apply BEGIN
    READ_ASCII 0 original (BUFFER_LENGTH)
    LPF cbr_cea_layout RET ab na fx eq_first eq_count readable END
    PATCH_IF readable BEGIN
      LPF cbr_cea_template STR_VAR item = EVAL ~%SOURCE_RES%~ RET template_ability = ability template_effect = effect description name END
      WRITE_SHORT 0x1c 5
      SET bow_count = 0
      FOR (i=0; i<na; ++i) BEGIN
        LPF cbr_elemental_arrow_owned INT_VAR ability_at = ab + i*0x38 RET owned END
        SET bow_count += owned
      END
      PATCH_IF bow_count = 0 BEGIN
        SET new_ab = BUFFER_LENGTH
        SPRINT old_abilities ~~
        PATCH_IF na > 0 BEGIN READ_ASCII ab old_abilities (na * 0x38) END
        INSERT_BYTES new_ab ((na+1)*0x38)
        WRITE_ASCIIE new_ab ~%old_abilities%~ (na*0x38)
        WRITE_ASCIIE (new_ab+na*0x38) ~%template_ability%~ (0x38)
        SET ab = new_ab SET na += 1 WRITE_LONG 0x64 ab WRITE_SHORT 0x68 na
      END
      FOR (i=0; i<na AND readable; ++i) BEGIN
        READ_LONG 0x64 ab SET at = ab+i*0x38
        LPF cbr_elemental_arrow_owned INT_VAR ability_at=at RET owned END
        PATCH_IF owned BEGIN
          READ_SHORT (at+0x1e) count READ_SHORT (at+0x20) first
          SET found = 0 SET package = 0 SET new_count = 0 SPRINT slice ~~
          FOR (j=0; j<count; ++j) BEGIN
            SET ef = fx+(first+j)*0x30
            READ_SHORT ef op READ_BYTE (ef+2) target READ_LONG (ef+8) type
            SET mine = op = 12 AND target = 2 AND type = damage_type * 65536
            PATCH_IF mine BEGIN SET found += 1 END
            PATCH_IF NOT mine OR found = 1 BEGIN
              READ_ASCII ef record (0x30)
              PATCH_IF mine BEGIN
                SET package = ef
                INNER_PATCH_SAVE record ~%record%~ BEGIN WRITE_LONG 0x1c 1 WRITE_LONG 0x20 elemental_size END
              END
              SPRINT slice ~%slice%%record%~ SET new_count += 1
            END
          END
          PATCH_IF found = 0 BEGIN
            INNER_PATCH_SAVE record ~%template_effect%~ BEGIN WRITE_LONG 0x1c 1 WRITE_LONG 0x20 elemental_size END
            SPRINT slice ~%slice%%record%~ SET new_count += 1
          END
          SET shared = 0
          PATCH_IF found = 1 BEGIN
            LPF cbr_elemental_arrow_foreign_ref INT_VAR ability_offset=ab ability_count=na self=i record=(package - fx)/0x30 RET shared END
          END
          PATCH_IF found = 1 AND NOT shared BEGIN
            WRITE_LONG (package+0x1c) 1 WRITE_LONG (package+0x20) elemental_size
          END ELSE BEGIN
            LPF cbr_cea_effect_end RET end_index = effect_end END
            SET readable = end_index <= 0xffff AND new_count <= 0xffff
            PATCH_IF readable BEGIN
              SET destination = fx+end_index*0x30
              INSERT_BYTES destination (new_count*0x30) WRITE_ASCIIE destination ~%slice%~ (new_count*0x30)
              PATCH_IF ab >= destination BEGIN SET ab += new_count*0x30 WRITE_LONG 0x64 ab END
              SET at = ab+i*0x38 WRITE_SHORT (at+0x1e) new_count WRITE_SHORT (at+0x20) end_index
            END
          END
          PATCH_IF remove_bonus AND readable BEGIN WRITE_SHORT (at+0x14) 0 WRITE_SHORT (at+0x1a) 0 END
        END
      END
      PATCH_IF readable BEGIN
        PATCH_IF ~%EE_LANGUAGE%~ STRING_EQUAL_CASE ~en_us~ BEGIN
          SAY DESC ~%description%~
          PATCH_IF remove_bonus BEGIN SAY NAME2 ~%name%~ END
        END ELSE BEGIN PATCH_PRINT ~Elemental arrows: no %EE_LANGUAGE% translation; existing text retained for %SOURCE_RES%.~ END
      END ELSE BEGIN
        DELETE_BYTES 0 BUFFER_LENGTH INSERT_BYTES 0 (STRING_LENGTH ~%original%~) WRITE_ASCIIE 0 ~%original%~
        PATCH_PRINT ~Elemental arrows: %SOURCE_RES% has no representable effect-slice address; only this item is unchanged.~
      END
    END
  END
END

DEFINE_ACTION_FUNCTION cbr_elemental_arrows
  INT_VAR apply=0
BEGIN
  ACTION_IF apply BEGIN
    ACTION_FOR_EACH item IN AROW04 AROW09 AROW08 AROWKC BEGIN
      ACTION_IF FILE_EXISTS_IN_GAME ~%item%.ITM~ BEGIN
        OUTER_SET damage_type = 8 OUTER_SET elemental_size = 2 OUTER_SET remove_bonus = 1
        ACTION_IF ~%item%~ STR_EQ ~AROW04~ BEGIN OUTER_SET damage_type=1 OUTER_SET elemental_size=3 OUTER_SET remove_bonus=0 END
        ACTION_IF ~%item%~ STR_EQ ~AROW09~ BEGIN OUTER_SET damage_type=2 OUTER_SET remove_bonus=0 END
        COPY_EXISTING ~%item%.ITM~ ~override~
          LPF cbr_elemental_arrow INT_VAR damage_type elemental_size remove_bonus END
          BUT_ONLY
      END ELSE BEGIN PRINT ~Elemental arrows: optional item %item%.ITM is absent; continuing with the remaining arrows.~ END
    END
  END
END

LAF cbr_elemental_arrows INT_VAR apply=1 END
