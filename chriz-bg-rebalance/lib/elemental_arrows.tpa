// Component 130 owns one elemental dice package on each bow-fired header,
// fire hit/damage bonuses and complete English descriptions. Foreign abilities
// and riders remain intact. Missing owned effects/headers are supplied.

DEFINE_PATCH_FUNCTION cbr_cea_layout
  INT_VAR stride = 0x38 log_errors = 1
  RET ab na fx eq_first eq_count readable
BEGIN
  SET ab = 0 SET na = 0 SET fx = 0 SET eq_first = 0 SET eq_count = 0
  SET readable = BUFFER_LENGTH >= 0x72
  PATCH_IF readable BEGIN
    READ_LONG 0x64 ab READ_SHORT 0x68 na READ_LONG 0x6a fx
    READ_SHORT 0x6e eq_first READ_SHORT 0x70 eq_count
    SET readable = (na = 0 OR (ab >= 0x72 AND ab <= BUFFER_LENGTH
      AND na <= (BUFFER_LENGTH - ab) / stride)) AND fx >= 0x72 AND fx <= BUFFER_LENGTH
    PATCH_IF readable BEGIN
      SET available = (BUFFER_LENGTH - fx) / 0x30
      PATCH_IF eq_count > 0 AND eq_first + eq_count > available BEGIN SET readable = 0 END
      FOR (a = 0; a < na; ++a) BEGIN
        READ_SHORT (ab + a * stride + 0x1e) n
        READ_SHORT (ab + a * stride + 0x20) first
        PATCH_IF n > 0 AND first + n > available BEGIN SET readable = 0 END
      END
      // Tables may be in either order, but referenced records cannot overlap.
      PATCH_IF na > 0 AND fx >= ab AND fx < ab + na * stride BEGIN SET readable = 0 END
      PATCH_IF na > 0 AND fx < ab BEGIN
        PATCH_IF eq_count > 0 AND fx + (eq_first + eq_count) * 0x30 > ab BEGIN SET readable = 0 END
        FOR (a = 0; a < na; ++a) BEGIN
          READ_SHORT (ab + a * stride + 0x1e) n READ_SHORT (ab + a * stride + 0x20) first
          PATCH_IF n > 0 AND fx + (first + n) * 0x30 > ab BEGIN SET readable = 0 END
        END
      END
    END
  END
  PATCH_IF NOT readable AND log_errors BEGIN
    PATCH_PRINT ~Elemental arrows: %SOURCE_FILE% has unreadable resource bounds; leaving this file alone.~
  END
END


DEFINE_PATCH_FUNCTION cbr_cea_effect_end
  RET effect_end
BEGIN
  READ_LONG 0x64 table READ_SHORT 0x68 abilities
  READ_SHORT 0x6e first READ_SHORT 0x70 count
  SET effect_end = 0
  PATCH_IF count > 0 BEGIN SET effect_end = first + count END
  FOR (i = 0; i < abilities; ++i) BEGIN
    READ_SHORT (table + i * 0x38 + 0x1e) count
    READ_SHORT (table + i * 0x38 + 0x20) first
    PATCH_IF count > 0 AND first + count > effect_end BEGIN SET effect_end = first + count END
  END
END


DEFINE_PATCH_FUNCTION cbr_elemental_arrow_owned
    INT_VAR ability_at=0
    RET owned
BEGIN
    READ_BYTE ability_at cea_kind
    READ_BYTE (ability_at+0x10) cea_launcher
    SET owned = (cea_kind = 2 AND cea_launcher = 1) ? 1 : 0
END

// 1 if effect record index `record` is read by the equipped-effect slice or
// by the slice of any extended header other than `self` that is not owned.
DEFINE_PATCH_FUNCTION cbr_elemental_arrow_foreign_ref
    INT_VAR ability_offset=0 ability_count=0 self=0 record=0
    RET shared
BEGIN
    SET shared = 0
    READ_SHORT 0x6e cea_ref_first
    READ_SHORT 0x70 cea_ref_count
    PATCH_IF record >= cea_ref_first AND record < cea_ref_first + cea_ref_count BEGIN
        SET shared = 1
    END
    FOR (cea_k=0; cea_k<ability_count; cea_k+=1) BEGIN
        PATCH_IF cea_k != self BEGIN
            SET cea_b = ability_offset + cea_k * 0x38
            LPF cbr_elemental_arrow_owned INT_VAR ability_at=cea_b RET cea_b_owned=owned END
            READ_SHORT (cea_b+0x1e) cea_ref_count
            READ_SHORT (cea_b+0x20) cea_ref_first
            PATCH_IF NOT cea_b_owned AND
                record >= cea_ref_first AND record < cea_ref_first + cea_ref_count BEGIN
                SET shared = 1
            END
        END
    END
END

