// Component 110: identity-scoped runtime activation for five SCS dragons.
// Research: research/14-dragon-runtime-scope.md. No CRE/weapon stat edits.

DEFINE_PATCH_FUNCTION cbr_dragon_vorpal_prefix
  INT_VAR apply = 0
  STR_VAR actor = ~~ package = ~~ script_name = ~~ expected_actor = ~~
  RET changed
BEGIN

  SET changed = 0
  SET readable = BUFFER_LENGTH >= 6
  PATCH_IF readable BEGIN
    READ_ASCII 0 signature (3) READ_ASCII (BUFFER_LENGTH - 3) tail (3)
    SET readable = (~%signature%~ STR_EQ ~SC%LNL%~) AND (~%tail%~ STR_EQ ~SC%LNL%~)
  END
  PATCH_IF readable BEGIN
  // Choose the existing difficulty address; missing/mixed controls do not veto
  // our prefix. GLOBAL wins when both occur; otherwise use SCS's INI address.
  SET cbr_dv_global = INDEX_BUFFER (~TR%LNL%16399 [-0-9]+ [01] 0 0 "GLOBALDMWW_dragon_difficulty" "" OB~) >= 0
  PATCH_IF cbr_dv_global BEGIN
    SPRINT cbr_dv_category_0 ~Global("DMWW_dragon_difficulty","GLOBAL",0)~
    SPRINT cbr_dv_category_5 ~Global("DMWW_dragon_difficulty","GLOBAL",5)~
    SPRINT cbr_dv_category_6 ~Global("DMWW_dragon_difficulty","GLOBAL",6)~
    SPRINT cbr_dv_category_7 ~Global("DMWW_dragon_difficulty","GLOBAL",7)~
  END ELSE BEGIN
    SPRINT cbr_dv_category_0 ~INI("DMWW_dragon_difficulty",0)~
    SPRINT cbr_dv_category_5 ~INI("DMWW_dragon_difficulty",5)~
    SPRINT cbr_dv_category_6 ~INI("DMWW_dragon_difficulty",6)~
    SPRINT cbr_dv_category_7 ~INI("DMWW_dragon_difficulty",7)~
  END
  // Generated in memory; no upstream BAF source is edited. Four disjoint
  // transitions handle explicit category values and the game-slider fallback.
  SPRINT cbr_dv_baf ~
IF
  Name("%actor%",Myself)
  Global("CBR_DV_ACTIVE","LOCALS",0)
  OR(3)
    %cbr_dv_category_5%
    %cbr_dv_category_6%
    %cbr_dv_category_7%
THEN
  RESPONSE #100
    ApplySpellRES("%package%",Myself)
    SetGlobal("CBR_DV_ACTIVE","LOCALS",1)
    Continue()
END
IF
  Name("%actor%",Myself)
  Global("CBR_DV_ACTIVE","LOCALS",0)
  %cbr_dv_category_0%
  DifficultyGT(3)
  DifficultyLT(6)
THEN
  RESPONSE #100
    ApplySpellRES("%package%",Myself)
    SetGlobal("CBR_DV_ACTIVE","LOCALS",1)
    Continue()
END
IF
  Name("%actor%",Myself)
  Global("CBR_DV_ACTIVE","LOCALS",1)
  !%cbr_dv_category_0%
  !%cbr_dv_category_5%
  !%cbr_dv_category_6%
  !%cbr_dv_category_7%
THEN
  RESPONSE #100
    ApplySpellRES("CBRDVREM",Myself)
    SetGlobal("CBR_DV_ACTIVE","LOCALS",0)
    Continue()
END
IF
  Name("%actor%",Myself)
  Global("CBR_DV_ACTIVE","LOCALS",1)
  %cbr_dv_category_0%
  OR(2)
    DifficultyLT(4)
    DifficultyGT(5)
THEN
  RESPONSE #100
    ApplySpellRES("CBRDVREM",Myself)
    SetGlobal("CBR_DV_ACTIVE","LOCALS",0)
    Continue()
END
~
  INNER_PATCH_SAVE cbr_dv_prefix ~%cbr_dv_baf%~ BEGIN
    COMPILE_BAF_TO_BCS
    DELETE_BYTES (BUFFER_LENGTH - 3) 3
    DELETE_BYTES 0 3
  END

  READ_ASCII 0 previous (BUFFER_LENGTH)
  SPRINT result ~SC%LNL%%cbr_dv_prefix%~ SET cursor = 3
  WHILE cursor < BUFFER_LENGTH - 3 AND readable BEGIN
    SET finish = INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~RS%LNL%CR%LNL%~ cursor)
    PATCH_IF finish < 0 BEGIN SET readable = 0 END ELSE BEGIN
      SET finish += 6 READ_ASCII cursor block (finish - cursor)
      SET owned = 0
      INNER_PATCH ~%block%~ BEGIN
        SET owned = INDEX_BUFFER (CASE_INSENSITIVE ~CBR_DV_ACTIVE\|CBRDVREM\|CBRDV05\|CBRDV10\|CBRDV15~) >= 0
          AND (INDEX_BUFFER (CASE_INSENSITIVE EXACT_MATCH ~"%actor%"~) >= 0
            OR INDEX_BUFFER (CASE_INSENSITIVE EXACT_MATCH ~"%expected_actor%"~) >= 0)
      END
      PATCH_IF NOT owned BEGIN SPRINT result ~%result%%block%~ END
      SET cursor = finish
    END
  END
  PATCH_IF readable BEGIN
    SPRINT result ~%result%SC%LNL%~ SET changed = NOT (~%previous%~ STR_EQ ~%result%~)
    PATCH_IF apply BEGIN DELETE_BYTES 0 BUFFER_LENGTH INSERT_BYTES 0 (STRING_LENGTH ~%result%~) WRITE_ASCIIE 0 ~%result%~ END
  END
  END
  PATCH_IF NOT readable BEGIN PATCH_PRINT ~CBR 110: %script_name% has unreadable BCS bounds; only this script is unchanged.~ END
END

DEFINE_ACTION_FUNCTION cbr_dragon_vorpal_roster
  RET_ARRAY cbr_dv_roster
BEGIN
  ACTION_DEFINE_ASSOCIATIVE_ARRAY cbr_dv_roster BEGIN
    ~firkra02~ => ~dragred firkra02 CBRDV15~
    ~shadra01~ => ~shadra01 ShaDra01 CBRDV05~
    ~dragblac~ => ~dragblac Dragblac CBRDV10~
    ~gorsal~   => ~gorsal GorSal CBRDV10~
    ~fsdragon~ => ~draggree FSdragon CBRDV05~
  END
END


<<<<<<<< cbr_dv_empty
SC
SC
>>>>>>>>

// Retain the legacy preflight entry point as a no-op. Apply handles each target
// independently and publishes only the decided prefix plus needed addresses.
DEFINE_ACTION_FUNCTION cbr_apply_dragon_vorpal_scripts
  INT_VAR apply = 0
BEGIN
  ACTION_IF apply BEGIN
    LAF cbr_dragon_vorpal_roster RET_ARRAY cbr_dv_roster END
    ACTION_PHP_EACH cbr_dv_roster AS cbr_dv_cre => cbr_dv_row BEGIN
      OUTER_INNER_PATCH ~%cbr_dv_row%~ BEGIN
        READ_2DA_ENTRY 0 0 3 cbr_dv_script
        READ_2DA_ENTRY 0 1 3 cbr_dv_actor
        READ_2DA_ENTRY 0 2 3 cbr_dv_package
      END
      OUTER_SET cbr_dv_slot = 0x250
      ACTION_IF ~%cbr_dv_cre%~ STR_EQ ~shadra01~ BEGIN OUTER_SET cbr_dv_slot = 0x248 END
      ACTION_IF ~%cbr_dv_cre%~ STR_EQ ~gorsal~ BEGIN OUTER_SET cbr_dv_slot = 0x268 END
      ACTION_IF FILE_EXISTS_IN_GAME ~%cbr_dv_cre%.CRE~ BEGIN
        COPY_EXISTING ~%cbr_dv_cre%.CRE~ ~override~
          SET cbr_dv_readable = BUFFER_LENGTH >= 0x2d4
          PATCH_IF cbr_dv_readable BEGIN
            READ_ASCII 0x280 cbr_dv_actual_actor (32) NULL
            READ_ASCII cbr_dv_slot cbr_dv_actual_script (8) NULL
            PATCH_IF ~%cbr_dv_actual_actor%~ STR_EQ ~~ BEGIN SPRINT cbr_dv_actual_actor ~%cbr_dv_actor%~ WRITE_ASCIIE 0x280 ~%cbr_dv_actor%~ #32 END
            PATCH_IF ~%cbr_dv_actual_script%~ STR_EQ ~~ BEGIN SPRINT cbr_dv_actual_script ~%cbr_dv_script%~ WRITE_ASCIIE cbr_dv_slot ~%cbr_dv_script%~ #8 END
          END ELSE BEGIN PATCH_PRINT ~CBR 110: %cbr_dv_cre% has unreadable CRE bounds; only this creature is unchanged.~ END
          BUT_ONLY
        ACTION_IF cbr_dv_readable BEGIN
          ACTION_IF NOT FILE_EXISTS_IN_GAME ~%cbr_dv_actual_script%.BCS~ BEGIN COPY ~cbr_dv_empty~ ~override/%cbr_dv_actual_script%.BCS~ END
          COPY_EXISTING ~%cbr_dv_actual_script%.BCS~ ~override~
            LPF cbr_dragon_vorpal_prefix INT_VAR apply = 1
              STR_VAR actor = EVAL ~%cbr_dv_actual_actor%~ expected_actor = EVAL ~%cbr_dv_actor%~
                package = EVAL ~%cbr_dv_package%~ script_name = EVAL ~%cbr_dv_actual_script%~ END
            BUT_ONLY
        END
      END ELSE BEGIN PRINT ~CBR 110: optional creature %cbr_dv_cre% is absent; continuing with the remaining dragons.~ END
    END
  END
END
