// SR anti-magic: own the recipient MR / spell-failure package and its full
// English descriptions. Delivery wrappers, Spell Shield and other effects stay.
DEFINE_PATCH_MACRO cbr_am_layout
BEGIN
  SET am_readable = BUFFER_LENGTH >= 0x72
  PATCH_IF am_readable BEGIN
    READ_LONG 0x64 am_ab READ_SHORT 0x68 am_nab
    READ_LONG 0x6a am_fx READ_SHORT 0x6e am_cf READ_SHORT 0x70 am_nc
    SET am_readable = am_ab >= 0x72 AND am_ab + 40 * am_nab <= BUFFER_LENGTH
      AND am_fx >= 0x72 AND am_fx <= BUFFER_LENGTH
    SET am_total = am_cf + am_nc
    FOR (am_a = 0; am_readable AND am_a < am_nab; ++am_a) BEGIN
      READ_SHORT (am_ab + 40 * am_a + 0x1e) am_n
      READ_SHORT (am_ab + 40 * am_a + 0x20) am_first
      SET am_total = (am_total > am_first + am_n ? am_total : am_first + am_n)
    END
    SET am_readable = am_readable AND am_fx + 48 * am_total <= BUFFER_LENGTH
  END
  PATCH_IF am_readable BEGIN
    READ_ASCII (am_fx + 48 * am_cf) am_cast (48 * am_nc)
    FOR (am_a = 0; am_a < am_nab; ++am_a) BEGIN
      READ_ASCII (am_ab + 40 * am_a) $am_header(~%am_a%~) (40)
      READ_SHORT (am_ab + 40 * am_a + 0x1e) am_n
      READ_SHORT (am_ab + 40 * am_a + 0x20) am_first
      READ_ASCII (am_fx + 48 * am_first) $am_effects(~%am_a%~) (48 * am_n)
    END
  END
END

DEFINE_PATCH_FUNCTION cbr_sr_pierce_magic_patch
  RET am_readable
BEGIN
  LPM cbr_am_layout
  PATCH_IF am_readable BEGIN
    PATCH_IF am_nab = 0 BEGIN
      SET am_nab = 1
      INNER_PATCH_SAVE $am_header(~0~) ~~ BEGIN
        INSERT_BYTES 0 40 WRITE_BYTE 0 1 WRITE_BYTE 0xc 2 WRITE_BYTE 0xd 1
        WRITE_SHORT 0xe 40 WRITE_SHORT 0x10 1 WRITE_SHORT 0x26 1
      END
      SPRINT $am_effects(~0~) ~~
    END
    DELETE_BYTES 0x72 (BUFFER_LENGTH - 0x72)
    INSERT_BYTES 0x72 (40 * am_nab)
    SET am_fx = BUFFER_LENGTH INSERT_BYTES am_fx (48 * am_nc)
    WRITE_ASCIIE am_fx ~%am_cast%~ (48 * am_nc)
    WRITE_LONG 0x64 0x72 WRITE_SHORT 0x68 am_nab
    WRITE_LONG 0x6a am_fx WRITE_SHORT 0x6e 0
    SET am_out = am_nc
    FOR (am_a = 0; am_a < am_nab; ++am_a) BEGIN
      SPRINT am_raw $am_header(~%am_a%~)
      WRITE_ASCIIE (0x72 + 40 * am_a) ~%am_raw%~ (40)
      WRITE_SHORT (0x72 + 40 * am_a + 0x20) am_out
      SPRINT am_raw $am_effects(~%am_a%~)
      INNER_PATCH_SAVE pm_donor ~~ BEGIN
        INSERT_BYTES 0 48 WRITE_BYTE 0xd 2 WRITE_BYTE 0x12 100
      END
      SPRINT pm_strip_donor ~%pm_donor%~
      SET pm_have_mr = 0 SET pm_have_strip = 0
      INNER_PATCH ~%am_raw%~ BEGIN
        FOR (am_at = 0; am_at < BUFFER_LENGTH; am_at += 48) BEGIN
          READ_SHORT am_at pm_op READ_LONG (am_at + 8) pm_mode
          READ_ASCII (am_at + 20) pm_res (8) NULL
          PATCH_IF NOT pm_have_mr AND (pm_op = 166
            OR (pm_op = 402 AND ~%pm_res%~ STRING_EQUAL_CASE ~CBRPM~)) BEGIN
            READ_ASCII am_at pm_donor (48) SET pm_have_mr = 1
          END
          PATCH_IF NOT pm_have_strip AND pm_op = 230 AND pm_mode = 1 BEGIN
            READ_ASCII am_at pm_strip_donor (48) SET pm_have_strip = 1
          END
        END
      END
      // Impact-time MR is measured before removing protections.
      INNER_PATCH_SAVE pm_result ~%pm_donor%~ BEGIN
        WRITE_SHORT 0 402 WRITE_BYTE 2 2 WRITE_LONG 4 0 WRITE_LONG 8 0
        WRITE_BYTE 12 1 WRITE_BYTE 13 2 WRITE_LONG 14 0
        WRITE_BYTE 18 100 WRITE_BYTE 19 0 WRITE_ASCII 20 ~CBRPM~ #8
        READ_LONG 36 pm_save WRITE_LONG 36 (pm_save BAND 0xffffffe0)
      END
      INNER_PATCH_SAVE pm_strip_donor ~%pm_strip_donor%~ BEGIN
        WRITE_SHORT 0 230 WRITE_BYTE 2 2 WRITE_LONG 4 8 WRITE_LONG 8 1
        WRITE_BYTE 12 1 WRITE_BYTE 13 2 WRITE_LONG 14 0
        WRITE_BYTE 18 100 WRITE_BYTE 19 0
        READ_LONG 36 pm_save WRITE_LONG 36 (pm_save BAND 0xffffffe0)
      END
      SET pm_wrote_strip = 0
      INNER_PATCH ~%am_raw%~ BEGIN SET pm_count = BUFFER_LENGTH / 48 END
      FOR (pm_i = 0; pm_i <= pm_count; ++pm_i) BEGIN
        SET pm_op = 0 - 1 SET pm_mode = 0 SPRINT pm_res ~~
        PATCH_IF pm_i < pm_count BEGIN
          INNER_PATCH ~%am_raw%~ BEGIN
            SET am_at = pm_i * 48
            READ_SHORT am_at pm_op READ_LONG (am_at + 8) pm_mode
            READ_ASCII (am_at + 20) pm_res (8) NULL
            READ_ASCII am_at pm_record (48)
          END
        END
        SET pm_strip = pm_op = 230 AND pm_mode = 1
        PATCH_IF NOT pm_wrote_strip AND (pm_strip OR pm_i = pm_count) BEGIN
          INNER_PATCH_SAVE pm_result ~%pm_result%~ BEGIN
            SET am_at = BUFFER_LENGTH INSERT_BYTES am_at 48
            WRITE_ASCIIE am_at ~%pm_strip_donor%~ (48)
          END
          SET pm_wrote_strip = 1
        END
        PATCH_IF pm_i < pm_count AND NOT pm_strip AND pm_op != 166
          AND NOT (pm_op = 402 AND ~%pm_res%~ STRING_EQUAL_CASE ~CBRPM~)
          AND NOT (pm_op = 142 AND pm_mode = 106)
          AND NOT (pm_op = 174 AND ~%pm_res%~ STRING_EQUAL_CASE ~EFF_E06~) BEGIN
          INNER_PATCH_SAVE pm_result ~%pm_result%~ BEGIN
            SET am_at = BUFFER_LENGTH INSERT_BYTES am_at 48
            WRITE_ASCIIE am_at ~%pm_record%~ (48)
          END
        END
      END
      INNER_PATCH ~%pm_result%~ BEGIN SET pm_length = BUFFER_LENGTH END
      SET am_at = BUFFER_LENGTH INSERT_BYTES am_at pm_length
      WRITE_ASCIIE am_at ~%pm_result%~ (pm_length)
      WRITE_SHORT (0x72 + 40 * am_a + 0x1e) (pm_length / 48)
      SET am_out += pm_length / 48
    END
  END ELSE BEGIN
    PATCH_PRINT ~CBR Pierce Magic: unreadable spell tables; leaving this file unchanged.~
  END
END

// Walk actual delivery links. Every mechanical payload and every non-Shield
// leaf receives the package, even when all its old effects have been removed.
// Visited identities terminate cycles; absent resources cost only that target.
DEFINE_ACTION_MACRO cbr_am_discover
BEGIN
  ACTION_IF component = 210 BEGIN OUTER_SPRINT am_symbol ~WIZARD_PIERCE_MAGIC~ END
  ELSE ACTION_IF component = 211 BEGIN OUTER_SPRINT am_symbol ~WIZARD_SPELL_STRIKE~ END
  ELSE BEGIN FAIL ~CBR anti-magic: unknown component argument.~ END
  ACTION_CLEAR_ARRAY am_srcs ACTION_CLEAR_ARRAY am_payloads ACTION_CLEAR_ARRAY am_queue
  OUTER_SET am_available = 0 OUTER_SET am_id = 0 - 1
  ACTION_IF FILE_EXISTS_IN_GAME ~spell.ids~ BEGIN
    OUTER_SET am_id = IDS_OF_SYMBOL (~spell~ ~%am_symbol%~)
  END
  ACTION_IF am_id >= 2000 AND am_id < 3000 BEGIN
    OUTER_SET am_slot = am_id - 2000 OUTER_SPRINT am_parent ~SPWI%am_slot%~
    ACTION_IF am_slot < 100 BEGIN OUTER_SPRINT am_parent ~SPWI0%am_slot%~ END
    ACTION_IF am_slot < 10 BEGIN OUTER_SPRINT am_parent ~SPWI00%am_slot%~ END
    ACTION_IF FILE_EXISTS_IN_GAME ~%am_parent%.spl~ BEGIN
      OUTER_SET am_available = 1 OUTER_SET am_any_payload = 0 OUTER_SET am_missing = 0
      OUTER_SPRINT $am_queue(~0~) ~%am_parent%~ OUTER_SET am_queued = 1
      OUTER_FOR (am_q = 0; am_q < am_queued; ++am_q) BEGIN
        OUTER_SPRINT am_current $am_queue(~%am_q%~)
        ACTION_IF NOT VARIABLE_IS_SET $am_srcs(~%am_current%~) BEGIN
          OUTER_SET $am_srcs(~%am_current%~) = 1
          ACTION_IF FILE_EXISTS_IN_GAME ~%am_current%.spl~ BEGIN
            COPY_EXISTING - ~%am_current%.spl~ ~override~
              LPM cbr_am_layout
              PATCH_IF am_readable BEGIN
                SET am_links = 0 SET am_mechanic = 0 SET am_shield = 0
                FOR (am_a = 0; am_a < am_nab; ++am_a) BEGIN
                  SPRINT am_raw $am_effects(~%am_a%~)
                  INNER_PATCH ~%am_raw%~ BEGIN
                    FOR (am_at = 0; am_at < BUFFER_LENGTH; am_at += 48) BEGIN
                      READ_SHORT am_at am_op READ_LONG (am_at + 8) am_mode
                      READ_ASCII (am_at + 20) am_res (8) NULL TO_UPPER am_res
                      PATCH_IF am_op = 221 AND am_mode = 19 BEGIN SET am_shield = 1 END
                      PATCH_IF (component = 210 AND (am_op = 166 OR am_op = 230
                        OR (am_op = 402 AND ~%am_res%~ STRING_EQUAL_CASE ~CBRPM~)))
                        OR (component = 211 AND (am_op = 60 OR (am_op = 221 AND am_mode = 1))) BEGIN
                        SET am_mechanic = 1
                      END
                      PATCH_IF (am_op = 146 OR am_op = 148) AND NOT (~%am_res%~ STRING_EQUAL ~~) BEGIN
                        SET am_links = 1
                        SPRINT $am_queue(~%am_queued%~) ~%am_res%~ SET am_queued += 1
                      END
                    END
                  END
                END
                PATCH_IF am_mechanic OR (NOT am_links AND NOT am_shield) BEGIN
                  SET $am_payloads(~%am_current%~) = 1 SET am_any_payload = 1
                END
              END ELSE BEGIN
                PATCH_PRINT ~CBR anti-magic: %am_current%.spl has unreadable tables; continuing.~
                SET am_missing = 1
                PATCH_IF ~%am_current%~ STRING_EQUAL_CASE ~%am_parent%~ BEGIN SET am_available = 0 END
              END
          END ELSE BEGIN
            OUTER_SET am_missing = 1 PRINT ~CBR anti-magic: %am_current%.spl is absent; continuing.~
          END
        END
      END
      // A readable cycle with no leaf still gets the decided behavior.
      ACTION_IF am_available AND NOT am_missing AND NOT am_any_payload BEGIN
        OUTER_SET $am_payloads(~%am_parent%~) = 1
      END
    END ELSE BEGIN PRINT ~CBR anti-magic: %am_parent%.spl is absent; continuing.~ END
  END ELSE BEGIN PRINT ~CBR anti-magic: %am_symbol% is absent from spell.ids; continuing.~ END
END

// Text ownership follows delivery identities, never an old strref or sentence.
DEFINE_PATCH_MACRO cbr_am_spell_links
BEGIN
  SET as_casts = 0
  LPM cbr_am_layout
  PATCH_IF am_readable BEGIN
    FOR (am_a = 0; am_a < am_nab; ++am_a) BEGIN
      SPRINT am_raw $am_effects(~%am_a%~)
      INNER_PATCH ~%am_raw%~ BEGIN
        FOR (am_at = 0; am_at < BUFFER_LENGTH; am_at += 48) BEGIN
          READ_SHORT am_at am_op READ_ASCII (am_at + 20) am_res (8) NULL TO_UPPER am_res
          PATCH_IF (am_op = 146 OR am_op = 148) AND VARIABLE_IS_SET $am_srcs(~%am_res%~) BEGIN SET as_casts = 1 END
        END
      END
    END
  END
END

DEFINE_PATCH_MACRO cbr_am_item_links
BEGIN
  SET ai_direct = 0 SET ai_indirect = 0
  PATCH_IF BUFFER_LENGTH >= 0x72 BEGIN
    READ_LONG 0x64 ai_ab READ_SHORT 0x68 ai_nab READ_LONG 0x6a ai_fx
    PATCH_IF ai_ab >= 0x72 AND ai_ab + 0x38 * ai_nab <= BUFFER_LENGTH
      AND ai_fx >= 0x72 AND ai_fx <= BUFFER_LENGTH BEGIN
      // Each ability owns a slice; table order and shared slices do not matter.
      FOR (ai_a = 0; ai_a < ai_nab; ++ai_a) BEGIN
        READ_SHORT (ai_ab + 0x38 * ai_a + 0x1e) ai_n
        READ_SHORT (ai_ab + 0x38 * ai_a + 0x20) ai_first
        PATCH_IF ai_fx + 48 * (ai_first + ai_n) <= BUFFER_LENGTH BEGIN
          FOR (ai_i = ai_first; ai_i < ai_first + ai_n; ++ai_i) BEGIN
            SET ai_at = ai_fx + 48 * ai_i READ_SHORT ai_at ai_op
            READ_ASCII (ai_at + 20) ai_res (8) NULL TO_UPPER ai_res
            PATCH_IF (ai_op = 146 OR ai_op = 147 OR ai_op = 148)
              AND ~%ai_res%~ STRING_EQUAL_CASE ~%am_parent%~ BEGIN SET ai_direct = 1 END
            PATCH_IF (ai_op = 146 OR ai_op = 148) AND VARIABLE_IS_SET $am_sib(~%ai_res%~) BEGIN SET ai_indirect = 1 END
          END
        END
      END
    END
  END
END

DEFINE_ACTION_MACRO cbr_am_describe
BEGIN
  ACTION_IF am_available AND ~%EE_LANGUAGE%~ STRING_EQUAL_CASE ~en_us~ BEGIN
    ACTION_IF component = 210 BEGIN
      OUTER_SPRINT am_text @2100 OUTER_SPRINT am_wand_special @2101
      OUTER_SPRINT am_name ~Pierce Magic~
    END ELSE BEGIN
      OUTER_SPRINT am_text @2110 OUTER_SPRINT am_wand_special @2111
      OUTER_SPRINT am_name ~Spellstrike~
    END
    OUTER_SPRINT am_note @2102
    COPY_EXISTING ~%am_parent%.spl~ ~override~
      PATCH_IF BUFFER_LENGTH >= 0x72 BEGIN
        READ_LONG 0x18 am_flags READ_SLONG 8 am_name_ref
        PATCH_IF am_name_ref >= 0 BEGIN GET_STRREF am_name_ref am_name END
        PATCH_IF (am_flags BAND 0x1000000) != 0 BEGIN
          SPRINT am_text ~%am_text%

%am_note%~
        END
        SET am_new_ref = RESOLVE_STR_REF (~%am_text%~)
        WRITE_LONG 0x50 am_new_ref
      END
    BUT_ONLY
    OUTER_SPRINT am_wand_text ~Ironically, these wands are both prized and hated by wizards.

STATISTICS:

Charge abilities:
– Breach
  Special: Dispels all specific and combat protections on target
  Range: 40 ft.
  Area of Effect: 1 creature

– %am_name%
  Special: %am_wand_special%
  Range: 40 ft.
  Area of Effect: 1 creature

Requires:
 9 Intelligence

Weight: 1~
    OUTER_SET am_wand_ref = RESOLVE_STR_REF (~%am_wand_text%~)
    ACTION_CLEAR_ARRAY am_sib
    COPY_EXISTING_REGEXP GLOB ~^.+\.spl$~ ~override~
        LPM cbr_am_spell_links
        SPRINT am_me ~%SOURCE_RES%~ TO_UPPER am_me
        PATCH_IF as_casts AND NOT VARIABLE_IS_SET $am_srcs(~%am_me%~) BEGIN
          SET $am_sib(~%am_me%~) = 1 WRITE_LONG 0x50 am_new_ref
        END
    BUT_ONLY IF_EXISTS
    COPY_EXISTING_REGEXP GLOB ~^.+\.itm$~ ~override~
        LPM cbr_am_item_links
        PATCH_IF ai_direct BEGIN
          WRITE_LONG 0x54 am_new_ref WRITE_LONG 0x50 am_new_ref
        END ELSE PATCH_IF ai_indirect BEGIN WRITE_LONG 0x54 am_wand_ref END
    BUT_ONLY IF_EXISTS
  END ELSE ACTION_IF am_available BEGIN
    PRINT ~CBR anti-magic: no translation for this language; retaining descriptions.~
  END
END

DEFINE_ACTION_FUNCTION cbr_install_sr_antimagic
  INT_VAR component = 210
  STR_VAR runtime_file = ~chriz-bg-rebalance/lua/M_CBRPM.lua~
BEGIN
  LAM cbr_am_discover
  ACTION_IF am_available BEGIN
    ACTION_PHP_EACH am_payloads AS am_payload => _ BEGIN
      COPY_EXISTING ~%am_payload%.spl~ ~override~
        PATCH_IF component = 210 BEGIN LPF cbr_sr_pierce_magic_patch END END
        ELSE BEGIN LPF cbr_sr_spellstrike_patch STR_VAR payload_resref = EVAL ~%am_payload%~ END END
      BUT_ONLY
    END
    ACTION_IF component = 210 BEGIN
      OUTER_SET CBR_PM_MR_STAT = 18
      ACTION_IF FILE_EXISTS_IN_GAME ~stats.ids~ BEGIN
        OUTER_SET am_stat = IDS_OF_SYMBOL (~stats~ ~RESISTMAGIC~)
        ACTION_IF am_stat >= 0 BEGIN OUTER_SET CBR_PM_MR_STAT = am_stat END
        ELSE BEGIN APPEND ~stats.ids~ ~18 RESISTMAGIC~ END
      END ELSE BEGIN
        COPY ~%runtime_file%~ ~override/stats.ids~
          DELETE_BYTES 0 BUFFER_LENGTH
          SPRINT am_ids ~IDS V1.0%WNL%18 RESISTMAGIC%WNL%~
          SET am_len = STRING_LENGTH ~%am_ids%~
          INSERT_BYTES 0 am_len WRITE_ASCIIE 0 ~%am_ids%~ (am_len)
      END
      COPY ~%runtime_file%~ ~override/M_CBRPM.lua~ EVALUATE_BUFFER
    END
    LAM cbr_am_describe
  END
END

// The independent text refresh owns only descriptions, irrespective of the
// current mechanical payload. It never alters the spell's effects or runtime.
DEFINE_ACTION_FUNCTION cbr_refresh_sr_antimagic_texts
  INT_VAR component = 210
BEGIN
  LAM cbr_am_discover
  LAM cbr_am_describe
END
