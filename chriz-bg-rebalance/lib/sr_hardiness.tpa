// Own the resistance package in every ability: four additive physical
// modifiers and optionally seven nonphysical modifiers. Casting hooks,
// headers and effects outside that package remain installed.
DEFINE_PATCH_FUNCTION cbr_sr_hardiness_patch
  INT_VAR physical = 40 extra_resistance = 0
  RET cbr_h_readable
BEGIN
  // These are component arguments, never values read from a game file.
  PATCH_IF ((physical != 40 AND physical != 30)
    OR (extra_resistance != 0 AND extra_resistance != 20)) BEGIN
    PATCH_FAIL ~CBR Hardiness: unsupported resistance choice.~
  END
  SET cbr_h_readable = BUFFER_LENGTH >= 0x72
  PATCH_IF cbr_h_readable BEGIN
    READ_LONG 0x64 cbr_h_ab
    READ_SHORT 0x68 cbr_h_ab_count
    READ_LONG 0x6a cbr_h_fx
    READ_SHORT 0x6e cbr_h_cast_first
    READ_SHORT 0x70 cbr_h_cast_count
    SET cbr_h_total = cbr_h_cast_first + cbr_h_cast_count
    SET cbr_h_readable = cbr_h_ab >= 0x72
      AND cbr_h_ab + 0x28 * cbr_h_ab_count <= BUFFER_LENGTH
      AND cbr_h_fx >= 0x72 AND cbr_h_fx <= BUFFER_LENGTH
    FOR (cbr_h_a = 0; cbr_h_readable AND cbr_h_a < cbr_h_ab_count; ++cbr_h_a) BEGIN
      READ_SHORT (cbr_h_ab + cbr_h_a * 0x28 + 0x1e) cbr_h_count
      READ_SHORT (cbr_h_ab + cbr_h_a * 0x28 + 0x20) cbr_h_first
      SET cbr_h_total = (cbr_h_total > cbr_h_first + cbr_h_count ? cbr_h_total : cbr_h_first + cbr_h_count)
    END
    SET cbr_h_readable = cbr_h_readable AND cbr_h_fx + cbr_h_total * 0x30 <= BUFFER_LENGTH
  END
  PATCH_IF cbr_h_readable BEGIN
    // Shared slices become independent; empty abilities get our package too.
    READ_ASCII (cbr_h_fx + cbr_h_cast_first * 0x30) cbr_h_cast (cbr_h_cast_count * 0x30)
    FOR (cbr_h_a = 0; cbr_h_a < cbr_h_ab_count; ++cbr_h_a) BEGIN
      SET cbr_h_header = cbr_h_ab + 0x28 * cbr_h_a
      READ_ASCII cbr_h_header $cbr_h_ability(~%cbr_h_a%~) (0x28)
      READ_SHORT (cbr_h_header + 0x1e) cbr_h_count
      READ_SHORT (cbr_h_header + 0x20) cbr_h_first
      READ_ASCII (cbr_h_fx + cbr_h_first * 0x30) $cbr_h_effects(~%cbr_h_a%~) (cbr_h_count * 0x30)
    END
    // Normalize table storage; other spell-header fields stay.
    DELETE_BYTES 0x72 (BUFFER_LENGTH - 0x72)
    SET cbr_h_ab = 0x72
    PATCH_IF cbr_h_ab_count = 0 BEGIN
      SET cbr_h_ab_count = 1
      INNER_PATCH_SAVE $cbr_h_ability(~0~) ~~ BEGIN
        INSERT_BYTES 0 0x28
        WRITE_BYTE 0 1 WRITE_BYTE 0x0c 1 WRITE_BYTE 0x0d 1
        WRITE_SHORT 0x10 1 WRITE_SHORT 0x26 1
      END
      SPRINT $cbr_h_effects(~0~) ~~
    END
    INSERT_BYTES 0x72 (cbr_h_ab_count * 0x28)
    SET cbr_h_fx = BUFFER_LENGTH
    INSERT_BYTES cbr_h_fx (cbr_h_cast_count * 0x30)
    WRITE_ASCIIE cbr_h_fx ~%cbr_h_cast%~ (cbr_h_cast_count * 0x30)
    WRITE_LONG 0x64 cbr_h_ab WRITE_SHORT 0x68 cbr_h_ab_count
    WRITE_LONG 0x6a cbr_h_fx WRITE_SHORT 0x6e 0
    SET cbr_h_out_count = cbr_h_cast_count
    FOR (cbr_h_a = 0; cbr_h_a < cbr_h_ab_count; ++cbr_h_a) BEGIN
      SET cbr_h_header = cbr_h_ab + cbr_h_a * 0x28
      SPRINT cbr_h_raw $cbr_h_ability(~%cbr_h_a%~)
      WRITE_ASCIIE cbr_h_header ~%cbr_h_raw%~ (0x28)
      READ_SHORT (cbr_h_header + 0x10) cbr_h_level
      READ_BYTE (cbr_h_header + 0x0c) cbr_h_target
      // Missing records use native Hardiness delivery. An existing physical
      // record supplies the unowned duration and delivery fields.
      INNER_PATCH_SAVE cbr_h_donor ~~ BEGIN
        INSERT_BYTES 0 0x30
        WRITE_BYTE 2 (cbr_h_target = 5 ? 3 : 1)
        WRITE_BYTE 0x0d 2 WRITE_BYTE 0x12 100
        WRITE_LONG 0x0e ((cbr_h_level < 2 ? 1 : cbr_h_level / 2) * 6)
      END
      SPRINT cbr_h_raw $cbr_h_effects(~%cbr_h_a%~)
      INNER_PATCH ~%cbr_h_raw%~ BEGIN
        SET cbr_h_have_donor = 0
        FOR (cbr_h_at = 0; cbr_h_at < BUFFER_LENGTH; cbr_h_at += 0x30) BEGIN
          READ_SHORT cbr_h_at cbr_h_op
          PATCH_IF NOT cbr_h_have_donor AND cbr_h_op >= 86 AND cbr_h_op <= 89 BEGIN
            READ_ASCII cbr_h_at cbr_h_donor (0x30)
            SET cbr_h_have_donor = 1
          END
        END
      END
      WRITE_SHORT (cbr_h_header + 0x20) cbr_h_out_count
      // Retain effects outside the resistance package, in their own order.
      INNER_PATCH_SAVE cbr_h_kept ~%cbr_h_raw%~ BEGIN
        SET cbr_h_insert = BUFFER_LENGTH
        FOR (cbr_h_at = BUFFER_LENGTH - 0x30; cbr_h_at >= 0; cbr_h_at -= 0x30) BEGIN
          READ_SHORT cbr_h_at cbr_h_op
          PATCH_IF ((cbr_h_op >= 27 AND cbr_h_op <= 31)
            OR (cbr_h_op >= 84 AND cbr_h_op <= 89)) BEGIN
            SET cbr_h_insert = cbr_h_at
            DELETE_BYTES cbr_h_at 0x30
          END
        END
        SET cbr_h_kept_length = BUFFER_LENGTH
      END
      SET cbr_h_dest = BUFFER_LENGTH
      INSERT_BYTES cbr_h_dest cbr_h_kept_length
      WRITE_ASCIIE cbr_h_dest ~%cbr_h_kept%~ (cbr_h_kept_length)
      SET cbr_h_package_dest = cbr_h_dest + cbr_h_insert
      SET cbr_h_new_count = cbr_h_kept_length / 0x30
      PATCH_FOR_EACH cbr_h_op IN 86 87 88 89 27 28 29 30 31 84 85 BEGIN
        PATCH_IF cbr_h_op >= 86 OR extra_resistance = 20 BEGIN
          SET cbr_h_dest = cbr_h_package_dest
          SET cbr_h_package_dest += 0x30
          INSERT_BYTES cbr_h_dest 0x30
          WRITE_ASCIIE cbr_h_dest ~%cbr_h_donor%~ (0x30)
          WRITE_SHORT cbr_h_dest cbr_h_op
          WRITE_LONG (cbr_h_dest + 4) (cbr_h_op >= 86 ? physical : extra_resistance)
          WRITE_LONG (cbr_h_dest + 8) 0
          ++cbr_h_new_count
        END
      END
      WRITE_SHORT (cbr_h_header + 0x1e) cbr_h_new_count
      SET cbr_h_out_count += cbr_h_new_count
    END
  END ELSE BEGIN
    PATCH_PRINT ~CBR Hardiness: unreadable spell tables; leaving this file unchanged.~
  END
END

DEFINE_ACTION_FUNCTION cbr_install_sr_hardiness
  INT_VAR physical = 40 extra_resistance = 0
BEGIN
  ACTION_IF (extra_resistance = 20) BEGIN
    ACTION_IF (physical = 40) BEGIN OUTER_SPRINT cbr_h_desc @2020 END
    ELSE BEGIN OUTER_SPRINT cbr_h_desc @2030 END
  END ELSE BEGIN
    ACTION_IF (physical = 40) BEGIN OUTER_SPRINT cbr_h_desc @2000 END
    ELSE BEGIN OUTER_SPRINT cbr_h_desc @2010 END
  END
  ACTION_FOR_EACH cbr_h_spell IN spcl907 spwish12 BEGIN
    ACTION_IF FILE_EXISTS_IN_GAME ~%cbr_h_spell%.spl~ BEGIN
      COPY_EXISTING ~%cbr_h_spell%.spl~ ~override~
        LPF cbr_sr_hardiness_patch INT_VAR physical extra_resistance RET cbr_h_readable END
        PATCH_IF cbr_h_readable BEGIN
          PATCH_IF ~%EE_LANGUAGE%~ STRING_EQUAL_CASE ~en_us~ BEGIN
            SAY UNIDENTIFIED_DESC ~%cbr_h_desc%~
          END ELSE BEGIN
            PATCH_PRINT ~CBR Hardiness: no translation for this language; retaining the spell text.~
          END
        END
      BUT_ONLY_IF_IT_CHANGES
    END ELSE BEGIN
      PRINT ~CBR Hardiness: %cbr_h_spell%.spl is absent; continuing with the remaining targets.~
    END
  END
END
