// chriz-bg-rebalance — Cleric of Tempus Divination toll (component 405).
//
// The kit's downside: Clerics of Tempus lose access to the installed
// Divination priest spells. Fully engine-native (no EEex dependency):
//   * CBRTMDV.SPL — op321 self-reset, then one instant op172 (remove spell)
//     per Divination spell, then one permanent op272 heartbeat per spell,
//     each firing a CBRTMD<i>.EFF op172. The pulse strips a Divination spell
//     within about a second of it ever appearing, so priest auto-learn
//     ordering at level-up is irrelevant.
//   * OHTEMPUS.2DA — a CBR_DIVTOLL row applies AP_CBRTMDV at every level;
//     the leading op321 makes the repeated application self-replacing, so
//     exactly one pulse set is live no matter how often the CLAB fires.
//
// The Divination spell list is discovered by the installer wrapper against
// the real game (school byte 0x25 == 3 across SPPR[1-7]xx, override and BIF)
// and passed in through the documented global-array contract below; this
// library never scans a game.
//
// Contract: the caller sets
//   $cbr_divtoll_res(~0~) .. $cbr_divtoll_res(~<divination_count - 1>~)
// to the SPL resrefs (no extension) that the toll removes.
//
// Requires chriz-bg-rebalance/lib/tempus_holy_power.tpa to be INCLUDEd first
// (cbr_add_basic_self_ability, cbr_append_spl_effect_record).

DEFINE_ACTION_FUNCTION cbr_define_tempus_toll_resrefs
  RET
    cbr_toll_spell
    cbr_toll_eff_prefix
BEGIN
  OUTER_SPRINT cbr_toll_spell      ~CBRTMDV~
  OUTER_SPRINT cbr_toll_eff_prefix ~CBRTMD~
END

// One standalone EFF V2 carrying the op172 removal for a single spell.
// Field layout mirrors the shipped 401 pulse EFFs (normalize everything
// after the signatures, then write only owned fields).
DEFINE_ACTION_FUNCTION cbr_toll_create_removal_eff
  STR_VAR
    resource_dir = ~~
    eff_resref = ~~
    removed_resref = ~~
BEGIN
  OUTER_SPRINT resource_dir EVALUATE_BUFFER ~%resource_dir%~
  OUTER_SPRINT eff_resref EVALUATE_BUFFER ~%eff_resref%~
  OUTER_SPRINT removed_resref EVALUATE_BUFFER ~%removed_resref%~
  COPY ~cbr-toll-empty~ ~%resource_dir%/%eff_resref%.eff~
    LPF cbr_tempus_blank INT_VAR size = 0x110 STR_VAR signature = ~EFF V2.0~ END
    FOR (cbr_toll_byte = 0x10; cbr_toll_byte < 0x110; ++cbr_toll_byte) BEGIN
      WRITE_BYTE cbr_toll_byte 0
    END
    WRITE_LONG 0x10 172
    WRITE_LONG 0x14 2
    WRITE_LONG 0x18 0
    WRITE_LONG 0x1c 0
    WRITE_LONG 0x20 0
    WRITE_LONG 0x24 1
    WRITE_LONG 0x28 0
    WRITE_SHORT 0x2c 100
    WRITE_SHORT 0x2e 0
    WRITE_ASCIIE 0x30 ~%removed_resref%~ #8
    WRITE_LONG 0x5c 2
END

// Own the application row by name and level labels, preserving unrelated rows.
DEFINE_PATCH_FUNCTION cbr_toll_ensure_clab_row STR_VAR toll_spell = ~~ BEGIN
  LPM cbr_tempus_read_table
  FOR (cbr_toll_level = 1; cbr_toll_level <= 50; ++cbr_toll_level) BEGIN
    SET cbr_toll_found = 0
    FOR (cbr_toll_c = 0; cbr_toll_c < cbr_t_cols; ++cbr_toll_c) BEGIN
      SPRINT cbr_toll_column $cbr_t_cell(2 ~%cbr_toll_c%~)
      PATCH_IF ~%cbr_toll_column%~ STRING_EQUAL ~%cbr_toll_level%~ BEGIN SET cbr_toll_found = 1 END
    END
    PATCH_IF NOT cbr_toll_found BEGIN
      SPRINT $cbr_t_cell(2 ~%cbr_t_cols%~) ~%cbr_toll_level%~ ++cbr_t_cols
      FOR (cbr_toll_r = 3; cbr_toll_r < cbr_t_lines; ++cbr_toll_r) BEGIN
        SPRINT $cbr_t_cell(~%cbr_toll_r%~ ~%cbr_t_cols%~) ~%cbr_t_default%~
      END
    END
  END
  SET cbr_toll_found = 0
  FOR (cbr_toll_r = 3; cbr_toll_r < cbr_t_lines; ++cbr_toll_r) BEGIN
    SPRINT cbr_toll_row $cbr_t_cell(~%cbr_toll_r%~ 0)
    PATCH_IF ~%cbr_toll_row%~ STRING_EQUAL_CASE ~CBR_DIVTOLL~ BEGIN SET cbr_toll_found = 1 END
  END
  PATCH_IF NOT cbr_toll_found BEGIN
    SPRINT $cbr_t_cell(~%cbr_t_lines%~ 0) ~CBR_DIVTOLL~
    FOR (cbr_toll_c = 1; cbr_toll_c <= cbr_t_cols; ++cbr_toll_c) BEGIN
      SPRINT $cbr_t_cell(~%cbr_t_lines%~ ~%cbr_toll_c%~) ~%cbr_t_default%~
    END
    ++cbr_t_lines
  END
  FOR (cbr_toll_r = 3; cbr_toll_r < cbr_t_lines; ++cbr_toll_r) BEGIN
    SPRINT cbr_toll_row $cbr_t_cell(~%cbr_toll_r%~ 0)
    PATCH_IF ~%cbr_toll_row%~ STRING_EQUAL_CASE ~CBR_DIVTOLL~ BEGIN
      FOR (cbr_toll_c = 0; cbr_toll_c < cbr_t_cols; ++cbr_toll_c) BEGIN
        SPRINT cbr_toll_column $cbr_t_cell(2 ~%cbr_toll_c%~)
        PATCH_IF IS_AN_INT ~%cbr_toll_column%~ BEGIN
          PATCH_IF cbr_toll_column > 0 BEGIN
            SET cbr_toll_col = cbr_toll_c + 1 SPRINT $cbr_t_cell(~%cbr_toll_r%~ ~%cbr_toll_col%~) ~AP_%toll_spell%~
          END
        END
      END
    END
  END
  LPM cbr_tempus_write_table
END

DEFINE_ACTION_FUNCTION cbr_apply_tempus_divination_toll
  INT_VAR divination_count = 0
  STR_VAR resource_dir = ~~
BEGIN
  OUTER_SPRINT resource_dir EVALUATE_BUFFER ~%resource_dir%~
  ACTION_IF ~%resource_dir%~ STRING_EQUAL ~~ BEGIN FAIL ~CBR Tempus Divination toll requires resource_dir.~ END
  <<<<<<<< cbr-toll-empty
>>>>>>>>
  ACTION_IF NOT FILE_EXISTS ~%resource_dir%/OHTEMPUS.2DA~ BEGIN
    <<<<<<<< cbr-toll-clab
2DA V1.0
****
1
>>>>>>>>
    COPY ~cbr-toll-clab~ ~%resource_dir%/OHTEMPUS.2DA~
  END
  LAF cbr_define_tempus_toll_resrefs RET cbr_toll_spell_resref = cbr_toll_spell cbr_toll_prefix = cbr_toll_eff_prefix END
  OUTER_SET cbr_toll_count = 0
  OUTER_FOR (cbr_toll_i = 0; cbr_toll_i < divination_count; ++cbr_toll_i) BEGIN
    OUTER_SPRINT cbr_toll_target $cbr_divtoll_res(~%cbr_toll_i%~)
    // Engine resrefs have at most eight bytes. An unaddressable input costs
    // only that entry, never the table or the remaining removal effects.
    ACTION_IF (STRING_LENGTH ~%cbr_toll_target%~) > 0 AND (STRING_LENGTH ~%cbr_toll_target%~) <= 8 BEGIN
      OUTER_SPRINT $cbr_toll_target(~%cbr_toll_count%~) ~%cbr_toll_target%~
      OUTER_SPRINT cbr_toll_eff ~%cbr_toll_prefix%%cbr_toll_count%~
      ACTION_IF cbr_toll_count >= 100 BEGIN OUTER_SPRINT cbr_toll_eff ~CBRD%cbr_toll_count%~ END
      OUTER_SPRINT $cbr_toll_eff(~%cbr_toll_count%~) ~%cbr_toll_eff%~
      LAF cbr_toll_create_removal_eff STR_VAR resource_dir = EVAL ~%resource_dir%~
        eff_resref = EVAL ~%cbr_toll_eff%~ removed_resref = EVAL ~%cbr_toll_target%~ END
      OUTER_SET cbr_toll_count += 1
    END ELSE BEGIN
      PRINT ~CBR: cannot address Divination list entry %cbr_toll_i% as an engine resref; the remaining toll applies.~
    END
  END
  COPY ~%resource_dir%/OHTEMPUS.2DA~ ~%resource_dir%/OHTEMPUS.2DA~
    LPF cbr_toll_ensure_clab_row STR_VAR toll_spell = EVAL ~%cbr_toll_spell_resref%~ END
  BUT_ONLY
  COPY ~cbr-toll-empty~ ~%resource_dir%/%cbr_toll_spell_resref%.spl~
    LPF cbr_tempus_blank END
    LPF cbr_add_basic_self_ability END
    LPF cbr_append_spl_effect_record INT_VAR opcode = 321 target = 1 timing = 1
      STR_VAR resource = EVAL ~%cbr_toll_spell_resref%~ END
    FOR (cbr_toll_i = 0; cbr_toll_i < cbr_toll_count; ++cbr_toll_i) BEGIN
      SPRINT cbr_toll_target $cbr_toll_target(~%cbr_toll_i%~)
      LPF cbr_append_spl_effect_record INT_VAR opcode = 172 target = 1 timing = 1
        STR_VAR resource = EVAL ~%cbr_toll_target%~ END
    END
    FOR (cbr_toll_i = 0; cbr_toll_i < cbr_toll_count; ++cbr_toll_i) BEGIN
      SPRINT cbr_toll_eff $cbr_toll_eff(~%cbr_toll_i%~)
      LPF cbr_append_spl_effect_record INT_VAR opcode = 272 target = 1 parameter1 = 1 parameter2 = 3 timing = 9
        STR_VAR resource = EVAL ~%cbr_toll_eff%~ END
    END
    WRITE_SHORT 0x90 (1 + 2 * cbr_toll_count)
  ACTION_IF cbr_toll_count = 0 BEGIN PRINT ~CBR: no addressable Divination spells; the toll has no spells to remove.~ END
END
