// chriz-bg-rebalance — Cleric of Tempus specialization APR, EEex variant
// (component 407; re-shipped over a live install by component 409).
//
// Component 406 flips CLSWPBON.2DA's CLERIC row, which grants the FULL
// warrior WSPATCK progression (live-verified 2026-07-17: a 2-pip flail put
// APR stat 8 at 2.5 attacks — fighter-grade, stronger than the kit
// advertises). The engine offers no spec-only knob: GETS_PROF_APR is a
// boolean class-row gate into the whole table. This variant instead ships an
// EEex listener (M_CBRAPR.lua) that adds exactly +1/2 attack while the
// selected weapon is one the character holds 2+ pips in, scoped to the
// Tempus kit.
//
// EEex_Opcode_AddListsResolvedListener fires once per ProcessEffectList
// PASS (every AI tick), while the engine rebuilds CDerivedStats only on some
// of those passes (research/07). The listener therefore keys its write to a
// private spell state it sets in the same stats struct: CDerivedStats::Reload
// clears the bit, so "bit clear" means "this pass rebuilt the stats". That
// state is allocated here in SPLSTATE.IDS and stamped into the Lua next to
// the kit id — both are per-install values and must never be hardcoded.

// Allocate only an unused state, or the private symbol's unshared state.
// Exhaustion omits this listener without affecting other Tempus features.
DEFINE_PATCH_FUNCTION cbr_plan_tempus_spec_apr_state
  INT_VAR planned_value = 242
  STR_VAR symbol = ~CBR_TEMPUS_SPEC_APR~
  RET state_value
BEGIN
  SET state_value = (0 - 1) SET cbr_sas_existing = (0 - 1)
  FOR (cbr_sas_i = 0; cbr_sas_i < 256; ++cbr_sas_i) BEGIN SET $cbr_sas_used(~%cbr_sas_i%~) = 0 END
  READ_ASCII 0 cbr_sas_text (BUFFER_LENGTH)
  INNER_PATCH ~%cbr_sas_text%~ BEGIN
    REPLACE_EVALUATE ~^[ %TAB%]*\([^ %TAB%%WNL%%LNL%%MNL%]+\)[ %TAB%]+\([^ %TAB%%WNL%%LNL%%MNL%]+\)~ BEGIN
      PATCH_IF IS_AN_INT ~%MATCH1%~ BEGIN
        SET cbr_sas_n = MATCH1
        PATCH_IF cbr_sas_n >= 0 AND cbr_sas_n < 256 BEGIN
          PATCH_IF ~%MATCH2%~ STRING_EQUAL_CASE ~%symbol%~ BEGIN
            SET cbr_sas_existing = cbr_sas_n
          END ELSE BEGIN SET $cbr_sas_used(~%cbr_sas_n%~) = 1 END
        END
      END
    END ~%MATCH0%~
  END
  PATCH_IF cbr_sas_existing >= 0 BEGIN
    PATCH_IF NOT $cbr_sas_used(~%cbr_sas_existing%~) BEGIN SET state_value = cbr_sas_existing END
  END
  SET cbr_sas_start = (planned_value >= 0 AND planned_value < 256 ? planned_value : 242)
  FOR (cbr_sas_i = cbr_sas_start; cbr_sas_i >= 0 AND state_value < 0; --cbr_sas_i) BEGIN
    PATCH_IF NOT $cbr_sas_used(~%cbr_sas_i%~) BEGIN SET state_value = cbr_sas_i END
  END
  FOR (cbr_sas_i = 255; cbr_sas_i > cbr_sas_start AND state_value < 0; --cbr_sas_i) BEGIN
    PATCH_IF NOT $cbr_sas_used(~%cbr_sas_i%~) BEGIN SET state_value = cbr_sas_i END
  END
END

DEFINE_ACTION_FUNCTION cbr_allocate_tempus_spec_apr_state
  INT_VAR planned_value = 242
  STR_VAR resource_dir = ~~
  RET state_value
BEGIN
  OUTER_SPRINT resource_dir EVALUATE_BUFFER ~%resource_dir%~
  ACTION_IF ~%resource_dir%~ STRING_EQUAL ~~ BEGIN FAIL ~CBR Tempus spec APR requires resource_dir.~ END
  OUTER_SPRINT cbr_sas_path ~%resource_dir%/SPLSTATE.IDS~
  ACTION_IF NOT FILE_EXISTS ~%cbr_sas_path%~ BEGIN
    <<<<<<<< cbr-apr-empty-states
IDS V1.0
>>>>>>>>
    COPY ~cbr-apr-empty-states~ ~%cbr_sas_path%~
  END
  COPY ~%cbr_sas_path%~ ~%cbr_sas_path%~
    LPF cbr_plan_tempus_spec_apr_state INT_VAR planned_value = planned_value RET state_value END
    INNER_ACTION BEGIN OUTER_SET state_value = state_value END
  BUT_ONLY
  ACTION_IF state_value >= 0 BEGIN
    LAF cbr_find_or_allocate_splstate INT_VAR planned_value = state_value
      STR_VAR resource_path = EVAL ~%cbr_sas_path%~ symbol = ~CBR_TEMPUS_SPEC_APR~ END
    CLEAR_IDS_MAP
  END
END

DEFINE_ACTION_FUNCTION cbr_apply_tempus_spec_apr_eeex
  INT_VAR kit_id = 0 marker_state = (0 - 1)
  STR_VAR resource_dir = ~~ template_file = ~~ component_tag = ~407~
BEGIN
  OUTER_SPRINT resource_dir EVALUATE_BUFFER ~%resource_dir%~
  OUTER_SPRINT template_file EVALUATE_BUFFER ~%template_file%~
  ACTION_IF ~%resource_dir%~ STRING_EQUAL ~~ BEGIN FAIL ~CBR Tempus spec APR requires resource_dir.~ END
  ACTION_IF ~%template_file%~ STRING_EQUAL ~~ BEGIN FAIL ~CBR Tempus spec APR requires template_file.~ END
  ACTION_IF marker_state < 0 OR marker_state > 255 OR kit_id <= 0 BEGIN
    // Overwrite an old copy too, so an exhausted allocation cannot leave a
    // listener running against a foreign state from an earlier installation.
    <<<<<<<< cbr-apr-unavailable
-- Tempus specialization APR is unavailable in this installation.
>>>>>>>>
    COPY ~cbr-apr-unavailable~ ~%resource_dir%/M_CBRAPR.lua~
    ACTION_IF marker_state < 0 OR marker_state > 255 BEGIN
      PRINT ~CBR: no unused SPLSTATE slot; only Tempus specialization APR is omitted.~
    END ELSE BEGIN
      PRINT ~CBR: the Tempus kit is absent; only its specialization APR listener is omitted.~
    END
  END ELSE BEGIN
    // Bundled template validity is tested offline.
    COPY ~%template_file%~ ~%resource_dir%/M_CBRAPR.lua~
      REPLACE_TEXTUALLY ~%CBR_TEMPUS_KIT_ID%~ ~%kit_id%~
      REPLACE_TEXTUALLY ~%CBR_TEMPUS_SPEC_APR_STATE%~ ~%marker_state%~
    PRINT ~cbr %component_tag%: shipped %resource_dir%/M_CBRAPR.lua with OHTEMPUS kit id %kit_id% and marker state %marker_state% (+1/2 attack while wielding a 2-pip weapon).~
  END
END
