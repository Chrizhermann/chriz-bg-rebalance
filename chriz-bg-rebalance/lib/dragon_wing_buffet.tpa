// Component 111: preserve SCS's exact original paths and add actor-scoped 18s
// copies. See research/15-dragon-wing-buffet.md for the captured block evidence.
// BAF exists only as an in-memory compiler input; no source files are edited.

DEFINE_ACTION_FUNCTION cbr_wb_build_family
  INT_VAR cooldown = 6
  STR_VAR death_variable = ~~
  RET family
BEGIN
  OUTER_SPRINT cbr_wb_guard ~~
  ACTION_IF !(~%death_variable%~ STR_EQ ~~) BEGIN
    OUTER_SPRINT cbr_wb_guard ~Name("%death_variable%",Myself)~
  END
  OUTER_SPRINT cbr_wb_source ~
IF
  %cbr_wb_guard%
  Allegiance(Myself,ENEMY)
  !GlobalTimerNotExpired("Buffet","LOCALS")
  Global("FIN_TIME_STOP_RUNNING","GLOBAL",0)
  OR(4)
    SpellCast([GOODCUTOFF],WIZARD_CLOUDKILL)
    SpellCast([GOODCUTOFF],WIZARD_STINKING_CLOUD)
    SpellCast([GOODCUTOFF],WIZARD_DEATH_FOG)
    SpellCast([GOODCUTOFF],WIZARD_INCENDIARY_CLOUD)
  !GlobalTimerNotExpired("Buffet","LOCALS")
THEN
  RESPONSE #100
    SetGlobalTimer("castspell","LOCALS",3)
    SetGlobalTimer("Buffet","LOCALS",%cooldown%)
    ApplySpellRES("dw#brkin",Myself)
    ReallyForceSpell(Myself,DRAGON_WING_BUFFET)
END
IF
  %cbr_wb_guard%
  Allegiance(Myself,ENEMY)
  Range(SecondNearestEnemyOf(Myself),12)
  !GlobalTimerNotExpired("Buffet","LOCALS")
  Global("FIN_TIME_STOP_RUNNING","GLOBAL",0)
THEN
  RESPONSE #100
    SetGlobalTimer("castspell","LOCALS",3)
    SetGlobalTimer("Buffet","LOCALS",%cooldown%)
    ApplySpellRES("dw#brkin",Myself)
    ReallyForceSpell(NearestEnemyOf(Myself),DRAGON_WING_BUFFET)
  RESPONSE #100
    SetGlobalTimer("Buffet","LOCALS",%cooldown%)
    Continue()
END
~
  OUTER_PATCH_SAVE family ~%cbr_wb_source%~ BEGIN
    COMPILE_BAF_TO_BCS
    DELETE_BYTES (BUFFER_LENGTH - 3) 3
    DELETE_BYTES 0 3
  END
END


// Offsets and current actor/script names are addresses, not compatibility tests.
DEFINE_PATCH_FUNCTION cbr_wb_validate_cre
  INT_VAR script_offset = 0
  STR_VAR expected_script = ~~ expected_dv = ~~ creature = ~~
  RET verified_dv assigned_script readable
BEGIN
  SET readable = BUFFER_LENGTH >= 0x2d4
  SPRINT verified_dv ~%expected_dv%~ SPRINT assigned_script ~%expected_script%~
  PATCH_IF readable BEGIN
    READ_ASCII 0x280 verified_dv (32) NULL
    READ_ASCII script_offset assigned_script (8) NULL
    PATCH_IF ~%verified_dv%~ STR_EQ ~~ BEGIN
      SPRINT verified_dv ~%expected_dv%~ WRITE_ASCIIE 0x280 ~%verified_dv%~ #32
    END
    PATCH_IF ~%assigned_script%~ STR_EQ ~~ BEGIN
      SPRINT assigned_script ~%expected_script%~ WRITE_ASCIIE script_offset ~%assigned_script%~ #8
    END
  END ELSE BEGIN PATCH_PRINT ~CBR wing-buffet: %creature% has unreadable CRE bounds; only this creature is unchanged.~ END
END

DEFINE_PATCH_FUNCTION cbr_wb_transform_bcs
  INT_VAR apply = 0
  STR_VAR original_family = ~~ gated_family = ~~ script = ~~ actor = ~~ expected_actor = ~~
  RET changed
BEGIN
  SET changed = 0
  SPRINT gated_family EVALUATE_BUFFER ~%gated_family%~
  SET readable = BUFFER_LENGTH >= 6
  PATCH_IF readable BEGIN
    READ_ASCII 0 header (3) READ_ASCII (BUFFER_LENGTH - 3) footer (3)
    SET readable = (~%header%~ STR_EQ ~SC%LNL%~) AND (~%footer%~ STR_EQ ~SC%LNL%~)
  END
  PATCH_IF readable BEGIN
    READ_ASCII 0 previous (BUFFER_LENGTH)
    SPRINT result ~SC%LNL%~ SET cursor = 3 SET inserted = 0
    WHILE cursor < BUFFER_LENGTH - 3 AND readable BEGIN
      SET finish = INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~RS%LNL%CR%LNL%~ cursor)
      PATCH_IF finish < 0 BEGIN SET readable = 0 END ELSE BEGIN
        SET finish += 6 READ_ASCII cursor block (finish - cursor)
        SET buffet = 0 SET owned = 0
        INNER_PATCH ~%block%~ BEGIN
          SET buffet = INDEX_BUFFER (CASE_INSENSITIVE ~LOCALSBuffet~) >= 0
          // Earlier releases marked their actor-scoped pair with Name.
          SET owned = buffet AND INDEX_BUFFER (~TR%LNL%16549 ~) >= 0
            AND (INDEX_BUFFER (CASE_INSENSITIVE EXACT_MATCH ~"%actor%"~) >= 0
              OR INDEX_BUFFER (CASE_INSENSITIVE EXACT_MATCH ~"%expected_actor%"~) >= 0)
        END
        PATCH_IF buffet AND NOT inserted BEGIN SPRINT result ~%result%%gated_family%~ SET inserted = 1 END
        PATCH_IF NOT owned BEGIN SPRINT result ~%result%%block%~ END
        SET cursor = finish
      END
    END
    PATCH_IF readable BEGIN
      PATCH_IF NOT inserted BEGIN SPRINT result ~SC%LNL%%gated_family%%result%~
        INNER_PATCH_SAVE result ~%result%~ BEGIN
          // Remove the old wrapper's opening SC after the new blocks.
          DELETE_BYTES (3 + STRING_LENGTH ~%gated_family%~) 3
        END
      END
      SPRINT result ~%result%SC%LNL%~
      SET changed = NOT (~%previous%~ STR_EQ ~%result%~)
      PATCH_IF apply BEGIN
        DELETE_BYTES 0 BUFFER_LENGTH INSERT_BYTES 0 (STRING_LENGTH ~%result%~) WRITE_ASCIIE 0 ~%result%~
      END
    END
  END
  PATCH_IF NOT readable BEGIN PATCH_PRINT ~CBR wing-buffet: %script% has unreadable BCS bounds; only this script is unchanged.~ END
END

<<<<<<<< cbr_wb_empty
SC
SC
>>>>>>>>

DEFINE_ACTION_FUNCTION cbr_apply_dragon_wing_buffet
  INT_VAR game_mode = 1
  STR_VAR resource_dir = ~~
  RET changed_scripts
BEGIN
  OUTER_SPRINT resource_dir EVALUATE_BUFFER ~%resource_dir%~
  ACTION_IF !game_mode && (~%resource_dir%~ STR_EQ ~~) BEGIN
    FAIL ~CBR wing-buffet fixture mode requires resource_dir.~
  END
  OUTER_SET changed_scripts = 0
  ACTION_DEFINE_ASSOCIATIVE_ARRAY roster BEGIN
    ~firkra02~ => ~dragred firkra02 0x250~
    ~shadra01~ => ~shadra01 ShaDra01 0x248~
    ~dragblac~ => ~dragblac Dragblac 0x250~
    ~gorsal~ => ~gorsal GorSal 0x268~
    ~fsdragon~ => ~draggree FSdragon 0x250~
  END
  ACTION_PHP_EACH roster AS creature => entry BEGIN
    OUTER_INNER_PATCH ~%entry%~ BEGIN
      READ_2DA_ENTRY 0 0 3 expected_script READ_2DA_ENTRY 0 1 3 expected_dv READ_2DA_ENTRY 0 2 3 script_offset
    END
    OUTER_SET readable = 0
    ACTION_IF game_mode AND FILE_EXISTS_IN_GAME ~%creature%.CRE~ BEGIN
      COPY_EXISTING ~%creature%.CRE~ ~override~
        LPF cbr_wb_validate_cre INT_VAR script_offset STR_VAR expected_script expected_dv creature RET verified_dv assigned_script readable END
        BUT_ONLY
    END ELSE ACTION_IF NOT game_mode AND FILE_EXISTS ~%resource_dir%/%creature%.cre~ BEGIN
      COPY ~%resource_dir%/%creature%.cre~ ~%resource_dir%/%creature%.cre~
        LPF cbr_wb_validate_cre INT_VAR script_offset STR_VAR expected_script expected_dv creature RET verified_dv assigned_script readable END
        BUT_ONLY
    END ELSE BEGIN PRINT ~CBR wing-buffet: optional creature %creature% is absent; continuing with the remaining dragons.~ END
    ACTION_IF readable BEGIN
      LAF cbr_wb_build_family INT_VAR cooldown = 18 STR_VAR death_variable = EVAL ~%verified_dv%~ RET gated_family = family END
      ACTION_IF game_mode BEGIN
        ACTION_IF NOT FILE_EXISTS_IN_GAME ~%assigned_script%.BCS~ BEGIN COPY ~cbr_wb_empty~ ~override/%assigned_script%.BCS~ END
        COPY_EXISTING ~%assigned_script%.BCS~ ~override~
          LPF cbr_wb_transform_bcs INT_VAR apply = 1 STR_VAR gated_family script = EVAL ~%assigned_script%~ actor = EVAL ~%verified_dv%~ expected_actor = EVAL ~%expected_dv%~ RET changed END
          BUT_ONLY
      END ELSE BEGIN
        ACTION_IF NOT FILE_EXISTS ~%resource_dir%/%assigned_script%.bcs~ BEGIN COPY ~cbr_wb_empty~ ~%resource_dir%/%assigned_script%.bcs~ END
        COPY ~%resource_dir%/%assigned_script%.bcs~ ~%resource_dir%/%assigned_script%.bcs~
          LPF cbr_wb_transform_bcs INT_VAR apply = 1 STR_VAR gated_family script = EVAL ~%assigned_script%~ actor = EVAL ~%verified_dv%~ expected_actor = EVAL ~%expected_dv%~ RET changed END
          BUT_ONLY
      END
      OUTER_SET changed_scripts += changed
    END
  END
  PRINT ~CBR wing-buffet: %changed_scripts% scripts updated with actor-scoped 18-second cooldowns.~
END
