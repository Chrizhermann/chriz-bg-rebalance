// Component 121 owns the generated readiness manifest and runtime module.
// Candidate identities come from IDS / SCS delivery mappings; their decided
// readiness settings do not depend on old spell effects, text or layout.
DEFINE_PATCH_FUNCTION cbr_rdy_resolve_symbol_from_ids
  STR_VAR wanted_symbol = ~~
  RET matches spell_number
BEGIN
  SET matches = 0 SET spell_number = 0
  SPRINT rdy_wanted ~%wanted_symbol%~ TO_UPPER rdy_wanted
  READ_ASCII 0 rdy_ids (BUFFER_LENGTH)
  INNER_PATCH ~%rdy_ids%~ BEGIN
    REPLACE_EVALUATE CASE_INSENSITIVE ~^\([0-9][0-9]*\)[ %TAB%]+\([^ %TAB%%WNL%%MNL%%LNL%]+\)~
    BEGIN
      SPRINT rdy_symbol ~%MATCH2%~ TO_UPPER rdy_symbol
      PATCH_IF ~%rdy_symbol%~ STR_EQ ~%rdy_wanted%~ BEGIN
        SET matches = 1 SET spell_number = MATCH1
      END
    END ~~
  END
END

DEFINE_ACTION_FUNCTION cbr_rdy_resolve_spell_symbol
  STR_VAR spell_ids = ~~ symbol = ~~
  RET found spell_number spell_resref spell_type
BEGIN
  OUTER_SPRINT spell_ids EVALUATE_BUFFER ~%spell_ids%~
  OUTER_SPRINT symbol EVALUATE_BUFFER ~%symbol%~
  OUTER_SET found = 0 OUTER_SET spell_number = 0 OUTER_SET spell_type = 0
  OUTER_SPRINT spell_resref ~~
  ACTION_IF FILE_EXISTS ~%spell_ids%~ BEGIN
    COPY ~%spell_ids%~ ~%spell_ids%~
      LPF cbr_rdy_resolve_symbol_from_ids STR_VAR wanted_symbol = EVAL ~%symbol%~
        RET found = matches spell_number END
    BUT_ONLY
  END
  ACTION_IF found BEGIN
    ACTION_IF spell_number >= 1000 AND spell_number < 2000 BEGIN
      OUTER_SET spell_type = 2 OUTER_SET rdy_slot = spell_number - 1000 OUTER_SPRINT rdy_prefix ~SPPR~
    END ELSE ACTION_IF spell_number >= 2000 AND spell_number < 3000 BEGIN
      OUTER_SET spell_type = 1 OUTER_SET rdy_slot = spell_number - 2000 OUTER_SPRINT rdy_prefix ~SPWI~
    END ELSE BEGIN OUTER_SET found = 0 END
    ACTION_IF found BEGIN
      OUTER_SPRINT spell_resref ~%rdy_prefix%%rdy_slot%~
      ACTION_IF rdy_slot < 100 BEGIN OUTER_SPRINT spell_resref ~%rdy_prefix%0%rdy_slot%~ END
      ACTION_IF rdy_slot < 10 BEGIN OUTER_SPRINT spell_resref ~%rdy_prefix%00%rdy_slot%~ END
    END
  END
END

DEFINE_PATCH_FUNCTION cbr_rdy_lookup_prebuff_from_text
  STR_VAR wanted_key = ~~
  RET matches delivery_resref
BEGIN
  SET matches = 0 SPRINT delivery_resref ~~
  SPRINT rdy_wanted ~%wanted_key%~ TO_UPPER rdy_wanted
  READ_ASCII 0 rdy_map (BUFFER_LENGTH)
  INNER_PATCH ~%rdy_map%~ BEGIN
    REPLACE_EVALUATE CASE_INSENSITIVE ~^\([^ %TAB%%WNL%%MNL%%LNL%]+\)[ %TAB%]+\([^ %TAB%%WNL%%MNL%%LNL%]+\)~
    BEGIN
      SPRINT rdy_key ~%MATCH1%~ TO_UPPER rdy_key
      PATCH_IF ~%rdy_key%~ STR_EQ ~%rdy_wanted%~ BEGIN
        SET matches = 1 SPRINT delivery_resref ~%MATCH2%~ TO_UPPER delivery_resref
      END
    END ~~
  END
END

DEFINE_ACTION_FUNCTION cbr_rdy_lookup_prebuff
  STR_VAR prebuff_map = ~~ symbol = ~~
  RET found delivery_resref
BEGIN
  OUTER_SPRINT prebuff_map EVALUATE_BUFFER ~%prebuff_map%~
  OUTER_SPRINT symbol EVALUATE_BUFFER ~%symbol%~
  OUTER_SET found = 0 OUTER_SPRINT delivery_resref ~~
  ACTION_IF FILE_EXISTS ~%prebuff_map%~ BEGIN
    COPY ~%prebuff_map%~ ~%prebuff_map%~
      LPF cbr_rdy_lookup_prebuff_from_text STR_VAR wanted_key = EVAL ~%symbol%_PREBUFF~
        RET found = matches delivery_resref END
    BUT_ONLY
  END
END

DEFINE_ACTION_FUNCTION cbr_compile_ambient_readiness_manifest
  STR_VAR spell_table = ~~ override_table = ~~ resource_dir = ~~ spell_ids = ~~ prebuff_map = ~~ output_file = ~~
  RET ambient_count urgent_count manifest_text
BEGIN
  OUTER_SPRINT spell_table EVALUATE_BUFFER ~%spell_table%~
  OUTER_SPRINT override_table EVALUATE_BUFFER ~%override_table%~
  OUTER_SPRINT resource_dir EVALUATE_BUFFER ~%resource_dir%~
  OUTER_SPRINT spell_ids EVALUATE_BUFFER ~%spell_ids%~
  OUTER_SPRINT prebuff_map EVALUATE_BUFFER ~%prebuff_map%~
  OUTER_SPRINT output_file EVALUATE_BUFFER ~%output_file%~
  ACTION_IF ~%resource_dir%~ STR_EQ ~~ OR ~%output_file%~ STR_EQ ~~ BEGIN
    FAIL ~CBR readiness: the caller must supply resource_dir and output_file.~
  END
  ACTION_CLEAR_ARRAY cbr_rdy_spell_keys
  ACTION_CLEAR_ARRAY cbr_rdy_spell_grade
  ACTION_CLEAR_ARRAY cbr_rdy_spell_duration
  ACTION_CLEAR_ARRAY cbr_rdy_spell_opcode
  ACTION_CLEAR_ARRAY cbr_rdy_spell_parameter2
  ACTION_CLEAR_ARRAY cbr_rdy_spell_required
  ACTION_CLEAR_ARRAY cbr_rdy_emit_ambient
  ACTION_CLEAR_ARRAY cbr_rdy_ambient_resref
  ACTION_CLEAR_ARRAY cbr_rdy_ambient_delivery
  ACTION_CLEAR_ARRAY cbr_rdy_ambient_number
  ACTION_CLEAR_ARRAY cbr_rdy_ambient_duration
  ACTION_CLEAR_ARRAY cbr_rdy_override_keys
  ACTION_CLEAR_ARRAY cbr_rdy_override_grade
  ACTION_CLEAR_ARRAY cbr_rdy_override_include
  ACTION_CLEAR_ARRAY cbr_rdy_override_exclude

  COPY ~%spell_table%~ ~%spell_table%~
    COUNT_2DA_COLS cbr_rdy_spell_columns
    READ_2DA_ENTRIES_NOW cbr_rdy_spell_rows 6
    FOR (cbr_rdy_row = 0; cbr_rdy_row < cbr_rdy_spell_rows; ++cbr_rdy_row) BEGIN
      READ_2DA_ENTRY_FORMER cbr_rdy_spell_rows cbr_rdy_row 0 cbr_rdy_symbol
      READ_2DA_ENTRY_FORMER cbr_rdy_spell_rows cbr_rdy_row 1 cbr_rdy_grade
      READ_2DA_ENTRY_FORMER cbr_rdy_spell_rows cbr_rdy_row 2 cbr_rdy_min_duration
      READ_2DA_ENTRY_FORMER cbr_rdy_spell_rows cbr_rdy_row 3 cbr_rdy_detect_opcode
      READ_2DA_ENTRY_FORMER cbr_rdy_spell_rows cbr_rdy_row 4 cbr_rdy_detect_parameter2
      READ_2DA_ENTRY_FORMER cbr_rdy_spell_rows cbr_rdy_row 5 cbr_rdy_required
      SPRINT cbr_rdy_symbol ~%cbr_rdy_symbol%~
      TO_UPPER cbr_rdy_symbol
      INNER_ACTION BEGIN
        OUTER_SET $cbr_rdy_spell_keys(~%cbr_rdy_symbol%~) = 1
        OUTER_SET $cbr_rdy_spell_grade(~%cbr_rdy_symbol%~) = cbr_rdy_grade
        OUTER_SET $cbr_rdy_spell_duration(~%cbr_rdy_symbol%~) = cbr_rdy_min_duration
        OUTER_SET $cbr_rdy_spell_opcode(~%cbr_rdy_symbol%~) = cbr_rdy_detect_opcode
        OUTER_SET $cbr_rdy_spell_parameter2(~%cbr_rdy_symbol%~) = cbr_rdy_detect_parameter2
        OUTER_SET $cbr_rdy_spell_required(~%cbr_rdy_symbol%~) = cbr_rdy_required
      END
    END
  BUT_ONLY

  COPY ~%override_table%~ ~%override_table%~
    COUNT_2DA_COLS cbr_rdy_override_columns
    // COUNT_2DA_COLS reports only the three header cells when the shipped
    // table has no data rows; once a row exists it reports label+3 (=4).
    READ_2DA_ENTRIES_NOW cbr_rdy_override_rows 4
    FOR (cbr_rdy_row = 0; cbr_rdy_row < cbr_rdy_override_rows; ++cbr_rdy_row) BEGIN
      READ_2DA_ENTRY_FORMER cbr_rdy_override_rows cbr_rdy_row 0 cbr_rdy_actor
      READ_2DA_ENTRY_FORMER cbr_rdy_override_rows cbr_rdy_row 1 cbr_rdy_grade
      READ_2DA_ENTRY_FORMER cbr_rdy_override_rows cbr_rdy_row 2 cbr_rdy_include
      READ_2DA_ENTRY_FORMER cbr_rdy_override_rows cbr_rdy_row 3 cbr_rdy_exclude
      SPRINT cbr_rdy_actor ~%cbr_rdy_actor%~
      SPRINT cbr_rdy_include ~%cbr_rdy_include%~
      SPRINT cbr_rdy_exclude ~%cbr_rdy_exclude%~
      TO_UPPER cbr_rdy_actor
      TO_UPPER cbr_rdy_include
      TO_UPPER cbr_rdy_exclude
      PATCH_IF (~%cbr_rdy_include%~ STR_EQ ~-~) BEGIN SPRINT cbr_rdy_include ~~ END
      PATCH_IF (~%cbr_rdy_exclude%~ STR_EQ ~-~) BEGIN SPRINT cbr_rdy_exclude ~~ END
      INNER_ACTION BEGIN
        OUTER_SET $cbr_rdy_override_keys(~%cbr_rdy_actor%~) = 1
        OUTER_SET $cbr_rdy_override_grade(~%cbr_rdy_actor%~) = cbr_rdy_grade
        OUTER_SPRINT $cbr_rdy_override_include(~%cbr_rdy_actor%~) ~%cbr_rdy_include%~
        OUTER_SPRINT $cbr_rdy_override_exclude(~%cbr_rdy_actor%~) ~%cbr_rdy_exclude%~
      END
    END
  BUT_ONLY


  // Project Image is an identity used by the existing runtime, not a spell
  // fingerprint. Its absent resource cannot invalidate other candidates.
  LAF cbr_rdy_resolve_spell_symbol STR_VAR spell_ids symbol = ~WIZARD_PROJECT_IMAGE~
    RET cbr_rdy_project_image_found = found cbr_rdy_project_image_resref = spell_resref END
  ACTION_IF NOT cbr_rdy_project_image_found BEGIN
    PRINT ~CBR readiness: WIZARD_PROJECT_IMAGE is absent from SPELL.IDS; continuing.~
  END
  ACTION_TO_LOWER cbr_rdy_project_image_resref
  OUTER_SET ambient_count = 0
  ACTION_SORT_ARRAY_INDICES cbr_rdy_spell_keys LEXICOGRAPHICALLY
  ACTION_PHP_EACH cbr_rdy_spell_keys AS cbr_rdy_symbol => _ BEGIN
    LAF cbr_rdy_resolve_spell_symbol STR_VAR spell_ids symbol = EVAL ~%cbr_rdy_symbol%~
      RET cbr_rdy_found = found cbr_rdy_number = spell_number cbr_rdy_resref = spell_resref END
    ACTION_IF NOT cbr_rdy_found BEGIN
      PRINT ~CBR readiness: missing SPELL.IDS symbol %cbr_rdy_symbol%; continuing.~
    END ELSE ACTION_IF NOT FILE_EXISTS ~%resource_dir%/%cbr_rdy_resref%.SPL~ BEGIN
      PRINT ~CBR readiness: %cbr_rdy_resref%.SPL is absent; continuing.~
    END ELSE BEGIN
      LAF cbr_rdy_lookup_prebuff STR_VAR prebuff_map symbol = EVAL ~%cbr_rdy_symbol%~
        RET cbr_rdy_delivery_found = found cbr_rdy_delivery = delivery_resref END
      ACTION_IF NOT cbr_rdy_delivery_found OR NOT FILE_EXISTS ~%resource_dir%/%cbr_rdy_delivery%.SPL~ BEGIN
        // The memorized spell is also a valid delivery target. A missing SCS
        // cosmetic-free copy changes presentation, not candidate inclusion.
        OUTER_SPRINT cbr_rdy_delivery ~%cbr_rdy_resref%~
        PRINT ~CBR readiness: %cbr_rdy_symbol% uses its source spell for delivery.~
      END
      // The shipped manifest's decided durations, independent of old effects.
      OUTER_SET cbr_rdy_duration = $cbr_rdy_spell_duration(~%cbr_rdy_symbol%~)
      ACTION_IF ~%cbr_rdy_symbol%~ STR_EQ ~CLERIC_IMPERVIOUS_SANCTITY_OF_MIND~ BEGIN OUTER_SET cbr_rdy_duration = 2880 END
      ACTION_IF ~%cbr_rdy_symbol%~ STR_EQ ~WIZARD_MIND_BLANK~ BEGIN OUTER_SET cbr_rdy_duration = 7200 END
      OUTER_SET $cbr_rdy_emit_ambient(~%cbr_rdy_symbol%~) = 1
      OUTER_SPRINT $cbr_rdy_ambient_resref(~%cbr_rdy_symbol%~) ~%cbr_rdy_resref%~
      OUTER_SPRINT $cbr_rdy_ambient_delivery(~%cbr_rdy_symbol%~) ~%cbr_rdy_delivery%~
      OUTER_SET $cbr_rdy_ambient_number(~%cbr_rdy_symbol%~) = cbr_rdy_number
      OUTER_SET $cbr_rdy_ambient_duration(~%cbr_rdy_symbol%~) = cbr_rdy_duration
      OUTER_SET ambient_count += 1
    END
  END
  OUTER_SET urgent_count = 0
  ACTION_CLEAR_ARRAY cbr_rdy_urgent_key ACTION_CLEAR_ARRAY cbr_rdy_urgent_resref
  ACTION_CLEAR_ARRAY cbr_rdy_urgent_number ACTION_CLEAR_ARRAY cbr_rdy_urgent_genuine
  ACTION_FOR_EACH cbr_rdy_urgent_symbol IN ~WIZARD_ABSOLUTE_IMMUNITY~ ~WIZARD_IMPROVED_MANTLE~
    ~WIZARD_MANTLE~ ~WIZARD_PROTECTION_FROM_MAGIC_WEAPONS~ BEGIN
    LAF cbr_rdy_resolve_spell_symbol STR_VAR spell_ids symbol = EVAL ~%cbr_rdy_urgent_symbol%~
      RET cbr_rdy_found = found cbr_rdy_number = spell_number cbr_rdy_resref = spell_resref END
    ACTION_IF NOT cbr_rdy_found BEGIN
      PRINT ~CBR readiness: missing SPELL.IDS symbol %cbr_rdy_urgent_symbol%; continuing.~
    END ELSE ACTION_IF NOT FILE_EXISTS ~%resource_dir%/%cbr_rdy_resref%.SPL~ BEGIN
      PRINT ~CBR readiness: %cbr_rdy_resref%.SPL is absent; continuing.~
    END ELSE BEGIN
      OUTER_SPRINT $cbr_rdy_urgent_key(~%urgent_count%~) ~%cbr_rdy_urgent_symbol%~
      OUTER_SPRINT $cbr_rdy_urgent_resref(~%urgent_count%~) ~%cbr_rdy_resref%~
      OUTER_SET $cbr_rdy_urgent_number(~%urgent_count%~) = cbr_rdy_number
      // This slot is MoP under SR but remains a weapon protection in the
      // base game / SCS. Classify that capability, not the symbol's spelling.
      OUTER_SET cbr_rdy_genuine = 1
      ACTION_IF ~%cbr_rdy_urgent_symbol%~ STR_EQ ~WIZARD_IMPROVED_MANTLE~ BEGIN
        LAF cbr_scs_wp_classify_file
          STR_VAR resource_path = EVAL ~%resource_dir%/%cbr_rdy_resref%.SPL~
            resource_name = EVAL ~%cbr_rdy_resref%.SPL~
          RET cbr_rdy_genuine = is_weapon_protection END
      END
      OUTER_SET $cbr_rdy_urgent_genuine(~%urgent_count%~) = cbr_rdy_genuine
      OUTER_SET urgent_count += 1
    END
  END
  OUTER_SPRINT cbr_rdy_manifest ~{
    schema_version = 1,
    runtime_profile = {
        target_eeex_version = "1.2.0",
        primary_tick_listener = "EEex_Opcode_AddDeferredListsResolvedListener",
        legacy_tick_listener = "EEex_Opcode_AddListsResolvedListener",
        game_time_accessor = "m_worldTime.m_gameTime",
        legacy_nil_marshal_export = "empty_table",
        game_time_unit = "engine_ticks",
        game_time_ticks_per_second = 15,
        source_verified_on = "2026-09-02",
    },
    minimum_duration = 2400,
    maintenance_cadence_ticks = 15,
    contact_rearm_seconds = 6,
    project_image_resref = "%cbr_rdy_project_image_resref%",
    defaults = {
        ambient_enabled = 1,
        urgent_enabled = 1,
        external_owner = 0,
        scs_caster_grade = 1,
    },
    grades = {
        minimum = 0,
        baseline = 1,
        reserved_maximum = 3,
    },
    ambient_spells = {
~
  ACTION_SORT_ARRAY_INDICES cbr_rdy_emit_ambient LEXICOGRAPHICALLY
  ACTION_PHP_EACH cbr_rdy_emit_ambient AS cbr_rdy_symbol => cbr_rdy_discard BEGIN
    OUTER_SPRINT cbr_rdy_resref $cbr_rdy_ambient_resref(~%cbr_rdy_symbol%~)
    OUTER_SPRINT cbr_rdy_delivery $cbr_rdy_ambient_delivery(~%cbr_rdy_symbol%~)
    OUTER_SET cbr_rdy_number = $cbr_rdy_ambient_number(~%cbr_rdy_symbol%~)
    OUTER_SET cbr_rdy_actual_duration = $cbr_rdy_ambient_duration(~%cbr_rdy_symbol%~)
    OUTER_SET cbr_rdy_grade = $cbr_rdy_spell_grade(~%cbr_rdy_symbol%~)
    OUTER_SET cbr_rdy_detect_opcode = $cbr_rdy_spell_opcode(~%cbr_rdy_symbol%~)
    OUTER_SET cbr_rdy_detect_parameter2 = $cbr_rdy_spell_parameter2(~%cbr_rdy_symbol%~)
    OUTER_SPRINT cbr_rdy_manifest ~%cbr_rdy_manifest%        {
            key = "%cbr_rdy_symbol%",
            resref = "%cbr_rdy_resref%",
            spell_number = %cbr_rdy_number%,
            delivery = "%cbr_rdy_delivery%",
            duration = %cbr_rdy_actual_duration%,
            minimum_grade = %cbr_rdy_grade%,
            detection_opcode = %cbr_rdy_detect_opcode%,
            detection_parameter2 = %cbr_rdy_detect_parameter2%,
            self_target = 1,
            defensive = 1,
        },
~
  END
  OUTER_SPRINT cbr_rdy_manifest ~%cbr_rdy_manifest%    },
    urgent_candidates = {
~
  OUTER_FOR (cbr_rdy_emit_index = 0; cbr_rdy_emit_index < urgent_count; ++cbr_rdy_emit_index) BEGIN
    OUTER_SPRINT cbr_rdy_urgent_symbol $cbr_rdy_urgent_key(~%cbr_rdy_emit_index%~)
    OUTER_SPRINT cbr_rdy_resref $cbr_rdy_urgent_resref(~%cbr_rdy_emit_index%~)
    OUTER_SET cbr_rdy_number = $cbr_rdy_urgent_number(~%cbr_rdy_emit_index%~)
    OUTER_SET cbr_rdy_is_genuine = $cbr_rdy_urgent_genuine(~%cbr_rdy_emit_index%~)
    OUTER_SPRINT cbr_rdy_manifest ~%cbr_rdy_manifest%        {
            key = "%cbr_rdy_urgent_symbol%",
            resref = "%cbr_rdy_resref%",
            spell_number = %cbr_rdy_number%,
            genuine_weapon_immunity = %cbr_rdy_is_genuine%,
        },
~
  END
  OUTER_SPRINT cbr_rdy_manifest ~%cbr_rdy_manifest%    },
    overrides = {
~
  ACTION_SORT_ARRAY_INDICES cbr_rdy_override_keys LEXICOGRAPHICALLY
  ACTION_PHP_EACH cbr_rdy_override_keys AS cbr_rdy_actor => cbr_rdy_discard BEGIN
    OUTER_SET cbr_rdy_grade = $cbr_rdy_override_grade(~%cbr_rdy_actor%~)
    OUTER_SPRINT cbr_rdy_include $cbr_rdy_override_include(~%cbr_rdy_actor%~)
    OUTER_SPRINT cbr_rdy_exclude $cbr_rdy_override_exclude(~%cbr_rdy_actor%~)
    OUTER_SPRINT cbr_rdy_manifest ~%cbr_rdy_manifest%        ["%cbr_rdy_actor%"] = {
            grade = %cbr_rdy_grade%,
            include = "%cbr_rdy_include%",
            exclude = "%cbr_rdy_exclude%",
        },
~
  END
  OUTER_SPRINT cbr_rdy_manifest ~%cbr_rdy_manifest%    },
}
~

  OUTER_SPRINT manifest_text ~%cbr_rdy_manifest%~
  OUTER_SPRINT cbr_rdy_manifest_file ~return %cbr_rdy_manifest%~

  COPY ~%spell_table%~ ~%output_file%~
    DELETE_BYTES 0 BUFFER_LENGTH
    INSERT_BYTES 0 (STRING_LENGTH ~%cbr_rdy_manifest_file%~)
    WRITE_ASCIIE 0 ~%cbr_rdy_manifest_file%~

END

// Bundled template assertions belong in offline tests, not player installs.
DEFINE_ACTION_FUNCTION cbr_install_ambient_readiness_runtime
  STR_VAR spell_table = ~~ override_table = ~~ resource_dir = ~~ spell_ids = ~~ prebuff_map = ~~ template_file = ~~
  RET ambient_count urgent_count
BEGIN
  OUTER_SPRINT resource_dir EVALUATE_BUFFER ~%resource_dir%~
  OUTER_SPRINT template_file EVALUATE_BUFFER ~%template_file%~
  OUTER_SPRINT cbr_rdy_runtime_path ~%resource_dir%/M_CBRRDY.lua~
  LAF cbr_compile_ambient_readiness_manifest
    STR_VAR spell_table override_table resource_dir spell_ids prebuff_map
      output_file = EVAL ~%cbr_rdy_runtime_path%~
    RET ambient_count urgent_count cbr_rdy_runtime_manifest = manifest_text END
  COPY ~%template_file%~ ~%cbr_rdy_runtime_path%~
    REPLACE_TEXTUALLY ~%CBR_RDY_MANIFEST%~ ~%cbr_rdy_runtime_manifest%~
END
