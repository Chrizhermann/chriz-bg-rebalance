// chriz-bg-rebalance - Cleric of Tempus updated descriptions (component 408).
//
// The kit rework (400/401-403/404/405/407) changed what the kit actually does;
// this component makes the player-facing text match. Strategy: append three
// NEW dialog.tlk strings and repoint the consumers, never edit an existing
// string in place. That matters because OHTMPS1's description strref (6088 on
// live BG2:EE/EET) is SHARED with the standard priest spell Holy Power -
// a STRING_SET there would rewrite every priest's spell description. The
// kit-owned SoD strrefs (103223/103225) could be edited in place, but the
// append+repoint route is collision-proof for all three and WeiDU's
// identical-string reuse keeps reinstalls append-stable (404 precedent).
//
// Repoint targets:
//   * KITLIST.2DA - OHTEMPUS row, HELP column (the kit description);
//   * OHTMPS1.SPL - header 0x50 (Holy Power innate description);
//   * OHTMPS2.SPL - header 0x50 (Chaos of Battle innate description).
// Names (kit LOWER/MIXED, spell names) stay untouched. The identified-
// description dword at 0x54 stays untouched (unused/junk on both spells).
//
// Uninstall restores KITLIST/SPL bytes from backup; the appended TLK strings
// remain (accepted append-only residue, same class as 404's announce lines).

// The wrapper resolves complete bundled descriptions. No old text is read.
DEFINE_PATCH_FUNCTION cbr_ds_write_kit_help INT_VAR new_strref = 0 BEGIN
  LPM cbr_tempus_read_table
  SET cbr_ds_name_col = (0 - 1)
  PATCH_FOR_EACH cbr_ds_column IN ~ROWNAME~ ~HELP~ BEGIN
    SET cbr_ds_col = (0 - 1)
    FOR (cbr_ds_c = 0; cbr_ds_c < cbr_t_cols; ++cbr_ds_c) BEGIN
      SPRINT cbr_ds_name $cbr_t_cell(2 ~%cbr_ds_c%~)
      PATCH_IF ~%cbr_ds_name%~ STRING_EQUAL_CASE ~%cbr_ds_column%~ BEGIN SET cbr_ds_col = cbr_ds_c + 1 END
    END
    PATCH_IF cbr_ds_col < 0 BEGIN
      SPRINT $cbr_t_cell(2 ~%cbr_t_cols%~) ~%cbr_ds_column%~ ++cbr_t_cols SET cbr_ds_col = cbr_t_cols
      FOR (cbr_ds_r = 3; cbr_ds_r < cbr_t_lines; ++cbr_ds_r) BEGIN
        SPRINT $cbr_t_cell(~%cbr_ds_r%~ ~%cbr_ds_col%~) ~%cbr_t_default%~
      END
    END
    PATCH_IF ~%cbr_ds_column%~ STRING_EQUAL ~ROWNAME~ BEGIN SET cbr_ds_name_col = cbr_ds_col END
  END
  SET cbr_ds_found = 0 SET cbr_ds_next = 0
  FOR (cbr_ds_r = 3; cbr_ds_r < cbr_t_lines; ++cbr_ds_r) BEGIN
    SPRINT cbr_ds_index $cbr_t_cell(~%cbr_ds_r%~ 0)
    PATCH_IF IS_AN_INT ~%cbr_ds_index%~ BEGIN SET cbr_ds_next = (cbr_ds_next > cbr_ds_index ? cbr_ds_next : cbr_ds_index + 1) END
    SPRINT cbr_ds_name $cbr_t_cell(~%cbr_ds_r%~ ~%cbr_ds_name_col%~)
    PATCH_IF ~%cbr_ds_name%~ STRING_EQUAL_CASE ~OHTEMPUS~ BEGIN SET cbr_ds_found = 1 END
  END
  PATCH_IF NOT cbr_ds_found BEGIN
    SPRINT $cbr_t_cell(~%cbr_t_lines%~ 0) ~%cbr_ds_next%~
    FOR (cbr_ds_c = 1; cbr_ds_c <= cbr_t_cols; ++cbr_ds_c) BEGIN
      SPRINT $cbr_t_cell(~%cbr_t_lines%~ ~%cbr_ds_c%~) ~%cbr_t_default%~
    END
    SPRINT $cbr_t_cell(~%cbr_t_lines%~ ~%cbr_ds_name_col%~) ~OHTEMPUS~ ++cbr_t_lines
  END
  FOR (cbr_ds_r = 3; cbr_ds_r < cbr_t_lines; ++cbr_ds_r) BEGIN
    SPRINT cbr_ds_name $cbr_t_cell(~%cbr_ds_r%~ ~%cbr_ds_name_col%~)
    PATCH_IF ~%cbr_ds_name%~ STRING_EQUAL_CASE ~OHTEMPUS~ BEGIN
      FOR (cbr_ds_c = 0; cbr_ds_c < cbr_t_cols; ++cbr_ds_c) BEGIN
        SPRINT cbr_ds_column $cbr_t_cell(2 ~%cbr_ds_c%~)
        PATCH_IF ~%cbr_ds_column%~ STRING_EQUAL_CASE ~HELP~ BEGIN
          SET cbr_ds_col = cbr_ds_c + 1 SPRINT $cbr_t_cell(~%cbr_ds_r%~ ~%cbr_ds_col%~) ~%new_strref%~
        END
      END
    END
  END
  LPM cbr_tempus_write_table
END

DEFINE_PATCH_FUNCTION cbr_ds_set_spl_desc INT_VAR new_strref = 0 BEGIN
  PATCH_IF BUFFER_LENGTH >= 0x54 BEGIN
    WRITE_LONG 0x50 new_strref
  END ELSE BEGIN
    PATCH_PRINT ~CBR: %SOURCE_FILE% has no writable description field; leaving only this file unchanged.~
  END
END

DEFINE_ACTION_FUNCTION cbr_apply_tempus_descriptions
  INT_VAR kit_help_strref = (0 - 1) hp_desc_strref = (0 - 1) cob_desc_strref = (0 - 1)
  STR_VAR resource_dir = ~~ text_language = ~english~
BEGIN
  OUTER_SPRINT resource_dir EVALUATE_BUFFER ~%resource_dir%~
  ACTION_IF ~%resource_dir%~ STRING_EQUAL ~~ BEGIN FAIL ~CBR Tempus descriptions requires resource_dir.~ END
  ACTION_IF kit_help_strref < 0 OR hp_desc_strref < 0 OR cob_desc_strref < 0 BEGIN
    FAIL ~CBR Tempus descriptions requires three resolved description strrefs.~
  END
  ACTION_IF NOT (~%text_language%~ STRING_EQUAL_CASE ~english~ OR ~%text_language%~ STRING_EQUAL_CASE ~en_US~) BEGIN
    PRINT ~CBR: Tempus descriptions have no %text_language% translation; existing text is retained.~
  END ELSE BEGIN
    ACTION_IF NOT FILE_EXISTS ~%resource_dir%/KITLIST.2DA~ BEGIN
      <<<<<<<< cbr-description-kitlist
2DA V1.0
0
ROWNAME HELP
>>>>>>>>
      COPY ~cbr-description-kitlist~ ~%resource_dir%/KITLIST.2DA~
    END
    COPY ~%resource_dir%/KITLIST.2DA~ ~%resource_dir%/KITLIST.2DA~
      LPF cbr_ds_write_kit_help INT_VAR new_strref = kit_help_strref END
    BUT_ONLY
    ACTION_FOR_EACH cbr_ds_spell IN ~OHTMPS1~ ~OHTMPS2~ BEGIN
      OUTER_SET cbr_ds_ref = hp_desc_strref
      ACTION_IF ~%cbr_ds_spell%~ STRING_EQUAL ~OHTMPS2~ BEGIN OUTER_SET cbr_ds_ref = cob_desc_strref END
      ACTION_IF FILE_EXISTS ~%resource_dir%/%cbr_ds_spell%.SPL~ BEGIN
        COPY ~%resource_dir%/%cbr_ds_spell%.SPL~ ~%resource_dir%/%cbr_ds_spell%.SPL~
          LPF cbr_ds_set_spl_desc INT_VAR new_strref = cbr_ds_ref END
        BUT_ONLY
      END ELSE BEGIN PRINT ~CBR: %cbr_ds_spell%.SPL is absent; the other descriptions still apply.~ END
    END
  END
END
