<<<<<<<< cbr_cwa_empty_splprot
2DA V1.0
*
 STAT VALUE RELATION
>>>>>>>>

DEFINE_PATCH_FUNCTION cbr_cwa_table_read
  RET cbr_t_cols cbr_t_rows cbr_t_default
  RET_ARRAY cbr_t_head cbr_t_cell
BEGIN
  CLEAR_ARRAY cbr_t_head CLEAR_ARRAY cbr_t_cell CLEAR_ARRAY cbr_t_line CLEAR_ARRAY cbr_t_width
  SET line = 0
  READ_ASCII 0 source (BUFFER_LENGTH)
  INNER_PATCH ~%source%~ BEGIN
    REPLACE_EVALUATE ~[^%LNL%%MNL%]+~ BEGIN
      SPRINT content ~%MATCH0%~
      SET token = 0
      INNER_PATCH ~%content%~ BEGIN
        REPLACE_TEXTUALLY ~//.*~ ~~
        REPLACE_EVALUATE ~[^ %TAB%%LNL%%MNL%]+~ BEGIN
          SPRINT $cbr_t_line(~%line%~ ~%token%~) ~%MATCH0%~
          SET token += 1
        END ~%MATCH0%~
      END
      PATCH_IF token > 0 BEGIN SET $cbr_t_width(~%line%~) = token SET line += 1 END
    END ~%MATCH0%~
  END
  SPRINT cbr_t_default ~0~
  PATCH_IF line > 1 BEGIN SPRINT cbr_t_default $cbr_t_line(~1~ ~0~) END
  SET cbr_t_cols = 1 SET cbr_t_rows = 0
  PATCH_IF line > 2 BEGIN
    SET cbr_t_cols = $cbr_t_width(~2~) + 1
    FOR (c = 1; c < cbr_t_cols; ++c) BEGIN
      SET j = c - 1 SPRINT $cbr_t_head(~%c%~) $cbr_t_line(~2~ ~%j%~)
    END
    SET cbr_t_rows = line - 3
    FOR (r = 0; r < cbr_t_rows; ++r) BEGIN
      SET l = r + 3
      PATCH_IF $cbr_t_width(~%l%~) > cbr_t_cols BEGIN
        FOR (c = cbr_t_cols; c < $cbr_t_width(~%l%~); ++c) BEGIN SPRINT $cbr_t_head(~%c%~) ~CBR_COLUMN_%c%~ END
        SET cbr_t_cols = $cbr_t_width(~%l%~)
      END
    END
    FOR (r = 0; r < cbr_t_rows; ++r) BEGIN
      SET l = r + 3
      FOR (c = 0; c < cbr_t_cols; ++c) BEGIN
        SPRINT $cbr_t_cell(~%r%~ ~%c%~) ~%cbr_t_default%~
        PATCH_IF c < $cbr_t_width(~%l%~) BEGIN SPRINT $cbr_t_cell(~%r%~ ~%c%~) $cbr_t_line(~%l%~ ~%c%~) END
      END
    END
  END
END

DEFINE_PATCH_FUNCTION cbr_cwa_table_write
BEGIN
  SPRINT output ~2DA V1.0%WNL%%cbr_t_default%%WNL%~
  FOR (c = 1; c < cbr_t_cols; ++c) BEGIN
    SPRINT value $cbr_t_head(~%c%~) SPRINT output ~%output% %value%~
  END
  SPRINT output ~%output%%WNL%~
  FOR (r = 0; r < cbr_t_rows; ++r) BEGIN
    FOR (c = 0; c < cbr_t_cols; ++c) BEGIN
      SPRINT value $cbr_t_cell(~%r%~ ~%c%~) SPRINT output ~%output%%value% ~
    END
    SPRINT output ~%output%%WNL%~
  END
  DELETE_BYTES 0 BUFFER_LENGTH INSERT_BYTES 0 (STRING_LENGTH ~%output%~) WRITE_ASCIIE 0 ~%output%~
END

DEFINE_PATCH_FUNCTION cbr_cwa_normalize_2da
  STR_VAR required = ~~
BEGIN
  LPF cbr_cwa_table_read RET cbr_t_cols cbr_t_rows cbr_t_default RET_ARRAY cbr_t_head cbr_t_cell END
  SET changed = 0
  // Padding short rows and adding named columns makes subsequent address reads safe.
  COUNT_2DA_COLS width
  COUNT_2DA_ROWS cbr_t_cols complete_rows
  PATCH_IF width != cbr_t_cols OR complete_rows != cbr_t_rows BEGIN SET changed = 1 END
  INNER_PATCH ~%required%~ BEGIN
    REPLACE_EVALUATE ~[^ ]+~ BEGIN
      SPRINT required_name ~%MATCH0%~ SET found = 0
      FOR (c = 1; c < cbr_t_cols; ++c) BEGIN
        SPRINT name $cbr_t_head(~%c%~)
        PATCH_IF ~%name%~ STRING_EQUAL_CASE ~%required_name%~ BEGIN SET found = 1 END
      END
      PATCH_IF NOT found BEGIN
        SET c = cbr_t_cols SPRINT $cbr_t_head(~%c%~) ~%required_name%~
        FOR (r = 0; r < cbr_t_rows; ++r) BEGIN SPRINT $cbr_t_cell(~%r%~ ~%c%~) ~%cbr_t_default%~ END
        SET cbr_t_cols += 1 SET changed = 1
      END
    END ~%MATCH0%~
  END
  PATCH_IF changed BEGIN LPF cbr_cwa_table_write END END
END

DEFINE_PATCH_FUNCTION cbr_cwa_named_column
  STR_VAR name = ~~ required = ~~
  RET data_column
BEGIN
  LPF cbr_cwa_normalize_2da STR_VAR required = EVAL ~%required% %name%~ END
  LPF cbr_cwa_table_read RET cbr_t_cols cbr_t_rows cbr_t_default RET_ARRAY cbr_t_head cbr_t_cell END
  SET data_column = 1
  FOR (c = cbr_t_cols - 1; c >= 1; --c) BEGIN
    SPRINT header $cbr_t_head(~%c%~)
    PATCH_IF ~%header%~ STRING_EQUAL_CASE ~%name%~ BEGIN SET data_column = c END
  END
END

// Components 410/411 own the requested proficiency cells, class/kit grants,
// usability bits and complete English descriptions. Dynamic caps still follow
// the existing class rules. Shared kit columns receive private copies. Resource
// bounds are read only to address writes; native-hook signatures remain safety checks.

DEFINE_PATCH_FUNCTION cbr_cwa_weapprof_column
  STR_VAR name = ~~ RET data_column
BEGIN
  COUNT_2DA_COLS old_cols
  LPF cbr_cwa_named_column STR_VAR name required = ~ID NAME_REF DESC_REF~ RET data_column END
  COUNT_2DA_COLS cols COUNT_2DA_ROWS cols rows
  PATCH_IF rows <= 1 BEGIN
    LPF cbr_cwa_table_read RET cbr_t_cols cbr_t_rows cbr_t_default RET_ARRAY cbr_t_head cbr_t_cell END
    PATCH_IF cbr_t_rows = 0 BEGIN
      SPRINT $cbr_t_cell(~0~ ~0~) ~CBR_PROF_92~
      FOR (c = 1; c < cbr_t_cols; ++c) BEGIN
        SPRINT header $cbr_t_head(~%c%~) SPRINT $cbr_t_cell(~0~ ~%c%~) ~0~
        PATCH_IF ~%header%~ STRING_EQUAL_CASE ~ID~ BEGIN SPRINT $cbr_t_cell(~0~ ~%c%~) ~92~ END
      END
      SET cbr_t_rows = 1 LPF cbr_cwa_table_write END
    END
  END
  PATCH_IF data_column >= old_cols AND NOT (~%name%~ STRING_EQUAL_CASE ~ID~) BEGIN
    LPF cbr_cwa_named_column STR_VAR name = ~ID~ RET id_col = data_column END
    COUNT_2DA_COLS cols READ_2DA_ENTRIES_NOW data cols
    FOR (r = 0; r < data; ++r) BEGIN
      READ_2DA_ENTRY_FORMER data r id_col id
      PATCH_IF IS_AN_INT ~%id%~ BEGIN
        LPF cbr_cwa_default_cap INT_VAR proficiency = id STR_VAR class_name = EVAL ~%name%~ RET cap END
        SET_2DA_ENTRY r data_column cols cap
      END
    END
  END
END

// The component has already supplied these columns and padded its rows.
DEFINE_PATCH_FUNCTION cbr_cwa_lookup_column
  STR_VAR name = ~~ RET data_column
BEGIN
  COUNT_2DA_COLS cols READ_2DA_ENTRIES_NOW headers (cols - 1)
  SET data_column = 1
  FOR (c = cols - 2; c >= 0; --c) BEGIN
    READ_2DA_ENTRY_FORMER headers 0 c header
    PATCH_IF ~%header%~ STRING_EQUAL_CASE ~%name%~ BEGIN SET data_column = c + 1 END
  END
END

DEFINE_PATCH_FUNCTION cbr_cwa_default_cap
  INT_VAR proficiency = 0 STR_VAR class_name = ~~ RET cap
BEGIN
  SET cap = 0
  SET druid = proficiency = 95 OR proficiency = 96 OR proficiency = 115 OR proficiency = 98 OR proficiency = 102 OR proficiency = 106 OR proficiency = 107
  SET cleric = proficiency = 97 OR proficiency = 115 OR proficiency = 100 OR proficiency = 101 OR proficiency = 102 OR proficiency = 107
  SET style = proficiency >= 111 AND proficiency <= 114
  PATCH_IF (~%class_name%~ STRING_EQUAL_CASE ~DRUID~) AND (druid OR style) BEGIN SET cap = 1 END
  PATCH_IF (~%class_name%~ STRING_EQUAL_CASE ~CLERIC~) AND (cleric OR style) BEGIN SET cap = 1 END
  PATCH_IF ((~%class_name%~ STRING_EQUAL_CASE ~FIGHTER_DRUID~) AND (druid OR style)) OR ((~%class_name%~ STRING_EQUAL_CASE ~FIGHTER_CLERIC~) AND (cleric OR style)) BEGIN
    SET cap = 2 PATCH_IF proficiency = 114 BEGIN SET cap = 3 END
  END
END


DEFINE_PATCH_FUNCTION cbr_cwa_weapprof_header_of
  INT_VAR
    data_column = 0
  RET
    name
BEGIN
  SPRINT name ~~
  COUNT_2DA_COLS cbr_cwa_cols
  SET cbr_cwa_wide_cols = cbr_cwa_cols - 1
  PATCH_IF (data_column >= 1 && data_column <= cbr_cwa_wide_cols) BEGIN
    READ_2DA_ENTRIES_NOW cbr_cwa_wide cbr_cwa_wide_cols
    READ_2DA_ENTRY_FORMER cbr_cwa_wide 0 (data_column - 1) name
  END
END

// The data row whose ID cell (data column 1) is `proficiency`. Exactly one is
// required: the engine maps a proficiency to its row by this ID.
DEFINE_PATCH_FUNCTION cbr_cwa_weapprof_row
  INT_VAR proficiency = 0 RET data_row
BEGIN
  LPF cbr_cwa_lookup_column STR_VAR name = ~ID~ RET id_col = data_column END
  COUNT_2DA_COLS cols READ_2DA_ENTRIES_NOW data cols
  SET data_row = (0 - 1)
  FOR (r = data - 1; r >= 0; --r) BEGIN
    READ_2DA_ENTRY_FORMER data r id_col id
    PATCH_IF IS_AN_INT ~%id%~ BEGIN PATCH_IF id = proficiency BEGIN SET data_row = r END END
  END
  PATCH_IF data_row < 0 BEGIN
    SPRINT row ~%WNL%CBR_PROF_%proficiency%~
    FOR (c = 1; c < cols; ++c) BEGIN
      LPF cbr_cwa_weapprof_header_of INT_VAR data_column = c RET name END
      LPF cbr_cwa_default_cap INT_VAR proficiency STR_VAR class_name = EVAL ~%name%~ RET value = cap END
      PATCH_IF c = id_col BEGIN SET value = proficiency END
      SPRINT row ~%row% %value%~
    END
    SPRINT row ~%row%%WNL%~ SET at = BUFFER_LENGTH
    INSERT_BYTES at (STRING_LENGTH ~%row%~) WRITE_ASCIIE at ~%row%~
    SET data_row = data
  END
END


DEFINE_PATCH_FUNCTION cbr_cwa_is_weapon_proficiency
  INT_VAR
    proficiency = 0
  RET
    is_weapon
BEGIN
  SET is_weapon = ((proficiency >= 89 && proficiency <= 107) || proficiency = 115)
END

// The highest cap one column gives any individual weapon; with
// filter_column, only weapons that column also allows count.
DEFINE_PATCH_FUNCTION cbr_cwa_column_weapon_cap
  INT_VAR
    data_column   = 0
    filter_column = "-1"
  RET
    cap
BEGIN
  SET cap = 0
  LPF cbr_cwa_lookup_column STR_VAR name = ~ID~ RET cbr_cwa_id_col = data_column END
  COUNT_2DA_COLS cbr_cwa_cols
  READ_2DA_ENTRIES_NOW cbr_cwa_data cbr_cwa_cols
  FOR (cbr_cwa_row = 0; cbr_cwa_row < cbr_cwa_data; ++cbr_cwa_row) BEGIN
    READ_2DA_ENTRY_FORMER cbr_cwa_data cbr_cwa_row cbr_cwa_id_col cbr_cwa_id
    SET cbr_cwa_weapon = 0
    PATCH_IF (IS_AN_INT ~%cbr_cwa_id%~) BEGIN
      LPF cbr_cwa_is_weapon_proficiency INT_VAR proficiency = cbr_cwa_id RET cbr_cwa_weapon = is_weapon END
    END
    PATCH_IF (cbr_cwa_weapon) BEGIN
      READ_2DA_ENTRY_FORMER cbr_cwa_data cbr_cwa_row data_column cbr_cwa_value
      PATCH_IF !(IS_AN_INT ~%cbr_cwa_value%~) BEGIN
        SET cbr_cwa_value = 0
      END
      SET cbr_cwa_counted = 1
      PATCH_IF (filter_column >= 0) BEGIN
        READ_2DA_ENTRY_FORMER cbr_cwa_data cbr_cwa_row filter_column cbr_cwa_filter
        PATCH_IF !(IS_AN_INT ~%cbr_cwa_filter%~) BEGIN
          // With no numeric cleric permission, use the base cleric weapon set.
          SET cbr_cwa_filter = (cbr_cwa_id = 97 OR cbr_cwa_id = 115 OR cbr_cwa_id = 100
            OR cbr_cwa_id = 101 OR cbr_cwa_id = 102 OR cbr_cwa_id = 107)
        END
        SET cbr_cwa_counted = (cbr_cwa_filter > 0)
      END
      PATCH_IF (cbr_cwa_counted && cbr_cwa_value > cap) BEGIN
        SET cap = cbr_cwa_value
      END
    END
  END
END

// Write the decided exact value or minimum. The second pass writes as well;
// old cells are not an installation precondition. changed is only a log count.
DEFINE_PATCH_FUNCTION cbr_cwa_set_cell
  INT_VAR data_row = 0 data_column = 0 minimum = "-1" exact = "-1" verify_only = 0
  RET changed
BEGIN
  LPF cbr_cwa_lookup_column STR_VAR name = ~ID~ RET id_col = data_column END
  COUNT_2DA_COLS cbr_cwa_cols
  READ_2DA_ENTRY data_row id_col cbr_cwa_cols owned_id
  READ_2DA_ENTRIES_NOW column_names (cbr_cwa_cols - 1)
  READ_2DA_ENTRY_FORMER column_names 0 (data_column - 1) owned_column
  SET changed = 0
  READ_2DA_ENTRIES_NOW cells cbr_cwa_cols
  FOR (r = 0; r < cells; ++r) BEGIN
    READ_2DA_ENTRY_FORMER cells r id_col id
    SET owned = r = data_row
    PATCH_IF IS_AN_INT ~%id%~ AND IS_AN_INT ~%owned_id%~ BEGIN SET owned = id = owned_id END
    PATCH_IF owned BEGIN
      FOR (c = 1; c < cbr_cwa_cols; ++c) BEGIN
        READ_2DA_ENTRY_FORMER column_names 0 (c - 1) column
        PATCH_IF ~%column%~ STRING_EQUAL_CASE ~%owned_column%~ BEGIN
          READ_2DA_ENTRY_FORMER cells r c cbr_cwa_value
          PATCH_IF NOT IS_AN_INT ~%cbr_cwa_value%~ BEGIN SET cbr_cwa_value = 0 SET changed = 1 END
          SET cbr_cwa_target = cbr_cwa_value
          PATCH_IF minimum > cbr_cwa_target BEGIN SET cbr_cwa_target = minimum END
          PATCH_IF exact >= 0 BEGIN SET cbr_cwa_target = exact END
          SET changed = changed OR cbr_cwa_target != cbr_cwa_value
          SET_2DA_ENTRY r c cbr_cwa_cols ~%cbr_cwa_target%~
        END
      END
    END
  END
END

// ---------------------------------------------------------------------------
// KITLIST.2DA
// ---------------------------------------------------------------------------
//
// Fills cbr_cwa_kit_name/_column/_class for every data row whose PROFICIENCY
// and CLASS cells are numeric; cbr_cwa_kits is the count. The column holds
// the WEAPPROF data column (PROFICIENCY + 1). Columns are found by header
// name, so their order is not assumed.
DEFINE_ACTION_FUNCTION cbr_cwa_read_kits
  RET cbr_cwa_kits RET_ARRAY cbr_cwa_kit_name cbr_cwa_kit_column cbr_cwa_kit_class
BEGIN
  OUTER_SET cbr_cwa_kits = 0
  COPY_EXISTING ~KITLIST.2DA~ ~override~
    LPF cbr_cwa_named_column STR_VAR name = ~ROWNAME~ required = ~ROWNAME LOWER MIXED HELP ABILITIES PROFICIENCY UNUSABLE CLASS KITIDS~ RET name_col = data_column END
    LPF cbr_cwa_named_column STR_VAR name = ~PROFICIENCY~ RET prof_col = data_column END
    LPF cbr_cwa_named_column STR_VAR name = ~CLASS~ RET class_col = data_column END
    COUNT_2DA_COLS cols READ_2DA_ENTRIES_NOW data cols
    FOR (r = 0; r < data; ++r) BEGIN
      READ_2DA_ENTRY_FORMER data r name_col name
      READ_2DA_ENTRY_FORMER data r prof_col prof
      READ_2DA_ENTRY_FORMER data r class_col class
      PATCH_IF NOT IS_AN_INT ~%prof%~ BEGIN SET prof = (0 - 1) END
      PATCH_IF NOT IS_AN_INT ~%class%~ BEGIN
        SET class = 0
        PATCH_IF (~%name%~ STRING_EQUAL_CASE ~TOTEMIC_DRUID~) OR (~%name%~ STRING_EQUAL_CASE ~SHAPESHIFTER~) OR (~%name%~ STRING_EQUAL_CASE ~AVENGER~) BEGIN SET class = 11 END
        PATCH_IF ~%name%~ STRING_EQUAL_CASE ~LK_ALAGHOR~ BEGIN SET class = 3 END
      END
      SPRINT $cbr_cwa_kit_name(~%cbr_cwa_kits%~) ~%name%~
      SET $cbr_cwa_kit_column(~%cbr_cwa_kits%~) = prof + 1
      SET $cbr_cwa_kit_class(~%cbr_cwa_kits%~) = class
      SET cbr_cwa_kits += 1
    END
  BUT_ONLY
END


DEFINE_PATCH_FUNCTION cbr_cwa_is_class_column_name
  STR_VAR
    name = ~~
  RET
    is_class
BEGIN
  SET is_class = 0
  PATCH_FOR_EACH cbr_cwa_class_name IN
      MAGE FIGHTER CLERIC THIEF BARD PALADIN DRUID RANGER FIGHTER_MAGE
      FIGHTER_CLERIC FIGHTER_THIEF FIGHTER_MAGE_THIEF MAGE_THIEF CLERIC_MAGE
      CLERIC_THIEF FIGHTER_DRUID FIGHTER_MAGE_CLERIC CLERIC_RANGER MONK SHAMAN
      SORCERER BEGIN
    PATCH_IF (~%name%~ STRING_EQUAL_CASE ~%cbr_cwa_class_name%~) BEGIN
      SET is_class = 1
    END
  END
END

// The WEAPPROF data columns of every kit of `kit_class` that can be changed
// on its own, deduplicated, as cbr_cwa_owned_column (count cbr_cwa_owned).
// Shared or reused columns are copied to the affected kit before its cells
// are written. Expects cbr_cwa_read_kits' arrays in scope.
DEFINE_ACTION_FUNCTION cbr_cwa_owned_kit_columns
  INT_VAR kit_class = 0 allowed_class_a = 0 allowed_class_b = 0 log_component = 0
  RET cbr_cwa_owned RET_ARRAY cbr_cwa_owned_column
BEGIN
  OUTER_SET cbr_cwa_owned = 0
  OUTER_FOR (k = 0; k < cbr_cwa_kits; ++k) BEGIN
    ACTION_IF $cbr_cwa_kit_class(~%k%~) = kit_class BEGIN
      OUTER_SPRINT name $cbr_cwa_kit_name(~%k%~)
      OUTER_SET old_column = $cbr_cwa_kit_column(~%k%~)
      LAF cbr_cwa_private_kit_column INT_VAR old_column STR_VAR kit_name = EVAL ~%name%~ RET column END
      OUTER_SET $cbr_cwa_owned_column(~%cbr_cwa_owned%~) = column
      OUTER_SET cbr_cwa_owned += 1
    END
  END
END

// Each affected kit gets an address that can be written without widening a
// different class or kit which happened to share its former column.
DEFINE_ACTION_FUNCTION cbr_cwa_private_kit_column
  INT_VAR old_column = 0 STR_VAR kit_name = ~~ RET column
BEGIN
  OUTER_SPRINT private_name ~%kit_name%~
  OUTER_SET shared = 0
  OUTER_FOR (j = 0; j < cbr_cwa_kits; ++j) BEGIN
    OUTER_SPRINT other $cbr_cwa_kit_name(~%j%~)
    ACTION_IF $cbr_cwa_kit_column(~%j%~) = old_column AND NOT (~%other%~ STRING_EQUAL_CASE ~%kit_name%~) BEGIN OUTER_SET shared = 1 END
  END
  COPY_EXISTING ~WEAPPROF.2DA~ ~override~
    LPF cbr_cwa_weapprof_header_of INT_VAR data_column = old_column RET old_name = name END
    PATCH_IF ~%old_name%~ STRING_EQUAL_CASE ~CBR_%kit_name%~ BEGIN SPRINT private_name ~%old_name%~ END
    PATCH_IF shared AND (~%old_name%~ STRING_EQUAL_CASE ~%kit_name%~) BEGIN SPRINT private_name ~CBR_%kit_name%~ END
    COUNT_2DA_COLS old_cols
    LPF cbr_cwa_weapprof_column STR_VAR name = EVAL ~%private_name%~ RET column = data_column END
    PATCH_IF column >= old_cols AND old_column > 0 AND old_column < old_cols BEGIN
      COUNT_2DA_COLS cols READ_2DA_ENTRIES_NOW data cols
      FOR (r = 0; r < data; ++r) BEGIN
        READ_2DA_ENTRY_FORMER data r old_column value SET_2DA_ENTRY r column cols ~%value%~
      END
    END
  BUT_ONLY
  COPY_EXISTING ~KITLIST.2DA~ ~override~
    LPF cbr_cwa_named_column STR_VAR name = ~ROWNAME~ RET name_col = data_column END
    LPF cbr_cwa_named_column STR_VAR name = ~PROFICIENCY~ RET prof_col = data_column END
    COUNT_2DA_COLS cols READ_2DA_ENTRIES_NOW data cols
    FOR (r = 0; r < data; ++r) BEGIN
      READ_2DA_ENTRY_FORMER data r name_col name
      PATCH_IF ~%name%~ STRING_EQUAL_CASE ~%kit_name%~ BEGIN SET_2DA_ENTRY r prof_col cols (column - 1) END
    END
  BUT_ONLY
END


DEFINE_PATCH_FUNCTION cbr_cwa_splprot_rows
  INT_VAR stat = 0 value = 0 relation = 0 RET rows
BEGIN
  LPF cbr_cwa_normalize_2da STR_VAR required = ~STAT VALUE RELATION~ END
  LPF cbr_cwa_named_column STR_VAR name = ~STAT~ RET sc = data_column END
  LPF cbr_cwa_named_column STR_VAR name = ~VALUE~ RET vc = data_column END
  LPF cbr_cwa_named_column STR_VAR name = ~RELATION~ RET rc = data_column END
  LPF cbr_cwa_table_read RET cbr_t_cols cbr_t_rows cbr_t_default RET_ARRAY cbr_t_head cbr_t_cell END
  PATCH_IF sc != 1 OR vc != 2 OR rc != 3 OR cbr_t_cols != 4 BEGIN
    SPRINT output ~2DA V1.0%WNL%*%WNL% STAT VALUE RELATION%WNL%~
    FOR (r = 0; r < cbr_t_rows; ++r) BEGIN
      SPRINT label $cbr_t_cell(~%r%~ ~0~) SPRINT sv $cbr_t_cell(~%r%~ ~%sc%~)
      SPRINT vv $cbr_t_cell(~%r%~ ~%vc%~) SPRINT rv $cbr_t_cell(~%r%~ ~%rc%~)
      SPRINT output ~%output%%label% %sv% %vv% %rv%%WNL%~
    END
    DELETE_BYTES 0 BUFFER_LENGTH INSERT_BYTES 0 (STRING_LENGTH ~%output%~) WRITE_ASCIIE 0 ~%output%~
  END
  SET sc = 1 SET vc = 2 SET rc = 3 SET cols = 4
  SPRINT rows ~ ~ READ_2DA_ENTRIES_NOW data cols
  FOR (r = 0; r < data; ++r) BEGIN
    READ_2DA_ENTRY_FORMER data r sc sv READ_2DA_ENTRY_FORMER data r vc vv READ_2DA_ENTRY_FORMER data r rc rv
    PATCH_IF IS_AN_INT ~%sv%~ AND IS_AN_INT ~%vv%~ AND IS_AN_INT ~%rv%~ BEGIN
      PATCH_IF sv = stat AND vv = value AND rv = relation BEGIN SPRINT rows ~%rows%%r% ~ END
    END
  END
END

DEFINE_PATCH_FUNCTION cbr_cwa_append_splprot
  INT_VAR stat = 0 value = 0 relation = 0 STR_VAR row_label = ~~ RET row_index
BEGIN
  LPF cbr_cwa_splprot_rows INT_VAR stat value relation RET rows END
  SET row_index = (0 - 1)
  INNER_PATCH ~%rows%~ BEGIN
    REPLACE_EVALUATE ~[0-9]+~ BEGIN PATCH_IF row_index < 0 BEGIN SET row_index = MATCH0 END END ~%MATCH0%~
  END
  PATCH_IF row_index < 0 BEGIN
    LPF cbr_cwa_named_column STR_VAR name = ~STAT~ RET sc = data_column END
    LPF cbr_cwa_named_column STR_VAR name = ~VALUE~ RET vc = data_column END
    LPF cbr_cwa_named_column STR_VAR name = ~RELATION~ RET rc = data_column END
    SET cols = 4 COUNT_2DA_ROWS cols row_index
    SPRINT row ~%WNL%%row_label%~
    FOR (c = 1; c < cols; ++c) BEGIN
      SPRINT cell ~*~
      PATCH_IF c = sc BEGIN SPRINT cell ~%stat%~ END
      PATCH_IF c = vc BEGIN SPRINT cell ~%value%~ END
      PATCH_IF c = rc BEGIN SPRINT cell ~%relation%~ END
      SPRINT row ~%row% %cell%~
    END
    SPRINT row ~%row%%WNL%~ SET at = BUFFER_LENGTH INSERT_BYTES at (STRING_LENGTH ~%row%~) WRITE_ASCIIE at ~%row%~
  END
END


DEFINE_ACTION_FUNCTION cbr_cwa_grant_rows
  INT_VAR
    kit_stat = 152
    need_kit = 0
  RET
    class_row
    class_rows
    kit_row
    kit_rows
BEGIN
  OUTER_SET kit_row = "-1"
  OUTER_SPRINT kit_rows ~ ~
  COPY_EXISTING ~SPLPROT.2DA~ ~override~
    LPF cbr_cwa_append_splprot
      INT_VAR stat = 0x10d value = "-1" relation = 1
      STR_VAR row_label = ~CBR_CWA_CLASS_EQ~
      RET class_row = row_index
    END
    LPF cbr_cwa_splprot_rows INT_VAR stat = 0x10d value = "-1" relation = 1 RET class_rows = rows END
    PATCH_IF (need_kit) BEGIN
      LPF cbr_cwa_append_splprot
        INT_VAR stat = kit_stat value = "-1" relation = 1
        STR_VAR row_label = ~CBR_CWA_KIT_EQ~
        RET kit_row = row_index
      END
      LPF cbr_cwa_splprot_rows INT_VAR stat = kit_stat value = "-1" relation = 1 RET kit_rows = rows END
    END
  BUT_ONLY
END

// ---------------------------------------------------------------------------
// C0PR#CL.SPL permission grants (Artisan's Kitpack)
// ---------------------------------------------------------------------------

// Rebuild the referenced slices with one canonical grant per ability.
// Empty slices have no address, regardless of their unused first-index field.
DEFINE_PATCH_FUNCTION cbr_cwa_ensure_permission_grant
  INT_VAR condition_value = 0 condition_row = 0 keep_special = 1 verify_only = 0
  STR_VAR condition_rows = ~~ class_rows = ~~ permission = ~~
  RET inserted missing
BEGIN
  SET inserted = 0 SET missing = 0
  PATCH_IF FILE_EXISTS_IN_GAME ~%permission%.SPL~ BEGIN
    LPF cbr_foa_layout INT_VAR stride = 0x28 RET ab na fx eq_first eq_count readable END
    PATCH_IF readable BEGIN
      READ_ASCII 0 original (BUFFER_LENGTH)
      PATCH_IF na = 0 BEGIN
        SET ab = 0x72 INSERT_BYTES ab 0x28 WRITE_LONG 0x64 ab WRITE_SHORT 0x68 1
        PATCH_IF fx >= ab BEGIN SET fx += 0x28 WRITE_LONG 0x6a fx END
        WRITE_BYTE ab 1 WRITE_BYTE (ab + 0xc) 5 WRITE_SHORT (ab + 0x10) 1 WRITE_SHORT (ab + 0x26) 1
        SET na = 1
      END
      // Rebuild only referenced slices. Their table order and sharing do not
      // determine whether a grant is written. Unused bytes remain after the table.
      SET effect_end = 0
      PATCH_IF eq_count > 0 BEGIN SET effect_end = eq_first + eq_count END
      FOR (h = 0; h < na; ++h) BEGIN
        READ_SHORT (ab + h * 0x28 + 0x1e) n READ_SHORT (ab + h * 0x28 + 0x20) first
        PATCH_IF n > 0 AND first + n > effect_end BEGIN SET effect_end = first + n END
      END
      SPRINT effects ~~ SET next_index = 0
      PATCH_IF eq_count > 0 BEGIN READ_ASCII (fx + eq_first * 0x30) effects (eq_count * 0x30) END
      SET next_index = eq_count SET fits = 1 WRITE_SHORT 0x6e 0
      FOR (h = 0; h < na; ++h) BEGIN
        SET header = ab + h * 0x28
        READ_SHORT (header + 0x1e) n READ_SHORT (header + 0x20) first
        SPRINT kept ~~ SET count = 0 SET insert_at = 0
        FOR (i = 0; i < n; ++i) BEGIN
          SET at = fx + (first + i) * 0x30
          READ_SHORT at op READ_LONG (at + 4) p1 READ_LONG (at + 8) p2 READ_ASCII (at + 0x14) res (8) NULL
          SET ours = op = 326 AND p1 = condition_value AND (~%res%~ STRING_EQUAL_CASE ~%permission%~)
          PATCH_IF NOT ours BEGIN
            READ_ASCII at record (0x30) SPRINT kept ~%kept%%record%~ SET count += 1
            PATCH_IF (op = 321 OR op = 326) AND ((~%res%~ STRING_MATCHES_REGEXP ~^C0PR#[0-9]+$~) = 0) BEGIN SET insert_at = count END
          END
        END
        INNER_PATCH_SAVE grant ~~ BEGIN
          INSERT_BYTES 0 0x30 WRITE_SHORT 0 326 WRITE_BYTE 2 2 WRITE_BYTE 0x12 100
          WRITE_LONG 4 condition_value WRITE_LONG 8 condition_row WRITE_ASCIIE 0x14 ~%permission%~ #8
          PATCH_IF keep_special BEGIN WRITE_LONG 0x2c 99999 END
        END
        INNER_PATCH_SAVE kept ~%kept%~ BEGIN INSERT_BYTES (insert_at * 0x30) 0x30 WRITE_ASCIIE (insert_at * 0x30) ~%grant%~ END
        PATCH_IF next_index <= 0xffff AND count < 0xffff BEGIN
          WRITE_SHORT (header + 0x20) next_index WRITE_SHORT (header + 0x1e) (count + 1)
        END ELSE BEGIN SET fits = 0 END
        SET next_index += count + 1 SPRINT effects ~%effects%%kept%~ SET inserted += 1
      END
      PATCH_IF fits BEGIN
        DELETE_BYTES fx (effect_end * 0x30) INSERT_BYTES fx (STRING_LENGTH ~%effects%~) WRITE_ASCIIE fx ~%effects%~
        PATCH_IF ab > fx BEGIN WRITE_LONG 0x64 (ab + STRING_LENGTH ~%effects%~ - effect_end * 0x30) END
      END ELSE BEGIN
        DELETE_BYTES 0 BUFFER_LENGTH INSERT_BYTES 0 (STRING_LENGTH ~%original%~) WRITE_ASCIIE 0 ~%original%~
        SET inserted = 0
        PATCH_PRINT ~CBR weapon access: %SOURCE_FILE% cannot address the new grant slices; only this resource is unchanged.~
      END
    END
  END ELSE BEGIN PATCH_PRINT ~CBR weapon access: %permission%.SPL is absent; this permission grant is unavailable.~ END
END


DEFINE_PATCH_FUNCTION cbr_cwa_lift_druid_item_restrictions
  INT_VAR
    druid_class         = 11
    fighter_druid_class = 16
  RET
    lifted
BEGIN
  SET lifted = 0
  PATCH_IF (BUFFER_LENGTH >= 0x72) BEGIN
    READ_ASCII 0x00 cbr_cwa_signature (8)
    READ_BYTE 0x31 cbr_cwa_proficiency
    SET cbr_cwa_druid_type = (cbr_cwa_proficiency = 92 || cbr_cwa_proficiency = 105)
    SET cbr_cwa_fd_type = (cbr_cwa_druid_type || cbr_cwa_proficiency = 104)
    READ_LONG 0x1e cbr_cwa_usability
    PATCH_IF (cbr_cwa_fd_type && (cbr_cwa_usability BAND 0x800) = 0) BEGIN
      READ_LONG  0x6a cbr_cwa_fx_off
      READ_SHORT 0x6e cbr_cwa_eq_first
      READ_SHORT 0x70 cbr_cwa_eq_count
      PATCH_IF cbr_cwa_fx_off >= 0x72 AND cbr_cwa_fx_off <= BUFFER_LENGTH
        AND cbr_cwa_eq_first + cbr_cwa_eq_count <= (BUFFER_LENGTH - cbr_cwa_fx_off) / 0x30 BEGIN
      SET cbr_cwa_gated = 0
      SET cbr_cwa_druid_319 = 0
      SET cbr_cwa_fd_319 = 0
      FOR (cbr_cwa_e = cbr_cwa_eq_first; cbr_cwa_e < (cbr_cwa_eq_first + cbr_cwa_eq_count); ++cbr_cwa_e) BEGIN
        SET cbr_cwa_record = cbr_cwa_fx_off + (cbr_cwa_e * 0x30)
        READ_SHORT cbr_cwa_record cbr_cwa_opcode
        READ_BYTE  (cbr_cwa_record + 0x03) cbr_cwa_power
        READ_LONG  (cbr_cwa_record + 0x04) cbr_cwa_p1
        READ_LONG  (cbr_cwa_record + 0x08) cbr_cwa_p2
        PATCH_IF (cbr_cwa_opcode = 319) BEGIN
          PATCH_IF (cbr_cwa_power = 3) BEGIN
            SET cbr_cwa_gated = 1
          END
          PATCH_IF (cbr_cwa_power = 0 && cbr_cwa_p2 = 5 && cbr_cwa_p1 = druid_class) BEGIN
            SET cbr_cwa_druid_319 += 1
          END
          PATCH_IF (cbr_cwa_power = 0 && cbr_cwa_p2 = 5 && cbr_cwa_p1 = fighter_druid_class) BEGIN
            SET cbr_cwa_fd_319 += 1
          END
        END
      END
      PATCH_IF (!cbr_cwa_gated) BEGIN
        SET cbr_cwa_new_usability = cbr_cwa_usability BAND (BNOT 0x1000)
        PATCH_IF (cbr_cwa_druid_type) BEGIN
          SET cbr_cwa_new_usability = cbr_cwa_new_usability BAND (BNOT 0x40000000)
        END
        PATCH_IF (cbr_cwa_new_usability != cbr_cwa_usability) BEGIN
          WRITE_LONG 0x1e cbr_cwa_new_usability
          SET lifted += 1
        END
        PATCH_IF (cbr_cwa_druid_type && cbr_cwa_druid_319 > 0) BEGIN
          LPF DELETE_EFFECT
            INT_VAR
              check_headers    = 0
              match_opcode     = 319
              match_power      = 0
              match_parameter1 = druid_class
              match_parameter2 = 5
          END
          SET lifted += 1
        END
        PATCH_IF (cbr_cwa_fd_319 > 0) BEGIN
          LPF DELETE_EFFECT
            INT_VAR
              check_headers    = 0
              match_opcode     = 319
              match_power      = 0
              match_parameter1 = fighter_druid_class
              match_parameter2 = 5
          END
          SET lifted += 1
        END
      END
      END ELSE BEGIN PATCH_PRINT ~CBR weapon access: %SOURCE_FILE% has unreadable effect bounds; leaving this file alone.~ END
    END
  END
END

// ---------------------------------------------------------------------------
// Descriptions
// ---------------------------------------------------------------------------
//
// kind druid:         "May only use the following weapons: ... ." gains the
//                     axe and short bow words it lacks.
// kind fighter_druid: "only those allowed by the Druid's ethos" gains the
//                     long-bow phrase unless the text names long bows.
// kind kit_bullet:    bullet_line becomes the first item under
//                     "Advantages:", in the text's own bullet style.
// new_text equals text when the wording is not found or nothing is missing.
DEFINE_PATCH_FUNCTION cbr_cwa_rewrite_text
  STR_VAR kind = ~~ text = ~~ axe_word = ~~ short_bow_word = ~~ long_bow_phrase = ~~ bullet_line = ~~
  RET new_text
BEGIN
  SPRINT new_text ~~
  PATCH_IF ~%kind%~ STR_EQ ~druid~ BEGIN SPRINT new_text ~DRUID: The Druid serves the cause of nature and neutrality; the wilderness is <PRO_HISHER> community, and <PRO_HESHE> uses <PRO_HISHER> special powers to protect it and to preserve balance in the world.

CLASS FEATURES:

– May only wear non-metallic armor.
– May only equip bucklers and non-metallic shields.
– May only use the following weapons: scimitar, dagger, club, spear, quarterstaff, dart, sling, axe, short bow.
– May only become Proficient (one slot) in any weapon class.
– May only become Proficient (one slot) in any fighting style.
– May cast druidic spells.
– 7th level: May Shapeshift into a wolf, black bear, or brown bear once per day.
– 15th level: Becomes immune to poison.
– 18th level: Gains 10% resistance to cold, fire, electricity, and acid; gains a further 10% resistance at levels 21 and 24.
– Alignment restricted to true neutral.
– Hit Die: d8

Prime Requisites For Dual-Classing: Wisdom, Charisma~ END
  PATCH_IF ~%kind%~ STR_EQ ~fighter_druid~ BEGIN SPRINT new_text ~FIGHTER/DRUID: This character can use the abilities of a Fighter and a Druid, though weapons are restricted to only those allowed by the Druid's ethos, plus long bows. This character may Specialize in, but not Master, any weapon they can use.~ END
  PATCH_IF ~%kind%~ STR_EQ ~kit_bullet~ BEGIN SPRINT new_text ~ALAGHOR OF CLANGEDDIN: Also called the clerics of Clangeddin. Clangeddin Silverbeard is the dwarven god of battle, war, and bravery; his titles include the Father of Battle and the Lord of the Twin Axes. He delights in battle, although he does not tolerate treachery or deceit, and he expects his followers to do the same. He and his followers hate giants and have trained their fellow dwarves in special ways to fight them.

Advantages:

- May use axes, Clangeddin's chosen weapon, alongside the cleric weapons, and may specialize in them like a Fighter/Cleric.
- 8th level: May cast Spiritual Axe once per day.
- 14th level: 14: May cast Clangeddin's Strength once per day. It works as the wizard spell of the same name.
- 16th level: May cast Axe Storm of Clangeddin once per day. It works as Blade Barrier cleric spell.

SPIRITUAL AXE: By calling upon Clangeddin, the caster of a Spiritual Axe spell brings into existence a magical axe, which <PRO_HESHE> can use for the duration of the spell (2 turns). It strikes as a magical weapon with a bonus of +3 to the attack and to the damage rolls. When it scores a hit, it deals 1d8 points of damage (half slashing, half magic damage).

Disadvantages:

- Race restricted to dwarf.
- Alignement restricted to lawful neutral or lawful good.~ END
END


DEFINE_ACTION_FUNCTION cbr_cwa_describe
  STR_VAR table = ~~ match_column = ~~ row_name = ~~ text_column = ~~ kind = ~~ axe_word = ~~ short_bow_word = ~~ long_bow_phrase = ~~ bullet_line = ~~
  RET described
BEGIN
  OUTER_SET described = 0
  ACTION_IF FILE_EXISTS_IN_GAME ~%table%~ BEGIN
    ACTION_IF ~%EE_LANGUAGE%~ STRING_EQUAL_CASE ~en_us~ BEGIN
      COPY_EXISTING ~%table%~ ~override~
        SPRINT required ~CLASSID KITID LOWER DESCSTR MIXED~
        PATCH_IF NOT (~%match_column%~ STR_EQ ~~) BEGIN SPRINT required ~ROWNAME LOWER MIXED HELP ABILITIES PROFICIENCY UNUSABLE CLASS KITIDS~ END
        LPF cbr_cwa_named_column STR_VAR name = EVAL ~%text_column%~ required RET text_col = data_column END
        SET match_col = 0
        PATCH_IF NOT (~%match_column%~ STR_EQ ~~) BEGIN LPF cbr_cwa_named_column STR_VAR name = EVAL ~%match_column%~ RET match_col = data_column END END
        LPF cbr_cwa_rewrite_text STR_VAR kind RET new_text END
        SET new_ref = RESOLVE_STR_REF (~%new_text%~)
        COUNT_2DA_COLS cols READ_2DA_ENTRIES_NOW data cols SET found = 0
        FOR (r = 0; r < data; ++r) BEGIN
          READ_2DA_ENTRY_FORMER data r match_col name
          PATCH_IF ~%name%~ STRING_EQUAL_CASE ~%row_name%~ BEGIN
            SET_2DA_ENTRY r text_col cols new_ref SET described += 1 SET found = 1
          END
        END
        PATCH_IF NOT found BEGIN
          SPRINT row ~%WNL%%row_name%~
          FOR (c = 1; c < cols; ++c) BEGIN
            SPRINT value ~-1~ PATCH_IF c = match_col BEGIN SPRINT value ~%row_name%~ END
            PATCH_IF c = text_col BEGIN SPRINT value ~%new_ref%~ END SPRINT row ~%row% %value%~
          END
          SPRINT row ~%row%%WNL%~ SET at = BUFFER_LENGTH INSERT_BYTES at (STRING_LENGTH ~%row%~) WRITE_ASCIIE at ~%row%~
        END
      BUT_ONLY
    END ELSE BEGIN PRINT ~CBR weapon access: no complete %EE_LANGUAGE% translation for %row_name%; keeping its description.~ END
  END
END


DEFINE_ACTION_FUNCTION cbr_apply_druid_weapon_access
  INT_VAR
    druid_class         = 11
    fighter_druid_class = 16
  STR_VAR
    axe_word        = ~axe~
    short_bow_word  = ~short bow~
    long_bow_phrase = ~plus long bows~
BEGIN
  // WEAPPROF geometry and the two reference caps.
  COPY_EXISTING ~WEAPPROF.2DA~ ~override~
    LPF cbr_cwa_weapprof_column STR_VAR name = ~DRUID~ RET cbr_cwa_druid_col = data_column END
    LPF cbr_cwa_weapprof_column STR_VAR name = ~FIGHTER_DRUID~ RET cbr_cwa_fd_col = data_column END
    LPF cbr_cwa_column_weapon_cap INT_VAR data_column = cbr_cwa_druid_col RET cbr_cwa_druid_cap = cap END
    LPF cbr_cwa_column_weapon_cap INT_VAR data_column = cbr_cwa_fd_col RET cbr_cwa_fd_cap = cap END
    // Without a usable reference cap, write the existing base-game defaults.
    PATCH_IF cbr_cwa_druid_cap <= 0 BEGIN SET cbr_cwa_druid_cap = 1 END
    PATCH_IF cbr_cwa_fd_cap <= 0 BEGIN SET cbr_cwa_fd_cap = 2 END
    LPF cbr_cwa_weapprof_row INT_VAR proficiency = 92 RET cbr_cwa_axe_row = data_row END
    LPF cbr_cwa_weapprof_row INT_VAR proficiency = 105 RET cbr_cwa_sbow_row = data_row END
    LPF cbr_cwa_weapprof_row INT_VAR proficiency = 104 RET cbr_cwa_lbow_row = data_row END
  BUT_ONLY

  LAF cbr_cwa_read_kits
    RET cbr_cwa_kits
    RET_ARRAY cbr_cwa_kit_name cbr_cwa_kit_column cbr_cwa_kit_class
  END
  // Each kit gets its decided class weapons through its own column.
  LAF cbr_cwa_owned_kit_columns
    INT_VAR
      kit_class       = druid_class
      allowed_class_a = druid_class
      allowed_class_b = fighter_druid_class
      log_component   = 410
    RET cbr_cwa_druid_kits = cbr_cwa_owned
    RET_ARRAY cbr_cwa_druid_kit_col = cbr_cwa_owned_column
  END
  LAF cbr_cwa_owned_kit_columns
    INT_VAR
      kit_class       = fighter_druid_class
      allowed_class_a = fighter_druid_class
      allowed_class_b = fighter_druid_class
      log_component   = 410
    RET cbr_cwa_fd_kits = cbr_cwa_owned
    RET_ARRAY cbr_cwa_fd_kit_col = cbr_cwa_owned_column
  END

  OUTER_SET cbr_cwa_kitpack = FILE_EXISTS_IN_GAME ~C0PR#CL.SPL~
  ACTION_IF cbr_cwa_kitpack AND NOT FILE_EXISTS_IN_GAME ~SPLPROT.2DA~ BEGIN
    COPY ~cbr_cwa_empty_splprot~ ~override/SPLPROT.2DA~
  END

  // Write the class and kit caps.
  OUTER_SET cbr_cwa_changed = 0
  OUTER_FOR (cbr_cwa_pass = 0; cbr_cwa_pass < 1; ++cbr_cwa_pass) BEGIN
    COPY_EXISTING ~WEAPPROF.2DA~ ~override~
      FOR (cbr_cwa_c = 0; cbr_cwa_c <= cbr_cwa_druid_kits; ++cbr_cwa_c) BEGIN
        SET cbr_cwa_col = cbr_cwa_druid_col
        PATCH_IF (cbr_cwa_c > 0) BEGIN
          SET cbr_cwa_kit_index = cbr_cwa_c - 1
          SET cbr_cwa_col = $cbr_cwa_druid_kit_col(~%cbr_cwa_kit_index%~)
        END
        PATCH_FOR_EACH cbr_cwa_row IN cbr_cwa_axe_row cbr_cwa_sbow_row BEGIN
          SET cbr_cwa_row_index = EVAL ~%cbr_cwa_row%~
          LPF cbr_cwa_set_cell
            INT_VAR data_row = cbr_cwa_row_index data_column = cbr_cwa_col
                    minimum = cbr_cwa_druid_cap verify_only = cbr_cwa_pass
            RET cbr_cwa_cell = changed
          END
          SET cbr_cwa_changed += cbr_cwa_cell
        END
      END
      FOR (cbr_cwa_c = 0; cbr_cwa_c <= cbr_cwa_fd_kits; ++cbr_cwa_c) BEGIN
        SET cbr_cwa_col = cbr_cwa_fd_col
        PATCH_IF (cbr_cwa_c > 0) BEGIN
          SET cbr_cwa_kit_index = cbr_cwa_c - 1
          SET cbr_cwa_col = $cbr_cwa_fd_kit_col(~%cbr_cwa_kit_index%~)
        END
        PATCH_FOR_EACH cbr_cwa_row IN cbr_cwa_axe_row cbr_cwa_sbow_row cbr_cwa_lbow_row BEGIN
          SET cbr_cwa_row_index = EVAL ~%cbr_cwa_row%~
          LPF cbr_cwa_set_cell
            INT_VAR data_row = cbr_cwa_row_index data_column = cbr_cwa_col
                    minimum = cbr_cwa_fd_cap verify_only = cbr_cwa_pass
            RET cbr_cwa_cell = changed
          END
          SET cbr_cwa_changed += cbr_cwa_cell
        END
      END
    BUT_ONLY
  END

  // Artisan's permission grants.
  OUTER_SET cbr_cwa_grants = 0
  ACTION_IF (cbr_cwa_kitpack) BEGIN
    LAF cbr_cwa_grant_rows RET cbr_cwa_class_row = class_row cbr_cwa_class_rows = class_rows END
    OUTER_FOR (cbr_cwa_pass = 0; cbr_cwa_pass < 1; ++cbr_cwa_pass) BEGIN
      COPY_EXISTING ~C0PR#CL.SPL~ ~override~
        SET cbr_cwa_missing = 0
        PATCH_FOR_EACH cbr_cwa_prof IN 92 105 BEGIN
          LPF cbr_cwa_ensure_permission_grant
            INT_VAR
              condition_value = druid_class
              condition_row   = cbr_cwa_class_row
              verify_only     = cbr_cwa_pass
            STR_VAR
              condition_rows = EVAL ~%cbr_cwa_class_rows%~
              class_rows     = EVAL ~%cbr_cwa_class_rows%~
              permission     = EVAL ~C0PR#%cbr_cwa_prof%~
            RET cbr_cwa_added = inserted cbr_cwa_absent = missing
          END
          SET cbr_cwa_grants += cbr_cwa_added
          SET cbr_cwa_missing += cbr_cwa_absent
        END
        PATCH_FOR_EACH cbr_cwa_prof IN 92 105 104 BEGIN
          LPF cbr_cwa_ensure_permission_grant
            INT_VAR
              condition_value = fighter_druid_class
              condition_row   = cbr_cwa_class_row
              verify_only     = cbr_cwa_pass
            STR_VAR
              condition_rows = EVAL ~%cbr_cwa_class_rows%~
              class_rows     = EVAL ~%cbr_cwa_class_rows%~
              permission     = EVAL ~C0PR#%cbr_cwa_prof%~
            RET cbr_cwa_added = inserted cbr_cwa_absent = missing
          END
          SET cbr_cwa_grants += cbr_cwa_added
          SET cbr_cwa_missing += cbr_cwa_absent
        END
      BUT_ONLY
    END
  END

  // Weapons without the Kitpack gate.
  OUTER_SET cbr_cwa_items = 0
  COPY_EXISTING_REGEXP GLOB ~^.+\.itm$~ ~override~
    LPF cbr_cwa_lift_druid_item_restrictions
      INT_VAR druid_class = druid_class fighter_druid_class = fighter_druid_class
      RET cbr_cwa_item_lifted = lifted
    END
    PATCH_IF (cbr_cwa_item_lifted > 0) BEGIN
      SET cbr_cwa_items += 1
    END
  BUT_ONLY

  // EET keeps BG1 and SoD copies of the class texts next to CLASTEXT.
  OUTER_SET cbr_cwa_described = 0
  ACTION_FOR_EACH cbr_cwa_table IN BGCLATXT CLASTEXT SODCLTXT BEGIN
    LAF cbr_cwa_describe
      STR_VAR
        table          = EVAL ~%cbr_cwa_table%.2DA~
        row_name       = ~DRUID~
        text_column    = ~DESCSTR~
        kind           = ~druid~
        axe_word       = EVAL ~%axe_word%~
        short_bow_word = EVAL ~%short_bow_word%~
      RET cbr_cwa_done = described
    END
    OUTER_SET cbr_cwa_described += cbr_cwa_done
    LAF cbr_cwa_describe
      STR_VAR
        table           = EVAL ~%cbr_cwa_table%.2DA~
        row_name        = ~FIGHTER_DRUID~
        text_column     = ~DESCSTR~
        kind            = ~fighter_druid~
        long_bow_phrase = EVAL ~%long_bow_phrase%~
      RET cbr_cwa_done = described
    END
    OUTER_SET cbr_cwa_described += cbr_cwa_done
  END

  PRINT ~cbr 410: WEAPPROF cells raised: %cbr_cwa_changed% (druid cap %cbr_cwa_druid_cap%, fighter/druid cap %cbr_cwa_fd_cap%, %cbr_cwa_druid_kits% druid and %cbr_cwa_fd_kits% fighter/druid kit columns); C0PR#CL grants added: %cbr_cwa_grants%; items without the Kitpack gate opened: %cbr_cwa_items%; description cells updated: %cbr_cwa_described%.~
END

// ---------------------------------------------------------------------------
// Kit weapon lists for multiclass characters (EEex hook)
// ---------------------------------------------------------------------------
//
// CRuleTables::GetProficiencyClassIndex returns a kit's own WEAPPROF column
// only when the kit's KITLIST CLASS equals the character's class, and the
// class column otherwise. A multiclass character with a kit of one of its
// classes (Yeslick: fighter/cleric with a cleric kit) therefore trains from
// the multiclass column. M_CBRKP.lua lets the kit branch run for the
// class/kit pairs in CBRKPKIT.2DA. Every other check of KITLIST CLASS (kit
// abilities, the class name on the record screen, kit-to-class lookups)
// stays native.

// Read-only, file-based preflight, also callable from a --nogame test
// harness: the pattern of CBRKP.db must occur exactly once, inside an
// executable section. A pattern the EEex loader cannot resolve would stop
// EEex's Lua from starting, so an unsupported executable fails here instead.
DEFINE_ACTION_FUNCTION cbr_cwa_preflight_kit_column_hook
  STR_VAR executable_path = ~~
  RET hook_offset
BEGIN
  OUTER_SPRINT executable_path EVALUATE_BUFFER ~%executable_path%~
  ACTION_IF (NOT FILE_EXISTS ~%executable_path%~) BEGIN
    FAIL ~CBR kit weapon lists: game executable %executable_path% was not found.~
  END
  // The pattern's first 112 bytes, up to the LEA of sscanf's format string,
  // and (below) its last 17, from MOVZX EAX,BPL through the MOVSX after the
  // JNE. Between them only the format string's displacement and the sscanf
  // CALL displacement vary.
  OUTER_PATCH_SAVE cbr_kp_head ~................................................................................................................~ BEGIN
    WRITE_LONG 0 0x245c8948
    WRITE_LONG 4 0x57565508
    WRITE_LONG 8 0x20ec8348
    WRITE_LONG 12 0x48eab60f
    WRITE_LONG 16 0x0f41f98b
    WRITE_LONG 20 0x0f0ee0ba
    WRITE_LONG 24 0x0000d683
    WRITE_LONG 28 0xd88b4100
    WRITE_LONG 32 0xbfffe381
    WRITE_LONG 36 0x840fffff
    WRITE_LONG 40 0x000000c7
    WRITE_LONG 44 0x4089bf0f
    WRITE_LONG 48 0x83000026
    WRITE_LONG 52 0x267e07f9
    WRITE_LONG 56 0x4287bf0f
    WRITE_LONG 60 0x3b000026
    WRITE_LONG 64 0x851b7dd8
    WRITE_LONG 68 0x481778db
    WRITE_LONG 72 0x2630878b
    WRITE_LONG 76 0xaf0f0000
    WRITE_LONG 80 0xc08348cb
    WRITE_LONG 84 0xc9634838
    WRITE_LONG 88 0xc80c8d48
    WRITE_LONG 92 0x8d4807eb
    WRITE_LONG 96 0x0026388f
    WRITE_LONG 100 0x098b4800
    WRITE_LONG 104 0x24448d4c
    WRITE_LONG 108 0x158d4850
  END
  OUTER_SET hook_offset = (0 - 1)
  COPY - ~%executable_path%~ ~cbr_kit_column_exe_probe~
    PATCH_IF (SOURCE_SIZE < 0x40) BEGIN
      PATCH_FAIL ~CBR kit weapon lists: the executable is not a supported 64-bit PE image.~
    END
    READ_SHORT 0 cbr_kp_dos_magic
    READ_LONG 0x3c cbr_kp_pe
    PATCH_IF ((cbr_kp_dos_magic != 0x5a4d) OR (cbr_kp_pe < 0x40)
           OR (cbr_kp_pe > SOURCE_SIZE - 26)) BEGIN
      PATCH_FAIL ~CBR kit weapon lists: the executable is not a supported 64-bit PE image.~
    END
    READ_LONG cbr_kp_pe cbr_kp_pe_magic
    READ_SHORT (cbr_kp_pe + 4) cbr_kp_machine
    READ_SHORT (cbr_kp_pe + 6) cbr_kp_sections
    READ_SHORT (cbr_kp_pe + 20) cbr_kp_optional_size
    READ_SHORT (cbr_kp_pe + 24) cbr_kp_optional_magic
    PATCH_IF ((cbr_kp_pe_magic != 0x4550) OR (cbr_kp_machine != 0x8664)
           OR (cbr_kp_optional_magic != 0x20b) OR (cbr_kp_optional_size < 2)
           OR (cbr_kp_sections < 1)
           OR (cbr_kp_pe + 24 + cbr_kp_optional_size + cbr_kp_sections * 40 > SOURCE_SIZE)) BEGIN
      PATCH_FAIL ~CBR kit weapon lists: the executable is not a supported 64-bit PE image.~
    END
    SET cbr_kp_matches = 0
    SET cbr_kp_match = INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~%cbr_kp_head%~)
    WHILE (cbr_kp_match >= 0) BEGIN
      PATCH_IF (cbr_kp_match <= SOURCE_SIZE - 138) BEGIN
        READ_BYTE (cbr_kp_match + 116) cbr_kp_call
        READ_LONG (cbr_kp_match + 121) cbr_kp_tail1
        READ_LONG (cbr_kp_match + 125) cbr_kp_tail2
        READ_LONG (cbr_kp_match + 129) cbr_kp_tail3
        READ_LONG (cbr_kp_match + 133) cbr_kp_tail4
        READ_BYTE (cbr_kp_match + 137) cbr_kp_tail5
        PATCH_IF ((cbr_kp_call = 0xe8) AND (cbr_kp_tail1 = 0xc5b60f40)
               AND (cbr_kp_tail2 = 0x50244439) AND (cbr_kp_tail3 = 0xbf0f6a75)
               AND (cbr_kp_tail4 = 0x00264097) AND (cbr_kp_tail5 = 0)) BEGIN
          SET cbr_kp_matches += 1
          SET hook_offset = cbr_kp_match
        END
      END
      SET cbr_kp_match = INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~%cbr_kp_head%~ (cbr_kp_match + 1))
    END
    PATCH_IF (cbr_kp_matches != 1) BEGIN
      PATCH_FAIL ~CBR kit weapon lists: expected one compatible kit-proficiency lookup, found %cbr_kp_matches%. This executable is unsupported or ambiguous; nothing was installed.~
    END
    SET cbr_kp_executable_section = 0
    FOR (cbr_kp_section = 0; cbr_kp_section < cbr_kp_sections; ++cbr_kp_section) BEGIN
      SET cbr_kp_section_offset = cbr_kp_pe + 24 + cbr_kp_optional_size + cbr_kp_section * 40
      READ_LONG (cbr_kp_section_offset + 16) cbr_kp_raw_size
      READ_LONG (cbr_kp_section_offset + 20) cbr_kp_raw_start
      READ_LONG (cbr_kp_section_offset + 36) cbr_kp_section_flags
      PATCH_IF ((cbr_kp_raw_start >= 0) AND (cbr_kp_raw_size >= 138)
             AND (cbr_kp_raw_start <= SOURCE_SIZE - cbr_kp_raw_size)
             AND (hook_offset >= cbr_kp_raw_start)
             AND (hook_offset <= cbr_kp_raw_start + cbr_kp_raw_size - 138)
             AND ((cbr_kp_section_flags BAND 0x20000000) != 0)) BEGIN
        SET cbr_kp_executable_section = 1
      END
    END
    PATCH_IF (NOT cbr_kp_executable_section) BEGIN
      PATCH_FAIL ~CBR kit weapon lists: the compatible bytes are outside an executable section; nothing was installed.~
    END
  PRINT ~cbr kit weapon lists: compatible kit-proficiency lookup found in %executable_path% at file offset %hook_offset%.~
END

// Registers the class/kit pair in CBRKPKIT.2DA (once) and installs the
// runtime and its EEex pattern, which every registering component shares.
// The old preflight entry point remains a no-op; the apply call writes the
// canonical registry and publishes our runtime files.
DEFINE_ACTION_FUNCTION cbr_cwa_install_kit_column
  INT_VAR class_value = 0 kit_value = 0 verify_only = 0
BEGIN
  ACTION_IF NOT verify_only BEGIN
    OUTER_SET class_value = class_value BAND 0xff
    OUTER_SET kit_value = (kit_value BAND 0x3fff) BOR 0x4000
    ACTION_IF NOT FILE_EXISTS_IN_GAME ~CBRKPKIT.2DA~ BEGIN COPY ~chriz-bg-rebalance/kitprof/CBRKPKIT.2DA~ ~override/CBRKPKIT.2DA~ END
    COPY_EXISTING ~CBRKPKIT.2DA~ ~override~
      LPF cbr_cwa_named_column STR_VAR name = ~CLASS~ required = ~CLASS KIT~ RET cc = data_column END
      LPF cbr_cwa_named_column STR_VAR name = ~KIT~ RET kc = data_column END
      LPF cbr_cwa_table_read RET cbr_t_cols cbr_t_rows cbr_t_default RET_ARRAY cbr_t_head cbr_t_cell END
      SPRINT output ~2DA V1.0%WNL%****%WNL% CLASS KIT%WNL%~
      CLEAR_ARRAY seen
      FOR (r = 0; r < cbr_t_rows; ++r) BEGIN
        SPRINT cv $cbr_t_cell(~%r%~ ~%cc%~) SPRINT kv $cbr_t_cell(~%r%~ ~%kc%~) SPRINT label $cbr_t_cell(~%r%~ ~0~)
        PATCH_IF NOT IS_AN_INT ~%cv%~ BEGIN SET cv = IDS_OF_SYMBOL (~CLASS~ ~%cv%~) END
        PATCH_IF NOT IS_AN_INT ~%kv%~ BEGIN SET kv = IDS_OF_SYMBOL (~KIT~ ~%kv%~) END
        PATCH_IF cv > 0 AND cv < 256 AND kv > 0x4000 AND kv < 0x8000 BEGIN
          PATCH_IF NOT VARIABLE_IS_SET $seen(~%cv%~ ~%kv%~) BEGIN
            SPRINT output ~%output%%label% %cv% %kv%%WNL%~ SET $seen(~%cv%~ ~%kv%~) = 1
          END
        END
      END
      PATCH_IF NOT VARIABLE_IS_SET $seen(~%class_value%~ ~%kit_value%~) BEGIN SPRINT output ~%output%CBR_%class_value%_%kit_value% %class_value% %kit_value%%WNL%~ END
      DELETE_BYTES 0 BUFFER_LENGTH INSERT_BYTES 0 (STRING_LENGTH ~%output%~) WRITE_ASCIIE 0 ~%output%~
    BUT_ONLY
    COPY ~chriz-bg-rebalance/lua/M_CBRKP.lua~ ~override/M_CBRKP.lua~
    COPY ~chriz-bg-rebalance/kitprof/CBRKP.db~ ~EEex_scripts/extra_pattern_dbs/CBRKP.db~
  END
END


DEFINE_ACTION_FUNCTION cbr_apply_alaghor_weapon_access
  INT_VAR
    kit_value = 0       // KIT.IDS value of the kit
    kit_stat  = 152     // STATS.IDS KIT
  STR_VAR
    kit_name    = ~LK_ALAGHOR~
    bullet_line = ~~
BEGIN

  OUTER_SET kit_value = (kit_value BAND 0x3fff) BOR 0x4000
  LAF cbr_cwa_read_kits RET cbr_cwa_kits RET_ARRAY cbr_cwa_kit_name cbr_cwa_kit_column cbr_cwa_kit_class END
  OUTER_SET old_column = 0 OUTER_SET kit_found = 0
  OUTER_FOR (k = 0; k < cbr_cwa_kits; ++k) BEGIN
    OUTER_SPRINT name $cbr_cwa_kit_name(~%k%~)
    ACTION_IF ~%name%~ STRING_EQUAL_CASE ~%kit_name%~ BEGIN OUTER_SET old_column = $cbr_cwa_kit_column(~%k%~) OUTER_SET kit_found = 1 END
  END
  ACTION_IF NOT kit_found BEGIN
    COPY_EXISTING ~KITLIST.2DA~ ~override~
      LPF cbr_cwa_table_read RET cbr_t_cols cbr_t_rows cbr_t_default RET_ARRAY cbr_t_head cbr_t_cell END
      SET r = cbr_t_rows SET index = kit_value BAND 0x3fff
      SPRINT $cbr_t_cell(~%r%~ ~0~) ~%index%~
      FOR (c = 1; c < cbr_t_cols; ++c) BEGIN
        SPRINT $cbr_t_cell(~%r%~ ~%c%~) ~0~ SPRINT name $cbr_t_head(~%c%~)
        PATCH_IF ~%name%~ STRING_EQUAL_CASE ~ROWNAME~ BEGIN SPRINT $cbr_t_cell(~%r%~ ~%c%~) ~%kit_name%~ END
        PATCH_IF ~%name%~ STRING_EQUAL_CASE ~CLASS~ BEGIN SPRINT $cbr_t_cell(~%r%~ ~%c%~) ~3~ END
        PATCH_IF ~%name%~ STRING_EQUAL_CASE ~KITIDS~ BEGIN SPRINT $cbr_t_cell(~%r%~ ~%c%~) ~%kit_value%~ END
      END
      SET cbr_t_rows += 1 LPF cbr_cwa_table_write END
    BUT_ONLY
  END
  LAF cbr_cwa_private_kit_column INT_VAR old_column STR_VAR kit_name RET cbr_cwa_kit_col = column END
  COPY_EXISTING ~WEAPPROF.2DA~ ~override~
    LPF cbr_cwa_weapprof_column STR_VAR name = ~CLERIC~ RET cbr_cwa_cleric_col = data_column END
    LPF cbr_cwa_weapprof_column STR_VAR name = ~FIGHTER_CLERIC~ RET cbr_cwa_fc_col = data_column END
    PATCH_FOR_EACH proficiency IN 89 90 91 92 93 94 95 96 97 98 99 100 101 102 103 104 105 106 107 115 111 112 113 114 BEGIN
      LPF cbr_cwa_weapprof_row INT_VAR proficiency RET data_row END
    END
    LPF cbr_cwa_column_weapon_cap
      INT_VAR data_column = cbr_cwa_fc_col filter_column = cbr_cwa_cleric_col
      RET cbr_cwa_fc_cap = cap
    END
    PATCH_IF cbr_cwa_fc_cap <= 0 BEGIN SET cbr_cwa_fc_cap = 2 END
    LPF cbr_cwa_weapprof_row INT_VAR proficiency = 92 RET cbr_cwa_axe_row = data_row END
  BUT_ONLY
  // Every individual weapon row of the kit column: the cleric weapons at
  // their fighter/cleric cap (the cleric cap where FIGHTER_CLERIC has none),
  // the axe at its fighter/cleric cap or else the cleric-weapon cap,
  // every other weapon 0. Weapons the kit may then use that clerics cannot
  // become kit grants below. Every other row (fighting styles, the BG1
  // groups) takes the FIGHTER_CLERIC value: the limits Yeslick has without
  // the hook.
  OUTER_SET cbr_cwa_changed = 0
  OUTER_FOR (cbr_cwa_pass = 0; cbr_cwa_pass < 1; ++cbr_cwa_pass) BEGIN
    OUTER_SET cbr_cwa_extra = 0
    COPY_EXISTING ~WEAPPROF.2DA~ ~override~
      LPF cbr_cwa_lookup_column STR_VAR name = ~ID~ RET cbr_cwa_id_col = data_column END
      COUNT_2DA_COLS cbr_cwa_cols
      READ_2DA_ENTRIES_NOW cbr_cwa_data cbr_cwa_cols
      FOR (cbr_cwa_row = 0; cbr_cwa_row < cbr_cwa_data; ++cbr_cwa_row) BEGIN
        READ_2DA_ENTRY_FORMER cbr_cwa_data cbr_cwa_row cbr_cwa_id_col cbr_cwa_id
        SET cbr_cwa_weapon = 0
        PATCH_IF (IS_AN_INT ~%cbr_cwa_id%~) BEGIN
          LPF cbr_cwa_is_weapon_proficiency INT_VAR proficiency = cbr_cwa_id RET cbr_cwa_weapon = is_weapon END
        END
        PATCH_IF (cbr_cwa_weapon) BEGIN
          READ_2DA_ENTRY_FORMER cbr_cwa_data cbr_cwa_row cbr_cwa_cleric_col cbr_cwa_cleric_value
          READ_2DA_ENTRY_FORMER cbr_cwa_data cbr_cwa_row cbr_cwa_fc_col cbr_cwa_fc_value
          PATCH_IF NOT IS_AN_INT ~%cbr_cwa_cleric_value%~ BEGIN
            SET cbr_cwa_cleric_value = (cbr_cwa_id = 97 OR cbr_cwa_id = 115 OR cbr_cwa_id = 100
              OR cbr_cwa_id = 101 OR cbr_cwa_id = 102 OR cbr_cwa_id = 107)
          END
          PATCH_IF NOT IS_AN_INT ~%cbr_cwa_fc_value%~ BEGIN SET cbr_cwa_fc_value = cbr_cwa_fc_cap END
          SET cbr_cwa_target = 0
          PATCH_IF (cbr_cwa_cleric_value > 0) BEGIN
            SET cbr_cwa_target = cbr_cwa_cleric_value
            PATCH_IF (cbr_cwa_fc_value > 0) BEGIN
              SET cbr_cwa_target = cbr_cwa_fc_value
            END
          END ELSE PATCH_IF (cbr_cwa_id = 92) BEGIN
            SET cbr_cwa_target = cbr_cwa_fc_cap
            PATCH_IF (cbr_cwa_fc_value > 0) BEGIN
              SET cbr_cwa_target = cbr_cwa_fc_value
            END
          END
          LPF cbr_cwa_set_cell
            INT_VAR data_row = cbr_cwa_row data_column = cbr_cwa_kit_col
                    exact = cbr_cwa_target verify_only = cbr_cwa_pass
            RET cbr_cwa_cell = changed
          END
          SET cbr_cwa_changed += cbr_cwa_cell
          PATCH_IF (cbr_cwa_target > 0 && cbr_cwa_cleric_value <= 0) BEGIN
            SET $cbr_cwa_extra_prof(~%cbr_cwa_extra%~) = cbr_cwa_id
            SET cbr_cwa_extra += 1
          END
        END ELSE BEGIN
          READ_2DA_ENTRY_FORMER cbr_cwa_data cbr_cwa_row cbr_cwa_fc_col cbr_cwa_fc_value
          PATCH_IF !(IS_AN_INT ~%cbr_cwa_fc_value%~) BEGIN
            SET cbr_cwa_fc_value = 0
            PATCH_IF IS_AN_INT ~%cbr_cwa_id%~ BEGIN
              PATCH_IF cbr_cwa_id >= 111 AND cbr_cwa_id <= 113 BEGIN SET cbr_cwa_fc_value = 2 END
              PATCH_IF cbr_cwa_id = 114 BEGIN SET cbr_cwa_fc_value = 3 END
            END
          END
          LPF cbr_cwa_set_cell
            INT_VAR data_row = cbr_cwa_row data_column = cbr_cwa_kit_col
                    exact = cbr_cwa_fc_value verify_only = cbr_cwa_pass
            RET cbr_cwa_cell = changed
          END
          SET cbr_cwa_changed += cbr_cwa_cell
        END
      END
    BUT_ONLY
  END

  // Kit grants for those weapons, in C0PR#CL.
  OUTER_SPRINT cbr_cwa_extra_list ~~
  OUTER_FOR (cbr_cwa_x = 0; cbr_cwa_x < cbr_cwa_extra; ++cbr_cwa_x) BEGIN
    OUTER_SET cbr_cwa_prof = $cbr_cwa_extra_prof(~%cbr_cwa_x%~)
    OUTER_SPRINT cbr_cwa_extra_list ~%cbr_cwa_extra_list% %cbr_cwa_prof%~

  END
  LAF cbr_cwa_grant_rows
    INT_VAR kit_stat = kit_stat need_kit = 1
    RET cbr_cwa_class_rows = class_rows cbr_cwa_kit_row = kit_row cbr_cwa_kit_rows = kit_rows
  END
  OUTER_SET cbr_cwa_grants = 0
  OUTER_FOR (cbr_cwa_pass = 0; cbr_cwa_pass < 1; ++cbr_cwa_pass) BEGIN
    COPY_EXISTING ~C0PR#CL.SPL~ ~override~
      SET cbr_cwa_missing = 0
      FOR (cbr_cwa_x = 0; cbr_cwa_x < cbr_cwa_extra; ++cbr_cwa_x) BEGIN
        SET cbr_cwa_prof = $cbr_cwa_extra_prof(~%cbr_cwa_x%~)
        LPF cbr_cwa_ensure_permission_grant
          INT_VAR
            condition_value = kit_value
            condition_row   = cbr_cwa_kit_row
            keep_special    = 0
            verify_only     = cbr_cwa_pass
          STR_VAR
            condition_rows = EVAL ~%cbr_cwa_kit_rows%~
            class_rows     = EVAL ~%cbr_cwa_class_rows%~
            permission     = EVAL ~C0PR#%cbr_cwa_prof%~
          RET cbr_cwa_added = inserted cbr_cwa_absent = missing
        END
        SET cbr_cwa_grants += cbr_cwa_added
        SET cbr_cwa_missing += cbr_cwa_absent
      END
    BUT_ONLY
  END

  OUTER_SET cbr_cwa_described = 0
  LAF cbr_cwa_describe
    STR_VAR
      table        = ~KITLIST.2DA~
      match_column = ~ROWNAME~
      row_name     = EVAL ~%kit_name%~
      text_column  = ~HELP~
      kind         = ~kit_bullet~
      bullet_line  = EVAL ~%bullet_line%~
    RET cbr_cwa_done = described
  END
  OUTER_SET cbr_cwa_described += cbr_cwa_done
  ACTION_FOR_EACH cbr_cwa_table IN BGCLATXT CLASTEXT SODCLTXT BEGIN
    LAF cbr_cwa_describe
      STR_VAR
        table       = EVAL ~%cbr_cwa_table%.2DA~
        row_name    = EVAL ~%kit_name%~
        text_column = ~DESCSTR~
        kind        = ~kit_bullet~
        bullet_line = EVAL ~%bullet_line%~
      RET cbr_cwa_done = described
    END
    OUTER_SET cbr_cwa_described += cbr_cwa_done
  END

  PRINT ~cbr 411: %kit_name% WEAPPROF cells changed: %cbr_cwa_changed% (fighter/cleric cap %cbr_cwa_fc_cap%); kit grants for proficiencies%cbr_cwa_extra_list%: %cbr_cwa_grants% added to C0PR#CL; description cells updated: %cbr_cwa_described%.~
END
