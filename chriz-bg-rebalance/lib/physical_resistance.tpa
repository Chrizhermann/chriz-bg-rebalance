// No spell/item rewriting: own the marker symbol and ship the EEex listener.
// The 95% variant requires separate engine support and is not a public choice.
<<<<<<<< cbr_physical_empty_ids
IDS V1.0
>>>>>>>>

DEFINE_ACTION_FUNCTION cbr_apply_physical_resistance
  INT_VAR cap = 90
  STR_VAR
    resource_dir = ~override~
    template_file = ~chriz-bg-rebalance/lua/M_CBRRES.lua~
BEGIN
  OUTER_SPRINT resource_dir EVALUATE_BUFFER ~%resource_dir%~
  OUTER_SPRINT template_file EVALUATE_BUFFER ~%template_file%~
  // Only our callers supply cap; game data cannot reach this guard.
  ACTION_IF cap != 90 BEGIN
    FAIL ~CBR physical resistance: only the 90% engine integration is implemented. The 95% option requires separate engine support.~
  END
  OUTER_SPRINT cbr_res_path ~%resource_dir%/SPLSTATE.IDS~
  ACTION_IF NOT FILE_EXISTS ~%cbr_res_path%~ BEGIN
    COPY ~cbr_physical_empty_ids~ ~%cbr_res_path%~
  END
  COPY ~%cbr_res_path%~ ~%cbr_res_path%~
    FOR (i = 0; i < 256; ++i) BEGIN SET $cbr_res_used(~%i%~) = 0 END
    SET own_value = (0 - 1)
    READ_ASCII 0 contents (BUFFER_LENGTH)
    INNER_PATCH ~%contents%~ BEGIN
      REPLACE_EVALUATE
        ~^[ %TAB%]*\([^ %TAB%%WNL%%MNL%%LNL%]+\)[ %TAB%]+\([^ %TAB%%WNL%%MNL%%LNL%]+\)~
      BEGIN
        PATCH_IF IS_AN_INT ~%MATCH1%~ BEGIN
          SET value = MATCH1
          PATCH_IF value >= 0 AND value <= 255 BEGIN
            PATCH_IF ~%MATCH2%~ STRING_EQUAL_CASE ~CBR_PHYSICAL_SOFTCAP~ BEGIN
              PATCH_IF own_value < 0 BEGIN SET own_value = value END
            END ELSE BEGIN SET $cbr_res_used(~%value%~) = 1 END
          END
        END
      END ~~
    END
    // Reading allocated numbers chooses an address; it never vetoes our symbol.
    SET cbr_res_state = (0 - 1)
    PATCH_IF own_value >= 0 BEGIN
      PATCH_IF NOT $cbr_res_used(~%own_value%~) BEGIN SET cbr_res_state = own_value END
    END
    FOR (i = 255; i >= 0 AND cbr_res_state < 0; --i) BEGIN
      PATCH_IF NOT $cbr_res_used(~%i%~) BEGIN SET cbr_res_state = i END
    END
    // If every engine bit is named, our decided marker owns the preferred bit.
    PATCH_IF cbr_res_state < 0 BEGIN SET cbr_res_state = 255 END
    SET written = 0
    REPLACE_EVALUATE CASE_INSENSITIVE
      ~^[ %TAB%]*[^ %TAB%%WNL%%MNL%%LNL%]+[ %TAB%]+CBR_PHYSICAL_SOFTCAP\b[^%WNL%%MNL%%LNL%]*~
    BEGIN
      SPRINT row ~~
      PATCH_IF NOT written BEGIN
        SPRINT row ~%cbr_res_state% CBR_PHYSICAL_SOFTCAP~
        SET written = 1
      END
    END ~%row%~
    PATCH_IF NOT written BEGIN
      SPRINT row ~%cbr_res_state% CBR_PHYSICAL_SOFTCAP%LNL%~
      PATCH_IF BUFFER_LENGTH > 0 BEGIN
        READ_BYTE (BUFFER_LENGTH - 1) last
        PATCH_IF last != 10 AND last != 13 BEGIN SPRINT row ~%LNL%%row%~ END
      END
      SET at = BUFFER_LENGTH
      INSERT_BYTES at (STRING_LENGTH ~%row%~)
      WRITE_ASCIIE at ~%row%~
    END
  BUT_ONLY
  CLEAR_IDS_MAP

  COPY ~%template_file%~ ~%resource_dir%/M_CBRRES.lua~
    REPLACE_TEXTUALLY ~%CBR_RES_CAP%~ ~%cap%~
    REPLACE_TEXTUALLY ~%CBR_RES_STATE%~ ~%cbr_res_state%~
END
