// Component 302: patch the weapon's own behavior, never global Slow/Haste.
DEFINE_PATCH_FUNCTION cbr_foa_layout
  INT_VAR stride = 0x38 log_errors = 1
  RET ab na fx eq_first eq_count readable
BEGIN
  SET ab = 0 SET na = 0 SET fx = 0 SET eq_first = 0 SET eq_count = 0
  SET readable = BUFFER_LENGTH >= 0x72
  PATCH_IF readable BEGIN
    READ_LONG 0x64 ab READ_SHORT 0x68 na READ_LONG 0x6a fx
    READ_SHORT 0x6e eq_first READ_SHORT 0x70 eq_count
    SET readable = (na = 0 OR (ab >= 0x72 AND ab <= BUFFER_LENGTH
      AND na <= (BUFFER_LENGTH - ab) / stride)) AND fx >= 0x72 AND fx <= BUFFER_LENGTH
    PATCH_IF readable BEGIN
      SET available = (BUFFER_LENGTH - fx) / 0x30
      PATCH_IF eq_count > 0 AND eq_first + eq_count > available BEGIN SET readable = 0 END
      FOR (a = 0; a < na; ++a) BEGIN
        READ_SHORT (ab + a * stride + 0x1e) n
        READ_SHORT (ab + a * stride + 0x20) first
        PATCH_IF n > 0 AND first + n > available BEGIN SET readable = 0 END
      END
      // Tables may be in either order, but referenced records cannot overlap.
      PATCH_IF na > 0 AND fx >= ab AND fx < ab + na * stride BEGIN SET readable = 0 END
      PATCH_IF na > 0 AND fx < ab BEGIN
        PATCH_IF eq_count > 0 AND fx + (eq_first + eq_count) * 0x30 > ab BEGIN SET readable = 0 END
        FOR (a = 0; a < na; ++a) BEGIN
          READ_SHORT (ab + a * stride + 0x1e) n READ_SHORT (ab + a * stride + 0x20) first
          PATCH_IF n > 0 AND fx + (first + n) * 0x30 > ab BEGIN SET readable = 0 END
        END
      END
    END
  END
  PATCH_IF NOT readable AND log_errors BEGIN
    PATCH_PRINT ~Flail of Ages: %SOURCE_FILE% has unreadable resource bounds; leaving this file alone.~
  END
END

// Separate a shared slice before changing it. Other deliveries keep their own
// original records; trailing padding and unused data are preserved as well.
DEFINE_PATCH_FUNCTION cbr_foa_copy_slice
  INT_VAR fx = 0 first = 0 count = 0
  RET copied_first copy_ok
BEGIN
  LPF cbr_foa_effect_end RET copied_first = effect_end END
  READ_LONG 0x64 table READ_SHORT 0x68 abilities
  SET copy_ok = copied_first <= 0xffff AND count <= 0xffff
  PATCH_IF copy_ok BEGIN
  READ_ASCII (fx + first * 0x30) slice (count * 0x30)
  INSERT_BYTES (fx + copied_first * 0x30) (count * 0x30)
  WRITE_ASCIIE (fx + copied_first * 0x30) ~%slice%~ (count * 0x30)
  PATCH_IF abilities > 0 AND table >= fx + copied_first * 0x30 BEGIN
    WRITE_LONG 0x64 (table + count * 0x30)
  END
  END ELSE BEGIN SET copied_first = first END
END

// Haste/Slow secondary types and Slow penalties are sets written as ~|a|b|~.
// Membership is a literal match: plain | is not alternation in WeiDU regexps.
DEFINE_PATCH_FUNCTION cbr_foa_in_set
  STR_VAR set = ~|~ item = ~~
  RET found
BEGIN
  SET found = ((~%set%~ STRING_CONTAINS_REGEXP ~|%item%|~) = 0)
END

// Items present in both ~|a|b|~ sets, each once.
DEFINE_ACTION_FUNCTION cbr_foa_set_intersection
  STR_VAR left = ~|~ right = ~|~
  RET result
BEGIN
  OUTER_SPRINT result ~|~
  OUTER_PATCH ~%left%~ BEGIN
    REPLACE_EVALUATE ~|\([^|]+\)~ BEGIN
      LPF cbr_foa_in_set STR_VAR set = EVAL ~%right%~ item = EVAL ~%MATCH1%~ RET shared = found END
      LPF cbr_foa_in_set STR_VAR set = EVAL ~%result%~ item = EVAL ~%MATCH1%~ RET listed = found END
      PATCH_IF shared AND NOT listed BEGIN SPRINT result ~%result%%MATCH1%|~ END
    END ~|%MATCH1%~
  END
END

// The effective implementation of a spell: the spell plus the spells its
// abilities cast on the same target with opcode 146 (SCS moves Haste/Slow into
// such payloads), visiting each resource once. Casting features
// act on the caster and are not part of it. Returns, as ~|...|~ sets:
//   types     secondary types it carries (own header bytes, 0 = none)
//   removed   secondary types it removes from its target (opcode 221)
//   penalties AC/THAC0 penalties (opcode 0/54, negative, as opcode:mode)
//             applied with an opcode 40 of the same timing and duration
//   checks    opcode 318/324 conditions as RESREF:SPLPROT row:parameter 1
//   seen      resources visited
DEFINE_ACTION_FUNCTION cbr_foa_spell_profile
  INT_VAR depth = 0
  STR_VAR source = ~~ seen = ~|~
  RET types removed penalties checks seen
BEGIN
  OUTER_SPRINT types ~|~ OUTER_SPRINT removed ~|~ OUTER_SPRINT penalties ~|~ OUTER_SPRINT checks ~|~
  ACTION_TO_UPPER source
  ACTION_IF NOT (~%source%~ STRING_EQUAL ~~) AND FILE_EXISTS_IN_GAME ~%source%.SPL~
    AND (~%seen%~ STRING_CONTAINS_REGEXP ~|%source%|~) != 0 BEGIN
    OUTER_SPRINT seen ~%seen%%source%|~
    COPY_EXISTING ~%source%.SPL~ ~~
      LPF cbr_foa_layout INT_VAR stride = 0x28 RET ab na fx eq_first eq_count readable END
      PATCH_IF readable BEGIN
      READ_BYTE 0x27 own
      PATCH_IF own > 0 BEGIN SPRINT types ~%types%%own%|~ END
      FOR (a = 0; a < na; ++a) BEGIN
        READ_SHORT (ab + a * 0x28 + 0x1e) n READ_SHORT (ab + a * 0x28 + 0x20) first
        SPRINT slow_timings ~|~
        FOR (i = 0; i < n; ++i) BEGIN
          SET at = fx + (first + i) * 0x30
          PATCH_IF (SHORT_AT at) = 40 BEGIN
            READ_BYTE (at + 0xc) timing READ_LONG (at + 0xe) duration
            SPRINT slow_timings ~%slow_timings%%timing%:%duration%|~
          END
        END
        FOR (i = 0; i < n; ++i) BEGIN
          SET at = fx + (first + i) * 0x30
          READ_SHORT at op READ_BYTE (at + 2) target READ_LONG (at + 4) p1 READ_LONG (at + 8) p2
          READ_BYTE (at + 0xc) timing READ_LONG (at + 0xe) duration READ_ASCII (at + 0x14) res (8) NULL
          TO_UPPER res
          PATCH_IF target = 2 BEGIN
            PATCH_IF op = 221 AND p2 > 0 BEGIN SPRINT removed ~%removed%%p2%|~ END
            PATCH_IF (op = 0 OR op = 54) AND p1 < 0 BEGIN
              LPF cbr_foa_in_set STR_VAR set = EVAL ~%slow_timings%~ item = EVAL ~%timing%:%duration%~ RET with_slow = found END
              PATCH_IF with_slow BEGIN SPRINT penalties ~%penalties%%op%:%p2%|~ END
            END
            PATCH_IF (op = 318 OR op = 324) AND NOT (~%res%~ STRING_EQUAL ~~) BEGIN
              SPRINT checks ~%checks%%res%:%p2%:%p1%|~
            END
            PATCH_IF op = 146 AND NOT (~%res%~ STRING_EQUAL ~~) BEGIN
              INNER_ACTION BEGIN
                LAF cbr_foa_spell_profile INT_VAR depth = depth + 1 STR_VAR source = EVAL ~%res%~ seen = EVAL ~%seen%~
                  RET child_types = types child_removed = removed child_penalties = penalties
                    child_checks = checks seen END
              END
              SPRINT types ~%types%%child_types%~ SPRINT removed ~%removed%%child_removed%~
              SPRINT penalties ~%penalties%%child_penalties%~ SPRINT checks ~%checks%%child_checks%~
            END
          END
        END
      END
      END
    BUT_ONLY
    // Merged child sets meet at ~||~; keep one separator.
    OUTER_PATCH_SAVE types ~%types%~ BEGIN REPLACE_TEXTUALLY ~||+~ ~|~ END
    OUTER_PATCH_SAVE removed ~%removed%~ BEGIN REPLACE_TEXTUALLY ~||+~ ~|~ END
    OUTER_PATCH_SAVE penalties ~%penalties%~ BEGIN REPLACE_TEXTUALLY ~||+~ ~|~ END
    OUTER_PATCH_SAVE checks ~%checks%~ BEGIN REPLACE_TEXTUALLY ~||+~ ~|~ END
  END
END

// SPLPROT.2DA rows are read by meaning: STAT 0x112 (spell state) with
// RELATION 1 means "the target has spell state VALUE" (-1: Parameter 1).
DEFINE_ACTION_FUNCTION cbr_foa_splprot_splstate
  INT_VAR row = 0 param1 = 0
  RET splstate
BEGIN
  OUTER_SET splstate = (0 - 1)
  ACTION_IF row >= 0 AND FILE_EXISTS_IN_GAME ~SPLPROT.2DA~ BEGIN
    COPY_EXISTING ~SPLPROT.2DA~ ~~
      COUNT_2DA_ROWS 4 rows
      PATCH_IF row < rows BEGIN
        READ_2DA_ENTRY row 1 4 stat READ_2DA_ENTRY row 2 4 value READ_2DA_ENTRY row 3 4 relation
        PATCH_IF ((~%stat%~ STRING_EQUAL_CASE ~0x112~) OR (~%stat%~ STRING_EQUAL ~274~))
          AND (~%relation%~ STRING_EQUAL ~1~) BEGIN
          PATCH_IF ~%value%~ STRING_EQUAL ~-1~ BEGIN SET splstate = param1 END
          ELSE PATCH_IF IS_AN_INT value BEGIN SET splstate = value END
        END
      END
    BUT_ONLY
  END
END

// Spell states a Haste refuses itself under: its opcode 318/324 conditions
// (~|RESREF:SPLPROT row:parameter 1|~) on its own resources (owners), resolved
// through SPLPROT.2DA. Adds new states to the given set.
DEFINE_ACTION_FUNCTION cbr_foa_checked_splstates
  STR_VAR checks = ~|~ owners = ~|~ states = ~|~
  RET states
BEGIN
  OUTER_PATCH ~%checks%~ BEGIN
    REPLACE_EVALUATE ~|\([^|:]+\):\(-?[0-9]+\):\(-?[0-9]+\)~ BEGIN
      LPF cbr_foa_in_set STR_VAR set = EVAL ~%owners%~ item = EVAL ~%MATCH1%~ RET own = found END
      PATCH_IF own BEGIN
        INNER_ACTION BEGIN
          LAF cbr_foa_splprot_splstate INT_VAR row = MATCH2 param1 = MATCH3 RET state = splstate END
        END
        LPF cbr_foa_in_set STR_VAR set = EVAL ~%states%~ item = EVAL ~%state%~ RET listed = found END
        PATCH_IF state >= 0 AND NOT listed BEGIN SPRINT states ~%states%%state%|~ END
      END
    END ~|%MATCH1%~
  END
END

// A feedback branch only displays something on the struck creature: strings,
// lighting, glow, icons, sounds and visuals. Opcode 326 applies the payload to
// its own target; projectile 0 means None (IESDP), so 0 and 1 stay on the one
// creature. Anything else, linked resources included, is not feedback.
DEFINE_ACTION_FUNCTION cbr_foa_feedback_only
  STR_VAR source = ~~
  RET feedback
BEGIN
  OUTER_SET feedback = 0
  ACTION_IF FILE_EXISTS_IN_GAME ~%source%.SPL~ BEGIN
    COPY_EXISTING ~%source%.SPL~ ~~
      PATCH_IF BUFFER_LENGTH >= 0x72 BEGIN
        READ_ASCII 0 sig (8)
        PATCH_IF ~%sig%~ STRING_EQUAL ~SPL V1  ~ BEGIN
          LPF cbr_foa_layout INT_VAR stride = 0x28 RET ab na fx eq_first eq_count readable END
          PATCH_IF readable BEGIN
          SET feedback = 1
          FOR (a = (0 - 1); a < na; ++a) BEGIN
            SET n = eq_count SET first = eq_first
            PATCH_IF a >= 0 BEGIN
              READ_SHORT (ab + a * 0x28 + 0x1e) n READ_SHORT (ab + a * 0x28 + 0x20) first
              READ_SHORT (ab + a * 0x28 + 0x26) projectile
              PATCH_IF projectile > 1 BEGIN SET feedback = 0 END
            END
            FOR (i = 0; i < n; ++i) BEGIN
              READ_SHORT (fx + (first + i) * 0x30) op
              PATCH_IF NOT (op = 61 OR op = 139 OR op = 141 OR op = 142 OR op = 174
                OR op = 215 OR op = 240) BEGIN SET feedback = 0 END
            END
          END
        END
      END
          END
    BUT_ONLY
  END
END

// Classify a delegated payload without copying or changing its spell identity.
// bit 0 = Slow; bit 1 = its companions; bit 2 = another behavior/unsafe delivery.
// A save on a pure, single-recipient parent preserves resource immunities and
// self-refresh. Saving a mixed payload would also nerf its unrelated effects.
// Companions: Slowed feedback, removal of Haste or of an earlier Slow by the
// installed secondary types, the installed Slow's own AC/THAC0 penalties with
// this Slow's timing (slow_penalties = ~|opcode:mode|~, list_slow_timings =
// ~|timing:duration|~ of this list's opcode 40), and a feedback-only opcode 326
// whose condition also blocks the rest of this list (list_self_blocks).
DEFINE_PATCH_FUNCTION cbr_foa_classify_effect
  INT_VAR op = 0 target = 2 p1 = 0 p2 = 0 save = 0 bonus = 0 timing = 0 duration = 0
    save_penalty = 2 depth = 0 search_opcode = (0 - 1)
  STR_VAR resource = ~~ owner = ~~ chain = ~|~ haste_types = ~|~ slow_types = ~|~
    slow_penalties = ~|~ list_slow_timings = ~|~ list_self_blocks = ~|~
  RET kind
BEGIN
  SET kind = 4
  SET linked = (op = 146 OR op = 177 OR op = 326 OR (search_opcode >= 0 AND op = 148))
  SET removal = 0 SET penalty = 0
  PATCH_IF op = 221 AND p2 > 0 BEGIN
    LPF cbr_foa_in_set STR_VAR set = EVAL ~%haste_types%%slow_types%~ item = EVAL ~%p2%~ RET removal = found END
  END
  PATCH_IF (op = 0 OR op = 54) AND p1 < 0 BEGIN
    LPF cbr_foa_in_set STR_VAR set = EVAL ~%slow_penalties%~ item = EVAL ~%op%:%p2%~ RET penalty = found END
    LPF cbr_foa_in_set STR_VAR set = EVAL ~%list_slow_timings%~ item = EVAL ~%timing%:%duration%~ RET same_timing = found END
    SET penalty = (penalty AND same_timing)
  END
  PATCH_IF search_opcode >= 0 BEGIN SET kind = (op = search_opcode) END
  ELSE PATCH_IF op = 40 BEGIN SET kind = 1 END
  ELSE PATCH_IF (op = 139 AND p1 = 14000) OR (op = 142 AND p2 = 41) OR removal OR penalty BEGIN SET kind = 2 END
  ELSE PATCH_IF (op = 321 OR op = 206 OR op = 318 OR op = 324)
    AND NOT (~%owner%~ STRING_EQUAL ~~) AND (~%resource%~ STRING_EQUAL_CASE ~%owner%~) BEGIN SET kind = 0 END
  ELSE PATCH_IF op = 174 OR op = 215 BEGIN SET kind = 0 END // sound/visual only
  ELSE PATCH_IF op = 326 BEGIN
    // SCS's Slow cancels Haste instead of slowing: under one condition the
    // payload says so and an opcode 318/324 on this resource blocks the rest.
    LPF cbr_foa_in_set STR_VAR set = EVAL ~%list_self_blocks%~ item = EVAL ~%p1%:%p2%~ RET paired = found END
    PATCH_IF paired BEGIN
      INNER_ACTION BEGIN
        LAF cbr_foa_feedback_only STR_VAR source = EVAL ~%resource%~ RET feedback END
      END
      PATCH_IF feedback BEGIN SET kind = 2 SET linked = 0 END
    END
  END
  PATCH_IF linked BEGIN
    SPRINT extension ~SPL~
    PATCH_IF op = 177 BEGIN SPRINT extension ~EFF~ END
    INNER_ACTION BEGIN
      LAF cbr_foa_classify_resource INT_VAR save_penalty depth search_opcode
        STR_VAR source = EVAL ~%resource%~ extension = EVAL ~%extension%~ chain = EVAL ~%chain%~
          haste_types = EVAL ~%haste_types%~ slow_types = EVAL ~%slow_types%~
          slow_penalties = EVAL ~%slow_penalties%~
        RET kind END
    END
  END
  // An additional inner save cannot be replaced by saving only the parent.
  // Self/party/area effects cannot share one recipient's parent save either.
  PATCH_IF search_opcode < 0 AND (target != 2 OR (save BAND 0x3ff) != 0) BEGIN
    SET kind = kind BOR 4
  END
END

DEFINE_ACTION_FUNCTION cbr_foa_classify_resource
  INT_VAR save_penalty = 2 depth = 0 search_opcode = (0 - 1)
  STR_VAR source = ~~ extension = ~SPL~ chain = ~|~ haste_types = ~|~ slow_types = ~|~ slow_penalties = ~|~
  RET kind
BEGIN
  OUTER_SET kind = 4
  ACTION_IF FILE_EXISTS_IN_GAME ~%source%.%extension%~ BEGIN
    // End cycles. The result chooses where to write the save, never whether
    // the item's decided Slow is installed.
    ACTION_IF (~%chain%~ STRING_CONTAINS_REGEXP ~|%source%[.]%extension%|~) != 0 BEGIN
      COPY_EXISTING ~%source%.%extension%~ ~~
        SET kind = 0
        PATCH_IF ~%extension%~ STRING_EQUAL ~EFF~ BEGIN
          PATCH_IF BUFFER_LENGTH >= 0x110 BEGIN
          READ_LONG 0x10 op READ_LONG 0x14 target READ_LONG 0x1c p1 READ_LONG 0x20 p2
          READ_LONG 0x24 timing READ_LONG 0x28 duration
          READ_ASCII 0x30 resource (8) NULL READ_LONG 0x40 save READ_LONG 0x44 bonus
          LPF cbr_foa_classify_effect INT_VAR op target p1 p2 save bonus timing duration save_penalty search_opcode depth = depth + 1
            STR_VAR resource = EVAL ~%resource%~ owner = EVAL ~%source%~ chain = EVAL ~%chain%%source%.%extension%|~
              haste_types = EVAL ~%haste_types%~ slow_types = EVAL ~%slow_types%~ slow_penalties = EVAL ~%slow_penalties%~
            RET kind END
          END ELSE BEGIN
            PATCH_PRINT ~Flail of Ages: %SOURCE_FILE% is truncated; ending this effect branch.~
          END
        END ELSE BEGIN
          LPF cbr_foa_layout INT_VAR stride = 0x28 RET ab na fx eq_first eq_count readable END
          PATCH_IF readable BEGIN
          // Casting features belong to the caster rather than the struck actor.
          PATCH_IF eq_count > 0 AND search_opcode < 0 BEGIN SET kind = 4 END
          FOR (a = (0 - 1); a < na; ++a) BEGIN
            SET n = eq_count SET first = eq_first
            PATCH_IF a >= 0 BEGIN
              SET header = ab + a * 0x28
              READ_BYTE (header + 0xc) ability_target READ_SHORT (header + 0x26) projectile
              READ_SHORT (header + 0x1e) n READ_SHORT (header + 0x20) first
              // Instant no-projectile delivery is known single-recipient.
              // Other projectiles require a delivery-specific adapter (possibly AoE).
              PATCH_IF search_opcode < 0 AND (ability_target != 1 OR projectile > 1) BEGIN SET kind = kind BOR 4 END
            END
            // Effects of one list are applied together, so penalties and the
            // feedback branch are judged against this list's Slow and blocks.
            SPRINT list_slow_timings ~|~ SPRINT list_self_blocks ~|~
            FOR (i = 0; i < n; ++i) BEGIN
              SET at = fx + (first + i) * 0x30
              READ_SHORT at op READ_LONG (at + 4) p1 READ_LONG (at + 8) p2
              READ_BYTE (at + 0xc) timing READ_LONG (at + 0xe) duration READ_ASCII (at + 0x14) resource (8) NULL
              PATCH_IF op = 40 BEGIN SPRINT list_slow_timings ~%list_slow_timings%%timing%:%duration%|~ END
              PATCH_IF (op = 318 OR op = 324) AND (~%resource%~ STRING_EQUAL_CASE ~%source%~) BEGIN
                SPRINT list_self_blocks ~%list_self_blocks%%p1%:%p2%|~
              END
            END
            FOR (i = 0; i < n; ++i) BEGIN
              SET at = fx + (first + i) * 0x30
              READ_SHORT at op READ_BYTE (at + 2) target READ_LONG (at + 4) p1 READ_LONG (at + 8) p2
              READ_BYTE (at + 0xc) timing READ_LONG (at + 0xe) duration
              READ_ASCII (at + 0x14) resource (8) NULL READ_LONG (at + 0x24) save READ_LONG (at + 0x28) bonus
              LPF cbr_foa_classify_effect INT_VAR op target p1 p2 save bonus timing duration save_penalty search_opcode depth = depth + 1
                STR_VAR resource = EVAL ~%resource%~ owner = EVAL ~%source%~ chain = EVAL ~%chain%%source%.%extension%|~
                  haste_types = EVAL ~%haste_types%~ slow_types = EVAL ~%slow_types%~ slow_penalties = EVAL ~%slow_penalties%~
                  list_slow_timings = EVAL ~%list_slow_timings%~ list_self_blocks = EVAL ~%list_self_blocks%~
                RET child_kind = kind END
              SET kind = kind BOR child_kind
            END
          END
        END
          END
      BUT_ONLY
    END
  END
END

// bit 3 marks an installed Slow penalty; it shares a direct Slow's save only
// when it also has that Slow's timing and duration.
DEFINE_PATCH_FUNCTION cbr_foa_slow_slice
  INT_VAR start = 0 count = 0 save_penalty = 2 next_copy = 300000 any_target = 0
  STR_VAR haste_types = ~|~ slow_types = ~|~ slow_penalties = ~|~ copies = ~|~
  RET found next_copy copies
BEGIN
  SET found = 0
  FOR (i = 0; i < count; ++i) BEGIN
    SET at = start + i * 0x30
    READ_SHORT at op READ_BYTE (at + 2) target
    READ_LONG (at + 4) p1 READ_LONG (at + 8) p2
    SET kind = 0 SET removal = 0 SET penalty = 0
    PATCH_IF op = 221 AND p2 > 0 BEGIN
      LPF cbr_foa_in_set STR_VAR set = EVAL ~%haste_types%%slow_types%~ item = EVAL ~%p2%~ RET removal = found END
    END
    PATCH_IF (op = 0 OR op = 54) AND p1 < 0 BEGIN
      LPF cbr_foa_in_set STR_VAR set = EVAL ~%slow_penalties%~ item = EVAL ~%op%:%p2%~ RET penalty = found END
    END
    PATCH_IF target = 2 OR any_target BEGIN
      PATCH_IF op = 40 BEGIN SET kind = 1 END
      ELSE PATCH_IF (op = 139 AND p1 = 14000) OR (op = 142 AND p2 = 41) OR removal BEGIN SET kind = 2 END
      ELSE PATCH_IF penalty BEGIN SET kind = 8 END
      ELSE PATCH_IF op = 146 OR op = 177 OR op = 326 BEGIN
        READ_ASCII (at + 0x14) child (8) NULL
        SPRINT extension ~SPL~
        PATCH_IF op = 177 BEGIN SPRINT extension ~EFF~ END
        INNER_ACTION BEGIN
          LAF cbr_foa_classify_resource INT_VAR save_penalty
            STR_VAR source = EVAL ~%child%~ extension = EVAL ~%extension%~
              haste_types = EVAL ~%haste_types%~ slow_types = EVAL ~%slow_types%~ slow_penalties = EVAL ~%slow_penalties%~
            RET kind END
        END
        PATCH_IF (kind BAND 1) != 0 AND (kind BAND 4) != 0 BEGIN
          INNER_ACTION BEGIN
            LAF cbr_foa_private_slow INT_VAR save_penalty next_copy
              STR_VAR source = EVAL ~%child%~ extension = EVAL ~%extension%~ copies = EVAL ~%copies%~
                haste_types = EVAL ~%haste_types%~ slow_types = EVAL ~%slow_types%~ slow_penalties = EVAL ~%slow_penalties%~
              RET private next_copy copies END
          END
          WRITE_ASCIIE (at + 0x14) ~%private%~ #8
          READ_LONG (at + 0x24) outer_save
          WRITE_LONG (at + 0x24) (outer_save BAND 0xffffffe0)
          WRITE_LONG (at + 0x28) 0
          SET kind = 17
        END
      END
    END
    SET $foa_kind(~%i%~) = kind
    SET found += (kind BAND 1)
  END
  FOR (i = 0; i < count; ++i) BEGIN
    PATCH_IF ($foa_kind(~%i%~) BAND 1) != 0 BEGIN
      SET donor = start + i * 0x30
      READ_SHORT donor donor_op READ_BYTE (donor + 2) target
      READ_BYTE (donor + 0xc) donor_timing READ_LONG (donor + 0xe) donor_duration
      READ_BYTE (donor + 0x12) probability1 READ_BYTE (donor + 0x13) probability2
      FOR (j = 0; j < count; ++j) BEGIN
        SET at = start + j * 0x30
        READ_BYTE (at + 2) t READ_BYTE (at + 0x12) hi READ_BYTE (at + 0x13) lo
        READ_BYTE (at + 0xc) tm READ_LONG (at + 0xe) dur
        SET companion = (($foa_kind(~%j%~) BAND 3) != 0 AND ($foa_kind(~%j%~) BAND 4) = 0)
          OR ($foa_kind(~%j%~) = 8 AND donor_op = 40 AND tm = donor_timing AND dur = donor_duration)
        PATCH_IF t = target AND hi = probability1 AND lo = probability2 AND companion
          AND ($foa_kind(~%j%~) BAND 16) = 0 BEGIN
          READ_LONG (at + 0x24) save
          WRITE_LONG (at + 0x24) ((save BAND 0xffffffe0) BOR 2)
          WRITE_LONG (at + 0x28) (0 - save_penalty)
        END
      END
    END
  END
END

// Follow the effective Haste payload when removing resource immunities. Other
// effects in that spell do not veto the Haste allowance. Referenced records,
// including casting effects, count; padding and unused records do not.
// checks: opcode 318/324 conditions on each resource's own identity, resolved
// through SPLPROT.2DA to remove spell states that would still block that Haste.
DEFINE_ACTION_FUNCTION cbr_foa_native_haste
  INT_VAR depth = 0
  STR_VAR source = ~~ seen = ~|~ haste_types = ~|~ slow_types = ~|~
  RET is_haste has_haste foreign_op seen checks
BEGIN
  OUTER_SET has_haste = 0 OUTER_SET foreign_op = (0 - 1) OUTER_SPRINT checks ~|~
  ACTION_TO_UPPER source
  ACTION_IF (~%seen%~ STRING_CONTAINS_REGEXP ~|%source%|~) != 0 BEGIN
    OUTER_SPRINT seen ~%seen%%source%|~
    OUTER_SET foreign_op = 146
    ACTION_IF FILE_EXISTS_IN_GAME ~%source%.SPL~ BEGIN
      COPY_EXISTING ~%source%.SPL~ ~~
        PATCH_IF BUFFER_LENGTH >= 0x72 BEGIN
          READ_ASCII 0 signature (8)
          PATCH_IF ~%signature%~ STRING_EQUAL ~SPL V1  ~ BEGIN
            SET foreign_op = (0 - 1)
            LPF cbr_foa_layout INT_VAR stride = 0x28 RET ab na fx eq_first eq_count readable END
          PATCH_IF readable BEGIN
            FOR (a = (0 - 1); a < na; ++a) BEGIN
              SET n = eq_count SET first = eq_first
              PATCH_IF a >= 0 BEGIN
                READ_SHORT (ab + a * 0x28 + 0x1e) n READ_SHORT (ab + a * 0x28 + 0x20) first
              END
              SPRINT self_blocks ~|~
              FOR (i = 0; i < n; ++i) BEGIN
                SET at = fx + (first + i) * 0x30
                READ_SHORT at op READ_LONG (at + 4) p1 READ_LONG (at + 8) p2 READ_ASCII (at + 0x14) res (8) NULL
                PATCH_IF (op = 318 OR op = 324) AND (~%res%~ STRING_EQUAL_CASE ~%source%~) BEGIN
                  SPRINT self_blocks ~%self_blocks%%p1%:%p2%|~
                  SPRINT checks ~%checks%%source%:%p2%:%p1%|~
                END
              END
              FOR (i = 0; i < n; ++i) BEGIN
                SET at = fx + (first + i) * 0x30
                READ_SHORT at op READ_LONG (at + 4) p1 READ_LONG (at + 8) p2
                READ_ASCII (at + 0x14) res (8) NULL
                SET allowed = (op = 50 OR op = 61 OR op = 139 OR op = 141 OR op = 142
                  OR op = 174 OR op = 215 OR op = 93
                  OR ((op = 206 OR op = 318 OR op = 321 OR op = 324) AND (~%res%~ STRING_EQUAL_CASE ~%source%~)))
                PATCH_IF op = 221 AND p2 > 0 BEGIN
                  LPF cbr_foa_in_set STR_VAR set = EVAL ~%haste_types%%slow_types%~ item = EVAL ~%p2%~ RET allowed = found END
                END
                PATCH_IF op = 326 BEGIN
                  LPF cbr_foa_in_set STR_VAR set = EVAL ~%self_blocks%~ item = EVAL ~%p1%:%p2%~ RET paired = found END
                  PATCH_IF paired BEGIN
                    INNER_ACTION BEGIN
                      LAF cbr_foa_feedback_only STR_VAR source = EVAL ~%res%~ RET allowed = feedback END
                    END
                  END
                END
                PATCH_IF op = 16 BEGIN SET has_haste = 1 END
                ELSE PATCH_IF op = 146 AND NOT (~%res%~ STRING_EQUAL ~~) BEGIN
                  INNER_ACTION BEGIN
                    LAF cbr_foa_native_haste INT_VAR depth = depth + 1
                      STR_VAR source = EVAL ~%res%~ seen = EVAL ~%seen%~
                        haste_types = EVAL ~%haste_types%~ slow_types = EVAL ~%slow_types%~
                      RET child_haste = has_haste child_foreign = foreign_op seen child_checks = checks END
                  END
                  SPRINT checks ~%checks%%child_checks%~
                  SET has_haste = (has_haste OR child_haste)
                  PATCH_IF foreign_op < 0 BEGIN SET foreign_op = child_foreign END
                END
                ELSE PATCH_IF NOT allowed AND foreign_op < 0 BEGIN SET foreign_op = op END
              END
            END
          END
        END
          END
      BUT_ONLY
    END
  END
  OUTER_SET is_haste = has_haste
END

// haste_splstates: spell states the installed Haste and Improved Haste check
// (SPLPROT "has spell state") to refuse themselves. haste_immunity_state is
// SPLSTATE.IDS HASTE_IMMUNITY, the confirmation that such a state means only
// "cannot be hasted"; -1 when the symbol is absent.
DEFINE_PATCH_FUNCTION cbr_foa_patch
  INT_VAR save_penalty = 2 allow_haste = 0 haste_movement = 0 haste_immunity_state = (0 - 1)
  STR_VAR haste_resref = ~~ improved_haste_resref = ~~ haste_types = ~|~ slow_types = ~|~
    slow_penalties = ~|~ haste_splstates = ~|~
  RET slow_found
BEGIN
  SET slow_found = 0
  LPF cbr_foa_layout RET ab na fx eq_first eq_count readable END
  PATCH_IF readable BEGIN
  READ_ASCII 0 original_item (BUFFER_LENGTH)
  SET writable = 1
  LPF cbr_foa_ensure_melee END
  LPF cbr_foa_layout RET ab na fx eq_first eq_count END
  SET next_copy = 300000
  PATCH_IF ~%SOURCE_RES%~ STRING_EQUAL_CASE ~BLUN30C~ BEGIN SET next_copy = 400000 END
  PATCH_IF ~%SOURCE_RES%~ STRING_EQUAL_CASE ~BLUN30D~ BEGIN SET next_copy = 500000 END
  PATCH_IF allow_haste BEGIN SET next_copy = 600000 END
  SPRINT copies ~|~
  PATCH_IF allow_haste AND eq_count > 0 BEGIN
    SET shared = 0
    FOR (a = 0; a < na; ++a) BEGIN
      READ_SHORT (ab + a * 0x38 + 0x1e) n READ_SHORT (ab + a * 0x38 + 0x20) first
      PATCH_IF n > 0 AND first < eq_first + eq_count AND eq_first < first + n BEGIN SET shared = 1 END
    END
    PATCH_IF shared BEGIN
      LPF cbr_foa_copy_slice INT_VAR fx first = eq_first count = eq_count RET eq_first = copied_first copy_ok END
      SET writable = writable AND copy_ok
      WRITE_SHORT 0x6e eq_first
      READ_LONG 0x64 ab
    END
  END
  SET slow_found = 0
  FOR (a = 0; a < na; ++a) BEGIN
    SET header = ab + a * 0x38
    READ_BYTE header kind
    PATCH_IF kind = 1 BEGIN
      READ_SHORT (header + 0x1e) n READ_SHORT (header + 0x20) first
      SET shared = 0
      PATCH_IF n > 0 AND eq_count > 0 AND first < eq_first + eq_count AND eq_first < first + n BEGIN
        SET shared = 1
      END
      FOR (other = 0; other < na; ++other) BEGIN
        READ_BYTE (ab + other * 0x38) other_kind
        READ_SHORT (ab + other * 0x38 + 0x1e) other_n
        READ_SHORT (ab + other * 0x38 + 0x20) other_first
        PATCH_IF other_kind != 1 AND n > 0 AND other_n > 0
          AND first < other_first + other_n AND other_first < first + n BEGIN
          SET shared = 1
        END
      END
      PATCH_IF shared BEGIN
        LPF cbr_foa_copy_slice INT_VAR fx first count = n RET first = copied_first copy_ok END
        SET writable = writable AND copy_ok
        READ_LONG 0x64 ab
        SET header = ab + a * 0x38
        WRITE_SHORT (header + 0x20) first
      END
      LPF cbr_foa_slow_slice INT_VAR start = fx + first * 0x30 count = n save_penalty next_copy
        STR_VAR haste_types = EVAL ~%haste_types%~ slow_types = EVAL ~%slow_types%~
          slow_penalties = EVAL ~%slow_penalties%~ copies = EVAL ~%copies%~
        RET found next_copy copies END
      PATCH_IF found = 0 BEGIN
        LPF cbr_foa_supply_slow INT_VAR header save_penalty RET supplied END
        SET writable = writable AND supplied
        READ_LONG 0x64 ab
        SET found = 1
      END
      SET slow_found += found
    END
  END

  PATCH_IF allow_haste BEGIN
    // Before anything is removed: the spell states every Haste this item will
    // let through refuses itself under. That is the wizard Haste and Improved
    // Haste (haste_splstates) and each innate Haste whose op206 immunity is
    // lifted below (SPIN572: Potion of Haste, Haste rings). Keeping such a state
    // would leave that Haste blocked after its immunity is gone.
    SPRINT unblocked_states ~%haste_splstates%~
    FOR (i = 0; i < eq_count; ++i) BEGIN
      SET at = fx + (eq_first + i) * 0x30
      READ_SHORT at op READ_BYTE (at + 2) target READ_ASCII (at + 0x14) res (8) NULL
      PATCH_IF op = 206 AND target = 1 AND NOT (~%res%~ STRING_EQUAL ~~) AND FILE_EXISTS_IN_GAME ~%res%.spl~ BEGIN
        INNER_ACTION BEGIN
          LAF cbr_foa_native_haste
            STR_VAR source = EVAL ~%res%~ haste_types = EVAL ~%haste_types%~ slow_types = EVAL ~%slow_types%~
            RET innate_haste = is_haste innate_checks = checks innate_seen = seen END
          ACTION_IF innate_haste BEGIN
            LAF cbr_foa_checked_splstates
              STR_VAR checks = EVAL ~%innate_checks%~ owners = EVAL ~%innate_seen%~ states = EVAL ~%unblocked_states%~
              RET unblocked_states = states END
          END
        END
      END
    END
    FOR (i = eq_count - 1; i >= 0; --i) BEGIN
      SET idx = eq_first + i
      SET at = fx + idx * 0x30
      READ_SHORT at op READ_BYTE (at + 2) target
      READ_LONG (at + 4) p1 READ_LONG (at + 8) p2
      READ_ASCII (at + 0x14) res (8) NULL
      SET remove = 0
      PATCH_IF target = 1 BEGIN
        SET remove = (((op = 101) OR (op = 337)) AND (p2 = 16 OR (p2 = 176 AND haste_movement != 0)))
          OR (((op = 169) OR (op = 240)) AND (p2 = 38))
          OR ((op = 267) AND (p1 = 14023))
          OR ((op = 126) AND (p1 = 100) AND (p2 = 2))
        // Mode 1 sets a SPLSTATE.IDS state; mode 0 the IWD list 0..7 (IESDP).
        READ_LONG (at + 0x2c) special
        PATCH_IF op = 328 AND special = 1 BEGIN
          LPF cbr_foa_in_set STR_VAR set = EVAL ~%unblocked_states%~ item = EVAL ~%p2%~ RET checked = found END
          SET remove = checked OR p2 = haste_immunity_state
        END
        PATCH_IF op = 206 BEGIN
          PATCH_IF (((NOT (~%haste_resref%~ STRING_EQUAL ~~)) AND (~%res%~ STRING_EQUAL_CASE ~%haste_resref%~))
            OR ((NOT (~%improved_haste_resref%~ STRING_EQUAL ~~)) AND (~%res%~ STRING_EQUAL_CASE ~%improved_haste_resref%~))) BEGIN
            SET remove = 1
          END ELSE PATCH_IF FILE_EXISTS_IN_GAME ~%res%.spl~ BEGIN
            INNER_ACTION BEGIN
              LAF cbr_foa_native_haste
                STR_VAR source = EVAL ~%res%~ haste_types = EVAL ~%haste_types%~ slow_types = EVAL ~%slow_types%~
                RET is_haste has_haste foreign_op END
            END
            PATCH_IF is_haste BEGIN SET remove = 1 END

          END
        END
      END
      PATCH_IF remove BEGIN
        DELETE_BYTES at 0x30
        PATCH_IF ab > at BEGIN SET ab -= 0x30 WRITE_LONG 0x64 ab END
        --eq_count
        WRITE_SHORT 0x70 eq_count
        FOR (a = 0; a < na; ++a) BEGIN
          READ_SHORT (ab + a * 0x38 + 0x20) first
          PATCH_IF first > idx BEGIN WRITE_SHORT (ab + a * 0x38 + 0x20) (first - 1) END
        END
      END
    END
  END
  PATCH_IF NOT writable BEGIN
    DELETE_BYTES 0 BUFFER_LENGTH
    INSERT_BYTES 0 (STRING_LENGTH ~%original_item%~)
    WRITE_ASCIIE 0 ~%original_item%~
    SET slow_found = (0 - 1)
    PATCH_PRINT ~Flail of Ages: %SOURCE_FILE% has no representable effect index for this write; leaving this file alone.~
  END
  END
END

// Supply the decided 33% / 20-second Slow when its owned delivery is absent.
// An appended independent slice also handles shared effect lists without changing
// the other abilities. Existing proc windows and durations remain unowned.
DEFINE_PATCH_FUNCTION cbr_foa_supply_slow
  INT_VAR header = 0 save_penalty = 2
  RET supplied
BEGIN
  READ_LONG 0x6a fx READ_LONG 0x64 table READ_SHORT 0x68 abilities
  READ_SHORT (header + 0x1e) n READ_SHORT (header + 0x20) first
  LPF cbr_foa_effect_end RET new_first = effect_end END
  SET at = fx + new_first * 0x30
  SPRINT old ~~ SET kept = 0
  FOR (i = 0; i < n; ++i) BEGIN
    SET pos = fx + (first + i) * 0x30
    READ_SHORT pos op READ_LONG (pos + 4) p1 READ_LONG (pos + 8) p2
    // Replace orphaned Slow feedback with the feedback for our new delivery.
    PATCH_IF NOT ((op = 139 AND p1 = 14000) OR (op = 142 AND p2 = 41)) BEGIN
      READ_ASCII pos record (0x30)
      SPRINT old ~%old%%record%~
      SET kept += 1
    END
  END
  SET n = kept
  SET supplied = n + 2 <= 0xffff AND new_first <= 0xffff
  PATCH_IF supplied BEGIN
  INSERT_BYTES at ((n + 2) * 0x30)
  PATCH_IF n > 0 BEGIN WRITE_ASCIIE at ~%old%~ (n * 0x30) END
  PATCH_IF table >= at BEGIN
    WRITE_LONG 0x64 (table + (n + 2) * 0x30)
    SET header += (n + 2) * 0x30
  END
  WRITE_SHORT (header + 0x20) new_first
  WRITE_SHORT (header + 0x1e) (n + 2)
  SET at += n * 0x30
  WRITE_SHORT at 40 WRITE_BYTE (at + 2) 2
  WRITE_LONG (at + 0xe) 20 WRITE_BYTE (at + 0x12) 32
  WRITE_LONG (at + 0x24) 2 WRITE_LONG (at + 0x28) (0 - save_penalty)
  SET at += 0x30
  WRITE_SHORT at 139 WRITE_BYTE (at + 2) 2 WRITE_LONG (at + 4) 14000
  WRITE_BYTE (at + 0xc) 9 WRITE_BYTE (at + 0x12) 32
  WRITE_LONG (at + 0x24) 2 WRITE_LONG (at + 0x28) (0 - save_penalty)
  END
END

// Only mixed deliveries need a private resource: saving the parent would also
// save its damage or other riders. Cache by source within this traversal so a
// loop ends at the already assigned copy. Reapplication uses our reserved names.
DEFINE_ACTION_FUNCTION cbr_foa_private_slow
  INT_VAR save_penalty = 2 next_copy = 300000
  STR_VAR source = ~~ extension = ~SPL~ copies = ~|~
    haste_types = ~|~ slow_types = ~|~ slow_penalties = ~|~
  RET private next_copy copies
BEGIN
  ACTION_TO_UPPER source
  OUTER_SPRINT private ~~
  OUTER_PATCH ~%copies%~ BEGIN
    REPLACE_EVALUATE ~|\([^|:]+\):\([^|]+\)~ BEGIN
      PATCH_IF ~%MATCH1%~ STRING_EQUAL_CASE ~%source%.%extension%~ BEGIN SPRINT private ~%MATCH2%~ END
    END ~|%MATCH1%:%MATCH2%~
  END
  ACTION_IF ~%private%~ STRING_EQUAL ~~ BEGIN
    ACTION_IF (~%source%~ STRING_MATCHES_REGEXP ~^CF[3456][0-9][0-9][0-9][0-9][0-9]$~) = 0 BEGIN
      OUTER_SPRINT private ~%source%~
    END ELSE BEGIN
      OUTER_SET next_copy += 1
      OUTER_SPRINT private ~CF%next_copy%~
    END
    OUTER_SPRINT copies ~%copies%%source%.%extension%:%private%|~
    COPY_EXISTING ~%source%.%extension%~ ~override/%private%.%extension%~
      PATCH_IF ~%extension%~ STRING_EQUAL ~EFF~ BEGIN
        PATCH_IF BUFFER_LENGTH >= 0x110 BEGIN
          READ_LONG 0x10 op READ_ASCII 0x30 child (8) NULL
          PATCH_IF op = 146 OR op = 177 OR op = 326 OR op = 148 BEGIN
            SPRINT child_extension ~SPL~
            PATCH_IF op = 177 BEGIN SPRINT child_extension ~EFF~ END
            PATCH_IF FILE_EXISTS_IN_GAME ~%child%.%child_extension%~ BEGIN
              INNER_ACTION BEGIN
                LAF cbr_foa_private_slow INT_VAR save_penalty next_copy
                  STR_VAR source = EVAL ~%child%~ extension = EVAL ~%child_extension%~ copies = EVAL ~%copies%~
                    haste_types = EVAL ~%haste_types%~ slow_types = EVAL ~%slow_types%~ slow_penalties = EVAL ~%slow_penalties%~
                  RET child_private = private next_copy copies END
              END
              WRITE_ASCIIE 0x30 ~%child_private%~ #8
              READ_LONG 0x40 save WRITE_LONG 0x40 (save BAND 0xffffffe0) WRITE_LONG 0x44 0
            END
          END ELSE BEGIN
            READ_LONG 0x40 save
            WRITE_LONG 0x40 ((save BAND 0xffffffe0) BOR 2)
            WRITE_LONG 0x44 (0 - save_penalty)
          END
        END
      END ELSE BEGIN
        LPF cbr_foa_layout INT_VAR stride = 0x28 RET ab na fx eq_first eq_count readable END
        PATCH_IF readable BEGIN
          FOR (list = (0 - 1); list < na; ++list) BEGIN
            SET n = eq_count SET first = eq_first
            PATCH_IF list >= 0 BEGIN
              READ_SHORT (ab + list * 0x28 + 0x1e) n READ_SHORT (ab + list * 0x28 + 0x20) first
            END
            LPF cbr_foa_slow_slice INT_VAR start = fx + first * 0x30 count = n save_penalty next_copy any_target = 1
              STR_VAR haste_types = EVAL ~%haste_types%~ slow_types = EVAL ~%slow_types%~
                slow_penalties = EVAL ~%slow_penalties%~ copies = EVAL ~%copies%~
              RET next_copy copies END
            FOR (i = 0; i < n; ++i) BEGIN
              SET at = fx + (first + i) * 0x30
              READ_SHORT at op READ_ASCII (at + 0x14) res (8) NULL
              PATCH_IF (op = 206 OR op = 318 OR op = 321 OR op = 324)
                AND (~%res%~ STRING_EQUAL_CASE ~%source%~) BEGIN
                WRITE_ASCIIE (at + 0x14) ~%private%~ #8
              END
            END
          END
        END
      END
  END
END

// Complete English descriptions, taken from component 302's existing output on
// the reference items. Other game languages retain their text until translated.
DEFINE_PATCH_FUNCTION cbr_foa_description
  INT_VAR allow_haste = 0 slow_found = 1
  STR_VAR save_note = ~~ haste_note = ~~
BEGIN
  LPF cbr_foa_layout INT_VAR log_errors = 0 RET readable END
  PATCH_IF readable AND slow_found >= 0 BEGIN
    PATCH_IF ~%EE_LANGUAGE%~ STRING_EQUAL_CASE ~en_us~ BEGIN
      PATCH_IF ~%SOURCE_RES%~ STRING_EQUAL_CASE ~BLUN14~ BEGIN
        SAY 0x54 ~This flail has been in the care of Lord de'Arnise for some time, a relic of his adventuring youth. It has been kept disassembled, the individual pieces stored in separate locations, and only used in the direst of emergencies. Lord de'Arnise was likely concerned about the powerful magic that the weapon radiated when compiled, and rightfully so. A trail of destruction has followed it through history, leading straight back to the original owners. The flail was the creation of the warlike rakshasa, a race of vengeful spirits that crave human meat, and used as an adaptable weapon that could suit any battle. During a particularly violent hunt, the flail was lost, only to be returned when they used their affinity for magic to locate its powerful aura. They discovered that the weapon had found its way into the hands of a great human warrior, and the battle that followed was truly splendid. They have since used the item as bait countless times, "losing" it again and again. Powerful items gravitate toward powerful people, and powerful people yield the most glorious battles.

STATISTICS:

Combat abilities:
– 33% chance of slowing target for 20 seconds (Save vs. Breath at -2 negates)

THAC0: +3
Damage: 1d6+4, +1 acid damage, +1 cold damage, +1 fire damage
Damage type: Crushing
Speed Factor: 4
Proficiency Type: Flail/Morning Star
Type: One-handed
Requires:
 13 Strength

Weight: 10~
      END ELSE PATCH_IF ~%SOURCE_RES%~ STRING_EQUAL_CASE ~BLUN30C~ BEGIN
        SAY 0x54 ~This flail has been in the care of Lord de'Arnise for some time, a relic of his adventuring youth. It has been kept disassembled, the individual pieces stored in separate locations, and only used in the direst of emergencies. Lord Arnise was likely concerned about the powerful magic that the weapon radiated when compiled, and rightfully so. A trail of destruction has followed it through history, leading straight back to the original owners. The flail was the creation of the warlike Rakshasa, a race of vengeful spirits that crave human meat, and used as an adaptable weapon that could suit any battle. During a particularly violent hunt the flail was lost, only to be returned when they used their affinity for magic to locate its powerful aura. They discovered that the weapon had found its way into the hands of a great human warrior, and the battle that followed was truly splendid. They have since used the item as bait countless times, 'losing' it again and again. Powerful items gravitate towards powerful people, and powerful people yield the most glorious battles.

This four-headed flail causes fire, cold, acid and poison damage.  If the fifth head for the Flail of Ages could be found, it would make this awesome weapon even more powerful.

STATISTICS:

Combat Abilities:
   33% chance with each successful attack that the target is slowed (Save vs. Breath at -4 negates)

THAC0: +4
Damage:  1D6 + 5, +1 Fire Damage, +1 Cold Damage, +1 Acid Damage, +1 Poison Damage
Damage type:  crushing
Weight: 9
Speed Factor: 3
Proficiency Type: Flail/Morningstar
Type:  1-handed
Requires: 13 Strength
~
      END ELSE PATCH_IF ~%SOURCE_RES%~ STRING_EQUAL_CASE ~BLUN30D~ BEGIN
        SAY 0x54 ~This flail has been in the care of Lord de'Arnise for some time, a relic of his adventuring youth. It has been kept disassembled, the individual pieces stored in separate locations, and only used in the direst of emergencies. Lord Arnise was likely concerned about the powerful magic that the weapon radiated when compiled, and rightfully so. A trail of destruction has followed it through history, leading straight back to the original owners. The flail was the creation of the warlike Rakshasa, a race of vengeful spirits that crave human meat, and used as an adaptable weapon that could suit any battle. During a particularly violent hunt the flail was lost, only to be returned when they used their affinity for magic to locate its powerful aura. They discovered that the weapon had found its way into the hands of a great human warrior, and the battle that followed was truly splendid. They have since used the item as bait countless times, 'losing' it again and again. Powerful items gravitate towards powerful people, and powerful people yield the most glorious battles.

This four-headed flail causes fire, cold, acid and electrical damage.  If the fifth head for the Flail of Ages could be found, it would make this awesome weapon even more powerful.

STATISTICS:

Combat Abilities:
   33% chance with each successful attack that the target is slowed (Save vs. Breath at -4 negates)

THAC0: +4
Damage:  1D6 + 5, +1 Fire Damage, +1 Cold Damage, +1 Acid Damage, +1 Electrical Damage
Damage type:  crushing
Weight: 9
Speed Factor: 3
Proficiency Type: Flail/Morningstar
Type:  1-handed
Requires: 13 Strength
~
      END ELSE PATCH_IF ~%SOURCE_RES%~ STRING_EQUAL_CASE ~BLUN30~ BEGIN
        SAY 0x54 ~This flail has been in the care of Lord de'Arnise for some time, a relic of his adventuring youth. It has been kept disassembled, the individual pieces stored in separate locations, and only used in the direst of emergencies. Lord Arnise was likely concerned about the powerful magic that the weapon radiated when compiled, and rightfully so. A trail of destruction has followed it through history, leading straight back to the original owners. The flail was the creation of the warlike Rakshasa, a race of vengeful spirits that crave human meat, and used as an adaptable weapon that could suit any battle. During a particularly violent hunt the flail was lost, only to be returned when they used their affinity for magic to locate its powerful aura. They discovered that the weapon had found its way into the hands of a great human warrior, and the battle that followed was truly splendid. They have since used the item as bait countless times, 'losing' it again and again. Powerful items gravitate towards powerful people, and powerful people yield the most glorious battles.

With the addition of the fifth and final head to this weapon created by the evil Rakshasa race the true potential of the Flail of Ages is finally realized.

STATISTICS:

Equipped Abilities:
   Free Action (allows Haste and Improved Haste)
   5% bonus to Magic Resistance

Combat Abilities:
   33% chance each hit that target will be slowed (Save vs. Breath at -6 negates)

THAC0:  +5 bonus
Damage:  1D6 + 6, +2 Acid Damage, +2 Cold Damage, +2 Fire Damage, +2 Poison Damage,  +2 Electrical Damage
Damage type:  crushing
Weight: 8
Speed Factor: 2
Proficiency Type: Flail/Morningstar
Type:  1-handed
Requires: 13 Strength
~
      END
    END ELSE BEGIN
      PATCH_PRINT ~Flail of Ages: no complete translation for %EE_LANGUAGE%; keeping this description.~
    END
  END
END

// The weapon still gets its decided on-hit behavior if its melee header was
// removed. These headers are the reference items' existing melee statistics.
DEFINE_PATCH_FUNCTION cbr_foa_ensure_melee
BEGIN
  READ_LONG 0x64 ab READ_SHORT 0x68 na READ_LONG 0x6a fx
  SET melee = 0
  FOR (i = 0; i < na; ++i) BEGIN
    READ_BYTE (ab + i * 0x38) type
    PATCH_IF type = 1 BEGIN SET melee = 1 END
  END
  PATCH_IF NOT melee BEGIN
    PATCH_IF na = 0 BEGIN SET ab = 0x72 WRITE_LONG 0x64 ab END
    SET at = ab + na * 0x38
    INSERT_BYTES at 0x38
    PATCH_IF fx >= at BEGIN WRITE_LONG 0x6a (fx + 0x38) END
    WRITE_SHORT 0x68 (na + 1)
    PATCH_IF ~%SOURCE_RES%~ STRING_EQUAL_CASE ~BLUN14~ BEGIN
      WRITE_LONG (at + 0x0) 0x00010001
      WRITE_LONG (at + 0x4) 0x554c4249
      WRITE_LONG (at + 0x8) 0x0034314e
      WRITE_LONG (at + 0xc) 0x00010001
      WRITE_LONG (at + 0x10) 0x00040000
      WRITE_LONG (at + 0x14) 0x00060003
      WRITE_LONG (at + 0x18) 0x00041501
      WRITE_LONG (at + 0x1c) 0x00000002
      WRITE_LONG (at + 0x20) 0x00000000
      WRITE_LONG (at + 0x24) 0x00010001
      WRITE_LONG (at + 0x28) 0x00010000
      WRITE_LONG (at + 0x2c) 0x00320032
      WRITE_LONG (at + 0x30) 0x00000000
      WRITE_LONG (at + 0x34) 0x00000000
    END ELSE PATCH_IF ~%SOURCE_RES%~ STRING_EQUAL_CASE ~BLUN30C~ BEGIN
      WRITE_LONG (at + 0x0) 0x00010001
      WRITE_LONG (at + 0x4) 0x554c4249
      WRITE_LONG (at + 0x8) 0x4330334e
      WRITE_LONG (at + 0xc) 0x00010001
      WRITE_LONG (at + 0x10) 0x00030000
      WRITE_LONG (at + 0x14) 0x00060004
      WRITE_LONG (at + 0x18) 0x00051501
      WRITE_LONG (at + 0x1c) 0x00000002
      WRITE_LONG (at + 0x20) 0x00000000
      WRITE_LONG (at + 0x24) 0x00010001
      WRITE_LONG (at + 0x28) 0x00010000
      WRITE_LONG (at + 0x2c) 0x00320032
      WRITE_LONG (at + 0x30) 0x00000000
      WRITE_LONG (at + 0x34) 0x00000000
    END ELSE PATCH_IF ~%SOURCE_RES%~ STRING_EQUAL_CASE ~BLUN30D~ BEGIN
      WRITE_LONG (at + 0x0) 0x00010001
      WRITE_LONG (at + 0x4) 0x756c6269
      WRITE_LONG (at + 0x8) 0x6430336e
      WRITE_LONG (at + 0xc) 0x00010001
      WRITE_LONG (at + 0x10) 0x00030000
      WRITE_LONG (at + 0x14) 0x00060004
      WRITE_LONG (at + 0x18) 0x00051501
      WRITE_LONG (at + 0x1c) 0x00000002
      WRITE_LONG (at + 0x20) 0x00000000
      WRITE_LONG (at + 0x24) 0x00010001
      WRITE_LONG (at + 0x28) 0x00010000
      WRITE_LONG (at + 0x2c) 0x00320032
      WRITE_LONG (at + 0x30) 0x00000000
      WRITE_LONG (at + 0x34) 0x00000000
    END ELSE PATCH_IF ~%SOURCE_RES%~ STRING_EQUAL_CASE ~BLUN30~ BEGIN
      WRITE_LONG (at + 0x0) 0x00010001
      WRITE_LONG (at + 0x4) 0x554c4249
      WRITE_LONG (at + 0x8) 0x0030334e
      WRITE_LONG (at + 0xc) 0x00010001
      WRITE_LONG (at + 0x10) 0x00020000
      WRITE_LONG (at + 0x14) 0x00060005
      WRITE_LONG (at + 0x18) 0x00061501
      WRITE_LONG (at + 0x1c) 0x00000002
      WRITE_LONG (at + 0x20) 0x00000000
