      WRITE_LONG (at + 0x28) 0x00010000
      WRITE_LONG (at + 0x2c) 0x00320032
      WRITE_LONG (at + 0x30) 0x00000000
      WRITE_LONG (at + 0x34) 0x00000000
    END
  END
END

DEFINE_PATCH_FUNCTION cbr_foa_effect_end
  RET effect_end
BEGIN
  READ_LONG 0x64 table READ_SHORT 0x68 abilities
  READ_SHORT 0x6e first READ_SHORT 0x70 count
  SET effect_end = 0
  PATCH_IF count > 0 BEGIN SET effect_end = first + count END
  FOR (i = 0; i < abilities; ++i) BEGIN
    READ_SHORT (table + i * 0x38 + 0x1e) count
    READ_SHORT (table + i * 0x38 + 0x20) first
    PATCH_IF count > 0 AND first + count > effect_end BEGIN SET effect_end = first + count END
  END
END
