// Component 302: patch the weapon's own behavior, never global Slow/Haste.
DEFINE_PATCH_FUNCTION cbr_foa_layout
  INT_VAR stride = 0x38
  RET ab na fx eq_first eq_count
BEGIN
  PATCH_IF BUFFER_LENGTH < 0x72 BEGIN PATCH_FAIL ~Flail of Ages: truncated resource header.~ END
  READ_LONG 0x64 ab READ_SHORT 0x68 na READ_LONG 0x6a fx
  READ_SHORT 0x6e eq_first READ_SHORT 0x70 eq_count
  PATCH_IF (na > 0 AND (ab < 0x72 OR ab > BUFFER_LENGTH OR na > (BUFFER_LENGTH - ab) / stride
    OR fx < ab + na * stride)) OR fx < 0x72 OR fx > BUFFER_LENGTH BEGIN
    PATCH_FAIL ~Flail of Ages: ability/effect table is outside the resource.~
  END
  // Padding and unused records are legitimate. Validate referenced slices only.
  SET available = (BUFFER_LENGTH - fx) / 0x30
  PATCH_IF eq_count > 0 AND eq_first + eq_count > available BEGIN
    PATCH_FAIL ~Flail of Ages: global effect slice is outside the resource.~
  END
  FOR (a = 0; a < na; ++a) BEGIN
    READ_SHORT (ab + a * stride + 0x1e) n
    READ_SHORT (ab + a * stride + 0x20) first
    PATCH_IF n > 0 AND first + n > available BEGIN
      PATCH_FAIL ~Flail of Ages: ability effect slice is outside the resource.~
    END
  END
END

// Separate a shared slice before changing it. Other deliveries keep their own
// original records; trailing padding and unused data are preserved as well.
DEFINE_PATCH_FUNCTION cbr_foa_copy_slice
  INT_VAR fx = 0 first = 0 count = 0
  RET copied_first
BEGIN
  SET copied_first = (BUFFER_LENGTH - fx) / 0x30
  PATCH_IF copied_first + count > 0x10000 BEGIN
    PATCH_FAIL ~Flail of Ages: separating shared effects would exceed the format's effect-index limit.~
  END
  READ_ASCII (fx + first * 0x30) slice (count * 0x30)
  INSERT_BYTES (fx + copied_first * 0x30) (count * 0x30)
  WRITE_ASCIIE (fx + copied_first * 0x30) ~%slice%~ (count * 0x30)
END

// Haste/Slow secondary types and Slow penalties are sets written as ~|a|b|~.
// Membership is a literal match: plain | is not alternation in WeiDU regexps.
DEFINE_PATCH_FUNCTION cbr_foa_in_set
  STR_VAR set = ~|~ item = ~~
  RET found
BEGIN
  SET found = ((~%set%~ STRING_CONTAINS_REGEXP ~|%item%|~) = 0)
END

// Items present in both ~|a|b|~ sets, each once.
DEFINE_ACTION_FUNCTION cbr_foa_set_intersection
  STR_VAR left = ~|~ right = ~|~
  RET result
BEGIN
  OUTER_SPRINT result ~|~
  OUTER_PATCH ~%left%~ BEGIN
    REPLACE_EVALUATE ~|\([^|]+\)~ BEGIN
      LPF cbr_foa_in_set STR_VAR set = EVAL ~%right%~ item = EVAL ~%MATCH1%~ RET shared = found END
      LPF cbr_foa_in_set STR_VAR set = EVAL ~%result%~ item = EVAL ~%MATCH1%~ RET listed = found END
      PATCH_IF shared AND NOT listed BEGIN SPRINT result ~%result%%MATCH1%|~ END
    END ~|%MATCH1%~
  END
END

// The effective implementation of a spell: the spell plus the spells its
// abilities cast on the same target with opcode 146 (SCS moves Haste/Slow into
// such payloads), bounded and visiting each resource once. Casting features
// act on the caster and are not part of it. Returns, as ~|...|~ sets:
//   types     secondary types it carries (own header bytes, 0 = none)
//   removed   secondary types it removes from its target (opcode 221)
//   penalties AC/THAC0 penalties (opcode 0/54, negative, as opcode:mode)
//             applied with an opcode 40 of the same timing and duration
//   checks    opcode 318/324 conditions as RESREF:SPLPROT row:parameter 1
//   seen      resources visited
DEFINE_ACTION_FUNCTION cbr_foa_spell_profile
  INT_VAR depth = 0
  STR_VAR source = ~~ seen = ~|~
  RET types removed penalties checks seen
BEGIN
  OUTER_SPRINT types ~|~ OUTER_SPRINT removed ~|~ OUTER_SPRINT penalties ~|~ OUTER_SPRINT checks ~|~
  ACTION_TO_UPPER source
  ACTION_IF depth < 32 AND NOT (~%source%~ STRING_EQUAL ~~) AND FILE_EXISTS_IN_GAME ~%source%.SPL~
    AND (~%seen%~ STRING_CONTAINS_REGEXP ~|%source%|~) != 0 BEGIN
    OUTER_SPRINT seen ~%seen%%source%|~
    COPY_EXISTING ~%source%.SPL~ ~~
      PATCH_IF BUFFER_LENGTH < 8 BEGIN PATCH_FAIL ~Flail of Ages: %SOURCE_FILE% is truncated.~ END
      READ_ASCII 0 sig (8)
      PATCH_IF NOT (~%sig%~ STRING_EQUAL ~SPL V1  ~) BEGIN PATCH_FAIL ~Flail of Ages: %SOURCE_FILE% is not SPL V1.~ END
      LPF cbr_foa_layout INT_VAR stride = 0x28 RET ab na fx eq_first eq_count END
      READ_BYTE 0x27 own
      PATCH_IF own > 0 BEGIN SPRINT types ~%types%%own%|~ END
      FOR (a = 0; a < na; ++a) BEGIN
        READ_SHORT (ab + a * 0x28 + 0x1e) n READ_SHORT (ab + a * 0x28 + 0x20) first
        SPRINT slow_timings ~|~
        FOR (i = 0; i < n; ++i) BEGIN
          SET at = fx + (first + i) * 0x30
          PATCH_IF (SHORT_AT at) = 40 BEGIN
            READ_BYTE (at + 0xc) timing READ_LONG (at + 0xe) duration
            SPRINT slow_timings ~%slow_timings%%timing%:%duration%|~
          END
        END
        FOR (i = 0; i < n; ++i) BEGIN
          SET at = fx + (first + i) * 0x30
          READ_SHORT at op READ_BYTE (at + 2) target READ_LONG (at + 4) p1 READ_LONG (at + 8) p2
          READ_BYTE (at + 0xc) timing READ_LONG (at + 0xe) duration READ_ASCII (at + 0x14) res (8) NULL
          TO_UPPER res
          PATCH_IF target = 2 BEGIN
            PATCH_IF op = 221 AND p2 > 0 BEGIN SPRINT removed ~%removed%%p2%|~ END
            PATCH_IF (op = 0 OR op = 54) AND p1 < 0 BEGIN
              LPF cbr_foa_in_set STR_VAR set = EVAL ~%slow_timings%~ item = EVAL ~%timing%:%duration%~ RET with_slow = found END
              PATCH_IF with_slow BEGIN SPRINT penalties ~%penalties%%op%:%p2%|~ END
            END
            PATCH_IF (op = 318 OR op = 324) AND NOT (~%res%~ STRING_EQUAL ~~) BEGIN
              SPRINT checks ~%checks%%res%:%p2%:%p1%|~
            END
            PATCH_IF op = 146 AND NOT (~%res%~ STRING_EQUAL ~~) BEGIN
              INNER_ACTION BEGIN
                LAF cbr_foa_spell_profile INT_VAR depth = depth + 1 STR_VAR source = EVAL ~%res%~ seen = EVAL ~%seen%~
                  RET child_types = types child_removed = removed child_penalties = penalties
                    child_checks = checks seen END
              END
              SPRINT types ~%types%%child_types%~ SPRINT removed ~%removed%%child_removed%~
              SPRINT penalties ~%penalties%%child_penalties%~ SPRINT checks ~%checks%%child_checks%~
            END
          END
        END
      END
    BUT_ONLY
    // Merged child sets meet at ~||~; keep one separator.
    OUTER_PATCH_SAVE types ~%types%~ BEGIN REPLACE_TEXTUALLY ~||+~ ~|~ END
    OUTER_PATCH_SAVE removed ~%removed%~ BEGIN REPLACE_TEXTUALLY ~||+~ ~|~ END
    OUTER_PATCH_SAVE penalties ~%penalties%~ BEGIN REPLACE_TEXTUALLY ~||+~ ~|~ END
    OUTER_PATCH_SAVE checks ~%checks%~ BEGIN REPLACE_TEXTUALLY ~||+~ ~|~ END
  END
END

// SPLPROT.2DA rows are read by meaning: STAT 0x112 (spell state) with
// RELATION 1 means "the target has spell state VALUE" (-1: Parameter 1).
DEFINE_ACTION_FUNCTION cbr_foa_splprot_splstate
  INT_VAR row = 0 param1 = 0
  RET splstate
BEGIN
  OUTER_SET splstate = (0 - 1)
  ACTION_IF row >= 0 AND FILE_EXISTS_IN_GAME ~SPLPROT.2DA~ BEGIN
    COPY_EXISTING ~SPLPROT.2DA~ ~~
      COUNT_2DA_ROWS 4 rows
      PATCH_IF row < rows BEGIN
        READ_2DA_ENTRY row 1 4 stat READ_2DA_ENTRY row 2 4 value READ_2DA_ENTRY row 3 4 relation
        PATCH_IF ((~%stat%~ STRING_EQUAL_CASE ~0x112~) OR (~%stat%~ STRING_EQUAL ~274~))
          AND (~%relation%~ STRING_EQUAL ~1~) BEGIN
          PATCH_IF ~%value%~ STRING_EQUAL ~-1~ BEGIN SET splstate = param1 END
          ELSE PATCH_IF IS_AN_INT value BEGIN SET splstate = value END
        END
      END
    BUT_ONLY
  END
END

// A feedback branch only displays something on the struck creature: strings,
// lighting, glow, icons, sounds and visuals. Opcode 326 applies the payload to
// its own target; projectile 0 means None (IESDP), so 0 and 1 stay on the one
// creature. Anything else, linked resources included, is not feedback.
DEFINE_ACTION_FUNCTION cbr_foa_feedback_only
  STR_VAR source = ~~
  RET feedback
BEGIN
  OUTER_SET feedback = 0
  ACTION_IF FILE_EXISTS_IN_GAME ~%source%.SPL~ BEGIN
    COPY_EXISTING ~%source%.SPL~ ~~
      PATCH_IF BUFFER_LENGTH >= 0x72 BEGIN
        READ_ASCII 0 sig (8)
        PATCH_IF ~%sig%~ STRING_EQUAL ~SPL V1  ~ BEGIN
          LPF cbr_foa_layout INT_VAR stride = 0x28 RET ab na fx eq_first eq_count END
          SET feedback = 1
          FOR (a = (0 - 1); a < na; ++a) BEGIN
            SET n = eq_count SET first = eq_first
            PATCH_IF a >= 0 BEGIN
              READ_SHORT (ab + a * 0x28 + 0x1e) n READ_SHORT (ab + a * 0x28 + 0x20) first
              READ_SHORT (ab + a * 0x28 + 0x26) projectile
              PATCH_IF projectile > 1 BEGIN SET feedback = 0 END
            END
            FOR (i = 0; i < n; ++i) BEGIN
              READ_SHORT (fx + (first + i) * 0x30) op
              PATCH_IF NOT (op = 61 OR op = 139 OR op = 141 OR op = 142 OR op = 174
                OR op = 215 OR op = 240) BEGIN SET feedback = 0 END
            END
          END
        END
      END
    BUT_ONLY
  END
END

// Classify a delegated payload without copying or changing its spell identity.
// bit 0 = Slow; bit 1 = its companions; bit 2 = another behavior/unsafe delivery.
// A save on a pure, single-recipient parent preserves resource immunities and
// self-refresh. Saving a mixed payload would also nerf its unrelated effects.
// Companions: Slowed feedback, removal of Haste or of an earlier Slow by the
// installed secondary types, the installed Slow's own AC/THAC0 penalties with
// this Slow's timing (slow_penalties = ~|opcode:mode|~, list_slow_timings =
// ~|timing:duration|~ of this list's opcode 40), and a feedback-only opcode 326
// whose condition also blocks the rest of this list (list_self_blocks).
DEFINE_PATCH_FUNCTION cbr_foa_classify_effect
  INT_VAR op = 0 target = 2 p1 = 0 p2 = 0 save = 0 bonus = 0 timing = 0 duration = 0
    save_penalty = 2 depth = 0 search_opcode = (0 - 1)
  STR_VAR resource = ~~ owner = ~~ chain = ~|~ haste_types = ~|~ slow_types = ~|~
    slow_penalties = ~|~ list_slow_timings = ~|~ list_self_blocks = ~|~
  RET kind
BEGIN
  SET kind = 4
  SET linked = (op = 146 OR op = 177 OR op = 326 OR (search_opcode >= 0 AND op = 148))
  SET removal = 0 SET penalty = 0
  PATCH_IF op = 221 AND p2 > 0 BEGIN
    LPF cbr_foa_in_set STR_VAR set = EVAL ~%haste_types%%slow_types%~ item = EVAL ~%p2%~ RET removal = found END
  END
  PATCH_IF (op = 0 OR op = 54) AND p1 < 0 BEGIN
    LPF cbr_foa_in_set STR_VAR set = EVAL ~%slow_penalties%~ item = EVAL ~%op%:%p2%~ RET penalty = found END
    LPF cbr_foa_in_set STR_VAR set = EVAL ~%list_slow_timings%~ item = EVAL ~%timing%:%duration%~ RET same_timing = found END
    SET penalty = (penalty AND same_timing)
  END
  PATCH_IF search_opcode >= 0 BEGIN SET kind = (op = search_opcode) END
  ELSE PATCH_IF op = 40 BEGIN SET kind = 1 END
  ELSE PATCH_IF (op = 139 AND p1 = 14000) OR (op = 142 AND p2 = 41) OR removal OR penalty BEGIN SET kind = 2 END
  ELSE PATCH_IF (op = 321 OR op = 206 OR op = 318 OR op = 324)
    AND NOT (~%owner%~ STRING_EQUAL ~~) AND (~%resource%~ STRING_EQUAL_CASE ~%owner%~) BEGIN SET kind = 0 END
  ELSE PATCH_IF op = 174 OR op = 215 BEGIN SET kind = 0 END // sound/visual only
  ELSE PATCH_IF op = 326 BEGIN
    // SCS's Slow cancels Haste instead of slowing: under one condition the
    // payload says so and an opcode 318/324 on this resource blocks the rest.
    LPF cbr_foa_in_set STR_VAR set = EVAL ~%list_self_blocks%~ item = EVAL ~%p1%:%p2%~ RET paired = found END
    PATCH_IF paired BEGIN
      INNER_ACTION BEGIN
        LAF cbr_foa_feedback_only STR_VAR source = EVAL ~%resource%~ RET feedback END
      END
      PATCH_IF feedback BEGIN SET kind = 2 SET linked = 0 END
    END
  END
  PATCH_IF linked BEGIN
    SPRINT extension ~SPL~
    PATCH_IF op = 177 BEGIN SPRINT extension ~EFF~ END
    INNER_ACTION BEGIN
      LAF cbr_foa_classify_resource INT_VAR save_penalty depth search_opcode
        STR_VAR source = EVAL ~%resource%~ extension = EVAL ~%extension%~ chain = EVAL ~%chain%~
          haste_types = EVAL ~%haste_types%~ slow_types = EVAL ~%slow_types%~
          slow_penalties = EVAL ~%slow_penalties%~
        RET kind END
    END
  END
  // An additional inner save cannot be replaced by saving only the parent.
  // Self/party/area effects cannot share one recipient's parent save either.
  PATCH_IF search_opcode < 0 AND (target != 2 OR (save BAND 0x3ff) != 0) BEGIN
    SET kind = kind BOR 4
  END
END

DEFINE_ACTION_FUNCTION cbr_foa_classify_resource
  INT_VAR save_penalty = 2 depth = 0 search_opcode = (0 - 1)
  STR_VAR source = ~~ extension = ~SPL~ chain = ~|~ haste_types = ~|~ slow_types = ~|~ slow_penalties = ~|~
  RET kind
BEGIN
  OUTER_SET kind = 4
  ACTION_IF FILE_EXISTS_IN_GAME ~%source%.%extension%~ BEGIN
    // Cyclic/very deep foreign helpers are opaque, not install fingerprints.
    // They remain untouched unless a Slow-containing mixed delivery is found.
    ACTION_IF depth < 32 AND (~%chain%~ STRING_CONTAINS_REGEXP ~|%source%[.]%extension%|~) != 0 BEGIN
      COPY_EXISTING ~%source%.%extension%~ ~~
        PATCH_IF BUFFER_LENGTH < 8 BEGIN PATCH_FAIL ~Flail of Ages: truncated linked effect resource.~ END
        READ_ASCII 0 sig (8)
        SET kind = 0
        PATCH_IF ~%extension%~ STRING_EQUAL ~EFF~ BEGIN
          PATCH_IF BUFFER_LENGTH < 0x110 OR NOT (~%sig%~ STRING_EQUAL ~EFF V2.0~) BEGIN
            PATCH_FAIL ~Flail of Ages: linked EFF has an invalid header or is truncated.~
          END
          READ_LONG 0x10 op READ_LONG 0x14 target READ_LONG 0x1c p1 READ_LONG 0x20 p2
          READ_LONG 0x24 timing READ_LONG 0x28 duration
          READ_ASCII 0x30 resource (8) NULL READ_LONG 0x40 save READ_LONG 0x44 bonus
          LPF cbr_foa_classify_effect INT_VAR op target p1 p2 save bonus timing duration save_penalty search_opcode depth = depth + 1
            STR_VAR resource = EVAL ~%resource%~ owner = EVAL ~%source%~ chain = EVAL ~%chain%%source%.%extension%|~
              haste_types = EVAL ~%haste_types%~ slow_types = EVAL ~%slow_types%~ slow_penalties = EVAL ~%slow_penalties%~
            RET kind END
        END ELSE BEGIN
          PATCH_IF NOT (~%sig%~ STRING_EQUAL ~SPL V1  ~) BEGIN PATCH_FAIL ~Flail of Ages: linked spell is not SPL V1.~ END
          LPF cbr_foa_layout INT_VAR stride = 0x28 RET ab na fx eq_first eq_count END
          // Casting features belong to the caster rather than the struck actor.
          PATCH_IF eq_count > 0 AND search_opcode < 0 BEGIN SET kind = 4 END
          FOR (a = (0 - 1); a < na; ++a) BEGIN
            SET n = eq_count SET first = eq_first
            PATCH_IF a >= 0 BEGIN
              SET header = ab + a * 0x28
              READ_BYTE (header + 0xc) ability_target READ_SHORT (header + 0x26) projectile
              READ_SHORT (header + 0x1e) n READ_SHORT (header + 0x20) first
              // Instant no-projectile delivery is known single-recipient.
              // Other projectiles require a delivery-specific adapter (possibly AoE).
              PATCH_IF search_opcode < 0 AND (ability_target != 1 OR projectile > 1) BEGIN SET kind = kind BOR 4 END
            END
            // Effects of one list are applied together, so penalties and the
            // feedback branch are judged against this list's Slow and blocks.
            SPRINT list_slow_timings ~|~ SPRINT list_self_blocks ~|~
            FOR (i = 0; i < n; ++i) BEGIN
              SET at = fx + (first + i) * 0x30
              READ_SHORT at op READ_LONG (at + 4) p1 READ_LONG (at + 8) p2
              READ_BYTE (at + 0xc) timing READ_LONG (at + 0xe) duration READ_ASCII (at + 0x14) resource (8) NULL
              PATCH_IF op = 40 BEGIN SPRINT list_slow_timings ~%list_slow_timings%%timing%:%duration%|~ END
              PATCH_IF (op = 318 OR op = 324) AND (~%resource%~ STRING_EQUAL_CASE ~%source%~) BEGIN
                SPRINT list_self_blocks ~%list_self_blocks%%p1%:%p2%|~
              END
            END
            FOR (i = 0; i < n; ++i) BEGIN
              SET at = fx + (first + i) * 0x30
              READ_SHORT at op READ_BYTE (at + 2) target READ_LONG (at + 4) p1 READ_LONG (at + 8) p2
              READ_BYTE (at + 0xc) timing READ_LONG (at + 0xe) duration
              READ_ASCII (at + 0x14) resource (8) NULL READ_LONG (at + 0x24) save READ_LONG (at + 0x28) bonus
              LPF cbr_foa_classify_effect INT_VAR op target p1 p2 save bonus timing duration save_penalty search_opcode depth = depth + 1
                STR_VAR resource = EVAL ~%resource%~ owner = EVAL ~%source%~ chain = EVAL ~%chain%%source%.%extension%|~
                  haste_types = EVAL ~%haste_types%~ slow_types = EVAL ~%slow_types%~ slow_penalties = EVAL ~%slow_penalties%~
                  list_slow_timings = EVAL ~%list_slow_timings%~ list_self_blocks = EVAL ~%list_self_blocks%~
                RET child_kind = kind END
              SET kind = kind BOR child_kind
            END
          END
        END
      BUT_ONLY
    END
  END
END

// bit 3 marks an installed Slow penalty; it shares a direct Slow's save only
// when it also has that Slow's timing and duration.
DEFINE_PATCH_FUNCTION cbr_foa_slow_slice
  INT_VAR start = 0 count = 0 save_penalty = 2
  STR_VAR haste_types = ~|~ slow_types = ~|~ slow_penalties = ~|~
  RET found
BEGIN
  SET found = 0
  FOR (i = 0; i < count; ++i) BEGIN
    SET at = start + i * 0x30
    READ_SHORT at op READ_BYTE (at + 2) target
    READ_LONG (at + 4) p1 READ_LONG (at + 8) p2
    SET kind = 0 SET removal = 0 SET penalty = 0
    PATCH_IF op = 221 AND p2 > 0 BEGIN
      LPF cbr_foa_in_set STR_VAR set = EVAL ~%haste_types%%slow_types%~ item = EVAL ~%p2%~ RET removal = found END
    END
    PATCH_IF (op = 0 OR op = 54) AND p1 < 0 BEGIN
      LPF cbr_foa_in_set STR_VAR set = EVAL ~%slow_penalties%~ item = EVAL ~%op%:%p2%~ RET penalty = found END
    END
    PATCH_IF target = 2 BEGIN
      PATCH_IF op = 40 BEGIN SET kind = 1 END
      ELSE PATCH_IF (op = 139 AND p1 = 14000) OR (op = 142 AND p2 = 41) OR removal BEGIN SET kind = 2 END
      ELSE PATCH_IF penalty BEGIN SET kind = 8 END
      ELSE PATCH_IF op = 221 AND (~%haste_types%~ STRING_EQUAL ~|~) BEGIN
        PATCH_PRINT ~Flail of Ages: %SOURCE_RES% removes secondary type %p2% on hit. Haste's secondary type is unknown in this game, so that removal was left unchanged and has no save.~
      END
      ELSE PATCH_IF op = 146 OR op = 177 OR op = 326 BEGIN
        READ_ASCII (at + 0x14) child (8) NULL
        SPRINT extension ~SPL~
        PATCH_IF op = 177 BEGIN SPRINT extension ~EFF~ END
        INNER_ACTION BEGIN
          LAF cbr_foa_classify_resource INT_VAR save_penalty
            STR_VAR source = EVAL ~%child%~ extension = EVAL ~%extension%~
              haste_types = EVAL ~%haste_types%~ slow_types = EVAL ~%slow_types%~ slow_penalties = EVAL ~%slow_penalties%~
            RET kind END
        END
        PATCH_IF (kind BAND 1) != 0 AND (kind BAND 4) != 0 BEGIN
          PATCH_FAIL ~Flail of Ages: %child%.%extension% mixes Slow with other effects, additional saves, or a different recipient/projectile. Saving the whole helper would change those effects; an adapter is needed.~
        END
      END
    END
    SET $foa_kind(~%i%~) = kind
    SET found += (kind BAND 1)
  END
  FOR (i = 0; i < count; ++i) BEGIN
    PATCH_IF ($foa_kind(~%i%~) BAND 1) != 0 BEGIN
      SET donor = start + i * 0x30
      READ_SHORT donor donor_op READ_BYTE (donor + 2) target
      READ_BYTE (donor + 0xc) donor_timing READ_LONG (donor + 0xe) donor_duration
      READ_BYTE (donor + 0x12) probability1 READ_BYTE (donor + 0x13) probability2
      FOR (j = 0; j < count; ++j) BEGIN
        SET at = start + j * 0x30
        READ_BYTE (at + 2) t READ_BYTE (at + 0x12) hi READ_BYTE (at + 0x13) lo
        READ_BYTE (at + 0xc) tm READ_LONG (at + 0xe) dur
        SET companion = (($foa_kind(~%j%~) BAND 3) != 0 AND ($foa_kind(~%j%~) BAND 4) = 0)
          OR ($foa_kind(~%j%~) = 8 AND donor_op = 40 AND tm = donor_timing AND dur = donor_duration)
        PATCH_IF t = target AND hi = probability1 AND lo = probability2 AND companion BEGIN
          READ_LONG (at + 0x24) save
          WRITE_LONG (at + 0x24) ((save BAND 0xffffffe0) BOR 2)
          WRITE_LONG (at + 0x28) (0 - save_penalty)
        END
      END
    END
  END
END

// For noncanonical immunity resources, a stray Haste record is not enough:
// only a referenced payload of Haste and its normal companions establishes
// identity. Those companions are feedback/visuals, the post-Haste fatigue,
// removal of Slow or an earlier Haste by secondary type (SR), and guards
// against stacking the same resource. Vanilla and SR innate Haste spells carry
// them. Anything else, such as damage, keeps the flail's immunity.
// A spell cast by opcode 146 is part of the same Haste and is judged as a
// whole with it (SCS's SPIN572 casts its op16 payload SPIN572A); each resource
// is its own owner for self-guards and SCS's paired "Slow cancelled by Haste"
// feedback branch. A missing, malformed or too-deep payload is unknown and
// counts as foreign (opcode 146). Traversal is bounded; each resource once.
DEFINE_ACTION_FUNCTION cbr_foa_native_haste
  INT_VAR depth = 0
  STR_VAR source = ~~ seen = ~|~ haste_types = ~|~ slow_types = ~|~
  RET is_haste has_haste foreign_op seen
BEGIN
  OUTER_SET has_haste = 0 OUTER_SET foreign_op = (0 - 1)
  ACTION_TO_UPPER source
  ACTION_IF (~%seen%~ STRING_CONTAINS_REGEXP ~|%source%|~) != 0 BEGIN
    OUTER_SPRINT seen ~%seen%%source%|~
    OUTER_SET foreign_op = 146
    ACTION_IF depth < 32 AND FILE_EXISTS_IN_GAME ~%source%.SPL~ BEGIN
      COPY_EXISTING ~%source%.SPL~ ~~
        PATCH_IF BUFFER_LENGTH >= 0x72 BEGIN
          READ_ASCII 0 signature (8)
          PATCH_IF ~%signature%~ STRING_EQUAL ~SPL V1  ~ BEGIN
            SET foreign_op = (0 - 1)
            LPF cbr_foa_layout INT_VAR stride = 0x28 RET ab na fx eq_first eq_count END
            FOR (a = (0 - 1); a < na; ++a) BEGIN
              SET n = eq_count SET first = eq_first
              PATCH_IF a >= 0 BEGIN
                READ_SHORT (ab + a * 0x28 + 0x1e) n READ_SHORT (ab + a * 0x28 + 0x20) first
              END
              SPRINT self_blocks ~|~
              FOR (i = 0; i < n; ++i) BEGIN
                SET at = fx + (first + i) * 0x30
                READ_SHORT at op READ_LONG (at + 4) p1 READ_LONG (at + 8) p2 READ_ASCII (at + 0x14) res (8) NULL
                PATCH_IF (op = 318 OR op = 324) AND (~%res%~ STRING_EQUAL_CASE ~%source%~) BEGIN
                  SPRINT self_blocks ~%self_blocks%%p1%:%p2%|~
                END
              END
              FOR (i = 0; i < n; ++i) BEGIN
                SET at = fx + (first + i) * 0x30
                READ_SHORT at op READ_LONG (at + 4) p1 READ_LONG (at + 8) p2
                READ_ASCII (at + 0x14) res (8) NULL
                SET allowed = (op = 50 OR op = 61 OR op = 139 OR op = 141 OR op = 142
                  OR op = 174 OR op = 215 OR op = 93
                  OR ((op = 206 OR op = 318 OR op = 321 OR op = 324) AND (~%res%~ STRING_EQUAL_CASE ~%source%~)))
                PATCH_IF op = 221 AND p2 > 0 BEGIN
                  LPF cbr_foa_in_set STR_VAR set = EVAL ~%haste_types%%slow_types%~ item = EVAL ~%p2%~ RET allowed = found END
                END
                PATCH_IF op = 326 BEGIN
                  LPF cbr_foa_in_set STR_VAR set = EVAL ~%self_blocks%~ item = EVAL ~%p1%:%p2%~ RET paired = found END
                  PATCH_IF paired BEGIN
                    INNER_ACTION BEGIN
                      LAF cbr_foa_feedback_only STR_VAR source = EVAL ~%res%~ RET allowed = feedback END
                    END
                  END
                END
                PATCH_IF op = 16 BEGIN SET has_haste = 1 END
                ELSE PATCH_IF op = 146 AND NOT (~%res%~ STRING_EQUAL ~~) BEGIN
                  INNER_ACTION BEGIN
                    LAF cbr_foa_native_haste INT_VAR depth = depth + 1
                      STR_VAR source = EVAL ~%res%~ seen = EVAL ~%seen%~
                        haste_types = EVAL ~%haste_types%~ slow_types = EVAL ~%slow_types%~
                      RET child_haste = has_haste child_foreign = foreign_op seen END
                  END
                  SET has_haste = (has_haste OR child_haste)
                  PATCH_IF foreign_op < 0 BEGIN SET foreign_op = child_foreign END
                END
                ELSE PATCH_IF NOT allowed AND foreign_op < 0 BEGIN SET foreign_op = op END
              END
            END
          END
        END
      BUT_ONLY
    END
  END
  OUTER_SET is_haste = (has_haste AND (foreign_op < 0))
END

// haste_splstates: spell states the installed Haste and Improved Haste check
// (SPLPROT "has spell state") to refuse themselves. haste_immunity_state is
// SPLSTATE.IDS HASTE_IMMUNITY, the confirmation that such a state means only
// "cannot be hasted"; -1 when the symbol is absent.
DEFINE_PATCH_FUNCTION cbr_foa_patch
  INT_VAR save_penalty = 2 allow_haste = 0 haste_movement = 0 haste_immunity_state = (0 - 1)
  STR_VAR haste_resref = ~~ improved_haste_resref = ~~ haste_types = ~|~ slow_types = ~|~
    slow_penalties = ~|~ haste_splstates = ~|~
  RET slow_found
BEGIN
  PATCH_IF BUFFER_LENGTH < 0x72 BEGIN PATCH_FAIL ~Flail of Ages: truncated ITM.~ END
  READ_ASCII 0 sig (8)
  PATCH_IF NOT (~%sig%~ STRING_EQUAL ~ITM V1  ~) BEGIN
    PATCH_FAIL ~Flail of Ages: unsupported ITM format.~
  END
  LPF cbr_foa_layout RET ab na fx eq_first eq_count END
  PATCH_IF allow_haste AND eq_count > 0 BEGIN
    SET shared = 0
    FOR (a = 0; a < na; ++a) BEGIN
      READ_SHORT (ab + a * 0x38 + 0x1e) n READ_SHORT (ab + a * 0x38 + 0x20) first
      PATCH_IF n > 0 AND first < eq_first + eq_count AND eq_first < first + n BEGIN SET shared = 1 END
    END
    PATCH_IF shared BEGIN
      LPF cbr_foa_copy_slice INT_VAR fx first = eq_first count = eq_count RET eq_first = copied_first END
      WRITE_SHORT 0x6e eq_first
    END
  END
  SET slow_found = 0
  FOR (a = 0; a < na; ++a) BEGIN
    SET header = ab + a * 0x38
    READ_BYTE header kind
    PATCH_IF kind = 1 BEGIN
      READ_SHORT (header + 0x1e) n READ_SHORT (header + 0x20) first
      SET shared = 0
      PATCH_IF n > 0 AND eq_count > 0 AND first < eq_first + eq_count AND eq_first < first + n BEGIN
        SET shared = 1
      END
      FOR (other = 0; other < na; ++other) BEGIN
        READ_BYTE (ab + other * 0x38) other_kind
        READ_SHORT (ab + other * 0x38 + 0x1e) other_n
        READ_SHORT (ab + other * 0x38 + 0x20) other_first
        PATCH_IF other_kind != 1 AND n > 0 AND other_n > 0
          AND first < other_first + other_n AND other_first < first + n BEGIN
          SET shared = 1
        END
      END
      PATCH_IF shared BEGIN
        LPF cbr_foa_copy_slice INT_VAR fx first count = n RET first = copied_first END
        WRITE_SHORT (header + 0x20) first
      END
      LPF cbr_foa_slow_slice INT_VAR start = fx + first * 0x30 count = n save_penalty
        STR_VAR haste_types = EVAL ~%haste_types%~ slow_types = EVAL ~%slow_types%~
          slow_penalties = EVAL ~%slow_penalties%~
        RET found END
      SET slow_found += found
    END
  END
  PATCH_IF slow_found = 0 BEGIN
    PATCH_PRINT ~Flail of Ages: %SOURCE_RES% has no recognized on-hit Slow; its on-hit effects were left unchanged.~
  END

  PATCH_IF allow_haste BEGIN
    FOR (i = eq_count - 1; i >= 0; --i) BEGIN
      SET idx = eq_first + i
      SET at = fx + idx * 0x30
      READ_SHORT at op READ_BYTE (at + 2) target
      READ_LONG (at + 4) p1 READ_LONG (at + 8) p2
      READ_ASCII (at + 0x14) res (8) NULL
      SET remove = 0
      PATCH_IF target = 1 BEGIN
        // Removing immunity to all movement-rate changes would also remove
        // protection from harmful movement changes, outside this component.
        PATCH_IF op = 101 AND p2 = 176 AND haste_movement BEGIN
          PATCH_IF (haste_movement BAND 4) != 0 BEGIN
            PATCH_FAIL ~Flail of Ages: movement-rate immunity may block a Haste helper that could not be resolved; removing it would also lose protection against harmful movement changes.~
          END
          PATCH_FAIL ~Flail of Ages: movement-rate immunity blocks revised Haste as well as harmful movement changes; cannot remove it without losing that protection.~
        END
        SET remove = (((op = 101) OR (op = 337)) AND (p2 = 16))
          OR (((op = 169) OR (op = 240)) AND (p2 = 38))
          OR ((op = 267) AND (p1 = 14023))
          OR ((op = 126) AND (p1 = 100) AND (p2 = 2))
        // Mode 1 sets a SPLSTATE.IDS state; mode 0 the IWD list 0..7 (IESDP).
        READ_LONG (at + 0x2c) special
        PATCH_IF op = 328 AND special = 1 BEGIN
          LPF cbr_foa_in_set STR_VAR set = EVAL ~%haste_splstates%~ item = EVAL ~%p2%~ RET checked = found END
          PATCH_IF checked AND p2 = haste_immunity_state BEGIN SET remove = 1 END
          ELSE PATCH_IF checked BEGIN
            PATCH_FAIL ~Flail of Ages: %SOURCE_RES% sets spell state %p2%, which the installed Haste or Improved Haste checks to refuse itself, but SPLSTATE.IDS does not name it HASTE_IMMUNITY. Removing it could also remove another protection, so Haste cannot be allowed safely.~
          END ELSE PATCH_IF p2 = haste_immunity_state BEGIN
            PATCH_PRINT ~Flail of Ages: %SOURCE_RES% keeps spell state HASTE_IMMUNITY (%p2%): the installed Haste and Improved Haste do not check it, so it does not block them.~
          END
        END
        PATCH_IF op = 206 BEGIN
          PATCH_IF (((NOT (~%haste_resref%~ STRING_EQUAL ~~)) AND (~%res%~ STRING_EQUAL_CASE ~%haste_resref%~))
            OR ((NOT (~%improved_haste_resref%~ STRING_EQUAL ~~)) AND (~%res%~ STRING_EQUAL_CASE ~%improved_haste_resref%~))) BEGIN
            SET remove = 1
          END ELSE PATCH_IF FILE_EXISTS_IN_GAME ~%res%.spl~ BEGIN
            INNER_ACTION BEGIN
              LAF cbr_foa_native_haste
                STR_VAR source = EVAL ~%res%~ haste_types = EVAL ~%haste_types%~ slow_types = EVAL ~%slow_types%~
                RET is_haste has_haste foreign_op END
            END
            PATCH_IF is_haste BEGIN SET remove = 1 END
            ELSE PATCH_IF has_haste BEGIN
              PATCH_PRINT ~Flail of Ages: %SOURCE_RES% keeps its immunity to %res%. That spell combines Haste with another effect (opcode %foreign_op%), and removing the immunity would expose the wielder to that effect too.~
            END ELSE PATCH_IF foreign_op = 146 BEGIN
              PATCH_PRINT ~Flail of Ages: %SOURCE_RES% keeps its immunity to %res%. That spell casts a spell that is missing or cannot be read, so whether it is Haste is unknown.~
            END
          END
        END
      END
      PATCH_IF remove BEGIN
        DELETE_BYTES at 0x30
        --eq_count
        WRITE_SHORT 0x70 eq_count
        FOR (a = 0; a < na; ++a) BEGIN
          READ_SHORT (ab + a * 0x38 + 0x20) first
          PATCH_IF first > idx BEGIN WRITE_SHORT (ab + a * 0x38 + 0x20) (first - 1) END
        END
      END
    END
  END
END

DEFINE_PATCH_FUNCTION cbr_foa_description
  INT_VAR allow_haste = 0 slow_found = 1
  STR_VAR save_note = ~~ haste_note = ~~
BEGIN
  READ_STRREF 0x54 desc
  INNER_PATCH_SAVE new_desc ~%desc%~ BEGIN
    PATCH_IF slow_found BEGIN
      COUNT_REGEXP_INSTANCES ~[^%WNL%%LNL%%MNL%]*[Ss]low[^%WNL%%LNL%%MNL%]*~ lines
      SET annotated = 0
      PATCH_IF lines > 0 BEGIN
        REPLACE_EVALUATE ~[^%WNL%%LNL%%MNL%]*[Ss]low[^%WNL%%LNL%%MNL%]*~ BEGIN
          INNER_PATCH_SAVE line ~%MATCH0%~ BEGIN
            COUNT_REGEXP_INSTANCES ~([Nn]o [Ss]ave)~ no_save
            COUNT_REGEXP_INSTANCES ~([Nn]o [Ss]aving [Tt]hrow)~ no_throw
            COUNT_REGEXP_INSTANCES ~(Save vs. Breath at -[246] negates)~ old_note
            SET annotate = (lines = 1 OR no_save > 0 OR no_throw > 0 OR old_note > 0)
            PATCH_IF annotate BEGIN
            REPLACE_TEXTUALLY CASE_INSENSITIVE ~[ ]*(No Save)~ ~~
            REPLACE_TEXTUALLY CASE_INSENSITIVE ~[ ]*(no saving throw)~ ~~
            REPLACE_TEXTUALLY ~[ ]*(Save vs. Breath at -[246] negates)~ ~~
            REPLACE_TEXTUALLY ~[ %TAB%]+$~ ~~
            END
          END
          PATCH_IF annotate BEGIN
            SPRINT line ~%line% %save_note%~
            SET annotated += 1
          END
        END ~%line%~
      END
      PATCH_IF annotated = 0 BEGIN
        // Do not rewrite lore or require English text for valid mechanics.
        // This explicit override note takes precedence over an older description.
        COUNT_REGEXP_INSTANCES ~CBR on-hit Slow:~ notes
        PATCH_IF notes = 0 BEGIN
          INSERT_BYTES BUFFER_LENGTH (STRING_LENGTH ~%LNL%CBR on-hit Slow: %save_note%~)
          WRITE_ASCIIE (BUFFER_LENGTH - STRING_LENGTH ~%LNL%CBR on-hit Slow: %save_note%~) ~%LNL%CBR on-hit Slow: %save_note%~
        END
      END
    END
    PATCH_IF allow_haste BEGIN
      COUNT_REGEXP_INSTANCES ~[^%WNL%%LNL%%MNL%]*[Ff]ree [Aa]ction[^%WNL%%LNL%%MNL%]*~ lines
      PATCH_IF lines = 1 BEGIN
        REPLACE_EVALUATE ~[^%WNL%%LNL%%MNL%]*[Ff]ree [Aa]ction[^%WNL%%LNL%%MNL%]*~ BEGIN
          INNER_PATCH_SAVE line ~%MATCH0%~ BEGIN
            REPLACE_TEXTUALLY ~[ ]*(allows Haste and Improved Haste)~ ~~
            REPLACE_TEXTUALLY ~[ %TAB%]+$~ ~~
          END
        END ~%line% %haste_note%~
      END ELSE BEGIN
        COUNT_REGEXP_INSTANCES ~CBR Free Action:~ notes
        PATCH_IF notes = 0 BEGIN
          INSERT_BYTES BUFFER_LENGTH (STRING_LENGTH ~%LNL%CBR Free Action: %haste_note%~)
          WRITE_ASCIIE (BUFFER_LENGTH - STRING_LENGTH ~%LNL%CBR Free Action: %haste_note%~) ~%LNL%CBR Free Action: %haste_note%~
        END
      END
    END
  END
  PATCH_IF NOT (~%new_desc%~ STRING_EQUAL ~%desc%~) BEGIN
    WRITE_LONG 0x54 (RESOLVE_STR_REF (~%new_desc%~))
  END
END
