// Druid access for priest spells (350). For priest spells the high word of the
// exclusion flags (0x20) selects the classes: bit 0x8000 excludes druids and
// rangers, bit 0x4000 clerics and paladins. Only the druid bit is cleared.
DEFINE_PATCH_FUNCTION cbr_druid_access_patch
  RET cbr_da_changed
BEGIN
  SET cbr_da_changed = 0
  PATCH_IF BUFFER_LENGTH < 0x72 BEGIN
    PATCH_FAIL ~CBR druid access: %SOURCE_RES% has a truncated SPL header.~
  END
  READ_ASCII 0 cbr_da_sig (8)
  PATCH_IF NOT (~%cbr_da_sig%~ STRING_EQUAL ~SPL V1  ~) BEGIN
    PATCH_FAIL ~CBR druid access: %SOURCE_RES% is not an SPL V1 file.~
  END
  READ_SHORT 0x1c cbr_da_type
  PATCH_IF cbr_da_type != 2 BEGIN
    PATCH_FAIL ~CBR druid access: %SOURCE_RES% is not a priest spell (type %cbr_da_type%).~
  END
  READ_SHORT 0x20 cbr_da_classes
  PATCH_IF (cbr_da_classes BAND 0x8000) != 0 BEGIN
    // Both class bits set means no priest can learn it: a hidden helper, not a
    // restriction to lift. Refuse rather than publish an unintended spell.
    PATCH_IF (cbr_da_classes BAND 0x4000) != 0 BEGIN
      PATCH_FAIL ~CBR druid access: %SOURCE_RES% is excluded for every priest class; refusing to make it learnable.~
    END
    WRITE_SHORT 0x20 (cbr_da_classes BAND 0x7fff)
    SET cbr_da_changed = 1
  END
END

DEFINE_ACTION_FUNCTION cbr_install_druid_access
  STR_VAR symbol = ~~
BEGIN
  CLEAR_IDS_MAP
  OUTER_SET cbr_da_id = IDS_OF_SYMBOL (~spell~ ~%symbol%~)
  ACTION_IF cbr_da_id < 1100 OR cbr_da_id > 1999 BEGIN
    FAIL ~CBR druid access: %symbol% is not a priest spell in SPELL.IDS.~
  END
  OUTER_SET cbr_da_slot = cbr_da_id - 1000
  OUTER_SPRINT cbr_da_res ~SPPR%cbr_da_slot%~
  ACTION_IF NOT FILE_EXISTS_IN_GAME ~%cbr_da_res%.spl~ BEGIN
    FAIL ~CBR druid access: SPELL.IDS maps %symbol% to the missing %cbr_da_res%.spl.~
  END
  OUTER_SET cbr_da_changed = 0
  COPY_EXISTING ~%cbr_da_res%.spl~ ~override~
    LPF cbr_druid_access_patch RET cbr_da_changed END
  BUT_ONLY_IF_IT_CHANGES
  ACTION_IF cbr_da_changed BEGIN PRINT @3500 END ELSE BEGIN PRINT @3501 END
END
