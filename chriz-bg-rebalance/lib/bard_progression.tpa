// API 1 installer helpers. Component 420 publishes this functions-only library
// as CBRSPAPI.TPA so late kit adapters share the registry and text contract.

// Read-only, file-based preflight, also callable from a --nogame test harness.
// Find the actual instruction sequence rather than pinning a build offset or
// the relative CALL displacement (which differs between BG2EE and IWDEE).
DEFINE_ACTION_FUNCTION cbr_sp_preflight_executable
  STR_VAR executable_path = ~~
  RET hook_offset
BEGIN
  OUTER_SPRINT executable_path EVALUATE_BUFFER ~%executable_path%~
  ACTION_IF (NOT FILE_EXISTS ~%executable_path%~) BEGIN
    FAIL ~Bard progression: game executable %executable_path% was not found.~
  END
  OUTER_PATCH_SAVE cbr_sp_signature ~................~ BEGIN
    WRITE_LONG 0 0x388e8d48
    WRITE_LONG 4 0x4c000007
    WRITE_LONG 8 0x48f0458d
    WRITE_LONG 12 0xe8f8558d
  END
  OUTER_SET hook_offset = (0 - 1)
  COPY - ~%executable_path%~ ~cbr_bard_exe_probe~
    PATCH_IF (SOURCE_SIZE < 0x40) BEGIN
      PATCH_FAIL ~Bard progression: executable is not a supported 64-bit PE image.~
    END
    READ_SHORT 0 cbr_sp_dos_magic
    READ_LONG 0x3c cbr_sp_pe
    PATCH_IF ((cbr_sp_dos_magic != 0x5a4d) OR (cbr_sp_pe < 0x40)
           OR (cbr_sp_pe > SOURCE_SIZE - 26)) BEGIN
      PATCH_FAIL ~Bard progression: executable is not a supported 64-bit PE image.~
    END
    READ_LONG cbr_sp_pe cbr_sp_pe_magic
    READ_SHORT (cbr_sp_pe + 4) cbr_sp_machine
    READ_SHORT (cbr_sp_pe + 6) cbr_sp_sections
    READ_SHORT (cbr_sp_pe + 20) cbr_sp_optional_size
    READ_SHORT (cbr_sp_pe + 24) cbr_sp_optional_magic
    PATCH_IF ((cbr_sp_pe_magic != 0x4550) OR (cbr_sp_machine != 0x8664)
           OR (cbr_sp_optional_magic != 0x20b) OR (cbr_sp_optional_size < 2)
           OR (cbr_sp_sections < 1)
           OR (cbr_sp_pe + 24 + cbr_sp_optional_size + cbr_sp_sections * 40 > SOURCE_SIZE)) BEGIN
      PATCH_FAIL ~Bard progression: executable is not a supported 64-bit PE image.~
    END
    SET cbr_sp_matches = 0
    SET cbr_sp_match = INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~%cbr_sp_signature%~)
    WHILE (cbr_sp_match >= 0) BEGIN
      PATCH_IF (cbr_sp_match <= SOURCE_SIZE - 24) BEGIN
        READ_LONG (cbr_sp_match + 20) cbr_sp_tail
        PATCH_IF (cbr_sp_tail = 0xe4458d4c) BEGIN
          SET cbr_sp_matches += 1
          SET hook_offset = cbr_sp_match
        END
      END
      SET cbr_sp_match = INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~%cbr_sp_signature%~ (cbr_sp_match + 1))
    END
    PATCH_IF (cbr_sp_matches != 1) BEGIN
      PATCH_FAIL ~Bard progression: expected one compatible bard-table hook, found %cbr_sp_matches%. This executable is unsupported or ambiguous; no hook was installed.~
    END
    SET cbr_sp_executable_section = 0
    FOR (cbr_sp_section = 0; cbr_sp_section < cbr_sp_sections; ++cbr_sp_section) BEGIN
      SET cbr_sp_section_offset = cbr_sp_pe + 24 + cbr_sp_optional_size + cbr_sp_section * 40
      READ_LONG (cbr_sp_section_offset + 16) cbr_sp_raw_size
      READ_LONG (cbr_sp_section_offset + 20) cbr_sp_raw_start
      READ_LONG (cbr_sp_section_offset + 36) cbr_sp_section_flags
      PATCH_IF ((cbr_sp_raw_start >= 0) AND (cbr_sp_raw_size >= 24)
             AND (cbr_sp_raw_start <= SOURCE_SIZE - cbr_sp_raw_size)
             AND (hook_offset >= cbr_sp_raw_start)
             AND (hook_offset <= cbr_sp_raw_start + cbr_sp_raw_size - 24)
             AND ((cbr_sp_section_flags BAND 0x20000000) != 0)) BEGIN
        SET cbr_sp_executable_section = 1
      END
    END
    PATCH_IF (NOT cbr_sp_executable_section) BEGIN
      PATCH_FAIL ~Bard progression: compatible bytes are outside an executable section; no hook was installed.~
    END
  PRINT ~Bard progression: compatible native hook found in %executable_path% at file offset %hook_offset%.~
END

DEFINE_PATCH_FUNCTION cbr_sp_table_read
  RET cbr_t_cols cbr_t_rows cbr_t_default
  RET_ARRAY cbr_t_head cbr_t_cell
BEGIN
  CLEAR_ARRAY cbr_t_head CLEAR_ARRAY cbr_t_cell CLEAR_ARRAY cbr_t_line CLEAR_ARRAY cbr_t_width
  SET line = 0
  READ_ASCII 0 source (BUFFER_LENGTH)
  INNER_PATCH ~%source%~ BEGIN
    REPLACE_EVALUATE ~[^%LNL%%MNL%]+~ BEGIN
      SPRINT content ~%MATCH0%~
      SET token = 0
      INNER_PATCH ~%content%~ BEGIN
        REPLACE_TEXTUALLY ~//.*~ ~~
        REPLACE_EVALUATE ~[^ %TAB%%LNL%%MNL%]+~ BEGIN
          SPRINT $cbr_t_line(~%line%~ ~%token%~) ~%MATCH0%~
          SET token += 1
        END ~%MATCH0%~
      END
      PATCH_IF token > 0 BEGIN SET $cbr_t_width(~%line%~) = token SET line += 1 END
    END ~%MATCH0%~
  END
  SPRINT cbr_t_default ~0~
  PATCH_IF line > 1 BEGIN SPRINT cbr_t_default $cbr_t_line(~1~ ~0~) END
  SET cbr_t_cols = 1 SET cbr_t_rows = 0
  PATCH_IF line > 2 BEGIN
    SET cbr_t_cols = $cbr_t_width(~2~) + 1
    FOR (c = 1; c < cbr_t_cols; ++c) BEGIN
      SET j = c - 1 SPRINT $cbr_t_head(~%c%~) $cbr_t_line(~2~ ~%j%~)
    END
    SET cbr_t_rows = line - 3
    FOR (r = 0; r < cbr_t_rows; ++r) BEGIN
      SET l = r + 3
      PATCH_IF $cbr_t_width(~%l%~) > cbr_t_cols BEGIN
        FOR (c = cbr_t_cols; c < $cbr_t_width(~%l%~); ++c) BEGIN SPRINT $cbr_t_head(~%c%~) ~CBR_COLUMN_%c%~ END
        SET cbr_t_cols = $cbr_t_width(~%l%~)
      END
    END
    FOR (r = 0; r < cbr_t_rows; ++r) BEGIN
      SET l = r + 3
      FOR (c = 0; c < cbr_t_cols; ++c) BEGIN
        SPRINT $cbr_t_cell(~%r%~ ~%c%~) ~%cbr_t_default%~
        PATCH_IF c < $cbr_t_width(~%l%~) BEGIN SPRINT $cbr_t_cell(~%r%~ ~%c%~) $cbr_t_line(~%l%~ ~%c%~) END
      END
    END
  END
END

DEFINE_PATCH_FUNCTION cbr_sp_table_write
BEGIN
  SPRINT output ~2DA V1.0%WNL%%cbr_t_default%%WNL%~
  FOR (c = 1; c < cbr_t_cols; ++c) BEGIN
    SPRINT value $cbr_t_head(~%c%~) SPRINT output ~%output% %value%~
  END
  SPRINT output ~%output%%WNL%~
  FOR (r = 0; r < cbr_t_rows; ++r) BEGIN
    FOR (c = 0; c < cbr_t_cols; ++c) BEGIN
      SPRINT value $cbr_t_cell(~%r%~ ~%c%~) SPRINT output ~%output%%value% ~
    END
    SPRINT output ~%output%%WNL%~
  END
  DELETE_BYTES 0 BUFFER_LENGTH INSERT_BYTES 0 (STRING_LENGTH ~%output%~) WRITE_ASCIIE 0 ~%output%~
END

DEFINE_PATCH_FUNCTION cbr_sp_normalize_2da
  STR_VAR required = ~~
BEGIN
  LPF cbr_sp_table_read RET cbr_t_cols cbr_t_rows cbr_t_default RET_ARRAY cbr_t_head cbr_t_cell END
  SET changed = 0
  // Padding short rows and adding named columns makes subsequent address reads safe.
  COUNT_2DA_COLS width
  COUNT_2DA_ROWS cbr_t_cols complete_rows
  PATCH_IF width != cbr_t_cols OR complete_rows != cbr_t_rows BEGIN SET changed = 1 END
  INNER_PATCH ~%required%~ BEGIN
    REPLACE_EVALUATE ~[^ ]+~ BEGIN
      SPRINT required_name ~%MATCH0%~ SET found = 0
      FOR (c = 1; c < cbr_t_cols; ++c) BEGIN
        SPRINT name $cbr_t_head(~%c%~)
        PATCH_IF ~%name%~ STRING_EQUAL_CASE ~%required_name%~ BEGIN SET found = 1 END
      END
      PATCH_IF NOT found BEGIN
        SET c = cbr_t_cols SPRINT $cbr_t_head(~%c%~) ~%required_name%~
        FOR (r = 0; r < cbr_t_rows; ++r) BEGIN SPRINT $cbr_t_cell(~%r%~ ~%c%~) ~%cbr_t_default%~ END
        SET cbr_t_cols += 1 SET changed = 1
      END
    END ~%MATCH0%~
  END
  PATCH_IF changed BEGIN LPF cbr_sp_table_write END END
END

DEFINE_PATCH_FUNCTION cbr_sp_named_column
  STR_VAR name = ~~ required = ~~
  RET data_column
BEGIN
  LPF cbr_sp_normalize_2da STR_VAR required = EVAL ~%required% %name%~ END
  LPF cbr_sp_table_read RET cbr_t_cols cbr_t_rows cbr_t_default RET_ARRAY cbr_t_head cbr_t_cell END
  SET data_column = 1
  FOR (c = cbr_t_cols - 1; c >= 1; --c) BEGIN
    SPRINT header $cbr_t_head(~%c%~)
    PATCH_IF ~%header%~ STRING_EQUAL_CASE ~%name%~ BEGIN SET data_column = c END
  END
END


