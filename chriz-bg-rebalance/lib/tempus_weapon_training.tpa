// Tempus weapon training owns its prescribed two-pip caps, the longsword
// permission and longsword/crossbow starter pips, and the migration helpers.
// Other kit cells, legacy composite proficiencies, axe grants and other effects
// remain external. Readable spell storage is serialized before adding behavior.

DEFINE_ACTION_FUNCTION cbr_define_tempus_training_resrefs
  RET
    cbr_training_migration
    cbr_training_pip_longsword
    cbr_training_pip_crossbow
BEGIN
  OUTER_SPRINT cbr_training_migration     ~CBRTMG2~
  OUTER_SPRINT cbr_training_pip_longsword ~CBRTMG2L~
  OUTER_SPRINT cbr_training_pip_crossbow  ~CBRTMG2X~
END

DEFINE_PATCH_FUNCTION cbr_wt_transform_weapprof RET changed_cells BEGIN
  LPM cbr_tempus_read_table
  SET changed_cells = 0 SET cbr_wt_kit = (0 - 1) SET cbr_wt_cleric = (0 - 1)
  FOR (cbr_wt_c = 0; cbr_wt_c < cbr_t_cols; ++cbr_wt_c) BEGIN
    SPRINT cbr_wt_label $cbr_t_cell(2 ~%cbr_wt_c%~)
    PATCH_IF ~%cbr_wt_label%~ STRING_EQUAL_CASE ~OHTEMPUS~ BEGIN SET cbr_wt_kit = cbr_wt_c + 1 END
    PATCH_IF ~%cbr_wt_label%~ STRING_EQUAL_CASE ~CLERIC~ BEGIN SET cbr_wt_cleric = cbr_wt_c + 1 END
  END
  PATCH_IF cbr_wt_kit < 0 BEGIN
    SPRINT $cbr_t_cell(2 ~%cbr_t_cols%~) ~OHTEMPUS~ ++cbr_t_cols SET cbr_wt_kit = cbr_t_cols
    FOR (cbr_wt_r = 3; cbr_wt_r < cbr_t_lines; ++cbr_wt_r) BEGIN
      SPRINT $cbr_t_cell(~%cbr_wt_r%~ ~%cbr_wt_kit%~) ~0~
    END
  END
  // The fixed cleric arsenal and the three decided additions always receive
  // their caps, even when old permission/cap cells or whole rows are absent.
  PATCH_FOR_EACH cbr_wt_name IN ~LONGSWORD~ ~AXE~ ~CROSSBOW~ ~WARHAMMER~ ~MACE~ ~FLAILMORNINGSTAR~
    ~QUARTERSTAFF~ ~SLING~ ~CLUB~ ~2HANDED~ ~SWORDANDSHIELD~ ~SINGLEWEAPON~ ~2WEAPON~ BEGIN
    SET cbr_wt_found = 0
    FOR (cbr_wt_r = 3; cbr_wt_r < cbr_t_lines; ++cbr_wt_r) BEGIN
      SPRINT cbr_wt_label $cbr_t_cell(~%cbr_wt_r%~ 0)
      PATCH_IF ~%cbr_wt_label%~ STRING_EQUAL_CASE ~%cbr_wt_name%~ BEGIN
        SET cbr_wt_found = 1
        SPRINT $cbr_t_cell(~%cbr_wt_r%~ ~%cbr_wt_kit%~) ~2~ ++changed_cells
      END
    END
    PATCH_IF NOT cbr_wt_found BEGIN
      SPRINT $cbr_t_cell(~%cbr_t_lines%~ 0) ~%cbr_wt_name%~
      FOR (cbr_wt_c = 1; cbr_wt_c <= cbr_t_cols; ++cbr_wt_c) BEGIN
        SPRINT $cbr_t_cell(~%cbr_t_lines%~ ~%cbr_wt_c%~) ~%cbr_t_default%~
      END
      SPRINT $cbr_t_cell(~%cbr_t_lines%~ ~%cbr_wt_kit%~) ~2~ ++cbr_t_lines ++changed_cells
    END
  END
  // Inherited extra weapon availability remains a feature input: cap every
  // additional weapon granted to the cleric class or kit. Legacy BG1 groups
  // and EXTRA placeholders are outside this component's owned fields.
  FOR (cbr_wt_r = 3; cbr_wt_r < cbr_t_lines; ++cbr_wt_r) BEGIN
    SPRINT cbr_wt_label $cbr_t_cell(~%cbr_wt_r%~ 0) TO_UPPER cbr_wt_label
    SET cbr_wt_allowed = 0
    PATCH_IF cbr_wt_cleric >= 0 BEGIN
      SPRINT cbr_wt_value $cbr_t_cell(~%cbr_wt_r%~ ~%cbr_wt_cleric%~)
      PATCH_IF IS_AN_INT ~%cbr_wt_value%~ BEGIN SET cbr_wt_allowed = (cbr_wt_value > 0) END
    END
    SPRINT cbr_wt_value $cbr_t_cell(~%cbr_wt_r%~ ~%cbr_wt_kit%~)
    PATCH_IF IS_AN_INT ~%cbr_wt_value%~ BEGIN SET cbr_wt_allowed = cbr_wt_allowed OR (cbr_wt_value > 0) END
    PATCH_IF cbr_wt_allowed AND (~%cbr_wt_label%~ STRING_MATCHES_REGEXP ~.*_BG1~) != 0
      AND (~%cbr_wt_label%~ STRING_MATCHES_REGEXP ~EXTRA.*~) != 0 BEGIN
      SPRINT $cbr_t_cell(~%cbr_wt_r%~ ~%cbr_wt_kit%~) ~2~
    END
  END
  // Every occurrence of the owned column receives the same decided values.
  FOR (cbr_wt_c = 0; cbr_wt_c < cbr_t_cols; ++cbr_wt_c) BEGIN
    SPRINT cbr_wt_label $cbr_t_cell(2 ~%cbr_wt_c%~)
    PATCH_IF ~%cbr_wt_label%~ STRING_EQUAL_CASE ~OHTEMPUS~ BEGIN
      SET cbr_wt_dest = cbr_wt_c + 1
      FOR (cbr_wt_r = 3; cbr_wt_r < cbr_t_lines; ++cbr_wt_r) BEGIN
        SPRINT $cbr_t_cell(~%cbr_wt_r%~ ~%cbr_wt_dest%~) $cbr_t_cell(~%cbr_wt_r%~ ~%cbr_wt_kit%~)
      END
    END
  END
  LPM cbr_tempus_write_table
END

DEFINE_PATCH_FUNCTION cbr_wt_owned_effect INT_VAR at = 0 RET owned BEGIN
  READ_SHORT at cbr_wt_op READ_LONG (at + 8) cbr_wt_p2 READ_ASCII (at + 0x14) cbr_wt_res (8) NULL
  SET owned = ((cbr_wt_op = 233 AND (cbr_wt_p2 = 90 OR cbr_wt_p2 = 103))
    OR (cbr_wt_op = 326 AND (~%cbr_wt_res%~ STRING_EQUAL_CASE ~C0PR#90~)))
END

DEFINE_PATCH_FUNCTION cbr_wt_complete_tempus_grant RET appended_effects BEGIN
  LPF cbr_tempus_repack_spl INT_VAR default_target = 1 END
  READ_LONG 0x64 cbr_wt_ab READ_SHORT 0x68 cbr_wt_na READ_LONG 0x6a cbr_wt_fx
  READ_SHORT 0x70 cbr_wt_cast
  SET cbr_wt_total = 0 SET appended_effects = 0
  FOR (cbr_wt_a = (0 - 1); cbr_wt_a < cbr_wt_na; ++cbr_wt_a) BEGIN
    SET cbr_wt_first = 0 SET cbr_wt_n = cbr_wt_cast
    PATCH_IF cbr_wt_a >= 0 BEGIN
      READ_SHORT (cbr_wt_ab + cbr_wt_a * 0x28 + 0x1e) cbr_wt_n
      READ_SHORT (cbr_wt_ab + cbr_wt_a * 0x28 + 0x20) cbr_wt_first
    END
    SET $cbr_wt_first(~%cbr_wt_a%~) = cbr_wt_total
    FOR (cbr_wt_i = 0; cbr_wt_i < cbr_wt_n; ++cbr_wt_i) BEGIN
      SET cbr_wt_at = cbr_wt_fx + (cbr_wt_first + cbr_wt_i) * 0x30
      LPF cbr_wt_owned_effect INT_VAR at = cbr_wt_at RET owned END
      PATCH_IF NOT owned BEGIN
        LPF cbr_append_raw_spl_effect_record INT_VAR source_offset = cbr_wt_at END
        ++cbr_wt_total
      END
    END
    PATCH_IF cbr_wt_a >= 0 BEGIN
      LPF cbr_append_spl_effect_record INT_VAR opcode = 326 target = 1 STR_VAR resource = ~C0PR#90~ END
      PATCH_FOR_EACH cbr_wt_prof IN ~90~ ~103~ BEGIN
        SET cbr_wt_prof_n = %cbr_wt_prof%
        LPF cbr_append_spl_effect_record INT_VAR opcode = 233 target = 1 parameter1 = 1 parameter2 = cbr_wt_prof_n timing = 9 END
      END
      SET cbr_wt_total += 3 SET appended_effects += 3
    END
    SET $cbr_wt_count(~%cbr_wt_a%~) = cbr_wt_total - $cbr_wt_first(~%cbr_wt_a%~)
  END
  DELETE_BYTES cbr_wt_fx (BUFFER_LENGTH - cbr_wt_fx - cbr_wt_total * 0x30)
  WRITE_SHORT 0x6e 0 WRITE_SHORT 0x70 $cbr_wt_count(~-1~)
  FOR (cbr_wt_a = 0; cbr_wt_a < cbr_wt_na; ++cbr_wt_a) BEGIN
    WRITE_SHORT (cbr_wt_ab + cbr_wt_a * 0x28 + 0x1e) $cbr_wt_count(~%cbr_wt_a%~)
    WRITE_SHORT (cbr_wt_ab + cbr_wt_a * 0x28 + 0x20) $cbr_wt_first(~%cbr_wt_a%~)
  END
END

DEFINE_ACTION_FUNCTION cbr_wt_create_pip_helper
  INT_VAR
    proficiency = 0
  STR_VAR
    resource_dir = ~~
    helper_resref = ~~
BEGIN
  OUTER_SPRINT resource_dir EVALUATE_BUFFER ~%resource_dir%~
  OUTER_SPRINT helper_resref EVALUATE_BUFFER ~%helper_resref%~
  COPY ~cbr-training-empty~ ~%resource_dir%/%helper_resref%.spl~
    LPF cbr_tempus_blank END
    LPF cbr_add_basic_self_ability END
    // Field-for-field mirror of Artisan's starter pip (opcode 233, one star,
    // timing 9 permanent).
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 233 target = 1 power = 0 parameter1 = 1 parameter2 = proficiency timing = 9
    END
    WRITE_SHORT 0x90 1
END

DEFINE_ACTION_FUNCTION cbr_wt_create_migration_helper
  INT_VAR
    ls_perm_row = "-1"
    ls_pips_row = "-1"
    xbow_pips_row = "-1"
  STR_VAR
    resource_dir = ~~
    migration_resref = ~~
    pip_longsword_resref = ~~
    pip_crossbow_resref = ~~
BEGIN
  OUTER_SPRINT resource_dir EVALUATE_BUFFER ~%resource_dir%~
  OUTER_SPRINT migration_resref EVALUATE_BUFFER ~%migration_resref%~
  OUTER_SPRINT pip_longsword_resref EVALUATE_BUFFER ~%pip_longsword_resref%~
  OUTER_SPRINT pip_crossbow_resref EVALUATE_BUFFER ~%pip_crossbow_resref%~
  ACTION_IF (ls_pips_row < 0 || xbow_pips_row < 0) BEGIN
    FAIL ~CBR cannot create the Tempus migration helper without all three SPLPROT gate rows.~
  END
  COPY ~cbr-training-empty~ ~%resource_dir%/%migration_resref%.spl~
    LPF cbr_tempus_blank END
    LPF cbr_add_basic_self_ability END
    // Gate rows use relation "<=" against 0, so each branch fires exactly
    // when the permission/pips are absent and never again afterwards —
    // recasting the helper is harmless by construction.
    PATCH_IF ls_perm_row >= 0 BEGIN
      LPF cbr_append_spl_effect_record
        INT_VAR opcode = 326 target = 1 parameter2 = ls_perm_row
        STR_VAR resource = ~C0PR#90~ END
    END
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 326 target = 1 power = 0 parameter2 = ls_pips_row timing = 0
      STR_VAR resource = EVAL ~%pip_longsword_resref%~
    END
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 326 target = 1 power = 0 parameter2 = xbow_pips_row timing = 0
      STR_VAR resource = EVAL ~%pip_crossbow_resref%~
    END
    WRITE_SHORT 0x90 (2 + (ls_perm_row >= 0))
END

DEFINE_ACTION_FUNCTION cbr_apply_tempus_weapon_training
  INT_VAR
    // Artisan's custom longsword-permission stat (C0_PROFICIENCYLONGSWORD).
    // The default matches the documented Artisan allocation; the installer
    // wrapper passes the value resolved from the live STATS.IDS instead.
    ls_perm_stat = 204
  STR_VAR
    resource_dir = ~~
BEGIN
  OUTER_SPRINT resource_dir EVALUATE_BUFFER ~%resource_dir%~
  ACTION_IF (~%resource_dir%~ STR_EQ ~~) BEGIN
    FAIL ~CBR Tempus weapon training requires resource_dir.~
  END
  <<<<<<<< cbr-training-empty
>>>>>>>>
  ACTION_IF NOT FILE_EXISTS ~%resource_dir%/WEAPPROF.2DA~ BEGIN
    <<<<<<<< cbr-training-weapprof
2DA V1.0
0
CLERIC OHTEMPUS
>>>>>>>>
    COPY ~cbr-training-weapprof~ ~%resource_dir%/WEAPPROF.2DA~
  END
  ACTION_IF NOT FILE_EXISTS ~%resource_dir%/SPLPROT.2DA~ BEGIN
    <<<<<<<< cbr-training-splprot
2DA V1.0
0
STAT VALUE RELATION
>>>>>>>>
    COPY ~cbr-training-splprot~ ~%resource_dir%/SPLPROT.2DA~
  END
  LAF cbr_define_tempus_training_resrefs
    RET
      cbr_wt_migration = cbr_training_migration
      cbr_wt_pip_ls    = cbr_training_pip_longsword
      cbr_wt_pip_xb    = cbr_training_pip_crossbow
  END

  // Gate rows first: the migration helper embeds the row indices.
  COPY ~%resource_dir%/SPLPROT.2DA~ ~%resource_dir%/SPLPROT.2DA~
    SET cbr_wt_ls_perm_row = (0 - 1)
    PATCH_IF ls_perm_stat > 0 AND ls_perm_stat <= 65535 BEGIN
    LPF cbr_find_or_append_splprot
      INT_VAR stat = ls_perm_stat value = 0 relation = 0
      STR_VAR row_label = ~CBR_TEMPUS_C0LS_LE0~
      RET cbr_wt_ls_perm_row = row_index
    END
    END
    LPF cbr_find_or_append_splprot
      INT_VAR stat = 90 value = 0 relation = 0
      STR_VAR row_label = ~CBR_TEMPUS_PROFLS_LE0~
      RET cbr_wt_ls_pips_row = row_index
    END
    LPF cbr_find_or_append_splprot
      INT_VAR stat = 103 value = 0 relation = 0
      STR_VAR row_label = ~CBR_TEMPUS_PROFXB_LE0~
      RET cbr_wt_xb_pips_row = row_index
    END
  BUT_ONLY

  COPY ~%resource_dir%/WEAPPROF.2DA~ ~%resource_dir%/WEAPPROF.2DA~
    LPF cbr_wt_transform_weapprof RET cbr_wt_changed = changed_cells END
  BUT_ONLY

  ACTION_IF FILE_EXISTS ~%resource_dir%/C0PR#C4.SPL~ BEGIN
    COPY ~%resource_dir%/C0PR#C4.SPL~ ~%resource_dir%/C0PR#C4.SPL~
      LPF cbr_validate_spl_v1 STR_VAR resource_name = ~C0PR#C4.SPL~ RET readable END
      PATCH_IF readable BEGIN LPF cbr_wt_complete_tempus_grant END END
    BUT_ONLY
  END ELSE BEGIN PRINT ~CBR: C0PR#C4.SPL is absent; weapon caps and migration helpers still apply.~ END
  ACTION_IF ls_perm_stat <= 0 OR ls_perm_stat > 65535 BEGIN
    PRINT ~CBR: longsword permission stat is absent; only the migration permission check is omitted.~
  END

  LAF cbr_wt_create_pip_helper
    INT_VAR proficiency = 90
    STR_VAR resource_dir = EVAL ~%resource_dir%~ helper_resref = EVAL ~%cbr_wt_pip_ls%~
  END
  LAF cbr_wt_create_pip_helper
    INT_VAR proficiency = 103
    STR_VAR resource_dir = EVAL ~%resource_dir%~ helper_resref = EVAL ~%cbr_wt_pip_xb%~
  END
  LAF cbr_wt_create_migration_helper
    INT_VAR
      ls_perm_row   = cbr_wt_ls_perm_row
      ls_pips_row   = cbr_wt_ls_pips_row
      xbow_pips_row = cbr_wt_xb_pips_row
    STR_VAR
      resource_dir = EVAL ~%resource_dir%~
      migration_resref = EVAL ~%cbr_wt_migration%~
      pip_longsword_resref = EVAL ~%cbr_wt_pip_ls%~
      pip_crossbow_resref = EVAL ~%cbr_wt_pip_xb%~
  END

END
