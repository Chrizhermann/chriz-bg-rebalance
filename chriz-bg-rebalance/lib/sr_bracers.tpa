// Bracers of Blinding Strike own their Improved Haste activation and CBRBIH.
// The helper copies the installed donor's first header, delivers it only to
// the wearer and grants additive +1 APR for the activation's duration.

// Read slices only to locate data. Shared slices and arbitrary storage order
// are valid. Rebuilding gives every ability its own effect slice.
DEFINE_PATCH_MACRO cbrsb_read
BEGIN
  SET cb_readable = BUFFER_LENGTH >= 0x72
  SET cb_na = 0 SET cb_cn = 0 SPRINT cb_cast ~~
  PATCH_CLEAR_ARRAY cb_headers PATCH_CLEAR_ARRAY cb_effects
  PATCH_IF cb_readable BEGIN
    READ_LONG 0x64 cb_ab READ_SHORT 0x68 cb_na READ_LONG 0x6a cb_fx
    READ_SHORT 0x6e cb_cf READ_SHORT 0x70 cb_cn
    SET cb_readable = cb_ab >= 0x72 AND cb_ab + cb_na * cb_stride <= BUFFER_LENGTH
      AND cb_fx >= 0x72 AND cb_fx + (cb_cf + cb_cn) * 48 <= BUFFER_LENGTH
    FOR (cb_h = 0; cb_readable AND cb_h < cb_na; ++cb_h) BEGIN
      READ_SHORT (cb_ab + cb_h * cb_stride + 0x1e) cb_n
      READ_SHORT (cb_ab + cb_h * cb_stride + 0x20) cb_first
      SET cb_readable = cb_fx + (cb_first + cb_n) * 48 <= BUFFER_LENGTH
    END
    PATCH_IF cb_readable BEGIN
      READ_ASCII (cb_fx + cb_cf * 48) cb_cast (cb_cn * 48)
      FOR (cb_h = 0; cb_h < cb_na; ++cb_h) BEGIN
        READ_ASCII (cb_ab + cb_h * cb_stride) $cb_headers(~%cb_h%~) (cb_stride)
        READ_SHORT (cb_ab + cb_h * cb_stride + 0x1e) cb_n
        READ_SHORT (cb_ab + cb_h * cb_stride + 0x20) cb_first
        READ_ASCII (cb_fx + cb_first * 48) $cb_effects(~%cb_h%~) (cb_n * 48)
      END
    END
  END
END

DEFINE_PATCH_MACRO cbrsb_ensure_ability
BEGIN
  PATCH_IF cb_na = 0 BEGIN
    SET cb_na = 1
    INNER_PATCH_SAVE $cb_headers(~0~) ~~ BEGIN
      INSERT_BYTES 0 cb_stride
      WRITE_BYTE 0 (cb_stride = 56 ? 3 : 1)
      WRITE_BYTE 12 5 WRITE_BYTE 13 1
      PATCH_IF cb_stride = 56 BEGIN WRITE_SHORT 34 1 WRITE_LONG 38 2048 END
      ELSE BEGIN WRITE_SHORT 38 1 END
    END
    SPRINT $cb_effects(~0~) ~~
  END
END

DEFINE_PATCH_MACRO cbrsb_write
BEGIN
  DELETE_BYTES 0x72 (BUFFER_LENGTH - 0x72)
  INSERT_BYTES 0x72 (cb_na * cb_stride)
  SET cb_fx = BUFFER_LENGTH
  INSERT_BYTES cb_fx (cb_cn * 48)
  WRITE_ASCIIE cb_fx ~%cb_cast%~ (cb_cn * 48)
  WRITE_LONG 0x64 0x72 WRITE_SHORT 0x68 cb_na
  WRITE_LONG 0x6a cb_fx WRITE_SHORT 0x6e 0 WRITE_SHORT 0x70 cb_cn
  SET cb_next = cb_cn
  FOR (cb_h = 0; cb_h < cb_na; ++cb_h) BEGIN
    SPRINT cb_raw $cb_headers(~%cb_h%~)
    SET cb_at = 0x72 + cb_h * cb_stride
    WRITE_ASCIIE cb_at ~%cb_raw%~ (cb_stride)
    SPRINT cb_raw $cb_effects(~%cb_h%~)
    INNER_PATCH ~%cb_raw%~ BEGIN SET cb_length = BUFFER_LENGTH END
    WRITE_SHORT (cb_at + 30) (cb_length / 48) WRITE_SHORT (cb_at + 32) cb_next
    SET cb_next += cb_length / 48
    SET cb_at = BUFFER_LENGTH INSERT_BYTES cb_at cb_length
    WRITE_ASCIIE cb_at ~%cb_raw%~ (cb_length)
  END
END

// A private guard replaces all earlier CBRBIH guards. Existing spell payloads
// stay intact; put our guard before the spell's own protection, which otherwise
// prevents later effects from taking effect (verified by the existing lab).
DEFINE_PATCH_FUNCTION cbrsb_alias
  INT_VAR apply = 0
  RET is_alias
BEGIN
  SET cb_stride = 40 LPM cbrsb_read
  SET is_alias = 0
  PATCH_IF cb_readable BEGIN
    SET cb_known = ~%SOURCE_RES%~ STRING_EQUAL_CASE ~%cbrsb_ih%~
      OR ~%SOURCE_RES%~ STRING_EQUAL_CASE ~%cbrsb_haste%~
    PATCH_IF cb_known AND apply BEGIN LPM cbrsb_ensure_ability END
    FOR (cb_a = 0; cb_a < cb_na; ++cb_a) BEGIN
      SPRINT cb_old $cb_effects(~%cb_a%~)
      SET cb_haste = 0 SET cb_native = 0 SET cb_ih_guard = 0 SET cb_guard_found = 0
      SET cb_duration = 60
      INNER_PATCH_SAVE cb_guard ~~ BEGIN
        INSERT_BYTES 0 48 WRITE_BYTE 2 2 WRITE_BYTE 3 6 WRITE_BYTE 13 3
      END
      INNER_PATCH ~%cb_old%~ BEGIN
        FOR (cb_at = 0; cb_at < BUFFER_LENGTH; cb_at += 48) BEGIN
          READ_SHORT cb_at cb_op READ_ASCII (cb_at + 20) cb_res (8) NULL
          PATCH_IF cb_op = 1 OR cb_op = 16 OR cb_op = 317 BEGIN
            SET cb_haste = 1
            READ_LONG (cb_at + 14) cb_duration
            PATCH_IF cb_op != 1 BEGIN SET cb_native = 1 END
          END
          PATCH_IF cb_op = 206 BEGIN
            PATCH_IF ~%cb_res%~ STRING_EQUAL_CASE ~%cbrsb_ih%~ BEGIN SET cb_ih_guard = 1 END
            PATCH_IF ~%cb_res%~ STRING_EQUAL_CASE ~%cbrsb_ih%~
              OR ~%cb_res%~ STRING_EQUAL_CASE ~%cbrsb_haste%~ BEGIN
              READ_ASCII cb_at cb_guard (48) SET cb_guard_found = 1
            END
          END
        END
      END
      SET cb_qualifies = cb_known OR (cb_haste AND cb_guard_found AND (cb_native OR cb_ih_guard))
      PATCH_IF cb_qualifies BEGIN
        SET is_alias = 1
        PATCH_IF apply BEGIN
          INNER_PATCH_SAVE cb_guard ~%cb_guard%~ BEGIN
            PATCH_IF cb_guard_found BEGIN READ_LONG 14 cb_duration END
            WRITE_SHORT 0 206 WRITE_LONG 4 0 WRITE_LONG 8 0 WRITE_BYTE 12 0
            WRITE_LONG 14 (cb_duration > 0 ? cb_duration : 60)
            WRITE_BYTE 18 100 WRITE_BYTE 19 0 WRITE_LONG 36 0 WRITE_LONG 40 0
            WRITE_ASCII 20 ~CBRBIH~ #8
          END
          SPRINT cb_out ~~ SET cb_inserted = 0
          INNER_PATCH ~%cb_old%~ BEGIN SET cb_n = BUFFER_LENGTH / 48 END
          FOR (cb_k = 0; cb_k < cb_n; ++cb_k) BEGIN
            INNER_PATCH ~%cb_old%~ BEGIN
              SET cb_at = cb_k * 48
              READ_SHORT cb_at cb_op READ_ASCII (cb_at + 20) cb_res (8) NULL
              READ_ASCII cb_at cb_record (48)
            END
            PATCH_IF NOT cb_inserted AND cb_op = 206
              AND ~%cb_res%~ STRING_EQUAL_CASE ~%SOURCE_RES%~ BEGIN
              INNER_PATCH_SAVE cb_out ~%cb_out%~ BEGIN
                SET cb_at = BUFFER_LENGTH INSERT_BYTES cb_at 48 WRITE_ASCIIE cb_at ~%cb_guard%~ (48)
              END
              SET cb_inserted = 1
            END
            PATCH_IF NOT (cb_op = 206 AND ~%cb_res%~ STRING_EQUAL_CASE ~CBRBIH~) BEGIN
              INNER_PATCH_SAVE cb_out ~%cb_out%~ BEGIN
                SET cb_at = BUFFER_LENGTH INSERT_BYTES cb_at 48 WRITE_ASCIIE cb_at ~%cb_record%~ (48)
              END
            END
          END
          PATCH_IF NOT cb_inserted BEGIN
            INNER_PATCH_SAVE cb_out ~%cb_out%~ BEGIN
              SET cb_at = BUFFER_LENGTH INSERT_BYTES cb_at 48 WRITE_ASCIIE cb_at ~%cb_guard%~ (48)
            END
          END
          SPRINT $cb_effects(~%cb_a%~) ~%cb_out%~
        END
      END
    END
    PATCH_IF apply AND is_alias BEGIN LPM cbrsb_write END
  END ELSE PATCH_IF apply BEGIN
    PATCH_PRINT ~SR bracers: %SOURCE_FILE% has unreadable tables; leaving this file unchanged.~
  END
END

DEFINE_PATCH_FUNCTION cbrsb_build_helper
  INT_VAR duration = 20
  STR_VAR donor = ~~
  RET cb_readable
BEGIN
  SET cb_stride = 40 LPM cbrsb_read
  PATCH_IF cb_readable BEGIN
    LPM cbrsb_ensure_ability
    // A fixed-duration item uses the first donor header. Other level headers
    // are never a compatibility fingerprint for this private copy.
    SPRINT cb_old $cb_effects(~0~)
    SET cb_spell_duration = 60 SET cb_apr_found = 0
    INNER_PATCH_SAVE cb_apr ~~ BEGIN
      INSERT_BYTES 0 48 WRITE_BYTE 3 6 WRITE_BYTE 13 3 WRITE_BYTE 18 100
    END
    INNER_PATCH ~%cb_old%~ BEGIN
      FOR (cb_at = 0; cb_at < BUFFER_LENGTH; cb_at += 48) BEGIN
        READ_SHORT cb_at cb_op
        PATCH_IF NOT cb_apr_found AND (cb_op = 1 OR cb_op = 16 OR cb_op = 317) BEGIN
          READ_ASCII cb_at cb_apr (48) READ_LONG (cb_at + 14) cb_spell_duration
          SET cb_apr_found = 1
        END
      END
    END
    INNER_PATCH_SAVE cb_apr ~%cb_apr%~ BEGIN
      WRITE_SHORT 0 1 WRITE_BYTE 2 1 WRITE_LONG 4 1 WRITE_LONG 8 0
      WRITE_BYTE 12 0 WRITE_LONG 14 duration
    END
    SPRINT cb_out ~~ SET cb_apr_written = 0
    PATCH_CLEAR_ARRAY cb_guards
    INNER_PATCH ~%cb_old%~ BEGIN SET cb_n = BUFFER_LENGTH / 48 END
    FOR (cb_k = 0; cb_k <= cb_n; ++cb_k) BEGIN
      SET cb_op = 0 - 1 SPRINT cb_res ~~
      PATCH_IF cb_k < cb_n BEGIN
        INNER_PATCH ~%cb_old%~ BEGIN
          SET cb_at = cb_k * 48
          READ_SHORT cb_at cb_op READ_ASCII (cb_at + 20) cb_res (8) NULL
          READ_ASCII cb_at cb_record (48)
        END
      END
      SET cb_is_apr = cb_op = 1 OR cb_op = 16 OR cb_op = 317
      PATCH_IF NOT cb_apr_written AND (cb_is_apr OR cb_k = cb_n) BEGIN
        INNER_PATCH_SAVE cb_out ~%cb_out%~ BEGIN
          SET cb_at = BUFFER_LENGTH INSERT_BYTES cb_at 48 WRITE_ASCIIE cb_at ~%cb_apr%~ (48)
        END
        SET cb_apr_written = 1
      END
      PATCH_IF cb_k < cb_n AND NOT cb_is_apr
        AND NOT (cb_op = 206 AND ~%cb_res%~ STRING_EQUAL_CASE ~CBRBIH~) BEGIN
        INNER_PATCH_SAVE cb_record ~%cb_record%~ BEGIN
          READ_BYTE 2 cb_target READ_BYTE 12 cb_timing READ_LONG 14 cb_duration
          PATCH_IF cb_target > 1 BEGIN WRITE_BYTE 2 1 END
          PATCH_IF (cb_timing = 0 OR cb_timing = 4) AND cb_duration = cb_spell_duration BEGIN WRITE_LONG 14 duration END
          PATCH_IF cb_op = 321 AND ~%cb_res%~ STRING_EQUAL_CASE ~%donor%~ BEGIN WRITE_ASCII 20 ~CBRBIH~ #8 END
        END
        SET cb_keep = 1
        PATCH_IF cb_op = 206 BEGIN
          SPRINT cb_key ~%cb_res%~ TO_UPPER cb_key
          PATCH_IF VARIABLE_IS_SET $cbrsb_aliases(~%cb_key%~) BEGIN
            SET cb_keep = NOT VARIABLE_IS_SET $cb_guards(~%cb_key%~)
            INNER_PATCH_SAVE cb_record ~%cb_record%~ BEGIN
              WRITE_BYTE 2 1 WRITE_LONG 4 0 WRITE_LONG 8 0 WRITE_BYTE 12 0
              WRITE_LONG 14 duration WRITE_BYTE 18 100 WRITE_BYTE 19 0
              WRITE_LONG 36 0 WRITE_LONG 40 0
            END
          END
          SET $cb_guards(~%cb_key%~) = 1
        END
        PATCH_IF cb_keep BEGIN
          INNER_PATCH_SAVE cb_out ~%cb_out%~ BEGIN
            SET cb_at = BUFFER_LENGTH INSERT_BYTES cb_at 48 WRITE_ASCIIE cb_at ~%cb_record%~ (48)
          END
        END
      END
    END
    // All aliases get a guard, with our own protection last.
    PATCH_PHP_EACH cbrsb_aliases AS cb_alias => cb_unused BEGIN
      PATCH_IF NOT (~%cb_alias%~ STRING_EQUAL_CASE ~CBRBIH~)
        AND NOT VARIABLE_IS_SET $cb_guards(~%cb_alias%~) BEGIN
        INNER_PATCH_SAVE cb_out ~%cb_out%~ BEGIN
          SET cb_at = BUFFER_LENGTH INSERT_BYTES cb_at 48
          WRITE_SHORT cb_at 206 WRITE_BYTE (cb_at + 2) 1 WRITE_BYTE (cb_at + 3) 6
          WRITE_BYTE (cb_at + 13) 3 WRITE_LONG (cb_at + 14) duration WRITE_BYTE (cb_at + 18) 100
          WRITE_ASCIIE (cb_at + 20) ~%cb_alias%~ #8
        END
      END
    END
    INNER_PATCH_SAVE cb_out ~%cb_out%~ BEGIN
      SET cb_at = BUFFER_LENGTH INSERT_BYTES cb_at 48
      WRITE_SHORT cb_at 206 WRITE_BYTE (cb_at + 2) 1 WRITE_BYTE (cb_at + 3) 6
      WRITE_BYTE (cb_at + 13) 3 WRITE_LONG (cb_at + 14) duration WRITE_BYTE (cb_at + 18) 100
      WRITE_ASCII (cb_at + 20) ~CBRBIH~ #8
    END
    SPRINT $cb_effects(~0~) ~%cb_out%~
    SPRINT cb_raw $cb_headers(~0~)
    INNER_PATCH_SAVE $cb_headers(~0~) ~%cb_raw%~ BEGIN
      WRITE_BYTE 12 5 WRITE_BYTE 13 1 WRITE_SHORT 14 0 WRITE_SHORT 16 0
      WRITE_SHORT 18 0 WRITE_SHORT 38 1
    END
    SET cb_na = 1 LPM cbrsb_write
  END ELSE BEGIN
    PATCH_PRINT ~SR bracers: %SOURCE_FILE% has unreadable tables; leaving this file unchanged.~
  END
END

DEFINE_PATCH_FUNCTION cbrsb_scan_item
  RET haste_duration carriers transformed cb_readable
BEGIN
  SET cb_stride = 56 LPM cbrsb_read
  SET haste_duration = 20 SET carriers = 0 SET transformed = 0
  PATCH_IF cb_readable BEGIN
    FOR (cb_a = 0; cb_a < cb_na; ++cb_a) BEGIN
      SPRINT cb_old $cb_effects(~%cb_a%~)
      INNER_PATCH ~%cb_old%~ BEGIN
        FOR (cb_at = 0; cb_at < BUFFER_LENGTH; cb_at += 48) BEGIN
          READ_SHORT cb_at cb_op READ_ASCII (cb_at + 20) cb_res (8) NULL
          PATCH_IF (cb_op = 16 OR cb_op = 317) AND NOT carriers BEGIN
            READ_LONG (cb_at + 14) cb_duration
            SET haste_duration = (cb_duration > 0 ? cb_duration : 20) SET carriers = 1
          END
          PATCH_IF cb_op = 146 AND ~%cb_res%~ STRING_EQUAL_CASE ~CBRBIH~ BEGIN SET transformed = 1 END
        END
      END
    END
  END
END

DEFINE_PATCH_FUNCTION cbrsb_helper_duration RET duration BEGIN
  SET duration = 20 SET cb_stride = 40 LPM cbrsb_read
  PATCH_IF cb_readable AND cb_na > 0 BEGIN
    SPRINT cb_old $cb_effects(~0~)
    INNER_PATCH ~%cb_old%~ BEGIN
      SET cb_found = 0
      FOR (cb_at = 0; cb_at < BUFFER_LENGTH; cb_at += 48) BEGIN
        READ_SHORT cb_at cb_op
        PATCH_IF cb_op = 1 AND NOT cb_found BEGIN
          READ_LONG (cb_at + 14) cb_duration
          SET duration = (cb_duration > 0 ? cb_duration : 20) SET cb_found = 1
        END
      END
    END
  END
END

DEFINE_PATCH_FUNCTION cbrsb_patch_item
  INT_VAR duration = 20
  RET cb_readable
BEGIN
  SET cb_stride = 56 LPM cbrsb_read
  PATCH_IF cb_readable BEGIN
    LPM cbrsb_ensure_ability
    SET cb_any_activation = 0
    FOR (cb_a = 0; cb_a < cb_na; ++cb_a) BEGIN
      SPRINT cb_old $cb_effects(~%cb_a%~)
      INNER_PATCH ~%cb_old%~ BEGIN
        FOR (cb_at = 0; cb_at < BUFFER_LENGTH; cb_at += 48) BEGIN
          READ_SHORT cb_at cb_op READ_ASCII (cb_at + 20) cb_res (8) NULL
          PATCH_IF cb_op = 16 OR cb_op = 317
            OR (cb_op = 146 AND ~%cb_res%~ STRING_EQUAL_CASE ~CBRBIH~) BEGIN
            SET cb_any_activation = 1
          END
        END
      END
    END
    FOR (cb_a = 0; cb_a < cb_na; ++cb_a) BEGIN
      SPRINT cb_old $cb_effects(~%cb_a%~)
      SET cb_activation = cb_a = 0 AND NOT cb_any_activation SET cb_have_call = 0
      INNER_PATCH_SAVE cb_call ~~ BEGIN
        INSERT_BYTES 0 48 WRITE_BYTE 3 3 WRITE_BYTE 18 100
      END
      INNER_PATCH ~%cb_old%~ BEGIN
        FOR (cb_at = 0; cb_at < BUFFER_LENGTH; cb_at += 48) BEGIN
          READ_SHORT cb_at cb_op READ_ASCII (cb_at + 20) cb_res (8) NULL
          PATCH_IF cb_op = 16 OR cb_op = 317
            OR (cb_op = 146 AND ~%cb_res%~ STRING_EQUAL_CASE ~CBRBIH~) BEGIN
            SET cb_activation = 1
            PATCH_IF NOT cb_have_call BEGIN READ_ASCII cb_at cb_call (48) SET cb_have_call = 1 END
          END
        END
      END
      PATCH_IF cb_activation BEGIN
        INNER_PATCH_SAVE cb_call ~%cb_call%~ BEGIN
          READ_BYTE 3 cb_power READ_BYTE 18 cb_p1 READ_BYTE 19 cb_p2
          READ_LONG 36 cb_save READ_LONG 40 cb_bonus
          FOR (cb_at = 0; cb_at < 48; cb_at += 4) BEGIN WRITE_LONG cb_at 0 END
          WRITE_SHORT 0 146 WRITE_BYTE 2 1 WRITE_BYTE 3 cb_power WRITE_LONG 8 1
          WRITE_BYTE 12 1 WRITE_BYTE 13 3 WRITE_BYTE 18 cb_p1 WRITE_BYTE 19 cb_p2
          WRITE_ASCII 20 ~CBRBIH~ #8 WRITE_LONG 36 cb_save WRITE_LONG 40 cb_bonus
        END
        SPRINT cb_out ~~ SET cb_written = 0
        INNER_PATCH ~%cb_old%~ BEGIN SET cb_n = BUFFER_LENGTH / 48 END
        FOR (cb_k = 0; cb_k <= cb_n; ++cb_k) BEGIN
          SET cb_op = 0 - 1 SPRINT cb_res ~~
          PATCH_IF cb_k < cb_n BEGIN
            INNER_PATCH ~%cb_old%~ BEGIN
              SET cb_at = cb_k * 48
              READ_SHORT cb_at cb_op READ_ASCII (cb_at + 20) cb_res (8) NULL
              READ_ASCII cb_at cb_record (48)
            END
          END
          SET cb_replace = cb_op = 16 OR cb_op = 317
            OR (cb_op = 146 AND ~%cb_res%~ STRING_EQUAL_CASE ~CBRBIH~)
          PATCH_IF NOT cb_written AND (cb_replace OR cb_k = cb_n) BEGIN
            INNER_PATCH_SAVE cb_out ~%cb_out%~ BEGIN
              SET cb_at = BUFFER_LENGTH INSERT_BYTES cb_at 48 WRITE_ASCIIE cb_at ~%cb_call%~ (48)
            END
            SET cb_written = 1
          END
          // The activation's old haste presentation belongs to the replaced
          // behavior. Other mechanics and all equipped effects stay intact.
          SET cb_presentation = cb_op = 61 OR cb_op = 139 OR cb_op = 141
            OR cb_op = 142 OR cb_op = 174 OR cb_op = 221
          PATCH_IF cb_k < cb_n AND NOT cb_replace AND NOT cb_presentation BEGIN
            INNER_PATCH_SAVE cb_out ~%cb_out%~ BEGIN
              SET cb_at = BUFFER_LENGTH INSERT_BYTES cb_at 48 WRITE_ASCIIE cb_at ~%cb_record%~ (48)
            END
          END
        END
        SPRINT $cb_effects(~%cb_a%~) ~%cb_out%~
        SPRINT cb_raw $cb_headers(~%cb_a%~)
        INNER_PATCH_SAVE $cb_headers(~%cb_a%~) ~%cb_raw%~ BEGIN WRITE_BYTE 12 5 END
      END
    END
    LPM cbrsb_write
  END ELSE BEGIN
    PATCH_PRINT ~SR bracers: BRAC16.ITM has unreadable tables; leaving this file unchanged.~
  END
END

DEFINE_ACTION_FUNCTION cbr_apply_sr_bracers
BEGIN
  OUTER_SET ih_id = 0 - 1 OUTER_SET haste_id = 0 - 1
  ACTION_IF FILE_EXISTS_IN_GAME ~SPELL.IDS~ BEGIN
    OUTER_SET ih_id = IDS_OF_SYMBOL (~spell~ ~WIZARD_IMPROVED_HASTE~)
    OUTER_SET haste_id = IDS_OF_SYMBOL (~spell~ ~WIZARD_HASTE~)
  END
  OUTER_SET n = ih_id - 2000 OUTER_SPRINT cbrsb_ih ~SPWI%n%~
  ACTION_IF n >= 0 AND n < 100 BEGIN OUTER_SPRINT cbrsb_ih ~SPWI0%n%~ END
  ACTION_IF n >= 0 AND n < 10 BEGIN OUTER_SPRINT cbrsb_ih ~SPWI00%n%~ END
  OUTER_SET n = haste_id - 2000 OUTER_SPRINT cbrsb_haste ~SPWI%n%~
  ACTION_IF n >= 0 AND n < 100 BEGIN OUTER_SPRINT cbrsb_haste ~SPWI0%n%~ END
  ACTION_IF n >= 0 AND n < 10 BEGIN OUTER_SPRINT cbrsb_haste ~SPWI00%n%~ END
  ACTION_IF FILE_EXISTS_IN_GAME ~BRAC16.ITM~ AND FILE_EXISTS_IN_GAME ~%cbrsb_ih%.SPL~ BEGIN
    ACTION_CLEAR_ARRAY cbrsb_aliases
    OUTER_SET $cbrsb_aliases(~%cbrsb_ih%~) = 1
    ACTION_IF FILE_EXISTS_IN_GAME ~%cbrsb_haste%.SPL~ BEGIN OUTER_SET $cbrsb_aliases(~%cbrsb_haste%~) = 1 END
    COPY_EXISTING_REGEXP GLOB ~^.+\.spl$~ ~override~
      PATCH_IF NOT (~%SOURCE_RES%~ STRING_EQUAL_CASE ~CBRBIH~) BEGIN
        LPF cbrsb_alias RET is_alias END
        PATCH_IF is_alias BEGIN
          SPRINT cb_key ~%SOURCE_RES%~ TO_UPPER cb_key SET $cbrsb_aliases(~%cb_key%~) = 1
        END
      END
    BUT_ONLY
    COPY_EXISTING - ~BRAC16.ITM~ ~override~
      LPF cbrsb_scan_item RET cbrsb_duration = haste_duration cb_transformed = transformed cb_readable END
    ACTION_IF cb_readable BEGIN
      ACTION_IF cb_transformed AND FILE_EXISTS_IN_GAME ~CBRBIH.SPL~ BEGIN
        COPY_EXISTING - ~CBRBIH.SPL~ ~override~
          LPF cbrsb_helper_duration RET cbrsb_duration = duration END
      END
      COPY_EXISTING - ~%cbrsb_ih%.SPL~ ~override~
        LPF cbrsb_build_helper INT_VAR duration = cbrsb_duration STR_VAR donor = EVAL ~%cbrsb_ih%~ RET cb_readable END
        SET cb_helper_length = BUFFER_LENGTH READ_ASCII 0 cb_helper (BUFFER_LENGTH)
      ACTION_IF cb_readable BEGIN
        COPY_EXISTING ~%cbrsb_ih%.SPL~ ~override/CBRBIH.SPL~
          DELETE_BYTES 0 BUFFER_LENGTH INSERT_BYTES 0 cb_helper_length
          WRITE_ASCIIE 0 ~%cb_helper%~ (cb_helper_length)
        BUT_ONLY
        ACTION_PHP_EACH cbrsb_aliases AS cb_alias => cb_unused BEGIN
          COPY_EXISTING ~%cb_alias%.SPL~ ~override~ LPF cbrsb_alias INT_VAR apply = 1 END BUT_ONLY
        END
        // Complete English description, from the original supported item.
        // The source template is ours; no installed sentence is inspected.
        OUTER_SPRINT cb_description ~Knight Wesic of the Most Noble Order of the Radiant Heart often said, "Attack swiftly and your enemy will be so overwhelmed that the battle will be yours." He lived this principle through these bracers. Before engaging in righteous battle, he would unlock the magic of the Blinding Strike and quickly rush at his enemy. More often than not, his opponent would fall within the first few seconds of battle.

STATISTICS:

Charge abilities:
– Improved Haste once per day
  Duration: %cbrsb_duration% seconds
  Area of Effect: The user

Weight: 2~
        COPY_EXISTING ~BRAC16.ITM~ ~override~
          LPF cbrsb_patch_item INT_VAR duration = cbrsb_duration END
          PATCH_IF ~%EE_LANGUAGE%~ STRING_EQUAL_CASE ~en_us~ BEGIN
            SAY IDENTIFIED_DESC ~%cb_description%~
          END ELSE BEGIN
            PATCH_PRINT ~SR bracers: no translation for this language; retaining the item text.~
          END
        BUT_ONLY
        PRINT ~Bracers now use a self-only copy of Spell Revisions Improved Haste for %cbrsb_duration% seconds.~
      END
    END ELSE BEGIN
      PRINT ~SR bracers: BRAC16.ITM has unreadable tables; leaving this file unchanged.~
    END
  END ELSE BEGIN
    PRINT ~SR bracers: BRAC16.ITM or the resolved Improved Haste resource is absent; continuing.~
  END
END
