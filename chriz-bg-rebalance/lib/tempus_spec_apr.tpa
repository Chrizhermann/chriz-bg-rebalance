// chriz-bg-rebalance — Cleric of Tempus specialization APR (component 406).
//
// CLSWPBON.2DA's GETS_PROF_APR column drives the engine's warrior-style
// extra half-attack from weapon specialization. The table carries both class
// and kit rows, but live testing (2026-07-17, BG2:EE 2.6.6/EET: Battleguard
// with an equipped 2-pip flail, OHTEMPUS row = 1 in the loaded table, APR
// stat 8 still exactly 1) shows the engine consults the CLASS row only — the
// kit rows are decorative for this mechanic. So this component flips BOTH:
//   * OHTEMPUS (kit) — correct data, future-proof, and appended
//     cleric-shaped (`1 0 3`) when a game ships without the row;
//   * CLERIC (class) — the operative cell on current engines.
//
// Scope of the class flip: specialization APR only materializes for
// characters who can reach 2+ pips, and pure clerics cap at 1 everywhere
// except kit columns a mod raised. On the reference install a full
// KITLIST×WEAPPROF scan found exactly one pure-cleric kit with any cap >= 2:
// OHTEMPUS itself. Fresh-install scope scan is a tracked follow-up.
//
// Own GETS_PROF_APR in both named rows. Existing cells in other columns stay.
// Missing rows use the existing cleric definition (1, 0, 3 by column name).
DEFINE_PATCH_FUNCTION cbr_sa_transform_clswpbon STR_VAR row_label = ~~ BEGIN
  LPM cbr_tempus_read_table
  SET cbr_sa_found_col = 0
  FOR (cbr_sa_c = 0; cbr_sa_c < cbr_t_cols; ++cbr_sa_c) BEGIN
    SPRINT cbr_sa_column $cbr_t_cell(2 ~%cbr_sa_c%~)
    PATCH_IF ~%cbr_sa_column%~ STRING_EQUAL_CASE ~GETS_PROF_APR~ BEGIN SET cbr_sa_found_col = 1 END
  END
  PATCH_IF NOT cbr_sa_found_col BEGIN
    SPRINT $cbr_t_cell(2 ~%cbr_t_cols%~) ~GETS_PROF_APR~ ++cbr_t_cols
    FOR (cbr_sa_r = 3; cbr_sa_r < cbr_t_lines; ++cbr_sa_r) BEGIN
      SPRINT $cbr_t_cell(~%cbr_sa_r%~ ~%cbr_t_cols%~) ~%cbr_t_default%~
    END
  END
  SET cbr_sa_found_row = 0
  FOR (cbr_sa_r = 3; cbr_sa_r < cbr_t_lines; ++cbr_sa_r) BEGIN
    SPRINT cbr_sa_name $cbr_t_cell(~%cbr_sa_r%~ 0)
    PATCH_IF ~%cbr_sa_name%~ STRING_EQUAL_CASE ~%row_label%~ BEGIN SET cbr_sa_found_row = 1 END
  END
  PATCH_IF NOT cbr_sa_found_row BEGIN
    SPRINT $cbr_t_cell(~%cbr_t_lines%~ 0) ~%row_label%~
    FOR (cbr_sa_c = 0; cbr_sa_c < cbr_t_cols; ++cbr_sa_c) BEGIN
      SPRINT cbr_sa_column $cbr_t_cell(2 ~%cbr_sa_c%~)
      SPRINT cbr_sa_value ~%cbr_t_default%~
      PATCH_IF ~%cbr_sa_column%~ STRING_EQUAL_CASE ~UNARMED_DIVISOR~ BEGIN SPRINT cbr_sa_value ~0~ END
      PATCH_IF ~%cbr_sa_column%~ STRING_EQUAL_CASE ~ZERO_SKILL_THAC0~ BEGIN SPRINT cbr_sa_value ~3~ END
      SET cbr_sa_col = cbr_sa_c + 1 SPRINT $cbr_t_cell(~%cbr_t_lines%~ ~%cbr_sa_col%~) ~%cbr_sa_value%~
    END
    ++cbr_t_lines
  END
  FOR (cbr_sa_r = 3; cbr_sa_r < cbr_t_lines; ++cbr_sa_r) BEGIN
    SPRINT cbr_sa_name $cbr_t_cell(~%cbr_sa_r%~ 0)
    PATCH_IF ~%cbr_sa_name%~ STRING_EQUAL_CASE ~%row_label%~ BEGIN
      FOR (cbr_sa_c = 0; cbr_sa_c < cbr_t_cols; ++cbr_sa_c) BEGIN
        SPRINT cbr_sa_column $cbr_t_cell(2 ~%cbr_sa_c%~)
        PATCH_IF ~%cbr_sa_column%~ STRING_EQUAL_CASE ~GETS_PROF_APR~ BEGIN
          SET cbr_sa_col = cbr_sa_c + 1 SPRINT $cbr_t_cell(~%cbr_sa_r%~ ~%cbr_sa_col%~) ~1~
        END
      END
    END
  END
  LPM cbr_tempus_write_table
END

DEFINE_ACTION_FUNCTION cbr_apply_tempus_spec_apr STR_VAR resource_dir = ~~ BEGIN
  OUTER_SPRINT resource_dir EVALUATE_BUFFER ~%resource_dir%~
  ACTION_IF ~%resource_dir%~ STRING_EQUAL ~~ BEGIN FAIL ~CBR Tempus spec APR requires resource_dir.~ END
  ACTION_IF NOT FILE_EXISTS ~%resource_dir%/CLSWPBON.2DA~ BEGIN
    <<<<<<<< cbr-spec-apr-table
2DA V1.0
0
GETS_PROF_APR UNARMED_DIVISOR ZERO_SKILL_THAC0
>>>>>>>>
    COPY ~cbr-spec-apr-table~ ~%resource_dir%/CLSWPBON.2DA~
  END
  COPY ~%resource_dir%/CLSWPBON.2DA~ ~%resource_dir%/CLSWPBON.2DA~
    LPF cbr_sa_transform_clswpbon STR_VAR row_label = ~OHTEMPUS~ END
    LPF cbr_sa_transform_clswpbon STR_VAR row_label = ~CLERIC~ END
  BUT_ONLY
END
