DEFINE_PATCH_FUNCTION cbr_cr_read_layout
  INT_VAR stride = 0x38 log_errors = 1
  RET ab na fx eq_first eq_count readable
BEGIN
  SET ab = 0 SET na = 0 SET fx = 0 SET eq_first = 0 SET eq_count = 0
  SET readable = BUFFER_LENGTH >= 0x72
  PATCH_IF readable BEGIN
    READ_LONG 0x64 ab READ_SHORT 0x68 na READ_LONG 0x6a fx
    READ_SHORT 0x6e eq_first READ_SHORT 0x70 eq_count
    SET readable = (na = 0 OR (ab >= 0x72 AND ab <= BUFFER_LENGTH
      AND na <= (BUFFER_LENGTH - ab) / stride)) AND fx >= 0x72 AND fx <= BUFFER_LENGTH
    PATCH_IF readable BEGIN
      SET available = (BUFFER_LENGTH - fx) / 0x30
      PATCH_IF eq_count > 0 AND eq_first + eq_count > available BEGIN SET readable = 0 END
      FOR (a = 0; a < na; ++a) BEGIN
        READ_SHORT (ab + a * stride + 0x1e) n
        READ_SHORT (ab + a * stride + 0x20) first
        PATCH_IF n > 0 AND first + n > available BEGIN SET readable = 0 END
      END
      // Tables may be in either order, but referenced records cannot overlap.
      PATCH_IF na > 0 AND fx >= ab AND fx < ab + na * stride BEGIN SET readable = 0 END
      PATCH_IF na > 0 AND fx < ab BEGIN
        PATCH_IF eq_count > 0 AND fx + (eq_first + eq_count) * 0x30 > ab BEGIN SET readable = 0 END
        FOR (a = 0; a < na; ++a) BEGIN
          READ_SHORT (ab + a * stride + 0x1e) n READ_SHORT (ab + a * stride + 0x20) first
          PATCH_IF n > 0 AND fx + (first + n) * 0x30 > ab BEGIN SET readable = 0 END
        END
      END
    END
  END
  PATCH_IF NOT readable AND log_errors BEGIN
    PATCH_PRINT ~Chris Revisions: %SOURCE_FILE% has unreadable resource bounds; leaving this file alone.~
  END
END


// Component 340, Chris Revisions: Christopher's spell balance changes, with or
// without Spell Revisions. Decisions and evidence:
// research/2026-10-23-aid-luck-chaotic-commands.md,
// research/2026-10-23-prayer-recitation.md and research/2026-10-23-bless.md
//
// Parts: Aid (hit points only), Luck (90 seconds), Bless (30 seconds + 1 round
// per level, and druids), Chaotic Commands (druids), Prayer and Recitation (not
// cumulative).
// Each part resolves SPELL.IDS and known copy provenance. Owned effects and
// complete descriptions are written independently for every readable target.
DEFINE_PATCH_MACRO cbr_cr_problem
BEGIN
  PATCH_PRINT ~Chris Revisions: %cr_msg% Only this resource is unchanged.~
END


DEFINE_PATCH_MACRO cbr_cr_layout
BEGIN
  LPF cbr_cr_read_layout INT_VAR stride = 0x28 log_errors = 0
    RET cr_ab = ab cr_nab = na cr_fx = fx cr_cast_first = eq_first cr_cast_n = eq_count cr_ok = readable END
  SET cr_std = cr_ok SET cr_nfx = 0
  PATCH_IF cr_ok BEGIN SET cr_nfx = (BUFFER_LENGTH - cr_fx) / 0x30 END
END


DEFINE_PATCH_MACRO cbr_cr_is_member
BEGIN
  SET cr_member_hit = 0
  TO_UPPER cr_res
  PATCH_IF (VARIABLE_IS_SET $cbr_cr_member(~%cr_res%~)) BEGIN
    PATCH_IF ($cbr_cr_member(~%cr_res%~) = cbr_cr_gen) BEGIN SET cr_member_hit = 1 END
  END
END

// Appends a copy of the effect at cr_src; cr_dst is the copy's offset.
DEFINE_PATCH_MACRO cbr_cr_append_copy
BEGIN
  SET cr_dst = BUFFER_LENGTH
  INSERT_BYTES cr_dst 0x30
  FOR (cr_c = 0; cr_c < 12; ++cr_c) BEGIN
    READ_LONG (cr_src + cr_c * 4) cr_v
    WRITE_LONG (cr_dst + cr_c * 4) cr_v
  END
END

// Appends an effect that is delivered like the one at cr_tsrc (target, power,
// resistance, probability, saving throw), so it reaches the same creatures;
// every other field is cleared. cr_dst is its offset.
DEFINE_PATCH_MACRO cbr_cr_append_like
BEGIN
  SET cr_src = cr_tsrc
  LPM cbr_cr_append_copy
  WRITE_SHORT cr_dst 0
  WRITE_LONG (cr_dst + 0x04) 0
  WRITE_LONG (cr_dst + 0x08) 0
  WRITE_BYTE (cr_dst + 0x0c) 0
  WRITE_LONG (cr_dst + 0x0e) 0
  WRITE_LONG (cr_dst + 0x14) 0
  WRITE_LONG (cr_dst + 0x18) 0
  WRITE_LONG (cr_dst + 0x1c) 0
  WRITE_LONG (cr_dst + 0x20) 0
  WRITE_LONG (cr_dst + 0x2c) 0
END

// Resolves cr_symbol to cr_anchor (cr_prefix + slot; cr_base 1000 for priest,
// 2000 for wizard spells). cr_found = 0 without the symbol; a symbol that maps
// outside the range or to a missing file becomes cr_problem.
DEFINE_ACTION_MACRO cbr_cr_resolve
BEGIN
  OUTER_SET cr_found=0 OUTER_SPRINT cr_problem ~~ OUTER_SPRINT cr_anchor ~~
  ACTION_IF FILE_EXISTS_IN_GAME ~SPELL.IDS~ BEGIN
    CLEAR_IDS_MAP OUTER_SET cr_id=IDS_OF_SYMBOL (~spell~ ~%cr_symbol%~)
    ACTION_IF cr_id>=0 BEGIN
      OUTER_SET family=cr_id / 1000 OUTER_SET slot=cr_id MODULO 1000
      ACTION_MATCH family WITH
        1 BEGIN OUTER_SPRINT cr_prefix ~SPPR~ END
        2 BEGIN OUTER_SPRINT cr_prefix ~SPWI~ END
        3 BEGIN OUTER_SPRINT cr_prefix ~SPIN~ END
        4 BEGIN OUTER_SPRINT cr_prefix ~SPCL~ END
        DEFAULT OUTER_SPRINT cr_prefix ~SPIT~
      END
      OUTER_SPRINT digits ~%slot%~
      ACTION_IF slot<100 BEGIN OUTER_SPRINT digits ~0%digits%~ END
      ACTION_IF slot<10 BEGIN OUTER_SPRINT digits ~0%digits%~ END
      OUTER_SPRINT cr_anchor ~%cr_prefix%%digits%~
      ACTION_IF FILE_EXISTS_IN_GAME ~%cr_anchor%.SPL~ BEGIN OUTER_SET cr_found=1 END
    END
  END
END

DEFINE_ACTION_MACRO cbr_cr_report_skip
BEGIN
  ACTION_IF NOT cr_found BEGIN PRINT ~Chris Revisions: optional %cr_symbol% target is absent; the remaining changes continue.~ END
END


DEFINE_ACTION_MACRO cbr_cr_collect_family
BEGIN
  ACTION_IF (NOT VARIABLE_IS_SET cbr_cr_gen) BEGIN OUTER_SET cbr_cr_gen = 0 END
  OUTER_SET cbr_cr_gen = cbr_cr_gen + 1
  OUTER_SET cr_nfam=1
  OUTER_SPRINT $cbr_cr_fam(~0~) ~%cr_anchor%~
  OUTER_SET $cbr_cr_member(~%cr_anchor%~)=cbr_cr_gen
  ACTION_IF (~%cr_kind%~ STR_EQ ~aid~) AND FILE_EXISTS_IN_GAME ~C0TRBS2.SPL~ BEGIN
    OUTER_SET cr_new_member = 1
    ACTION_IF VARIABLE_IS_SET $cbr_cr_member(~C0TRBS2~) BEGIN
      ACTION_IF $cbr_cr_member(~C0TRBS2~) = cbr_cr_gen BEGIN OUTER_SET cr_new_member = 0 END
    END
    ACTION_IF cr_new_member BEGIN
      OUTER_SPRINT $cbr_cr_fam(~%cr_nfam%~) ~C0TRBS2~ OUTER_SET cr_nfam += 1
      OUTER_SET $cbr_cr_member(~C0TRBS2~) = cbr_cr_gen
    END
  END
  OUTER_SPRINT cr_map ~weidu_external/data/stratagems/instant_prebuff_spells.2da~
  ACTION_IF FILE_EXISTS ~%cr_map%~ BEGIN
    OUTER_SPRINT cr_key ~%cr_symbol%_PREBUFF~
    OUTER_SET cr_npre = 0
    COPY ~%cr_map%~ ~%cr_map%~
      READ_ASCII 0 cr_map_text (BUFFER_LENGTH)
      INNER_PATCH ~%cr_map_text%~ BEGIN
        REPLACE_EVALUATE CASE_INSENSITIVE
          ~^\([^ %TAB%%WNL%%MNL%%LNL%]+\)[ %TAB%]+\([^ %TAB%%WNL%%MNL%%LNL%]+\)~
        BEGIN
          PATCH_IF (~%MATCH1%~ STRING_EQUAL_CASE ~%cr_key%~) BEGIN
            SPRINT $cbr_cr_pre(~%cr_npre%~) ~%MATCH2%~
            SET cr_npre += 1
          END
        END
          ~~
      END
    BUT_ONLY
    OUTER_FOR (cr_pi = 0; cr_pi < cr_npre; ++cr_pi) BEGIN
      OUTER_SPRINT cr_res $cbr_cr_pre(~%cr_pi%~)
      ACTION_TO_UPPER cr_res
      OUTER_SET cr_new_member = 0
      ACTION_IF ((STRING_LENGTH ~%cr_res%~) <= 8) BEGIN
        ACTION_IF FILE_EXISTS_IN_GAME ~%cr_res%.spl~ BEGIN
          OUTER_SET cr_new_member = 1
          ACTION_IF VARIABLE_IS_SET $cbr_cr_member(~%cr_res%~) BEGIN
            ACTION_IF ($cbr_cr_member(~%cr_res%~) = cbr_cr_gen) BEGIN OUTER_SET cr_new_member = 0 END
          END
        END
      END
      ACTION_IF cr_new_member BEGIN
        OUTER_SPRINT $cbr_cr_fam(~%cr_nfam%~) ~%cr_res%~
        OUTER_SET cr_nfam = cr_nfam + 1
        OUTER_SET $cbr_cr_member(~%cr_res%~) = cbr_cr_gen
      END
    END
  END
  OUTER_SPRINT cr_members ~~
  OUTER_FOR (cr_fi = 0; cr_fi < cr_nfam; ++cr_fi) BEGIN
    OUTER_SPRINT cr_member $cbr_cr_fam(~%cr_fi%~)
    OUTER_SPRINT cr_members ~%cr_members% %cr_member%~
  END
END

// Aid for one family member. Per ability, L = max(ability level, 3), the
// cleric's minimum level for a 2nd-level spell, as Spell Revisions uses it:
// - the timed opcode-129 payload goes. A timed opcode-18 type-0 bonus becomes
//   min(L, 10) + 1d8 hit points; without one (native Aid) the opcode 129 itself
//   becomes that bonus, keeping its delivery fields;
// - every timed effect that lasted exactly as long as the payload lasts 60 * L
//   seconds (glow, icon, end sound);
// - the ability starts with one opcode-321 refresh per family member, so a recast
//   of any member replaces the bonus instead of stacking it. The ability's first
//   family refresh is the template; otherwise Spell Revisions' form is used.
// Each ability gets its own copy of its effects; casting effects stay first.

DEFINE_PATCH_MACRO cbr_cr_snapshot
BEGIN
  LPM cbr_cr_layout
  SPRINT cr_trailer ~~
  PATCH_IF cr_ok BEGIN
    READ_ASCII 0 cr_header (0x72)
    SPRINT cr_casting ~~
    PATCH_IF cr_cast_n > 0 BEGIN READ_ASCII (cr_fx+cr_cast_first*0x30) cr_casting (cr_cast_n*0x30) END
    SET cr_end = 0x72
    PATCH_IF cr_nab > 0 BEGIN SET cr_end = cr_ab+cr_nab*0x28 END
    PATCH_IF cr_cast_n > 0 AND cr_fx+(cr_cast_first+cr_cast_n)*0x30 > cr_end BEGIN SET cr_end = cr_fx+(cr_cast_first+cr_cast_n)*0x30 END
    FOR (cr_a=0; cr_a<cr_nab; ++cr_a) BEGIN
      SET cr_at=cr_ab+cr_a*0x28
      READ_ASCII cr_at $cr_ability(~%cr_a%~) (0x28)
      READ_SHORT (cr_at+0x10) $cr_level(~%cr_a%~)
      READ_SHORT (cr_at+0x1e) cr_n READ_SHORT (cr_at+0x20) cr_first
      SPRINT $cr_effects(~%cr_a%~) ~~
      PATCH_IF cr_n > 0 BEGIN READ_ASCII (cr_fx+cr_first*0x30) $cr_effects(~%cr_a%~) (cr_n*0x30) END
      PATCH_IF cr_n > 0 AND cr_fx+(cr_first+cr_n)*0x30 > cr_end BEGIN SET cr_end=cr_fx+(cr_first+cr_n)*0x30 END
    END
    PATCH_IF cr_end < BUFFER_LENGTH BEGIN READ_ASCII cr_end cr_trailer (BUFFER_LENGTH - cr_end) END
    SPRINT cr_new_abilities ~~ SPRINT cr_new_effects ~%cr_casting%~
    SET cr_out = cr_cast_n SET cr_new_count = 0 SET cr_fits = 1
    PATCH_IF cr_nab = 0 BEGIN
      INNER_PATCH_SAVE cr_default_ability ~........................................~ BEGIN
        FOR (cr_j=0;cr_j<0x28;++cr_j) BEGIN WRITE_BYTE cr_j 0 END
        WRITE_BYTE 0 1 WRITE_BYTE 0xc 1 WRITE_SHORT 0xe 30 WRITE_SHORT 0x10 1
      END
      SPRINT $cr_ability(~0~) ~%cr_default_ability%~ SPRINT $cr_effects(~0~) ~~ SET $cr_level(~0~)=1 SET cr_nab=1
    END
  END ELSE BEGIN PATCH_PRINT ~Chris Revisions: %SOURCE_FILE% has unreadable SPL bounds; only this file is unchanged.~ END
END

DEFINE_PATCH_MACRO cbr_cr_output_ability
BEGIN
  SET cr_count = STRING_LENGTH ~%cr_slice%~ / 0x30
  PATCH_IF cr_count > 0xffff OR cr_out > 0xffff BEGIN SET cr_fits = 0 END
  INNER_PATCH_SAVE cr_header_ability ~%cr_header_ability%~ BEGIN
    WRITE_SHORT 0x10 cr_new_level WRITE_SHORT 0x1e cr_count WRITE_SHORT 0x20 cr_out
  END
  SPRINT cr_new_abilities ~%cr_new_abilities%%cr_header_ability%~
  SPRINT cr_new_effects ~%cr_new_effects%%cr_slice%~
  SET cr_out += cr_count SET cr_new_count += 1
END

DEFINE_PATCH_MACRO cbr_cr_write
BEGIN
  PATCH_IF cr_fits AND cr_new_count <= 0xffff BEGIN
  SPRINT cr_output ~%cr_header%%cr_new_abilities%%cr_new_effects%%cr_trailer%~
  DELETE_BYTES 0 BUFFER_LENGTH INSERT_BYTES 0 (STRING_LENGTH ~%cr_output%~) WRITE_ASCIIE 0 ~%cr_output%~
  WRITE_LONG 0x64 0x72 WRITE_SHORT 0x68 cr_new_count WRITE_LONG 0x6a (0x72+cr_new_count*0x28) WRITE_SHORT 0x6e 0
  END ELSE BEGIN SET cr_ok = 0 PATCH_PRINT ~Chris Revisions: %SOURCE_FILE% cannot address the new slices; only this file is unchanged.~ END
END

DEFINE_PATCH_MACRO cbr_cr_empty_effect
BEGIN
  INNER_PATCH_SAVE cr_record ~................................................~ BEGIN
    FOR (cr_j=0;cr_j<0x30;++cr_j) BEGIN WRITE_BYTE cr_j 0 END
    WRITE_BYTE 2 2 WRITE_BYTE 3 2 WRITE_BYTE 0xd 3 WRITE_BYTE 0x12 100
  END
END

DEFINE_PATCH_MACRO cbr_cr_rebuild_family
BEGIN
  LPM cbr_cr_snapshot
  PATCH_IF cr_ok BEGIN
    SET cr_nt = cr_nab
    FOR (cr_a=0;cr_a<cr_nab;++cr_a) BEGIN SET $cr_target_level(~%cr_a%~)=$cr_level(~%cr_a%~) SET $cr_source_ability(~%cr_a%~)=cr_a END
    PATCH_IF ~%cr_kind%~ STR_EQ ~bless~ BEGIN
      SET cr_nt=20 FOR (cr_k=0;cr_k<20;++cr_k) BEGIN SET $cr_target_level(~%cr_k%~)=cr_k+1 END
      SET cr_last=20 SET cr_more=1
      WHILE cr_more BEGIN
        SET cr_next=65536
        FOR (cr_a=0;cr_a<cr_nab;++cr_a) BEGIN SET cr_level=$cr_level(~%cr_a%~) PATCH_IF cr_level>cr_last AND cr_level<cr_next BEGIN SET cr_next=cr_level END END
        PATCH_IF cr_next<65536 BEGIN SET $cr_target_level(~%cr_nt%~)=cr_next SET cr_nt+=1 SET cr_last=cr_next END ELSE BEGIN SET cr_more=0 END
      END
      FOR (cr_k=0;cr_k<cr_nt;++cr_k) BEGIN
        SET cr_level=$cr_target_level(~%cr_k%~) SET cr_best= (0 - 1) SET cr_low=0
        FOR (cr_a=0;cr_a<cr_nab;++cr_a) BEGIN
          SET cr_l=$cr_level(~%cr_a%~)
          PATCH_IF cr_l<$cr_level(~%cr_low%~) BEGIN SET cr_low=cr_a END
          PATCH_IF cr_l<=cr_level BEGIN PATCH_IF cr_best<0 BEGIN SET cr_best=cr_a END ELSE PATCH_IF cr_l>=$cr_level(~%cr_best%~) BEGIN SET cr_best=cr_a END END
        END
        PATCH_IF cr_best<0 BEGIN SET cr_best=cr_low END SET $cr_source_ability(~%cr_k%~)=cr_best
      END
    END
    FOR (cr_k=0;cr_k<cr_nt;++cr_k) BEGIN
      SET cr_a=$cr_source_ability(~%cr_k%~) SET cr_new_level=$cr_target_level(~%cr_k%~)
      SPRINT cr_header_ability $cr_ability(~%cr_a%~) SPRINT cr_input $cr_effects(~%cr_a%~)
      SET cr_duration=90 SET cr_main=133
      PATCH_IF ~%cr_kind%~ STR_EQ ~aid~ BEGIN SET cr_duration=60*(cr_new_level < 3 ? 3 : cr_new_level) SET cr_main=18 END
      PATCH_IF ~%cr_kind%~ STR_EQ ~bless~ BEGIN SET cr_duration=30+6*(cr_new_level > 20 ? 20 : cr_new_level) SET cr_main=130 END
      SPRINT cr_slice ~~ SET cr_payload= (0 - 1) SET cr_count=(STRING_LENGTH ~%cr_input%~)/0x30
      INNER_PATCH ~%cr_input%~ BEGIN
        FOR (cr_i=0;cr_i<cr_count;++cr_i) BEGIN
          READ_SHORT (cr_i*0x30) cr_op
          PATCH_IF cr_op=cr_main OR (~%cr_kind%~ STR_EQ ~luck~ AND cr_op=22) BEGIN PATCH_IF cr_payload<0 BEGIN SET cr_payload=cr_i END END
        END
        PATCH_IF cr_payload<0 AND ~%cr_kind%~ STR_EQ ~aid~ BEGIN
          FOR (cr_i=0;cr_i<cr_count;++cr_i) BEGIN READ_SHORT (cr_i*0x30) cr_op PATCH_IF cr_op=129 AND cr_payload<0 BEGIN SET cr_payload=cr_i END END
        END
      END
      LPM cbr_cr_empty_effect
      PATCH_IF cr_payload>=0 BEGIN INNER_PATCH ~%cr_input%~ BEGIN READ_ASCII (cr_payload*0x30) cr_record (0x30) END END
      INNER_PATCH_SAVE cr_payload_record ~%cr_record%~ BEGIN
        WRITE_SHORT 0 cr_main WRITE_BYTE 0xc 0 WRITE_LONG 0xe cr_duration
        PATCH_IF ~%cr_kind%~ STR_EQ ~aid~ BEGIN WRITE_LONG 4 (cr_new_level > 10 ? 10 : (cr_new_level < 3 ? 3 : cr_new_level)) WRITE_LONG 8 0 WRITE_LONG 0x1c 1 WRITE_LONG 0x20 8 END
        PATCH_IF cr_payload<0 AND NOT (~%cr_kind%~ STR_EQ ~aid~) BEGIN WRITE_LONG 4 1 END
        READ_BYTE 2 cr_target
      END
      PATCH_IF ~%cr_kind%~ STR_EQ ~aid~ BEGIN
        FOR (cr_m=0;cr_m<cr_nfam;++cr_m) BEGIN
          SPRINT cr_mres $cbr_cr_fam(~%cr_m%~)
          LPM cbr_cr_empty_effect
          INNER_PATCH_SAVE cr_record ~%cr_record%~ BEGIN
            WRITE_SHORT 0 321 WRITE_BYTE 2 cr_target WRITE_BYTE 3 0 WRITE_BYTE 0xc 1 WRITE_BYTE 0xd 0 WRITE_ASCIIE 0x14 ~%cr_mres%~ #8
          END
          SPRINT cr_slice ~%cr_slice%%cr_record%~
        END
      END
      INNER_PATCH ~%cr_input%~ BEGIN
        FOR (cr_i=0;cr_i<cr_count;++cr_i) BEGIN
          READ_ASCII (cr_i*0x30) cr_record (0x30) READ_SHORT (cr_i*0x30) cr_op READ_BYTE (cr_i*0x30+0xc) cr_tm
          SET cr_keep=1
          PATCH_IF ~%cr_kind%~ STR_EQ ~aid~ BEGIN
            PATCH_IF cr_op=129 OR cr_op=18 BEGIN SET cr_keep=0 END
            PATCH_IF cr_op=321 BEGIN READ_ASCII (cr_i*0x30+0x14) cr_res (8) NULL LPM cbr_cr_is_member PATCH_IF cr_member_hit BEGIN SET cr_keep=0 END END
            PATCH_IF cr_i=cr_payload BEGIN SPRINT cr_slice ~%cr_slice%%cr_payload_record%~ END
          END
          PATCH_IF cr_keep BEGIN
            INNER_PATCH_SAVE cr_record ~%cr_record%~ BEGIN
              PATCH_IF (cr_tm=0 OR cr_tm=3 OR cr_tm=4) AND cr_op!=50 AND cr_op!=215 BEGIN WRITE_LONG 0xe cr_duration END
              PATCH_IF (~%cr_kind%~ STR_EQ ~luck~ AND (cr_op=133 OR cr_op=22)) OR (~%cr_kind%~ STR_EQ ~bless~ AND cr_op=130) BEGIN WRITE_BYTE 0xc 0 WRITE_LONG 0xe cr_duration END
            END
            SPRINT cr_slice ~%cr_slice%%cr_record%~
          END
        END
      END
      PATCH_IF cr_payload<0 BEGIN SPRINT cr_slice ~%cr_slice%%cr_payload_record%~ END
      LPM cbr_cr_output_ability
    END
    LPM cbr_cr_write
  END
END

DEFINE_PATCH_MACRO cbr_cr_family_patch
BEGIN
  LPM cbr_cr_rebuild_family
END


DEFINE_PATCH_MACRO cbr_cr_record_text
BEGIN
  SET cr_dup = 0
  FOR (cr_t = 0; cr_t < cr_ntxt; ++cr_t) BEGIN
    PATCH_IF ($cbr_cr_txt_oref(~%cr_t%~) = cr_ref) BEGIN SET cr_dup = 1 END
  END
  PATCH_IF NOT cr_dup BEGIN
    SPRINT $cbr_cr_txt_old(~%cr_ntxt%~) ~%cr_text%~
    SET $cbr_cr_txt_oref(~%cr_ntxt%~) = cr_ref
    SET $cbr_cr_txt_ref(~%cr_ntxt%~) = cr_new_ref
    SET cr_ntxt += 1
  END
END

// Rewrites the text at cr_off with the phrases of cr_kind (aid, luck or bless).
// Text that is not recognized stays unchanged; cr_warn = 1 reports it. With
// cr_record = 1 the change is recorded for cbr_cr_item_descriptions.
DEFINE_PATCH_MACRO cbr_cr_description
BEGIN
  PATCH_IF cr_off+4 <= BUFFER_LENGTH BEGIN
    PATCH_IF ~%EE_LANGUAGE%~ STRING_EQUAL_CASE ~en_us~ BEGIN
      PATCH_IF ~%cr_kind%~ STR_EQ ~aid~ BEGIN SPRINT cr_new_text ~Aid
Level: 2
School: Necromancy
Sphere: Combat, Necromantic
Range: Touch
Duration: 1 turn/level
Casting Time: 5
Area of Effect: 1 creature
Saving Throw: None

The recipient of this spell gains 1d8 additional hit points +1 per level of the caster (up to a maximum of 1d8+10). The Aid spell allows the recipient to temporarily have more hit points than his full normal total. The bonus hit points are lost first when the recipient takes damage. Multiple castings of this spell are not cumulative.~ END
      PATCH_IF ~%cr_kind%~ STR_EQ ~luck~ BEGIN SPRINT cr_new_text ~Luck
Level: 2
School: Enchantment
Range: Medium
Duration: 15 rounds
Casting Time: 2
Area of Effect: 1 creature
Saving Throw: None

The recipient of this spell is lucky in everything that he does for the next 15 rounds. The affected character receives a 5% or +1 bonus to all of his actions. This includes saving throws, to hit chances, damage rolls, thieving skills, etc. Multiple castings of this spell are not cumulative.~ END
      PATCH_IF ~%cr_kind%~ STR_EQ ~bless~ BEGIN SPRINT cr_new_text ~Bless
Level: 1
School: Enchantment
Sphere: All
Range: Long
Duration: 5 rounds + 1 round/level (maximum 25 rounds)
Casting Time: 5
Area of Effect: 30' radius
Saving Throw: None

Upon uttering the Bless spell, the caster raises the morale of friendly creatures by +1. Furthermore, it raises their attack and damage dice rolls by +1. The caster determines at what range he will cast the spell. At the instant the spell is completed, it affects all creatures in a 30 foot radius centered on the point selected by the caster (thus, affected creatures leaving the area are still subject to the spell's effect; those entering the area after the casting is completed are not).~ END
      PATCH_IF ~%cr_kind%~ STR_EQ ~prayer~ BEGIN SPRINT cr_new_text ~Prayer
(Conjuration/Summoning)

Level: 3
Sphere: Combat
Range: 0
Duration: 1 round/level
Casting Time: 6
Area of Effect: 30-ft. radius
Saving Throw: None

Prayer bestows favor on the priest and <PRO_HISHER> allies, and curses their enemies. All attacks, damage, and Saving Throws by friendly characters gain a +1 bonus, while enemy attacks, damage rolls, and saves get a -1 penalty. Any creatures within the area of effect when the spell is cast will continue to be affected by the spell when they leave the area, so if the warriors want to chase down that fleeing goblin, the effects of the Prayer will follow them.

Prayer does not stack with Recitation. A creature with Recitation's bonus gains no bonus from Prayer, a creature with Recitation's penalty suffers no penalty from Prayer, and a later Recitation replaces Prayer's bonus or penalty.~ END
      PATCH_IF ~%cr_kind%~ STR_EQ ~recitation~ BEGIN SPRINT cr_new_text ~Recitation
(Abjuration, Invocation/Evocation)

Level: 4
Sphere: Combat
Range: 0
Duration: 1 round/level
Casting Time: 7
Area of Effect: 25-ft. radius
Saving Throw: None

By reciting a sacred passage or declaration, the priest invokes <PRO_HISHER> deity's blessing upon <PRO_HIMHER>self and <PRO_HISHER> allies while sowing confusion and weakness among <PRO_HISHER> enemies. The priest's allies gain a +2 bonus to their attack rolls and Saving Throws, and the priest's enemies receive a -2 penalty to the same. Recitation does not stack with Prayer. On each creature, Recitation's bonus replaces a Prayer bonus and its penalty replaces a Prayer penalty; while Recitation lasts, Prayer adds no bonus or penalty of the same kind.~ END
      READ_LONG cr_off cr_ref SPRINT cr_text ~~ SET cr_new_ref = RESOLVE_STR_REF (~%cr_new_text%~)
      WRITE_LONG cr_off cr_new_ref
      PATCH_IF cr_record BEGIN LPM cbr_cr_record_text END
    END ELSE BEGIN PATCH_PRINT ~Chris Revisions: no %EE_LANGUAGE% translation for %SOURCE_FILE%; existing text retained.~ END
  END
END


DEFINE_PATCH_MACRO cbr_cr_note_description
BEGIN
  LPM cbr_cr_layout
  PATCH_IF cr_ok BEGIN SET cr_off=0x50 SET cr_record=1 LPM cbr_cr_description END
END


DEFINE_PATCH_MACRO cbr_cr_teach_slice
BEGIN
  FOR (cr_i = 0; cr_i < cr_s_n; ++cr_i) BEGIN
    SET cr_e = cr_ifx + (cr_s_first + cr_i) * 0x30
    PATCH_IF ((cr_e + 0x30) <= BUFFER_LENGTH) BEGIN
      READ_SHORT cr_e cr_op
      PATCH_IF (cr_op = 147) BEGIN
        READ_ASCII (cr_e + 0x14) cr_res (8) NULL
        LPM cbr_cr_is_member
        PATCH_IF cr_member_hit BEGIN SET cr_teach = 1 END
      END
    END
  END
END

// Item descriptions. An item that shows a changed spell description exactly (a
// priest scroll that casts the spell, such as IWDification's) shows the new one:
// $cbr_cr_txt_old(k) becomes $cbr_cr_txt_ref(k), k < cr_ntxt. With
// cr_teach_scan = 1, an item that teaches a family member (opcode 147, wizard
// scrolls) gets the same text update as the spell; its identified description
// warns when it is not recognized.
DEFINE_ACTION_MACRO cbr_cr_item_descriptions
BEGIN
  COPY_EXISTING_REGEXP GLOB ~^.+\.itm$~ ~override~
    LPF cbr_cr_read_layout INT_VAR stride=0x38 log_errors=0 RET ab na fx eq_first eq_count readable END
    PATCH_IF readable BEGIN
      READ_SHORT 0x1c category SET teach=0
      FOR (a= (0 - 1);a<na;++a) BEGIN
        PATCH_IF a<0 BEGIN SET first=eq_first SET count=eq_count END ELSE BEGIN READ_SHORT (ab+a*0x38+0x1e) count READ_SHORT (ab+a*0x38+0x20) first END
        FOR (i=0;i<count;++i) BEGIN
          READ_SHORT (fx+(first+i)*0x30) op
          PATCH_IF op=147 OR (category=11 AND (op=146 OR op=148 OR op=326)) BEGIN
            READ_ASCII (fx+(first+i)*0x30+0x14) cr_res (8) NULL LPM cbr_cr_is_member
            PATCH_IF cr_member_hit BEGIN SET teach=1 END
          END
        END
      END
      PATCH_IF teach BEGIN SET cr_off=0x54 SET cr_record=0 LPM cbr_cr_description END
    END
    BUT_ONLY IF_EXISTS
END


DEFINE_ACTION_MACRO cbr_cr_family_part
BEGIN
  OUTER_SET cr_ntxt=0 LAM cbr_cr_resolve
  ACTION_IF cr_found BEGIN
    LAM cbr_cr_collect_family OUTER_SET cr_check=0
    OUTER_FOR (cr_fi=0;cr_fi<cr_nfam;++cr_fi) BEGIN
      OUTER_SPRINT cr_member $cbr_cr_fam(~%cr_fi%~)
      COPY_EXISTING ~%cr_member%.spl~ ~override~
        LPM cbr_cr_family_patch
        PATCH_IF cr_ok BEGIN SET cr_off=0x50 SET cr_record=1 LPM cbr_cr_description END
        BUT_ONLY
    END
    LAM cbr_cr_item_descriptions
    ACTION_IF ~%cr_kind%~ STR_EQ ~aid~ BEGIN PRINT @3401 END ELSE ACTION_IF ~%cr_kind%~ STR_EQ ~bless~ BEGIN PRINT @3406 END ELSE BEGIN PRINT @3402 END
  END
  LAM cbr_cr_report_skip
END


DEFINE_PATCH_MACRO cbr_cr_druid_patch
BEGIN
  SET cr_changed=0
  PATCH_IF BUFFER_LENGTH>=0x72 BEGIN
    READ_SHORT 0x20 cr_classes SET cr_changed=(cr_classes BAND 0x8000)!=0
    WRITE_SHORT 0x20 (cr_classes BAND 0x7fff)
  END ELSE BEGIN PATCH_PRINT ~Chris Revisions: %SOURCE_FILE% has unreadable SPL bounds; only this file is unchanged.~ END
END


DEFINE_ACTION_MACRO cbr_cr_druid_part
BEGIN
  LAM cbr_cr_resolve
  ACTION_IF cr_found BEGIN
    COPY_EXISTING ~%cr_anchor%.spl~ ~override~ LPM cbr_cr_druid_patch BUT_ONLY
    ACTION_IF cr_changed BEGIN PRINT @3500 END ELSE BEGIN PRINT @3501 END
  END
  LAM cbr_cr_report_skip
END



// Mixed/delegating payloads get private stat-only deliveries, so blocking one
// sign does not block the other sign or an unrelated spell cast by the carrier.
DEFINE_PATCH_MACRO cbr_cr_split_stats
BEGIN
  LPM cbr_cr_snapshot
  PATCH_IF cr_ok BEGIN
    PATCH_IF cr_split_mode=0 BEGIN SPRINT cr_new_effects ~~ SET cr_cast_n=0 SET cr_out=0 END
    FOR (cr_a=0;cr_a<cr_nab;++cr_a) BEGIN
      SPRINT cr_header_ability $cr_ability(~%cr_a%~) SET cr_new_level=$cr_level(~%cr_a%~)
      SPRINT cr_input $cr_effects(~%cr_a%~) SPRINT cr_slice ~~ SET made_positive=0 SET made_negative=0
      INNER_PATCH ~%cr_input%~ BEGIN
        FOR (cr_i=0;cr_i<BUFFER_LENGTH/0x30;++cr_i) BEGIN
          SET at=cr_i*0x30 READ_SHORT at op READ_LONG (at+4) amount READ_ASCII at cr_record (0x30)
          SET sign=0 PATCH_IF (op=54 OR op=325 OR op=73) AND amount!=0 BEGIN SET sign=(amount>0 ? 1 : 2) END
          PATCH_IF cr_split_mode=0 BEGIN
            PATCH_IF sign=cr_split_sign BEGIN
              INNER_PATCH_SAVE cr_record ~%cr_record%~ BEGIN WRITE_BYTE 2 2 END
              SPRINT cr_slice ~%cr_slice%%cr_record%~
            END
          END ELSE BEGIN
            PATCH_IF sign=0 BEGIN SPRINT cr_slice ~%cr_slice%%cr_record%~ END ELSE BEGIN
              SET make=(sign=1 AND NOT made_positive) OR (sign=2 AND NOT made_negative)
              PATCH_IF make BEGIN
                SPRINT dest ~%cr_negative%~ PATCH_IF sign=1 BEGIN SPRINT dest ~%cr_positive%~ END
                INNER_PATCH_SAVE cr_record ~%cr_record%~ BEGIN
                  READ_BYTE 2 target
                  FOR (j=0;j<0x30;++j) BEGIN WRITE_BYTE j 0 END
                  WRITE_SHORT 0 146 WRITE_BYTE 2 target WRITE_LONG 8 1 WRITE_BYTE 0xc 1 WRITE_BYTE 0x12 100 WRITE_ASCIIE 0x14 ~%dest%~ #8
                END
                SPRINT cr_slice ~%cr_slice%%cr_record%~
              END
              PATCH_IF sign=1 BEGIN SET made_positive=1 END ELSE BEGIN SET made_negative=1 END
            END
          END
        END
      END
      PATCH_IF cr_split_mode=0 BEGIN
        LPM cbr_cr_empty_effect
        INNER_PATCH_SAVE cr_record ~%cr_record%~ BEGIN
          WRITE_SHORT 0 321 WRITE_BYTE 3 0 WRITE_BYTE 0xc 1 WRITE_BYTE 0xd 0 WRITE_ASCIIE 0x14 ~%cr_private%~ #8
        END
        SPRINT cr_slice ~%cr_record%%cr_slice%~
      END
      LPM cbr_cr_output_ability
    END
    LPM cbr_cr_write
    PATCH_IF cr_split_mode=0 BEGIN WRITE_SHORT 0x70 0 END
  END
END

DEFINE_ACTION_MACRO cbr_cr_payloads
BEGIN
  OUTER_SET cbr_cr_gen+=1
  OUTER_SET $cbr_cr_payn(~%cr_role%~ ~1~)=0 OUTER_SET $cbr_cr_payn(~%cr_role%~ ~2~)=0
  OUTER_SET cr_qn=1 OUTER_SPRINT $cbr_cr_q(~0~) ~%cr_anchor%~ OUTER_SET $cbr_cr_seen(~%cr_anchor%~)=cbr_cr_gen
  OUTER_FOR (cr_qi=0;cr_qi<cr_qn;++cr_qi) BEGIN
    OUTER_SPRINT cr_qres $cbr_cr_q(~%cr_qi%~)
    OUTER_SET cr_pos=0 OUTER_SET cr_neg=0 OUTER_SET cr_casts=0
    COPY_EXISTING ~%cr_qres%.SPL~ ~override~
      LPM cbr_cr_layout
      PATCH_IF cr_ok BEGIN
        FOR (cr_a=0;cr_a<cr_nab;++cr_a) BEGIN
          READ_SHORT (cr_ab+cr_a*0x28+0x1e) cr_n READ_SHORT (cr_ab+cr_a*0x28+0x20) cr_first
          FOR (cr_i=0;cr_i<cr_n;++cr_i) BEGIN
            SET at=cr_fx+(cr_first+cr_i)*0x30 READ_SHORT at op READ_LONG (at+4) amount
            PATCH_IF op=54 OR op=325 BEGIN PATCH_IF amount>=0 BEGIN SET cr_pos=1 END ELSE BEGIN SET cr_neg=1 END END
            PATCH_IF op=146 OR op=148 OR op=326 BEGIN
              SET cr_casts=1 READ_ASCII (at+0x14) cr_child (8) NULL TO_UPPER cr_child
              PATCH_IF NOT (~%cr_child%~ STR_EQ ~~) AND FILE_EXISTS_IN_GAME ~%cr_child%.SPL~ BEGIN
                SET cr_new=1 PATCH_IF VARIABLE_IS_SET $cbr_cr_seen(~%cr_child%~) BEGIN PATCH_IF $cbr_cr_seen(~%cr_child%~)=cbr_cr_gen BEGIN SET cr_new=0 END END
                PATCH_IF cr_new BEGIN SPRINT $cbr_cr_q(~%cr_qn%~) ~%cr_child%~ SET cr_qn+=1 SET $cbr_cr_seen(~%cr_child%~)=cbr_cr_gen END
              END ELSE BEGIN PATCH_PRINT ~Chris Revisions: optional linked spell %cr_child% is absent; this delivery branch ends.~ END
            END
          END
        END
      END ELSE BEGIN PATCH_PRINT ~Chris Revisions: %cr_qres% has unreadable SPL bounds; only this file is unchanged.~ END
      BUT_ONLY
    ACTION_IF cr_pos OR cr_neg BEGIN
      OUTER_SET split=(cr_pos AND cr_neg) OR cr_casts
      OUTER_SPRINT cr_positive ~%cr_qres%~ OUTER_SPRINT cr_negative ~%cr_qres%~
      ACTION_IF split BEGIN
        OUTER_SPRINT roleletter ~P~ ACTION_IF ~%cr_role%~ STR_EQ ~recitation~ BEGIN OUTER_SPRINT roleletter ~R~ END
        OUTER_SPRINT cr_positive ~CQ%roleletter%%cr_qi%G~ OUTER_SPRINT cr_negative ~CQ%roleletter%%cr_qi%B~
      END
      OUTER_FOR (cr_sign=1;cr_sign<3;++cr_sign) BEGIN
        ACTION_IF (cr_sign=1 AND cr_pos) OR (cr_sign=2 AND cr_neg) BEGIN
          OUTER_SPRINT cr_private ~%cr_negative%~ ACTION_IF cr_sign=1 BEGIN OUTER_SPRINT cr_private ~%cr_positive%~ END
          ACTION_IF split BEGIN
            OUTER_SET cr_split_mode=0 OUTER_SET cr_split_sign=cr_sign
            COPY_EXISTING ~%cr_qres%.SPL~ ~override/%cr_private%.SPL~ LPM cbr_cr_split_stats
          END
          OUTER_SET cr_k=$cbr_cr_payn(~%cr_role%~ ~%cr_sign%~)
          OUTER_SPRINT $cbr_cr_pay(~%cr_role%~ ~%cr_sign%~ ~%cr_k%~) ~%cr_private%~
          OUTER_SET $cbr_cr_payn(~%cr_role%~ ~%cr_sign%~)=cr_k+1
        END
      END
      ACTION_IF split BEGIN OUTER_SET cr_split_mode=1 COPY_EXISTING ~%cr_qres%.SPL~ ~override~ LPM cbr_cr_split_stats BUT_ONLY END
    END
  END
  // An empty or entirely rewritten spell still gets the non-stacking contract.
  ACTION_IF $cbr_cr_payn(~%cr_role%~ ~1~)+$cbr_cr_payn(~%cr_role%~ ~2~)=0 BEGIN
    OUTER_SPRINT $cbr_cr_pay(~%cr_role%~ ~1~ ~0~) ~%cr_anchor%~ OUTER_SET $cbr_cr_payn(~%cr_role%~ ~1~)=1
  END
END


DEFINE_PATCH_MACRO cbr_cr_copy_synced
BEGIN
  LPM cbr_cr_append_copy
  READ_SHORT cr_src cr_op
  PATCH_IF (cr_op = 206) BEGIN
    READ_ASCII (cr_src + 0x14) cr_res (8) NULL
    FOR (cr_k = 0; cr_k < cr_np; ++cr_k) BEGIN
      SPRINT cr_p $cbr_cr_rp(~%cr_r%~ ~%cr_k%~)
      PATCH_IF (~%cr_res%~ STRING_EQUAL_CASE ~%cr_p%~) BEGIN
        WRITE_LONG (cr_dst + 0x0e) cr_dur
      END
    END
  END
  SET cr_out += 1
END

// One Recitation payload (cr_r). For every Prayer payload of the same kind
// ($cbr_cr_rp(cr_r k)), each ability removes it (opcode 321) and blocks it for
// the ability's bonus duration (opcode 206, without feedback). Added records are
// delivered like the ability's first bonus effect and follow its refreshes of
// itself, which would otherwise remove them; existing ones are reused, with the
// block's duration kept equal to the bonus. Spell states stay as they are: SCS
// tests Prayer's state on the caster's enemies, so copying it to Recitation
// would change when the other side casts Prayer.
DEFINE_PATCH_MACRO cbr_cr_recitation_patch
BEGIN
  LPM cbr_cr_snapshot
  PATCH_IF cr_ok BEGIN
    SET cr_np=$cbr_cr_rpn(~%cr_r%~)
    FOR (cr_a=0;cr_a<cr_nab;++cr_a) BEGIN
      SPRINT cr_header_ability $cr_ability(~%cr_a%~) SET cr_new_level=$cr_level(~%cr_a%~)
      SPRINT cr_input $cr_effects(~%cr_a%~) SPRINT cr_slice ~~ SPRINT cr_before ~~ SPRINT cr_after ~~
      SET cr_dur=6*(cr_new_level<7 ? 7 : cr_new_level) SET template_found=0
      LPM cbr_cr_empty_effect SPRINT cr_template ~%cr_record%~
      SET cr_lead=0 SET leading=1
      INNER_PATCH ~%cr_input%~ BEGIN
        FOR (cr_i=0;cr_i<BUFFER_LENGTH/0x30;++cr_i) BEGIN
          SET at=cr_i*0x30 READ_SHORT at op READ_ASCII (at+0x14) res (8) NULL
          PATCH_IF op=321 BEGIN PATCH_IF leading OR ~%res%~ STRING_EQUAL_CASE ~%cr_r%~ BEGIN SET cr_lead=cr_i+1 END END ELSE BEGIN SET leading=0 END
          PATCH_IF NOT template_found AND (op=54 OR op=325) BEGIN
            READ_ASCII at cr_template (0x30) READ_LONG (at+0xe) duration
            PATCH_IF duration>0 BEGIN SET cr_dur=duration END SET template_found=1
          END
        END
        FOR (cr_i=0;cr_i<BUFFER_LENGTH/0x30;++cr_i) BEGIN
          SET at=cr_i*0x30 READ_SHORT at op READ_ASCII (at+0x14) res (8) NULL SET owned=0
          PATCH_IF op=206 OR op=321 BEGIN
            FOR (cr_k=0;cr_k<cr_np;++cr_k) BEGIN SPRINT paired $cbr_cr_rp(~%cr_r%~ ~%cr_k%~) PATCH_IF ~%res%~ STRING_EQUAL_CASE ~%paired%~ BEGIN SET owned=1 END END
          END
          PATCH_IF NOT owned BEGIN
            READ_ASCII at cr_record (0x30)
            PATCH_IF cr_i<cr_lead BEGIN SPRINT cr_before ~%cr_before%%cr_record%~ END ELSE BEGIN SPRINT cr_after ~%cr_after%%cr_record%~ END
          END
        END
      END
      SPRINT cr_slice ~%cr_before%~
      PATCH_FOR_EACH new_op IN 321 206 BEGIN
        FOR (cr_k=0;cr_k<cr_np;++cr_k) BEGIN
          SPRINT paired $cbr_cr_rp(~%cr_r%~ ~%cr_k%~)
          INNER_PATCH_SAVE cr_record ~%cr_template%~ BEGIN
            WRITE_SHORT 0 new_op WRITE_LONG 4 0 WRITE_LONG 8 0 WRITE_BYTE 0xc 1 WRITE_LONG 0xe 0
            WRITE_ASCIIE 0x14 ~%paired%~ #8 WRITE_LONG 0x1c 0 WRITE_LONG 0x20 0 WRITE_LONG 0x2c 0
            PATCH_IF new_op=206 BEGIN WRITE_BYTE 0xc 0 WRITE_LONG 4 (0 - 1) WRITE_LONG 0xe cr_dur END
          END
          SPRINT cr_slice ~%cr_slice%%cr_record%~
        END
      END
      SPRINT cr_slice ~%cr_slice%%cr_after%~ LPM cbr_cr_output_ability
    END
    LPM cbr_cr_write
  END
END


DEFINE_ACTION_MACRO cbr_cr_prayer_recitation_part
BEGIN
  OUTER_SET cr_ntxt=0 OUTER_SPRINT cr_prefix ~SPPR~ OUTER_SET cr_base=1000 OUTER_SPRINT cr_symbol ~CLERIC_PRAYER~ LAM cbr_cr_resolve OUTER_SPRINT cr_prayer ~%cr_anchor%~
  ACTION_IF cr_found BEGIN OUTER_SPRINT cr_symbol ~CLERIC_RECITATION~ LAM cbr_cr_resolve OUTER_SPRINT cr_recitation ~%cr_anchor%~ END
  ACTION_IF cr_found BEGIN
    OUTER_SPRINT cr_role ~prayer~ OUTER_SPRINT cr_anchor ~%cr_prayer%~ LAM cbr_cr_payloads
    OUTER_SPRINT cr_role ~recitation~ OUTER_SPRINT cr_anchor ~%cr_recitation%~ LAM cbr_cr_payloads
    OUTER_SPRINT cr_pairs ~~
    OUTER_FOR (cr_s=1;cr_s<3;++cr_s) BEGIN
      OUTER_FOR (cr_ri=0;cr_ri<$cbr_cr_payn(~recitation~ ~%cr_s%~);++cr_ri) BEGIN
        OUTER_SPRINT cr_r $cbr_cr_pay(~recitation~ ~%cr_s%~ ~%cr_ri%~)
        OUTER_SET cr_np=$cbr_cr_payn(~prayer~ ~%cr_s%~)
        OUTER_FOR (cr_pi=0;cr_pi<cr_np;++cr_pi) BEGIN
          OUTER_SPRINT cr_p $cbr_cr_pay(~prayer~ ~%cr_s%~ ~%cr_pi%~) OUTER_SPRINT $cbr_cr_rp(~%cr_r%~ ~%cr_pi%~) ~%cr_p%~
          ACTION_IF STRING_LENGTH ~%cr_pairs%~>0 BEGIN OUTER_SPRINT cr_pairs ~%cr_pairs%, ~ END
          OUTER_SPRINT cr_pairs ~%cr_pairs%%cr_r% replaces %cr_p%~
        END
        OUTER_SET $cbr_cr_rpn(~%cr_r%~)=cr_np
        COPY_EXISTING ~%cr_r%.SPL~ ~override~ LPM cbr_cr_recitation_patch BUT_ONLY
      END
    END
    ACTION_FOR_EACH cr_kind IN prayer recitation BEGIN
      OUTER_SPRINT cr_anchor ~%cr_prayer%~ ACTION_IF ~%cr_kind%~ STR_EQ ~recitation~ BEGIN OUTER_SPRINT cr_anchor ~%cr_recitation%~ END
      COPY_EXISTING ~%cr_anchor%.SPL~ ~override~ LPM cbr_cr_note_description BUT_ONLY
      OUTER_SET cbr_cr_gen+=1 OUTER_SET $cbr_cr_member(~%cr_anchor%~)=cbr_cr_gen
      LAM cbr_cr_item_descriptions
    END
    PRINT @3403
  END
  LAM cbr_cr_report_skip
END


DEFINE_ACTION_FUNCTION cbr_install_chris_revisions
BEGIN
  ACTION_IF NOT VARIABLE_IS_SET cbr_cr_gen BEGIN OUTER_SET cbr_cr_gen=0 END
  OUTER_SET cr_check = 0
  OUTER_SET cr_record = 0
  OUTER_SET cr_teach_scan = 0
  OUTER_SPRINT cr_nl ~x~
  OUTER_INNER_PATCH_SAVE cr_nl ~%cr_nl%~ BEGIN WRITE_BYTE 0 10 END

  OUTER_SPRINT cr_what ~Aid~
  OUTER_SPRINT cr_kind ~aid~
  OUTER_SPRINT cr_symbol ~CLERIC_AID~
  OUTER_SPRINT cr_prefix ~SPPR~
  OUTER_SET cr_base = 1000
  LAM cbr_cr_family_part

  OUTER_SPRINT cr_what ~Luck~
  OUTER_SPRINT cr_kind ~luck~
  OUTER_SPRINT cr_symbol ~WIZARD_LUCK~
  OUTER_SPRINT cr_prefix ~SPWI~
  OUTER_SET cr_base = 2000
  LAM cbr_cr_family_part

  OUTER_SPRINT cr_what ~Bless~
  OUTER_SPRINT cr_kind ~bless~
  OUTER_SPRINT cr_symbol ~CLERIC_BLESS~
  OUTER_SPRINT cr_prefix ~SPPR~
  OUTER_SET cr_base = 1000
  LAM cbr_cr_family_part

  OUTER_SPRINT cr_what ~Bless for druids~
  OUTER_SPRINT cr_spell ~Bless~
  OUTER_SPRINT cr_symbol ~CLERIC_BLESS~
  OUTER_SPRINT cr_prefix ~SPPR~
  OUTER_SET cr_base = 1000
  LAM cbr_cr_druid_part

  OUTER_SPRINT cr_what ~Chaotic Commands~
  OUTER_SPRINT cr_spell ~Chaotic Commands~
  OUTER_SPRINT cr_symbol ~CLERIC_CHAOTIC_COMMANDS~
  OUTER_SPRINT cr_prefix ~SPPR~
  OUTER_SET cr_base = 1000
  LAM cbr_cr_druid_part

  OUTER_SPRINT cr_what ~Prayer and Recitation~
  LAM cbr_cr_prayer_recitation_part
END
