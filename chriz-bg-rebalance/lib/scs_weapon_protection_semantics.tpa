// SCS / SR weapon-protection metadata and common-mage script repair.
// Own MoP's false weapon/dispelling markers and its use in preparation,
// renewal and Chain Contingency. Ordinary MoP casts and gameplay effects stay.
// Compiled-block splitting follows DavidW's SCS sfo2e/alter_script.tph.
DEFINE_PATCH_FUNCTION cbr_scs_wp_validate_spl_v1
  STR_VAR resource_name = ~unknown SPL~
  RET ability_offset ability_count effect_offset effect_count readable
BEGIN
  SET ability_offset = 0 SET ability_count = 0 SET effect_offset = 0 SET effect_count = 0
  SET readable = BUFFER_LENGTH >= 0x72
  PATCH_IF readable BEGIN
    READ_LONG 0x64 ability_offset READ_SHORT 0x68 ability_count
    READ_LONG 0x6a effect_offset READ_SHORT 0x6e wp_first READ_SHORT 0x70 wp_count
    SET readable = ability_offset >= 0x72 AND ability_offset + ability_count * 40 <= BUFFER_LENGTH
      AND effect_offset >= 0x72 AND effect_offset <= BUFFER_LENGTH
    SET effect_count = wp_first + wp_count
    FOR (wp_a = 0; readable AND wp_a < ability_count; ++wp_a) BEGIN
      READ_SHORT (ability_offset + wp_a * 40 + 0x1e) wp_count
      READ_SHORT (ability_offset + wp_a * 40 + 0x20) wp_first
      SET effect_count = (effect_count > wp_first + wp_count ? effect_count : wp_first + wp_count)
    END
    SET readable = readable AND effect_offset + effect_count * 48 <= BUFFER_LENGTH
  END
  PATCH_IF NOT readable BEGIN
    SET ability_count = 0 SET effect_count = 0
    PATCH_PRINT ~CBR SCS: unreadable spell tables in %resource_name%; continuing.~
  END
END

// This public query describes an arbitrary spell; it never rejects variant
// targets, durations, effect fields or shared slices. Owned candidate identities
// are chosen by the caller, independently of this diagnostic query.
DEFINE_PATCH_FUNCTION cbr_scs_wp_classify_spell
  STR_VAR resource_name = ~unknown SPL~
  RET is_weapon_protection
BEGIN
  SET is_weapon_protection = 0
  LPF cbr_scs_wp_validate_spl_v1 STR_VAR resource_name
    RET ability_offset ability_count effect_offset effect_count END
  FOR (wp_i = 0; wp_i < effect_count; ++wp_i) BEGIN
    READ_SHORT (effect_offset + 48 * wp_i) wp_op
    PATCH_IF wp_op = 120 BEGIN SET is_weapon_protection = 1 END
  END
END

DEFINE_ACTION_FUNCTION cbr_scs_wp_classify_file
  STR_VAR resource_path = ~~ resource_name = ~~
  RET is_weapon_protection
BEGIN
  OUTER_SPRINT resource_path EVALUATE_BUFFER ~%resource_path%~
  OUTER_SPRINT resource_name EVALUATE_BUFFER ~%resource_name%~
  OUTER_SET is_weapon_protection = 0
  ACTION_IF FILE_EXISTS ~%resource_path%~ BEGIN
    COPY ~%resource_path%~ ~%resource_path%~
      LPF cbr_scs_wp_classify_spell STR_VAR resource_name RET is_weapon_protection END
    BUT_ONLY
  END ELSE BEGIN PRINT ~CBR SCS: %resource_name% is absent; continuing.~ END
END

DEFINE_PATCH_FUNCTION cbr_scs_wp_parse_spell_ids
  RET pfmw_number mantle_number improved_number mop_number absolute_number breach_number dispel_number
BEGIN
  SET pfmw_number = 0 SET mantle_number = 0 SET improved_number = 0 SET mop_number = 0
  SET absolute_number = 0 SET breach_number = 0 SET dispel_number = 0
  READ_ASCII 0 wp_ids (BUFFER_LENGTH)
  INNER_PATCH ~%wp_ids%~ BEGIN
    REPLACE_EVALUATE CASE_INSENSITIVE
      ~^\([0-9][0-9]*\)[ %TAB%]+\([^ %TAB%%WNL%%MNL%%LNL%]+\)~
    BEGIN
      SET wp_number = MATCH1 SPRINT wp_symbol ~%MATCH2%~ TO_UPPER wp_symbol
      PATCH_IF ~%wp_symbol%~ STR_EQ ~WIZARD_PROTECTION_FROM_MAGIC_WEAPONS~ BEGIN SET pfmw_number = wp_number END
      PATCH_IF ~%wp_symbol%~ STR_EQ ~WIZARD_MANTLE~ BEGIN SET mantle_number = wp_number END
      PATCH_IF ~%wp_symbol%~ STR_EQ ~WIZARD_IMPROVED_MANTLE~ BEGIN SET improved_number = wp_number END
      PATCH_IF ~%wp_symbol%~ STR_EQ ~WIZARD_MOMENT_OF_PRESCIENCE~ BEGIN SET mop_number = wp_number END
      PATCH_IF ~%wp_symbol%~ STR_EQ ~WIZARD_ABSOLUTE_IMMUNITY~ BEGIN SET absolute_number = wp_number END
      PATCH_IF ~%wp_symbol%~ STR_EQ ~WIZARD_BREACH~ BEGIN SET breach_number = wp_number END
      PATCH_IF ~%wp_symbol%~ STR_EQ ~WIZARD_DISPEL_MAGIC~ BEGIN SET dispel_number = wp_number END
    END ~~
  END
END

DEFINE_ACTION_FUNCTION cbr_scs_wp_read_spell_ids
  STR_VAR spell_ids = ~~
  RET pfmw_number mantle_number improved_number mop_number absolute_number breach_number dispel_number
BEGIN
  OUTER_SPRINT spell_ids EVALUATE_BUFFER ~%spell_ids%~
  OUTER_SET pfmw_number = 0 OUTER_SET mantle_number = 0 OUTER_SET improved_number = 0 OUTER_SET mop_number = 0
  OUTER_SET absolute_number = 0 OUTER_SET breach_number = 0 OUTER_SET dispel_number = 0
  ACTION_IF FILE_EXISTS ~%spell_ids%~ BEGIN
    COPY ~%spell_ids%~ ~%spell_ids%~
      LPF cbr_scs_wp_parse_spell_ids
        RET pfmw_number mantle_number improved_number mop_number absolute_number breach_number dispel_number END
    BUT_ONLY
  END ELSE BEGIN PRINT ~CBR SCS: %spell_ids% is absent; continuing.~ END
END

DEFINE_PATCH_FUNCTION cbr_scs_wp_remove_metadata
  INT_VAR keep_breach_state = 1 keep_dispel_state = 0
  STR_VAR resource_name = ~Moment of Prescience~
  RET removed
BEGIN
  SET removed = 0
  LPF cbr_scs_wp_validate_spl_v1 STR_VAR resource_name
    RET ability_offset ability_count effect_offset effect_count END
  FOR (wp_i = effect_count - 1; wp_i >= 0; --wp_i) BEGIN
    SET wp_at = effect_offset + 48 * wp_i
    READ_SHORT wp_at wp_op READ_LONG (wp_at + 8) wp_key
    PATCH_IF (wp_op = 233 AND wp_key = 128)
      OR (wp_op = 328 AND (wp_key = 64 OR (wp_key = 188 AND NOT keep_dispel_state)
        OR (wp_key = 187 AND NOT keep_breach_state))) BEGIN
      READ_SHORT 0x6e wp_first READ_SHORT 0x70 wp_count
      PATCH_IF wp_i >= wp_first AND wp_i < wp_first + wp_count BEGIN WRITE_SHORT 0x70 (wp_count - 1) END
      ELSE PATCH_IF wp_first > wp_i BEGIN WRITE_SHORT 0x6e (wp_first - 1) END
      FOR (wp_a = 0; wp_a < ability_count; ++wp_a) BEGIN
        SET wp_header = ability_offset + 40 * wp_a
        READ_SHORT (wp_header + 0x1e) wp_count READ_SHORT (wp_header + 0x20) wp_first
        PATCH_IF wp_i >= wp_first AND wp_i < wp_first + wp_count BEGIN WRITE_SHORT (wp_header + 0x1e) (wp_count - 1) END
        ELSE PATCH_IF wp_first > wp_i BEGIN WRITE_SHORT (wp_header + 0x20) (wp_first - 1) END
      END
      DELETE_BYTES wp_at 48
      PATCH_IF wp_at < ability_offset BEGIN
        SET ability_offset -= 48 WRITE_LONG 0x64 ability_offset
      END
      ++removed
    END
  END
END

// Block ownership uses the preparation/renewal/chain identities, never old
// timer values, trigger counts, line counts, difficulty settings or action order.
DEFINE_PATCH_FUNCTION cbr_scs_wp_classify_baf_block
  RET shape
BEGIN
  SET shape = 0
  PATCH_IF INDEX_BUFFER (~WIZARD_MOMENT_OF_PRESCIENCE~) >= 0
    OR INDEX_BUFFER (~WIZARD_IMPROVED_MANTLE~) >= 0 BEGIN
    PATCH_IF INDEX_BUFFER (~ChainContingencyFired~) >= 0
      OR INDEX_BUFFER (~ReallyForceSpellRES("dw#cc~) >= 0 BEGIN SET shape = 3 END
    ELSE PATCH_IF INDEX_BUFFER (~justdonepmw~) >= 0 BEGIN SET shape = 2 END
    ELSE PATCH_IF INDEX_BUFFER (~instantprep~) >= 0 BEGIN SET shape = 1 END
  END
END

DEFINE_PATCH_FUNCTION cbr_scs_wp_transform_bcs
  INT_VAR apply = 0 false_spell_number = 0
  STR_VAR replacement_symbol = ~~ script_name = ~unknown BCS~
  RET first_round_removed renewal_removed chain_replaced unknown_blocks
BEGIN
  SET first_round_removed = 0 SET renewal_removed = 0 SET chain_replaced = 0 SET unknown_blocks = 0
  SET wp_bcs_readable = 1
  // Work in memory so unreadable scripts alone remain unchanged.
  INNER_PATCH_SAVE wp_changed ~~ BEGIN END
  SPRINT wp_blocks ~~
  READ_ASCII 0 wp_original (BUFFER_LENGTH)
  INNER_PATCH ~%wp_original%~ BEGIN
    SET wp_start = INDEX_BUFFER (~CR%LNL%~)
    WHILE (wp_bcs_readable AND wp_start >= 0) BEGIN
      SET wp_end = INDEX_BUFFER (~RS%LNL%CR%LNL%~ wp_start)
      PATCH_IF wp_end < wp_start BEGIN SET wp_bcs_readable = 0 END
      ELSE BEGIN
        SET wp_length = wp_end - wp_start + 6
        READ_ASCII wp_start wp_block (wp_length)
        INNER_PATCH_SAVE wp_baf ~SC%LNL%%wp_block%SC%LNL%~ BEGIN
          PATCH_TRY DECOMPILE_BCS_TO_BAF
          WITH DEFAULT SET wp_bcs_readable = 0 END
        END
        SET wp_shape = 0
        PATCH_IF wp_bcs_readable AND (INDEX (~%false_spell_number%~ ~%wp_block%~)) >= 0 BEGIN
          INNER_PATCH ~%wp_baf%~ BEGIN
            LPF cbr_scs_wp_classify_baf_block RET wp_shape = shape END
          END
        END
        PATCH_IF wp_shape = 1 BEGIN ++first_round_removed SPRINT wp_block ~~ END
        ELSE PATCH_IF wp_shape = 2 BEGIN ++renewal_removed SPRINT wp_block ~~ END
        ELSE PATCH_IF wp_shape = 3 BEGIN
          ++chain_replaced
          // An absent optional replacement removes the false cast only.
          INNER_PATCH_SAVE wp_baf ~%wp_baf%~ BEGIN
            PATCH_IF ~%replacement_symbol%~ STR_EQ ~~ BEGIN
              REPLACE_TEXTUALLY CASE_INSENSITIVE ~^.*\(WIZARD_MOMENT_OF_PRESCIENCE\|WIZARD_IMPROVED_MANTLE\).*%LNL%~ ~~
            END ELSE BEGIN
              REPLACE_TEXTUALLY CASE_INSENSITIVE ~WIZARD_MOMENT_OF_PRESCIENCE~ ~%replacement_symbol%~
              PATCH_IF false_spell_number = IDS_OF_SYMBOL (~spell~ ~WIZARD_IMPROVED_MANTLE~) BEGIN
                REPLACE_TEXTUALLY CASE_INSENSITIVE ~WIZARD_IMPROVED_MANTLE~ ~%replacement_symbol%~
              END
            END
            COMPILE_BAF_TO_BCS
            SET wp_compiled_start = INDEX_BUFFER (~CR%LNL%~)
            SET wp_compiled_end = INDEX_BUFFER (~RS%LNL%CR%LNL%~)
            SET wp_compiled_length = wp_compiled_end - wp_compiled_start + 6
            READ_ASCII wp_compiled_start wp_block (wp_compiled_length)
          END
        END
        SPRINT wp_blocks ~%wp_blocks%%wp_block%~
        DELETE_BYTES wp_start wp_length
        SET wp_start = INDEX_BUFFER (~CR%LNL%~)
      END
    END
    // The remaining SC delimiters are container syntax, not a content fingerprint.
    PATCH_IF BUFFER_LENGTH != 6 BEGIN SET wp_bcs_readable = 0 END
    ELSE BEGIN
      READ_ASCII 0 wp_wrapper (6)
      PATCH_IF NOT (~%wp_wrapper%~ STRING_EQUAL ~SC%LNL%SC%LNL%~) BEGIN SET wp_bcs_readable = 0 END
    END
  END
  PATCH_IF wp_bcs_readable AND apply BEGIN
    SPRINT wp_changed ~SC%LNL%%wp_blocks%SC%LNL%~
    DELETE_BYTES 0 BUFFER_LENGTH INSERT_BYTES 0 (STRING_LENGTH ~%wp_changed%~)
    WRITE_ASCIIE 0 ~%wp_changed%~
  END ELSE PATCH_IF NOT wp_bcs_readable BEGIN
    SET first_round_removed = 0 SET renewal_removed = 0 SET chain_replaced = 0
    PATCH_PRINT ~CBR SCS: unreadable script %script_name%; leaving this file unchanged.~
  END
END

DEFINE_ACTION_FUNCTION cbr_scs_wp_scan_scripts
  INT_VAR
    apply = 0
    false_spell_number = 0
  STR_VAR
    script_dir = ~~
    replacement_symbol = ~~
  RET
    script_count
    first_round_removed
    renewal_removed
    chain_replaced
    unknown_blocks
BEGIN
  OUTER_SPRINT script_dir EVALUATE_BUFFER ~%script_dir%~
  OUTER_SPRINT replacement_symbol EVALUATE_BUFFER ~%replacement_symbol%~
  OUTER_SET script_count = 0
  OUTER_SET first_round_removed = 0
  OUTER_SET renewal_removed = 0
  OUTER_SET chain_replaced = 0
  OUTER_SET unknown_blocks = 0
  ACTION_IF (FILE_EXISTS ~%script_dir%~) BEGIN
    ACTION_BASH_FOR ~%script_dir%~ ~^dw#mg[0-9]+\.bcs$~ BEGIN
      OUTER_SET script_count += 1
      COPY ~%BASH_FOR_FILESPEC%~ ~%BASH_FOR_FILESPEC%~
        LPF cbr_scs_wp_transform_bcs
          INT_VAR
            apply = apply
            false_spell_number = false_spell_number
          STR_VAR
            replacement_symbol = EVAL ~%replacement_symbol%~
            script_name = EVAL ~%BASH_FOR_FILE%~
          RET
            cbr_scs_wp_patch_first = first_round_removed
            cbr_scs_wp_patch_renewal = renewal_removed
            cbr_scs_wp_patch_chain = chain_replaced
            cbr_scs_wp_patch_unknown = unknown_blocks
        END
        INNER_ACTION BEGIN
          OUTER_SET first_round_removed += cbr_scs_wp_patch_first
          OUTER_SET renewal_removed += cbr_scs_wp_patch_renewal
          OUTER_SET chain_replaced += cbr_scs_wp_patch_chain
          OUTER_SET unknown_blocks += cbr_scs_wp_patch_unknown
        END
      BUT_ONLY
    END
  END
END


DEFINE_ACTION_FUNCTION cbr_apply_scs_weapon_protection_semantics
  STR_VAR resource_dir = ~~ script_dir = ~~ spell_ids = ~~ phase = ~full~ probe_resref = ~NONE~
  RET probe_is_protection mismatch_detected candidate_order replacement_resref
    metadata_removed first_round_removed renewal_removed chain_replaced unknown_blocks
BEGIN
  OUTER_SPRINT resource_dir EVALUATE_BUFFER ~%resource_dir%~
  OUTER_SPRINT script_dir EVALUATE_BUFFER ~%script_dir%~
  OUTER_SPRINT spell_ids EVALUATE_BUFFER ~%spell_ids%~
  OUTER_SPRINT phase EVALUATE_BUFFER ~%phase%~
  OUTER_SPRINT probe_resref EVALUATE_BUFFER ~%probe_resref%~
  ACTION_IF ~%resource_dir%~ STR_EQ ~~ OR ~%script_dir%~ STR_EQ ~~ OR ~%spell_ids%~ STR_EQ ~~ BEGIN
    FAIL ~CBR SCS: explicit paths are required by the caller.~
  END
  ACTION_IF NOT (~%phase%~ STR_EQ ~classify~ OR ~%phase%~ STR_EQ ~metadata~
    OR ~%phase%~ STR_EQ ~scripts~ OR ~%phase%~ STR_EQ ~full~ OR ~%phase%~ STR_EQ ~preflight~) BEGIN
    FAIL ~CBR SCS: invalid caller phase.~
  END
  OUTER_SET probe_is_protection = 0 OUTER_SET mismatch_detected = 0
  OUTER_SPRINT candidate_order ~~ OUTER_SPRINT replacement_resref ~~ OUTER_SPRINT wp_replacement ~~
  OUTER_SET metadata_removed = 0 OUTER_SET first_round_removed = 0
  OUTER_SET renewal_removed = 0 OUTER_SET chain_replaced = 0 OUTER_SET unknown_blocks = 0
  LAF cbr_scs_wp_read_spell_ids STR_VAR spell_ids
    RET pfmw_number mantle_number improved_number mop_number absolute_number breach_number dispel_number END
  // The component defines MoP as outside the weapon-protection ladder.
  // Preserve the ladder order and choose Mantle, then PFMW, by resource identity.
  ACTION_CLEAR_ARRAY wp_candidates
  ACTION_FOR_EACH wp_kind IN absolute improved mantle pfmw BEGIN
    OUTER_SET wp_number = EVAL ~%wp_kind%_number~
    ACTION_IF wp_number >= 2000 AND wp_number < 3000 AND wp_number != mop_number BEGIN
      OUTER_SET wp_slot = wp_number - 2000 OUTER_SPRINT wp_res ~SPWI%wp_slot%~
      ACTION_IF wp_slot < 100 BEGIN OUTER_SPRINT wp_res ~SPWI0%wp_slot%~ END
      ACTION_IF wp_slot < 10 BEGIN OUTER_SPRINT wp_res ~SPWI00%wp_slot%~ END
      ACTION_IF FILE_EXISTS ~%resource_dir%/%wp_res%.SPL~ BEGIN
        ACTION_IF NOT VARIABLE_IS_SET $wp_candidates(~%wp_res%~) BEGIN
          OUTER_SET $wp_candidates(~%wp_res%~) = 1
          ACTION_IF ~%candidate_order%~ STR_EQ ~~ BEGIN OUTER_SPRINT candidate_order ~%wp_res%~ END
          ELSE BEGIN OUTER_SPRINT candidate_order ~%candidate_order%,%wp_res%~ END
        END
        ACTION_IF ~%replacement_resref%~ STR_EQ ~~ BEGIN
          ACTION_IF ~%wp_kind%~ STR_EQ ~mantle~ BEGIN
            OUTER_SPRINT replacement_resref ~%wp_res%~ OUTER_SPRINT wp_replacement ~WIZARD_MANTLE~
          END ELSE ACTION_IF ~%wp_kind%~ STR_EQ ~pfmw~ BEGIN
            OUTER_SPRINT replacement_resref ~%wp_res%~ OUTER_SPRINT wp_replacement ~WIZARD_PROTECTION_FROM_MAGIC_WEAPONS~
          END
        END
      END ELSE BEGIN PRINT ~CBR SCS: %wp_res%.SPL is absent; continuing.~ END
    END
  END
  ACTION_IF mop_number >= 2000 AND mop_number < 3000 BEGIN OUTER_SET mismatch_detected = 1 END
  ACTION_IF ~%phase%~ STR_EQ ~classify~ BEGIN
    ACTION_IF ~%probe_resref%~ STR_EQ ~~ OR ~%probe_resref%~ STR_EQ ~NONE~ BEGIN
      FAIL ~CBR SCS: classify requires a probe argument.~
    END
    LAF cbr_scs_wp_classify_file STR_VAR resource_path = EVAL ~%resource_dir%/%probe_resref%.SPL~
      resource_name = EVAL ~%probe_resref%~ RET probe_is_protection = is_weapon_protection END
  END ELSE ACTION_IF mismatch_detected BEGIN
    OUTER_SET wp_slot = mop_number - 2000 OUTER_SPRINT wp_target ~SPWI%wp_slot%~
    ACTION_IF wp_slot < 100 BEGIN OUTER_SPRINT wp_target ~SPWI0%wp_slot%~ END
    ACTION_IF wp_slot < 10 BEGIN OUTER_SPRINT wp_target ~SPWI00%wp_slot%~ END
    ACTION_IF ~%phase%~ STR_EQ ~metadata~ OR ~%phase%~ STR_EQ ~full~ BEGIN
      ACTION_IF FILE_EXISTS ~%resource_dir%/%wp_target%.SPL~ BEGIN
        COPY ~%resource_dir%/%wp_target%.SPL~ ~%resource_dir%/%wp_target%.SPL~
          LPF cbr_scs_wp_remove_metadata STR_VAR resource_name = EVAL ~%wp_target%~ RET metadata_removed = removed END
        BUT_ONLY
      END ELSE BEGIN PRINT ~CBR SCS: %wp_target%.SPL is absent; continuing.~ END
    END
    ACTION_IF ~%phase%~ STR_EQ ~scripts~ OR ~%phase%~ STR_EQ ~full~ OR ~%phase%~ STR_EQ ~preflight~ BEGIN
      LAF cbr_scs_wp_scan_scripts INT_VAR apply = NOT (~%phase%~ STR_EQ ~preflight~) false_spell_number = mop_number
        STR_VAR script_dir replacement_symbol = EVAL ~%wp_replacement%~
        RET first_round_removed renewal_removed chain_replaced unknown_blocks END
    END
  END ELSE BEGIN PRINT ~CBR SCS: Moment of Prescience is absent from SPELL.IDS; continuing.~ END
END
