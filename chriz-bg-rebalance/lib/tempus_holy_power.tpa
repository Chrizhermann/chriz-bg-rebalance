// Tempus owns its Holy Power progression and private helper resources. Rebuild
// those definitions on every application. Divine Power and Improved Haste keep
// their unrelated effects; only Tempus interaction effects are replaced.

// Bounds needed to read SPL slices, without imposing a storage order, partition,
// ability count, effect count, or padding convention. An unreadable target costs
// only that file. Callers that change a foreign spell inspect readable first.
DEFINE_PATCH_FUNCTION cbr_validate_spl_v1
  STR_VAR resource_name = ~unknown SPL~
  RET ability_offset ability_count effect_offset effect_count readable
BEGIN
  SET ability_offset = 0 SET ability_count = 0
  SET effect_offset = 0 SET effect_count = 0 SET readable = 0
  PATCH_IF BUFFER_LENGTH >= 0x72 BEGIN
    READ_LONG 0x64 ability_offset READ_SHORT 0x68 ability_count
    READ_LONG 0x6a effect_offset
    SET readable = (ability_count = 0 OR (ability_offset >= 0x72 AND ability_offset <= BUFFER_LENGTH
      AND ability_count <= (BUFFER_LENGTH - ability_offset) / 0x28))
    PATCH_IF readable BEGIN
      SET effect_count = 0
      PATCH_IF effect_offset >= 0x72 AND effect_offset <= BUFFER_LENGTH BEGIN
        SET effect_count = (BUFFER_LENGTH - effect_offset) / 0x30
      END
      FOR (cbr_r_a = (0 - 1); cbr_r_a < ability_count; ++cbr_r_a) BEGIN
        SET cbr_r_at = 0x6e
        PATCH_IF cbr_r_a >= 0 BEGIN SET cbr_r_at = ability_offset + cbr_r_a * 0x28 + 0x1e END
        PATCH_IF cbr_r_a < 0 BEGIN
          READ_SHORT cbr_r_at cbr_r_first READ_SHORT (cbr_r_at + 2) cbr_r_n
        END ELSE BEGIN
          READ_SHORT cbr_r_at cbr_r_n READ_SHORT (cbr_r_at + 2) cbr_r_first
        END
        PATCH_IF cbr_r_n > 0 AND cbr_r_first + cbr_r_n > effect_count BEGIN SET readable = 0 END
      END
    END
  END
  PATCH_IF NOT readable BEGIN
    PATCH_PRINT ~CBR: cannot read the spell tables in %resource_name%; leaving this file unchanged.~
    SET ability_offset = 0 SET ability_count = 0 SET effect_offset = 0 SET effect_count = 0
  END
END

// Put readable slices in header/abilities/effects order before editing. Shared
// slices receive independent copies. Orphan bytes are not executable effects.
DEFINE_PATCH_FUNCTION cbr_tempus_repack_spl
  INT_VAR default_target = 5
BEGIN
  READ_LONG 0x64 cbr_pk_ab READ_SHORT 0x68 cbr_pk_na READ_LONG 0x6a cbr_pk_fx
  READ_SHORT 0x6e cbr_pk_cf READ_SHORT 0x70 cbr_pk_cn
  READ_ASCII 0 cbr_pk_header (0x72)
  SPRINT cbr_pk_cast ~~
  PATCH_IF cbr_pk_cn > 0 BEGIN
    READ_ASCII (cbr_pk_fx + cbr_pk_cf * 0x30) cbr_pk_cast (cbr_pk_cn * 0x30)
  END
  FOR (cbr_pk_a = 0; cbr_pk_a < cbr_pk_na; ++cbr_pk_a) BEGIN
    SET cbr_pk_at = cbr_pk_ab + cbr_pk_a * 0x28
    READ_ASCII cbr_pk_at $cbr_pk_header(~%cbr_pk_a%~) (0x28)
    READ_SHORT (cbr_pk_at + 0x1e) cbr_pk_n READ_SHORT (cbr_pk_at + 0x20) cbr_pk_first
    SET $cbr_pk_n(~%cbr_pk_a%~) = cbr_pk_n
    SPRINT $cbr_pk_effects(~%cbr_pk_a%~) ~~
    PATCH_IF cbr_pk_n > 0 BEGIN
      READ_ASCII (cbr_pk_fx + cbr_pk_first * 0x30) $cbr_pk_effects(~%cbr_pk_a%~) (cbr_pk_n * 0x30)
    END
  END
  DELETE_BYTES 0 BUFFER_LENGTH
  SET cbr_pk_out_na = (cbr_pk_na > 0 ? cbr_pk_na : 1)
  INSERT_BYTES 0 (0x72 + cbr_pk_out_na * 0x28)
  WRITE_ASCIIE 0 ~%cbr_pk_header%~ (0x72)
  WRITE_ASCII 0 ~SPL V1  ~ #8
  WRITE_LONG 0x64 0x72 WRITE_SHORT 0x68 cbr_pk_out_na
  WRITE_LONG 0x6a (0x72 + cbr_pk_out_na * 0x28)
  WRITE_SHORT 0x6e 0 WRITE_SHORT 0x70 cbr_pk_cn
  INSERT_BYTES BUFFER_LENGTH (cbr_pk_cn * 0x30)
  WRITE_ASCIIE (0x72 + cbr_pk_out_na * 0x28) ~%cbr_pk_cast%~ (cbr_pk_cn * 0x30)
  SET cbr_pk_index = cbr_pk_cn
  FOR (cbr_pk_a = 0; cbr_pk_a < cbr_pk_out_na; ++cbr_pk_a) BEGIN
    SET cbr_pk_at = 0x72 + cbr_pk_a * 0x28
    PATCH_IF cbr_pk_a < cbr_pk_na BEGIN
      SPRINT cbr_pk_h $cbr_pk_header(~%cbr_pk_a%~)
      SPRINT cbr_pk_e $cbr_pk_effects(~%cbr_pk_a%~)
      SET cbr_pk_n = $cbr_pk_n(~%cbr_pk_a%~)
      WRITE_ASCIIE cbr_pk_at ~%cbr_pk_h%~ (0x28)
      SET cbr_pk_end = BUFFER_LENGTH
      INSERT_BYTES cbr_pk_end (cbr_pk_n * 0x30)
      WRITE_ASCIIE cbr_pk_end ~%cbr_pk_e%~ (cbr_pk_n * 0x30)
    END ELSE BEGIN
      SET cbr_pk_n = 0
      WRITE_SHORT cbr_pk_at 1 WRITE_SHORT (cbr_pk_at + 2) 4
      WRITE_BYTE (cbr_pk_at + 0xc) default_target
      WRITE_BYTE (cbr_pk_at + 0xd) 1 WRITE_SHORT (cbr_pk_at + 0x10) 1
      WRITE_SHORT (cbr_pk_at + 0x22) 1 WRITE_SHORT (cbr_pk_at + 0x24) 1
      WRITE_SHORT (cbr_pk_at + 0x26) 1
    END
    WRITE_SHORT (cbr_pk_at + 0x1e) cbr_pk_n
    WRITE_SHORT (cbr_pk_at + 0x20) cbr_pk_index
    SET cbr_pk_index += cbr_pk_n
  END
END

// Read delivery links to select auto mode, never to admit or reject an install.
// Repeated resources and absent links end that branch. Forced modes are choices.
DEFINE_ACTION_FUNCTION cbr_tempus_haste_graph
  STR_VAR resource_dir = ~~ resref = ~~ extension = ~SPL~ visited = ~|~
  RET additive doubling
BEGIN
  OUTER_SET additive = 0 OUTER_SET doubling = 0
  ACTION_TO_UPPER resref ACTION_TO_UPPER extension
  OUTER_SET cbr_seen = 0
  OUTER_PATCH ~%visited%~ BEGIN
    REPLACE_EVALUATE ~[^|]+~ BEGIN
      PATCH_IF ~%MATCH0%~ STRING_EQUAL_CASE ~%resref%.%extension%~ BEGIN SET cbr_seen = 1 END
    END ~%MATCH0%~
  END
  ACTION_IF NOT (~%resref%~ STRING_EQUAL ~~) AND NOT cbr_seen BEGIN
    OUTER_SPRINT visited ~%visited%%resref%.%extension%|~
    ACTION_IF FILE_EXISTS ~%resource_dir%/%resref%.%extension%~ BEGIN
      COPY ~%resource_dir%/%resref%.%extension%~ ~%resource_dir%/%resref%.%extension%~
        LPF cbr_tempus_haste_graph_buffer
          STR_VAR resource_dir resref extension visited RET additive doubling END
      BUT_ONLY
    END ELSE ACTION_IF FILE_EXISTS ~chitin.key~ AND FILE_EXISTS_IN_GAME ~%resref%.%extension%~ BEGIN
      COPY_EXISTING ~%resref%.%extension%~ ~~
        LPF cbr_tempus_haste_graph_buffer
          STR_VAR resource_dir resref extension visited RET additive doubling END
      BUT_ONLY
    END ELSE BEGIN
      PRINT ~CBR: Improved Haste link %resref%.%extension% is absent; continuing with the other branches.~
    END
  END
END

DEFINE_PATCH_FUNCTION cbr_tempus_haste_graph_buffer
  STR_VAR resource_dir = ~~ resref = ~~ extension = ~SPL~ visited = ~|~
  RET additive doubling
BEGIN
  SET additive = 0 SET doubling = 0
  SET cbr_g_n = 0
  PATCH_IF ~%extension%~ STRING_EQUAL ~EFF~ BEGIN
    PATCH_IF BUFFER_LENGTH >= 0x110 BEGIN
      READ_LONG 0x10 cbr_g_op READ_LONG 0x20 cbr_g_p2 READ_ASCII 0x30 cbr_g_res (8) NULL
      SET $cbr_g_op(0) = cbr_g_op SET $cbr_g_p2(0) = cbr_g_p2
      SPRINT $cbr_g_res(0) ~%cbr_g_res%~ SET cbr_g_n = 1
    END ELSE BEGIN PATCH_PRINT ~CBR: cannot read Improved Haste link %resref%.EFF; continuing with the other branches.~ END
  END ELSE BEGIN
    LPF cbr_validate_spl_v1 STR_VAR resource_name = EVAL ~%resref%.SPL~
      RET cbr_g_ab = ability_offset cbr_g_na = ability_count cbr_g_fx = effect_offset cbr_g_ok = readable END
    PATCH_IF cbr_g_ok BEGIN
      FOR (cbr_g_a = (0 - 1); cbr_g_a < cbr_g_na; ++cbr_g_a) BEGIN
        PATCH_IF cbr_g_a < 0 BEGIN READ_SHORT 0x6e cbr_g_first READ_SHORT 0x70 cbr_g_count END
        ELSE BEGIN
          READ_SHORT (cbr_g_ab + cbr_g_a * 0x28 + 0x1e) cbr_g_count
          READ_SHORT (cbr_g_ab + cbr_g_a * 0x28 + 0x20) cbr_g_first
        END
        FOR (cbr_g_i = 0; cbr_g_i < cbr_g_count; ++cbr_g_i) BEGIN
          SET cbr_g_at = cbr_g_fx + (cbr_g_first + cbr_g_i) * 0x30
          READ_SHORT cbr_g_at cbr_g_op READ_LONG (cbr_g_at + 8) cbr_g_p2
          READ_ASCII (cbr_g_at + 0x14) cbr_g_res (8) NULL
          SET $cbr_g_op(~%cbr_g_n%~) = cbr_g_op SET $cbr_g_p2(~%cbr_g_n%~) = cbr_g_p2
          SPRINT $cbr_g_res(~%cbr_g_n%~) ~%cbr_g_res%~ ++cbr_g_n
        END
      END
    END
  END
  FOR (cbr_g_i = 0; cbr_g_i < cbr_g_n; ++cbr_g_i) BEGIN
    SET cbr_g_op = $cbr_g_op(~%cbr_g_i%~) SET cbr_g_p2 = $cbr_g_p2(~%cbr_g_i%~)
    SPRINT cbr_g_res $cbr_g_res(~%cbr_g_i%~)
    PATCH_IF cbr_g_op = 1 BEGIN SET additive = 1 END
    PATCH_IF (cbr_g_op = 16 OR cbr_g_op = 317) AND cbr_g_p2 = 1 BEGIN SET doubling = 1 END
    PATCH_IF cbr_g_op = 146 OR cbr_g_op = 148 OR cbr_g_op = 326 OR cbr_g_op = 177 OR cbr_g_op = 272 BEGIN
      SPRINT cbr_g_ext ~SPL~
      PATCH_IF cbr_g_op = 177 OR cbr_g_op = 272 BEGIN SPRINT cbr_g_ext ~EFF~ END
      INNER_ACTION BEGIN
        LAF cbr_tempus_haste_graph STR_VAR resource_dir resref = EVAL ~%cbr_g_res%~
          extension = EVAL ~%cbr_g_ext%~ visited RET cbr_g_add = additive cbr_g_double = doubling END
      END
      SET additive = additive OR cbr_g_add SET doubling = doubling OR cbr_g_double
    END
  END
END

DEFINE_ACTION_FUNCTION cbr_classify_improved_haste_file
  STR_VAR resource_path = ~~ resource_dir = ~~ improved_haste_resref = ~~ compatibility_mode = ~auto~
  RET semantics
BEGIN
  OUTER_SPRINT resource_dir EVALUATE_BUFFER ~%resource_dir%~
  OUTER_SPRINT improved_haste_resref EVALUATE_BUFFER ~%improved_haste_resref%~
  OUTER_SPRINT compatibility_mode EVALUATE_BUFFER ~%compatibility_mode%~
  OUTER_SPRINT semantics ~double~
  ACTION_IF ~%compatibility_mode%~ STRING_EQUAL ~force_additive~ BEGIN OUTER_SPRINT semantics ~additive~ END
  ELSE ACTION_IF ~%compatibility_mode%~ STRING_EQUAL ~auto~ BEGIN
    ACTION_IF FILE_EXISTS ~%resource_dir%/%improved_haste_resref%.SPL~
      OR (FILE_EXISTS ~chitin.key~ AND FILE_EXISTS_IN_GAME ~%improved_haste_resref%.SPL~) BEGIN
      LAF cbr_tempus_haste_graph STR_VAR resource_dir resref = EVAL ~%improved_haste_resref%~ RET additive doubling END
      ACTION_IF additive AND NOT doubling BEGIN OUTER_SPRINT semantics ~additive~ END
    END
  END
END

// Private resources are created directly at their destination from inline data;
// CREATE's process-local override staging must never decide whether to write.
DEFINE_PATCH_FUNCTION cbr_tempus_blank
  INT_VAR size = 0x72
  STR_VAR signature = ~SPL V1  ~
BEGIN
  DELETE_BYTES 0 BUFFER_LENGTH INSERT_BYTES 0 size
  WRITE_ASCIIE 0 ~%signature%~ (8)
  PATCH_IF size = 0x110 BEGIN WRITE_ASCIIE 8 ~%signature%~ (8) END
END


DEFINE_PATCH_FUNCTION cbr_add_basic_self_ability
  RET
    ability_index
    ability_offset
BEGIN
  // Private helpers have no TLK metadata; write their fixed header fields.
  FOR (cbr_blank_byte = 0x08; cbr_blank_byte < 0x64; ++cbr_blank_byte) BEGIN
    WRITE_BYTE cbr_blank_byte 0
  END
  SET ability_index = 0
  SET ability_offset = 0x72
  INSERT_BYTES 0x72 0x28
  WRITE_SHORT 0x72 1
  WRITE_SHORT 0x74 4
  WRITE_BYTE  0x7e 5
  WRITE_SHORT 0x82 1
  WRITE_SHORT 0x94 1
  WRITE_SHORT 0x96 1
  WRITE_SHORT 0x98 0
  WRITE_LONG  0x64 0x72
  WRITE_SHORT 0x68 1
  WRITE_LONG  0x6a 0x9a
  WRITE_SHORT 0x6e 0
  WRITE_SHORT 0x70 0
END


DEFINE_PATCH_FUNCTION cbr_append_spl_effect_record
  INT_VAR
    opcode          = 0
    target          = 0
    power           = 0
    parameter1      = 0
    parameter2      = 0
    timing          = 0
    resist_dispel   = 0
    duration        = 0
    probability1    = 100
    probability2    = 0
    dice_number     = 0
    dice_size       = 0
    save_type       = 0
    save_bonus      = 0
    special         = 0
  STR_VAR
    resource        = ~~
  RET
    appended_offset
BEGIN
  SET appended_offset = BUFFER_LENGTH
  INSERT_BYTES appended_offset 0x30
  WRITE_SHORT appended_offset opcode
  WRITE_BYTE  (appended_offset + 0x02) target
  WRITE_BYTE  (appended_offset + 0x03) power
  WRITE_LONG  (appended_offset + 0x04) parameter1
  WRITE_LONG  (appended_offset + 0x08) parameter2
  WRITE_BYTE  (appended_offset + 0x0c) timing
  WRITE_BYTE  (appended_offset + 0x0d) resist_dispel
  WRITE_LONG  (appended_offset + 0x0e) duration
  WRITE_BYTE  (appended_offset + 0x12) probability1
  WRITE_BYTE  (appended_offset + 0x13) probability2
  WRITE_ASCIIE (appended_offset + 0x14) ~%resource%~ #8
  WRITE_LONG  (appended_offset + 0x1c) dice_number
  WRITE_LONG  (appended_offset + 0x20) dice_size
  WRITE_LONG  (appended_offset + 0x24) save_type
  WRITE_LONG  (appended_offset + 0x28) save_bonus
  WRITE_LONG  (appended_offset + 0x2c) special
END

// Copy a complete effect record without interpreting any of its fields.  A
// nonnegative duration override is used only for narrowly recognized
// source-owned visual/state effects whose lifetime follows Holy Power.


DEFINE_PATCH_FUNCTION cbr_append_raw_spl_effect_record
  INT_VAR
    source_offset     = 0
    duration_override = "-1"
  RET
    appended_offset
BEGIN
  SET appended_offset = BUFFER_LENGTH
  INSERT_BYTES appended_offset 0x30
  FOR (cbr_raw_byte = 0; cbr_raw_byte < 0x30; ++cbr_raw_byte) BEGIN
    READ_BYTE (source_offset + cbr_raw_byte) cbr_raw_value
    WRITE_BYTE (appended_offset + cbr_raw_byte) cbr_raw_value
  END
  PATCH_IF (duration_override >= 0) BEGIN
    WRITE_LONG (appended_offset + 0x0e) duration_override
  END
END

// These macros read 2DA tokens only to address rows and named columns. Missing
// columns are supplied with the table's default; unrelated cells are retained.
DEFINE_PATCH_MACRO cbr_tempus_read_table BEGIN
  SET cbr_t_lines = 0
  READ_ASCII 0 cbr_t_source (BUFFER_LENGTH)
  INNER_PATCH ~%cbr_t_source%~ BEGIN
    REPLACE_EVALUATE ~[^%WNL%%LNL%%MNL%]+~ BEGIN
      SET cbr_t_tokens = 0
      INNER_PATCH ~%MATCH0%~ BEGIN
        REPLACE_TEXTUALLY ~//.*$~ ~~
        REPLACE_EVALUATE ~[^ %TAB%]+~ BEGIN
          SPRINT $cbr_t_cell(~%cbr_t_lines%~ ~%cbr_t_tokens%~) ~%MATCH0%~
          ++cbr_t_tokens
        END ~%MATCH0%~
      END
      PATCH_IF cbr_t_tokens > 0 BEGIN
        SET $cbr_t_width(~%cbr_t_lines%~) = cbr_t_tokens ++cbr_t_lines
      END
    END ~%MATCH0%~
  END
  PATCH_IF cbr_t_lines < 3 BEGIN
    SET cbr_t_lines = 3 SET $cbr_t_width(2) = 0
    SPRINT $cbr_t_cell(1 0) ~****~
  END
  SPRINT cbr_t_default $cbr_t_cell(1 0)
  SET cbr_t_cols = $cbr_t_width(2)
  FOR (cbr_t_r = 3; cbr_t_r < cbr_t_lines; ++cbr_t_r) BEGIN
    PATCH_IF $cbr_t_width(~%cbr_t_r%~) - 1 > cbr_t_cols BEGIN SET cbr_t_cols = $cbr_t_width(~%cbr_t_r%~) - 1 END
  END
  FOR (cbr_t_c = $cbr_t_width(2); cbr_t_c < cbr_t_cols; ++cbr_t_c) BEGIN
    SPRINT $cbr_t_cell(2 ~%cbr_t_c%~) ~CBR_EXTRA_%cbr_t_c%~
  END
  FOR (cbr_t_r = 3; cbr_t_r < cbr_t_lines; ++cbr_t_r) BEGIN
    FOR (cbr_t_c = $cbr_t_width(~%cbr_t_r%~); cbr_t_c <= cbr_t_cols; ++cbr_t_c) BEGIN
      SPRINT $cbr_t_cell(~%cbr_t_r%~ ~%cbr_t_c%~) ~%cbr_t_default%~
    END
  END
END

DEFINE_PATCH_MACRO cbr_tempus_write_table BEGIN
  SPRINT cbr_t_text ~2DA V1.0%WNL%%cbr_t_default%%WNL%~
  FOR (cbr_t_c = 0; cbr_t_c < cbr_t_cols; ++cbr_t_c) BEGIN
    SPRINT cbr_t_value $cbr_t_cell(2 ~%cbr_t_c%~)
    SPRINT cbr_t_text ~%cbr_t_text% %cbr_t_value%~
  END
  SPRINT cbr_t_text ~%cbr_t_text%%WNL%~
  FOR (cbr_t_r = 3; cbr_t_r < cbr_t_lines; ++cbr_t_r) BEGIN
    FOR (cbr_t_c = 0; cbr_t_c <= cbr_t_cols; ++cbr_t_c) BEGIN
      SPRINT cbr_t_value $cbr_t_cell(~%cbr_t_r%~ ~%cbr_t_c%~)
      SPRINT cbr_t_text ~%cbr_t_text%%cbr_t_value% ~
    END
    SPRINT cbr_t_text ~%cbr_t_text%%WNL%~
  END
  DELETE_BYTES 0 BUFFER_LENGTH
  INSERT_BYTES 0 (STRING_LENGTH ~%cbr_t_text%~)
  WRITE_ASCIIE 0 ~%cbr_t_text%~
END

DEFINE_PATCH_FUNCTION cbr_find_or_append_splprot
  INT_VAR stat = 0 value = 0 relation = 0 append = 1
  STR_VAR row_label = ~~
  RET row_index appended
BEGIN
  LPM cbr_tempus_read_table
  SET row_index = (0 - 1) SET appended = 0
  PATCH_FOR_EACH cbr_sp_column IN ~STAT~ ~VALUE~ ~RELATION~ BEGIN
    SET cbr_sp_col = (0 - 1)
    FOR (cbr_sp_c = 0; cbr_sp_c < cbr_t_cols; ++cbr_sp_c) BEGIN
      SPRINT cbr_sp_name $cbr_t_cell(2 ~%cbr_sp_c%~)
      PATCH_IF ~%cbr_sp_name%~ STRING_EQUAL_CASE ~%cbr_sp_column%~ BEGIN SET cbr_sp_col = cbr_sp_c + 1 END
    END
    PATCH_IF cbr_sp_col < 0 BEGIN
      SPRINT $cbr_t_cell(2 ~%cbr_t_cols%~) ~%cbr_sp_column%~
      ++cbr_t_cols SET cbr_sp_col = cbr_t_cols
      FOR (cbr_sp_r = 3; cbr_sp_r < cbr_t_lines; ++cbr_sp_r) BEGIN
        SPRINT $cbr_t_cell(~%cbr_sp_r%~ ~%cbr_sp_col%~) ~%cbr_t_default%~
      END
    END
    SET $cbr_sp_column(~%cbr_sp_column%~) = cbr_sp_col
  END
  FOR (cbr_sp_r = 3; cbr_sp_r < cbr_t_lines; ++cbr_sp_r) BEGIN
    SPRINT cbr_sp_label $cbr_t_cell(~%cbr_sp_r%~ 0)
    PATCH_IF ~%cbr_sp_label%~ STRING_EQUAL_CASE ~%row_label%~ BEGIN
      PATCH_IF row_index < 0 BEGIN SET row_index = cbr_sp_r - 3 END
      SET cbr_sp_col = $cbr_sp_column(~STAT~) SPRINT $cbr_t_cell(~%cbr_sp_r%~ ~%cbr_sp_col%~) ~%stat%~
      SET cbr_sp_col = $cbr_sp_column(~VALUE~) SPRINT $cbr_t_cell(~%cbr_sp_r%~ ~%cbr_sp_col%~) ~%value%~
      SET cbr_sp_col = $cbr_sp_column(~RELATION~) SPRINT $cbr_t_cell(~%cbr_sp_r%~ ~%cbr_sp_col%~) ~%relation%~
    END
  END
  PATCH_IF row_index < 0 AND append BEGIN
    SET row_index = cbr_t_lines - 3 SET appended = 1
    SPRINT $cbr_t_cell(~%cbr_t_lines%~ 0) ~%row_label%~
    FOR (cbr_sp_c = 1; cbr_sp_c <= cbr_t_cols; ++cbr_sp_c) BEGIN
      SPRINT $cbr_t_cell(~%cbr_t_lines%~ ~%cbr_sp_c%~) ~%cbr_t_default%~
    END
    SET cbr_sp_col = $cbr_sp_column(~STAT~) SPRINT $cbr_t_cell(~%cbr_t_lines%~ ~%cbr_sp_col%~) ~%stat%~
    SET cbr_sp_col = $cbr_sp_column(~VALUE~) SPRINT $cbr_t_cell(~%cbr_t_lines%~ ~%cbr_sp_col%~) ~%value%~
    SET cbr_sp_col = $cbr_sp_column(~RELATION~) SPRINT $cbr_t_cell(~%cbr_t_lines%~ ~%cbr_sp_col%~) ~%relation%~
    ++cbr_t_lines
  END
  // Duplicate owned column labels still describe our cells: write all of
  // them, so whichever occurrence the engine reads has the decided value.
  FOR (cbr_sp_r = 3; cbr_sp_r < cbr_t_lines; ++cbr_sp_r) BEGIN
    SPRINT cbr_sp_label $cbr_t_cell(~%cbr_sp_r%~ 0)
    PATCH_IF ~%cbr_sp_label%~ STRING_EQUAL_CASE ~%row_label%~ BEGIN
      FOR (cbr_sp_c = 0; cbr_sp_c < cbr_t_cols; ++cbr_sp_c) BEGIN
        SPRINT cbr_sp_name $cbr_t_cell(2 ~%cbr_sp_c%~)
        SET cbr_sp_col = cbr_sp_c + 1
        PATCH_IF ~%cbr_sp_name%~ STRING_EQUAL_CASE ~STAT~ BEGIN SPRINT $cbr_t_cell(~%cbr_sp_r%~ ~%cbr_sp_col%~) ~%stat%~ END
        PATCH_IF ~%cbr_sp_name%~ STRING_EQUAL_CASE ~VALUE~ BEGIN SPRINT $cbr_t_cell(~%cbr_sp_r%~ ~%cbr_sp_col%~) ~%value%~ END
        PATCH_IF ~%cbr_sp_name%~ STRING_EQUAL_CASE ~RELATION~ BEGIN SPRINT $cbr_t_cell(~%cbr_sp_r%~ ~%cbr_sp_col%~) ~%relation%~ END
      END
    END
  END
  PATCH_IF append BEGIN LPM cbr_tempus_write_table END
END

DEFINE_PATCH_FUNCTION cbr_plan_tempus_splstates
  RET ih_state apr_half_state apr_one_state apr_one_half_state append_states
BEGIN
  FOR (cbr_st_i = 0; cbr_st_i < 256; ++cbr_st_i) BEGIN
    SET $cbr_st_used(~%cbr_st_i%~) = 0
  END
  PATCH_FOR_EACH cbr_st_symbol IN ~CBR_TEMPUS_IH~ ~CBR_TEMPUS_APR_HALF~ ~CBR_TEMPUS_APR_ONE~ ~CBR_TEMPUS_APR_ONE_HALF~ BEGIN
    SET $cbr_st_value(~%cbr_st_symbol%~) = (0 - 1)
  END
  READ_ASCII 0 cbr_st_text (BUFFER_LENGTH)
  INNER_PATCH ~%cbr_st_text%~ BEGIN
    REPLACE_EVALUATE ~^[ %TAB%]*\([^ %TAB%%WNL%%LNL%%MNL%]+\)[ %TAB%]+\([^ %TAB%%WNL%%LNL%%MNL%]+\)~ BEGIN
      PATCH_IF IS_AN_INT ~%MATCH1%~ BEGIN
        SET cbr_st_n = MATCH1 SPRINT cbr_st_name ~%MATCH2%~ TO_UPPER cbr_st_name
        PATCH_IF cbr_st_n >= 0 AND cbr_st_n < 256 BEGIN
          SET cbr_st_private = 0
          PATCH_FOR_EACH cbr_st_symbol IN ~CBR_TEMPUS_IH~ ~CBR_TEMPUS_APR_HALF~ ~CBR_TEMPUS_APR_ONE~ ~CBR_TEMPUS_APR_ONE_HALF~ BEGIN
            PATCH_IF ~%cbr_st_name%~ STRING_EQUAL ~%cbr_st_symbol%~ BEGIN
              SET $cbr_st_value(~%cbr_st_symbol%~) = cbr_st_n SET cbr_st_private = 1
            END
          END
          PATCH_IF NOT cbr_st_private BEGIN SET $cbr_st_used(~%cbr_st_n%~) = 1 END
        END
      END
    END ~%MATCH0%~
  END
  SET append_states = 1
  PATCH_FOR_EACH cbr_st_symbol IN ~CBR_TEMPUS_IH~ ~CBR_TEMPUS_APR_HALF~ ~CBR_TEMPUS_APR_ONE~ ~CBR_TEMPUS_APR_ONE_HALF~ BEGIN
    SET cbr_st_n = $cbr_st_value(~%cbr_st_symbol%~)
    PATCH_IF cbr_st_n >= 0 BEGIN
      PATCH_IF $cbr_st_used(~%cbr_st_n%~) BEGIN SET cbr_st_n = (0 - 1) END
    END
    FOR (cbr_st_i = 255; cbr_st_i >= 0 AND cbr_st_n < 0; --cbr_st_i) BEGIN
      PATCH_IF NOT $cbr_st_used(~%cbr_st_i%~) BEGIN SET cbr_st_n = cbr_st_i END
    END
    SET $cbr_st_value(~%cbr_st_symbol%~) = cbr_st_n
    PATCH_IF cbr_st_n >= 0 BEGIN SET $cbr_st_used(~%cbr_st_n%~) = 1 END
    ELSE BEGIN SET append_states = 0 END
  END
  // The bridge requires all four states. Do not reserve a partial allocation
  // or alias another feature's state when the engine has no available slots.
  SET ih_state = (append_states ? $cbr_st_value(~CBR_TEMPUS_IH~) : (0 - 1))
  SET apr_half_state = (append_states ? $cbr_st_value(~CBR_TEMPUS_APR_HALF~) : (0 - 1))
  SET apr_one_state = (append_states ? $cbr_st_value(~CBR_TEMPUS_APR_ONE~) : (0 - 1))
  SET apr_one_half_state = (append_states ? $cbr_st_value(~CBR_TEMPUS_APR_ONE_HALF~) : (0 - 1))
END

DEFINE_ACTION_FUNCTION cbr_find_or_allocate_splstate
  INT_VAR planned_value = (0 - 1)
  STR_VAR resource_path = ~~ symbol = ~~
  RET state_value appended
BEGIN
  OUTER_SPRINT resource_path EVALUATE_BUFFER ~%resource_path%~
  OUTER_SPRINT symbol EVALUATE_BUFFER ~%symbol%~
  OUTER_SET state_value = planned_value OUTER_SET appended = 0
  // The planner can return -1 when every state belongs to another feature.
  // Keep that result out of IDS even if a caller has not handled it yet.
  ACTION_IF planned_value < 0 OR planned_value > 255 BEGIN
    PRINT ~CBR: no unused SPLSTATE slot for %symbol%; no marker is allocated.~
  END ELSE BEGIN
    OUTER_SET appended = 1
    ACTION_IF NOT FILE_EXISTS ~%resource_path%~ BEGIN
      <<<<<<<< cbr-empty-states
IDS V1.0
>>>>>>>>
      COPY ~cbr-empty-states~ ~%resource_path%~
    END
    COPY ~%resource_path%~ ~%resource_path%~
      READ_ASCII 0 cbr_st_input (BUFFER_LENGTH)
      SPRINT cbr_st_newline ~%LNL%~
      PATCH_IF (~%cbr_st_input%~ STRING_CONTAINS_REGEXP ~%MNL%~) = 0 BEGIN
        SPRINT cbr_st_newline ~%WNL%~
      END
      REPLACE_EVALUATE ~^[ %TAB%]*[^ %TAB%%WNL%%LNL%%MNL%]+[ %TAB%]+\([^ %TAB%%WNL%%LNL%%MNL%]+\)[^%WNL%%LNL%%MNL%]*~ BEGIN
        SPRINT cbr_st_keep ~%MATCH0%~
        PATCH_IF ~%MATCH1%~ STRING_EQUAL_CASE ~%symbol%~ BEGIN SPRINT cbr_st_keep ~~ END
      END ~%cbr_st_keep%~
      REPLACE_TEXTUALLY ~[%WNL%%LNL%%MNL%]+~ ~%cbr_st_newline%~
      REPLACE_TEXTUALLY ~[%WNL%%LNL%%MNL%]+$~ ~~
      SET cbr_st_end = BUFFER_LENGTH
      SPRINT cbr_st_line ~%cbr_st_newline%%planned_value% %symbol%%cbr_st_newline%~
      INSERT_BYTES cbr_st_end (STRING_LENGTH ~%cbr_st_line%~)
      WRITE_ASCIIE cbr_st_end ~%cbr_st_line%~
    BUT_ONLY
  END
END

// A cap owns the Holy Power grants, irrespective of the ABILITY row in which
// another installer packed them. Missing grants receive the original schedule.
DEFINE_PATCH_FUNCTION cbr_scan_tempus_clab
  INT_VAR apply_cap = 0
  RET grant_count capped_shape cleared_count
BEGIN
  LPM cbr_tempus_read_table
  SET grant_count = 0 SET cleared_count = 0
  FOR (cbr_cl_c = 1; cbr_cl_c <= cbr_t_cols; ++cbr_cl_c) BEGIN
    FOR (cbr_cl_r = 3; cbr_cl_r < cbr_t_lines; ++cbr_cl_r) BEGIN
      SPRINT cbr_cl_cell $cbr_t_cell(~%cbr_cl_r%~ ~%cbr_cl_c%~)
      PATCH_IF ~%cbr_cl_cell%~ STRING_EQUAL_CASE ~GA_OHTMPS1~ BEGIN
        ++grant_count
        PATCH_IF apply_cap AND grant_count > 5 BEGIN
          SPRINT $cbr_t_cell(~%cbr_cl_r%~ ~%cbr_cl_c%~) ~****~ ++cleared_count
        END
      END
    END
  END
  SET capped_shape = (grant_count > 0 AND grant_count <= 5)
  PATCH_IF apply_cap BEGIN
    PATCH_IF grant_count = 0 BEGIN
      FOR (cbr_cl_c = cbr_t_cols; cbr_cl_c < 21; ++cbr_cl_c) BEGIN
        SET cbr_cl_level = cbr_cl_c + 1
        SPRINT $cbr_t_cell(2 ~%cbr_cl_c%~) ~%cbr_cl_level%~
        FOR (cbr_cl_r = 3; cbr_cl_r < cbr_t_lines; ++cbr_cl_r) BEGIN
          SPRINT $cbr_t_cell(~%cbr_cl_r%~ ~%cbr_cl_level%~) ~%cbr_t_default%~
        END
      END
      PATCH_IF cbr_t_cols < 21 BEGIN SET cbr_t_cols = 21 END
      SPRINT $cbr_t_cell(~%cbr_t_lines%~ 0) ~CBR_HOLY_POWER~
      FOR (cbr_cl_c = 1; cbr_cl_c <= cbr_t_cols; ++cbr_cl_c) BEGIN
        SPRINT $cbr_t_cell(~%cbr_t_lines%~ ~%cbr_cl_c%~) ~****~
      END
      PATCH_FOR_EACH cbr_cl_c IN 1 6 11 16 21 BEGIN
        SPRINT $cbr_t_cell(~%cbr_t_lines%~ ~%cbr_cl_c%~) ~GA_OHTMPS1~
      END
      ++cbr_t_lines SET grant_count = 5
    END
    LPM cbr_tempus_write_table
  END
END

DEFINE_PATCH_FUNCTION cbr_validate_tempus_clab RET capped_shape grant_count BEGIN
  LPF cbr_scan_tempus_clab RET capped_shape grant_count END
END
DEFINE_PATCH_FUNCTION cbr_cap_tempus_clab BEGIN
  LPF cbr_scan_tempus_clab INT_VAR apply_cap = 1 END
END


// Ability and effect definition from the original Holy Power result.
DEFINE_PATCH_FUNCTION cbr_tempus_holy_chassis BEGIN
  SET cbr_name = 6087 SET cbr_name2 = (0 - 1) SET cbr_desc = 6088 SET cbr_desc2 = (0 - 1)
  PATCH_IF BUFFER_LENGTH >= 0x58 BEGIN
    READ_LONG 8 cbr_name READ_LONG 0xc cbr_name2 READ_LONG 0x50 cbr_desc READ_LONG 0x54 cbr_desc2
  END
  DELETE_BYTES 0 BUFFER_LENGTH INSERT_BYTES 0 (0x72 + 30 * 0x28)
  WRITE_ASCII 0 ~SPL V1  ~ #8
  WRITE_BYTE 0x10 69
  WRITE_BYTE 0x11 70
  WRITE_BYTE 0x12 70
  WRITE_BYTE 0x13 95
  WRITE_BYTE 0x14 80
  WRITE_BYTE 0x15 48
  WRITE_BYTE 0x16 54
  WRITE_BYTE 0x1c 4
  WRITE_BYTE 0x21 128
  WRITE_BYTE 0x22 15
  WRITE_BYTE 0x25 6
  WRITE_BYTE 0x27 12
  WRITE_BYTE 0x34 1
  WRITE_BYTE 0x38 1
  WRITE_BYTE 0x3a 83
  WRITE_BYTE 0x3b 80
  WRITE_BYTE 0x3c 80
  WRITE_BYTE 0x3d 82
  WRITE_BYTE 0x3e 52
  WRITE_BYTE 0x3f 49
  WRITE_BYTE 0x40 50
  WRITE_BYTE 0x41 67
  WRITE_LONG 8 cbr_name WRITE_LONG 0xc cbr_name2 WRITE_LONG 0x50 cbr_desc WRITE_LONG 0x54 cbr_desc2
  WRITE_LONG 0x64 0x72 WRITE_SHORT 0x68 30 WRITE_LONG 0x6a (0x72 + 30 * 0x28)
  FOR (cbr_ch = 0; cbr_ch < 30; ++cbr_ch) BEGIN
    SET cbr_ch_at = 0x72 + cbr_ch * 0x28
    WRITE_BYTE (cbr_ch_at + 0x0) 1
    WRITE_BYTE (cbr_ch_at + 0x2) 4
    WRITE_BYTE (cbr_ch_at + 0x4) 83
    WRITE_BYTE (cbr_ch_at + 0x5) 80
    WRITE_BYTE (cbr_ch_at + 0x6) 80
    WRITE_BYTE (cbr_ch_at + 0x7) 82
    WRITE_BYTE (cbr_ch_at + 0x8) 52
    WRITE_BYTE (cbr_ch_at + 0x9) 49
    WRITE_BYTE (cbr_ch_at + 0xa) 50
    WRITE_BYTE (cbr_ch_at + 0xb) 66
    WRITE_BYTE (cbr_ch_at + 0xc) 5
    WRITE_BYTE (cbr_ch_at + 0xe) 1
    WRITE_BYTE (cbr_ch_at + 0x12) 1
    WRITE_BYTE (cbr_ch_at + 0x16) 6
    WRITE_BYTE (cbr_ch_at + 0x1c) 1
    WRITE_BYTE (cbr_ch_at + 0x22) 1
    WRITE_BYTE (cbr_ch_at + 0x24) 1
    WRITE_BYTE (cbr_ch_at + 0x26) 255
    WRITE_SHORT (cbr_ch_at + 0x10) (cbr_ch + 1)
  END
END


DEFINE_PATCH_FUNCTION cbr_build_tempus_holy_progression
  INT_VAR
    str_lt_row = "-1"
    str_eq_row = "-1"
    str_bonus_lt_row = "-1"
  STR_VAR
    divine_power_resref = ~~
    strength_pulse_18   = ~CBRSE18~
    strength_pulse_19   = ~CBRSE19~
    strength_pulse_20   = ~CBRSE20~
    strength_pulse_21   = ~CBRSE21~
    strength_set_18     = ~CBRST18~
    strength_set_19     = ~CBRST19~
    strength_set_20     = ~CBRST20~
    strength_set_21     = ~CBRST21~
    strength_exception_18 = ~CBRSX18~
BEGIN
  LPF cbr_tempus_holy_chassis END
  SET cbr_progression_ability_offset = 0x72
  SET cbr_progression_effect_offset = 0x72 + 30 * 0x28
  SET cbr_progression_old_effect_bytes = 0
  SET cbr_new_effect_index = 0
  FOR (cbr_header = 0; cbr_header < 30; ++cbr_header) BEGIN
    SET cbr_level = cbr_header + 1
    SET cbr_header_offset = cbr_progression_ability_offset + (cbr_header * 0x28)
    READ_SHORT (cbr_header_offset + 0x1e) cbr_source_effect_count
    READ_SHORT (cbr_header_offset + 0x20) cbr_source_first_effect
    WRITE_SHORT (cbr_header_offset + 0x10) cbr_level
    WRITE_SHORT (cbr_header_offset + 0x20) cbr_new_effect_index
    SET cbr_new_header_first = cbr_new_effect_index

    PATCH_IF (cbr_level <= 6) BEGIN
      SET cbr_duration = 18
      SET cbr_apr = "-1"
    END ELSE PATCH_IF (cbr_level <= 12) BEGIN
      SET cbr_duration = 24
      SET cbr_apr = 6
    END ELSE BEGIN
      SET cbr_duration = 30
      PATCH_IF (cbr_level <= 24) BEGIN
        SET cbr_apr = 1
      END ELSE BEGIN
        SET cbr_apr = 7
      END
    END
    SET cbr_thac0 = 21 - cbr_level
    PATCH_IF (cbr_thac0 < 0) BEGIN
      SET cbr_thac0 = 0
    END
    SET cbr_hp = cbr_level
    PATCH_IF (cbr_hp > 30) BEGIN
      SET cbr_hp = 30
    END
    PATCH_IF (cbr_level <= 12) BEGIN
      SET cbr_strength_floor = 18
      SPRINT cbr_strength_set ~%strength_set_18%~
      SPRINT cbr_strength_pulse ~%strength_pulse_18%~
    END ELSE PATCH_IF (cbr_level <= 18) BEGIN
      SET cbr_strength_floor = 19
      SPRINT cbr_strength_set ~%strength_set_19%~
      SPRINT cbr_strength_pulse ~%strength_pulse_19%~
    END ELSE PATCH_IF (cbr_level <= 24) BEGIN
      SET cbr_strength_floor = 20
      SPRINT cbr_strength_set ~%strength_set_20%~
      SPRINT cbr_strength_pulse ~%strength_pulse_20%~
    END ELSE BEGIN
      SET cbr_strength_floor = 21
      SPRINT cbr_strength_set ~%strength_set_21%~
      SPRINT cbr_strength_pulse ~%strength_pulse_21%~
    END

    // Canonical owned prefix: dynamic Divine cleanup, self cleanup, timed-only
    // removal of every possible prior tier setter for level-drain/recast
    // safety, then the immediate floor graph.
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 321 target = 1 power = 4 parameter2 = 2 timing = 1 resist_dispel = 2
      STR_VAR resource = EVAL ~%divine_power_resref%~
    END
    ++cbr_new_effect_index
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 321 target = 1 power = 4 timing = 1 resist_dispel = 2
      STR_VAR resource = ~OHTMPS1~
    END
    ++cbr_new_effect_index
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 321 target = 1 power = 4 parameter2 = 2 timing = 1 resist_dispel = 2
      STR_VAR resource = EVAL ~%strength_set_18%~
    END
    ++cbr_new_effect_index
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 321 target = 1 power = 4 parameter2 = 2 timing = 1 resist_dispel = 2
      STR_VAR resource = EVAL ~%strength_set_19%~
    END
    ++cbr_new_effect_index
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 321 target = 1 power = 4 parameter2 = 2 timing = 1 resist_dispel = 2
      STR_VAR resource = EVAL ~%strength_set_20%~
    END
    ++cbr_new_effect_index
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 321 target = 1 power = 4 parameter2 = 2 timing = 1 resist_dispel = 2
      STR_VAR resource = EVAL ~%strength_set_21%~
    END
    ++cbr_new_effect_index
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 326 target = 1 power = 4 parameter1 = cbr_strength_floor parameter2 = str_lt_row timing = 1 resist_dispel = 2
      STR_VAR resource = EVAL ~%cbr_strength_set%~
    END
    ++cbr_new_effect_index
    PATCH_IF (cbr_strength_floor = 18) BEGIN
      LPF cbr_append_spl_effect_record
        INT_VAR opcode = 326 target = 1 power = 4 parameter1 = 18 parameter2 = str_eq_row timing = 1 resist_dispel = 2
        STR_VAR resource = EVAL ~%strength_exception_18%~
      END
      ++cbr_new_effect_index
    END

    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 54 target = 1 power = 4 parameter1 = cbr_thac0 parameter2 = 1 timing = 0 resist_dispel = 3 duration = cbr_duration
    END
    ++cbr_new_effect_index
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 18 target = 1 power = 4 parameter1 = cbr_hp parameter2 = 0 timing = 0 resist_dispel = 3 duration = cbr_duration
    END
    ++cbr_new_effect_index

    // The decided visual, portrait, state, and sound effects.
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 141 target = 1 power = 4 parameter1 = 0 parameter2 = 24 timing = 1 resist_dispel = 3 duration = 0 special = 0
    END
    ++cbr_new_effect_index
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 50 target = 1 power = 4 parameter1 = 1614807040 parameter2 = 1638400 timing = 1 resist_dispel = 3 duration = 0 special = 0
    END
    ++cbr_new_effect_index
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 142 target = 1 power = 4 parameter1 = 0 parameter2 = 60 timing = 0 resist_dispel = 3 duration = cbr_duration special = 0
    END
    ++cbr_new_effect_index
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 328 target = 1 power = 4 parameter1 = 0 parameter2 = 68 timing = 0 resist_dispel = 3 duration = cbr_duration special = 1
    END
    ++cbr_new_effect_index
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 328 target = 1 power = 4 parameter1 = 0 parameter2 = 9 timing = 0 resist_dispel = 3 duration = cbr_duration special = 1
    END
    ++cbr_new_effect_index
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 282 target = 1 power = 4 parameter1 = 3 parameter2 = 5 timing = 0 resist_dispel = 3 duration = cbr_duration special = 0
    END
    ++cbr_new_effect_index
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 174 target = 1 power = 4 parameter1 = 0 parameter2 = 0 timing = 4 resist_dispel = 3 duration = cbr_duration special = 0
      STR_VAR resource = ~EFF_E03~
    END
    ++cbr_new_effect_index

    PATCH_IF (cbr_apr >= 0) BEGIN
      LPF cbr_append_spl_effect_record
        INT_VAR opcode = 1 target = 1 power = 4 parameter1 = cbr_apr parameter2 = 0 timing = 0 resist_dispel = 3 duration = cbr_duration
      END
      ++cbr_new_effect_index
    END
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 272 target = 1 power = 4 parameter1 = 1 parameter2 = 3 timing = 0 resist_dispel = 3 duration = cbr_duration
      STR_VAR resource = EVAL ~%cbr_strength_pulse%~
    END
    ++cbr_new_effect_index

    // A child setter has no intrinsic parent lifetime.  Delayed all-tier
    // cleanup fires at the exact Holy duration so the 31-tick overlap cannot
    // survive normal parent expiration.  Task 5 must mirror these cleanups on
    // every mod-controlled early OHTMPS1 removal path (notably Divine Power).
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 321 target = 1 power = 4 parameter2 = 2 timing = 4 resist_dispel = 2 duration = cbr_duration
      STR_VAR resource = EVAL ~%strength_set_18%~
    END
    ++cbr_new_effect_index
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 321 target = 1 power = 4 parameter2 = 2 timing = 4 resist_dispel = 2 duration = cbr_duration
      STR_VAR resource = EVAL ~%strength_set_19%~
    END
    ++cbr_new_effect_index
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 321 target = 1 power = 4 parameter2 = 2 timing = 4 resist_dispel = 2 duration = cbr_duration
      STR_VAR resource = EVAL ~%strength_set_20%~
    END
    ++cbr_new_effect_index
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 321 target = 1 power = 4 parameter2 = 2 timing = 4 resist_dispel = 2 duration = cbr_duration
      STR_VAR resource = EVAL ~%strength_set_21%~
    END
    ++cbr_new_effect_index

    SET cbr_new_header_count = cbr_new_effect_index - cbr_new_header_first
    WRITE_SHORT (cbr_header_offset + 0x1e) cbr_new_header_count
  END

  DELETE_BYTES cbr_progression_effect_offset cbr_progression_old_effect_bytes
  WRITE_LONG 0x6a cbr_progression_effect_offset

END


DEFINE_ACTION_FUNCTION cbr_define_tempus_private_resrefs
  RET
    cbr_apr_helper_6
    cbr_apr_helper_1
    cbr_apr_helper_7
    cbr_apr_condition_6
    cbr_apr_condition_1
    cbr_apr_condition_7
    cbr_strength_set_18
    cbr_strength_set_19
    cbr_strength_set_20
    cbr_strength_set_21
    cbr_strength_check_18
    cbr_strength_check_19
    cbr_strength_check_20
    cbr_strength_check_21
    cbr_strength_pulse_18
    cbr_strength_pulse_19
    cbr_strength_pulse_20
    cbr_strength_pulse_21
    cbr_strength_exception_18
BEGIN
  OUTER_SPRINT cbr_apr_helper_6 ~CBRAPR6~
  OUTER_SPRINT cbr_apr_helper_1 ~CBRAPR1~
  OUTER_SPRINT cbr_apr_helper_7 ~CBRAPR7~
  OUTER_SPRINT cbr_apr_condition_6 ~CBRAPC6~
  OUTER_SPRINT cbr_apr_condition_1 ~CBRAPC1~
  OUTER_SPRINT cbr_apr_condition_7 ~CBRAPC7~
  OUTER_SPRINT cbr_strength_set_18 ~CBRST18~
  OUTER_SPRINT cbr_strength_set_19 ~CBRST19~
  OUTER_SPRINT cbr_strength_set_20 ~CBRST20~
  OUTER_SPRINT cbr_strength_set_21 ~CBRST21~
  OUTER_SPRINT cbr_strength_check_18 ~CBRSC18~
  OUTER_SPRINT cbr_strength_check_19 ~CBRSC19~
  OUTER_SPRINT cbr_strength_check_20 ~CBRSC20~
  OUTER_SPRINT cbr_strength_check_21 ~CBRSC21~
  OUTER_SPRINT cbr_strength_pulse_18 ~CBRSE18~
  OUTER_SPRINT cbr_strength_pulse_19 ~CBRSE19~
  OUTER_SPRINT cbr_strength_pulse_20 ~CBRSE20~
  OUTER_SPRINT cbr_strength_pulse_21 ~CBRSE21~
  OUTER_SPRINT cbr_strength_exception_18 ~CBRSX18~
END


DEFINE_ACTION_FUNCTION cbr_create_tempus_strength_setter
  INT_VAR
    floor = 0
  STR_VAR
    resource_dir = ~~
    setter_resref = ~~
BEGIN
  OUTER_SPRINT resource_dir EVALUATE_BUFFER ~%resource_dir%~
  OUTER_SPRINT setter_resref EVALUATE_BUFFER ~%setter_resref%~
  COPY ~%resource_dir%/SPLPROT.2DA~ ~%resource_dir%/%setter_resref%.spl~
    LPF cbr_tempus_blank INT_VAR size = 0x72 STR_VAR signature = ~SPL V1  ~ END
    LPF cbr_add_basic_self_ability END
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 321 target = 1 power = 4 parameter2 = 2 timing = 1 resist_dispel = 2
      STR_VAR resource = EVAL ~%setter_resref%~
    END
    // Timing mode 10 measures duration in engine ticks.  Opcode 272's nominal
    // one-second pulse stretches to 30 ticks under Slow/disease, so 31 ticks
    // gives one tick of overlap without lengthening stale early-removal state
    // beyond roughly two seconds.
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 44 target = 1 power = 4 parameter1 = floor parameter2 = 1 timing = 10 resist_dispel = 3 duration = 31
    END
    PATCH_IF (floor = 18) BEGIN
      LPF cbr_append_spl_effect_record
        INT_VAR opcode = 97 target = 1 power = 4 parameter1 = 100 parameter2 = 1 timing = 10 resist_dispel = 3 duration = 31
      END
      WRITE_SHORT 0x90 3
    END ELSE BEGIN
      WRITE_SHORT 0x90 2
    END
END


DEFINE_ACTION_FUNCTION cbr_create_tempus_strength_checker
  INT_VAR
    floor       = 0
    str_lt_row  = "-1"
    str_eq_row  = "-1"
  STR_VAR
    resource_dir      = ~~
    checker_resref    = ~~
    setter_resref     = ~~
    exception_resref  = ~~
BEGIN
  OUTER_SPRINT resource_dir EVALUATE_BUFFER ~%resource_dir%~
  OUTER_SPRINT checker_resref EVALUATE_BUFFER ~%checker_resref%~
  OUTER_SPRINT setter_resref EVALUATE_BUFFER ~%setter_resref%~
  OUTER_SPRINT exception_resref EVALUATE_BUFFER ~%exception_resref%~
  COPY ~%resource_dir%/SPLPROT.2DA~ ~%resource_dir%/%checker_resref%.spl~
    LPF cbr_tempus_blank INT_VAR size = 0x72 STR_VAR signature = ~SPL V1  ~ END
    LPF cbr_add_basic_self_ability END
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 321 target = 1 power = 4 parameter2 = 2 timing = 1 resist_dispel = 2
      STR_VAR resource = EVAL ~%setter_resref%~
    END
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 326 target = 1 power = 4 parameter1 = floor parameter2 = str_lt_row timing = 1 resist_dispel = 2
      STR_VAR resource = EVAL ~%setter_resref%~
    END
    PATCH_IF (floor = 18) BEGIN
      LPF cbr_append_spl_effect_record
        INT_VAR opcode = 326 target = 1 power = 4 parameter1 = 18 parameter2 = str_eq_row timing = 1 resist_dispel = 2
        STR_VAR resource = EVAL ~%exception_resref%~
      END
      WRITE_SHORT 0x90 3
    END ELSE BEGIN
      WRITE_SHORT 0x90 2
    END
END


DEFINE_ACTION_FUNCTION cbr_create_tempus_strength_exception
  INT_VAR
    bonus_lt_row = "-1"
  STR_VAR
    resource_dir      = ~~
    exception_resref  = ~~
    setter_resref     = ~~
BEGIN
  OUTER_SPRINT resource_dir EVALUATE_BUFFER ~%resource_dir%~
  OUTER_SPRINT exception_resref EVALUATE_BUFFER ~%exception_resref%~
  OUTER_SPRINT setter_resref EVALUATE_BUFFER ~%setter_resref%~
  COPY ~%resource_dir%/SPLPROT.2DA~ ~%resource_dir%/%exception_resref%.spl~
    LPF cbr_tempus_blank INT_VAR size = 0x72 STR_VAR signature = ~SPL V1  ~ END
    LPF cbr_add_basic_self_ability END
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 326 target = 1 power = 4 parameter1 = 100 parameter2 = bonus_lt_row timing = 1 resist_dispel = 2
      STR_VAR resource = EVAL ~%setter_resref%~
    END
    WRITE_SHORT 0x90 1
END


DEFINE_ACTION_FUNCTION cbr_create_tempus_strength_pulse
  STR_VAR
    resource_dir    = ~~
    pulse_resref    = ~~
    checker_resref  = ~~
BEGIN
  OUTER_SPRINT resource_dir EVALUATE_BUFFER ~%resource_dir%~
  OUTER_SPRINT pulse_resref EVALUATE_BUFFER ~%pulse_resref%~
  OUTER_SPRINT checker_resref EVALUATE_BUFFER ~%checker_resref%~
  COPY ~%resource_dir%/SPLPROT.2DA~ ~%resource_dir%/%pulse_resref%.eff~
    LPF cbr_tempus_blank INT_VAR size = 0x110 STR_VAR signature = ~EFF V2.0~ END
    // Write the complete private EFF definition.
    FOR (cbr_eff_byte = 0x10; cbr_eff_byte < 0x110; ++cbr_eff_byte) BEGIN
      WRITE_BYTE cbr_eff_byte 0
    END
    WRITE_LONG 0x10 146
    WRITE_LONG 0x14 2
    WRITE_LONG 0x18 4
    WRITE_LONG 0x1c 0
    WRITE_LONG 0x20 1
    WRITE_LONG 0x24 1
    WRITE_LONG 0x28 0
    WRITE_SHORT 0x2c 100
    WRITE_SHORT 0x2e 0
    WRITE_ASCIIE 0x30 ~%checker_resref%~ #8
    WRITE_LONG 0x38 0
    WRITE_LONG 0x3c 0
    WRITE_LONG 0x40 0
    WRITE_LONG 0x44 0
    WRITE_LONG 0x48 0
    WRITE_LONG 0x5c 2
END


DEFINE_ACTION_FUNCTION cbr_create_tempus_strength_helpers
  INT_VAR
    str_lt_row       = "-1"
    str_eq_row       = "-1"
    str_bonus_lt_row = "-1"
  STR_VAR
    resource_dir = ~~
BEGIN
  OUTER_SPRINT resource_dir EVALUATE_BUFFER ~%resource_dir%~
  ACTION_IF (str_lt_row < 0 || str_eq_row < 0 || str_bonus_lt_row < 0) BEGIN
    FAIL ~CBR cannot create Tempus Strength helpers without all dynamic SPLPROT rows.~
  END
  LAF cbr_define_tempus_private_resrefs
    RET
      cbr_strength_set_18
      cbr_strength_set_19
      cbr_strength_set_20
      cbr_strength_set_21
      cbr_strength_check_18
      cbr_strength_check_19
      cbr_strength_check_20
      cbr_strength_check_21
      cbr_strength_pulse_18
      cbr_strength_pulse_19
      cbr_strength_pulse_20
      cbr_strength_pulse_21
      cbr_strength_exception_18
  END

  LAF cbr_create_tempus_strength_setter INT_VAR floor = 18 STR_VAR resource_dir = EVAL ~%resource_dir%~ setter_resref = EVAL ~%cbr_strength_set_18%~ END
  LAF cbr_create_tempus_strength_setter INT_VAR floor = 19 STR_VAR resource_dir = EVAL ~%resource_dir%~ setter_resref = EVAL ~%cbr_strength_set_19%~ END
  LAF cbr_create_tempus_strength_setter INT_VAR floor = 20 STR_VAR resource_dir = EVAL ~%resource_dir%~ setter_resref = EVAL ~%cbr_strength_set_20%~ END
  LAF cbr_create_tempus_strength_setter INT_VAR floor = 21 STR_VAR resource_dir = EVAL ~%resource_dir%~ setter_resref = EVAL ~%cbr_strength_set_21%~ END

  LAF cbr_create_tempus_strength_checker INT_VAR floor = 18 str_lt_row = str_lt_row str_eq_row = str_eq_row STR_VAR resource_dir = EVAL ~%resource_dir%~ checker_resref = EVAL ~%cbr_strength_check_18%~ setter_resref = EVAL ~%cbr_strength_set_18%~ exception_resref = EVAL ~%cbr_strength_exception_18%~ END
  LAF cbr_create_tempus_strength_checker INT_VAR floor = 19 str_lt_row = str_lt_row STR_VAR resource_dir = EVAL ~%resource_dir%~ checker_resref = EVAL ~%cbr_strength_check_19%~ setter_resref = EVAL ~%cbr_strength_set_19%~ END
  LAF cbr_create_tempus_strength_checker INT_VAR floor = 20 str_lt_row = str_lt_row STR_VAR resource_dir = EVAL ~%resource_dir%~ checker_resref = EVAL ~%cbr_strength_check_20%~ setter_resref = EVAL ~%cbr_strength_set_20%~ END
  LAF cbr_create_tempus_strength_checker INT_VAR floor = 21 str_lt_row = str_lt_row STR_VAR resource_dir = EVAL ~%resource_dir%~ checker_resref = EVAL ~%cbr_strength_check_21%~ setter_resref = EVAL ~%cbr_strength_set_21%~ END

  LAF cbr_create_tempus_strength_exception INT_VAR bonus_lt_row = str_bonus_lt_row STR_VAR resource_dir = EVAL ~%resource_dir%~ exception_resref = EVAL ~%cbr_strength_exception_18%~ setter_resref = EVAL ~%cbr_strength_set_18%~ END

  LAF cbr_create_tempus_strength_pulse STR_VAR resource_dir = EVAL ~%resource_dir%~ pulse_resref = EVAL ~%cbr_strength_pulse_18%~ checker_resref = EVAL ~%cbr_strength_check_18%~ END
  LAF cbr_create_tempus_strength_pulse STR_VAR resource_dir = EVAL ~%resource_dir%~ pulse_resref = EVAL ~%cbr_strength_pulse_19%~ checker_resref = EVAL ~%cbr_strength_check_19%~ END
  LAF cbr_create_tempus_strength_pulse STR_VAR resource_dir = EVAL ~%resource_dir%~ pulse_resref = EVAL ~%cbr_strength_pulse_20%~ checker_resref = EVAL ~%cbr_strength_check_20%~ END
  LAF cbr_create_tempus_strength_pulse STR_VAR resource_dir = EVAL ~%resource_dir%~ pulse_resref = EVAL ~%cbr_strength_pulse_21%~ checker_resref = EVAL ~%cbr_strength_check_21%~ END

END


DEFINE_ACTION_FUNCTION cbr_create_tempus_apr_helper
  INT_VAR
    apr_key = 0
  STR_VAR
    resource_dir = ~~
    helper_resref = ~~
BEGIN
  OUTER_SPRINT resource_dir EVALUATE_BUFFER ~%resource_dir%~
  OUTER_SPRINT helper_resref EVALUATE_BUFFER ~%helper_resref%~
  COPY ~%resource_dir%/SPLPROT.2DA~ ~%resource_dir%/%helper_resref%.spl~
    LPF cbr_tempus_blank INT_VAR size = 0x72 STR_VAR signature = ~SPL V1  ~ END
    LPF cbr_add_basic_self_ability END
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 321 target = 1 power = 4 parameter2 = 2 timing = 1 resist_dispel = 2
      STR_VAR resource = EVAL ~%helper_resref%~
    END
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 1 target = 1 power = 4 parameter1 = apr_key parameter2 = 0 timing = 0 resist_dispel = 2 duration = 1
    END
    WRITE_SHORT 0x90 2
END


DEFINE_ACTION_FUNCTION cbr_create_tempus_apr_condition
  INT_VAR
    ih_state          = "-1"
    active_state_row = "-1"
  STR_VAR
    resource_dir    = ~~
    condition_resref = ~~
    helper_resref   = ~~
BEGIN
  OUTER_SPRINT resource_dir EVALUATE_BUFFER ~%resource_dir%~
  OUTER_SPRINT condition_resref EVALUATE_BUFFER ~%condition_resref%~
  OUTER_SPRINT helper_resref EVALUATE_BUFFER ~%helper_resref%~
  COPY ~%resource_dir%/SPLPROT.2DA~ ~%resource_dir%/%condition_resref%.eff~
    LPF cbr_tempus_blank INT_VAR size = 0x110 STR_VAR signature = ~EFF V2.0~ END
    FOR (cbr_apr_create_byte = 0x10; cbr_apr_create_byte < 0x110; ++cbr_apr_create_byte) BEGIN
      WRITE_BYTE cbr_apr_create_byte 0
    END
    WRITE_LONG 0x10 326
    WRITE_LONG 0x14 2
    WRITE_LONG 0x18 4
    WRITE_LONG 0x1c ih_state
    WRITE_LONG 0x20 active_state_row
    WRITE_LONG 0x24 1
    WRITE_LONG 0x28 0
    WRITE_SHORT 0x2c 100
    WRITE_SHORT 0x2e 0
    WRITE_ASCIIE 0x30 ~%helper_resref%~ #8
    WRITE_LONG 0x5c 2
END


DEFINE_ACTION_FUNCTION cbr_create_tempus_apr_helpers
  INT_VAR
    ih_state          = "-1"
    active_state_row = "-1"
  STR_VAR
    resource_dir = ~~
BEGIN
  OUTER_SPRINT resource_dir EVALUATE_BUFFER ~%resource_dir%~
  LAF cbr_define_tempus_private_resrefs
    RET
      cbr_apr_helper_6
      cbr_apr_helper_1
      cbr_apr_helper_7
      cbr_apr_condition_6
      cbr_apr_condition_1
      cbr_apr_condition_7
  END
  LAF cbr_create_tempus_apr_helper INT_VAR apr_key = 6 STR_VAR resource_dir = EVAL ~%resource_dir%~ helper_resref = EVAL ~%cbr_apr_helper_6%~ END
  LAF cbr_create_tempus_apr_helper INT_VAR apr_key = 1 STR_VAR resource_dir = EVAL ~%resource_dir%~ helper_resref = EVAL ~%cbr_apr_helper_1%~ END
  LAF cbr_create_tempus_apr_helper INT_VAR apr_key = 7 STR_VAR resource_dir = EVAL ~%resource_dir%~ helper_resref = EVAL ~%cbr_apr_helper_7%~ END
  LAF cbr_create_tempus_apr_condition INT_VAR ih_state = ih_state active_state_row = active_state_row STR_VAR resource_dir = EVAL ~%resource_dir%~ condition_resref = EVAL ~%cbr_apr_condition_6%~ helper_resref = EVAL ~%cbr_apr_helper_6%~ END
  LAF cbr_create_tempus_apr_condition INT_VAR ih_state = ih_state active_state_row = active_state_row STR_VAR resource_dir = EVAL ~%resource_dir%~ condition_resref = EVAL ~%cbr_apr_condition_1%~ helper_resref = EVAL ~%cbr_apr_helper_1%~ END
  LAF cbr_create_tempus_apr_condition INT_VAR ih_state = ih_state active_state_row = active_state_row STR_VAR resource_dir = EVAL ~%resource_dir%~ condition_resref = EVAL ~%cbr_apr_condition_7%~ helper_resref = EVAL ~%cbr_apr_helper_7%~ END
END


DEFINE_PATCH_FUNCTION cbr_build_tempus_holy_bridge
  INT_VAR
    ih_state            = "-1"
    apr_half_state      = "-1"
    apr_one_state       = "-1"
    apr_one_half_state  = "-1"
    active_state_row    = "-1"
  STR_VAR
    apr_helper_6 = ~CBRAPR6~
    apr_helper_1 = ~CBRAPR1~
    apr_helper_7 = ~CBRAPR7~
    apr_condition_6 = ~CBRAPC6~
    apr_condition_1 = ~CBRAPC1~
    apr_condition_7 = ~CBRAPC7~
BEGIN
  LPF cbr_validate_spl_v1
    STR_VAR resource_name = ~OHTMPS1 Holy APR bridge source~
    RET
      cbr_holy_build_ability_offset = ability_offset
      cbr_holy_build_ability_count  = ability_count
      cbr_holy_build_effect_offset  = effect_offset
      cbr_holy_build_effect_count   = effect_count
  END
  SET cbr_holy_build_old_bytes = cbr_holy_build_effect_count * 0x30
  READ_SHORT 0x6e cbr_holy_build_casting_first
  READ_SHORT 0x70 cbr_holy_build_casting_count
  SET cbr_holy_build_new_index = 0
  FOR (cbr_holy_build_casting = 0; cbr_holy_build_casting < cbr_holy_build_casting_count; ++cbr_holy_build_casting) BEGIN
    SET cbr_holy_build_source = cbr_holy_build_effect_offset + ((cbr_holy_build_casting_first + cbr_holy_build_casting) * 0x30)
    LPF cbr_append_raw_spl_effect_record INT_VAR source_offset = cbr_holy_build_source END
    ++cbr_holy_build_new_index
  END
  WRITE_SHORT 0x6e 0
  FOR (cbr_holy_build_header = 0; cbr_holy_build_header < 30; ++cbr_holy_build_header) BEGIN
    SET cbr_holy_build_level = cbr_holy_build_header + 1
    SET cbr_holy_build_header_offset = cbr_holy_build_ability_offset + (cbr_holy_build_header * 0x28)
    READ_SHORT (cbr_holy_build_header_offset + 0x1e) cbr_holy_build_source_count
    READ_SHORT (cbr_holy_build_header_offset + 0x20) cbr_holy_build_source_first
    SET cbr_holy_build_new_first = cbr_holy_build_new_index
    WRITE_SHORT (cbr_holy_build_header_offset + 0x20) cbr_holy_build_new_first
    PATCH_IF (cbr_holy_build_level <= 6) BEGIN
      SET cbr_holy_build_state = "-1"
      SET cbr_holy_build_duration = 18
    END ELSE PATCH_IF (cbr_holy_build_level <= 12) BEGIN
      SET cbr_holy_build_state = apr_half_state
      SET cbr_holy_build_duration = 24
      SPRINT cbr_holy_build_helper ~%apr_helper_6%~
      SPRINT cbr_holy_build_condition ~%apr_condition_6%~
    END ELSE PATCH_IF (cbr_holy_build_level <= 24) BEGIN
      SET cbr_holy_build_state = apr_one_state
      SET cbr_holy_build_duration = 30
      SPRINT cbr_holy_build_helper ~%apr_helper_1%~
      SPRINT cbr_holy_build_condition ~%apr_condition_1%~
    END ELSE BEGIN
      SET cbr_holy_build_state = apr_one_half_state
      SET cbr_holy_build_duration = 30
      SPRINT cbr_holy_build_helper ~%apr_helper_7%~
      SPRINT cbr_holy_build_condition ~%apr_condition_7%~
    END
    FOR (cbr_holy_build_effect = 0; cbr_holy_build_effect < cbr_holy_build_source_count; ++cbr_holy_build_effect) BEGIN
      PATCH_IF (cbr_holy_build_state >= 0 && cbr_holy_build_effect = (cbr_holy_build_source_count - 4)) BEGIN
        LPF cbr_append_spl_effect_record
          INT_VAR opcode = 328 target = 1 power = 4 parameter1 = 0 parameter2 = cbr_holy_build_state timing = 0 resist_dispel = 3 duration = cbr_holy_build_duration special = 1
        END
        ++cbr_holy_build_new_index
        LPF cbr_append_spl_effect_record
          INT_VAR opcode = 326 target = 1 power = 4 parameter1 = ih_state parameter2 = active_state_row timing = 1 resist_dispel = 2
          STR_VAR resource = EVAL ~%cbr_holy_build_helper%~
        END
        ++cbr_holy_build_new_index
        LPF cbr_append_spl_effect_record
          INT_VAR opcode = 272 target = 1 power = 4 parameter1 = 1 parameter2 = 3 timing = 0 resist_dispel = 3 duration = cbr_holy_build_duration
          STR_VAR resource = EVAL ~%cbr_holy_build_condition%~
        END
        ++cbr_holy_build_new_index
      END
      SET cbr_holy_build_source = cbr_holy_build_effect_offset + ((cbr_holy_build_source_first + cbr_holy_build_effect) * 0x30)
      LPF cbr_append_raw_spl_effect_record INT_VAR source_offset = cbr_holy_build_source END
      ++cbr_holy_build_new_index
    END
    SET cbr_holy_build_new_count = cbr_holy_build_new_index - cbr_holy_build_new_first
    WRITE_SHORT (cbr_holy_build_header_offset + 0x1e) cbr_holy_build_new_count
  END
  DELETE_BYTES cbr_holy_build_effect_offset cbr_holy_build_old_bytes
  WRITE_LONG 0x6a cbr_holy_build_effect_offset
END


DEFINE_PATCH_FUNCTION cbr_build_tempus_ih_bridge
  INT_VAR
    enabled = 1
    old_ih_half = (0 - 1) old_ih_one = (0 - 1) old_ih_one_half = (0 - 1)
    ih_state            = "-1"
    apr_half_state      = "-1"
    apr_one_state       = "-1"
    apr_one_half_state  = "-1"
    active_state_row    = "-1"
  STR_VAR
    improved_haste_resref = ~~
    apr_helper_6 = ~CBRAPR6~
    apr_helper_1 = ~CBRAPR1~
    apr_helper_7 = ~CBRAPR7~
BEGIN
  LPF cbr_tempus_repack_spl INT_VAR default_target = 1 END
  LPF cbr_validate_spl_v1
    STR_VAR resource_name = EVAL ~Improved Haste %improved_haste_resref% bridge source~
    RET
      cbr_ih_build_ability_offset = ability_offset
      cbr_ih_build_ability_count  = ability_count
      cbr_ih_build_effect_offset  = effect_offset
      cbr_ih_build_effect_count   = effect_count
  END
  SET cbr_ih_build_old_bytes = cbr_ih_build_effect_count * 0x30
  READ_SHORT 0x6e cbr_ih_build_casting_first
  READ_SHORT 0x70 cbr_ih_build_casting_count
  SET cbr_ih_build_new_index = 0
  FOR (cbr_ih_build_casting = 0; cbr_ih_build_casting < cbr_ih_build_casting_count; ++cbr_ih_build_casting) BEGIN
    SET cbr_ih_build_source = cbr_ih_build_effect_offset + ((cbr_ih_build_casting_first + cbr_ih_build_casting) * 0x30)
    READ_SHORT cbr_ih_build_source cbr_ih_op READ_LONG (cbr_ih_build_source + 8) cbr_ih_p2
    READ_ASCII (cbr_ih_build_source + 0x14) cbr_ih_res (8) NULL
    PATCH_IF NOT ((cbr_ih_op = 328 AND (cbr_ih_p2 = ih_state OR cbr_ih_p2 = old_ih_half OR cbr_ih_p2 = old_ih_one OR cbr_ih_p2 = old_ih_one_half))
      OR (~%cbr_ih_res%~ STRING_MATCHES_REGEXP ~^CBRAP[RC][167]$~) = 0) BEGIN
      LPF cbr_append_raw_spl_effect_record INT_VAR source_offset = cbr_ih_build_source END
      ++cbr_ih_build_new_index
    END
  END
  WRITE_SHORT 0x6e 0 WRITE_SHORT 0x70 cbr_ih_build_new_index
  FOR (cbr_ih_build_header = 0; cbr_ih_build_header < cbr_ih_build_ability_count; ++cbr_ih_build_header) BEGIN
    SET cbr_ih_build_header_offset = cbr_ih_build_ability_offset + (cbr_ih_build_header * 0x28)
    READ_SHORT (cbr_ih_build_header_offset + 0x1e) cbr_ih_build_source_count
    READ_SHORT (cbr_ih_build_header_offset + 0x20) cbr_ih_build_source_first
    SET cbr_ih_build_new_first = cbr_ih_build_new_index
    WRITE_SHORT (cbr_ih_build_header_offset + 0x20) cbr_ih_build_new_first
    SET cbr_ih_insert = 0 SET cbr_ih_donor = (0 - 1)
    SET cbr_ih_build_target = 2 SET cbr_ih_build_power = 6 SET cbr_ih_build_timing = 0
    SET cbr_ih_build_dr = 3 SET cbr_ih_build_probability1 = 100 SET cbr_ih_build_probability2 = 0
    READ_SHORT (cbr_ih_build_header_offset + 0x10) cbr_ih_level
    SET cbr_ih_build_duration = 6 * (cbr_ih_level > 0 ? cbr_ih_level : 1)
    FOR (cbr_ih_i = 0; cbr_ih_i < cbr_ih_build_source_count; ++cbr_ih_i) BEGIN
      SET cbr_ih_at = cbr_ih_build_effect_offset + (cbr_ih_build_source_first + cbr_ih_i) * 0x30
      READ_SHORT cbr_ih_at cbr_ih_op READ_ASCII (cbr_ih_at + 0x14) cbr_ih_res (8) NULL
      PATCH_IF cbr_ih_op = 321 AND (~%cbr_ih_res%~ STRING_EQUAL_CASE ~%improved_haste_resref%~) BEGIN
        SET cbr_ih_insert = cbr_ih_i + 1
      END
      PATCH_IF cbr_ih_op = 1 AND cbr_ih_donor < 0 BEGIN SET cbr_ih_donor = cbr_ih_i END
    END
    PATCH_IF cbr_ih_donor >= 0 BEGIN
      SET cbr_ih_insert = cbr_ih_donor + 1
      SET cbr_ih_at = cbr_ih_build_effect_offset + (cbr_ih_build_source_first + cbr_ih_donor) * 0x30
      READ_BYTE (cbr_ih_at + 2) cbr_ih_build_target READ_BYTE (cbr_ih_at + 3) cbr_ih_build_power
      READ_BYTE (cbr_ih_at + 0xc) cbr_ih_build_timing READ_BYTE (cbr_ih_at + 0xd) cbr_ih_build_dr
      READ_LONG (cbr_ih_at + 0xe) cbr_ih_build_duration
      READ_BYTE (cbr_ih_at + 0x12) cbr_ih_build_probability1 READ_BYTE (cbr_ih_at + 0x13) cbr_ih_build_probability2
    END
    FOR (cbr_ih_build_effect = 0; cbr_ih_build_effect <= cbr_ih_build_source_count; ++cbr_ih_build_effect) BEGIN
      PATCH_IF enabled AND cbr_ih_build_effect = cbr_ih_insert BEGIN
        LPF cbr_append_spl_effect_record
          INT_VAR opcode = 328 target = cbr_ih_build_target power = cbr_ih_build_power parameter1 = 0 parameter2 = ih_state timing = cbr_ih_build_timing resist_dispel = cbr_ih_build_dr duration = cbr_ih_build_duration probability1 = cbr_ih_build_probability1 probability2 = cbr_ih_build_probability2 special = 1
        END
        ++cbr_ih_build_new_index
        LPF cbr_append_spl_effect_record
          INT_VAR opcode = 326 target = cbr_ih_build_target power = cbr_ih_build_power parameter1 = apr_half_state parameter2 = active_state_row timing = 1 resist_dispel = 2
          STR_VAR resource = EVAL ~%apr_helper_6%~
        END
        ++cbr_ih_build_new_index
        LPF cbr_append_spl_effect_record
          INT_VAR opcode = 326 target = cbr_ih_build_target power = cbr_ih_build_power parameter1 = apr_one_state parameter2 = active_state_row timing = 1 resist_dispel = 2
          STR_VAR resource = EVAL ~%apr_helper_1%~
        END
        ++cbr_ih_build_new_index
        LPF cbr_append_spl_effect_record
          INT_VAR opcode = 326 target = cbr_ih_build_target power = cbr_ih_build_power parameter1 = apr_one_half_state parameter2 = active_state_row timing = 1 resist_dispel = 2
          STR_VAR resource = EVAL ~%apr_helper_7%~
        END
        ++cbr_ih_build_new_index
      END
      PATCH_IF cbr_ih_build_effect < cbr_ih_build_source_count BEGIN
        SET cbr_ih_build_source = cbr_ih_build_effect_offset + (cbr_ih_build_source_first + cbr_ih_build_effect) * 0x30
        READ_SHORT cbr_ih_build_source cbr_ih_op READ_LONG (cbr_ih_build_source + 8) cbr_ih_p2
        READ_ASCII (cbr_ih_build_source + 0x14) cbr_ih_res (8) NULL
        SET cbr_ih_owned = ((cbr_ih_op = 328 AND (cbr_ih_p2 = ih_state OR cbr_ih_p2 = old_ih_half OR cbr_ih_p2 = old_ih_one OR cbr_ih_p2 = old_ih_one_half))
          OR (~%cbr_ih_res%~ STRING_MATCHES_REGEXP ~^CBRAP[RC][167]$~) = 0)
        PATCH_IF NOT cbr_ih_owned BEGIN
          LPF cbr_append_raw_spl_effect_record INT_VAR source_offset = cbr_ih_build_source END
          ++cbr_ih_build_new_index
        END
      END
    END
    SET cbr_ih_build_new_count = cbr_ih_build_new_index - cbr_ih_build_new_first
    WRITE_SHORT (cbr_ih_build_header_offset + 0x1e) cbr_ih_build_new_count
  END
  DELETE_BYTES cbr_ih_build_effect_offset cbr_ih_build_old_bytes
  WRITE_LONG 0x6a cbr_ih_build_effect_offset
END


DEFINE_PATCH_FUNCTION cbr_build_tempus_divine_cleanup
  STR_VAR
    divine_power_resref = ~~
    strength_set_18 = ~CBRST18~
    strength_set_19 = ~CBRST19~
    strength_set_20 = ~CBRST20~
    strength_set_21 = ~CBRST21~
BEGIN
  LPF cbr_tempus_repack_spl END
  LPF cbr_validate_spl_v1
    STR_VAR resource_name = EVAL ~Divine Power %divine_power_resref% cleanup source~
    RET
      cbr_divine_build_ability_offset = ability_offset
      cbr_divine_build_ability_count  = ability_count
      cbr_divine_build_effect_offset  = effect_offset
      cbr_divine_build_effect_count   = effect_count
  END
  SET cbr_divine_build_old_bytes = cbr_divine_build_effect_count * 0x30
  READ_SHORT 0x6e cbr_divine_build_casting_first
  READ_SHORT 0x70 cbr_divine_build_casting_count
  SET cbr_divine_build_new_index = 0
  FOR (cbr_divine_build_casting = 0; cbr_divine_build_casting < cbr_divine_build_casting_count; ++cbr_divine_build_casting) BEGIN
    SET cbr_divine_build_source = cbr_divine_build_effect_offset + ((cbr_divine_build_casting_first + cbr_divine_build_casting) * 0x30)
    READ_SHORT cbr_divine_build_source cbr_dv_op
    READ_ASCII (cbr_divine_build_source + 0x14) cbr_dv_res (8) NULL
    PATCH_IF NOT (cbr_dv_op = 321 AND ((~%cbr_dv_res%~ STRING_EQUAL_CASE ~OHTMPS1~)
      OR (~%cbr_dv_res%~ STRING_EQUAL_CASE ~%strength_set_18%~)
      OR (~%cbr_dv_res%~ STRING_EQUAL_CASE ~%strength_set_19%~)
      OR (~%cbr_dv_res%~ STRING_EQUAL_CASE ~%strength_set_20%~)
      OR (~%cbr_dv_res%~ STRING_EQUAL_CASE ~%strength_set_21%~))) BEGIN
      LPF cbr_append_raw_spl_effect_record INT_VAR source_offset = cbr_divine_build_source END
      ++cbr_divine_build_new_index
    END
  END
  WRITE_SHORT 0x6e 0 WRITE_SHORT 0x70 cbr_divine_build_new_index
  FOR (cbr_divine_build_header = 0; cbr_divine_build_header < cbr_divine_build_ability_count; ++cbr_divine_build_header) BEGIN
    SET cbr_divine_build_header_offset = cbr_divine_build_ability_offset + (cbr_divine_build_header * 0x28)
    READ_SHORT (cbr_divine_build_header_offset + 0x1e) cbr_divine_build_source_count
    READ_SHORT (cbr_divine_build_header_offset + 0x20) cbr_divine_build_source_first
    SET cbr_divine_build_new_first = cbr_divine_build_new_index
    WRITE_SHORT (cbr_divine_build_header_offset + 0x20) cbr_divine_build_new_first
    LPF cbr_append_spl_effect_record INT_VAR opcode = 321 target = 1 power = 4 parameter2 = 2 timing = 1 resist_dispel = 2 STR_VAR resource = ~OHTMPS1~ END
    ++cbr_divine_build_new_index
    LPF cbr_append_spl_effect_record INT_VAR opcode = 321 target = 1 power = 4 parameter2 = 2 timing = 1 resist_dispel = 2 STR_VAR resource = EVAL ~%strength_set_18%~ END
    ++cbr_divine_build_new_index
    LPF cbr_append_spl_effect_record INT_VAR opcode = 321 target = 1 power = 4 parameter2 = 2 timing = 1 resist_dispel = 2 STR_VAR resource = EVAL ~%strength_set_19%~ END
    ++cbr_divine_build_new_index
    LPF cbr_append_spl_effect_record INT_VAR opcode = 321 target = 1 power = 4 parameter2 = 2 timing = 1 resist_dispel = 2 STR_VAR resource = EVAL ~%strength_set_20%~ END
    ++cbr_divine_build_new_index
    LPF cbr_append_spl_effect_record INT_VAR opcode = 321 target = 1 power = 4 parameter2 = 2 timing = 1 resist_dispel = 2 STR_VAR resource = EVAL ~%strength_set_21%~ END
    ++cbr_divine_build_new_index
    // Replace Tempus cleanup by identity, retaining the spell's other effects.
    FOR (cbr_divine_build_effect = 0; cbr_divine_build_effect < cbr_divine_build_source_count; ++cbr_divine_build_effect) BEGIN
      SET cbr_divine_build_source = cbr_divine_build_effect_offset + ((cbr_divine_build_source_first + cbr_divine_build_effect) * 0x30)
      READ_SHORT cbr_divine_build_source cbr_dv_op
      READ_ASCII (cbr_divine_build_source + 0x14) cbr_dv_res (8) NULL
      SET cbr_dv_owned = cbr_dv_op = 321 AND ((~%cbr_dv_res%~ STRING_EQUAL_CASE ~OHTMPS1~)
        OR (~%cbr_dv_res%~ STRING_EQUAL_CASE ~%strength_set_18%~)
        OR (~%cbr_dv_res%~ STRING_EQUAL_CASE ~%strength_set_19%~)
        OR (~%cbr_dv_res%~ STRING_EQUAL_CASE ~%strength_set_20%~)
        OR (~%cbr_dv_res%~ STRING_EQUAL_CASE ~%strength_set_21%~))
      PATCH_IF NOT cbr_dv_owned BEGIN
        LPF cbr_append_raw_spl_effect_record INT_VAR source_offset = cbr_divine_build_source END
        ++cbr_divine_build_new_index
      END
    END
    SET cbr_divine_build_new_count = cbr_divine_build_new_index - cbr_divine_build_new_first
    WRITE_SHORT (cbr_divine_build_header_offset + 0x1e) cbr_divine_build_new_count
  END
  DELETE_BYTES cbr_divine_build_effect_offset cbr_divine_build_old_bytes
  WRITE_LONG 0x6a cbr_divine_build_effect_offset
END


DEFINE_ACTION_FUNCTION cbr_allocate_tempus_tables
  STR_VAR
    resource_dir              = ~~
    improved_haste_semantics  = ~~
  RET
    str_lt_row
    str_eq_row
    str_bonus_lt_row
    ih_state
    apr_half_state
    apr_one_state
    apr_one_half_state
    active_state_row
BEGIN
  OUTER_SPRINT resource_dir EVALUATE_BUFFER ~%resource_dir%~
  OUTER_SPRINT improved_haste_semantics EVALUATE_BUFFER ~%improved_haste_semantics%~
  OUTER_SPRINT cbr_splstate_path ~%resource_dir%/SPLSTATE.IDS~
  OUTER_SPRINT cbr_splprot_path ~%resource_dir%/SPLPROT.2DA~
  OUTER_SET str_lt_row = "-1"
  OUTER_SET str_eq_row = "-1"
  OUTER_SET str_bonus_lt_row = "-1"
  OUTER_SET ih_state = "-1"
  OUTER_SET apr_half_state = "-1"
  OUTER_SET apr_one_state = "-1"
  OUTER_SET apr_one_half_state = "-1"
  OUTER_SET active_state_row = "-1"
  ACTION_IF NOT FILE_EXISTS ~%cbr_splprot_path%~ BEGIN
    <<<<<<<< cbr-empty-splprot
2DA V1.0
0
STAT VALUE RELATION
>>>>>>>>
    COPY ~cbr-empty-splprot~ ~%cbr_splprot_path%~
  END
  ACTION_IF NOT FILE_EXISTS ~%cbr_splstate_path%~ BEGIN
    <<<<<<<< cbr-empty-splstate
IDS V1.0
>>>>>>>>
    COPY ~cbr-empty-splstate~ ~%cbr_splstate_path%~
  END
  ACTION_IF (~%improved_haste_semantics%~ STR_EQ ~additive~) BEGIN
    OUTER_SET cbr_append_states = 0
    COPY ~%cbr_splstate_path%~ ~%cbr_splstate_path%~
      LPF cbr_plan_tempus_splstates
        RET
          cbr_patch_ih_state           = ih_state
          cbr_patch_apr_half_state     = apr_half_state
          cbr_patch_apr_one_state      = apr_one_state
          cbr_patch_apr_one_half_state = apr_one_half_state
          cbr_patch_append_states      = append_states
      END
      INNER_ACTION BEGIN
        OUTER_SET cbr_ih_state           = cbr_patch_ih_state
        OUTER_SET cbr_apr_half_state     = cbr_patch_apr_half_state
        OUTER_SET cbr_apr_one_state      = cbr_patch_apr_one_state
        OUTER_SET cbr_apr_one_half_state = cbr_patch_apr_one_half_state
        OUTER_SET ih_state           = cbr_patch_ih_state
        OUTER_SET apr_half_state     = cbr_patch_apr_half_state
        OUTER_SET apr_one_state      = cbr_patch_apr_one_state
        OUTER_SET apr_one_half_state = cbr_patch_apr_one_half_state
        OUTER_SET cbr_append_states      = cbr_patch_append_states
      END
    BUT_ONLY
    ACTION_IF (cbr_append_states = 1) BEGIN
      LAF cbr_find_or_allocate_splstate INT_VAR planned_value = cbr_ih_state STR_VAR resource_path = EVAL ~%cbr_splstate_path%~ symbol = ~CBR_TEMPUS_IH~ END
      LAF cbr_find_or_allocate_splstate INT_VAR planned_value = cbr_apr_half_state STR_VAR resource_path = EVAL ~%cbr_splstate_path%~ symbol = ~CBR_TEMPUS_APR_HALF~ END
      LAF cbr_find_or_allocate_splstate INT_VAR planned_value = cbr_apr_one_state STR_VAR resource_path = EVAL ~%cbr_splstate_path%~ symbol = ~CBR_TEMPUS_APR_ONE~ END
      LAF cbr_find_or_allocate_splstate INT_VAR planned_value = cbr_apr_one_half_state STR_VAR resource_path = EVAL ~%cbr_splstate_path%~ symbol = ~CBR_TEMPUS_APR_ONE_HALF~ END
      CLEAR_IDS_MAP
    END ELSE BEGIN
      PRINT ~CBR: insufficient unused SPLSTATE slots; only the Improved Haste APR bridge is omitted.~
    END
  END
  COPY ~%cbr_splprot_path%~ ~%cbr_splprot_path%~
    SET cbr_allocate_active_state_row = "-1"
    PATCH_IF (~%improved_haste_semantics%~ STR_EQ ~additive~) AND ih_state >= 0 BEGIN
      LPF cbr_find_or_append_splprot
        INT_VAR stat = 0x112 value = "-1" relation = 1
        STR_VAR row_label = ~CBR_TEMPUS_STATE_ACTIVE~
        RET cbr_allocate_active_state_row = row_index
      END
    END
    LPF cbr_find_or_append_splprot
      INT_VAR stat = 36 value = "-1" relation = 2
      STR_VAR row_label = ~CBR_TEMPUS_STR_LT~
      RET cbr_allocate_str_lt_row = row_index
    END
    LPF cbr_find_or_append_splprot
      INT_VAR stat = 36 value = "-1" relation = 1
      STR_VAR row_label = ~CBR_TEMPUS_STR_EQ~
      RET cbr_allocate_str_eq_row = row_index
    END
    LPF cbr_find_or_append_splprot
      INT_VAR stat = 37 value = "-1" relation = 2
      STR_VAR row_label = ~CBR_TEMPUS_STR_BONUS_LT~
      RET cbr_allocate_str_bonus_lt_row = row_index
    END
    INNER_ACTION BEGIN
      OUTER_SET active_state_row = cbr_allocate_active_state_row
      OUTER_SET str_lt_row = cbr_allocate_str_lt_row
      OUTER_SET str_eq_row = cbr_allocate_str_eq_row
      OUTER_SET str_bonus_lt_row = cbr_allocate_str_bonus_lt_row
    END
  BUT_ONLY
END


DEFINE_ACTION_FUNCTION cbr_apply_tempus_progression
  INT_VAR holy_ability_count = 0 clab_capped_shape = 0 str_lt_row = (0 - 1) str_eq_row = (0 - 1) str_bonus_lt_row = (0 - 1)
  STR_VAR resource_dir = ~~ divine_power_resref = ~~
BEGIN
  OUTER_SPRINT resource_dir EVALUATE_BUFFER ~%resource_dir%~
  OUTER_SPRINT divine_power_resref EVALUATE_BUFFER ~%divine_power_resref%~
  LAF cbr_create_tempus_strength_helpers INT_VAR str_lt_row str_eq_row str_bonus_lt_row STR_VAR resource_dir END
  ACTION_IF FILE_EXISTS ~%resource_dir%/OHTMPS1.SPL~ BEGIN
    COPY ~%resource_dir%/OHTMPS1.SPL~ ~%resource_dir%/OHTMPS1.SPL~
      LPF cbr_build_tempus_holy_progression INT_VAR str_lt_row str_eq_row str_bonus_lt_row STR_VAR divine_power_resref END
    BUT_ONLY
  END ELSE BEGIN PRINT ~CBR: OHTMPS1.SPL is absent; no Holy Power spell to update.~ END
  ACTION_IF NOT FILE_EXISTS ~%resource_dir%/OHTEMPUS.2DA~ BEGIN
    <<<<<<<< cbr-empty-clab
2DA V1.0
****
1
>>>>>>>>
    COPY ~cbr-empty-clab~ ~%resource_dir%/OHTEMPUS.2DA~
  END
  COPY ~%resource_dir%/OHTEMPUS.2DA~ ~%resource_dir%/OHTEMPUS.2DA~
    LPF cbr_cap_tempus_clab END
  BUT_ONLY
END

DEFINE_ACTION_FUNCTION cbr_apply_tempus_bridge
  INT_VAR bridge_status = 0 divine_cleanup_status = 0 ih_state = (0 - 1)
    apr_half_state = (0 - 1) apr_one_state = (0 - 1) apr_one_half_state = (0 - 1) active_state_row = (0 - 1)
  STR_VAR resource_dir = ~~ improved_haste_semantics = ~~ improved_haste_resref = ~~ divine_power_resref = ~~
BEGIN
  OUTER_SPRINT resource_dir EVALUATE_BUFFER ~%resource_dir%~
  OUTER_SPRINT improved_haste_semantics EVALUATE_BUFFER ~%improved_haste_semantics%~
  OUTER_SPRINT improved_haste_resref EVALUATE_BUFFER ~%improved_haste_resref%~
  OUTER_SPRINT divine_power_resref EVALUATE_BUFFER ~%divine_power_resref%~
  // Existing owned condition helpers identify the previous marker even if
  // another installer reassigned its IDS symbol. Capture it before rewriting.
  ACTION_FOR_EACH cbr_old_key IN ~6~ ~1~ ~7~ BEGIN
    OUTER_SET $cbr_old_ih(~%cbr_old_key%~) = (0 - 1)
    ACTION_IF FILE_EXISTS ~%resource_dir%/CBRAPC%cbr_old_key%.eff~ BEGIN
      COPY ~%resource_dir%/CBRAPC%cbr_old_key%.eff~ ~%resource_dir%/CBRAPC%cbr_old_key%.eff~
        PATCH_IF BUFFER_LENGTH >= 0x20 BEGIN
          READ_LONG 0x10 cbr_old_op READ_LONG 0x1c cbr_old_state
          PATCH_IF cbr_old_op = 326 AND cbr_old_state >= 0 AND cbr_old_state < 256 BEGIN
            INNER_ACTION BEGIN OUTER_SET $cbr_old_ih(~%cbr_old_key%~) = cbr_old_state END
          END
        END
      BUT_ONLY
    END
  END
  OUTER_SET enabled = ((~%improved_haste_semantics%~ STRING_EQUAL ~additive~)
    AND ih_state >= 0 AND apr_half_state >= 0 AND apr_one_state >= 0 AND apr_one_half_state >= 0 AND active_state_row >= 0)
  ACTION_IF enabled BEGIN
    LAF cbr_create_tempus_apr_helpers INT_VAR ih_state active_state_row STR_VAR resource_dir END
    ACTION_IF FILE_EXISTS ~%resource_dir%/OHTMPS1.SPL~ BEGIN
      COPY ~%resource_dir%/OHTMPS1.SPL~ ~%resource_dir%/OHTMPS1.SPL~
        LPF cbr_build_tempus_holy_bridge INT_VAR ih_state apr_half_state apr_one_state apr_one_half_state active_state_row END
      BUT_ONLY
    END
  END ELSE ACTION_IF FILE_EXISTS ~%resource_dir%/SPLSTATE.IDS~ BEGIN
    // Resolve a previous installation's state only to remove its old bridge.
    COPY ~%resource_dir%/SPLSTATE.IDS~ ~%resource_dir%/SPLSTATE.IDS~
      READ_ASCII 0 cbr_old_states (BUFFER_LENGTH)
      INNER_PATCH ~%cbr_old_states%~ BEGIN
        REPLACE_EVALUATE CASE_INSENSITIVE ~^[ %TAB%]*\([^ %TAB%%WNL%%LNL%%MNL%]+\)[ %TAB%]+CBR_TEMPUS_IH\b~ BEGIN
          PATCH_IF IS_AN_INT ~%MATCH1%~ BEGIN SET ih_state = MATCH1 END
        END ~%MATCH0%~
      END
    BUT_ONLY
  END
  ACTION_IF NOT enabled AND (~%improved_haste_semantics%~ STRING_EQUAL ~additive~) BEGIN
    // Replace stale helpers as well, including resources indexed in a BIF.
    // Old saved heartbeat effects then only clear this feature's own bonus.
    ACTION_FOR_EACH cbr_off_key IN ~6~ ~1~ ~7~ BEGIN
      COPY ~%resource_dir%/SPLPROT.2DA~ ~%resource_dir%/CBRAPR%cbr_off_key%.spl~
        LPF cbr_tempus_blank END LPF cbr_add_basic_self_ability END
        LPF cbr_append_spl_effect_record INT_VAR opcode = 321 target = 1 timing = 1
          STR_VAR resource = EVAL ~CBRAPR%cbr_off_key%~ END
        WRITE_SHORT 0x90 1
      COPY ~%resource_dir%/SPLPROT.2DA~ ~%resource_dir%/CBRAPC%cbr_off_key%.eff~
        LPF cbr_tempus_blank INT_VAR size = 0x110 STR_VAR signature = ~EFF V2.0~ END
        WRITE_LONG 0x10 321 WRITE_LONG 0x14 2 WRITE_LONG 0x24 1 WRITE_SHORT 0x2c 100
        WRITE_ASCIIE 0x30 ~CBRAPR%cbr_off_key%~ #8 WRITE_LONG 0x5c 2
    END
  END
  ACTION_IF FILE_EXISTS ~%resource_dir%/%improved_haste_resref%.SPL~ BEGIN
    COPY ~%resource_dir%/%improved_haste_resref%.SPL~ ~%resource_dir%/%improved_haste_resref%.SPL~
      LPF cbr_validate_spl_v1 STR_VAR resource_name = EVAL ~%improved_haste_resref%.SPL~ RET readable END
      PATCH_IF readable BEGIN
        LPF cbr_build_tempus_ih_bridge INT_VAR enabled ih_state apr_half_state apr_one_state apr_one_half_state active_state_row
          old_ih_half = $cbr_old_ih(~6~) old_ih_one = $cbr_old_ih(~1~) old_ih_one_half = $cbr_old_ih(~7~)
          STR_VAR improved_haste_resref END
      END
    BUT_ONLY
  END ELSE BEGIN PRINT ~CBR: Improved Haste %improved_haste_resref%.SPL is absent; continuing without its bridge.~ END
  ACTION_IF FILE_EXISTS ~%resource_dir%/%divine_power_resref%.SPL~ BEGIN
    COPY ~%resource_dir%/%divine_power_resref%.SPL~ ~%resource_dir%/%divine_power_resref%.SPL~
      LPF cbr_validate_spl_v1 STR_VAR resource_name = EVAL ~%divine_power_resref%.SPL~ RET readable END
      PATCH_IF readable BEGIN LPF cbr_build_tempus_divine_cleanup STR_VAR divine_power_resref END END
    BUT_ONLY
  END ELSE BEGIN PRINT ~CBR: Divine Power %divine_power_resref%.SPL is absent; continuing without its cleanup.~ END
END

DEFINE_ACTION_FUNCTION cbr_apply_tempus_holy_power
  STR_VAR resource_dir = ~~ compatibility_mode = ~auto~ divine_power_resref = ~~ improved_haste_resref = ~~
    phase = ~full~ spell_ids = ~require~
BEGIN
  OUTER_SPRINT resource_dir EVALUATE_BUFFER ~%resource_dir%~
  OUTER_SPRINT compatibility_mode EVALUATE_BUFFER ~%compatibility_mode%~
  OUTER_SPRINT divine_power_resref EVALUATE_BUFFER ~%divine_power_resref%~
  OUTER_SPRINT improved_haste_resref EVALUATE_BUFFER ~%improved_haste_resref%~
  OUTER_SPRINT phase EVALUATE_BUFFER ~%phase%~
  ACTION_IF NOT (~%compatibility_mode%~ STRING_EQUAL ~auto~ OR ~%compatibility_mode%~ STRING_EQUAL ~force_double~
    OR ~%compatibility_mode%~ STRING_EQUAL ~force_additive~) BEGIN
    FAIL ~CBR Tempus Holy Power: invalid compatibility mode %compatibility_mode%.~
  END
  ACTION_IF NOT (~%phase%~ STRING_EQUAL ~classify~ OR ~%phase%~ STRING_EQUAL ~allocate~ OR ~%phase%~ STRING_EQUAL ~progression~
    OR ~%phase%~ STRING_EQUAL ~bridge~ OR ~%phase%~ STRING_EQUAL ~full~) BEGIN
    FAIL ~CBR Tempus Holy Power: invalid phase %phase%.~
  END
  ACTION_IF ~%resource_dir%~ STRING_EQUAL ~~ BEGIN FAIL ~CBR Tempus Holy Power: explicit resource_dir is required.~ END
  LAF cbr_classify_improved_haste_file STR_VAR resource_dir improved_haste_resref compatibility_mode
    RET cbr_semantics = semantics END
  ACTION_IF ~%phase%~ STRING_EQUAL ~classify~ BEGIN
    PRINT ~CBR Improved Haste %improved_haste_resref% classified as %cbr_semantics%.~
  END ELSE BEGIN
    LAF cbr_allocate_tempus_tables STR_VAR resource_dir improved_haste_semantics = EVAL ~%cbr_semantics%~
      RET str_lt_row str_eq_row str_bonus_lt_row ih_state apr_half_state apr_one_state apr_one_half_state active_state_row END
    ACTION_IF NOT (~%phase%~ STRING_EQUAL ~allocate~) BEGIN
      LAF cbr_apply_tempus_progression INT_VAR str_lt_row str_eq_row str_bonus_lt_row STR_VAR resource_dir divine_power_resref END
      ACTION_IF NOT (~%phase%~ STRING_EQUAL ~progression~) BEGIN
        LAF cbr_apply_tempus_bridge INT_VAR ih_state apr_half_state apr_one_state apr_one_half_state active_state_row
          STR_VAR resource_dir improved_haste_semantics = EVAL ~%cbr_semantics%~ improved_haste_resref divine_power_resref END
      END
    END
  END
END
