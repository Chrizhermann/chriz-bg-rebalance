// Tempus Holy Power shared implementation.
//
// This file is deliberately self-contained.  It does not INCLUDE SCS, Spell
// Revisions, or Artisan's Kitpack at install time.  The SPL V1 table walk uses
// the empirical nFx@0x1e / firstFxIdx@0x20 layout recorded in research/04.
// Improved Haste classification follows the final SR direct-opcode pattern
// documented there, but validates every reachable header instead of assuming
// a particular resref such as SPWI613.

DEFINE_PATCH_FUNCTION cbr_validate_spl_v1
  STR_VAR
    resource_name = ~unknown SPL~
  RET
    ability_offset
    ability_count
    effect_offset
    effect_count
BEGIN
  SET ability_offset = 0
  SET ability_count = 0
  SET effect_offset = 0
  SET effect_count = 0

  PATCH_IF (BUFFER_LENGTH < 0x72) BEGIN
    PATCH_FAIL ~CBR SPL V1 validation failed for %resource_name%: header is truncated (%BUFFER_LENGTH% bytes).~
  END

  READ_ASCII 0x00 cbr_spl_signature (8)
  PATCH_IF !(~%cbr_spl_signature%~ STR_EQ ~SPL V1  ~) BEGIN
    PATCH_FAIL ~CBR SPL V1 validation failed for %resource_name%: expected SPL V1 signature.~
  END

  READ_LONG  0x64 ability_offset
  READ_SHORT 0x68 ability_count
  READ_LONG  0x6a effect_offset
  READ_SHORT 0x6e cbr_casting_first
  READ_SHORT 0x70 cbr_casting_count

  SET cbr_ability_end = ability_offset + (ability_count * 0x28)
  PATCH_IF (ability_offset < 0x72 || cbr_ability_end > BUFFER_LENGTH) BEGIN
    PATCH_FAIL ~CBR SPL V1 validation failed for %resource_name%: ability table is out of bounds.~
  END
  PATCH_IF (effect_offset < cbr_ability_end || effect_offset > BUFFER_LENGTH) BEGIN
    PATCH_FAIL ~CBR SPL V1 validation failed for %resource_name%: effect table overlaps or is out of bounds.~
  END
  PATCH_IF (((BUFFER_LENGTH - effect_offset) MODULO 0x30) != 0) BEGIN
    PATCH_FAIL ~CBR SPL V1 validation failed for %resource_name%: effect table has a partial opcode record.~
  END

  SET effect_count = (BUFFER_LENGTH - effect_offset) / 0x30
  PATCH_IF ((cbr_casting_first + cbr_casting_count) > effect_count) BEGIN
    PATCH_FAIL ~CBR SPL V1 validation failed for %resource_name%: casting-effect slice is out of bounds.~
  END

  FOR (cbr_header = 0; cbr_header < ability_count; ++cbr_header) BEGIN
    SET cbr_header_offset = ability_offset + (cbr_header * 0x28)
    READ_SHORT (cbr_header_offset + 0x1e) cbr_header_effect_count
    READ_SHORT (cbr_header_offset + 0x20) cbr_header_first_effect
    PATCH_IF ((cbr_header_first_effect + cbr_header_effect_count) > effect_count) BEGIN
      PATCH_FAIL ~CBR SPL V1 validation failed for %resource_name%: header %cbr_header% opcode slice is out of bounds.~
    END
  END

  // Every rebuilder below copies casting and ability slices into a fresh table.
  // Require those slices to form an exact partition so no orphan record can be
  // dropped and no overlapping record can be duplicated during that rebuild.
  FOR (cbr_partition_effect = 0; cbr_partition_effect < effect_count; ++cbr_partition_effect) BEGIN
    SET cbr_partition_references = 0
    PATCH_IF (cbr_partition_effect >= cbr_casting_first
           && cbr_partition_effect < (cbr_casting_first + cbr_casting_count)) BEGIN
      ++cbr_partition_references
    END
    FOR (cbr_partition_header = 0; cbr_partition_header < ability_count; ++cbr_partition_header) BEGIN
      SET cbr_partition_header_offset = ability_offset + (cbr_partition_header * 0x28)
      READ_SHORT (cbr_partition_header_offset + 0x1e) cbr_partition_header_count
      READ_SHORT (cbr_partition_header_offset + 0x20) cbr_partition_header_first
      PATCH_IF (cbr_partition_effect >= cbr_partition_header_first
             && cbr_partition_effect < (cbr_partition_header_first + cbr_partition_header_count)) BEGIN
        ++cbr_partition_references
      END
    END
    PATCH_IF (cbr_partition_references != 1) BEGIN
      PATCH_FAIL ~CBR SPL V1 validation failed for %resource_name%: effect-table record %cbr_partition_effect% has %cbr_partition_references% references; casting and ability slices must form an exact nonoverlapping partition.~
    END
  END
END

DEFINE_PATCH_FUNCTION cbr_classify_improved_haste
  STR_VAR
    improved_haste_resref = ~~
    compatibility_mode    = ~auto~
  RET
    classification
BEGIN
  SPRINT classification ~~

  LPF cbr_validate_spl_v1
    STR_VAR resource_name = ~Improved Haste %improved_haste_resref%~
    RET
      cbr_ih_ability_offset = ability_offset
      cbr_ih_ability_count  = ability_count
      cbr_ih_effect_offset  = effect_offset
      cbr_ih_effect_count   = effect_count
  END

  PATCH_IF (cbr_ih_ability_count < 1) BEGIN
    PATCH_FAIL ~CBR Improved Haste %improved_haste_resref% has no reachable ability header or opcode layout.~
  END

  SET cbr_ih_detected = 0
  SET cbr_ih_previous_level = 0

  FOR (cbr_header = 0; cbr_header < cbr_ih_ability_count; ++cbr_header) BEGIN
    SET cbr_header_offset = cbr_ih_ability_offset + (cbr_header * 0x28)
    READ_SHORT (cbr_header_offset + 0x10) cbr_header_level
    READ_SHORT (cbr_header_offset + 0x1e) cbr_header_effect_count
    READ_SHORT (cbr_header_offset + 0x20) cbr_header_first_effect

    PATCH_IF (cbr_header_level < 1 || (cbr_header > 0 && cbr_header_level <= cbr_ih_previous_level)) BEGIN
      PATCH_FAIL ~CBR Improved Haste %improved_haste_resref% header %cbr_header% is not a uniquely reachable caster-level header; inspect header levels and opcode layout.~
    END
    SET cbr_ih_previous_level = cbr_header_level

    SET cbr_additive_count = 0
    SET cbr_additive_deterministic = 0
    SET cbr_double_count = 0
    SET cbr_double_deterministic = 0

    FOR (cbr_effect = 0; cbr_effect < cbr_header_effect_count; ++cbr_effect) BEGIN
      SET cbr_effect_index = cbr_header_first_effect + cbr_effect
      SET cbr_effect_offset = cbr_ih_effect_offset + (cbr_effect_index * 0x30)
      READ_SHORT (cbr_effect_offset + 0x00) cbr_opcode
      READ_LONG  (cbr_effect_offset + 0x04) cbr_parameter1
      READ_LONG  (cbr_effect_offset + 0x08) cbr_parameter2
      READ_BYTE  (cbr_effect_offset + 0x0c) cbr_timing
      READ_BYTE  (cbr_effect_offset + 0x0d) cbr_resist_dispel
      READ_LONG  (cbr_effect_offset + 0x0e) cbr_duration
      READ_BYTE  (cbr_effect_offset + 0x12) cbr_probability1
      READ_BYTE  (cbr_effect_offset + 0x13) cbr_probability2
      READ_ASCII (cbr_effect_offset + 0x14) cbr_resource (8) NULL
      READ_LONG  (cbr_effect_offset + 0x1c) cbr_dice_number
      READ_LONG  (cbr_effect_offset + 0x20) cbr_dice_size
      READ_LONG  (cbr_effect_offset + 0x24) cbr_save_type
      READ_LONG  (cbr_effect_offset + 0x28) cbr_save_bonus
      READ_LONG  (cbr_effect_offset + 0x2c) cbr_special

      PATCH_IF (cbr_opcode = 1 && cbr_parameter1 = 1 && cbr_parameter2 = 0) BEGIN
        ++cbr_additive_count
        PATCH_IF (cbr_timing = 0
               && cbr_duration > 0
               && cbr_probability1 = 100
               && cbr_probability2 = 0
               && ((cbr_resist_dispel BAND 2) = 2)
               && ~%cbr_resource%~ STR_EQ ~~
               && cbr_dice_number = 0
               && cbr_dice_size = 0
               && cbr_save_type = 0
               && cbr_save_bonus = 0
               && cbr_special = 0) BEGIN
          ++cbr_additive_deterministic
        END
      END

      PATCH_IF ((cbr_opcode = 16 || cbr_opcode = 317) && cbr_parameter2 = 1) BEGIN
        ++cbr_double_count
        PATCH_IF ((cbr_timing = 0 || cbr_timing = 3) && cbr_duration > 0 && cbr_probability1 = 100 && cbr_probability2 = 0) BEGIN
          ++cbr_double_deterministic
        END
      END
    END

    SET cbr_header_semantics = 0
    PATCH_IF (cbr_additive_count = 1 && cbr_additive_deterministic = 1 && cbr_double_count = 0) BEGIN
      SET cbr_header_semantics = 1
    END ELSE PATCH_IF (cbr_double_count = 1 && cbr_double_deterministic = 1 && cbr_additive_count = 0) BEGIN
      SET cbr_header_semantics = 2
    END ELSE BEGIN
      PATCH_FAIL ~CBR Improved Haste %improved_haste_resref% header %cbr_header% has an unsafe opcode/probability layout for mode %compatibility_mode%: opcode1 additive=%cbr_additive_count% deterministic=%cbr_additive_deterministic%; opcode16/317 double=%cbr_double_count% deterministic=%cbr_double_deterministic%; require timed probability 100/0.~
    END

    PATCH_IF (cbr_ih_detected = 0) BEGIN
      SET cbr_ih_detected = cbr_header_semantics
    END ELSE PATCH_IF (cbr_ih_detected != cbr_header_semantics) BEGIN
      PATCH_FAIL ~CBR Improved Haste %improved_haste_resref% is header-inconsistent at header %cbr_header%: additive and opcode16/317 doubling semantics differ; mode %compatibility_mode%.~
    END
  END

  PATCH_IF (cbr_ih_detected = 1) BEGIN
    SPRINT classification ~additive~
  END ELSE PATCH_IF (cbr_ih_detected = 2) BEGIN
    SPRINT classification ~double~
  END ELSE BEGIN
    PATCH_FAIL ~CBR Improved Haste %improved_haste_resref% has neither a supported additive opcode nor opcode16/317 doubling layout.~
  END

  PATCH_IF (~%compatibility_mode%~ STR_EQ ~force_additive~ && !(~%classification%~ STR_EQ ~additive~)) BEGIN
    PATCH_FAIL ~CBR Improved Haste %improved_haste_resref% header opcode semantics are %classification%, but mode force_additive was selected.~
  END
  PATCH_IF (~%compatibility_mode%~ STR_EQ ~force_double~ && !(~%classification%~ STR_EQ ~double~)) BEGIN
    PATCH_FAIL ~CBR Improved Haste %improved_haste_resref% header opcode semantics are %classification%, but mode force_double was selected.~
  END
END

// Read an explicit file without consulting the game KEY.  INNER_ACTION lifts
// the pure patch result to the action caller; the COPY is source=destination
// and BUT_ONLY guarantees that classification cannot rewrite the SPL.
DEFINE_ACTION_FUNCTION cbr_classify_improved_haste_file
  STR_VAR
    resource_path           = ~~
    improved_haste_resref   = ~~
    compatibility_mode      = ~auto~
  RET
    semantics
BEGIN
  OUTER_SPRINT resource_path         EVALUATE_BUFFER ~%resource_path%~
  OUTER_SPRINT improved_haste_resref EVALUATE_BUFFER ~%improved_haste_resref%~
  OUTER_SPRINT compatibility_mode    EVALUATE_BUFFER ~%compatibility_mode%~
  OUTER_SPRINT semantics ~~
  COPY ~%resource_path%~ ~%resource_path%~
    LPF cbr_classify_improved_haste
      STR_VAR
        improved_haste_resref = EVAL ~%improved_haste_resref%~
        compatibility_mode    = EVAL ~%compatibility_mode%~
      RET cbr_patch_semantics = classification
    END
    INNER_ACTION BEGIN
      OUTER_SPRINT semantics ~%cbr_patch_semantics%~
    END
  BUT_ONLY
  ACTION_IF (~%semantics%~ STR_EQ ~~) BEGIN
    FAIL ~CBR Improved Haste %improved_haste_resref% classification did not return header opcode semantics.~
  END
END

// Public utility surface used by later implementation phases.  The two
// structural builders are namespaced adaptations of SCS v35's
// add_basic_spell_ability / final-header table-walk patterns; they remain
// local so installed SCS code is never a runtime dependency.
DEFINE_PATCH_FUNCTION cbr_add_basic_self_ability
  RET
    ability_index
    ability_offset
BEGIN
  PATCH_IF (BUFFER_LENGTH != 0x72) BEGIN
    PATCH_FAIL ~CBR add_basic_self_ability requires a blank SPL V1 header.~
  END
  READ_ASCII 0x00 cbr_blank_signature (8)
  PATCH_IF !(~%cbr_blank_signature%~ STR_EQ ~SPL V1  ~) BEGIN
    PATCH_FAIL ~CBR add_basic_self_ability requires an SPL V1 signature.~
  END
  // CREATE SPL supplies tool defaults (including TLK/header metadata) that are
  // irrelevant to private opcode-only helpers.  Erase them so generation and
  // reserved-resref recognition share one deterministic byte template.
  FOR (cbr_blank_byte = 0x08; cbr_blank_byte < 0x64; ++cbr_blank_byte) BEGIN
    WRITE_BYTE cbr_blank_byte 0
  END
  SET ability_index = 0
  SET ability_offset = 0x72
  INSERT_BYTES 0x72 0x28
  WRITE_SHORT 0x72 1
  WRITE_SHORT 0x74 4
  WRITE_BYTE  0x7e 5
  WRITE_SHORT 0x82 1
  WRITE_SHORT 0x94 1
  WRITE_SHORT 0x96 1
  WRITE_SHORT 0x98 0
  WRITE_LONG  0x64 0x72
  WRITE_SHORT 0x68 1
  WRITE_LONG  0x6a 0x9a
  WRITE_SHORT 0x6e 0
  WRITE_SHORT 0x70 0
END

DEFINE_PATCH_FUNCTION cbr_clone_final_spell_header
  STR_VAR
    resource_name = ~unknown SPL~
  RET
    cloned_header_index
BEGIN
  LPF cbr_validate_spl_v1
    STR_VAR resource_name = EVAL ~%resource_name%~
    RET
      cbr_clone_ability_offset = ability_offset
      cbr_clone_ability_count  = ability_count
      cbr_clone_effect_offset  = effect_offset
      cbr_clone_effect_count   = effect_count
  END
  PATCH_IF (cbr_clone_ability_count < 1) BEGIN
    PATCH_FAIL ~CBR cannot clone the final header of %resource_name%: the SPL has no ability headers.~
  END
  SET cbr_clone_ability_end = cbr_clone_ability_offset + (cbr_clone_ability_count * 0x28)
  PATCH_IF (cbr_clone_ability_end != cbr_clone_effect_offset) BEGIN
    PATCH_FAIL ~CBR cannot clone the final header of %resource_name%: noncanonical data separates the ability and effect tables.~
  END

  SET cloned_header_index = cbr_clone_ability_count
  SET cbr_clone_donor_offset = cbr_clone_ability_offset + ((cbr_clone_ability_count - 1) * 0x28)
  READ_SHORT (cbr_clone_donor_offset + 0x1e) cbr_clone_donor_effect_count
  READ_SHORT (cbr_clone_donor_offset + 0x20) cbr_clone_donor_first_effect

  // Minimal namespaced adaptation of the final-header cloning table walk used
  // by SCS: insert the header before the effect table, then clone its exact
  // opcode bytes at the tail and point the new header at that appended slice.
  INSERT_BYTES cbr_clone_ability_end 0x28
  FOR (cbr_clone_byte = 0; cbr_clone_byte < 0x28; ++cbr_clone_byte) BEGIN
    READ_BYTE (cbr_clone_donor_offset + cbr_clone_byte) cbr_clone_value
    WRITE_BYTE (cbr_clone_ability_end + cbr_clone_byte) cbr_clone_value
  END
  SET cbr_clone_shifted_effect_offset = cbr_clone_effect_offset + 0x28
  SET cbr_clone_append_offset = BUFFER_LENGTH
  INSERT_BYTES cbr_clone_append_offset (cbr_clone_donor_effect_count * 0x30)
  FOR (cbr_clone_byte = 0; cbr_clone_byte < (cbr_clone_donor_effect_count * 0x30); ++cbr_clone_byte) BEGIN
    READ_BYTE (cbr_clone_shifted_effect_offset + (cbr_clone_donor_first_effect * 0x30) + cbr_clone_byte) cbr_clone_value
    WRITE_BYTE (cbr_clone_append_offset + cbr_clone_byte) cbr_clone_value
  END
  WRITE_SHORT (cbr_clone_ability_end + 0x20) cbr_clone_effect_count
  WRITE_SHORT 0x68 (cbr_clone_ability_count + 1)
  WRITE_LONG  0x6a cbr_clone_shifted_effect_offset
END

// Append one exact SPL V1 effect record.  The caller owns the surrounding
// header indices/counts; keeping this primitive index-neutral makes it useful
// both for one-header private helpers and for an atomic whole-table rebuild.
DEFINE_PATCH_FUNCTION cbr_append_spl_effect_record
  INT_VAR
    opcode          = 0
    target          = 0
    power           = 0
    parameter1      = 0
    parameter2      = 0
    timing          = 0
    resist_dispel   = 0
    duration        = 0
    probability1    = 100
    probability2    = 0
    dice_number     = 0
    dice_size       = 0
    save_type       = 0
    save_bonus      = 0
    special         = 0
  STR_VAR
    resource        = ~~
  RET
    appended_offset
BEGIN
  SET appended_offset = BUFFER_LENGTH
  INSERT_BYTES appended_offset 0x30
  WRITE_SHORT appended_offset opcode
  WRITE_BYTE  (appended_offset + 0x02) target
  WRITE_BYTE  (appended_offset + 0x03) power
  WRITE_LONG  (appended_offset + 0x04) parameter1
  WRITE_LONG  (appended_offset + 0x08) parameter2
  WRITE_BYTE  (appended_offset + 0x0c) timing
  WRITE_BYTE  (appended_offset + 0x0d) resist_dispel
  WRITE_LONG  (appended_offset + 0x0e) duration
  WRITE_BYTE  (appended_offset + 0x12) probability1
  WRITE_BYTE  (appended_offset + 0x13) probability2
  WRITE_ASCIIE (appended_offset + 0x14) ~%resource%~ #8
  WRITE_LONG  (appended_offset + 0x1c) dice_number
  WRITE_LONG  (appended_offset + 0x20) dice_size
  WRITE_LONG  (appended_offset + 0x24) save_type
  WRITE_LONG  (appended_offset + 0x28) save_bonus
  WRITE_LONG  (appended_offset + 0x2c) special
END

// Copy a complete effect record without interpreting any of its fields.  A
// nonnegative duration override is used only for narrowly recognized
// source-owned visual/state effects whose lifetime follows Holy Power.
DEFINE_PATCH_FUNCTION cbr_append_raw_spl_effect_record
  INT_VAR
    source_offset     = 0
    duration_override = "-1"
  RET
    appended_offset
BEGIN
  PATCH_IF (source_offset < 0 || (source_offset + 0x30) > BUFFER_LENGTH) BEGIN
    PATCH_FAIL ~CBR cannot copy an out-of-bounds SPL effect record at %source_offset%.~
  END
  SET appended_offset = BUFFER_LENGTH
  INSERT_BYTES appended_offset 0x30
  FOR (cbr_raw_byte = 0; cbr_raw_byte < 0x30; ++cbr_raw_byte) BEGIN
    READ_BYTE (source_offset + cbr_raw_byte) cbr_raw_value
    WRITE_BYTE (appended_offset + cbr_raw_byte) cbr_raw_value
  END
  PATCH_IF (duration_override >= 0) BEGIN
    WRITE_LONG (appended_offset + 0x0e) duration_override
  END
END

DEFINE_PATCH_FUNCTION cbr_validate_tempus_clab
  RET
    capped_shape
    ability1_row
BEGIN
  SET capped_shape = 0
  SET ability1_row = "-1"
  COUNT_2DA_COLS cbr_clab_cols
  PATCH_IF (cbr_clab_cols != 51) BEGIN
    PATCH_FAIL ~CBR Tempus CLAB OHTEMPUS.2DA validation failed: expected row label plus levels 1 through 50.~
  END
  READ_2DA_ENTRIES_NOW cbr_clab_rows 51
  SET cbr_ability1_row = "-1"
  SET cbr_ability1_count = 0
  FOR (cbr_row = 0; cbr_row < cbr_clab_rows; ++cbr_row) BEGIN
    READ_2DA_ENTRY_FORMER cbr_clab_rows cbr_row 0 cbr_clab_label
    PATCH_IF (~%cbr_clab_label%~ STR_EQ ~ABILITY1~) BEGIN
      SET cbr_ability1_row = cbr_row
      ++cbr_ability1_count
    END
  END
  PATCH_IF (cbr_ability1_count != 1) BEGIN
    PATCH_FAIL ~CBR Tempus CLAB OHTEMPUS.2DA validation failed: expected exactly one ABILITY1 row.~
  END
  SET ability1_row = cbr_ability1_row

  SET cbr_late_original = 0
  SET cbr_late_capped = 0
  FOR (cbr_level = 1; cbr_level <= 50; ++cbr_level) BEGIN
    READ_2DA_ENTRY_FORMER cbr_clab_rows cbr_ability1_row cbr_level cbr_clab_cell
    SET cbr_early_grant = (cbr_level = 1 || cbr_level = 6 || cbr_level = 11 || cbr_level = 16 || cbr_level = 21)
    SET cbr_late_grant = (cbr_level = 26 || cbr_level = 31 || cbr_level = 36 || cbr_level = 41 || cbr_level = 46)
    PATCH_IF (cbr_early_grant) BEGIN
      PATCH_IF !(~%cbr_clab_cell%~ STR_EQ ~GA_OHTMPS1~) BEGIN
        PATCH_FAIL ~CBR Tempus CLAB OHTEMPUS.2DA validation failed: ABILITY1 level %cbr_level% must grant GA_OHTMPS1.~
      END
    END ELSE PATCH_IF (cbr_level = 25) BEGIN
      PATCH_IF !(~%cbr_clab_cell%~ STR_EQ ~AP_CDHLYSYM~) BEGIN
        PATCH_FAIL ~CBR Tempus CLAB OHTEMPUS.2DA validation failed: ABILITY1 level 25 must preserve AP_CDHLYSYM.~
      END
    END ELSE PATCH_IF (cbr_late_grant) BEGIN
      PATCH_IF (~%cbr_clab_cell%~ STR_EQ ~GA_OHTMPS1~) BEGIN
        ++cbr_late_original
      END ELSE PATCH_IF (~%cbr_clab_cell%~ STR_EQ ~****~) BEGIN
        ++cbr_late_capped
      END ELSE BEGIN
        PATCH_FAIL ~CBR Tempus CLAB OHTEMPUS.2DA validation failed: ABILITY1 level %cbr_level% has an unrecognized Holy Power grant.~
      END
    END ELSE PATCH_IF !(~%cbr_clab_cell%~ STR_EQ ~****~) BEGIN
      PATCH_FAIL ~CBR Tempus CLAB OHTEMPUS.2DA validation failed: ABILITY1 level %cbr_level% must be empty.~
    END
  END
  PATCH_IF !((cbr_late_original = 5 && cbr_late_capped = 0) || (cbr_late_original = 0 && cbr_late_capped = 5)) BEGIN
    PATCH_FAIL ~CBR Tempus CLAB OHTEMPUS.2DA validation failed: late Holy Power grants are partially cleared.~
  END
  PATCH_IF (cbr_late_capped = 5) BEGIN
    SET capped_shape = 1
  END
END

DEFINE_PATCH_FUNCTION cbr_cap_tempus_clab
BEGIN
  LPF cbr_validate_tempus_clab
    RET cbr_cap_already_capped = capped_shape
  END
  PATCH_IF (!cbr_cap_already_capped) BEGIN
    // Deferred 2DA writers normalize whitespace/newlines globally.  Walk the
    // already validated ABILITY1 row instead and shrink only the five literal
    // GA_OHTMPS1 tokens to ****, preserving every surrounding byte.
    SET cbr_cap_scan = 0
    SET cbr_cap_position = "-1"
    WHILE (cbr_cap_position < 0 && cbr_cap_scan < BUFFER_LENGTH) BEGIN
      SET cbr_cap_candidate = cbr_cap_scan
      SET cbr_cap_skipping_indent = 1
      WHILE (cbr_cap_skipping_indent && cbr_cap_candidate < BUFFER_LENGTH) BEGIN
        READ_BYTE cbr_cap_candidate cbr_cap_byte
        PATCH_IF (cbr_cap_byte = 9 || cbr_cap_byte = 32) BEGIN
          ++cbr_cap_candidate
        END ELSE BEGIN
          SET cbr_cap_skipping_indent = 0
        END
      END
      PATCH_IF ((cbr_cap_candidate + 8) < BUFFER_LENGTH) BEGIN
        READ_ASCII cbr_cap_candidate cbr_cap_line_label (8)
        READ_BYTE (cbr_cap_candidate + 8) cbr_cap_after_label
        PATCH_IF (~%cbr_cap_line_label%~ STR_EQ ~ABILITY1~
               && (cbr_cap_after_label = 9 || cbr_cap_after_label = 32)) BEGIN
          SET cbr_cap_position = cbr_cap_candidate
        END
      END
      PATCH_IF (cbr_cap_position < 0) BEGIN
        SET cbr_cap_at_eol = 0
        WHILE (!cbr_cap_at_eol && cbr_cap_scan < BUFFER_LENGTH) BEGIN
          READ_BYTE cbr_cap_scan cbr_cap_byte
          PATCH_IF (cbr_cap_byte = 10 || cbr_cap_byte = 13) BEGIN
            SET cbr_cap_at_eol = 1
          END ELSE BEGIN
            ++cbr_cap_scan
          END
        END
        SET cbr_cap_skipping_eol = 1
        WHILE (cbr_cap_skipping_eol && cbr_cap_scan < BUFFER_LENGTH) BEGIN
          READ_BYTE cbr_cap_scan cbr_cap_byte
          PATCH_IF (cbr_cap_byte = 10 || cbr_cap_byte = 13) BEGIN
            ++cbr_cap_scan
          END ELSE BEGIN
            SET cbr_cap_skipping_eol = 0
          END
        END
      END
    END
    PATCH_IF (cbr_cap_position < 0) BEGIN
      PATCH_FAIL ~CBR Tempus CLAB cap could not relocate the validated ABILITY1 row.~
    END
    FOR (cbr_cap_level = 0; cbr_cap_level <= 50; ++cbr_cap_level) BEGIN
      SET cbr_cap_target = (cbr_cap_level = 26
                         || cbr_cap_level = 31
                         || cbr_cap_level = 36
                         || cbr_cap_level = 41
                         || cbr_cap_level = 46)
      PATCH_IF (cbr_cap_target) BEGIN
        READ_ASCII cbr_cap_position cbr_cap_token (10)
        PATCH_IF !(~%cbr_cap_token%~ STR_EQ ~GA_OHTMPS1~) BEGIN
          PATCH_FAIL ~CBR Tempus CLAB cap expected GA_OHTMPS1 at validated ABILITY1 level %cbr_cap_level%, found %cbr_cap_token%.~
        END
        WRITE_ASCII cbr_cap_position ~****~ #4
        DELETE_BYTES (cbr_cap_position + 4) 6
      END
      SET cbr_cap_at_separator = 0
      WHILE (!cbr_cap_at_separator && cbr_cap_position < BUFFER_LENGTH) BEGIN
        READ_BYTE cbr_cap_position cbr_cap_byte
        PATCH_IF (cbr_cap_byte = 9 || cbr_cap_byte = 10 || cbr_cap_byte = 13 || cbr_cap_byte = 32) BEGIN
          SET cbr_cap_at_separator = 1
        END ELSE BEGIN
          ++cbr_cap_position
        END
      END
      PATCH_IF (cbr_cap_level < 50) BEGIN
        SET cbr_cap_at_token = 0
        WHILE (!cbr_cap_at_token && cbr_cap_position < BUFFER_LENGTH) BEGIN
          READ_BYTE cbr_cap_position cbr_cap_byte
          PATCH_IF (cbr_cap_byte = 9 || cbr_cap_byte = 10 || cbr_cap_byte = 13 || cbr_cap_byte = 32) BEGIN
            ++cbr_cap_position
          END ELSE BEGIN
            SET cbr_cap_at_token = 1
          END
        END
        PATCH_IF (!cbr_cap_at_token) BEGIN
          PATCH_FAIL ~CBR Tempus CLAB cap reached EOF before ABILITY1 level 50.~
        END
      END
    END
    LPF cbr_validate_tempus_clab
      RET cbr_cap_verified = capped_shape
    END
    PATCH_IF (!cbr_cap_verified) BEGIN
      PATCH_FAIL ~CBR Tempus CLAB cap did not produce the exact five-use shape.~
    END
  END
END

DEFINE_PATCH_FUNCTION cbr_validate_spell_ids
  STR_VAR
    divine_power_resref   = ~~
    improved_haste_resref = ~~
BEGIN
  SET cbr_spell_ids_divine_count = 0
  SET cbr_spell_ids_haste_count = 0
  SET cbr_spell_ids_length = BUFFER_LENGTH
  READ_ASCII 0 cbr_spell_ids_contents (cbr_spell_ids_length)
  INNER_PATCH ~%cbr_spell_ids_contents%~ BEGIN
    REPLACE_EVALUATE CASE_INSENSITIVE
      ~^\([0-9][0-9]*\)[ %TAB%]+\([^ %TAB%%WNL%%MNL%%LNL%]+\)~
    BEGIN
      SET cbr_spell_ids_value = MATCH1
      SPRINT cbr_spell_ids_symbol ~%MATCH2%~
      TO_UPPER cbr_spell_ids_symbol
      PATCH_IF (~%cbr_spell_ids_symbol%~ STR_EQ ~CLERIC_HOLY_POWER~) BEGIN
        ++cbr_spell_ids_divine_count
        SET cbr_spell_ids_divine_value = cbr_spell_ids_value
      END ELSE PATCH_IF (~%cbr_spell_ids_symbol%~ STR_EQ ~WIZARD_IMPROVED_HASTE~) BEGIN
        ++cbr_spell_ids_haste_count
        SET cbr_spell_ids_haste_value = cbr_spell_ids_value
      END
    END
      ~~
  END
  PATCH_IF (cbr_spell_ids_divine_count != 1 || cbr_spell_ids_haste_count != 1) BEGIN
    PATCH_FAIL ~CBR SPELL.IDS validation failed: CLERIC_HOLY_POWER and WIZARD_IMPROVED_HASTE must each map uniquely.~
  END
  PATCH_IF (cbr_spell_ids_divine_value < 1100 || cbr_spell_ids_divine_value > 1999 || cbr_spell_ids_haste_value < 2100 || cbr_spell_ids_haste_value > 2999) BEGIN
    PATCH_FAIL ~CBR SPELL.IDS validation failed: Holy Power or Improved Haste has an invalid symbolic spell number.~
  END
  SET cbr_divine_slot = cbr_spell_ids_divine_value - 1000
  SET cbr_haste_slot = cbr_spell_ids_haste_value - 2000
  SPRINT cbr_expected_divine ~SPPR%cbr_divine_slot%~
  SPRINT cbr_expected_haste ~SPWI%cbr_haste_slot%~
  PATCH_IF !(~%divine_power_resref%~ STR_EQ ~%cbr_expected_divine%~) BEGIN
    PATCH_FAIL ~CBR SPELL.IDS validation failed: CLERIC_HOLY_POWER resolves to %cbr_expected_divine%, not requested %divine_power_resref%.~
  END
  PATCH_IF !(~%improved_haste_resref%~ STR_EQ ~%cbr_expected_haste%~) BEGIN
    PATCH_FAIL ~CBR SPELL.IDS validation failed: WIZARD_IMPROVED_HASTE resolves to %cbr_expected_haste%, not requested %improved_haste_resref%.~
  END
END

DEFINE_PATCH_FUNCTION cbr_validate_tempus_holy_spell
  INT_VAR
    str_lt_row       = "-1"
    str_eq_row       = "-1"
    str_bonus_lt_row = "-1"
  STR_VAR
    divine_power_resref = ~~
    strength_pulse_18   = ~CBRSE18~
    strength_pulse_19   = ~CBRSE19~
    strength_pulse_20   = ~CBRSE20~
    strength_pulse_21   = ~CBRSE21~
    strength_set_18     = ~CBRST18~
    strength_set_19     = ~CBRST19~
    strength_set_20     = ~CBRST20~
    strength_set_21     = ~CBRST21~
    strength_exception_18 = ~CBRSX18~
  RET
    holy_ability_count
BEGIN
  LPF cbr_validate_spl_v1
    STR_VAR resource_name = ~OHTMPS1.SPL~
    RET
      cbr_holy_ability_offset = ability_offset
      cbr_holy_ability_count  = ability_count
      cbr_holy_effect_offset  = effect_offset
  END
  PATCH_IF (cbr_holy_ability_count != 20 && cbr_holy_ability_count != 30) BEGIN
    PATCH_FAIL ~CBR OHTMPS1.SPL validation failed: expected supported original 20-header or patched 30-header layout, found %cbr_holy_ability_count%.~
  END
  SET holy_ability_count = cbr_holy_ability_count
  PATCH_IF (cbr_holy_ability_count = 30 && (str_lt_row < 0 || str_eq_row < 0 || str_bonus_lt_row < 0)) BEGIN
    PATCH_FAIL ~CBR OHTMPS1.SPL 30-header validation failed: dynamically resolved Strength SPLPROT rows are missing.~
  END
  FOR (cbr_header = 0; cbr_header < cbr_holy_ability_count; ++cbr_header) BEGIN
    SET cbr_header_offset = cbr_holy_ability_offset + (cbr_header * 0x28)
    READ_BYTE  (cbr_header_offset + 0x0c) cbr_holy_target
    READ_SHORT (cbr_header_offset + 0x10) cbr_holy_level
    READ_SHORT (cbr_header_offset + 0x1e) cbr_holy_effect_count
    READ_SHORT (cbr_header_offset + 0x20) cbr_holy_first_effect
    READ_SHORT (cbr_header_offset + 0x26) cbr_holy_projectile
    PATCH_IF (cbr_holy_level != (cbr_header + 1) || cbr_holy_target != 5 || cbr_holy_projectile != 255) BEGIN
      PATCH_FAIL ~CBR OHTMPS1.SPL validation failed at header %cbr_header%: expected sequential level, self target 5, and projectile 255.~
    END
    SET cbr_own_cleanup = 0
    SET cbr_divine_cleanup = 0
    SET cbr_thac0_mechanics = 0
    SET cbr_hp_mechanics = 0
    SET cbr_apr_mechanics = 0
    SET cbr_legacy_strength_mechanics = 0
    SET cbr_legacy_strength_44 = 0
    SET cbr_legacy_strength_97 = 0
    SET cbr_owned_strength_pulses = 0
    SET cbr_owned_strength_pulse_invalid = 0
    SET cbr_owned_strength_immediate = 0
    SET cbr_owned_strength_immediate_invalid = 0
    SET cbr_owned_strength_recast_cleanup = 0
    SET cbr_owned_strength_expiry_cleanup = 0
    SET cbr_owned_strength_cleanup_invalid = 0
    SET cbr_owned_cleanup_invalid = 0
    SET cbr_signature_source_level = cbr_holy_level
    PATCH_IF (cbr_signature_source_level > 20) BEGIN
      SET cbr_signature_source_level = 20
    END
    SET cbr_expected_legacy_duration = cbr_signature_source_level * 6
    SET cbr_expected_cleanup_dr = 3
    PATCH_IF (cbr_holy_ability_count = 30) BEGIN
      SET cbr_expected_cleanup_dr = 2
    END
    PATCH_IF (cbr_holy_level <= 6) BEGIN
      SET cbr_expected_duration = 18
      SET cbr_expected_apr = "-1"
    END ELSE PATCH_IF (cbr_holy_level <= 12) BEGIN
      SET cbr_expected_duration = 24
      SET cbr_expected_apr = 6
    END ELSE BEGIN
      SET cbr_expected_duration = 30
      PATCH_IF (cbr_holy_level <= 24) BEGIN
        SET cbr_expected_apr = 1
      END ELSE BEGIN
        SET cbr_expected_apr = 7
      END
    END
    SET cbr_expected_thac0 = 21 - cbr_holy_level
    PATCH_IF (cbr_expected_thac0 < 0) BEGIN
      SET cbr_expected_thac0 = 0
    END
    SET cbr_expected_hp = cbr_holy_level
    PATCH_IF (cbr_expected_hp > 30) BEGIN
      SET cbr_expected_hp = 30
    END
    SET cbr_expected_core_duration = cbr_expected_duration
    PATCH_IF (cbr_holy_ability_count = 20) BEGIN
      SET cbr_expected_core_duration = cbr_expected_legacy_duration
    END
    PATCH_IF (cbr_holy_level <= 12) BEGIN
      SPRINT cbr_expected_strength_pulse ~%strength_pulse_18%~
      SPRINT cbr_expected_strength_set ~%strength_set_18%~
      SET cbr_expected_strength_floor = 18
    END ELSE PATCH_IF (cbr_holy_level <= 18) BEGIN
      SPRINT cbr_expected_strength_pulse ~%strength_pulse_19%~
      SPRINT cbr_expected_strength_set ~%strength_set_19%~
      SET cbr_expected_strength_floor = 19
    END ELSE PATCH_IF (cbr_holy_level <= 24) BEGIN
      SPRINT cbr_expected_strength_pulse ~%strength_pulse_20%~
      SPRINT cbr_expected_strength_set ~%strength_set_20%~
      SET cbr_expected_strength_floor = 20
    END ELSE BEGIN
      SPRINT cbr_expected_strength_pulse ~%strength_pulse_21%~
      SPRINT cbr_expected_strength_set ~%strength_set_21%~
      SET cbr_expected_strength_floor = 21
    END
    FOR (cbr_effect = 0; cbr_effect < cbr_holy_effect_count; ++cbr_effect) BEGIN
      SET cbr_effect_offset = cbr_holy_effect_offset + ((cbr_holy_first_effect + cbr_effect) * 0x30)
      READ_SHORT cbr_effect_offset cbr_holy_opcode
      READ_BYTE  (cbr_effect_offset + 0x02) cbr_holy_effect_target
      READ_BYTE  (cbr_effect_offset + 0x03) cbr_holy_power
      READ_LONG  (cbr_effect_offset + 0x04) cbr_holy_parameter1
      READ_LONG  (cbr_effect_offset + 0x08) cbr_holy_parameter2
      READ_BYTE  (cbr_effect_offset + 0x0c) cbr_holy_timing
      READ_BYTE  (cbr_effect_offset + 0x0d) cbr_holy_resist_dispel
      READ_LONG  (cbr_effect_offset + 0x0e) cbr_holy_duration
      READ_BYTE  (cbr_effect_offset + 0x12) cbr_holy_probability1
      READ_BYTE  (cbr_effect_offset + 0x13) cbr_holy_probability2
      READ_ASCII (cbr_effect_offset + 0x14) cbr_holy_resource (8) NULL
      READ_LONG  (cbr_effect_offset + 0x1c) cbr_holy_dice_number
      READ_LONG  (cbr_effect_offset + 0x20) cbr_holy_dice_size
      READ_LONG  (cbr_effect_offset + 0x24) cbr_holy_save_type
      READ_LONG  (cbr_effect_offset + 0x28) cbr_holy_save_bonus
      READ_LONG  (cbr_effect_offset + 0x2c) cbr_holy_special
      PATCH_IF (cbr_holy_opcode = 321 && ~%cbr_holy_resource%~ STR_EQ ~OHTMPS1~) BEGIN
        ++cbr_own_cleanup
        SET cbr_expected_own_cleanup_index = 0
        PATCH_IF (cbr_holy_ability_count = 30) BEGIN
          SET cbr_expected_own_cleanup_index = 1
        END
        PATCH_IF (cbr_effect != cbr_expected_own_cleanup_index
                || cbr_holy_effect_target != 1
                || cbr_holy_power != 4
                || cbr_holy_parameter1 != 0
                || cbr_holy_parameter2 != 0
                || cbr_holy_timing != 1
                || cbr_holy_resist_dispel != cbr_expected_cleanup_dr
                || cbr_holy_duration != 0
                || cbr_holy_probability1 != 100
                || cbr_holy_probability2 != 0
                || cbr_holy_dice_number != 0
                || cbr_holy_dice_size != 0
                || cbr_holy_save_type != 0
                || cbr_holy_save_bonus != 0
                || cbr_holy_special != 0) BEGIN
          SET cbr_owned_cleanup_invalid = 1
        END
      END
      PATCH_IF (cbr_holy_opcode = 321 && ~%cbr_holy_resource%~ STR_EQ ~%divine_power_resref%~) BEGIN
        ++cbr_divine_cleanup
        SET cbr_expected_divine_cleanup_index = 1
        SET cbr_expected_divine_cleanup_p2 = 0
        PATCH_IF (cbr_holy_ability_count = 30) BEGIN
          SET cbr_expected_divine_cleanup_index = 0
          SET cbr_expected_divine_cleanup_p2 = 2
        END
        PATCH_IF (cbr_effect != cbr_expected_divine_cleanup_index
                || cbr_holy_effect_target != 1
                || cbr_holy_power != 4
                || cbr_holy_parameter1 != 0
                || cbr_holy_parameter2 != cbr_expected_divine_cleanup_p2
                || cbr_holy_timing != 1
                || cbr_holy_resist_dispel != cbr_expected_cleanup_dr
                || cbr_holy_duration != 0
                || cbr_holy_probability1 != 100
                || cbr_holy_probability2 != 0
                || cbr_holy_dice_number != 0
                || cbr_holy_dice_size != 0
                || cbr_holy_save_type != 0
                || cbr_holy_save_bonus != 0
                || cbr_holy_special != 0) BEGIN
          SET cbr_owned_cleanup_invalid = 1
        END
      END
      PATCH_IF (cbr_holy_opcode = 321
             && (~%cbr_holy_resource%~ STR_EQ ~%strength_set_18%~
              || ~%cbr_holy_resource%~ STR_EQ ~%strength_set_19%~
              || ~%cbr_holy_resource%~ STR_EQ ~%strength_set_20%~
              || ~%cbr_holy_resource%~ STR_EQ ~%strength_set_21%~)) BEGIN
        SET cbr_strength_cleanup_slot = 0
        PATCH_IF (~%cbr_holy_resource%~ STR_EQ ~%strength_set_19%~) BEGIN
          SET cbr_strength_cleanup_slot = 1
        END ELSE PATCH_IF (~%cbr_holy_resource%~ STR_EQ ~%strength_set_20%~) BEGIN
          SET cbr_strength_cleanup_slot = 2
        END ELSE PATCH_IF (~%cbr_holy_resource%~ STR_EQ ~%strength_set_21%~) BEGIN
          SET cbr_strength_cleanup_slot = 3
        END
        SET cbr_strength_cleanup_expected_index = "-1"
        SET cbr_strength_cleanup_expected_duration = 0
        PATCH_IF (cbr_holy_timing = 1) BEGIN
          ++cbr_owned_strength_recast_cleanup
          SET cbr_strength_cleanup_expected_index = 2 + cbr_strength_cleanup_slot
        END ELSE PATCH_IF (cbr_holy_timing = 4) BEGIN
          ++cbr_owned_strength_expiry_cleanup
          SET cbr_strength_cleanup_expected_index = cbr_holy_effect_count - 4 + cbr_strength_cleanup_slot
          SET cbr_strength_cleanup_expected_duration = cbr_expected_duration
        END
        PATCH_IF (cbr_effect != cbr_strength_cleanup_expected_index
               || cbr_holy_effect_target != 1
               || cbr_holy_power != 4
               || cbr_holy_parameter1 != 0
               || cbr_holy_parameter2 != 2
               || cbr_holy_resist_dispel != 2
               || cbr_holy_duration != cbr_strength_cleanup_expected_duration
               || cbr_holy_probability1 != 100
               || cbr_holy_probability2 != 0
               || cbr_holy_dice_number != 0
               || cbr_holy_dice_size != 0
               || cbr_holy_save_type != 0
               || cbr_holy_save_bonus != 0
               || cbr_holy_special != 0) BEGIN
          SET cbr_owned_strength_cleanup_invalid = 1
        END
      END
      // Count only the complete canonical mechanic.  Same-opcode records with
      // any distinct field belong to other mods and must remain invisible to
      // ownership classification.
      PATCH_IF (cbr_holy_opcode = 54
             && cbr_holy_effect_target = 1
             && cbr_holy_power = 4
             && cbr_holy_parameter1 = cbr_expected_thac0
             && cbr_holy_parameter2 = 1
             && cbr_holy_timing = 0
             && cbr_holy_duration = cbr_expected_core_duration
             && cbr_holy_resist_dispel = 3
             && cbr_holy_probability1 = 100
             && cbr_holy_probability2 = 0
             && ~%cbr_holy_resource%~ STR_EQ ~~
             && cbr_holy_dice_number = 0
             && cbr_holy_dice_size = 0
             && cbr_holy_save_type = 0
             && cbr_holy_save_bonus = 0
             && cbr_holy_special = 0) BEGIN
        ++cbr_thac0_mechanics
      END
      PATCH_IF (cbr_holy_opcode = 18
             && cbr_holy_effect_target = 1
             && cbr_holy_power = 4
             && cbr_holy_parameter1 = cbr_expected_hp
             && cbr_holy_parameter2 = 0
             && cbr_holy_timing = 0
             && cbr_holy_duration = cbr_expected_core_duration
             && cbr_holy_resist_dispel = 3
             && cbr_holy_probability1 = 100
             && cbr_holy_probability2 = 0
             && ~%cbr_holy_resource%~ STR_EQ ~~
             && cbr_holy_dice_number = 0
             && cbr_holy_dice_size = 0
             && cbr_holy_save_type = 0
             && cbr_holy_save_bonus = 0
             && cbr_holy_special = 0) BEGIN
        ++cbr_hp_mechanics
      END
      PATCH_IF (cbr_holy_opcode = 1
             && cbr_expected_apr >= 0
             && cbr_holy_effect_target = 1
             && cbr_holy_power = 4
             && cbr_holy_parameter1 = cbr_expected_apr
             && cbr_holy_parameter2 = 0
             && cbr_holy_timing = 0
             && cbr_holy_duration = cbr_expected_duration
             && cbr_holy_resist_dispel = 3
             && cbr_holy_probability1 = 100
             && cbr_holy_probability2 = 0
             && ~%cbr_holy_resource%~ STR_EQ ~~
             && cbr_holy_dice_number = 0
             && cbr_holy_dice_size = 0
             && cbr_holy_save_type = 0
             && cbr_holy_save_bonus = 0
             && cbr_holy_special = 0) BEGIN
        ++cbr_apr_mechanics
      END
      PATCH_IF (cbr_holy_opcode = 326
             && (~%cbr_holy_resource%~ STR_EQ ~%strength_set_18%~
              || ~%cbr_holy_resource%~ STR_EQ ~%strength_set_19%~
              || ~%cbr_holy_resource%~ STR_EQ ~%strength_set_20%~
              || ~%cbr_holy_resource%~ STR_EQ ~%strength_set_21%~
              || ~%cbr_holy_resource%~ STR_EQ ~%strength_exception_18%~)) BEGIN
        ++cbr_owned_strength_immediate
        SET cbr_immediate_expected = 0
        PATCH_IF (~%cbr_holy_resource%~ STR_EQ ~%cbr_expected_strength_set%~
               && cbr_effect = 6
               && cbr_holy_parameter1 = cbr_expected_strength_floor
               && cbr_holy_parameter2 = str_lt_row) BEGIN
          SET cbr_immediate_expected = 1
        END ELSE PATCH_IF (cbr_expected_strength_floor = 18
                       && ~%cbr_holy_resource%~ STR_EQ ~%strength_exception_18%~
                       && cbr_effect = 7
                       && cbr_holy_parameter1 = 18
                       && cbr_holy_parameter2 = str_eq_row) BEGIN
          SET cbr_immediate_expected = 1
        END
        PATCH_IF (!cbr_immediate_expected
               || cbr_holy_effect_target != 1
               || cbr_holy_power != 4
               || cbr_holy_timing != 1
               || cbr_holy_resist_dispel != 2
               || cbr_holy_duration != 0
               || cbr_holy_probability1 != 100
               || cbr_holy_probability2 != 0
               || cbr_holy_dice_number != 0
               || cbr_holy_dice_size != 0
               || cbr_holy_save_type != 0
               || cbr_holy_save_bonus != 0
               || cbr_holy_special != 0) BEGIN
          SET cbr_owned_strength_immediate_invalid = 1
        END
      END
      PATCH_IF ((cbr_holy_opcode = 44 || cbr_holy_opcode = 97)
             && cbr_holy_parameter2 = 1
             && cbr_holy_effect_target = 1
             && cbr_holy_power = 4
             && cbr_holy_timing = 0
             && cbr_holy_resist_dispel = 3
             && cbr_holy_duration = cbr_expected_legacy_duration
             && cbr_holy_probability1 = 100
             && cbr_holy_probability2 = 0
             && ~%cbr_holy_resource%~ STR_EQ ~~
             && cbr_holy_dice_number = 0
             && cbr_holy_dice_size = 0
             && cbr_holy_save_type = 0
             && cbr_holy_save_bonus = 0
             && cbr_holy_special = 0
             && ((cbr_holy_opcode = 44 && cbr_holy_parameter1 = 18)
              || (cbr_holy_opcode = 97 && cbr_holy_parameter1 = 100))) BEGIN
        ++cbr_legacy_strength_mechanics
        PATCH_IF (cbr_holy_opcode = 44) BEGIN
          ++cbr_legacy_strength_44
        END ELSE BEGIN
          ++cbr_legacy_strength_97
        END
      END
      PATCH_IF (cbr_holy_opcode = 272
             && (~%cbr_holy_resource%~ STR_EQ ~%strength_pulse_18%~
              || ~%cbr_holy_resource%~ STR_EQ ~%strength_pulse_19%~
              || ~%cbr_holy_resource%~ STR_EQ ~%strength_pulse_20%~
              || ~%cbr_holy_resource%~ STR_EQ ~%strength_pulse_21%~)) BEGIN
        ++cbr_owned_strength_pulses
        PATCH_IF (!(~%cbr_holy_resource%~ STR_EQ ~%cbr_expected_strength_pulse%~)
               || cbr_holy_effect_target != 1
               || cbr_holy_power != 4
               || cbr_holy_parameter1 != 1
               || cbr_holy_parameter2 != 3
               || cbr_holy_timing != 0
               || cbr_holy_resist_dispel != 3
               || cbr_holy_duration != cbr_expected_duration
               || cbr_holy_probability1 != 100
               || cbr_holy_probability2 != 0
               || cbr_holy_dice_number != 0
               || cbr_holy_dice_size != 0
               || cbr_holy_save_type != 0
               || cbr_holy_save_bonus != 0
               || cbr_holy_special != 0) BEGIN
          SET cbr_owned_strength_pulse_invalid = 1
        END
      END
    END
    PATCH_IF (cbr_own_cleanup != 1 || cbr_divine_cleanup != 1 || cbr_thac0_mechanics != 1 || cbr_hp_mechanics != 1) BEGIN
      PATCH_FAIL ~CBR OHTMPS1.SPL validation failed at header %cbr_header%: expected unique cleanup, THAC0, and temporary-HP mechanics in the supported 20/30-header shape.~
    END
    PATCH_IF (cbr_holy_ability_count = 20) BEGIN
      PATCH_IF (cbr_owned_cleanup_invalid
             || cbr_legacy_strength_44 != 1
             || cbr_legacy_strength_97 != 1
             || cbr_apr_mechanics != 0
             || cbr_owned_strength_recast_cleanup != 0
             || cbr_owned_strength_expiry_cleanup != 0
             || cbr_owned_strength_immediate != 0
             || cbr_owned_strength_pulses != 0) BEGIN
        PATCH_FAIL ~CBR OHTMPS1.SPL original 20-header validation failed at header %cbr_header%: legacy cleanup/core/Strength fields, duration, APR, or prior CBR helper shape is ambiguous.~
      END
    END ELSE PATCH_IF (cbr_holy_ability_count = 30) BEGIN
      SET cbr_expected_apr_count = 1
      PATCH_IF (cbr_expected_apr < 0) BEGIN
        SET cbr_expected_apr_count = 0
      END
      PATCH_IF (cbr_owned_cleanup_invalid
             || cbr_apr_mechanics != cbr_expected_apr_count
             || cbr_legacy_strength_mechanics != 0
             || cbr_owned_strength_recast_cleanup != 4
             || cbr_owned_strength_expiry_cleanup != 4
             || cbr_owned_strength_cleanup_invalid
             || cbr_owned_strength_immediate != (1 + (cbr_expected_strength_floor = 18))
             || cbr_owned_strength_immediate_invalid
             || cbr_owned_strength_pulses != 1
             || cbr_owned_strength_pulse_invalid) BEGIN
        PATCH_FAIL ~CBR OHTMPS1.SPL 30-header validation failed at header %cbr_header%: THAC0/HP tier duration, APR key, ordered all-tier setter recast/expiry cleanup, or owned Strength opcode-272 pulse does not match the progression.~
      END
    END
  END
END

// Transform the exact recognized original 20-header spell into the canonical
// 30-header progression.  Source effects stay at stable offsets while a new
// table is appended; one final deletion atomically swaps the new table into
// the original table's offset, avoiding every in-place index-shift hazard.
DEFINE_PATCH_FUNCTION cbr_build_tempus_holy_progression
  INT_VAR
    str_lt_row = "-1"
    str_eq_row = "-1"
    str_bonus_lt_row = "-1"
  STR_VAR
    divine_power_resref = ~~
    strength_pulse_18   = ~CBRSE18~
    strength_pulse_19   = ~CBRSE19~
    strength_pulse_20   = ~CBRSE20~
    strength_pulse_21   = ~CBRSE21~
    strength_set_18     = ~CBRST18~
    strength_set_19     = ~CBRST19~
    strength_set_20     = ~CBRST20~
    strength_set_21     = ~CBRST21~
    strength_exception_18 = ~CBRSX18~
BEGIN
  LPF cbr_validate_tempus_holy_spell
    INT_VAR str_lt_row = str_lt_row str_eq_row = str_eq_row str_bonus_lt_row = str_bonus_lt_row
    STR_VAR
      divine_power_resref = EVAL ~%divine_power_resref%~
      strength_pulse_18 = EVAL ~%strength_pulse_18%~
      strength_pulse_19 = EVAL ~%strength_pulse_19%~
      strength_pulse_20 = EVAL ~%strength_pulse_20%~
      strength_pulse_21 = EVAL ~%strength_pulse_21%~
      strength_set_18 = EVAL ~%strength_set_18%~
      strength_set_19 = EVAL ~%strength_set_19%~
      strength_set_20 = EVAL ~%strength_set_20%~
      strength_set_21 = EVAL ~%strength_set_21%~
      strength_exception_18 = EVAL ~%strength_exception_18%~
    RET cbr_progression_original_count = holy_ability_count
  END
  PATCH_IF (cbr_progression_original_count != 20) BEGIN
    PATCH_FAIL ~CBR Tempus progression builder requires the exact original 20-header shape.~
  END

  FOR (cbr_clone = 20; cbr_clone < 30; ++cbr_clone) BEGIN
    LPF cbr_clone_final_spell_header STR_VAR resource_name = ~OHTMPS1.SPL~ END
  END

  LPF cbr_validate_spl_v1
    STR_VAR resource_name = ~OHTMPS1.SPL cloned progression source~
    RET
      cbr_progression_ability_offset = ability_offset
      cbr_progression_ability_count  = ability_count
      cbr_progression_effect_offset  = effect_offset
      cbr_progression_effect_count   = effect_count
  END
  PATCH_IF (cbr_progression_ability_count != 30) BEGIN
    PATCH_FAIL ~CBR Tempus progression clone phase did not produce exactly 30 headers.~
  END
  SET cbr_progression_old_effect_bytes = cbr_progression_effect_count * 0x30
  SET cbr_progression_old_effect_end = cbr_progression_effect_offset + cbr_progression_old_effect_bytes
  PATCH_IF (cbr_progression_old_effect_end != BUFFER_LENGTH) BEGIN
    PATCH_FAIL ~CBR Tempus progression source effect table does not end at EOF.~
  END

  READ_SHORT 0x6e cbr_progression_casting_first
  READ_SHORT 0x70 cbr_progression_casting_count
  SET cbr_new_effect_index = 0
  FOR (cbr_casting = 0; cbr_casting < cbr_progression_casting_count; ++cbr_casting) BEGIN
    SET cbr_source_effect_offset = cbr_progression_effect_offset + ((cbr_progression_casting_first + cbr_casting) * 0x30)
    LPF cbr_append_raw_spl_effect_record INT_VAR source_offset = cbr_source_effect_offset END
    ++cbr_new_effect_index
  END
  WRITE_SHORT 0x6e 0

  FOR (cbr_header = 0; cbr_header < 30; ++cbr_header) BEGIN
    SET cbr_level = cbr_header + 1
    SET cbr_header_offset = cbr_progression_ability_offset + (cbr_header * 0x28)
    READ_SHORT (cbr_header_offset + 0x1e) cbr_source_effect_count
    READ_SHORT (cbr_header_offset + 0x20) cbr_source_first_effect
    WRITE_SHORT (cbr_header_offset + 0x10) cbr_level
    WRITE_SHORT (cbr_header_offset + 0x20) cbr_new_effect_index
    SET cbr_new_header_first = cbr_new_effect_index

    PATCH_IF (cbr_level <= 6) BEGIN
      SET cbr_duration = 18
      SET cbr_apr = "-1"
    END ELSE PATCH_IF (cbr_level <= 12) BEGIN
      SET cbr_duration = 24
      SET cbr_apr = 6
    END ELSE BEGIN
      SET cbr_duration = 30
      PATCH_IF (cbr_level <= 24) BEGIN
        SET cbr_apr = 1
      END ELSE BEGIN
        SET cbr_apr = 7
      END
    END
    SET cbr_thac0 = 21 - cbr_level
    PATCH_IF (cbr_thac0 < 0) BEGIN
      SET cbr_thac0 = 0
    END
    SET cbr_hp = cbr_level
    PATCH_IF (cbr_hp > 30) BEGIN
      SET cbr_hp = 30
    END
    PATCH_IF (cbr_level <= 12) BEGIN
      SET cbr_strength_floor = 18
      SPRINT cbr_strength_set ~%strength_set_18%~
      SPRINT cbr_strength_pulse ~%strength_pulse_18%~
    END ELSE PATCH_IF (cbr_level <= 18) BEGIN
      SET cbr_strength_floor = 19
      SPRINT cbr_strength_set ~%strength_set_19%~
      SPRINT cbr_strength_pulse ~%strength_pulse_19%~
    END ELSE PATCH_IF (cbr_level <= 24) BEGIN
      SET cbr_strength_floor = 20
      SPRINT cbr_strength_set ~%strength_set_20%~
      SPRINT cbr_strength_pulse ~%strength_pulse_20%~
    END ELSE BEGIN
      SET cbr_strength_floor = 21
      SPRINT cbr_strength_set ~%strength_set_21%~
      SPRINT cbr_strength_pulse ~%strength_pulse_21%~
    END

    // Canonical owned prefix: dynamic Divine cleanup, self cleanup, timed-only
    // removal of every possible prior tier setter for level-drain/recast
    // safety, then the immediate floor graph. Validator ordering makes rerun
    // recognition exact.
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 321 target = 1 power = 4 parameter2 = 2 timing = 1 resist_dispel = 2
      STR_VAR resource = EVAL ~%divine_power_resref%~
    END
    ++cbr_new_effect_index
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 321 target = 1 power = 4 timing = 1 resist_dispel = 2
      STR_VAR resource = ~OHTMPS1~
    END
    ++cbr_new_effect_index
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 321 target = 1 power = 4 parameter2 = 2 timing = 1 resist_dispel = 2
      STR_VAR resource = EVAL ~%strength_set_18%~
    END
    ++cbr_new_effect_index
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 321 target = 1 power = 4 parameter2 = 2 timing = 1 resist_dispel = 2
      STR_VAR resource = EVAL ~%strength_set_19%~
    END
    ++cbr_new_effect_index
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 321 target = 1 power = 4 parameter2 = 2 timing = 1 resist_dispel = 2
      STR_VAR resource = EVAL ~%strength_set_20%~
    END
    ++cbr_new_effect_index
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 321 target = 1 power = 4 parameter2 = 2 timing = 1 resist_dispel = 2
      STR_VAR resource = EVAL ~%strength_set_21%~
    END
    ++cbr_new_effect_index
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 326 target = 1 power = 4 parameter1 = cbr_strength_floor parameter2 = str_lt_row timing = 1 resist_dispel = 2
      STR_VAR resource = EVAL ~%cbr_strength_set%~
    END
    ++cbr_new_effect_index
    PATCH_IF (cbr_strength_floor = 18) BEGIN
      LPF cbr_append_spl_effect_record
        INT_VAR opcode = 326 target = 1 power = 4 parameter1 = 18 parameter2 = str_eq_row timing = 1 resist_dispel = 2
        STR_VAR resource = EVAL ~%strength_exception_18%~
      END
      ++cbr_new_effect_index
    END

    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 54 target = 1 power = 4 parameter1 = cbr_thac0 parameter2 = 1 timing = 0 resist_dispel = 3 duration = cbr_duration
    END
    ++cbr_new_effect_index
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 18 target = 1 power = 4 parameter1 = cbr_hp parameter2 = 0 timing = 0 resist_dispel = 3 duration = cbr_duration
    END
    ++cbr_new_effect_index

    // Copy every non-owned source record raw.  Only the exact stock timed
    // visual/state signatures get a duration override; unknown effects,
    // including foreign opcode 272 records, remain byte-identical.
    SET cbr_source_level = cbr_level
    PATCH_IF (cbr_source_level > 20) BEGIN
      SET cbr_source_level = 20
    END
    SET cbr_source_legacy_duration = cbr_source_level * 6
    SET cbr_source_thac0 = 21 - cbr_source_level
    PATCH_IF (cbr_source_thac0 < 0) BEGIN
      SET cbr_source_thac0 = 0
    END
    FOR (cbr_effect = 0; cbr_effect < cbr_source_effect_count; ++cbr_effect) BEGIN
      SET cbr_source_effect_offset = cbr_progression_effect_offset + ((cbr_source_first_effect + cbr_effect) * 0x30)
      READ_SHORT cbr_source_effect_offset cbr_opcode
      READ_BYTE  (cbr_source_effect_offset + 0x02) cbr_target
      READ_BYTE  (cbr_source_effect_offset + 0x03) cbr_power
      READ_LONG  (cbr_source_effect_offset + 0x04) cbr_parameter1
      READ_LONG  (cbr_source_effect_offset + 0x08) cbr_parameter2
      READ_BYTE  (cbr_source_effect_offset + 0x0c) cbr_timing
      READ_BYTE  (cbr_source_effect_offset + 0x0d) cbr_resist_dispel
      READ_LONG  (cbr_source_effect_offset + 0x0e) cbr_source_duration
      READ_BYTE  (cbr_source_effect_offset + 0x12) cbr_probability1
      READ_BYTE  (cbr_source_effect_offset + 0x13) cbr_probability2
      READ_ASCII (cbr_source_effect_offset + 0x14) cbr_resource (8) NULL
      READ_LONG  (cbr_source_effect_offset + 0x1c) cbr_dice_number
      READ_LONG  (cbr_source_effect_offset + 0x20) cbr_dice_size
      READ_LONG  (cbr_source_effect_offset + 0x24) cbr_save_type
      READ_LONG  (cbr_source_effect_offset + 0x28) cbr_save_bonus
      READ_LONG  (cbr_source_effect_offset + 0x2c) cbr_special
      SET cbr_exact_legacy_common = (cbr_target = 1
                                  && cbr_power = 4
                                  && cbr_timing = 0
                                  && cbr_resist_dispel = 3
                                  && cbr_source_duration = cbr_source_legacy_duration
                                  && cbr_probability1 = 100
                                  && cbr_probability2 = 0
                                  && ~%cbr_resource%~ STR_EQ ~~
                                  && cbr_dice_number = 0
                                  && cbr_dice_size = 0
                                  && cbr_save_type = 0
                                  && cbr_save_bonus = 0
                                  && cbr_special = 0)
      SET cbr_owned_source = 0
      PATCH_IF ((cbr_opcode = 321 && (~%cbr_resource%~ STR_EQ ~OHTMPS1~ || ~%cbr_resource%~ STR_EQ ~%divine_power_resref%~))
             || (cbr_exact_legacy_common
              && ((cbr_opcode = 54 && cbr_parameter1 = cbr_source_thac0 && cbr_parameter2 = 1)
               || (cbr_opcode = 18 && cbr_parameter1 = cbr_source_level && cbr_parameter2 = 0)
               || (cbr_opcode = 44 && cbr_parameter1 = 18 && cbr_parameter2 = 1)
               || (cbr_opcode = 97 && cbr_parameter1 = 100 && cbr_parameter2 = 1)))
             || (cbr_opcode = 326 && (~%cbr_resource%~ STR_EQ ~%strength_set_18%~ || ~%cbr_resource%~ STR_EQ ~%strength_set_19%~ || ~%cbr_resource%~ STR_EQ ~%strength_set_20%~ || ~%cbr_resource%~ STR_EQ ~%strength_set_21%~ || ~%cbr_resource%~ STR_EQ ~%strength_exception_18%~))
             || (cbr_opcode = 272 && (~%cbr_resource%~ STR_EQ ~%strength_pulse_18%~ || ~%cbr_resource%~ STR_EQ ~%strength_pulse_19%~ || ~%cbr_resource%~ STR_EQ ~%strength_pulse_20%~ || ~%cbr_resource%~ STR_EQ ~%strength_pulse_21%~))) BEGIN
        SET cbr_owned_source = 1
      END
      PATCH_IF (!cbr_owned_source) BEGIN
        SET cbr_duration_override = "-1"
        SET cbr_common_timed_visual = (cbr_target = 1
                                    && cbr_power = 4
                                    && cbr_resist_dispel = 3
                                    && cbr_source_duration = cbr_source_legacy_duration
                                    && cbr_probability1 = 100
                                    && cbr_probability2 = 0
                                    && cbr_dice_number = 0
                                    && cbr_dice_size = 0
                                    && cbr_save_type = 0
                                    && cbr_save_bonus = 0)
        PATCH_IF (cbr_common_timed_visual
               && ((cbr_opcode = 142 && cbr_parameter1 = 0 && cbr_parameter2 = 60 && cbr_timing = 0 && ~%cbr_resource%~ STR_EQ ~~ && cbr_special = 0)
                || (cbr_opcode = 328 && cbr_parameter1 = 0 && (cbr_parameter2 = 68 || cbr_parameter2 = 9) && cbr_timing = 0 && ~%cbr_resource%~ STR_EQ ~~ && cbr_special = 1)
                || (cbr_opcode = 282 && cbr_parameter1 = 3 && cbr_parameter2 = 5 && cbr_timing = 0 && ~%cbr_resource%~ STR_EQ ~~ && cbr_special = 0)
                || (cbr_opcode = 174 && cbr_parameter1 = 0 && cbr_parameter2 = 0 && cbr_timing = 4 && ~%cbr_resource%~ STR_EQ ~EFF_E03~ && cbr_special = 0))) BEGIN
          SET cbr_duration_override = cbr_duration
        END
        LPF cbr_append_raw_spl_effect_record INT_VAR source_offset = cbr_source_effect_offset duration_override = cbr_duration_override END
        ++cbr_new_effect_index
      END
    END

    PATCH_IF (cbr_apr >= 0) BEGIN
      LPF cbr_append_spl_effect_record
        INT_VAR opcode = 1 target = 1 power = 4 parameter1 = cbr_apr parameter2 = 0 timing = 0 resist_dispel = 3 duration = cbr_duration
      END
      ++cbr_new_effect_index
    END
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 272 target = 1 power = 4 parameter1 = 1 parameter2 = 3 timing = 0 resist_dispel = 3 duration = cbr_duration
      STR_VAR resource = EVAL ~%cbr_strength_pulse%~
    END
    ++cbr_new_effect_index

    // A child setter has no intrinsic parent lifetime.  Delayed all-tier
    // cleanup fires at the exact Holy duration so the 31-tick overlap cannot
    // survive normal parent expiration.  Task 5 must mirror these cleanups on
    // every mod-controlled early OHTMPS1 removal path (notably Divine Power).
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 321 target = 1 power = 4 parameter2 = 2 timing = 4 resist_dispel = 2 duration = cbr_duration
      STR_VAR resource = EVAL ~%strength_set_18%~
    END
    ++cbr_new_effect_index
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 321 target = 1 power = 4 parameter2 = 2 timing = 4 resist_dispel = 2 duration = cbr_duration
      STR_VAR resource = EVAL ~%strength_set_19%~
    END
    ++cbr_new_effect_index
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 321 target = 1 power = 4 parameter2 = 2 timing = 4 resist_dispel = 2 duration = cbr_duration
      STR_VAR resource = EVAL ~%strength_set_20%~
    END
    ++cbr_new_effect_index
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 321 target = 1 power = 4 parameter2 = 2 timing = 4 resist_dispel = 2 duration = cbr_duration
      STR_VAR resource = EVAL ~%strength_set_21%~
    END
    ++cbr_new_effect_index

    SET cbr_new_header_count = cbr_new_effect_index - cbr_new_header_first
    PATCH_IF (cbr_new_header_first > 0xffff || cbr_new_header_count > 0xffff) BEGIN
      PATCH_FAIL ~CBR Tempus progression rebuilt effect indices exceed SPL V1 short fields.~
    END
    WRITE_SHORT (cbr_header_offset + 0x1e) cbr_new_header_count
  END

  DELETE_BYTES cbr_progression_effect_offset cbr_progression_old_effect_bytes
  WRITE_LONG 0x6a cbr_progression_effect_offset

  LPF cbr_validate_tempus_holy_spell
    INT_VAR str_lt_row = str_lt_row str_eq_row = str_eq_row str_bonus_lt_row = str_bonus_lt_row
    STR_VAR
      divine_power_resref = EVAL ~%divine_power_resref%~
      strength_pulse_18 = EVAL ~%strength_pulse_18%~
      strength_pulse_19 = EVAL ~%strength_pulse_19%~
      strength_pulse_20 = EVAL ~%strength_pulse_20%~
      strength_pulse_21 = EVAL ~%strength_pulse_21%~
      strength_set_18 = EVAL ~%strength_set_18%~
      strength_set_19 = EVAL ~%strength_set_19%~
      strength_set_20 = EVAL ~%strength_set_20%~
      strength_set_21 = EVAL ~%strength_set_21%~
      strength_exception_18 = EVAL ~%strength_exception_18%~
  END
END

// Plan all four private states before writing any of them.  Unlike the usual
// APPEND + CLEAR_IDS_MAP idiom, this rejects duplicate symbols, aliased values,
// and exhausted 0..255 space while atomically planning any missing symbols.
DEFINE_PATCH_FUNCTION cbr_plan_tempus_splstates
  RET
    ih_state
    apr_half_state
    apr_one_state
    apr_one_half_state
    append_states
BEGIN
  SET ih_state = "-1"
  SET apr_half_state = "-1"
  SET apr_one_state = "-1"
  SET apr_one_half_state = "-1"
  SET append_states = 0
  SET cbr_ih_count = 0
  SET cbr_apr_half_count = 0
  SET cbr_apr_one_count = 0
  SET cbr_apr_one_half_count = 0
  SET cbr_ids_entry_count = 0

  FOR (cbr_value = 0; cbr_value < 256; ++cbr_value) BEGIN
    SET $cbr_splstate_value_count(~%cbr_value%~) = 0
  END

  SET cbr_ids_length = BUFFER_LENGTH
  READ_ASCII 0 cbr_ids_contents (cbr_ids_length)
  INNER_PATCH ~%cbr_ids_contents%~ BEGIN
    REPLACE_EVALUATE CASE_INSENSITIVE
      ~^[ %TAB%]*\([^ %TAB%%WNL%%MNL%%LNL%]+\)[ %TAB%]+\([^ %TAB%%WNL%%MNL%%LNL%]+\)~
    BEGIN
      // IDS headers and comments may also have two tokens.  Only numeric first
      // tokens are spell-state rows; IS_AN_INT accepts decimal and 0x-prefixed
      // WeiDU integers, so both forms participate in collision accounting.
      PATCH_IF (IS_AN_INT ~%MATCH1%~) BEGIN
        SET cbr_value = MATCH1
        PATCH_IF (cbr_value < 0 || cbr_value > 255) BEGIN
          PATCH_FAIL ~CBR SPLSTATE.IDS spell-state value %cbr_value% is outside the collision-safe 0..255 range.~
        END
        SPRINT cbr_symbol ~%MATCH2%~
        TO_UPPER cbr_symbol
        SET $cbr_splstate_value_count(~%cbr_value%~) += 1
        ++cbr_ids_entry_count

        PATCH_IF (~%cbr_symbol%~ STR_EQ ~CBR_TEMPUS_IH~) BEGIN
          ++cbr_ih_count
          SET ih_state = cbr_value
        END ELSE PATCH_IF (~%cbr_symbol%~ STR_EQ ~CBR_TEMPUS_APR_HALF~) BEGIN
          ++cbr_apr_half_count
          SET apr_half_state = cbr_value
        END ELSE PATCH_IF (~%cbr_symbol%~ STR_EQ ~CBR_TEMPUS_APR_ONE~) BEGIN
          ++cbr_apr_one_count
          SET apr_one_state = cbr_value
        END ELSE PATCH_IF (~%cbr_symbol%~ STR_EQ ~CBR_TEMPUS_APR_ONE_HALF~) BEGIN
          ++cbr_apr_one_half_count
          SET apr_one_half_state = cbr_value
        END
      END
    END
      ~~
  END

  PATCH_IF (cbr_ids_entry_count < 1) BEGIN
    PATCH_FAIL ~CBR SPLSTATE.IDS spell-state allocation found no parseable value/symbol rows.~
  END
  PATCH_IF (cbr_ih_count > 1 || cbr_apr_half_count > 1 || cbr_apr_one_count > 1 || cbr_apr_one_half_count > 1) BEGIN
    PATCH_FAIL ~CBR SPLSTATE.IDS collision: a private Tempus spell-state symbol is defined more than once.~
  END

  PATCH_IF ((cbr_ih_count = 1 && $cbr_splstate_value_count(~%ih_state%~) != 1)
         || (cbr_apr_half_count = 1 && $cbr_splstate_value_count(~%apr_half_state%~) != 1)
         || (cbr_apr_one_count = 1 && $cbr_splstate_value_count(~%apr_one_state%~) != 1)
         || (cbr_apr_one_half_count = 1 && $cbr_splstate_value_count(~%apr_one_half_state%~) != 1)) BEGIN
    PATCH_FAIL ~CBR SPLSTATE.IDS collision: a private Tempus spell-state value is shared by another symbol.~
  END

  SET cbr_private_count = cbr_ih_count + cbr_apr_half_count + cbr_apr_one_count + cbr_apr_one_half_count
  PATCH_IF (cbr_private_count < 4) BEGIN
    SET append_states = 1
    SET cbr_missing_count = 4 - cbr_private_count
    SET cbr_allocated_missing = 0
    FOR (cbr_candidate = 255; cbr_candidate >= 0 && cbr_allocated_missing < cbr_missing_count; --cbr_candidate) BEGIN
      PATCH_IF ($cbr_splstate_value_count(~%cbr_candidate%~) = 0) BEGIN
        PATCH_IF (ih_state < 0) BEGIN
          SET ih_state = cbr_candidate
        END ELSE PATCH_IF (apr_half_state < 0) BEGIN
          SET apr_half_state = cbr_candidate
        END ELSE PATCH_IF (apr_one_state < 0) BEGIN
          SET apr_one_state = cbr_candidate
        END ELSE BEGIN
          SET apr_one_half_state = cbr_candidate
        END
        SET $cbr_splstate_value_count(~%cbr_candidate%~) = 1
        ++cbr_allocated_missing
      END
    END
    PATCH_IF (cbr_allocated_missing != cbr_missing_count) BEGIN
      PATCH_FAIL ~CBR SPLSTATE.IDS spell-state allocation is exhausted: %cbr_missing_count% additional unique values in 0..255 are required.~
    END
  END
END

DEFINE_ACTION_FUNCTION cbr_find_or_allocate_splstate
  INT_VAR
    planned_value = "-1"
  STR_VAR
    resource_path = ~~
    symbol        = ~~
  RET
    state_value
    appended
BEGIN
  OUTER_SPRINT resource_path EVALUATE_BUFFER ~%resource_path%~
  OUTER_SPRINT symbol EVALUATE_BUFFER ~%symbol%~
  OUTER_SPRINT symbol_upper ~%symbol%~
  ACTION_TO_UPPER symbol_upper
  OUTER_SET state_value = planned_value
  OUTER_SET appended = 0
  ACTION_IF (planned_value < 0 || planned_value > 255) BEGIN
    FAIL ~CBR SPLSTATE.IDS spell-state allocation for %symbol% has invalid planned value %planned_value%.~
  END
  COPY ~%resource_path%~ ~%resource_path%~
    SET cbr_symbol_count = 0
    SET cbr_value_count = 0
    SET cbr_ids_length = BUFFER_LENGTH
    READ_ASCII 0 cbr_ids_contents (cbr_ids_length)
    INNER_PATCH ~%cbr_ids_contents%~ BEGIN
      REPLACE_EVALUATE CASE_INSENSITIVE
        ~^[ %TAB%]*\([^ %TAB%%WNL%%MNL%%LNL%]+\)[ %TAB%]+\([^ %TAB%%WNL%%MNL%%LNL%]+\)~
      BEGIN
        PATCH_IF (IS_AN_INT ~%MATCH1%~) BEGIN
          SET cbr_current_value = MATCH1
          SPRINT cbr_current_symbol ~%MATCH2%~
          TO_UPPER cbr_current_symbol
          PATCH_IF (cbr_current_value = planned_value) BEGIN
            ++cbr_value_count
          END
          PATCH_IF (~%cbr_current_symbol%~ STR_EQ ~%symbol_upper%~) BEGIN
            ++cbr_symbol_count
            SET cbr_found_value = cbr_current_value
          END
        END
      END
        ~~
    END
    PATCH_IF (cbr_symbol_count > 1) BEGIN
      PATCH_FAIL ~CBR SPLSTATE.IDS collision: private spell-state symbol %symbol% is defined more than once.~
    END
    PATCH_IF (cbr_symbol_count = 1) BEGIN
      PATCH_IF (cbr_found_value != planned_value || cbr_value_count != 1) BEGIN
        PATCH_FAIL ~CBR SPLSTATE.IDS collision: private spell-state symbol %symbol% does not map uniquely to planned value %planned_value%.~
      END
    END ELSE BEGIN
      PATCH_IF (cbr_value_count != 0) BEGIN
        PATCH_FAIL ~CBR SPLSTATE.IDS collision: planned spell-state value %planned_value% for %symbol% is already occupied.~
      END
      SET cbr_ids_end = BUFFER_LENGTH
      SPRINT cbr_ids_prefix ~~
      PATCH_IF (cbr_ids_end > 0) BEGIN
        READ_BYTE (cbr_ids_end - 1) cbr_ids_last_byte
        PATCH_IF (cbr_ids_last_byte != 10 && cbr_ids_last_byte != 13) BEGIN
          SPRINT cbr_ids_prefix ~%WNL%~
        END
      END
      SPRINT cbr_ids_line ~%cbr_ids_prefix%%planned_value% %symbol%%WNL%~
      INSERT_BYTES cbr_ids_end (STRING_LENGTH ~%cbr_ids_line%~)
      WRITE_ASCIIE cbr_ids_end ~%cbr_ids_line%~
      SET cbr_did_append = 1
      INNER_ACTION BEGIN
        OUTER_SET appended = cbr_did_append
      END
    END
  BUT_ONLY
END

// Namespaced semantic version of SCS's resolve_splprot_entry and Artisan's
// ADD_SPLPROT_ENTRY: identify rows by all three data cells, reuse an exact
// foreign-labelled row, and append only when the semantic tuple is absent.
DEFINE_PATCH_FUNCTION cbr_find_or_append_splprot
  INT_VAR
    stat     = 0
    value    = 0
    relation = 0
    append   = 1
  STR_VAR
    row_label = ~~
  RET
    row_index
    appended
BEGIN
  SET row_index = "-1"
  SET appended = 0
  COUNT_2DA_COLS cbr_splprot_cols
  PATCH_IF (cbr_splprot_cols != 4) BEGIN
    PATCH_FAIL ~CBR SPLPROT.2DA validation failed: expected row label plus STAT VALUE RELATION columns.~
  END
  READ_2DA_ENTRIES_NOW cbr_splprot_rows 4
  SET cbr_semantic_matches = 0
  FOR (cbr_row = 0; cbr_row < cbr_splprot_rows; ++cbr_row) BEGIN
    READ_2DA_ENTRY_FORMER cbr_splprot_rows cbr_row 0 cbr_current_label
    READ_2DA_ENTRY_FORMER cbr_splprot_rows cbr_row 1 cbr_current_stat
    READ_2DA_ENTRY_FORMER cbr_splprot_rows cbr_row 2 cbr_current_value
    READ_2DA_ENTRY_FORMER cbr_splprot_rows cbr_row 3 cbr_current_relation
    SET cbr_current_numeric = (IS_AN_INT ~%cbr_current_stat%~) && (IS_AN_INT ~%cbr_current_value%~) && (IS_AN_INT ~%cbr_current_relation%~)
    // Vanilla BG2:EE SPLPROT.2DA ships predicate rows whose VALUE/RELATION
    // cells are the literal token `*` (43_SOURCE, 44_!SOURCE, 63_EVASIONCHECK),
    // and live games keep them. A non-numeric row can never match a semantic
    // (STAT, VALUE, RELATION) tuple, but it still occupies an engine row
    // number: skip it for matching while counting it, so reused and appended
    // row indices stay engine-faithful. Only a reserved-label squatter below
    // remains a hard failure.
    PATCH_IF (cbr_current_numeric && cbr_current_stat = stat && cbr_current_value = value && cbr_current_relation = relation) BEGIN
      ++cbr_semantic_matches
      PATCH_IF (row_index < 0) BEGIN
        // SPLPROT is an ordered predicate table. Multiple foreign labels may
        // legitimately alias one tuple, so consistently reuse the first row.
        SET row_index = cbr_row
      END
    END
    PATCH_IF (~%cbr_current_label%~ STR_EQ ~%row_label%~ && !(cbr_current_numeric && cbr_current_stat = stat && cbr_current_value = value && cbr_current_relation = relation)) BEGIN
      PATCH_FAIL ~CBR SPLPROT.2DA collision: reserved row label %row_label% already has different semantics.~
    END
  END
  PATCH_IF (cbr_semantic_matches = 0 && append = 1) BEGIN
    SET row_index = cbr_splprot_rows
    INSERT_2DA_ROW cbr_splprot_rows 4 ~%row_label% %stat% %value% %relation%~
    SET appended = 1
  END
END

DEFINE_PATCH_FUNCTION cbr_validate_exact_spl_effect
  INT_VAR
    effect_offset           = 0
    expected_opcode         = 0
    expected_target         = 0
    expected_power          = 0
    expected_parameter1     = 0
    expected_parameter2     = 0
    expected_timing         = 0
    expected_resist_dispel  = 0
    expected_duration       = 0
    expected_probability1   = 100
    expected_probability2   = 0
    expected_dice_number    = 0
    expected_dice_size      = 0
    expected_save_type      = 0
    expected_save_bonus     = 0
    expected_special        = 0
  STR_VAR
    helper_name             = ~unknown helper~
    expected_resource       = ~~
BEGIN
  READ_SHORT effect_offset cbr_helper_opcode
  READ_BYTE  (effect_offset + 0x02) cbr_helper_target
  READ_BYTE  (effect_offset + 0x03) cbr_helper_power
  READ_LONG  (effect_offset + 0x04) cbr_helper_parameter1
  READ_LONG  (effect_offset + 0x08) cbr_helper_parameter2
  READ_BYTE  (effect_offset + 0x0c) cbr_helper_timing
  READ_BYTE  (effect_offset + 0x0d) cbr_helper_resist_dispel
  READ_LONG  (effect_offset + 0x0e) cbr_helper_duration
  READ_BYTE  (effect_offset + 0x12) cbr_helper_probability1
  READ_BYTE  (effect_offset + 0x13) cbr_helper_probability2
  READ_ASCII (effect_offset + 0x14) cbr_helper_resource (8) NULL
  READ_LONG  (effect_offset + 0x1c) cbr_helper_dice_number
  READ_LONG  (effect_offset + 0x20) cbr_helper_dice_size
  READ_LONG  (effect_offset + 0x24) cbr_helper_save_type
  READ_LONG  (effect_offset + 0x28) cbr_helper_save_bonus
  READ_LONG  (effect_offset + 0x2c) cbr_helper_special
  PATCH_IF (cbr_helper_opcode != expected_opcode
         || cbr_helper_target != expected_target
         || cbr_helper_power != expected_power
         || cbr_helper_parameter1 != expected_parameter1
         || cbr_helper_parameter2 != expected_parameter2
         || cbr_helper_timing != expected_timing
         || cbr_helper_resist_dispel != expected_resist_dispel
         || cbr_helper_duration != expected_duration
         || cbr_helper_probability1 != expected_probability1
         || cbr_helper_probability2 != expected_probability2
         || !(~%cbr_helper_resource%~ STR_EQ ~%expected_resource%~)
         || cbr_helper_dice_number != expected_dice_number
         || cbr_helper_dice_size != expected_dice_size
         || cbr_helper_save_type != expected_save_type
         || cbr_helper_save_bonus != expected_save_bonus
         || cbr_helper_special != expected_special) BEGIN
    PATCH_FAIL ~CBR Tempus Strength helper %helper_name% has an unexpected opcode field layout or effect order: actual op=%cbr_helper_opcode% target=%cbr_helper_target% power=%cbr_helper_power% p1=%cbr_helper_parameter1% p2=%cbr_helper_parameter2% timing=%cbr_helper_timing% dr=%cbr_helper_resist_dispel% duration=%cbr_helper_duration% probability=%cbr_helper_probability1%/%cbr_helper_probability2% resource=%cbr_helper_resource% dice=%cbr_helper_dice_number%d%cbr_helper_dice_size% save=%cbr_helper_save_type%/%cbr_helper_save_bonus% special=%cbr_helper_special%; expected op=%expected_opcode% target=%expected_target% power=%expected_power% p1=%expected_parameter1% p2=%expected_parameter2% timing=%expected_timing% dr=%expected_resist_dispel% duration=%expected_duration% probability=%expected_probability1%/%expected_probability2% resource=%expected_resource% dice=%expected_dice_number%d%expected_dice_size% save=%expected_save_type%/%expected_save_bonus% special=%expected_special%.~
  END
END

DEFINE_PATCH_FUNCTION cbr_validate_basic_strength_helper_spl
  INT_VAR
    expected_effect_count = 0
  STR_VAR
    helper_name = ~unknown helper~
  RET
    helper_effect_offset
BEGIN
  LPF cbr_validate_spl_v1
    STR_VAR resource_name = EVAL ~Tempus Strength helper %helper_name%.SPL~
    RET
      cbr_helper_ability_offset = ability_offset
      cbr_helper_ability_count  = ability_count
      cbr_helper_effect_offset  = effect_offset
      cbr_helper_effect_count   = effect_count
  END
  READ_SHORT 0x6e cbr_helper_casting_first
  READ_SHORT 0x70 cbr_helper_casting_count
  PATCH_IF (cbr_helper_ability_offset != 0x72
         || cbr_helper_ability_count != 1
         || cbr_helper_effect_offset != 0x9a
         || cbr_helper_effect_count != expected_effect_count
         || cbr_helper_casting_first != 0
         || cbr_helper_casting_count != 0) BEGIN
    PATCH_FAIL ~CBR Tempus Strength helper %helper_name%.SPL must have one canonical self header, no casting effects, and exactly %expected_effect_count% effects.~
  END
  // These private helpers are generated from a blank SPL.  Reserved-name
  // ownership therefore requires the whole main-header template, not just the
  // table pointers; any metadata/icon/string field left nonzero is foreign.
  FOR (cbr_helper_header_byte = 0x08; cbr_helper_header_byte < 0x64; ++cbr_helper_header_byte) BEGIN
    READ_BYTE cbr_helper_header_byte cbr_helper_header_value
    PATCH_IF (cbr_helper_header_value != 0) BEGIN
      PATCH_FAIL ~CBR Tempus Strength helper %helper_name%.SPL has noncanonical main-header data at byte %cbr_helper_header_byte%; reserved helper ownership requires the exact generated blank-header template.~
    END
  END
  READ_SHORT 0x72 cbr_helper_ability_type
  READ_SHORT 0x74 cbr_helper_location
  READ_BYTE  0x7e cbr_helper_target
  READ_SHORT 0x82 cbr_helper_level
  READ_SHORT 0x90 cbr_helper_effect_count_header
  READ_SHORT 0x92 cbr_helper_first_effect
  READ_SHORT 0x94 cbr_helper_charges
  READ_SHORT 0x96 cbr_helper_depletion
  READ_SHORT 0x98 cbr_helper_projectile
  PATCH_IF (cbr_helper_ability_type != 1
         || cbr_helper_location != 4
         || cbr_helper_target != 5
         || cbr_helper_level != 1
         || cbr_helper_effect_count_header != expected_effect_count
         || cbr_helper_first_effect != 0
         || cbr_helper_charges != 1
         || cbr_helper_depletion != 1
         || cbr_helper_projectile != 0) BEGIN
    PATCH_FAIL ~CBR Tempus Strength helper %helper_name%.SPL has an unexpected self-ability header layout.~
  END
  FOR (cbr_helper_header_byte = 0x76; cbr_helper_header_byte < 0x7e; ++cbr_helper_header_byte) BEGIN
    READ_BYTE cbr_helper_header_byte cbr_helper_header_value
    PATCH_IF (cbr_helper_header_value != 0) BEGIN
      PATCH_FAIL ~CBR Tempus Strength helper %helper_name%.SPL has a noncanonical ability icon/header byte at %cbr_helper_header_byte%.~
    END
  END
  FOR (cbr_helper_header_byte = 0x7f; cbr_helper_header_byte < 0x82; ++cbr_helper_header_byte) BEGIN
    READ_BYTE cbr_helper_header_byte cbr_helper_header_value
    PATCH_IF (cbr_helper_header_value != 0) BEGIN
      PATCH_FAIL ~CBR Tempus Strength helper %helper_name%.SPL has noncanonical target/range header data at byte %cbr_helper_header_byte%.~
    END
  END
  FOR (cbr_helper_header_byte = 0x84; cbr_helper_header_byte < 0x90; ++cbr_helper_header_byte) BEGIN
    READ_BYTE cbr_helper_header_byte cbr_helper_header_value
    PATCH_IF (cbr_helper_header_value != 0) BEGIN
      PATCH_FAIL ~CBR Tempus Strength helper %helper_name%.SPL has noncanonical ability metadata at byte %cbr_helper_header_byte%.~
    END
  END
  SET helper_effect_offset = cbr_helper_effect_offset
END

DEFINE_PATCH_FUNCTION cbr_validate_strength_setter
  INT_VAR
    floor = 0
  STR_VAR
    helper_name = ~~
BEGIN
  SET cbr_setter_effect_count = 2
  PATCH_IF (floor = 18) BEGIN
    SET cbr_setter_effect_count = 3
  END
  LPF cbr_validate_basic_strength_helper_spl
    INT_VAR expected_effect_count = cbr_setter_effect_count
    STR_VAR helper_name = EVAL ~%helper_name%~
    RET cbr_setter_effect_offset = helper_effect_offset
  END
  LPF cbr_validate_exact_spl_effect
    INT_VAR
      effect_offset          = cbr_setter_effect_offset
      expected_opcode        = 321
      expected_target        = 1
      expected_power         = 4
      expected_parameter2    = 2
      expected_timing        = 1
      expected_resist_dispel = 2
    STR_VAR expected_resource = EVAL ~%helper_name%~ helper_name = EVAL ~%helper_name% cleanup~
  END
  LPF cbr_validate_exact_spl_effect
    INT_VAR
      effect_offset          = cbr_setter_effect_offset + 0x30
      expected_opcode        = 44
      expected_target        = 1
      expected_power         = 4
      expected_parameter1    = floor
      expected_parameter2    = 1
      expected_timing        = 10
      expected_resist_dispel = 3
      expected_duration      = 31
    STR_VAR helper_name = EVAL ~%helper_name% Strength setter~
  END
  PATCH_IF (floor = 18) BEGIN
    LPF cbr_validate_exact_spl_effect
      INT_VAR
        effect_offset          = cbr_setter_effect_offset + 0x60
        expected_opcode        = 97
        expected_target        = 1
        expected_power         = 4
        expected_parameter1    = 100
        expected_parameter2    = 1
        expected_timing        = 10
        expected_resist_dispel = 3
        expected_duration      = 31
      STR_VAR helper_name = EVAL ~%helper_name% exceptional Strength setter~
    END
  END
END

DEFINE_PATCH_FUNCTION cbr_validate_strength_checker
  INT_VAR
    floor       = 0
    str_lt_row  = "-1"
    str_eq_row  = "-1"
  STR_VAR
    helper_name    = ~~
    setter_resref  = ~~
    exception_resref = ~~
BEGIN
  SET cbr_checker_effect_count = 2
  PATCH_IF (floor = 18) BEGIN
    SET cbr_checker_effect_count = 3
  END
  LPF cbr_validate_basic_strength_helper_spl
    INT_VAR expected_effect_count = cbr_checker_effect_count
    STR_VAR helper_name = EVAL ~%helper_name%~
    RET cbr_checker_effect_offset = helper_effect_offset
  END
  LPF cbr_validate_exact_spl_effect
    INT_VAR
      effect_offset          = cbr_checker_effect_offset
      expected_opcode        = 321
      expected_target        = 1
      expected_power         = 4
      expected_parameter2    = 2
      expected_timing        = 1
      expected_resist_dispel = 2
    STR_VAR helper_name = EVAL ~%helper_name% timed cleanup~ expected_resource = EVAL ~%setter_resref%~
  END
  LPF cbr_validate_exact_spl_effect
    INT_VAR
      effect_offset          = cbr_checker_effect_offset + 0x30
      expected_opcode        = 326
      expected_target        = 1
      expected_power         = 4
      expected_parameter1    = floor
      expected_parameter2    = str_lt_row
      expected_timing        = 1
      expected_resist_dispel = 2
    STR_VAR helper_name = EVAL ~%helper_name% STR floor condition~ expected_resource = EVAL ~%setter_resref%~
  END
  PATCH_IF (floor = 18) BEGIN
    LPF cbr_validate_exact_spl_effect
      INT_VAR
        effect_offset          = cbr_checker_effect_offset + 0x60
        expected_opcode        = 326
        expected_target        = 1
        expected_power         = 4
        expected_parameter1    = 18
        expected_parameter2    = str_eq_row
        expected_timing        = 1
        expected_resist_dispel = 2
      STR_VAR helper_name = EVAL ~%helper_name% exceptional branch~ expected_resource = EVAL ~%exception_resref%~
    END
  END
END

DEFINE_PATCH_FUNCTION cbr_validate_strength_exception
  INT_VAR
    bonus_lt_row = "-1"
  STR_VAR
    helper_name   = ~~
    setter_resref = ~~
BEGIN
  LPF cbr_validate_basic_strength_helper_spl
    INT_VAR expected_effect_count = 1
    STR_VAR helper_name = EVAL ~%helper_name%~
    RET cbr_exception_effect_offset = helper_effect_offset
  END
  LPF cbr_validate_exact_spl_effect
    INT_VAR
      effect_offset          = cbr_exception_effect_offset
      expected_opcode        = 326
      expected_target        = 1
      expected_power         = 4
      expected_parameter1    = 100
      expected_parameter2    = bonus_lt_row
      expected_timing        = 1
      expected_resist_dispel = 2
    STR_VAR helper_name = EVAL ~%helper_name% exceptional Strength condition~ expected_resource = EVAL ~%setter_resref%~
  END
END

DEFINE_PATCH_FUNCTION cbr_validate_strength_pulse_eff
  STR_VAR
    helper_name    = ~~
    checker_resref = ~~
BEGIN
  PATCH_IF (BUFFER_LENGTH != 0x110) BEGIN
    PATCH_FAIL ~CBR Tempus Strength helper %helper_name%.EFF must be exactly one EFF V2 record.~
  END
  READ_ASCII 0x00 cbr_eff_signature_1 (8)
  READ_ASCII 0x08 cbr_eff_signature_2 (8)
  READ_LONG  0x10 cbr_eff_opcode
  READ_LONG  0x14 cbr_eff_target
  READ_LONG  0x18 cbr_eff_power
  READ_LONG  0x1c cbr_eff_parameter1
  READ_LONG  0x20 cbr_eff_parameter2
  READ_LONG  0x24 cbr_eff_timing
  READ_LONG  0x28 cbr_eff_duration
  READ_SHORT 0x2c cbr_eff_probability1
  READ_SHORT 0x2e cbr_eff_probability2
  READ_ASCII 0x30 cbr_eff_resource (8) NULL
  READ_LONG  0x38 cbr_eff_dice_number
  READ_LONG  0x3c cbr_eff_dice_size
  READ_LONG  0x40 cbr_eff_save_type
  READ_LONG  0x44 cbr_eff_save_bonus
  READ_LONG  0x48 cbr_eff_special
  READ_LONG  0x5c cbr_eff_flags
  PATCH_IF (!(~%cbr_eff_signature_1%~ STR_EQ ~EFF V2.0~)
         || !(~%cbr_eff_signature_2%~ STR_EQ ~EFF V2.0~)
         || cbr_eff_opcode != 146
         || cbr_eff_target != 2
         || cbr_eff_power != 4
         || cbr_eff_parameter1 != 0
         || cbr_eff_parameter2 != 1
         || cbr_eff_timing != 1
         || cbr_eff_duration != 0
         || cbr_eff_probability1 != 100
         || cbr_eff_probability2 != 0
         || !(~%cbr_eff_resource%~ STR_EQ ~%checker_resref%~)
         || cbr_eff_dice_number != 0
         || cbr_eff_dice_size != 0
         || cbr_eff_save_type != 0
         || cbr_eff_save_bonus != 0
         || cbr_eff_special != 0
         || cbr_eff_flags != 2) BEGIN
    PATCH_FAIL ~CBR Tempus Strength helper %helper_name%.EFF has an unexpected opcode-146 field layout; EFF offset 0x5c must contain flags 2.~
  END
  // CREATE EFF leaves every extended V2 field zero except flags at 0x5c.
  // Validate the metadata, parent-resource, source, timing-extension, and all
  // remaining reserved bytes so a foreign same-resref EFF cannot masquerade as
  // one of our private heartbeat records.
  FOR (cbr_eff_byte = 0x4c; cbr_eff_byte < 0x5c; ++cbr_eff_byte) BEGIN
    READ_BYTE cbr_eff_byte cbr_eff_value
    PATCH_IF (cbr_eff_value != 0) BEGIN
      PATCH_FAIL ~CBR Tempus Strength helper %helper_name%.EFF has noncanonical extended metadata at byte %cbr_eff_byte%.~
    END
  END
  FOR (cbr_eff_byte = 0x60; cbr_eff_byte < 0x110; ++cbr_eff_byte) BEGIN
    READ_BYTE cbr_eff_byte cbr_eff_value
    PATCH_IF (cbr_eff_value != 0) BEGIN
      PATCH_FAIL ~CBR Tempus Strength helper %helper_name%.EFF has noncanonical extended or parent-resource data at byte %cbr_eff_byte%.~
    END
  END
END

// Task 5 APR helpers are deliberately stricter than the long-lived Strength
// setters: each refresh removes only prior timed instances of itself, then
// applies one cumulative APR effect for exactly one second.
DEFINE_PATCH_FUNCTION cbr_validate_tempus_apr_helper_spl
  INT_VAR
    apr_key = 0
  STR_VAR
    helper_name = ~~
BEGIN
  SPRINT cbr_apr_helper_resref ~%helper_name%~
  LPF cbr_validate_basic_strength_helper_spl
    INT_VAR expected_effect_count = 2
    STR_VAR helper_name = EVAL ~%cbr_apr_helper_resref% APR~
    RET cbr_apr_effect_offset = helper_effect_offset
  END
  LPF cbr_validate_exact_spl_effect
    INT_VAR
      effect_offset          = cbr_apr_effect_offset
      expected_opcode        = 321
      expected_target        = 1
      expected_power         = 4
      expected_parameter2    = 2
      expected_timing        = 1
      expected_resist_dispel = 2
    STR_VAR helper_name = EVAL ~%cbr_apr_helper_resref% timed-only cleanup~ expected_resource = EVAL ~%cbr_apr_helper_resref%~
  END
  LPF cbr_validate_exact_spl_effect
    INT_VAR
      effect_offset          = cbr_apr_effect_offset + 0x30
      expected_opcode        = 1
      expected_target        = 1
      expected_power         = 4
      expected_parameter1    = apr_key
      expected_parameter2    = 0
      expected_timing        = 0
      expected_resist_dispel = 2
      expected_duration      = 1
    STR_VAR helper_name = EVAL ~%cbr_apr_helper_resref% one-second APR~
  END
END

DEFINE_PATCH_FUNCTION cbr_validate_tempus_apr_condition_eff
  INT_VAR
    ih_state         = "-1"
    active_state_row = "-1"
  STR_VAR
    helper_name   = ~~
    helper_resref = ~~
BEGIN
  PATCH_IF (BUFFER_LENGTH != 0x110) BEGIN
    PATCH_FAIL ~CBR Tempus APR condition %helper_name%.EFF must be exactly one EFF V2 record.~
  END
  READ_ASCII 0x00 cbr_apr_eff_signature_1 (8)
  READ_ASCII 0x08 cbr_apr_eff_signature_2 (8)
  READ_LONG  0x10 cbr_apr_eff_opcode
  READ_LONG  0x14 cbr_apr_eff_target
  READ_LONG  0x18 cbr_apr_eff_power
  READ_LONG  0x1c cbr_apr_eff_parameter1
  READ_LONG  0x20 cbr_apr_eff_parameter2
  READ_LONG  0x24 cbr_apr_eff_timing
  READ_LONG  0x28 cbr_apr_eff_duration
  READ_SHORT 0x2c cbr_apr_eff_probability1
  READ_SHORT 0x2e cbr_apr_eff_probability2
  READ_ASCII 0x30 cbr_apr_eff_resource (8) NULL
  READ_LONG  0x38 cbr_apr_eff_dice_number
  READ_LONG  0x3c cbr_apr_eff_dice_size
  READ_LONG  0x40 cbr_apr_eff_save_type
  READ_LONG  0x44 cbr_apr_eff_save_bonus
  READ_LONG  0x48 cbr_apr_eff_special
  READ_LONG  0x5c cbr_apr_eff_flags
  PATCH_IF (!(~%cbr_apr_eff_signature_1%~ STR_EQ ~EFF V2.0~)
         || !(~%cbr_apr_eff_signature_2%~ STR_EQ ~EFF V2.0~)
         || cbr_apr_eff_opcode != 326
         || cbr_apr_eff_target != 2
         || cbr_apr_eff_power != 4
         || cbr_apr_eff_parameter1 != ih_state
         || cbr_apr_eff_parameter2 != active_state_row
         || cbr_apr_eff_timing != 1
         || cbr_apr_eff_duration != 0
         || cbr_apr_eff_probability1 != 100
         || cbr_apr_eff_probability2 != 0
         || !(~%cbr_apr_eff_resource%~ STR_EQ ~%helper_resref%~)
         || cbr_apr_eff_dice_number != 0
         || cbr_apr_eff_dice_size != 0
         || cbr_apr_eff_save_type != 0
         || cbr_apr_eff_save_bonus != 0
         || cbr_apr_eff_special != 0
         || cbr_apr_eff_flags != 2) BEGIN
    PATCH_FAIL ~CBR Tempus APR condition %helper_name%.EFF has a noncanonical active-Improved-Haste opcode-326 layout.~
  END
  FOR (cbr_apr_eff_byte = 0x4c; cbr_apr_eff_byte < 0x5c; ++cbr_apr_eff_byte) BEGIN
    READ_BYTE cbr_apr_eff_byte cbr_apr_eff_value
    PATCH_IF (cbr_apr_eff_value != 0) BEGIN
      PATCH_FAIL ~CBR Tempus APR condition %helper_name%.EFF has noncanonical metadata at byte %cbr_apr_eff_byte%.~
    END
  END
  FOR (cbr_apr_eff_byte = 0x60; cbr_apr_eff_byte < 0x110; ++cbr_apr_eff_byte) BEGIN
    READ_BYTE cbr_apr_eff_byte cbr_apr_eff_value
    PATCH_IF (cbr_apr_eff_value != 0) BEGIN
      PATCH_FAIL ~CBR Tempus APR condition %helper_name%.EFF has noncanonical extended data at byte %cbr_apr_eff_byte%.~
    END
  END
END

// Central private-resref registry shared by the progression and bridge phases.
// During Task 3 any existing reserved file is foreign and therefore a hard
// collision. Later phases must relax that rule only for an exact, semantically
// recognized CBR-owned resource so an idempotent reinstall remains safe.
DEFINE_ACTION_FUNCTION cbr_define_tempus_private_resrefs
  RET
    cbr_apr_helper_6
    cbr_apr_helper_1
    cbr_apr_helper_7
    cbr_apr_condition_6
    cbr_apr_condition_1
    cbr_apr_condition_7
    cbr_strength_set_18
    cbr_strength_set_19
    cbr_strength_set_20
    cbr_strength_set_21
    cbr_strength_check_18
    cbr_strength_check_19
    cbr_strength_check_20
    cbr_strength_check_21
    cbr_strength_pulse_18
    cbr_strength_pulse_19
    cbr_strength_pulse_20
    cbr_strength_pulse_21
    cbr_strength_exception_18
BEGIN
  OUTER_SPRINT cbr_apr_helper_6 ~CBRAPR6~
  OUTER_SPRINT cbr_apr_helper_1 ~CBRAPR1~
  OUTER_SPRINT cbr_apr_helper_7 ~CBRAPR7~
  OUTER_SPRINT cbr_apr_condition_6 ~CBRAPC6~
  OUTER_SPRINT cbr_apr_condition_1 ~CBRAPC1~
  OUTER_SPRINT cbr_apr_condition_7 ~CBRAPC7~
  OUTER_SPRINT cbr_strength_set_18 ~CBRST18~
  OUTER_SPRINT cbr_strength_set_19 ~CBRST19~
  OUTER_SPRINT cbr_strength_set_20 ~CBRST20~
  OUTER_SPRINT cbr_strength_set_21 ~CBRST21~
  OUTER_SPRINT cbr_strength_check_18 ~CBRSC18~
  OUTER_SPRINT cbr_strength_check_19 ~CBRSC19~
  OUTER_SPRINT cbr_strength_check_20 ~CBRSC20~
  OUTER_SPRINT cbr_strength_check_21 ~CBRSC21~
  OUTER_SPRINT cbr_strength_pulse_18 ~CBRSE18~
  OUTER_SPRINT cbr_strength_pulse_19 ~CBRSE19~
  OUTER_SPRINT cbr_strength_pulse_20 ~CBRSE20~
  OUTER_SPRINT cbr_strength_pulse_21 ~CBRSE21~
  OUTER_SPRINT cbr_strength_exception_18 ~CBRSX18~
END

DEFINE_ACTION_FUNCTION cbr_validate_tempus_apr_helpers
  INT_VAR
    ih_state          = "-1"
    active_state_row = "-1"
  STR_VAR
    resource_dir = ~~
BEGIN
  OUTER_SPRINT resource_dir EVALUATE_BUFFER ~%resource_dir%~
  LAF cbr_define_tempus_private_resrefs
    RET
      cbr_apr_helper_6
      cbr_apr_helper_1
      cbr_apr_helper_7
      cbr_apr_condition_6
      cbr_apr_condition_1
      cbr_apr_condition_7
  END
  ACTION_IF (ih_state < 0 || active_state_row < 0) BEGIN
    FAIL ~CBR Tempus APR helper validation requires allocated private state and active-SPLSTATE predicate row.~
  END
  ACTION_FOR_EACH cbr_apr_spl IN ~%cbr_apr_helper_6%~ ~%cbr_apr_helper_1%~ ~%cbr_apr_helper_7%~ BEGIN
    ACTION_IF !(FILE_EXISTS ~%resource_dir%/%cbr_apr_spl%.spl~ || FILE_EXISTS ~%resource_dir%/%cbr_apr_spl%.SPL~) BEGIN
      FAIL ~CBR Tempus APR helper %cbr_apr_spl%.SPL is missing from a bridged resource tree.~
    END
    ACTION_IF (FILE_EXISTS ~%resource_dir%/%cbr_apr_spl%.eff~ || FILE_EXISTS ~%resource_dir%/%cbr_apr_spl%.EFF~) BEGIN
      FAIL ~CBR Tempus APR helper collision: %cbr_apr_spl% exists with both SPL and EFF extensions.~
    END
  END
  ACTION_FOR_EACH cbr_apr_eff IN ~%cbr_apr_condition_6%~ ~%cbr_apr_condition_1%~ ~%cbr_apr_condition_7%~ BEGIN
    ACTION_IF !(FILE_EXISTS ~%resource_dir%/%cbr_apr_eff%.eff~ || FILE_EXISTS ~%resource_dir%/%cbr_apr_eff%.EFF~) BEGIN
      FAIL ~CBR Tempus APR condition %cbr_apr_eff%.EFF is missing from a bridged resource tree.~
    END
    ACTION_IF (FILE_EXISTS ~%resource_dir%/%cbr_apr_eff%.spl~ || FILE_EXISTS ~%resource_dir%/%cbr_apr_eff%.SPL~) BEGIN
      FAIL ~CBR Tempus APR condition collision: %cbr_apr_eff% exists with both EFF and SPL extensions.~
    END
  END

  COPY ~%resource_dir%/%cbr_apr_helper_6%.spl~ ~%resource_dir%/%cbr_apr_helper_6%.spl~
    LPF cbr_validate_tempus_apr_helper_spl INT_VAR apr_key = 6 STR_VAR helper_name = EVAL ~%cbr_apr_helper_6%~ END
  BUT_ONLY
  COPY ~%resource_dir%/%cbr_apr_helper_1%.spl~ ~%resource_dir%/%cbr_apr_helper_1%.spl~
    LPF cbr_validate_tempus_apr_helper_spl INT_VAR apr_key = 1 STR_VAR helper_name = EVAL ~%cbr_apr_helper_1%~ END
  BUT_ONLY
  COPY ~%resource_dir%/%cbr_apr_helper_7%.spl~ ~%resource_dir%/%cbr_apr_helper_7%.spl~
    LPF cbr_validate_tempus_apr_helper_spl INT_VAR apr_key = 7 STR_VAR helper_name = EVAL ~%cbr_apr_helper_7%~ END
  BUT_ONLY

  COPY ~%resource_dir%/%cbr_apr_condition_6%.eff~ ~%resource_dir%/%cbr_apr_condition_6%.eff~
    LPF cbr_validate_tempus_apr_condition_eff INT_VAR ih_state = ih_state active_state_row = active_state_row STR_VAR helper_name = EVAL ~%cbr_apr_condition_6%~ helper_resref = EVAL ~%cbr_apr_helper_6%~ END
  BUT_ONLY
  COPY ~%resource_dir%/%cbr_apr_condition_1%.eff~ ~%resource_dir%/%cbr_apr_condition_1%.eff~
    LPF cbr_validate_tempus_apr_condition_eff INT_VAR ih_state = ih_state active_state_row = active_state_row STR_VAR helper_name = EVAL ~%cbr_apr_condition_1%~ helper_resref = EVAL ~%cbr_apr_helper_1%~ END
  BUT_ONLY
  COPY ~%resource_dir%/%cbr_apr_condition_7%.eff~ ~%resource_dir%/%cbr_apr_condition_7%.eff~
    LPF cbr_validate_tempus_apr_condition_eff INT_VAR ih_state = ih_state active_state_row = active_state_row STR_VAR helper_name = EVAL ~%cbr_apr_condition_7%~ helper_resref = EVAL ~%cbr_apr_helper_7%~ END
  BUT_ONLY
END

// Reject private-resource names supplied by the installed game rather than by
// the explicit resource tree being validated.  FILE_EXISTS alone cannot see
// BIFF-backed resources, so the chitin.key path must probe every extension
// which opcode-321 cleanup or helper publication could accidentally shadow.
// An explicit same-extension SPL/EFF is deferred to the exact owned-resource
// validators below; ITMs are never an owned CBR resource.
DEFINE_ACTION_FUNCTION cbr_reject_key_private_collisions
  STR_VAR
    resource_dir = ~~
BEGIN
  OUTER_SPRINT resource_dir EVALUATE_BUFFER ~%resource_dir%~
  LAF cbr_define_tempus_private_resrefs
    RET
      cbr_apr_helper_6
      cbr_apr_helper_1
      cbr_apr_helper_7
      cbr_apr_condition_6
      cbr_apr_condition_1
      cbr_apr_condition_7
      cbr_strength_set_18
      cbr_strength_set_19
      cbr_strength_set_20
      cbr_strength_set_21
      cbr_strength_check_18
      cbr_strength_check_19
      cbr_strength_check_20
      cbr_strength_check_21
      cbr_strength_pulse_18
      cbr_strength_pulse_19
      cbr_strength_pulse_20
      cbr_strength_pulse_21
      cbr_strength_exception_18
  END

  ACTION_IF (FILE_EXISTS ~chitin.key~) BEGIN
    ACTION_IF (FILE_EXISTS_IN_GAME ~OHTMPS1.ITM~) BEGIN
      FAIL ~CBR Tempus Holy Power reserved-resource namespace collision: OHTMPS1.ITM is visible through the game KEY and could be affected by opcode 321 cleanup.~
    END
    ACTION_FOR_EACH cbr_key_reserved IN
      ~%cbr_apr_helper_6%~ ~%cbr_apr_helper_1%~ ~%cbr_apr_helper_7%~
      ~%cbr_apr_condition_6%~ ~%cbr_apr_condition_1%~ ~%cbr_apr_condition_7%~
      ~%cbr_strength_set_18%~ ~%cbr_strength_set_19%~ ~%cbr_strength_set_20%~ ~%cbr_strength_set_21%~
      ~%cbr_strength_check_18%~ ~%cbr_strength_check_19%~ ~%cbr_strength_check_20%~ ~%cbr_strength_check_21%~
      ~%cbr_strength_pulse_18%~ ~%cbr_strength_pulse_19%~ ~%cbr_strength_pulse_20%~ ~%cbr_strength_pulse_21%~
      ~%cbr_strength_exception_18%~
    BEGIN
      ACTION_IF (FILE_EXISTS_IN_GAME ~%cbr_key_reserved%.SPL~
              && !(FILE_EXISTS ~%resource_dir%/%cbr_key_reserved%.spl~ || FILE_EXISTS ~%resource_dir%/%cbr_key_reserved%.SPL~)) BEGIN
        FAIL ~CBR Tempus Holy Power reserved-resource namespace collision: %cbr_key_reserved%.SPL is visible only through the game KEY; refusing to shadow a foreign resource.~
      END
      ACTION_IF (FILE_EXISTS_IN_GAME ~%cbr_key_reserved%.EFF~
              && !(FILE_EXISTS ~%resource_dir%/%cbr_key_reserved%.eff~ || FILE_EXISTS ~%resource_dir%/%cbr_key_reserved%.EFF~)) BEGIN
        FAIL ~CBR Tempus Holy Power reserved-resource namespace collision: %cbr_key_reserved%.EFF is visible only through the game KEY; refusing to shadow a foreign resource.~
      END
      ACTION_IF (FILE_EXISTS_IN_GAME ~%cbr_key_reserved%.ITM~) BEGIN
        FAIL ~CBR Tempus Holy Power reserved-resource namespace collision: %cbr_key_reserved%.ITM is visible through the game KEY and could be affected by opcode 321 cleanup.~
      END
    END
  END
END

DEFINE_ACTION_FUNCTION cbr_validate_tempus_strength_helpers
  INT_VAR
    str_lt_row       = "-1"
    str_eq_row       = "-1"
    str_bonus_lt_row = "-1"
  STR_VAR
    resource_dir = ~~
BEGIN
  OUTER_SPRINT resource_dir EVALUATE_BUFFER ~%resource_dir%~
  LAF cbr_define_tempus_private_resrefs
    RET
      cbr_strength_set_18
      cbr_strength_set_19
      cbr_strength_set_20
      cbr_strength_set_21
      cbr_strength_check_18
      cbr_strength_check_19
      cbr_strength_check_20
      cbr_strength_check_21
      cbr_strength_pulse_18
      cbr_strength_pulse_19
      cbr_strength_pulse_20
      cbr_strength_pulse_21
      cbr_strength_exception_18
  END
  ACTION_FOR_EACH cbr_strength_spl IN
    ~%cbr_strength_set_18%~ ~%cbr_strength_set_19%~ ~%cbr_strength_set_20%~ ~%cbr_strength_set_21%~
    ~%cbr_strength_check_18%~ ~%cbr_strength_check_19%~ ~%cbr_strength_check_20%~ ~%cbr_strength_check_21%~
    ~%cbr_strength_exception_18%~
  BEGIN
    ACTION_IF !(FILE_EXISTS ~%resource_dir%/%cbr_strength_spl%.spl~) BEGIN
      FAIL ~CBR Tempus Strength helper %cbr_strength_spl%.SPL is missing from recognized 30-header output.~
    END
    ACTION_IF (FILE_EXISTS ~%resource_dir%/%cbr_strength_spl%.eff~ || FILE_EXISTS ~%resource_dir%/%cbr_strength_spl%.EFF~) BEGIN
      FAIL ~CBR Tempus Strength helper collision: %cbr_strength_spl% exists with both SPL and EFF extensions.~
    END
  END
  ACTION_FOR_EACH cbr_strength_eff IN
    ~%cbr_strength_pulse_18%~ ~%cbr_strength_pulse_19%~ ~%cbr_strength_pulse_20%~ ~%cbr_strength_pulse_21%~
  BEGIN
    ACTION_IF !(FILE_EXISTS ~%resource_dir%/%cbr_strength_eff%.eff~) BEGIN
      FAIL ~CBR Tempus Strength helper %cbr_strength_eff%.EFF is missing from recognized 30-header output.~
    END
    ACTION_IF (FILE_EXISTS ~%resource_dir%/%cbr_strength_eff%.spl~ || FILE_EXISTS ~%resource_dir%/%cbr_strength_eff%.SPL~) BEGIN
      FAIL ~CBR Tempus Strength helper collision: %cbr_strength_eff% exists with both EFF and SPL extensions.~
    END
  END

  COPY ~%resource_dir%/%cbr_strength_set_18%.spl~ ~%resource_dir%/%cbr_strength_set_18%.spl~
    LPF cbr_validate_strength_setter INT_VAR floor = 18 STR_VAR helper_name = EVAL ~%cbr_strength_set_18%~ END
  BUT_ONLY
  COPY ~%resource_dir%/%cbr_strength_set_19%.spl~ ~%resource_dir%/%cbr_strength_set_19%.spl~
    LPF cbr_validate_strength_setter INT_VAR floor = 19 STR_VAR helper_name = EVAL ~%cbr_strength_set_19%~ END
  BUT_ONLY
  COPY ~%resource_dir%/%cbr_strength_set_20%.spl~ ~%resource_dir%/%cbr_strength_set_20%.spl~
    LPF cbr_validate_strength_setter INT_VAR floor = 20 STR_VAR helper_name = EVAL ~%cbr_strength_set_20%~ END
  BUT_ONLY
  COPY ~%resource_dir%/%cbr_strength_set_21%.spl~ ~%resource_dir%/%cbr_strength_set_21%.spl~
    LPF cbr_validate_strength_setter INT_VAR floor = 21 STR_VAR helper_name = EVAL ~%cbr_strength_set_21%~ END
  BUT_ONLY

  COPY ~%resource_dir%/%cbr_strength_check_18%.spl~ ~%resource_dir%/%cbr_strength_check_18%.spl~
    LPF cbr_validate_strength_checker
      INT_VAR floor = 18 str_lt_row = str_lt_row str_eq_row = str_eq_row
      STR_VAR helper_name = EVAL ~%cbr_strength_check_18%~ setter_resref = EVAL ~%cbr_strength_set_18%~ exception_resref = EVAL ~%cbr_strength_exception_18%~
    END
  BUT_ONLY
  COPY ~%resource_dir%/%cbr_strength_check_19%.spl~ ~%resource_dir%/%cbr_strength_check_19%.spl~
    LPF cbr_validate_strength_checker
      INT_VAR floor = 19 str_lt_row = str_lt_row
      STR_VAR helper_name = EVAL ~%cbr_strength_check_19%~ setter_resref = EVAL ~%cbr_strength_set_19%~
    END
  BUT_ONLY
  COPY ~%resource_dir%/%cbr_strength_check_20%.spl~ ~%resource_dir%/%cbr_strength_check_20%.spl~
    LPF cbr_validate_strength_checker
      INT_VAR floor = 20 str_lt_row = str_lt_row
      STR_VAR helper_name = EVAL ~%cbr_strength_check_20%~ setter_resref = EVAL ~%cbr_strength_set_20%~
    END
  BUT_ONLY
  COPY ~%resource_dir%/%cbr_strength_check_21%.spl~ ~%resource_dir%/%cbr_strength_check_21%.spl~
    LPF cbr_validate_strength_checker
      INT_VAR floor = 21 str_lt_row = str_lt_row
      STR_VAR helper_name = EVAL ~%cbr_strength_check_21%~ setter_resref = EVAL ~%cbr_strength_set_21%~
    END
  BUT_ONLY

  COPY ~%resource_dir%/%cbr_strength_exception_18%.spl~ ~%resource_dir%/%cbr_strength_exception_18%.spl~
    LPF cbr_validate_strength_exception
      INT_VAR bonus_lt_row = str_bonus_lt_row
      STR_VAR helper_name = EVAL ~%cbr_strength_exception_18%~ setter_resref = EVAL ~%cbr_strength_set_18%~
    END
  BUT_ONLY

  COPY ~%resource_dir%/%cbr_strength_pulse_18%.eff~ ~%resource_dir%/%cbr_strength_pulse_18%.eff~
    LPF cbr_validate_strength_pulse_eff STR_VAR helper_name = EVAL ~%cbr_strength_pulse_18%~ checker_resref = EVAL ~%cbr_strength_check_18%~ END
  BUT_ONLY
  COPY ~%resource_dir%/%cbr_strength_pulse_19%.eff~ ~%resource_dir%/%cbr_strength_pulse_19%.eff~
    LPF cbr_validate_strength_pulse_eff STR_VAR helper_name = EVAL ~%cbr_strength_pulse_19%~ checker_resref = EVAL ~%cbr_strength_check_19%~ END
  BUT_ONLY
  COPY ~%resource_dir%/%cbr_strength_pulse_20%.eff~ ~%resource_dir%/%cbr_strength_pulse_20%.eff~
    LPF cbr_validate_strength_pulse_eff STR_VAR helper_name = EVAL ~%cbr_strength_pulse_20%~ checker_resref = EVAL ~%cbr_strength_check_20%~ END
  BUT_ONLY
  COPY ~%resource_dir%/%cbr_strength_pulse_21%.eff~ ~%resource_dir%/%cbr_strength_pulse_21%.eff~
    LPF cbr_validate_strength_pulse_eff STR_VAR helper_name = EVAL ~%cbr_strength_pulse_21%~ checker_resref = EVAL ~%cbr_strength_check_21%~ END
  BUT_ONLY
END

DEFINE_ACTION_FUNCTION cbr_create_tempus_strength_setter
  INT_VAR
    floor = 0
  STR_VAR
    resource_dir = ~~
    setter_resref = ~~
BEGIN
  OUTER_SPRINT resource_dir EVALUATE_BUFFER ~%resource_dir%~
  OUTER_SPRINT setter_resref EVALUATE_BUFFER ~%setter_resref%~
  CREATE SPL ~%setter_resref%~
    LPF cbr_add_basic_self_ability END
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 321 target = 1 power = 4 parameter2 = 2 timing = 1 resist_dispel = 2
      STR_VAR resource = EVAL ~%setter_resref%~
    END
    // Timing mode 10 measures duration in engine ticks.  Opcode 272's nominal
    // one-second pulse stretches to 30 ticks under Slow/disease, so 31 ticks
    // gives one tick of overlap without lengthening stale early-removal state
    // beyond roughly two seconds.
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 44 target = 1 power = 4 parameter1 = floor parameter2 = 1 timing = 10 resist_dispel = 3 duration = 31
    END
    PATCH_IF (floor = 18) BEGIN
      LPF cbr_append_spl_effect_record
        INT_VAR opcode = 97 target = 1 power = 4 parameter1 = 100 parameter2 = 1 timing = 10 resist_dispel = 3 duration = 31
      END
      WRITE_SHORT 0x90 3
    END ELSE BEGIN
      WRITE_SHORT 0x90 2
    END
  ACTION_IF !(~%resource_dir%~ STR_EQ ~override~) BEGIN
    // Preflight proved a distinct destination has no reserved file.  If the
    // destination exists only after CREATE, its path aliases cwd/override and
    // the generated helper is already in place; a MOVE would target itself.
    ACTION_IF !(FILE_EXISTS ~%resource_dir%/%setter_resref%.spl~) BEGIN
      MOVE ~override/%setter_resref%.spl~ ~%resource_dir%/%setter_resref%.spl~
    END
  END
END

DEFINE_ACTION_FUNCTION cbr_create_tempus_strength_checker
  INT_VAR
    floor       = 0
    str_lt_row  = "-1"
    str_eq_row  = "-1"
  STR_VAR
    resource_dir      = ~~
    checker_resref    = ~~
    setter_resref     = ~~
    exception_resref  = ~~
BEGIN
  OUTER_SPRINT resource_dir EVALUATE_BUFFER ~%resource_dir%~
  OUTER_SPRINT checker_resref EVALUATE_BUFFER ~%checker_resref%~
  OUTER_SPRINT setter_resref EVALUATE_BUFFER ~%setter_resref%~
  OUTER_SPRINT exception_resref EVALUATE_BUFFER ~%exception_resref%~
  CREATE SPL ~%checker_resref%~
    LPF cbr_add_basic_self_ability END
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 321 target = 1 power = 4 parameter2 = 2 timing = 1 resist_dispel = 2
      STR_VAR resource = EVAL ~%setter_resref%~
    END
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 326 target = 1 power = 4 parameter1 = floor parameter2 = str_lt_row timing = 1 resist_dispel = 2
      STR_VAR resource = EVAL ~%setter_resref%~
    END
    PATCH_IF (floor = 18) BEGIN
      LPF cbr_append_spl_effect_record
        INT_VAR opcode = 326 target = 1 power = 4 parameter1 = 18 parameter2 = str_eq_row timing = 1 resist_dispel = 2
        STR_VAR resource = EVAL ~%exception_resref%~
      END
      WRITE_SHORT 0x90 3
    END ELSE BEGIN
      WRITE_SHORT 0x90 2
    END
  ACTION_IF !(~%resource_dir%~ STR_EQ ~override~) BEGIN
    ACTION_IF !(FILE_EXISTS ~%resource_dir%/%checker_resref%.spl~) BEGIN
      MOVE ~override/%checker_resref%.spl~ ~%resource_dir%/%checker_resref%.spl~
    END
  END
END

DEFINE_ACTION_FUNCTION cbr_create_tempus_strength_exception
  INT_VAR
    bonus_lt_row = "-1"
  STR_VAR
    resource_dir      = ~~
    exception_resref  = ~~
    setter_resref     = ~~
BEGIN
  OUTER_SPRINT resource_dir EVALUATE_BUFFER ~%resource_dir%~
  OUTER_SPRINT exception_resref EVALUATE_BUFFER ~%exception_resref%~
  OUTER_SPRINT setter_resref EVALUATE_BUFFER ~%setter_resref%~
  CREATE SPL ~%exception_resref%~
    LPF cbr_add_basic_self_ability END
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 326 target = 1 power = 4 parameter1 = 100 parameter2 = bonus_lt_row timing = 1 resist_dispel = 2
      STR_VAR resource = EVAL ~%setter_resref%~
    END
    WRITE_SHORT 0x90 1
  ACTION_IF !(~%resource_dir%~ STR_EQ ~override~) BEGIN
    ACTION_IF !(FILE_EXISTS ~%resource_dir%/%exception_resref%.spl~) BEGIN
      MOVE ~override/%exception_resref%.spl~ ~%resource_dir%/%exception_resref%.spl~
    END
  END
END

DEFINE_ACTION_FUNCTION cbr_create_tempus_strength_pulse
  STR_VAR
    resource_dir    = ~~
    pulse_resref    = ~~
    checker_resref  = ~~
BEGIN
  OUTER_SPRINT resource_dir EVALUATE_BUFFER ~%resource_dir%~
  OUTER_SPRINT pulse_resref EVALUATE_BUFFER ~%pulse_resref%~
  OUTER_SPRINT checker_resref EVALUATE_BUFFER ~%checker_resref%~
  CREATE EFF ~%pulse_resref%~
    // Normalize every EFF field after the two V2 signatures before writing the
    // owned opcode.  This prevents WeiDU-version defaults from broadening the
    // exact reserved-resource acceptance template.
    FOR (cbr_eff_byte = 0x10; cbr_eff_byte < 0x110; ++cbr_eff_byte) BEGIN
      WRITE_BYTE cbr_eff_byte 0
    END
    WRITE_LONG 0x10 146
    WRITE_LONG 0x14 2
    WRITE_LONG 0x18 4
    WRITE_LONG 0x1c 0
    WRITE_LONG 0x20 1
    WRITE_LONG 0x24 1
    WRITE_LONG 0x28 0
    WRITE_SHORT 0x2c 100
    WRITE_SHORT 0x2e 0
    WRITE_ASCIIE 0x30 ~%checker_resref%~ #8
    WRITE_LONG 0x38 0
    WRITE_LONG 0x3c 0
    WRITE_LONG 0x40 0
    WRITE_LONG 0x44 0
    WRITE_LONG 0x48 0
    WRITE_LONG 0x5c 2
  ACTION_IF !(~%resource_dir%~ STR_EQ ~override~) BEGIN
    ACTION_IF !(FILE_EXISTS ~%resource_dir%/%pulse_resref%.eff~) BEGIN
      MOVE ~override/%pulse_resref%.eff~ ~%resource_dir%/%pulse_resref%.eff~
    END
  END
END

DEFINE_ACTION_FUNCTION cbr_create_tempus_strength_helpers
  INT_VAR
    str_lt_row       = "-1"
    str_eq_row       = "-1"
    str_bonus_lt_row = "-1"
  STR_VAR
    resource_dir = ~~
BEGIN
  OUTER_SPRINT resource_dir EVALUATE_BUFFER ~%resource_dir%~
  ACTION_IF (str_lt_row < 0 || str_eq_row < 0 || str_bonus_lt_row < 0) BEGIN
    FAIL ~CBR cannot create Tempus Strength helpers without all dynamic SPLPROT rows.~
  END
  LAF cbr_define_tempus_private_resrefs
    RET
      cbr_strength_set_18
      cbr_strength_set_19
      cbr_strength_set_20
      cbr_strength_set_21
      cbr_strength_check_18
      cbr_strength_check_19
      cbr_strength_check_20
      cbr_strength_check_21
      cbr_strength_pulse_18
      cbr_strength_pulse_19
      cbr_strength_pulse_20
      cbr_strength_pulse_21
      cbr_strength_exception_18
  END

  LAF cbr_create_tempus_strength_setter INT_VAR floor = 18 STR_VAR resource_dir = EVAL ~%resource_dir%~ setter_resref = EVAL ~%cbr_strength_set_18%~ END
  LAF cbr_create_tempus_strength_setter INT_VAR floor = 19 STR_VAR resource_dir = EVAL ~%resource_dir%~ setter_resref = EVAL ~%cbr_strength_set_19%~ END
  LAF cbr_create_tempus_strength_setter INT_VAR floor = 20 STR_VAR resource_dir = EVAL ~%resource_dir%~ setter_resref = EVAL ~%cbr_strength_set_20%~ END
  LAF cbr_create_tempus_strength_setter INT_VAR floor = 21 STR_VAR resource_dir = EVAL ~%resource_dir%~ setter_resref = EVAL ~%cbr_strength_set_21%~ END

  LAF cbr_create_tempus_strength_checker INT_VAR floor = 18 str_lt_row = str_lt_row str_eq_row = str_eq_row STR_VAR resource_dir = EVAL ~%resource_dir%~ checker_resref = EVAL ~%cbr_strength_check_18%~ setter_resref = EVAL ~%cbr_strength_set_18%~ exception_resref = EVAL ~%cbr_strength_exception_18%~ END
  LAF cbr_create_tempus_strength_checker INT_VAR floor = 19 str_lt_row = str_lt_row STR_VAR resource_dir = EVAL ~%resource_dir%~ checker_resref = EVAL ~%cbr_strength_check_19%~ setter_resref = EVAL ~%cbr_strength_set_19%~ END
  LAF cbr_create_tempus_strength_checker INT_VAR floor = 20 str_lt_row = str_lt_row STR_VAR resource_dir = EVAL ~%resource_dir%~ checker_resref = EVAL ~%cbr_strength_check_20%~ setter_resref = EVAL ~%cbr_strength_set_20%~ END
  LAF cbr_create_tempus_strength_checker INT_VAR floor = 21 str_lt_row = str_lt_row STR_VAR resource_dir = EVAL ~%resource_dir%~ checker_resref = EVAL ~%cbr_strength_check_21%~ setter_resref = EVAL ~%cbr_strength_set_21%~ END

  LAF cbr_create_tempus_strength_exception INT_VAR bonus_lt_row = str_bonus_lt_row STR_VAR resource_dir = EVAL ~%resource_dir%~ exception_resref = EVAL ~%cbr_strength_exception_18%~ setter_resref = EVAL ~%cbr_strength_set_18%~ END

  LAF cbr_create_tempus_strength_pulse STR_VAR resource_dir = EVAL ~%resource_dir%~ pulse_resref = EVAL ~%cbr_strength_pulse_18%~ checker_resref = EVAL ~%cbr_strength_check_18%~ END
  LAF cbr_create_tempus_strength_pulse STR_VAR resource_dir = EVAL ~%resource_dir%~ pulse_resref = EVAL ~%cbr_strength_pulse_19%~ checker_resref = EVAL ~%cbr_strength_check_19%~ END
  LAF cbr_create_tempus_strength_pulse STR_VAR resource_dir = EVAL ~%resource_dir%~ pulse_resref = EVAL ~%cbr_strength_pulse_20%~ checker_resref = EVAL ~%cbr_strength_check_20%~ END
  LAF cbr_create_tempus_strength_pulse STR_VAR resource_dir = EVAL ~%resource_dir%~ pulse_resref = EVAL ~%cbr_strength_pulse_21%~ checker_resref = EVAL ~%cbr_strength_check_21%~ END

  LAF cbr_validate_tempus_strength_helpers
    INT_VAR str_lt_row = str_lt_row str_eq_row = str_eq_row str_bonus_lt_row = str_bonus_lt_row
    STR_VAR resource_dir = EVAL ~%resource_dir%~
  END
END

DEFINE_PATCH_FUNCTION cbr_validate_tempus_divine_cleanup_graph
  STR_VAR
    divine_power_resref = ~~
    strength_set_18 = ~CBRST18~
    strength_set_19 = ~CBRST19~
    strength_set_20 = ~CBRST20~
    strength_set_21 = ~CBRST21~
  RET
    cleanup_status
BEGIN
  SET cleanup_status = "-1"
  LPF cbr_validate_spl_v1
    STR_VAR resource_name = EVAL ~resolved Divine Power %divine_power_resref%~
    RET
      cbr_divine_ability_offset = ability_offset
      cbr_divine_ability_count  = ability_count
      cbr_divine_effect_offset  = effect_offset
  END
  PATCH_IF (cbr_divine_ability_count < 1) BEGIN
    PATCH_FAIL ~CBR Divine Power %divine_power_resref% has no ability headers to protect with reciprocal cleanup.~
  END
  FOR (cbr_divine_header = 0; cbr_divine_header < cbr_divine_ability_count; ++cbr_divine_header) BEGIN
    SET cbr_divine_header_offset = cbr_divine_ability_offset + (cbr_divine_header * 0x28)
    READ_SHORT (cbr_divine_header_offset + 0x1e) cbr_divine_header_count
    READ_SHORT (cbr_divine_header_offset + 0x20) cbr_divine_header_first
    SET cbr_divine_owned_count = 0
    SET cbr_divine_owned_invalid = 0
    FOR (cbr_divine_effect = 0; cbr_divine_effect < cbr_divine_header_count; ++cbr_divine_effect) BEGIN
      SET cbr_divine_fx = cbr_divine_effect_offset + ((cbr_divine_header_first + cbr_divine_effect) * 0x30)
      READ_SHORT cbr_divine_fx cbr_divine_opcode
      READ_BYTE  (cbr_divine_fx + 0x02) cbr_divine_target
      READ_BYTE  (cbr_divine_fx + 0x03) cbr_divine_power
      READ_LONG  (cbr_divine_fx + 0x04) cbr_divine_parameter1
      READ_LONG  (cbr_divine_fx + 0x08) cbr_divine_parameter2
      READ_BYTE  (cbr_divine_fx + 0x0c) cbr_divine_timing
      READ_BYTE  (cbr_divine_fx + 0x0d) cbr_divine_dr
      READ_LONG  (cbr_divine_fx + 0x0e) cbr_divine_duration
      READ_BYTE  (cbr_divine_fx + 0x12) cbr_divine_probability1
      READ_BYTE  (cbr_divine_fx + 0x13) cbr_divine_probability2
      READ_ASCII (cbr_divine_fx + 0x14) cbr_divine_resource (8) NULL
      READ_LONG  (cbr_divine_fx + 0x1c) cbr_divine_dice_number
      READ_LONG  (cbr_divine_fx + 0x20) cbr_divine_dice_size
      READ_LONG  (cbr_divine_fx + 0x24) cbr_divine_save_type
      READ_LONG  (cbr_divine_fx + 0x28) cbr_divine_save_bonus
      READ_LONG  (cbr_divine_fx + 0x2c) cbr_divine_special
      SET cbr_divine_slot = "-1"
      SET cbr_divine_expected_p2 = 2
      PATCH_IF (~%cbr_divine_resource%~ STR_EQ ~OHTMPS1~) BEGIN
        SET cbr_divine_slot = 0
        SET cbr_divine_expected_p2 = 2
      END ELSE PATCH_IF (~%cbr_divine_resource%~ STR_EQ ~%strength_set_18%~) BEGIN
        SET cbr_divine_slot = 1
      END ELSE PATCH_IF (~%cbr_divine_resource%~ STR_EQ ~%strength_set_19%~) BEGIN
        SET cbr_divine_slot = 2
      END ELSE PATCH_IF (~%cbr_divine_resource%~ STR_EQ ~%strength_set_20%~) BEGIN
        SET cbr_divine_slot = 3
      END ELSE PATCH_IF (~%cbr_divine_resource%~ STR_EQ ~%strength_set_21%~) BEGIN
        SET cbr_divine_slot = 4
      END
      PATCH_IF (cbr_divine_opcode = 321 && cbr_divine_slot >= 0) BEGIN
        ++cbr_divine_owned_count
        PATCH_IF (cbr_divine_effect != cbr_divine_slot
               || cbr_divine_target != 1
               || cbr_divine_power != 4
               || cbr_divine_parameter1 != 0
               || cbr_divine_parameter2 != cbr_divine_expected_p2
               || cbr_divine_timing != 1
               || cbr_divine_dr != 2
               || cbr_divine_duration != 0
               || cbr_divine_probability1 != 100
               || cbr_divine_probability2 != 0
               || cbr_divine_dice_number != 0
               || cbr_divine_dice_size != 0
               || cbr_divine_save_type != 0
               || cbr_divine_save_bonus != 0
               || cbr_divine_special != 0) BEGIN
          SET cbr_divine_owned_invalid = 1
        END
      END
    END
    SET cbr_divine_header_status = 0
    PATCH_IF (cbr_divine_owned_count = 5 && !cbr_divine_owned_invalid) BEGIN
      SET cbr_divine_header_status = 1
    END ELSE PATCH_IF (cbr_divine_owned_count != 0 || cbr_divine_owned_invalid) BEGIN
      PATCH_FAIL ~CBR Divine Power %divine_power_resref% header %cbr_divine_header% has a partial, duplicated, or misordered Tempus cleanup prefix.~
    END
    PATCH_IF (cleanup_status < 0) BEGIN
      SET cleanup_status = cbr_divine_header_status
    END ELSE PATCH_IF (cleanup_status != cbr_divine_header_status) BEGIN
      PATCH_FAIL ~CBR Divine Power %divine_power_resref% mixes pristine and Tempus-cleanup headers.~
    END
  END
END

DEFINE_PATCH_FUNCTION cbr_validate_tempus_ih_bridge_graph
  INT_VAR
    ih_state            = "-1"
    apr_half_state      = "-1"
    apr_one_state       = "-1"
    apr_one_half_state  = "-1"
    active_state_row    = "-1"
  STR_VAR
    improved_haste_resref = ~~
    apr_helper_6 = ~CBRAPR6~
    apr_helper_1 = ~CBRAPR1~
    apr_helper_7 = ~CBRAPR7~
    apr_condition_6 = ~CBRAPC6~
    apr_condition_1 = ~CBRAPC1~
    apr_condition_7 = ~CBRAPC7~
  RET
    bridge_status
BEGIN
  SET bridge_status = "-1"
  LPF cbr_validate_spl_v1
    STR_VAR resource_name = EVAL ~Improved Haste %improved_haste_resref% bridge graph~
    RET
      cbr_ih_graph_ability_offset = ability_offset
      cbr_ih_graph_ability_count  = ability_count
      cbr_ih_graph_effect_offset  = effect_offset
  END
  FOR (cbr_ih_graph_header = 0; cbr_ih_graph_header < cbr_ih_graph_ability_count; ++cbr_ih_graph_header) BEGIN
    SET cbr_ih_graph_header_offset = cbr_ih_graph_ability_offset + (cbr_ih_graph_header * 0x28)
    READ_SHORT (cbr_ih_graph_header_offset + 0x1e) cbr_ih_graph_count
    READ_SHORT (cbr_ih_graph_header_offset + 0x20) cbr_ih_graph_first
    SET cbr_ih_donor_count = 0
    SET cbr_ih_owned_count = 0
    SET cbr_ih_owned_invalid = 0
    FOR (cbr_ih_graph_effect = 0; cbr_ih_graph_effect < cbr_ih_graph_count; ++cbr_ih_graph_effect) BEGIN
      SET cbr_ih_fx = cbr_ih_graph_effect_offset + ((cbr_ih_graph_first + cbr_ih_graph_effect) * 0x30)
      READ_SHORT cbr_ih_fx cbr_ih_opcode
      READ_BYTE  (cbr_ih_fx + 0x02) cbr_ih_target
      READ_BYTE  (cbr_ih_fx + 0x03) cbr_ih_power
      READ_LONG  (cbr_ih_fx + 0x04) cbr_ih_parameter1
      READ_LONG  (cbr_ih_fx + 0x08) cbr_ih_parameter2
      READ_BYTE  (cbr_ih_fx + 0x0c) cbr_ih_timing
      READ_BYTE  (cbr_ih_fx + 0x0d) cbr_ih_dr
      READ_LONG  (cbr_ih_fx + 0x0e) cbr_ih_duration
      READ_BYTE  (cbr_ih_fx + 0x12) cbr_ih_probability1
      READ_BYTE  (cbr_ih_fx + 0x13) cbr_ih_probability2
      READ_ASCII (cbr_ih_fx + 0x14) cbr_ih_resource (8) NULL
      READ_LONG  (cbr_ih_fx + 0x1c) cbr_ih_dice_number
      READ_LONG  (cbr_ih_fx + 0x20) cbr_ih_dice_size
      READ_LONG  (cbr_ih_fx + 0x24) cbr_ih_save_type
      READ_LONG  (cbr_ih_fx + 0x28) cbr_ih_save_bonus
      READ_LONG  (cbr_ih_fx + 0x2c) cbr_ih_special
      PATCH_IF (cbr_ih_opcode = 1 && cbr_ih_parameter1 = 1 && cbr_ih_parameter2 = 0) BEGIN
        ++cbr_ih_donor_count
        SET cbr_ih_donor_index = cbr_ih_graph_effect
        SET cbr_ih_donor_target = cbr_ih_target
        SET cbr_ih_donor_power = cbr_ih_power
        SET cbr_ih_donor_timing = cbr_ih_timing
        SET cbr_ih_donor_dr = cbr_ih_dr
        SET cbr_ih_donor_duration = cbr_ih_duration
        SET cbr_ih_donor_probability1 = cbr_ih_probability1
        SET cbr_ih_donor_probability2 = cbr_ih_probability2
      END
    END
    PATCH_IF (cbr_ih_donor_count != 1) BEGIN
      PATCH_FAIL ~CBR Improved Haste %improved_haste_resref% header %cbr_ih_graph_header% bridge validation found %cbr_ih_donor_count% additive APR donors.~
    END
    FOR (cbr_ih_graph_effect = 0; cbr_ih_graph_effect < cbr_ih_graph_count; ++cbr_ih_graph_effect) BEGIN
      SET cbr_ih_fx = cbr_ih_graph_effect_offset + ((cbr_ih_graph_first + cbr_ih_graph_effect) * 0x30)
      READ_SHORT cbr_ih_fx cbr_ih_opcode
      READ_BYTE  (cbr_ih_fx + 0x02) cbr_ih_target
      READ_BYTE  (cbr_ih_fx + 0x03) cbr_ih_power
      READ_LONG  (cbr_ih_fx + 0x04) cbr_ih_parameter1
      READ_LONG  (cbr_ih_fx + 0x08) cbr_ih_parameter2
      READ_BYTE  (cbr_ih_fx + 0x0c) cbr_ih_timing
      READ_BYTE  (cbr_ih_fx + 0x0d) cbr_ih_dr
      READ_LONG  (cbr_ih_fx + 0x0e) cbr_ih_duration
      READ_BYTE  (cbr_ih_fx + 0x12) cbr_ih_probability1
      READ_BYTE  (cbr_ih_fx + 0x13) cbr_ih_probability2
      READ_ASCII (cbr_ih_fx + 0x14) cbr_ih_resource (8) NULL
      READ_LONG  (cbr_ih_fx + 0x1c) cbr_ih_dice_number
      READ_LONG  (cbr_ih_fx + 0x20) cbr_ih_dice_size
      READ_LONG  (cbr_ih_fx + 0x24) cbr_ih_save_type
      READ_LONG  (cbr_ih_fx + 0x28) cbr_ih_save_bonus
      READ_LONG  (cbr_ih_fx + 0x2c) cbr_ih_special
      SET cbr_ih_owned = 0
      SET cbr_ih_expected_index = "-1"
      SET cbr_ih_expected_state = "-1"
      SPRINT cbr_ih_expected_resource ~~
      PATCH_IF (cbr_ih_opcode = 328
             && (cbr_ih_parameter2 = ih_state
              || cbr_ih_parameter2 = apr_half_state
              || cbr_ih_parameter2 = apr_one_state
              || cbr_ih_parameter2 = apr_one_half_state)) BEGIN
        SET cbr_ih_owned = 1
        SET cbr_ih_expected_index = cbr_ih_donor_index + 1
      END ELSE PATCH_IF (~%cbr_ih_resource%~ STR_EQ ~%apr_helper_6%~
                      || ~%cbr_ih_resource%~ STR_EQ ~%apr_helper_1%~
                      || ~%cbr_ih_resource%~ STR_EQ ~%apr_helper_7%~
                      || ~%cbr_ih_resource%~ STR_EQ ~%apr_condition_6%~
                      || ~%cbr_ih_resource%~ STR_EQ ~%apr_condition_1%~
                      || ~%cbr_ih_resource%~ STR_EQ ~%apr_condition_7%~) BEGIN
        SET cbr_ih_owned = 1
        PATCH_IF (cbr_ih_opcode = 326 && ~%cbr_ih_resource%~ STR_EQ ~%apr_helper_6%~) BEGIN
          SET cbr_ih_expected_index = cbr_ih_donor_index + 2
          SET cbr_ih_expected_state = apr_half_state
          SPRINT cbr_ih_expected_resource ~%apr_helper_6%~
        END ELSE PATCH_IF (cbr_ih_opcode = 326 && ~%cbr_ih_resource%~ STR_EQ ~%apr_helper_1%~) BEGIN
          SET cbr_ih_expected_index = cbr_ih_donor_index + 3
          SET cbr_ih_expected_state = apr_one_state
          SPRINT cbr_ih_expected_resource ~%apr_helper_1%~
        END ELSE PATCH_IF (cbr_ih_opcode = 326 && ~%cbr_ih_resource%~ STR_EQ ~%apr_helper_7%~) BEGIN
          SET cbr_ih_expected_index = cbr_ih_donor_index + 4
          SET cbr_ih_expected_state = apr_one_half_state
          SPRINT cbr_ih_expected_resource ~%apr_helper_7%~
        END
      END
      PATCH_IF (cbr_ih_owned) BEGIN
        ++cbr_ih_owned_count
        SET cbr_ih_common_invalid = (cbr_ih_graph_effect != cbr_ih_expected_index
                                  || cbr_ih_target != cbr_ih_donor_target
                                  || cbr_ih_power != cbr_ih_donor_power
                                  || cbr_ih_dice_number != 0
                                  || cbr_ih_dice_size != 0
                                  || cbr_ih_save_type != 0
                                  || cbr_ih_save_bonus != 0)
        PATCH_IF (cbr_ih_opcode = 328) BEGIN
          PATCH_IF (cbr_ih_common_invalid
                 || cbr_ih_parameter1 != 0
                 || cbr_ih_parameter2 != ih_state
                 || cbr_ih_timing != cbr_ih_donor_timing
                 || cbr_ih_dr != cbr_ih_donor_dr
                 || cbr_ih_duration != cbr_ih_donor_duration
                 || cbr_ih_probability1 != cbr_ih_donor_probability1
                 || cbr_ih_probability2 != cbr_ih_donor_probability2
                 || !(~%cbr_ih_resource%~ STR_EQ ~~)
                 || cbr_ih_special != 1) BEGIN
            SET cbr_ih_owned_invalid = 1
          END
        END ELSE BEGIN
          PATCH_IF (cbr_ih_common_invalid
                 || cbr_ih_expected_state < 0
                 || cbr_ih_parameter1 != cbr_ih_expected_state
                 || cbr_ih_parameter2 != active_state_row
                 || cbr_ih_timing != 1
                 || cbr_ih_dr != 2
                 || cbr_ih_duration != 0
                 || cbr_ih_probability1 != 100
                 || cbr_ih_probability2 != 0
                 || !(~%cbr_ih_resource%~ STR_EQ ~%cbr_ih_expected_resource%~)
                 || cbr_ih_special != 0) BEGIN
            SET cbr_ih_owned_invalid = 1
          END
        END
      END
    END
    SET cbr_ih_header_status = 0
    PATCH_IF (cbr_ih_owned_count = 4 && !cbr_ih_owned_invalid) BEGIN
      SET cbr_ih_header_status = 1
    END ELSE PATCH_IF (cbr_ih_owned_count != 0 || cbr_ih_owned_invalid) BEGIN
      PATCH_FAIL ~CBR Improved Haste %improved_haste_resref% header %cbr_ih_graph_header% has a partial, malformed, or misplaced Tempus APR bridge.~
    END
    PATCH_IF (bridge_status < 0) BEGIN
      SET bridge_status = cbr_ih_header_status
    END ELSE PATCH_IF (bridge_status != cbr_ih_header_status) BEGIN
      PATCH_FAIL ~CBR Improved Haste %improved_haste_resref% mixes pristine and bridged headers.~
    END
  END
END

DEFINE_PATCH_FUNCTION cbr_validate_tempus_holy_bridge_graph
  INT_VAR
    ih_state            = "-1"
    apr_half_state      = "-1"
    apr_one_state       = "-1"
    apr_one_half_state  = "-1"
    active_state_row    = "-1"
  STR_VAR
    apr_helper_6 = ~CBRAPR6~
    apr_helper_1 = ~CBRAPR1~
    apr_helper_7 = ~CBRAPR7~
    apr_condition_6 = ~CBRAPC6~
    apr_condition_1 = ~CBRAPC1~
    apr_condition_7 = ~CBRAPC7~
  RET
    bridge_status
BEGIN
  SET bridge_status = 0
  LPF cbr_validate_spl_v1
    STR_VAR resource_name = ~OHTMPS1 Holy APR bridge graph~
    RET
      cbr_holy_graph_ability_offset = ability_offset
      cbr_holy_graph_ability_count  = ability_count
      cbr_holy_graph_effect_offset  = effect_offset
  END
  SET cbr_holy_tier_status = "-1"
  FOR (cbr_holy_graph_header = 0; cbr_holy_graph_header < cbr_holy_graph_ability_count; ++cbr_holy_graph_header) BEGIN
    SET cbr_holy_level = cbr_holy_graph_header + 1
    SET cbr_holy_graph_header_offset = cbr_holy_graph_ability_offset + (cbr_holy_graph_header * 0x28)
    READ_SHORT (cbr_holy_graph_header_offset + 0x1e) cbr_holy_graph_count
    READ_SHORT (cbr_holy_graph_header_offset + 0x20) cbr_holy_graph_first
    PATCH_IF (cbr_holy_level <= 6) BEGIN
      SET cbr_holy_expected_state = "-1"
      SPRINT cbr_holy_expected_helper ~~
      SPRINT cbr_holy_expected_condition ~~
      SET cbr_holy_duration = 18
    END ELSE PATCH_IF (cbr_holy_level <= 12) BEGIN
      SET cbr_holy_expected_state = apr_half_state
      SPRINT cbr_holy_expected_helper ~%apr_helper_6%~
      SPRINT cbr_holy_expected_condition ~%apr_condition_6%~
      SET cbr_holy_duration = 24
    END ELSE PATCH_IF (cbr_holy_level <= 24) BEGIN
      SET cbr_holy_expected_state = apr_one_state
      SPRINT cbr_holy_expected_helper ~%apr_helper_1%~
      SPRINT cbr_holy_expected_condition ~%apr_condition_1%~
      SET cbr_holy_duration = 30
    END ELSE BEGIN
      SET cbr_holy_expected_state = apr_one_half_state
      SPRINT cbr_holy_expected_helper ~%apr_helper_7%~
      SPRINT cbr_holy_expected_condition ~%apr_condition_7%~
      SET cbr_holy_duration = 30
    END
    SET cbr_holy_owned_count = 0
    SET cbr_holy_owned_invalid = 0
    FOR (cbr_holy_graph_effect = 0; cbr_holy_graph_effect < cbr_holy_graph_count; ++cbr_holy_graph_effect) BEGIN
      SET cbr_holy_fx = cbr_holy_graph_effect_offset + ((cbr_holy_graph_first + cbr_holy_graph_effect) * 0x30)
      READ_SHORT cbr_holy_fx cbr_holy_opcode
      READ_BYTE  (cbr_holy_fx + 0x02) cbr_holy_target
      READ_BYTE  (cbr_holy_fx + 0x03) cbr_holy_power
      READ_LONG  (cbr_holy_fx + 0x04) cbr_holy_parameter1
      READ_LONG  (cbr_holy_fx + 0x08) cbr_holy_parameter2
      READ_BYTE  (cbr_holy_fx + 0x0c) cbr_holy_timing
      READ_BYTE  (cbr_holy_fx + 0x0d) cbr_holy_dr
      READ_LONG  (cbr_holy_fx + 0x0e) cbr_holy_effect_duration
      READ_BYTE  (cbr_holy_fx + 0x12) cbr_holy_probability1
      READ_BYTE  (cbr_holy_fx + 0x13) cbr_holy_probability2
      READ_ASCII (cbr_holy_fx + 0x14) cbr_holy_resource (8) NULL
      READ_LONG  (cbr_holy_fx + 0x1c) cbr_holy_dice_number
      READ_LONG  (cbr_holy_fx + 0x20) cbr_holy_dice_size
      READ_LONG  (cbr_holy_fx + 0x24) cbr_holy_save_type
      READ_LONG  (cbr_holy_fx + 0x28) cbr_holy_save_bonus
      READ_LONG  (cbr_holy_fx + 0x2c) cbr_holy_special
      SET cbr_holy_owned = 0
      PATCH_IF (cbr_holy_opcode = 328
             && (cbr_holy_parameter2 = ih_state
              || cbr_holy_parameter2 = apr_half_state
              || cbr_holy_parameter2 = apr_one_state
              || cbr_holy_parameter2 = apr_one_half_state)) BEGIN
        SET cbr_holy_owned = 1
      END ELSE PATCH_IF (~%cbr_holy_resource%~ STR_EQ ~%apr_helper_6%~
                      || ~%cbr_holy_resource%~ STR_EQ ~%apr_helper_1%~
                      || ~%cbr_holy_resource%~ STR_EQ ~%apr_helper_7%~
                      || ~%cbr_holy_resource%~ STR_EQ ~%apr_condition_6%~
                      || ~%cbr_holy_resource%~ STR_EQ ~%apr_condition_1%~
                      || ~%cbr_holy_resource%~ STR_EQ ~%apr_condition_7%~) BEGIN
        SET cbr_holy_owned = 1
      END
      PATCH_IF (cbr_holy_owned) BEGIN
        ++cbr_holy_owned_count
        SET cbr_holy_common_invalid = (cbr_holy_target != 1
                                    || cbr_holy_power != 4
                                    || cbr_holy_probability1 != 100
                                    || cbr_holy_probability2 != 0
                                    || cbr_holy_dice_number != 0
                                    || cbr_holy_dice_size != 0
                                    || cbr_holy_save_type != 0
                                    || cbr_holy_save_bonus != 0)
        PATCH_IF (cbr_holy_graph_effect = (cbr_holy_graph_count - 7)) BEGIN
          PATCH_IF (cbr_holy_common_invalid
                 || cbr_holy_opcode != 328
                 || cbr_holy_parameter1 != 0
                 || cbr_holy_parameter2 != cbr_holy_expected_state
                 || cbr_holy_timing != 0
                 || cbr_holy_dr != 3
                 || cbr_holy_effect_duration != cbr_holy_duration
                 || !(~%cbr_holy_resource%~ STR_EQ ~~)
                 || cbr_holy_special != 1) BEGIN
            SET cbr_holy_owned_invalid = 1
          END
        END ELSE PATCH_IF (cbr_holy_graph_effect = (cbr_holy_graph_count - 6)) BEGIN
          PATCH_IF (cbr_holy_common_invalid
                 || cbr_holy_opcode != 326
                 || cbr_holy_parameter1 != ih_state
                 || cbr_holy_parameter2 != active_state_row
                 || cbr_holy_timing != 1
                 || cbr_holy_dr != 2
                 || cbr_holy_effect_duration != 0
                 || !(~%cbr_holy_resource%~ STR_EQ ~%cbr_holy_expected_helper%~)
                 || cbr_holy_special != 0) BEGIN
            SET cbr_holy_owned_invalid = 1
          END
        END ELSE PATCH_IF (cbr_holy_graph_effect = (cbr_holy_graph_count - 5)) BEGIN
          PATCH_IF (cbr_holy_common_invalid
                 || cbr_holy_opcode != 272
                 || cbr_holy_parameter1 != 1
                 || cbr_holy_parameter2 != 3
                 || cbr_holy_timing != 0
                 || cbr_holy_dr != 3
                 || cbr_holy_effect_duration != cbr_holy_duration
                 || !(~%cbr_holy_resource%~ STR_EQ ~%cbr_holy_expected_condition%~)
                 || cbr_holy_special != 0) BEGIN
            SET cbr_holy_owned_invalid = 1
          END
        END ELSE BEGIN
          SET cbr_holy_owned_invalid = 1
        END
      END
    END
    PATCH_IF (cbr_holy_expected_state < 0) BEGIN
      PATCH_IF (cbr_holy_owned_count != 0 || cbr_holy_owned_invalid) BEGIN
        PATCH_FAIL ~CBR OHTMPS1 level %cbr_holy_level% must not contain an APR bridge below level 7.~
      END
    END ELSE BEGIN
      SET cbr_holy_header_status = 0
      PATCH_IF (cbr_holy_owned_count = 3 && !cbr_holy_owned_invalid) BEGIN
        SET cbr_holy_header_status = 1
      END ELSE PATCH_IF (cbr_holy_owned_count != 0 || cbr_holy_owned_invalid) BEGIN
        PATCH_FAIL ~CBR OHTMPS1 level %cbr_holy_level% has a partial, malformed, or misplaced APR bridge.~
      END
      PATCH_IF (cbr_holy_tier_status < 0) BEGIN
        SET cbr_holy_tier_status = cbr_holy_header_status
      END ELSE PATCH_IF (cbr_holy_tier_status != cbr_holy_header_status) BEGIN
        PATCH_FAIL ~CBR OHTMPS1 mixes pristine and bridged APR-tier headers.~
      END
    END
  END
  PATCH_IF (cbr_holy_tier_status >= 0) BEGIN
    SET bridge_status = cbr_holy_tier_status
  END
END

DEFINE_PATCH_FUNCTION cbr_reject_tempus_apr_artifacts
  STR_VAR
    resource_name = ~unknown SPL~
    apr_helper_6 = ~CBRAPR6~
    apr_helper_1 = ~CBRAPR1~
    apr_helper_7 = ~CBRAPR7~
    apr_condition_6 = ~CBRAPC6~
    apr_condition_1 = ~CBRAPC1~
    apr_condition_7 = ~CBRAPC7~
BEGIN
  LPF cbr_validate_spl_v1
    STR_VAR resource_name = EVAL ~%resource_name% no-bridge scan~
    RET
      cbr_no_bridge_effect_offset = effect_offset
      cbr_no_bridge_effect_count = effect_count
  END
  FOR (cbr_no_bridge_effect = 0; cbr_no_bridge_effect < cbr_no_bridge_effect_count; ++cbr_no_bridge_effect) BEGIN
    SET cbr_no_bridge_fx = cbr_no_bridge_effect_offset + (cbr_no_bridge_effect * 0x30)
    READ_ASCII (cbr_no_bridge_fx + 0x14) cbr_no_bridge_resource (8) NULL
    PATCH_IF (~%cbr_no_bridge_resource%~ STR_EQ ~%apr_helper_6%~
           || ~%cbr_no_bridge_resource%~ STR_EQ ~%apr_helper_1%~
           || ~%cbr_no_bridge_resource%~ STR_EQ ~%apr_helper_7%~
           || ~%cbr_no_bridge_resource%~ STR_EQ ~%apr_condition_6%~
           || ~%cbr_no_bridge_resource%~ STR_EQ ~%apr_condition_1%~
           || ~%cbr_no_bridge_resource%~ STR_EQ ~%apr_condition_7%~) BEGIN
      PATCH_FAIL ~CBR Tempus APR bridge collision: true-doubling resource %resource_name% retains dangling reserved bridge reference %cbr_no_bridge_resource% at effect %cbr_no_bridge_effect%.~
    END
  END
END

DEFINE_PATCH_FUNCTION cbr_reject_tempus_private_splstates
BEGIN
  SET cbr_private_state_rows = 0
  SET cbr_private_ids_length = BUFFER_LENGTH
  READ_ASCII 0 cbr_private_ids_contents (cbr_private_ids_length)
  INNER_PATCH ~%cbr_private_ids_contents%~ BEGIN
    REPLACE_EVALUATE CASE_INSENSITIVE
      ~^[ %TAB%]*\([^ %TAB%%WNL%%MNL%%LNL%]+\)[ %TAB%]+\([^ %TAB%%WNL%%MNL%%LNL%]+\)~
    BEGIN
      PATCH_IF (IS_AN_INT ~%MATCH1%~) BEGIN
        SPRINT cbr_private_symbol ~%MATCH2%~
        TO_UPPER cbr_private_symbol
        PATCH_IF (~%cbr_private_symbol%~ STR_EQ ~CBR_TEMPUS_IH~
               || ~%cbr_private_symbol%~ STR_EQ ~CBR_TEMPUS_APR_HALF~
               || ~%cbr_private_symbol%~ STR_EQ ~CBR_TEMPUS_APR_ONE~
               || ~%cbr_private_symbol%~ STR_EQ ~CBR_TEMPUS_APR_ONE_HALF~) BEGIN
          ++cbr_private_state_rows
        END
      END
    END
      ~~
  END
  PATCH_IF (cbr_private_state_rows != 0) BEGIN
    PATCH_FAIL ~CBR Tempus APR bridge collision: true-doubling mode found %cbr_private_state_rows% private CBR_TEMPUS spell-state rows.~
  END
END

DEFINE_ACTION_FUNCTION cbr_create_tempus_apr_helper
  INT_VAR
    apr_key = 0
  STR_VAR
    resource_dir = ~~
    helper_resref = ~~
BEGIN
  OUTER_SPRINT resource_dir EVALUATE_BUFFER ~%resource_dir%~
  OUTER_SPRINT helper_resref EVALUATE_BUFFER ~%helper_resref%~
  CREATE SPL ~%helper_resref%~
    LPF cbr_add_basic_self_ability END
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 321 target = 1 power = 4 parameter2 = 2 timing = 1 resist_dispel = 2
      STR_VAR resource = EVAL ~%helper_resref%~
    END
    LPF cbr_append_spl_effect_record
      INT_VAR opcode = 1 target = 1 power = 4 parameter1 = apr_key parameter2 = 0 timing = 0 resist_dispel = 2 duration = 1
    END
    WRITE_SHORT 0x90 2
  ACTION_IF !(~%resource_dir%~ STR_EQ ~override~) BEGIN
    ACTION_IF !(FILE_EXISTS ~%resource_dir%/%helper_resref%.spl~) BEGIN
      MOVE ~override/%helper_resref%.spl~ ~%resource_dir%/%helper_resref%.spl~
    END
  END
END

DEFINE_ACTION_FUNCTION cbr_create_tempus_apr_condition
  INT_VAR
    ih_state          = "-1"
    active_state_row = "-1"
  STR_VAR
    resource_dir    = ~~
    condition_resref = ~~
    helper_resref   = ~~
BEGIN
  OUTER_SPRINT resource_dir EVALUATE_BUFFER ~%resource_dir%~
  OUTER_SPRINT condition_resref EVALUATE_BUFFER ~%condition_resref%~
  OUTER_SPRINT helper_resref EVALUATE_BUFFER ~%helper_resref%~
  CREATE EFF ~%condition_resref%~
    FOR (cbr_apr_create_byte = 0x10; cbr_apr_create_byte < 0x110; ++cbr_apr_create_byte) BEGIN
      WRITE_BYTE cbr_apr_create_byte 0
    END
    WRITE_LONG 0x10 326
    WRITE_LONG 0x14 2
    WRITE_LONG 0x18 4
    WRITE_LONG 0x1c ih_state
    WRITE_LONG 0x20 active_state_row
    WRITE_LONG 0x24 1
    WRITE_LONG 0x28 0
    WRITE_SHORT 0x2c 100
    WRITE_SHORT 0x2e 0
    WRITE_ASCIIE 0x30 ~%helper_resref%~ #8
    WRITE_LONG 0x5c 2
  ACTION_IF !(~%resource_dir%~ STR_EQ ~override~) BEGIN
    ACTION_IF !(FILE_EXISTS ~%resource_dir%/%condition_resref%.eff~) BEGIN
      MOVE ~override/%condition_resref%.eff~ ~%resource_dir%/%condition_resref%.eff~
    END
  END
END

DEFINE_ACTION_FUNCTION cbr_create_tempus_apr_helpers
  INT_VAR
    ih_state          = "-1"
    active_state_row = "-1"
  STR_VAR
    resource_dir = ~~
BEGIN
  OUTER_SPRINT resource_dir EVALUATE_BUFFER ~%resource_dir%~
  LAF cbr_define_tempus_private_resrefs
    RET
      cbr_apr_helper_6
      cbr_apr_helper_1
      cbr_apr_helper_7
      cbr_apr_condition_6
      cbr_apr_condition_1
      cbr_apr_condition_7
  END
  LAF cbr_create_tempus_apr_helper INT_VAR apr_key = 6 STR_VAR resource_dir = EVAL ~%resource_dir%~ helper_resref = EVAL ~%cbr_apr_helper_6%~ END
  LAF cbr_create_tempus_apr_helper INT_VAR apr_key = 1 STR_VAR resource_dir = EVAL ~%resource_dir%~ helper_resref = EVAL ~%cbr_apr_helper_1%~ END
  LAF cbr_create_tempus_apr_helper INT_VAR apr_key = 7 STR_VAR resource_dir = EVAL ~%resource_dir%~ helper_resref = EVAL ~%cbr_apr_helper_7%~ END
  LAF cbr_create_tempus_apr_condition INT_VAR ih_state = ih_state active_state_row = active_state_row STR_VAR resource_dir = EVAL ~%resource_dir%~ condition_resref = EVAL ~%cbr_apr_condition_6%~ helper_resref = EVAL ~%cbr_apr_helper_6%~ END
  LAF cbr_create_tempus_apr_condition INT_VAR ih_state = ih_state active_state_row = active_state_row STR_VAR resource_dir = EVAL ~%resource_dir%~ condition_resref = EVAL ~%cbr_apr_condition_1%~ helper_resref = EVAL ~%cbr_apr_helper_1%~ END
  LAF cbr_create_tempus_apr_condition INT_VAR ih_state = ih_state active_state_row = active_state_row STR_VAR resource_dir = EVAL ~%resource_dir%~ condition_resref = EVAL ~%cbr_apr_condition_7%~ helper_resref = EVAL ~%cbr_apr_helper_7%~ END
  LAF cbr_validate_tempus_apr_helpers
    INT_VAR ih_state = ih_state active_state_row = active_state_row
    STR_VAR resource_dir = EVAL ~%resource_dir%~
  END
END

DEFINE_PATCH_FUNCTION cbr_build_tempus_ih_bridge
  INT_VAR
    ih_state            = "-1"
    apr_half_state      = "-1"
    apr_one_state       = "-1"
    apr_one_half_state  = "-1"
    active_state_row    = "-1"
  STR_VAR
    improved_haste_resref = ~~
    apr_helper_6 = ~CBRAPR6~
    apr_helper_1 = ~CBRAPR1~
    apr_helper_7 = ~CBRAPR7~
BEGIN
  LPF cbr_validate_spl_v1
    STR_VAR resource_name = EVAL ~Improved Haste %improved_haste_resref% bridge source~
    RET
      cbr_ih_build_ability_offset = ability_offset
      cbr_ih_build_ability_count  = ability_count
      cbr_ih_build_effect_offset  = effect_offset
      cbr_ih_build_effect_count   = effect_count
  END
  SET cbr_ih_build_old_bytes = cbr_ih_build_effect_count * 0x30
  READ_SHORT 0x6e cbr_ih_build_casting_first
  READ_SHORT 0x70 cbr_ih_build_casting_count
  SET cbr_ih_build_new_index = 0
  FOR (cbr_ih_build_casting = 0; cbr_ih_build_casting < cbr_ih_build_casting_count; ++cbr_ih_build_casting) BEGIN
    SET cbr_ih_build_source = cbr_ih_build_effect_offset + ((cbr_ih_build_casting_first + cbr_ih_build_casting) * 0x30)
    LPF cbr_append_raw_spl_effect_record INT_VAR source_offset = cbr_ih_build_source END
    ++cbr_ih_build_new_index
  END
  WRITE_SHORT 0x6e 0
  FOR (cbr_ih_build_header = 0; cbr_ih_build_header < cbr_ih_build_ability_count; ++cbr_ih_build_header) BEGIN
    SET cbr_ih_build_header_offset = cbr_ih_build_ability_offset + (cbr_ih_build_header * 0x28)
    READ_SHORT (cbr_ih_build_header_offset + 0x1e) cbr_ih_build_source_count
    READ_SHORT (cbr_ih_build_header_offset + 0x20) cbr_ih_build_source_first
    SET cbr_ih_build_new_first = cbr_ih_build_new_index
    WRITE_SHORT (cbr_ih_build_header_offset + 0x20) cbr_ih_build_new_first
    FOR (cbr_ih_build_effect = 0; cbr_ih_build_effect < cbr_ih_build_source_count; ++cbr_ih_build_effect) BEGIN
      SET cbr_ih_build_source = cbr_ih_build_effect_offset + ((cbr_ih_build_source_first + cbr_ih_build_effect) * 0x30)
      READ_SHORT cbr_ih_build_source cbr_ih_build_opcode
      READ_BYTE  (cbr_ih_build_source + 0x02) cbr_ih_build_target
      READ_BYTE  (cbr_ih_build_source + 0x03) cbr_ih_build_power
      READ_LONG  (cbr_ih_build_source + 0x04) cbr_ih_build_parameter1
      READ_LONG  (cbr_ih_build_source + 0x08) cbr_ih_build_parameter2
      READ_BYTE  (cbr_ih_build_source + 0x0c) cbr_ih_build_timing
      READ_BYTE  (cbr_ih_build_source + 0x0d) cbr_ih_build_dr
      READ_LONG  (cbr_ih_build_source + 0x0e) cbr_ih_build_duration
      READ_BYTE  (cbr_ih_build_source + 0x12) cbr_ih_build_probability1
      READ_BYTE  (cbr_ih_build_source + 0x13) cbr_ih_build_probability2
      LPF cbr_append_raw_spl_effect_record INT_VAR source_offset = cbr_ih_build_source END
      ++cbr_ih_build_new_index
      PATCH_IF (cbr_ih_build_opcode = 1 && cbr_ih_build_parameter1 = 1 && cbr_ih_build_parameter2 = 0) BEGIN
        // Keep delivery identical to the matched APR donor and insert before
        // later same-resource opcode-206 immunities in the live SR spell.
        LPF cbr_append_spl_effect_record
          INT_VAR opcode = 328 target = cbr_ih_build_target power = cbr_ih_build_power parameter1 = 0 parameter2 = ih_state timing = cbr_ih_build_timing resist_dispel = cbr_ih_build_dr duration = cbr_ih_build_duration probability1 = cbr_ih_build_probability1 probability2 = cbr_ih_build_probability2 special = 1
        END
        ++cbr_ih_build_new_index
        LPF cbr_append_spl_effect_record
          INT_VAR opcode = 326 target = cbr_ih_build_target power = cbr_ih_build_power parameter1 = apr_half_state parameter2 = active_state_row timing = 1 resist_dispel = 2
          STR_VAR resource = EVAL ~%apr_helper_6%~
        END
        ++cbr_ih_build_new_index
        LPF cbr_append_spl_effect_record
          INT_VAR opcode = 326 target = cbr_ih_build_target power = cbr_ih_build_power parameter1 = apr_one_state parameter2 = active_state_row timing = 1 resist_dispel = 2
          STR_VAR resource = EVAL ~%apr_helper_1%~
        END
        ++cbr_ih_build_new_index
        LPF cbr_append_spl_effect_record
          INT_VAR opcode = 326 target = cbr_ih_build_target power = cbr_ih_build_power parameter1 = apr_one_half_state parameter2 = active_state_row timing = 1 resist_dispel = 2
          STR_VAR resource = EVAL ~%apr_helper_7%~
        END
        ++cbr_ih_build_new_index
      END
    END
    SET cbr_ih_build_new_count = cbr_ih_build_new_index - cbr_ih_build_new_first
    WRITE_SHORT (cbr_ih_build_header_offset + 0x1e) cbr_ih_build_new_count
  END
  DELETE_BYTES cbr_ih_build_effect_offset cbr_ih_build_old_bytes
  WRITE_LONG 0x6a cbr_ih_build_effect_offset
END

DEFINE_PATCH_FUNCTION cbr_build_tempus_holy_bridge
  INT_VAR
    ih_state            = "-1"
    apr_half_state      = "-1"
    apr_one_state       = "-1"
    apr_one_half_state  = "-1"
    active_state_row    = "-1"
  STR_VAR
    apr_helper_6 = ~CBRAPR6~
    apr_helper_1 = ~CBRAPR1~
    apr_helper_7 = ~CBRAPR7~
    apr_condition_6 = ~CBRAPC6~
    apr_condition_1 = ~CBRAPC1~
    apr_condition_7 = ~CBRAPC7~
BEGIN
  LPF cbr_validate_spl_v1
    STR_VAR resource_name = ~OHTMPS1 Holy APR bridge source~
    RET
      cbr_holy_build_ability_offset = ability_offset
      cbr_holy_build_ability_count  = ability_count
      cbr_holy_build_effect_offset  = effect_offset
      cbr_holy_build_effect_count   = effect_count
  END
  PATCH_IF (cbr_holy_build_ability_count != 30) BEGIN
    PATCH_FAIL ~CBR Holy APR bridge builder requires the canonical 30-header progression.~
  END
  SET cbr_holy_build_old_bytes = cbr_holy_build_effect_count * 0x30
  READ_SHORT 0x6e cbr_holy_build_casting_first
  READ_SHORT 0x70 cbr_holy_build_casting_count
  SET cbr_holy_build_new_index = 0
  FOR (cbr_holy_build_casting = 0; cbr_holy_build_casting < cbr_holy_build_casting_count; ++cbr_holy_build_casting) BEGIN
    SET cbr_holy_build_source = cbr_holy_build_effect_offset + ((cbr_holy_build_casting_first + cbr_holy_build_casting) * 0x30)
    LPF cbr_append_raw_spl_effect_record INT_VAR source_offset = cbr_holy_build_source END
    ++cbr_holy_build_new_index
  END
  WRITE_SHORT 0x6e 0
  FOR (cbr_holy_build_header = 0; cbr_holy_build_header < 30; ++cbr_holy_build_header) BEGIN
    SET cbr_holy_build_level = cbr_holy_build_header + 1
    SET cbr_holy_build_header_offset = cbr_holy_build_ability_offset + (cbr_holy_build_header * 0x28)
    READ_SHORT (cbr_holy_build_header_offset + 0x1e) cbr_holy_build_source_count
    READ_SHORT (cbr_holy_build_header_offset + 0x20) cbr_holy_build_source_first
    SET cbr_holy_build_new_first = cbr_holy_build_new_index
    WRITE_SHORT (cbr_holy_build_header_offset + 0x20) cbr_holy_build_new_first
    PATCH_IF (cbr_holy_build_level <= 6) BEGIN
      SET cbr_holy_build_state = "-1"
      SET cbr_holy_build_duration = 18
    END ELSE PATCH_IF (cbr_holy_build_level <= 12) BEGIN
      SET cbr_holy_build_state = apr_half_state
      SET cbr_holy_build_duration = 24
      SPRINT cbr_holy_build_helper ~%apr_helper_6%~
      SPRINT cbr_holy_build_condition ~%apr_condition_6%~
    END ELSE PATCH_IF (cbr_holy_build_level <= 24) BEGIN
      SET cbr_holy_build_state = apr_one_state
      SET cbr_holy_build_duration = 30
      SPRINT cbr_holy_build_helper ~%apr_helper_1%~
      SPRINT cbr_holy_build_condition ~%apr_condition_1%~
    END ELSE BEGIN
      SET cbr_holy_build_state = apr_one_half_state
      SET cbr_holy_build_duration = 30
      SPRINT cbr_holy_build_helper ~%apr_helper_7%~
      SPRINT cbr_holy_build_condition ~%apr_condition_7%~
    END
    FOR (cbr_holy_build_effect = 0; cbr_holy_build_effect < cbr_holy_build_source_count; ++cbr_holy_build_effect) BEGIN
      PATCH_IF (cbr_holy_build_state >= 0 && cbr_holy_build_effect = (cbr_holy_build_source_count - 4)) BEGIN
        LPF cbr_append_spl_effect_record
          INT_VAR opcode = 328 target = 1 power = 4 parameter1 = 0 parameter2 = cbr_holy_build_state timing = 0 resist_dispel = 3 duration = cbr_holy_build_duration special = 1
        END
        ++cbr_holy_build_new_index
        LPF cbr_append_spl_effect_record
          INT_VAR opcode = 326 target = 1 power = 4 parameter1 = ih_state parameter2 = active_state_row timing = 1 resist_dispel = 2
          STR_VAR resource = EVAL ~%cbr_holy_build_helper%~
        END
        ++cbr_holy_build_new_index
        LPF cbr_append_spl_effect_record
          INT_VAR opcode = 272 target = 1 power = 4 parameter1 = 1 parameter2 = 3 timing = 0 resist_dispel = 3 duration = cbr_holy_build_duration
          STR_VAR resource = EVAL ~%cbr_holy_build_condition%~
        END
        ++cbr_holy_build_new_index
      END
      SET cbr_holy_build_source = cbr_holy_build_effect_offset + ((cbr_holy_build_source_first + cbr_holy_build_effect) * 0x30)
      LPF cbr_append_raw_spl_effect_record INT_VAR source_offset = cbr_holy_build_source END
      ++cbr_holy_build_new_index
    END
    SET cbr_holy_build_new_count = cbr_holy_build_new_index - cbr_holy_build_new_first
    WRITE_SHORT (cbr_holy_build_header_offset + 0x1e) cbr_holy_build_new_count
  END
  DELETE_BYTES cbr_holy_build_effect_offset cbr_holy_build_old_bytes
  WRITE_LONG 0x6a cbr_holy_build_effect_offset
END

DEFINE_PATCH_FUNCTION cbr_build_tempus_divine_cleanup
  STR_VAR
    divine_power_resref = ~~
    strength_set_18 = ~CBRST18~
    strength_set_19 = ~CBRST19~
    strength_set_20 = ~CBRST20~
    strength_set_21 = ~CBRST21~
BEGIN
  LPF cbr_validate_spl_v1
    STR_VAR resource_name = EVAL ~Divine Power %divine_power_resref% cleanup source~
    RET
      cbr_divine_build_ability_offset = ability_offset
      cbr_divine_build_ability_count  = ability_count
      cbr_divine_build_effect_offset  = effect_offset
      cbr_divine_build_effect_count   = effect_count
  END
  SET cbr_divine_build_old_bytes = cbr_divine_build_effect_count * 0x30
  READ_SHORT 0x6e cbr_divine_build_casting_first
  READ_SHORT 0x70 cbr_divine_build_casting_count
  SET cbr_divine_build_new_index = 0
  FOR (cbr_divine_build_casting = 0; cbr_divine_build_casting < cbr_divine_build_casting_count; ++cbr_divine_build_casting) BEGIN
    SET cbr_divine_build_source = cbr_divine_build_effect_offset + ((cbr_divine_build_casting_first + cbr_divine_build_casting) * 0x30)
    LPF cbr_append_raw_spl_effect_record INT_VAR source_offset = cbr_divine_build_source END
    ++cbr_divine_build_new_index
  END
  WRITE_SHORT 0x6e 0
  FOR (cbr_divine_build_header = 0; cbr_divine_build_header < cbr_divine_build_ability_count; ++cbr_divine_build_header) BEGIN
    SET cbr_divine_build_header_offset = cbr_divine_build_ability_offset + (cbr_divine_build_header * 0x28)
    READ_SHORT (cbr_divine_build_header_offset + 0x1e) cbr_divine_build_source_count
    READ_SHORT (cbr_divine_build_header_offset + 0x20) cbr_divine_build_source_first
    SET cbr_divine_build_new_first = cbr_divine_build_new_index
    WRITE_SHORT (cbr_divine_build_header_offset + 0x20) cbr_divine_build_new_first
    LPF cbr_append_spl_effect_record INT_VAR opcode = 321 target = 1 power = 4 parameter2 = 2 timing = 1 resist_dispel = 2 STR_VAR resource = ~OHTMPS1~ END
    ++cbr_divine_build_new_index
    LPF cbr_append_spl_effect_record INT_VAR opcode = 321 target = 1 power = 4 parameter2 = 2 timing = 1 resist_dispel = 2 STR_VAR resource = EVAL ~%strength_set_18%~ END
    ++cbr_divine_build_new_index
    LPF cbr_append_spl_effect_record INT_VAR opcode = 321 target = 1 power = 4 parameter2 = 2 timing = 1 resist_dispel = 2 STR_VAR resource = EVAL ~%strength_set_19%~ END
    ++cbr_divine_build_new_index
    LPF cbr_append_spl_effect_record INT_VAR opcode = 321 target = 1 power = 4 parameter2 = 2 timing = 1 resist_dispel = 2 STR_VAR resource = EVAL ~%strength_set_20%~ END
    ++cbr_divine_build_new_index
    LPF cbr_append_spl_effect_record INT_VAR opcode = 321 target = 1 power = 4 parameter2 = 2 timing = 1 resist_dispel = 2 STR_VAR resource = EVAL ~%strength_set_21%~ END
    ++cbr_divine_build_new_index
    FOR (cbr_divine_build_effect = 0; cbr_divine_build_effect < cbr_divine_build_source_count; ++cbr_divine_build_effect) BEGIN
      SET cbr_divine_build_source = cbr_divine_build_effect_offset + ((cbr_divine_build_source_first + cbr_divine_build_effect) * 0x30)
      LPF cbr_append_raw_spl_effect_record INT_VAR source_offset = cbr_divine_build_source END
      ++cbr_divine_build_new_index
    END
    SET cbr_divine_build_new_count = cbr_divine_build_new_index - cbr_divine_build_new_first
    WRITE_SHORT (cbr_divine_build_header_offset + 0x1e) cbr_divine_build_new_count
  END
  DELETE_BYTES cbr_divine_build_effect_offset cbr_divine_build_old_bytes
  WRITE_LONG 0x6a cbr_divine_build_effect_offset
END

DEFINE_ACTION_FUNCTION cbr_apply_tempus_bridge
  INT_VAR
    bridge_status        = 0
    divine_cleanup_status = 0
    ih_state            = "-1"
    apr_half_state      = "-1"
    apr_one_state       = "-1"
    apr_one_half_state  = "-1"
    active_state_row    = "-1"
  STR_VAR
    resource_dir             = ~~
    improved_haste_semantics = ~~
    improved_haste_resref    = ~~
    divine_power_resref      = ~~
BEGIN
  OUTER_SPRINT resource_dir EVALUATE_BUFFER ~%resource_dir%~
  OUTER_SPRINT improved_haste_semantics EVALUATE_BUFFER ~%improved_haste_semantics%~
  OUTER_SPRINT improved_haste_resref EVALUATE_BUFFER ~%improved_haste_resref%~
  OUTER_SPRINT divine_power_resref EVALUATE_BUFFER ~%divine_power_resref%~
  OUTER_SPRINT cbr_bridge_holy_path ~%resource_dir%/OHTMPS1.SPL~
  OUTER_SPRINT cbr_bridge_ih_path ~%resource_dir%/%improved_haste_resref%.SPL~
  OUTER_SPRINT cbr_bridge_divine_path ~%resource_dir%/%divine_power_resref%.SPL~
  LAF cbr_define_tempus_private_resrefs
    RET
      cbr_apr_helper_6
      cbr_apr_helper_1
      cbr_apr_helper_7
      cbr_apr_condition_6
      cbr_apr_condition_1
      cbr_apr_condition_7
      cbr_strength_set_18
      cbr_strength_set_19
      cbr_strength_set_20
      cbr_strength_set_21
  END

  ACTION_IF (~%improved_haste_semantics%~ STR_EQ ~additive~) BEGIN
    ACTION_IF (ih_state < 0 || apr_half_state < 0 || apr_one_state < 0 || apr_one_half_state < 0 || active_state_row < 0) BEGIN
      FAIL ~CBR Tempus APR bridge application is missing dynamic state or SPLPROT allocations.~
    END
    ACTION_IF (bridge_status = 0) BEGIN
      LAF cbr_create_tempus_apr_helpers
        INT_VAR ih_state = ih_state active_state_row = active_state_row
        STR_VAR resource_dir = EVAL ~%resource_dir%~
      END
      COPY ~%cbr_bridge_holy_path%~ ~%cbr_bridge_holy_path%~
        LPF cbr_build_tempus_holy_bridge
          INT_VAR ih_state = ih_state apr_half_state = apr_half_state apr_one_state = apr_one_state apr_one_half_state = apr_one_half_state active_state_row = active_state_row
          STR_VAR apr_helper_6 = EVAL ~%cbr_apr_helper_6%~ apr_helper_1 = EVAL ~%cbr_apr_helper_1%~ apr_helper_7 = EVAL ~%cbr_apr_helper_7%~ apr_condition_6 = EVAL ~%cbr_apr_condition_6%~ apr_condition_1 = EVAL ~%cbr_apr_condition_1%~ apr_condition_7 = EVAL ~%cbr_apr_condition_7%~
        END
      BUT_ONLY
      COPY ~%cbr_bridge_ih_path%~ ~%cbr_bridge_ih_path%~
        LPF cbr_build_tempus_ih_bridge
          INT_VAR ih_state = ih_state apr_half_state = apr_half_state apr_one_state = apr_one_state apr_one_half_state = apr_one_half_state active_state_row = active_state_row
          STR_VAR improved_haste_resref = EVAL ~%improved_haste_resref%~ apr_helper_6 = EVAL ~%cbr_apr_helper_6%~ apr_helper_1 = EVAL ~%cbr_apr_helper_1%~ apr_helper_7 = EVAL ~%cbr_apr_helper_7%~
        END
      BUT_ONLY
    END ELSE ACTION_IF (bridge_status != 1) BEGIN
      FAIL ~CBR Tempus APR bridge application received invalid graph status %bridge_status%.~
    END
  END ELSE ACTION_IF (bridge_status != 0) BEGIN
    FAIL ~CBR true-doubling Improved Haste unexpectedly requested additive bridge status %bridge_status%.~
  END

  ACTION_IF (divine_cleanup_status = 0) BEGIN
    COPY ~%cbr_bridge_divine_path%~ ~%cbr_bridge_divine_path%~
      LPF cbr_build_tempus_divine_cleanup
        STR_VAR
          divine_power_resref = EVAL ~%divine_power_resref%~
          strength_set_18 = EVAL ~%cbr_strength_set_18%~
          strength_set_19 = EVAL ~%cbr_strength_set_19%~
          strength_set_20 = EVAL ~%cbr_strength_set_20%~
          strength_set_21 = EVAL ~%cbr_strength_set_21%~
      END
    BUT_ONLY
  END ELSE ACTION_IF (divine_cleanup_status != 1) BEGIN
    FAIL ~CBR Divine Power cleanup application received invalid graph status %divine_cleanup_status%.~
  END

  ACTION_IF (~%improved_haste_semantics%~ STR_EQ ~additive~) BEGIN
    LAF cbr_validate_tempus_apr_helpers
      INT_VAR ih_state = ih_state active_state_row = active_state_row
      STR_VAR resource_dir = EVAL ~%resource_dir%~
    END
    COPY ~%cbr_bridge_holy_path%~ ~%cbr_bridge_holy_path%~
      LPF cbr_validate_tempus_holy_bridge_graph
        INT_VAR ih_state = ih_state apr_half_state = apr_half_state apr_one_state = apr_one_state apr_one_half_state = apr_one_half_state active_state_row = active_state_row
        STR_VAR apr_helper_6 = EVAL ~%cbr_apr_helper_6%~ apr_helper_1 = EVAL ~%cbr_apr_helper_1%~ apr_helper_7 = EVAL ~%cbr_apr_helper_7%~ apr_condition_6 = EVAL ~%cbr_apr_condition_6%~ apr_condition_1 = EVAL ~%cbr_apr_condition_1%~ apr_condition_7 = EVAL ~%cbr_apr_condition_7%~
        RET cbr_bridge_holy_verified = bridge_status
      END
      PATCH_IF (cbr_bridge_holy_verified != 1) BEGIN
        PATCH_FAIL ~CBR Holy APR bridge post-validation did not find a canonical graph.~
      END
    BUT_ONLY
    COPY ~%cbr_bridge_ih_path%~ ~%cbr_bridge_ih_path%~
      LPF cbr_validate_tempus_ih_bridge_graph
        INT_VAR ih_state = ih_state apr_half_state = apr_half_state apr_one_state = apr_one_state apr_one_half_state = apr_one_half_state active_state_row = active_state_row
        STR_VAR improved_haste_resref = EVAL ~%improved_haste_resref%~ apr_helper_6 = EVAL ~%cbr_apr_helper_6%~ apr_helper_1 = EVAL ~%cbr_apr_helper_1%~ apr_helper_7 = EVAL ~%cbr_apr_helper_7%~ apr_condition_6 = EVAL ~%cbr_apr_condition_6%~ apr_condition_1 = EVAL ~%cbr_apr_condition_1%~ apr_condition_7 = EVAL ~%cbr_apr_condition_7%~
        RET cbr_bridge_ih_verified = bridge_status
      END
      PATCH_IF (cbr_bridge_ih_verified != 1) BEGIN
        PATCH_FAIL ~CBR Improved Haste APR bridge post-validation did not find a canonical graph.~
      END
    BUT_ONLY
  END
  COPY ~%cbr_bridge_divine_path%~ ~%cbr_bridge_divine_path%~
    LPF cbr_validate_tempus_divine_cleanup_graph
      STR_VAR divine_power_resref = EVAL ~%divine_power_resref%~ strength_set_18 = EVAL ~%cbr_strength_set_18%~ strength_set_19 = EVAL ~%cbr_strength_set_19%~ strength_set_20 = EVAL ~%cbr_strength_set_20%~ strength_set_21 = EVAL ~%cbr_strength_set_21%~
      RET cbr_bridge_divine_verified = cleanup_status
    END
    PATCH_IF (cbr_bridge_divine_verified != 1) BEGIN
      PATCH_FAIL ~CBR Divine Power reciprocal cleanup post-validation did not find a canonical prefix.~
    END
  BUT_ONLY
END

DEFINE_ACTION_FUNCTION cbr_preflight_tempus_holy_power
  STR_VAR
    resource_dir           = ~~
    divine_power_resref    = ~~
    improved_haste_resref  = ~~
    improved_haste_semantics = ~~
    spell_ids              = ~require~
  RET
    holy_ability_count
    clab_capped_shape
    bridge_status
    divine_cleanup_status
BEGIN
  OUTER_SPRINT resource_dir EVALUATE_BUFFER ~%resource_dir%~
  OUTER_SPRINT divine_power_resref EVALUATE_BUFFER ~%divine_power_resref%~
  OUTER_SPRINT improved_haste_resref EVALUATE_BUFFER ~%improved_haste_resref%~
  OUTER_SPRINT improved_haste_semantics EVALUATE_BUFFER ~%improved_haste_semantics%~
  OUTER_SPRINT spell_ids EVALUATE_BUFFER ~%spell_ids%~
  OUTER_SET holy_ability_count = "-1"
  OUTER_SET clab_capped_shape = "-1"
  OUTER_SET bridge_status = 0
  OUTER_SET divine_cleanup_status = "-1"
  LAF cbr_define_tempus_private_resrefs
    RET
      cbr_apr_helper_6
      cbr_apr_helper_1
      cbr_apr_helper_7
      cbr_apr_condition_6
      cbr_apr_condition_1
      cbr_apr_condition_7
      cbr_strength_set_18
      cbr_strength_set_19
      cbr_strength_set_20
      cbr_strength_set_21
      cbr_strength_check_18
      cbr_strength_check_19
      cbr_strength_check_20
      cbr_strength_check_21
      cbr_strength_pulse_18
      cbr_strength_pulse_19
      cbr_strength_pulse_20
      cbr_strength_pulse_21
      cbr_strength_exception_18
  END

  ACTION_IF (FILE_EXISTS ~chitin.key~ && !(GAME_IS ~bg2ee eet~)) BEGIN
    FAIL ~CBR Tempus Holy Power supports only BG2:EE or EET.~
  END

  ACTION_IF !(~%spell_ids%~ STR_EQ ~require~ || ~%spell_ids%~ STR_EQ ~skip~) BEGIN
    FAIL ~CBR Tempus Holy Power: invalid spell_ids handling %spell_ids%; expected require or skip.~
  END

  OUTER_SPRINT cbr_spell_ids_path ~%resource_dir%/SPELL.IDS~
  OUTER_SPRINT cbr_holy_path ~%resource_dir%/OHTMPS1.SPL~
  OUTER_SPRINT cbr_divine_path ~%resource_dir%/%divine_power_resref%.SPL~
  OUTER_SPRINT cbr_improved_haste_path ~%resource_dir%/%improved_haste_resref%.SPL~
  OUTER_SPRINT cbr_clab_path ~%resource_dir%/OHTEMPUS.2DA~
  OUTER_SPRINT cbr_splstate_path ~%resource_dir%/SPLSTATE.IDS~
  OUTER_SPRINT cbr_splprot_path ~%resource_dir%/SPLPROT.2DA~

  // spell_ids=skip serves the public in-game installer: it resolves both
  // symbolic resrefs from the live SPELL.IDS via IDS_OF_SYMBOL immediately
  // before calling this library, and materializing SPELL.IDS into override
  // only to re-validate the same mapping would trigger WeiDU's IDS-tracking
  // side file (SPELL.IDS.INSTALLED). The isolated harness keeps the default
  // require so fixture symbol tables stay part of the tested contract.
  ACTION_IF (~%spell_ids%~ STR_EQ ~require~) BEGIN
    ACTION_IF !(FILE_EXISTS ~%cbr_spell_ids_path%~) BEGIN
      FAIL ~CBR Tempus Holy Power preflight is missing required explicit resource %cbr_spell_ids_path%.~
    END
  END
  ACTION_FOR_EACH cbr_required_path IN
    ~%cbr_holy_path%~
    ~%cbr_divine_path%~
    ~%cbr_improved_haste_path%~
    ~%cbr_clab_path%~
    ~%cbr_splstate_path%~
    ~%cbr_splprot_path%~
  BEGIN
    ACTION_IF !(FILE_EXISTS ~%cbr_required_path%~) BEGIN
      FAIL ~CBR Tempus Holy Power preflight is missing required explicit resource %cbr_required_path%.~
    END
  END

  // Reciprocal cleanup is timed-only opcode 321 (p2=2), but timed effects
  // delivered by a same-name item still carry that item resref as their source.
  // Guard parent ITMs even though the expected parents themselves are SPLs.
  ACTION_IF (FILE_EXISTS ~chitin.key~) BEGIN
    ACTION_IF (FILE_EXISTS_IN_GAME ~OHTMPS1.ITM~) BEGIN
      FAIL ~CBR Tempus Holy Power collision: OHTMPS1.ITM is visible through the game KEY and could be removed by reciprocal cleanup.~
    END
    ACTION_IF (FILE_EXISTS_IN_GAME ~%divine_power_resref%.ITM~) BEGIN
      FAIL ~CBR Tempus Holy Power collision: %divine_power_resref%.ITM is visible through the game KEY and could be removed by reciprocal cleanup.~
    END
  END
  ACTION_IF (FILE_EXISTS ~%resource_dir%/OHTMPS1.itm~ || FILE_EXISTS ~%resource_dir%/OHTMPS1.ITM~
          || FILE_EXISTS ~%resource_dir%/%divine_power_resref%.itm~ || FILE_EXISTS ~%resource_dir%/%divine_power_resref%.ITM~) BEGIN
    FAIL ~CBR Tempus Holy Power collision: a parent-buff resref also exists as an ITM at the explicit resource path.~
  END
  ACTION_IF (!(~%resource_dir%~ STR_EQ ~override~)
          && (FILE_EXISTS ~override/OHTMPS1.itm~ || FILE_EXISTS ~override/OHTMPS1.ITM~
           || FILE_EXISTS ~override/%divine_power_resref%.itm~ || FILE_EXISTS ~override/%divine_power_resref%.ITM~)
          && !(FILE_EXISTS ~%resource_dir%/OHTMPS1.itm~ || FILE_EXISTS ~%resource_dir%/OHTMPS1.ITM~
            || FILE_EXISTS ~%resource_dir%/%divine_power_resref%.itm~ || FILE_EXISTS ~%resource_dir%/%divine_power_resref%.ITM~)) BEGIN
    FAIL ~CBR Tempus Holy Power scratch collision: a parent-buff ITM exists under the process-local override directory.~
  END

  LAF cbr_reject_key_private_collisions
    STR_VAR resource_dir = EVAL ~%resource_dir%~
  END

  // Timed-only opcode 321 still removes matching timed effects by source resref,
  // regardless of whether an SPL or ITM delivered them.  A same-name item can
  // therefore be collateral even when the expected private SPL/EFF is canonical.
  ACTION_FOR_EACH cbr_reserved_private IN
    ~%cbr_apr_helper_6%~ ~%cbr_apr_helper_1%~ ~%cbr_apr_helper_7%~
    ~%cbr_apr_condition_6%~ ~%cbr_apr_condition_1%~ ~%cbr_apr_condition_7%~
    ~%cbr_strength_set_18%~ ~%cbr_strength_set_19%~ ~%cbr_strength_set_20%~ ~%cbr_strength_set_21%~
    ~%cbr_strength_check_18%~ ~%cbr_strength_check_19%~ ~%cbr_strength_check_20%~ ~%cbr_strength_check_21%~
    ~%cbr_strength_pulse_18%~ ~%cbr_strength_pulse_19%~ ~%cbr_strength_pulse_20%~ ~%cbr_strength_pulse_21%~
    ~%cbr_strength_exception_18%~
  BEGIN
    ACTION_IF (FILE_EXISTS ~%resource_dir%/%cbr_reserved_private%.itm~ || FILE_EXISTS ~%resource_dir%/%cbr_reserved_private%.ITM~) BEGIN
      FAIL ~CBR Tempus Holy Power reserved-resource namespace collision: %cbr_reserved_private%.ITM exists at the explicit resource path and could be affected by opcode 321 cleanup.~
    END
  END

  // WeiDU CREATE stages resources under the process-local override directory.
  // When the explicit output is elsewhere, refuse to overwrite or MOVE-away a
  // foreign staging resource.  Include future APR names and ITMs so every
  // private namespace is protected before any helper CREATE can run.
  ACTION_IF !(~%resource_dir%~ STR_EQ ~override~) BEGIN
    ACTION_FOR_EACH cbr_scratch_reserved IN
      ~%cbr_apr_helper_6%~ ~%cbr_apr_helper_1%~ ~%cbr_apr_helper_7%~
      ~%cbr_apr_condition_6%~ ~%cbr_apr_condition_1%~ ~%cbr_apr_condition_7%~
      ~%cbr_strength_set_18%~ ~%cbr_strength_set_19%~ ~%cbr_strength_set_20%~ ~%cbr_strength_set_21%~
      ~%cbr_strength_check_18%~ ~%cbr_strength_check_19%~ ~%cbr_strength_check_20%~ ~%cbr_strength_check_21%~
      ~%cbr_strength_pulse_18%~ ~%cbr_strength_pulse_19%~ ~%cbr_strength_pulse_20%~ ~%cbr_strength_pulse_21%~
      ~%cbr_strength_exception_18%~
    BEGIN
      // An absolute resource_dir can name the process-local override itself.
      // Matching-extension files visible through both paths are deferred to
      // the exact original20/recognized30 ownership checks below.  A scratch
      // file absent from the explicit tree is necessarily a foreign staging
      // collision and remains an immediate failure.
      OUTER_SET cbr_scratch_collision = 0
      ACTION_IF ((FILE_EXISTS ~override/%cbr_scratch_reserved%.spl~ || FILE_EXISTS ~override/%cbr_scratch_reserved%.SPL~)
              && !(FILE_EXISTS ~%resource_dir%/%cbr_scratch_reserved%.spl~ || FILE_EXISTS ~%resource_dir%/%cbr_scratch_reserved%.SPL~)) BEGIN
        OUTER_SET cbr_scratch_collision = 1
      END
      ACTION_IF ((FILE_EXISTS ~override/%cbr_scratch_reserved%.eff~ || FILE_EXISTS ~override/%cbr_scratch_reserved%.EFF~)
              && !(FILE_EXISTS ~%resource_dir%/%cbr_scratch_reserved%.eff~ || FILE_EXISTS ~%resource_dir%/%cbr_scratch_reserved%.EFF~)) BEGIN
        OUTER_SET cbr_scratch_collision = 1
      END
      ACTION_IF ((FILE_EXISTS ~override/%cbr_scratch_reserved%.itm~ || FILE_EXISTS ~override/%cbr_scratch_reserved%.ITM~)
              && !(FILE_EXISTS ~%resource_dir%/%cbr_scratch_reserved%.itm~ || FILE_EXISTS ~%resource_dir%/%cbr_scratch_reserved%.ITM~)) BEGIN
        OUTER_SET cbr_scratch_collision = 1
      END
      ACTION_IF (cbr_scratch_collision) BEGIN
        FAIL ~CBR Tempus Holy Power scratch-publish collision: reserved resource %cbr_scratch_reserved% already exists under the process-local override directory; refusing destructive CREATE/MOVE staging.~
      END
    END
  END

  // The APR bridge is transactional at resource-graph granularity: either all
  // six exact helpers exist on a canonical rerun, or none exist before first
  // application. Wrong extensions and partial publication are always foreign.
  OUTER_SET cbr_apr_resource_count = 0
  ACTION_FOR_EACH cbr_reserved_apr_spl IN ~%cbr_apr_helper_6%~ ~%cbr_apr_helper_1%~ ~%cbr_apr_helper_7%~ BEGIN
    ACTION_IF (FILE_EXISTS ~%resource_dir%/%cbr_reserved_apr_spl%.eff~ || FILE_EXISTS ~%resource_dir%/%cbr_reserved_apr_spl%.EFF~) BEGIN
      FAIL ~CBR Tempus APR helper collision: reserved SPL %cbr_reserved_apr_spl% exists with EFF extension.~
    END
    ACTION_IF (FILE_EXISTS ~%resource_dir%/%cbr_reserved_apr_spl%.spl~ || FILE_EXISTS ~%resource_dir%/%cbr_reserved_apr_spl%.SPL~) BEGIN
      OUTER_SET cbr_apr_resource_count = cbr_apr_resource_count + 1
    END
  END
  ACTION_FOR_EACH cbr_reserved_apr_eff IN ~%cbr_apr_condition_6%~ ~%cbr_apr_condition_1%~ ~%cbr_apr_condition_7%~ BEGIN
    ACTION_IF (FILE_EXISTS ~%resource_dir%/%cbr_reserved_apr_eff%.spl~ || FILE_EXISTS ~%resource_dir%/%cbr_reserved_apr_eff%.SPL~) BEGIN
      FAIL ~CBR Tempus APR condition collision: reserved EFF %cbr_reserved_apr_eff% exists with SPL extension.~
    END
    ACTION_IF (FILE_EXISTS ~%resource_dir%/%cbr_reserved_apr_eff%.eff~ || FILE_EXISTS ~%resource_dir%/%cbr_reserved_apr_eff%.EFF~) BEGIN
      OUTER_SET cbr_apr_resource_count = cbr_apr_resource_count + 1
    END
  END
  ACTION_IF (cbr_apr_resource_count != 0 && cbr_apr_resource_count != 6) BEGIN
    FAIL ~CBR Tempus APR bridge collision: found a partial helper graph (%cbr_apr_resource_count% of 6 reserved resources).~
  END
  ACTION_IF (~%improved_haste_semantics%~ STR_EQ ~double~ && cbr_apr_resource_count != 0) BEGIN
    FAIL ~CBR Tempus APR bridge collision: true-doubling Improved Haste must not own additive bridge helpers.~
  END
  ACTION_IF (~%improved_haste_semantics%~ STR_EQ ~double~) BEGIN
    // A prior additive install can leave graph ownership in SPLSTATE.IDS or in
    // either parent even if its six helper files were removed.  True doubling
    // must therefore prove the entire additive namespace is absent.
    COPY ~%cbr_splstate_path%~ ~%cbr_splstate_path%~
      LPF cbr_reject_tempus_private_splstates END
    BUT_ONLY
    COPY ~%cbr_holy_path%~ ~%cbr_holy_path%~
      LPF cbr_reject_tempus_apr_artifacts
        STR_VAR
          resource_name = ~OHTMPS1.SPL~
          apr_helper_6 = EVAL ~%cbr_apr_helper_6%~
          apr_helper_1 = EVAL ~%cbr_apr_helper_1%~
          apr_helper_7 = EVAL ~%cbr_apr_helper_7%~
          apr_condition_6 = EVAL ~%cbr_apr_condition_6%~
          apr_condition_1 = EVAL ~%cbr_apr_condition_1%~
          apr_condition_7 = EVAL ~%cbr_apr_condition_7%~
      END
    BUT_ONLY
    COPY ~%cbr_improved_haste_path%~ ~%cbr_improved_haste_path%~
      LPF cbr_reject_tempus_apr_artifacts
        STR_VAR
          resource_name = EVAL ~%improved_haste_resref%.SPL~
          apr_helper_6 = EVAL ~%cbr_apr_helper_6%~
          apr_helper_1 = EVAL ~%cbr_apr_helper_1%~
          apr_helper_7 = EVAL ~%cbr_apr_helper_7%~
          apr_condition_6 = EVAL ~%cbr_apr_condition_6%~
          apr_condition_1 = EVAL ~%cbr_apr_condition_1%~
          apr_condition_7 = EVAL ~%cbr_apr_condition_7%~
      END
    BUT_ONLY
  END

  ACTION_IF (~%spell_ids%~ STR_EQ ~require~) BEGIN
    COPY ~%cbr_spell_ids_path%~ ~%cbr_spell_ids_path%~
      LPF cbr_validate_spell_ids
        STR_VAR
          divine_power_resref   = EVAL ~%divine_power_resref%~
          improved_haste_resref = EVAL ~%improved_haste_resref%~
      END
    BUT_ONLY
  END
  OUTER_SET cbr_str_lt_row = "-1"
  OUTER_SET cbr_str_eq_row = "-1"
  OUTER_SET cbr_str_bonus_lt_row = "-1"
  OUTER_SET cbr_active_state_row = "-1"
  COPY ~%cbr_splprot_path%~ ~%cbr_splprot_path%~
    SET cbr_patch_active_state_row = "-1"
    PATCH_IF (~%improved_haste_semantics%~ STR_EQ ~additive~) BEGIN
      LPF cbr_find_or_append_splprot
        INT_VAR stat = 0x112 value = "-1" relation = 1 append = 0
        STR_VAR row_label = ~CBR_TEMPUS_STATE_ACTIVE~
        RET cbr_patch_active_state_row = row_index
      END
    END
    LPF cbr_find_or_append_splprot
      INT_VAR stat = 36 value = "-1" relation = 2 append = 0
      STR_VAR row_label = ~CBR_TEMPUS_STR_LT~
      RET cbr_patch_str_lt_row = row_index
    END
    LPF cbr_find_or_append_splprot
      INT_VAR stat = 36 value = "-1" relation = 1 append = 0
      STR_VAR row_label = ~CBR_TEMPUS_STR_EQ~
      RET cbr_patch_str_eq_row = row_index
    END
    LPF cbr_find_or_append_splprot
      INT_VAR stat = 37 value = "-1" relation = 2 append = 0
      STR_VAR row_label = ~CBR_TEMPUS_STR_BONUS_LT~
      RET cbr_patch_str_bonus_lt_row = row_index
    END
    INNER_ACTION BEGIN
      OUTER_SET cbr_active_state_row = cbr_patch_active_state_row
      OUTER_SET cbr_str_lt_row = cbr_patch_str_lt_row
      OUTER_SET cbr_str_eq_row = cbr_patch_str_eq_row
      OUTER_SET cbr_str_bonus_lt_row = cbr_patch_str_bonus_lt_row
    END
  BUT_ONLY
  OUTER_SET cbr_holy_ability_count = 0
  COPY ~%cbr_holy_path%~ ~%cbr_holy_path%~
    LPF cbr_validate_tempus_holy_spell
      INT_VAR
        str_lt_row       = cbr_str_lt_row
        str_eq_row       = cbr_str_eq_row
        str_bonus_lt_row = cbr_str_bonus_lt_row
      STR_VAR
        divine_power_resref = EVAL ~%divine_power_resref%~
        strength_pulse_18 = EVAL ~%cbr_strength_pulse_18%~
        strength_pulse_19 = EVAL ~%cbr_strength_pulse_19%~
        strength_pulse_20 = EVAL ~%cbr_strength_pulse_20%~
        strength_pulse_21 = EVAL ~%cbr_strength_pulse_21%~
        strength_set_18 = EVAL ~%cbr_strength_set_18%~
        strength_set_19 = EVAL ~%cbr_strength_set_19%~
        strength_set_20 = EVAL ~%cbr_strength_set_20%~
        strength_set_21 = EVAL ~%cbr_strength_set_21%~
        strength_exception_18 = EVAL ~%cbr_strength_exception_18%~
      RET cbr_patch_holy_ability_count = holy_ability_count
    END
    INNER_ACTION BEGIN
      OUTER_SET cbr_holy_ability_count = cbr_patch_holy_ability_count
    END
  BUT_ONLY
  OUTER_SET holy_ability_count = cbr_holy_ability_count
  ACTION_IF (cbr_holy_ability_count = 20) BEGIN
    ACTION_FOR_EACH cbr_strength_reserved IN
      ~%cbr_strength_set_18%~ ~%cbr_strength_set_19%~ ~%cbr_strength_set_20%~ ~%cbr_strength_set_21%~
      ~%cbr_strength_check_18%~ ~%cbr_strength_check_19%~ ~%cbr_strength_check_20%~ ~%cbr_strength_check_21%~
      ~%cbr_strength_pulse_18%~ ~%cbr_strength_pulse_19%~ ~%cbr_strength_pulse_20%~ ~%cbr_strength_pulse_21%~
      ~%cbr_strength_exception_18%~
    BEGIN
      ACTION_IF (FILE_EXISTS ~%resource_dir%/%cbr_strength_reserved%.spl~ || FILE_EXISTS ~%resource_dir%/%cbr_strength_reserved%.SPL~ || FILE_EXISTS ~%resource_dir%/%cbr_strength_reserved%.eff~ || FILE_EXISTS ~%resource_dir%/%cbr_strength_reserved%.EFF~) BEGIN
        FAIL ~CBR Tempus Holy Power helper-resref collision: original 20-header input requires reserved Strength resource %cbr_strength_reserved% to be absent.~
      END
    END
  END ELSE ACTION_IF (cbr_holy_ability_count = 30) BEGIN
    LAF cbr_validate_tempus_strength_helpers
      INT_VAR
        str_lt_row       = cbr_str_lt_row
        str_eq_row       = cbr_str_eq_row
        str_bonus_lt_row = cbr_str_bonus_lt_row
      STR_VAR resource_dir = EVAL ~%resource_dir%~
    END
    // If both paths exposed Strength helpers, validate the process-local copy
    // independently.  This accepts a true absolute override alias (and an
    // exact duplicate owned tree) while rejecting a distinct foreign scratch
    // file that merely shares the canonical output's resref and extension.
    ACTION_IF (!(~%resource_dir%~ STR_EQ ~override~)
            && (FILE_EXISTS ~override/%cbr_strength_set_18%.spl~ || FILE_EXISTS ~override/%cbr_strength_set_18%.SPL~
             || FILE_EXISTS ~override/%cbr_strength_set_19%.spl~ || FILE_EXISTS ~override/%cbr_strength_set_19%.SPL~
             || FILE_EXISTS ~override/%cbr_strength_set_20%.spl~ || FILE_EXISTS ~override/%cbr_strength_set_20%.SPL~
             || FILE_EXISTS ~override/%cbr_strength_set_21%.spl~ || FILE_EXISTS ~override/%cbr_strength_set_21%.SPL~
             || FILE_EXISTS ~override/%cbr_strength_check_18%.spl~ || FILE_EXISTS ~override/%cbr_strength_check_18%.SPL~
             || FILE_EXISTS ~override/%cbr_strength_check_19%.spl~ || FILE_EXISTS ~override/%cbr_strength_check_19%.SPL~
             || FILE_EXISTS ~override/%cbr_strength_check_20%.spl~ || FILE_EXISTS ~override/%cbr_strength_check_20%.SPL~
             || FILE_EXISTS ~override/%cbr_strength_check_21%.spl~ || FILE_EXISTS ~override/%cbr_strength_check_21%.SPL~
             || FILE_EXISTS ~override/%cbr_strength_exception_18%.spl~ || FILE_EXISTS ~override/%cbr_strength_exception_18%.SPL~
             || FILE_EXISTS ~override/%cbr_strength_pulse_18%.eff~ || FILE_EXISTS ~override/%cbr_strength_pulse_18%.EFF~
             || FILE_EXISTS ~override/%cbr_strength_pulse_19%.eff~ || FILE_EXISTS ~override/%cbr_strength_pulse_19%.EFF~
             || FILE_EXISTS ~override/%cbr_strength_pulse_20%.eff~ || FILE_EXISTS ~override/%cbr_strength_pulse_20%.EFF~
             || FILE_EXISTS ~override/%cbr_strength_pulse_21%.eff~ || FILE_EXISTS ~override/%cbr_strength_pulse_21%.EFF~)) BEGIN
      LAF cbr_validate_tempus_strength_helpers
        INT_VAR
          str_lt_row       = cbr_str_lt_row
          str_eq_row       = cbr_str_eq_row
          str_bonus_lt_row = cbr_str_bonus_lt_row
        STR_VAR resource_dir = ~override~
      END
    END
  END ELSE BEGIN
    FAIL ~CBR Tempus Holy Power preflight did not retain a supported 20/30-header layout result.~
  END
  COPY ~%cbr_divine_path%~ ~%cbr_divine_path%~
    LPF cbr_validate_tempus_divine_cleanup_graph
      STR_VAR
        divine_power_resref = EVAL ~%divine_power_resref%~
        strength_set_18 = EVAL ~%cbr_strength_set_18%~
        strength_set_19 = EVAL ~%cbr_strength_set_19%~
        strength_set_20 = EVAL ~%cbr_strength_set_20%~
        strength_set_21 = EVAL ~%cbr_strength_set_21%~
      RET cbr_patch_divine_cleanup_status = cleanup_status
    END
    INNER_ACTION BEGIN
      OUTER_SET divine_cleanup_status = cbr_patch_divine_cleanup_status
    END
  BUT_ONLY
  COPY ~%cbr_clab_path%~ ~%cbr_clab_path%~
    LPF cbr_validate_tempus_clab
      RET cbr_patch_clab_capped_shape = capped_shape
    END
    INNER_ACTION BEGIN
      OUTER_SET clab_capped_shape = cbr_patch_clab_capped_shape
    END
  BUT_ONLY
  ACTION_IF (~%improved_haste_semantics%~ STR_EQ ~additive~) BEGIN
    COPY ~%cbr_splstate_path%~ ~%cbr_splstate_path%~
      LPF cbr_plan_tempus_splstates
        RET
          cbr_patch_ih_state = ih_state
          cbr_patch_apr_half_state = apr_half_state
          cbr_patch_apr_one_state = apr_one_state
          cbr_patch_apr_one_half_state = apr_one_half_state
      END
      INNER_ACTION BEGIN
        OUTER_SET cbr_preflight_ih_state = cbr_patch_ih_state
        OUTER_SET cbr_preflight_apr_half_state = cbr_patch_apr_half_state
        OUTER_SET cbr_preflight_apr_one_state = cbr_patch_apr_one_state
        OUTER_SET cbr_preflight_apr_one_half_state = cbr_patch_apr_one_half_state
      END
    BUT_ONLY
    ACTION_IF (cbr_apr_resource_count = 6) BEGIN
      ACTION_IF (cbr_holy_ability_count != 30 || cbr_active_state_row < 0) BEGIN
        FAIL ~CBR Tempus APR bridge helpers exist without the allocated 30-header bridge prerequisites.~
      END
      LAF cbr_validate_tempus_apr_helpers
        INT_VAR ih_state = cbr_preflight_ih_state active_state_row = cbr_active_state_row
        STR_VAR resource_dir = EVAL ~%resource_dir%~
      END
      ACTION_IF (!(~%resource_dir%~ STR_EQ ~override~)
              && (FILE_EXISTS ~override/%cbr_apr_helper_6%.spl~ || FILE_EXISTS ~override/%cbr_apr_helper_6%.SPL~
               || FILE_EXISTS ~override/%cbr_apr_helper_1%.spl~ || FILE_EXISTS ~override/%cbr_apr_helper_1%.SPL~
               || FILE_EXISTS ~override/%cbr_apr_helper_7%.spl~ || FILE_EXISTS ~override/%cbr_apr_helper_7%.SPL~
               || FILE_EXISTS ~override/%cbr_apr_condition_6%.eff~ || FILE_EXISTS ~override/%cbr_apr_condition_6%.EFF~
               || FILE_EXISTS ~override/%cbr_apr_condition_1%.eff~ || FILE_EXISTS ~override/%cbr_apr_condition_1%.EFF~
               || FILE_EXISTS ~override/%cbr_apr_condition_7%.eff~ || FILE_EXISTS ~override/%cbr_apr_condition_7%.EFF~)) BEGIN
        LAF cbr_validate_tempus_apr_helpers
          INT_VAR ih_state = cbr_preflight_ih_state active_state_row = cbr_active_state_row
          STR_VAR resource_dir = ~override~
        END
      END
    END
    OUTER_SET cbr_preflight_ih_bridge_status = "-1"
    COPY ~%cbr_improved_haste_path%~ ~%cbr_improved_haste_path%~
      LPF cbr_validate_tempus_ih_bridge_graph
        INT_VAR
          ih_state = cbr_preflight_ih_state
          apr_half_state = cbr_preflight_apr_half_state
          apr_one_state = cbr_preflight_apr_one_state
          apr_one_half_state = cbr_preflight_apr_one_half_state
          active_state_row = cbr_active_state_row
        STR_VAR
          improved_haste_resref = EVAL ~%improved_haste_resref%~
          apr_helper_6 = EVAL ~%cbr_apr_helper_6%~
          apr_helper_1 = EVAL ~%cbr_apr_helper_1%~
          apr_helper_7 = EVAL ~%cbr_apr_helper_7%~
          apr_condition_6 = EVAL ~%cbr_apr_condition_6%~
          apr_condition_1 = EVAL ~%cbr_apr_condition_1%~
          apr_condition_7 = EVAL ~%cbr_apr_condition_7%~
        RET cbr_patch_ih_bridge_status = bridge_status
      END
      INNER_ACTION BEGIN
        OUTER_SET cbr_preflight_ih_bridge_status = cbr_patch_ih_bridge_status
      END
    BUT_ONLY
    OUTER_SET cbr_preflight_holy_bridge_status = "-1"
    COPY ~%cbr_holy_path%~ ~%cbr_holy_path%~
      LPF cbr_validate_tempus_holy_bridge_graph
        INT_VAR
          ih_state = cbr_preflight_ih_state
          apr_half_state = cbr_preflight_apr_half_state
          apr_one_state = cbr_preflight_apr_one_state
          apr_one_half_state = cbr_preflight_apr_one_half_state
          active_state_row = cbr_active_state_row
        STR_VAR
          apr_helper_6 = EVAL ~%cbr_apr_helper_6%~
          apr_helper_1 = EVAL ~%cbr_apr_helper_1%~
          apr_helper_7 = EVAL ~%cbr_apr_helper_7%~
          apr_condition_6 = EVAL ~%cbr_apr_condition_6%~
          apr_condition_1 = EVAL ~%cbr_apr_condition_1%~
          apr_condition_7 = EVAL ~%cbr_apr_condition_7%~
        RET cbr_patch_holy_bridge_status = bridge_status
      END
      INNER_ACTION BEGIN
        OUTER_SET cbr_preflight_holy_bridge_status = cbr_patch_holy_bridge_status
      END
    BUT_ONLY
    ACTION_IF (cbr_preflight_ih_bridge_status != cbr_preflight_holy_bridge_status) BEGIN
      FAIL ~CBR Tempus APR bridge is partial: Improved Haste and Holy Power graph states differ.~
    END
    ACTION_IF ((cbr_apr_resource_count = 0 && cbr_preflight_ih_bridge_status != 0)
            || (cbr_apr_resource_count = 6 && cbr_preflight_ih_bridge_status != 1)) BEGIN
      FAIL ~CBR Tempus APR bridge helper publication and spell graph are not wholly pristine or wholly canonical.~
    END
    OUTER_SET bridge_status = cbr_preflight_ih_bridge_status
  END
END

DEFINE_ACTION_FUNCTION cbr_allocate_tempus_tables
  STR_VAR
    resource_dir              = ~~
    improved_haste_semantics  = ~~
  RET
    str_lt_row
    str_eq_row
    str_bonus_lt_row
    ih_state
    apr_half_state
    apr_one_state
    apr_one_half_state
    active_state_row
BEGIN
  OUTER_SPRINT resource_dir EVALUATE_BUFFER ~%resource_dir%~
  OUTER_SPRINT improved_haste_semantics EVALUATE_BUFFER ~%improved_haste_semantics%~
  OUTER_SPRINT cbr_splstate_path ~%resource_dir%/SPLSTATE.IDS~
  OUTER_SPRINT cbr_splprot_path ~%resource_dir%/SPLPROT.2DA~
  OUTER_SET str_lt_row = "-1"
  OUTER_SET str_eq_row = "-1"
  OUTER_SET str_bonus_lt_row = "-1"
  OUTER_SET ih_state = "-1"
  OUTER_SET apr_half_state = "-1"
  OUTER_SET apr_one_state = "-1"
  OUTER_SET apr_one_half_state = "-1"
  OUTER_SET active_state_row = "-1"
  ACTION_IF (~%improved_haste_semantics%~ STR_EQ ~additive~) BEGIN
    OUTER_SET cbr_append_states = 0
    COPY ~%cbr_splstate_path%~ ~%cbr_splstate_path%~
      LPF cbr_plan_tempus_splstates
        RET
          cbr_patch_ih_state           = ih_state
          cbr_patch_apr_half_state     = apr_half_state
          cbr_patch_apr_one_state      = apr_one_state
          cbr_patch_apr_one_half_state = apr_one_half_state
          cbr_patch_append_states      = append_states
      END
      INNER_ACTION BEGIN
        OUTER_SET cbr_ih_state           = cbr_patch_ih_state
        OUTER_SET cbr_apr_half_state     = cbr_patch_apr_half_state
        OUTER_SET cbr_apr_one_state      = cbr_patch_apr_one_state
        OUTER_SET cbr_apr_one_half_state = cbr_patch_apr_one_half_state
        OUTER_SET ih_state           = cbr_patch_ih_state
        OUTER_SET apr_half_state     = cbr_patch_apr_half_state
        OUTER_SET apr_one_state      = cbr_patch_apr_one_state
        OUTER_SET apr_one_half_state = cbr_patch_apr_one_half_state
        OUTER_SET cbr_append_states      = cbr_patch_append_states
      END
    BUT_ONLY
    ACTION_IF (cbr_append_states = 1) BEGIN
      LAF cbr_find_or_allocate_splstate INT_VAR planned_value = cbr_ih_state STR_VAR resource_path = EVAL ~%cbr_splstate_path%~ symbol = ~CBR_TEMPUS_IH~ END
      LAF cbr_find_or_allocate_splstate INT_VAR planned_value = cbr_apr_half_state STR_VAR resource_path = EVAL ~%cbr_splstate_path%~ symbol = ~CBR_TEMPUS_APR_HALF~ END
      LAF cbr_find_or_allocate_splstate INT_VAR planned_value = cbr_apr_one_state STR_VAR resource_path = EVAL ~%cbr_splstate_path%~ symbol = ~CBR_TEMPUS_APR_ONE~ END
      LAF cbr_find_or_allocate_splstate INT_VAR planned_value = cbr_apr_one_half_state STR_VAR resource_path = EVAL ~%cbr_splstate_path%~ symbol = ~CBR_TEMPUS_APR_ONE_HALF~ END
      CLEAR_IDS_MAP
    END
  END
  COPY ~%cbr_splprot_path%~ ~%cbr_splprot_path%~
    SET cbr_allocate_active_state_row = "-1"
    PATCH_IF (~%improved_haste_semantics%~ STR_EQ ~additive~) BEGIN
      LPF cbr_find_or_append_splprot
        INT_VAR stat = 0x112 value = "-1" relation = 1
        STR_VAR row_label = ~CBR_TEMPUS_STATE_ACTIVE~
        RET cbr_allocate_active_state_row = row_index
      END
    END
    LPF cbr_find_or_append_splprot
      INT_VAR stat = 36 value = "-1" relation = 2
      STR_VAR row_label = ~CBR_TEMPUS_STR_LT~
      RET cbr_allocate_str_lt_row = row_index
    END
    LPF cbr_find_or_append_splprot
      INT_VAR stat = 36 value = "-1" relation = 1
      STR_VAR row_label = ~CBR_TEMPUS_STR_EQ~
      RET cbr_allocate_str_eq_row = row_index
    END
    LPF cbr_find_or_append_splprot
      INT_VAR stat = 37 value = "-1" relation = 2
      STR_VAR row_label = ~CBR_TEMPUS_STR_BONUS_LT~
      RET cbr_allocate_str_bonus_lt_row = row_index
    END
    INNER_ACTION BEGIN
      OUTER_SET active_state_row = cbr_allocate_active_state_row
      OUTER_SET str_lt_row = cbr_allocate_str_lt_row
      OUTER_SET str_eq_row = cbr_allocate_str_eq_row
      OUTER_SET str_bonus_lt_row = cbr_allocate_str_bonus_lt_row
    END
  BUT_ONLY
END

DEFINE_ACTION_FUNCTION cbr_apply_tempus_progression
  INT_VAR
    holy_ability_count = 0
    clab_capped_shape  = 0
    str_lt_row         = "-1"
    str_eq_row         = "-1"
    str_bonus_lt_row   = "-1"
  STR_VAR
    resource_dir          = ~~
    divine_power_resref   = ~~
BEGIN
  OUTER_SPRINT resource_dir EVALUATE_BUFFER ~%resource_dir%~
  OUTER_SPRINT divine_power_resref EVALUATE_BUFFER ~%divine_power_resref%~
  OUTER_SPRINT cbr_progression_holy_path ~%resource_dir%/OHTMPS1.SPL~
  OUTER_SPRINT cbr_progression_clab_path ~%resource_dir%/OHTEMPUS.2DA~
  LAF cbr_define_tempus_private_resrefs
    RET
      cbr_strength_set_18
      cbr_strength_set_19
      cbr_strength_set_20
      cbr_strength_set_21
      cbr_strength_check_18
      cbr_strength_check_19
      cbr_strength_check_20
      cbr_strength_check_21
      cbr_strength_pulse_18
      cbr_strength_pulse_19
      cbr_strength_pulse_20
      cbr_strength_pulse_21
      cbr_strength_exception_18
  END

  ACTION_IF (holy_ability_count = 20) BEGIN
    LAF cbr_create_tempus_strength_helpers
      INT_VAR str_lt_row = str_lt_row str_eq_row = str_eq_row str_bonus_lt_row = str_bonus_lt_row
      STR_VAR resource_dir = EVAL ~%resource_dir%~
    END
    COPY ~%cbr_progression_holy_path%~ ~%cbr_progression_holy_path%~
      LPF cbr_build_tempus_holy_progression
        INT_VAR str_lt_row = str_lt_row str_eq_row = str_eq_row str_bonus_lt_row = str_bonus_lt_row
        STR_VAR
          divine_power_resref = EVAL ~%divine_power_resref%~
          strength_pulse_18 = EVAL ~%cbr_strength_pulse_18%~
          strength_pulse_19 = EVAL ~%cbr_strength_pulse_19%~
          strength_pulse_20 = EVAL ~%cbr_strength_pulse_20%~
          strength_pulse_21 = EVAL ~%cbr_strength_pulse_21%~
          strength_set_18 = EVAL ~%cbr_strength_set_18%~
          strength_set_19 = EVAL ~%cbr_strength_set_19%~
          strength_set_20 = EVAL ~%cbr_strength_set_20%~
          strength_set_21 = EVAL ~%cbr_strength_set_21%~
          strength_exception_18 = EVAL ~%cbr_strength_exception_18%~
      END
    BUT_ONLY
  END ELSE ACTION_IF (holy_ability_count != 30) BEGIN
    FAIL ~CBR Tempus progression received unsupported Holy Power header count %holy_ability_count%.~
  END

  ACTION_IF (!clab_capped_shape) BEGIN
    COPY ~%cbr_progression_clab_path%~ ~%cbr_progression_clab_path%~
      LPF cbr_cap_tempus_clab END
    BUT_ONLY
  END

  COPY ~%cbr_progression_holy_path%~ ~%cbr_progression_holy_path%~
    LPF cbr_validate_tempus_holy_spell
      INT_VAR str_lt_row = str_lt_row str_eq_row = str_eq_row str_bonus_lt_row = str_bonus_lt_row
      STR_VAR
        divine_power_resref = EVAL ~%divine_power_resref%~
        strength_pulse_18 = EVAL ~%cbr_strength_pulse_18%~
        strength_pulse_19 = EVAL ~%cbr_strength_pulse_19%~
        strength_pulse_20 = EVAL ~%cbr_strength_pulse_20%~
        strength_pulse_21 = EVAL ~%cbr_strength_pulse_21%~
        strength_set_18 = EVAL ~%cbr_strength_set_18%~
        strength_set_19 = EVAL ~%cbr_strength_set_19%~
        strength_set_20 = EVAL ~%cbr_strength_set_20%~
        strength_set_21 = EVAL ~%cbr_strength_set_21%~
        strength_exception_18 = EVAL ~%cbr_strength_exception_18%~
    END
  BUT_ONLY
  LAF cbr_validate_tempus_strength_helpers
    INT_VAR str_lt_row = str_lt_row str_eq_row = str_eq_row str_bonus_lt_row = str_bonus_lt_row
    STR_VAR resource_dir = EVAL ~%resource_dir%~
  END
  COPY ~%cbr_progression_clab_path%~ ~%cbr_progression_clab_path%~
    LPF cbr_validate_tempus_clab RET cbr_progression_clab_verified = capped_shape END
    PATCH_IF (!cbr_progression_clab_verified) BEGIN
      PATCH_FAIL ~CBR Tempus progression post-validation found an uncapped CLAB.~
    END
  BUT_ONLY
END

DEFINE_ACTION_FUNCTION cbr_apply_tempus_holy_power
  STR_VAR
    resource_dir           = ~~
    compatibility_mode     = ~auto~
    divine_power_resref    = ~~
    improved_haste_resref  = ~~
    phase                  = ~full~
    spell_ids              = ~require~
BEGIN
  // WeiDU does not EVALUATE_BUFFER STR_VAR arguments passed through LAF.
  // The isolated harness intentionally passes %argv[n]% placeholders, so
  // normalize the public boundary once before validating any value.
  OUTER_SPRINT resource_dir          EVALUATE_BUFFER ~%resource_dir%~
  OUTER_SPRINT compatibility_mode    EVALUATE_BUFFER ~%compatibility_mode%~
  OUTER_SPRINT divine_power_resref   EVALUATE_BUFFER ~%divine_power_resref%~
  OUTER_SPRINT improved_haste_resref EVALUATE_BUFFER ~%improved_haste_resref%~
  OUTER_SPRINT phase                 EVALUATE_BUFFER ~%phase%~
  OUTER_SPRINT spell_ids             EVALUATE_BUFFER ~%spell_ids%~

  ACTION_IF !(~%compatibility_mode%~ STR_EQ ~auto~ || ~%compatibility_mode%~ STR_EQ ~force_double~ || ~%compatibility_mode%~ STR_EQ ~force_additive~) BEGIN
    FAIL ~CBR Tempus Holy Power: invalid compatibility mode %compatibility_mode%; expected auto, force_double, or force_additive.~
  END
  ACTION_IF !(~%phase%~ STR_EQ ~classify~ || ~%phase%~ STR_EQ ~allocate~ || ~%phase%~ STR_EQ ~progression~ || ~%phase%~ STR_EQ ~bridge~ || ~%phase%~ STR_EQ ~full~) BEGIN
    FAIL ~CBR Tempus Holy Power: invalid phase %phase%.~
  END
  ACTION_IF !(~%spell_ids%~ STR_EQ ~require~ || ~%spell_ids%~ STR_EQ ~skip~) BEGIN
    FAIL ~CBR Tempus Holy Power: invalid spell_ids handling %spell_ids%; expected require or skip.~
  END
  ACTION_IF (~%resource_dir%~ STR_EQ ~~) BEGIN
    FAIL ~CBR Tempus Holy Power: explicit resource_dir is required.~
  END
  ACTION_IF (~%improved_haste_resref%~ STR_EQ ~~) BEGIN
    FAIL ~CBR Tempus Holy Power: explicit Improved Haste resref is required.~
  END
  ACTION_IF (~%divine_power_resref%~ STR_EQ ~~) BEGIN
    FAIL ~CBR Tempus Holy Power: explicit Divine Power resref is required.~
  END

  OUTER_SPRINT cbr_improved_haste_path ~%resource_dir%/%improved_haste_resref%.SPL~
  ACTION_IF !(FILE_EXISTS ~%cbr_improved_haste_path%~) BEGIN
    FAIL ~CBR Improved Haste %improved_haste_resref% is missing at the explicit resource path %cbr_improved_haste_path%.~
  END

  LAF cbr_classify_improved_haste_file
    STR_VAR
      resource_path          = EVAL ~%cbr_improved_haste_path%~
      improved_haste_resref  = EVAL ~%improved_haste_resref%~
      compatibility_mode     = EVAL ~%compatibility_mode%~
    RET cbr_improved_haste_semantics = semantics
  END

  LAF cbr_preflight_tempus_holy_power
    STR_VAR
      resource_dir                = EVAL ~%resource_dir%~
      divine_power_resref         = EVAL ~%divine_power_resref%~
      improved_haste_resref       = EVAL ~%improved_haste_resref%~
      improved_haste_semantics    = EVAL ~%cbr_improved_haste_semantics%~
      spell_ids                   = EVAL ~%spell_ids%~
    RET
      cbr_preflight_holy_ability_count = holy_ability_count
      cbr_preflight_clab_capped_shape  = clab_capped_shape
      cbr_preflight_bridge_status = bridge_status
      cbr_preflight_divine_cleanup_status = divine_cleanup_status
  END

  ACTION_IF (~%phase%~ STR_EQ ~classify~) BEGIN
    PRINT ~CBR Improved Haste %improved_haste_resref% classified as %cbr_improved_haste_semantics%.~
  END ELSE BEGIN
    LAF cbr_allocate_tempus_tables
      STR_VAR
        resource_dir                = EVAL ~%resource_dir%~
        improved_haste_semantics    = EVAL ~%cbr_improved_haste_semantics%~
      RET
        cbr_progression_str_lt_row       = str_lt_row
        cbr_progression_str_eq_row       = str_eq_row
        cbr_progression_str_bonus_lt_row = str_bonus_lt_row
        cbr_bridge_ih_state = ih_state
        cbr_bridge_apr_half_state = apr_half_state
        cbr_bridge_apr_one_state = apr_one_state
        cbr_bridge_apr_one_half_state = apr_one_half_state
        cbr_bridge_active_state_row = active_state_row
    END
    ACTION_IF (~%phase%~ STR_EQ ~allocate~) BEGIN
      PRINT ~CBR allocated collision-safe Tempus SPLSTATE.IDS values and SPLPROT.2DA semantics.~
    END ELSE BEGIN
      LAF cbr_apply_tempus_progression
        INT_VAR
          holy_ability_count = cbr_preflight_holy_ability_count
          clab_capped_shape  = cbr_preflight_clab_capped_shape
          str_lt_row         = cbr_progression_str_lt_row
          str_eq_row         = cbr_progression_str_eq_row
          str_bonus_lt_row   = cbr_progression_str_bonus_lt_row
        STR_VAR
          resource_dir        = EVAL ~%resource_dir%~
          divine_power_resref = EVAL ~%divine_power_resref%~
      END
      ACTION_IF (~%phase%~ STR_EQ ~progression~) BEGIN
        PRINT ~CBR applied the 30-level Tempus Holy Power progression and five-use CLAB cap.~
      END ELSE BEGIN
        LAF cbr_apply_tempus_bridge
          INT_VAR
            bridge_status = cbr_preflight_bridge_status
            divine_cleanup_status = cbr_preflight_divine_cleanup_status
            ih_state = cbr_bridge_ih_state
            apr_half_state = cbr_bridge_apr_half_state
            apr_one_state = cbr_bridge_apr_one_state
            apr_one_half_state = cbr_bridge_apr_one_half_state
            active_state_row = cbr_bridge_active_state_row
          STR_VAR
            resource_dir = EVAL ~%resource_dir%~
            improved_haste_semantics = EVAL ~%cbr_improved_haste_semantics%~
            improved_haste_resref = EVAL ~%improved_haste_resref%~
            divine_power_resref = EVAL ~%divine_power_resref%~
        END
        PRINT ~CBR applied the Tempus Holy Power interaction bridge and reciprocal Divine Power cleanup.~
      END
    END
  END
END
