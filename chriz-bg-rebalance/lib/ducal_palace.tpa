// Ducal Palace Coronation (AR0108 / BG0108) hostility and Confusion fix.
// Replaces single-attack betrayal triggers with a confused-attacker guard plus
// single-hit friendly-fire tolerance, and ensures Belt and Liia carry real
// Confusion (128), Fear (24), and Charm (5 / 241) immunities on both CRE V1 and V2.

DEFINE_PATCH_FUNCTION cbr_dp_strip_betrayal_blocks BEGIN
  SET cbr_dp_pos = 0
  WHILE (cbr_dp_pos >= 0 && cbr_dp_pos < BUFFER_LENGTH) BEGIN
    SET cbr_dp_start = INDEX_BUFFER (~^IF[ %TAB%]*\(%MNL%?%LNL%\)~ cbr_dp_pos)
    PATCH_IF (cbr_dp_start < 0) BEGIN
      SET cbr_dp_pos = 0 - 1
    END ELSE BEGIN
      SET cbr_dp_end = INDEX_BUFFER (~^END[ %TAB%]*\(%MNL%?%LNL%\|$\)~ cbr_dp_start)
      PATCH_IF (cbr_dp_end < 0) BEGIN
        SET cbr_dp_pos = 0 - 1
      END ELSE BEGIN
        SET cbr_dp_after = cbr_dp_end + 3
        WHILE (cbr_dp_after < BUFFER_LENGTH && (BYTE_AT cbr_dp_after = 0x20 || BYTE_AT cbr_dp_after = 0x09)) BEGIN
          SET cbr_dp_after += 1
        END
        PATCH_IF (cbr_dp_after < BUFFER_LENGTH && BYTE_AT cbr_dp_after = 0x0d) BEGIN
          SET cbr_dp_after += 1
        END
        PATCH_IF (cbr_dp_after < BUFFER_LENGTH && BYTE_AT cbr_dp_after = 0x0a) BEGIN
          SET cbr_dp_after += 1
        END
        READ_ASCII cbr_dp_start cbr_dp_block (cbr_dp_after - cbr_dp_start)
        TO_UPPER cbr_dp_block
        SET cbr_dp_is_ours = ((~%cbr_dp_block%~ STRING_CONTAINS_REGEXP ~CBR_DUCALFF~) = 0)
        SET cbr_dp_is_betrayal = ((~%cbr_dp_block%~ STRING_CONTAINS_REGEXP ~SETGLOBAL("SAREVOKBEHAVIOR","GLOBAL",3)~) = 0)
                              && ((~%cbr_dp_block%~ STRING_CONTAINS_REGEXP ~ATTACKEDBY(~) = 0)
        PATCH_IF (cbr_dp_is_ours || cbr_dp_is_betrayal) BEGIN
          DELETE_BYTES cbr_dp_start (cbr_dp_after - cbr_dp_start)
          SET cbr_dp_pos = cbr_dp_start
        END ELSE BEGIN
          SET cbr_dp_pos = cbr_dp_after
        END
      END
    END
  END
END

// Append an embedded effect without calling WeiDU's ADD_CRE_EFFECT, which in
// WeiDU 24900 downgrades CRE 0x33 = 1 (V2 effects) to V1 and drops unrelated V2 effects.
DEFINE_PATCH_FUNCTION cbr_dp_add_cre_effect
  INT_VAR
    opcode        = 0
    target        = 1
    power         = 0
    parameter1    = 0
    parameter2    = 0
    timing        = 9
    resist_dispel = 0
    duration      = 0
    probability1  = 100
    probability2  = 0
    special       = 0
BEGIN
  PATCH_IF (BUFFER_LENGTH >= 0x2d4) BEGIN
    READ_BYTE 0x33 cbr_dp_fx_ver
    SET cbr_dp_stride = (cbr_dp_fx_ver = 1) ? 0x108 : 0x30
    READ_LONG 0x2c4 cbr_dp_fx_off
    READ_LONG 0x2c8 cbr_dp_fx_cnt
    PATCH_IF (cbr_dp_fx_cnt = 0 AND cbr_dp_fx_off = 0) BEGIN
      SET cbr_dp_fx_off = BUFFER_LENGTH
      WRITE_LONG 0x2c4 cbr_dp_fx_off
    END
    PATCH_IF (cbr_dp_fx_off >= 0x2d4 AND cbr_dp_fx_off + cbr_dp_fx_cnt * cbr_dp_stride <= BUFFER_LENGTH) BEGIN
      SET cbr_dp_ins = cbr_dp_fx_off + cbr_dp_fx_cnt * cbr_dp_stride
      INSERT_BYTES cbr_dp_ins cbr_dp_stride
      PATCH_IF (cbr_dp_fx_ver = 1) BEGIN
        WRITE_LONG  (cbr_dp_ins + 0x08) opcode
        WRITE_LONG  (cbr_dp_ins + 0x0c) target
        WRITE_LONG  (cbr_dp_ins + 0x10) power
        WRITE_LONG  (cbr_dp_ins + 0x14) parameter1
        WRITE_LONG  (cbr_dp_ins + 0x18) parameter2
        WRITE_LONG  (cbr_dp_ins + 0x1c) timing
        WRITE_LONG  (cbr_dp_ins + 0x20) duration
        WRITE_SHORT (cbr_dp_ins + 0x24) probability1
        WRITE_SHORT (cbr_dp_ins + 0x26) probability2
        WRITE_LONG  (cbr_dp_ins + 0x54) resist_dispel
        WRITE_LONG  (cbr_dp_ins + 0x40) special
      END ELSE BEGIN
        WRITE_SHORT (cbr_dp_ins + 0x00) opcode
        WRITE_BYTE  (cbr_dp_ins + 0x02) target
        WRITE_BYTE  (cbr_dp_ins + 0x03) power
        WRITE_LONG  (cbr_dp_ins + 0x04) parameter1
        WRITE_LONG  (cbr_dp_ins + 0x08) parameter2
        WRITE_BYTE  (cbr_dp_ins + 0x0c) timing
        WRITE_BYTE  (cbr_dp_ins + 0x0d) resist_dispel
        WRITE_LONG  (cbr_dp_ins + 0x0e) duration
        WRITE_BYTE  (cbr_dp_ins + 0x12) probability1
        WRITE_BYTE  (cbr_dp_ins + 0x13) probability2
        WRITE_LONG  (cbr_dp_ins + 0x2c) special
      END
      WRITE_LONG 0x2c8 (cbr_dp_fx_cnt + 1)
      PATCH_FOR_EACH cbr_dp_hdr IN 0x2a0 0x2a8 0x2b0 0x2b8 0x2bc BEGIN
        READ_LONG cbr_dp_hdr cbr_dp_sec
        PATCH_IF (cbr_dp_sec >= cbr_dp_ins) BEGIN
          WRITE_LONG cbr_dp_hdr (cbr_dp_sec + cbr_dp_stride)
        END
      END
    END ELSE BEGIN
      PATCH_PRINT ~CBR 102: %SOURCE_FILE% has unreadable effect bounds; skipping effect add.~
    END
  END
END

DEFINE_ACTION_FUNCTION cbr_install_ducal_palace_fix BEGIN
  OUTER_SET cbr_dp_st_confusion = IDS_OF_SYMBOL (~splstate~ ~CONFUSION_IMMUNITY~)
  OUTER_SET cbr_dp_st_panic     = IDS_OF_SYMBOL (~splstate~ ~PANIC_IMMUNITY~)
  OUTER_SET cbr_dp_st_charm     = IDS_OF_SYMBOL (~splstate~ ~CHARM_IMMUNITY~)

  ACTION_FOR_EACH cbr_dp_cre IN BELT LIIA BEGIN
    ACTION_IF FILE_EXISTS_IN_GAME ~%cbr_dp_cre%.cre~ BEGIN
      COPY_EXISTING ~%cbr_dp_cre%.cre~ ~override~
        PATCH_IF (BUFFER_LENGTH >= 0x2d4) BEGIN
          // Remove SCS's typo op101 p2=148 (Cast Spell at Point) and deduplicate target immunities.
          PATCH_FOR_EACH cbr_dp_p2 IN 148 128 24 5 241 BEGIN
            LPF DELETE_EFFECT INT_VAR silent = 1 match_opcode = 101 match_parameter2 = cbr_dp_p2 END
          END
          PATCH_FOR_EACH cbr_dp_icon IN 0 1 2 3 36 BEGIN
            LPF DELETE_EFFECT INT_VAR silent = 1 match_opcode = 169 match_parameter2 = cbr_dp_icon END
          END
          PATCH_FOR_EACH cbr_dp_st IN ~%cbr_dp_st_confusion%~ ~%cbr_dp_st_panic%~ ~%cbr_dp_st_charm%~ BEGIN
            PATCH_IF (cbr_dp_st >= 0) BEGIN
              LPF DELETE_EFFECT INT_VAR silent = 1 match_opcode = 328 match_parameter2 = cbr_dp_st END
            END
          END

          PATCH_FOR_EACH cbr_dp_p2 IN 128 24 5 241 BEGIN
            LPF cbr_dp_add_cre_effect INT_VAR opcode = 101 target = 1 timing = 9 parameter2 = cbr_dp_p2 resist_dispel = 0 probability1 = 100 END
          END
          PATCH_FOR_EACH cbr_dp_icon IN 0 1 2 3 36 BEGIN
            LPF cbr_dp_add_cre_effect INT_VAR opcode = 169 target = 1 timing = 9 parameter2 = cbr_dp_icon resist_dispel = 0 probability1 = 100 END
          END
          PATCH_FOR_EACH cbr_dp_st IN ~%cbr_dp_st_confusion%~ ~%cbr_dp_st_panic%~ ~%cbr_dp_st_charm%~ BEGIN
            PATCH_IF (cbr_dp_st >= 0) BEGIN
              LPF cbr_dp_add_cre_effect INT_VAR opcode = 328 target = 1 timing = 9 parameter2 = cbr_dp_st special = 1 resist_dispel = 0 probability1 = 100 END
            END
          END
        END ELSE BEGIN
          PATCH_PRINT ~CBR 102: %cbr_dp_cre%.cre is unreadable; continuing.~
        END
    END ELSE BEGIN
      PRINT ~CBR 102: %cbr_dp_cre%.cre is absent; continuing.~
    END
  END

  OUTER_SPRINT cbr_dp_duke_header ~IF
  AttackedBy([PC],DEFAULT)
  !StateCheck(LastAttackerOf(Myself),STATE_CONFUSED)
  !Global("SarevokBehavior","GLOBAL",3)
  Global("CBR_DucalFF","MYAREA",0)
THEN
  RESPONSE #100
    SetGlobal("CBR_DucalFF","MYAREA",1)
    SetGlobalTimer("CBR_DucalFF_CD","MYAREA",6)
END

IF
  AttackedBy([PC],DEFAULT)
  !StateCheck(LastAttackerOf(Myself),STATE_CONFUSED)
  !Global("SarevokBehavior","GLOBAL",3)
  Global("CBR_DucalFF","MYAREA",1)
  GlobalTimerExpired("CBR_DucalFF_CD","MYAREA")
THEN
  RESPONSE #100
    SetGlobal("SarevokBehavior","GLOBAL",3)
END
%LNL%~
  OUTER_SET cbr_dp_duke_len = STRING_LENGTH ~%cbr_dp_duke_header%~

  ACTION_FOR_EACH cbr_dp_bcs IN BELT LIIA BEGIN
    ACTION_IF FILE_EXISTS_IN_GAME ~%cbr_dp_bcs%.bcs~ BEGIN
      COPY_EXISTING ~%cbr_dp_bcs%.bcs~ ~override~
        DECOMPILE_AND_PATCH BEGIN
          LPF cbr_dp_strip_betrayal_blocks END
          INSERT_BYTES 0 cbr_dp_duke_len
          WRITE_ASCIIE 0 ~%cbr_dp_duke_header%~ (cbr_dp_duke_len)
        END
    END ELSE BEGIN
      PRINT ~CBR 102: %cbr_dp_bcs%.bcs is absent; continuing.~
    END
  END

  ACTION_IF (GAME_IS ~eet~) BEGIN
    OUTER_SPRINT cbr_dp_area ~BG0108~
    OUTER_SPRINT cbr_dp_sarevok_bcs ~SAREVOK_~
  END ELSE BEGIN
    OUTER_SPRINT cbr_dp_area ~AR0108~
    OUTER_SPRINT cbr_dp_sarevok_bcs ~SAREVOK~
  END

  ACTION_IF FILE_EXISTS_IN_GAME ~SAREVO2.CRE~ BEGIN
    COPY_EXISTING - ~SAREVO2.CRE~ ~override~
      PATCH_IF (BUFFER_LENGTH >= 0x250) BEGIN
        READ_ASCII 0x248 cbr_dp_cre_scr (8) NULL
        PATCH_IF (!(~%cbr_dp_cre_scr%~ STR_EQ ~~) && !(~%cbr_dp_cre_scr%~ STRING_EQUAL_CASE ~None~)) BEGIN
          SPRINT cbr_dp_sarevok_bcs ~%cbr_dp_cre_scr%~
        END
      END
  END

  OUTER_SPRINT cbr_dp_sarevok_header ~IF
  AreaCheck("%cbr_dp_area%")
  Allegiance(Myself,NEUTRAL)
  AttackedBy([PC],DEFAULT)
  !StateCheck(LastAttackerOf(Myself),STATE_CONFUSED)
  !Global("SarevokBehavior","GLOBAL",3)
  Global("CBR_DucalFF","MYAREA",0)
THEN
  RESPONSE #100
    SetGlobal("CBR_DucalFF","MYAREA",1)
    SetGlobalTimer("CBR_DucalFF_CD","MYAREA",6)
END

IF
  AreaCheck("%cbr_dp_area%")
  Allegiance(Myself,NEUTRAL)
  AttackedBy([PC],DEFAULT)
  !StateCheck(LastAttackerOf(Myself),STATE_CONFUSED)
  !Global("SarevokBehavior","GLOBAL",3)
  Global("CBR_DucalFF","MYAREA",1)
  GlobalTimerExpired("CBR_DucalFF_CD","MYAREA")
THEN
  RESPONSE #100
    SetGlobal("SarevokBehavior","GLOBAL",3)
END
%LNL%~
  OUTER_SET cbr_dp_sarevok_len = STRING_LENGTH ~%cbr_dp_sarevok_header%~

  ACTION_IF FILE_EXISTS_IN_GAME ~%cbr_dp_sarevok_bcs%.bcs~ BEGIN
    COPY_EXISTING ~%cbr_dp_sarevok_bcs%.bcs~ ~override~
      DECOMPILE_AND_PATCH BEGIN
        LPF cbr_dp_strip_betrayal_blocks END
        INSERT_BYTES 0 cbr_dp_sarevok_len
        WRITE_ASCIIE 0 ~%cbr_dp_sarevok_header%~ (cbr_dp_sarevok_len)
      END
  END ELSE BEGIN
    PRINT ~CBR 102: %cbr_dp_sarevok_bcs%.bcs is absent; continuing.~
  END
END
