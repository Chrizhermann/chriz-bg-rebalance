BACKUP ~weidu_external/backup/cbr_sr_antimagic~
AUTHOR ~Christopher Hermann (github.com/Chrizhermann/chriz-bg-rebalance)~
VERSION ~v0.8.10~
ALWAYS
  INCLUDE ~CBR_SR_ANTIMAGIC/lib/sr_antimagic.tpa~
  INCLUDE ~CBR_SR_ANTIMAGIC/lib/sr_spellstrike.tpa~
END
LANGUAGE ~English~ ~english~ ~CBR_SR_ANTIMAGIC/languages/english/setup.tra~

BEGIN @210 DESIGNATED 210 LABEL ~cbr_sr_pierce_magic_tail~
REQUIRE_PREDICATE (GAME_IS ~bg2ee eet~) @9210
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~M___EEex.lua~) @9212
REQUIRE_PREDICATE NOT (MOD_IS_INSTALLED ~setup-chriz-bg-rebalance.tp2~ 210) @9213
LAF cbr_install_sr_antimagic INT_VAR component = 210
  STR_VAR runtime_file = ~CBR_SR_ANTIMAGIC/lua/M_CBRPM.lua~ END

BEGIN @211 DESIGNATED 211 LABEL ~cbr_sr_spellstrike_tail~
REQUIRE_PREDICATE (GAME_IS ~bg2ee eet~) @9210
REQUIRE_PREDICATE NOT (MOD_IS_INSTALLED ~setup-chriz-bg-rebalance.tp2~ 211) @9213
LAF cbr_install_sr_antimagic INT_VAR component = 211 END

// Texts only, for an installation that already has the changed mechanic from
// any source (the main installer, this tail's 210/211, a private tail). Nothing
// but descriptions changes: the spell's, scrolls', wands' and sibling spells'.
BEGIN @212 DESIGNATED 212 LABEL ~cbr_sr_pierce_magic_texts_tail~
REQUIRE_PREDICATE (GAME_IS ~bg2ee eet~) @9210
LAF cbr_refresh_sr_antimagic_texts INT_VAR component = 210 END

BEGIN @213 DESIGNATED 213 LABEL ~cbr_sr_spellstrike_texts_tail~
REQUIRE_PREDICATE (GAME_IS ~bg2ee eet~) @9210
LAF cbr_refresh_sr_antimagic_texts INT_VAR component = 211 END
