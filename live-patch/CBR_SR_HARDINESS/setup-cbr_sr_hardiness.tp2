BACKUP ~weidu_external/backup/cbr_sr_hardiness~
AUTHOR ~Christopher Hermann (github.com/Chrizhermann/chriz-bg-rebalance)~
VERSION ~v0.8.1~
ALWAYS
  INCLUDE ~CBR_SR_HARDINESS/lib/sr_hardiness.tpa~
END
LANGUAGE ~English~ ~english~ ~CBR_SR_HARDINESS/languages/english/setup.tra~

BEGIN @200 DESIGNATED 200 SUBCOMPONENT @1201 LABEL ~cbr_sr_hardiness_tail_40~
REQUIRE_PREDICATE (GAME_IS ~bg2ee eet~) @9200
REQUIRE_PREDICATE (MOD_IS_INSTALLED ~spell_rev/setup-spell_rev.tp2~ 65) @9201
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~spcl907.spl~ AND FILE_EXISTS_IN_GAME ~spwish12.spl~) @9202
REQUIRE_PREDICATE NOT ((MOD_IS_INSTALLED ~setup-chriz-bg-rebalance.tp2~ 200)
  OR (MOD_IS_INSTALLED ~setup-chriz-bg-rebalance.tp2~ 201)
  OR (MOD_IS_INSTALLED ~setup-chriz-bg-rebalance.tp2~ 202)) @9203
LAF cbr_install_sr_hardiness INT_VAR physical = 40 extra_resistance = 0 END

BEGIN @201 DESIGNATED 201 SUBCOMPONENT @1201 LABEL ~cbr_sr_hardiness_tail_30~
REQUIRE_PREDICATE (GAME_IS ~bg2ee eet~) @9200
REQUIRE_PREDICATE (MOD_IS_INSTALLED ~spell_rev/setup-spell_rev.tp2~ 65) @9201
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~spcl907.spl~ AND FILE_EXISTS_IN_GAME ~spwish12.spl~) @9202
REQUIRE_PREDICATE NOT ((MOD_IS_INSTALLED ~setup-chriz-bg-rebalance.tp2~ 200)
  OR (MOD_IS_INSTALLED ~setup-chriz-bg-rebalance.tp2~ 201)
  OR (MOD_IS_INSTALLED ~setup-chriz-bg-rebalance.tp2~ 202)) @9203
LAF cbr_install_sr_hardiness INT_VAR physical = 30 extra_resistance = 0 END

BEGIN @202 DESIGNATED 202 LABEL ~cbr_sr_hardiness_tail_extra_resistance~
REQUIRE_PREDICATE (GAME_IS ~bg2ee eet~) @9200
REQUIRE_PREDICATE (MOD_IS_INSTALLED ~spell_rev/setup-spell_rev.tp2~ 65) @9201
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~spcl907.spl~ AND FILE_EXISTS_IN_GAME ~spwish12.spl~) @9202
REQUIRE_PREDICATE ((MOD_IS_INSTALLED ~cbr_sr_hardiness/setup-cbr_sr_hardiness.tp2~ 200)
  OR (MOD_IS_INSTALLED ~cbr_sr_hardiness/setup-cbr_sr_hardiness.tp2~ 201)) @9204
REQUIRE_PREDICATE NOT ((MOD_IS_INSTALLED ~setup-chriz-bg-rebalance.tp2~ 200)
  OR (MOD_IS_INSTALLED ~setup-chriz-bg-rebalance.tp2~ 201)
  OR (MOD_IS_INSTALLED ~setup-chriz-bg-rebalance.tp2~ 202)) @9203
ACTION_IF (MOD_IS_INSTALLED ~cbr_sr_hardiness/setup-cbr_sr_hardiness.tp2~ 201) BEGIN
  LAF cbr_install_sr_hardiness INT_VAR physical = 30 extra_resistance = 20 END
END ELSE BEGIN
  LAF cbr_install_sr_hardiness INT_VAR physical = 40 extra_resistance = 20 END
END
