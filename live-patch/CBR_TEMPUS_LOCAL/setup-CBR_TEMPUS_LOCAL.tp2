BACKUP ~backup~
AUTHOR ~Christopher Hermann / local playthrough hotfix~
VERSION ~2026-07-14-local~

BEGIN ~Build TLK-neutral Cleric of Tempus local override resources~ DESIGNATED 0

// This builder is deliberately run with --nogame against copied input files.
// It never opens the live game or dialog.tlk. Its verified output is copied into
// override only after the build passes the semantic checks.

// Resolve the existing proficiency-equals-N SPLPROT rows used by Artisan's
// proficiency implementation. VALUE=-1 means opcode 326 supplies the value in p1;
// p1=0 therefore means "apply only when this proficiency is zero".
OUTER_SET cbr_prof_90_row = 0 - 1
OUTER_SET cbr_prof_92_row = 0 - 1
OUTER_SET cbr_prof_103_row = 0 - 1

COPY ~input/SPLPROT.2DA~ ~output/SPLPROT.2DA~
  COUNT_2DA_COLS cbr_sp_cols
  READ_2DA_ENTRIES_NOW cbr_sp_rows cbr_sp_cols
  FOR (row = 1; row < cbr_sp_rows; ++row) BEGIN
    READ_2DA_ENTRY_FORMER cbr_sp_rows row 0 ~cbr_sp_name~
    PATCH_IF (~%cbr_sp_name%~ STRING_EQUAL_CASE ~prof_90~)
          OR (~%cbr_sp_name%~ STRING_EQUAL_CASE ~prof_92~)
          OR (~%cbr_sp_name%~ STRING_EQUAL_CASE ~prof_103~) BEGIN
      READ_2DA_ENTRY_FORMER cbr_sp_rows row 1 ~cbr_sp_stat~
      READ_2DA_ENTRY_FORMER cbr_sp_rows row 2 ~cbr_sp_value~
      READ_2DA_ENTRY_FORMER cbr_sp_rows row 3 ~cbr_sp_relation~
      PATCH_IF NOT (~%cbr_sp_value%~ STRING_EQUAL ~-1~)
            OR NOT (~%cbr_sp_relation%~ STRING_EQUAL ~1~) BEGIN
        PATCH_FAIL ~CBR Tempus local: %cbr_sp_name% is not the expected VALUE=-1 RELATION=1 equality row.~
      END
      PATCH_IF ~%cbr_sp_name%~ STRING_EQUAL_CASE ~prof_90~ BEGIN
        PATCH_IF NOT (~%cbr_sp_stat%~ STRING_EQUAL ~90~) BEGIN
          PATCH_FAIL ~CBR Tempus local: prof_90 does not check stat 90.~
        END
        SET cbr_prof_90_row = row
      END ELSE PATCH_IF ~%cbr_sp_name%~ STRING_EQUAL_CASE ~prof_92~ BEGIN
        PATCH_IF NOT (~%cbr_sp_stat%~ STRING_EQUAL ~92~) BEGIN
          PATCH_FAIL ~CBR Tempus local: prof_92 does not check stat 92.~
        END
        SET cbr_prof_92_row = row
      END ELSE BEGIN
        PATCH_IF NOT (~%cbr_sp_stat%~ STRING_EQUAL ~103~) BEGIN
          PATCH_FAIL ~CBR Tempus local: prof_103 does not check stat 103.~
        END
        SET cbr_prof_103_row = row
      END
    END
  END
  PATCH_IF (cbr_prof_90_row < 0) OR (cbr_prof_92_row < 0) OR (cbr_prof_103_row < 0) BEGIN
    PATCH_FAIL ~CBR Tempus local: prof_90 / prof_92 / prof_103 rows were not all found in SPLPROT.2DA.~
  END

// Set the OHTEMPUS cap to 2 for every standard BG2 weapon already allowed to
// either a normal cleric or Tempus, plus longsword/axe/crossbow, and all styles.
// Legacy BG1 composites and EXTRA custom-stat rows are intentionally untouched.
COPY ~input/WEAPPROF.2DA~ ~output/WEAPPROF.2DA~
  COUNT_2DA_COLS cbr_wp_cols
  READ_2DA_ENTRIES_NOW cbr_wp_rows 1
  SET cbr_cleric_col = 0 - 1
  SET cbr_tempus_col = 0 - 1
  SET cbr_standard_found = 0
  SET cbr_styles_found = 0
  FOR (row = 0; row < cbr_wp_rows; ++row) BEGIN
    READ_2DA_ENTRY_FORMER cbr_wp_rows row 0 ~cbr_wp_name~
    PATCH_IF ~%cbr_wp_name%~ STRING_EQUAL_CASE ~ID~ BEGIN
      // Data rows have the extra leading row label; the declared header does not.
      FOR (col = 1; col < (cbr_wp_cols - 1); ++col) BEGIN
        READ_2DA_ENTRY_FORMER cbr_wp_rows row col ~cbr_wp_header~
        PATCH_IF ~%cbr_wp_header%~ STRING_EQUAL_CASE ~CLERIC~ BEGIN
          SET cbr_cleric_col = col + 1
        END ELSE PATCH_IF ~%cbr_wp_header%~ STRING_EQUAL_CASE ~OHTEMPUS~ BEGIN
          SET cbr_tempus_col = col + 1
        END
      END
    END
  END
  PATCH_IF (cbr_cleric_col < 0) OR (cbr_tempus_col < 0) BEGIN
    PATCH_FAIL ~CBR Tempus local: CLERIC or OHTEMPUS column not found in WEAPPROF.2DA.~
  END
  FOR (row = 0; row < cbr_wp_rows; ++row) BEGIN
    READ_2DA_ENTRY_FORMER cbr_wp_rows row 0 ~cbr_wp_name~
    SET cbr_is_standard = 0
    SET cbr_is_explicit = 0
    SET cbr_is_style = 0
    PATCH_IF (~%cbr_wp_name%~ STRING_EQUAL_CASE ~BASTARDSWORD~)
          OR (~%cbr_wp_name%~ STRING_EQUAL_CASE ~LONGSWORD~)
          OR (~%cbr_wp_name%~ STRING_EQUAL_CASE ~SHORTSWORD~)
          OR (~%cbr_wp_name%~ STRING_EQUAL_CASE ~AXE~)
          OR (~%cbr_wp_name%~ STRING_EQUAL_CASE ~TWOHANDEDSWORD~)
          OR (~%cbr_wp_name%~ STRING_EQUAL_CASE ~KATANA~)
          OR (~%cbr_wp_name%~ STRING_EQUAL_CASE ~SCIMITARWAKISASHININJATO~)
          OR (~%cbr_wp_name%~ STRING_EQUAL_CASE ~DAGGER~)
          OR (~%cbr_wp_name%~ STRING_EQUAL_CASE ~WARHAMMER~)
          OR (~%cbr_wp_name%~ STRING_EQUAL_CASE ~CLUB~)
          OR (~%cbr_wp_name%~ STRING_EQUAL_CASE ~SPEAR~)
          OR (~%cbr_wp_name%~ STRING_EQUAL_CASE ~HALBERD~)
          OR (~%cbr_wp_name%~ STRING_EQUAL_CASE ~FLAILMORNINGSTAR~)
          OR (~%cbr_wp_name%~ STRING_EQUAL_CASE ~MACE~)
          OR (~%cbr_wp_name%~ STRING_EQUAL_CASE ~QUARTERSTAFF~)
          OR (~%cbr_wp_name%~ STRING_EQUAL_CASE ~CROSSBOW~)
          OR (~%cbr_wp_name%~ STRING_EQUAL_CASE ~LONGBOW~)
          OR (~%cbr_wp_name%~ STRING_EQUAL_CASE ~SHORTBOW~)
          OR (~%cbr_wp_name%~ STRING_EQUAL_CASE ~DART~)
          OR (~%cbr_wp_name%~ STRING_EQUAL_CASE ~SLING~) BEGIN
      SET cbr_is_standard = 1
      SET cbr_standard_found += 1
    END
    PATCH_IF (~%cbr_wp_name%~ STRING_EQUAL_CASE ~LONGSWORD~)
          OR (~%cbr_wp_name%~ STRING_EQUAL_CASE ~AXE~)
          OR (~%cbr_wp_name%~ STRING_EQUAL_CASE ~CROSSBOW~) BEGIN
      SET cbr_is_explicit = 1
    END
    PATCH_IF (~%cbr_wp_name%~ STRING_EQUAL_CASE ~2HANDED~)
          OR (~%cbr_wp_name%~ STRING_EQUAL_CASE ~SWORDANDSHIELD~)
          OR (~%cbr_wp_name%~ STRING_EQUAL_CASE ~SINGLEWEAPON~)
          OR (~%cbr_wp_name%~ STRING_EQUAL_CASE ~2WEAPON~) BEGIN
      SET cbr_is_style = 1
      SET cbr_styles_found += 1
    END
    PATCH_IF cbr_is_standard BEGIN
      READ_2DA_ENTRY_FORMER cbr_wp_rows row cbr_cleric_col ~cbr_cleric_cap~
      READ_2DA_ENTRY_FORMER cbr_wp_rows row cbr_tempus_col ~cbr_tempus_cap~
      PATCH_IF (IS_AN_INT ~%cbr_cleric_cap%~) AND (IS_AN_INT ~%cbr_tempus_cap%~) BEGIN
        PATCH_IF (%cbr_cleric_cap% > 0) OR (%cbr_tempus_cap% > 0) OR cbr_is_explicit BEGIN
          SET_2DA_ENTRY_LATER ~cbr_wp_write~ row cbr_tempus_col ~2~
        END
      END ELSE BEGIN
        PATCH_FAIL ~CBR Tempus local: non-numeric proficiency cap on row %cbr_wp_name%.~
      END
    END ELSE PATCH_IF cbr_is_style BEGIN
      SET_2DA_ENTRY_LATER ~cbr_wp_write~ row cbr_tempus_col ~2~
    END
  END
  PATCH_IF (cbr_standard_found != 20) OR (cbr_styles_found != 4) BEGIN
    PATCH_FAIL ~CBR Tempus local: expected 20 BG2 weapon rows and 4 style rows, found %cbr_standard_found% and %cbr_styles_found%.~
  END
  SET_2DA_ENTRIES_NOW ~cbr_wp_write~ 1

// Normalize the Tempus-specific Artisan grant. Crossbow equipment permission is
// already supplied by the shared cleric dispatcher; C4 owns longsword + axe
// permission and one starter pip in longsword, axe, and crossbow.
COPY ~input/C0PR#C4.SPL~ ~output/C0PR#C4.SPL~
  PATCH_IF SOURCE_SIZE < 0x9a BEGIN
    PATCH_FAIL ~CBR Tempus local: C0PR#C4.SPL is too small to be a valid one-header SPL.~
  END
  READ_ASCII 0x00 ~cbr_spl_sig~ (4)
  READ_SHORT 0x68 cbr_spl_headers
  PATCH_IF NOT (~%cbr_spl_sig%~ STRING_EQUAL ~SPL ~) OR (cbr_spl_headers != 1) BEGIN
    PATCH_FAIL ~CBR Tempus local: C0PR#C4.SPL has an unexpected signature/header layout.~
  END
  LPF DELETE_EFFECT INT_VAR match_opcode = 326 STR_VAR match_resource = ~C0PR#90~ END
  LPF DELETE_EFFECT INT_VAR match_opcode = 326 STR_VAR match_resource = ~C0PR#103~ END
  LPF DELETE_EFFECT INT_VAR match_opcode = 233 match_parameter2 = 90 END
  LPF DELETE_EFFECT INT_VAR match_opcode = 233 match_parameter2 = 103 END
  LPF CLONE_EFFECT
    INT_VAR match_opcode = 326 match_parameter1 = 0 match_parameter2 = 0 multi_match = 1
    STR_VAR match_resource = ~C0PR#92~ resource = ~C0PR#90~ insert = ~last~
  END
  LPF CLONE_EFFECT
    INT_VAR match_opcode = 233 match_parameter1 = 1 match_parameter2 = 92 match_timing = 9
            parameter2 = 90 multi_match = 1
    STR_VAR insert = ~last~
  END
  LPF CLONE_EFFECT
    INT_VAR match_opcode = 233 match_parameter1 = 1 match_parameter2 = 92 match_timing = 9
            parameter2 = 103 multi_match = 1
    STR_VAR insert = ~last~
  END

// Three conditional pip children. Each contains only one permanent opcode-233
// starter point; CBRTMIG invokes it only when the current proficiency equals 0.
COPY ~output/C0PR#C4.SPL~ ~output/CBRTM90.SPL~
  LPF DELETE_EFFECT INT_VAR match_opcode = 326 END
  LPF DELETE_EFFECT INT_VAR match_opcode = 233 match_parameter2 = 92 END
  LPF DELETE_EFFECT INT_VAR match_opcode = 233 match_parameter2 = 103 END

COPY ~output/C0PR#C4.SPL~ ~output/CBRTM92.SPL~
  LPF DELETE_EFFECT INT_VAR match_opcode = 326 END
  LPF DELETE_EFFECT INT_VAR match_opcode = 233 match_parameter2 = 90 END
  LPF DELETE_EFFECT INT_VAR match_opcode = 233 match_parameter2 = 103 END

COPY ~output/C0PR#C4.SPL~ ~output/CBRTM103.SPL~
  LPF DELETE_EFFECT INT_VAR match_opcode = 326 END
  LPF DELETE_EFFECT INT_VAR match_opcode = 233 match_parameter2 = 90 END
  LPF DELETE_EFFECT INT_VAR match_opcode = 233 match_parameter2 = 92 END

// Parent migration spell: refresh the three self-cleaning Artisan permissions,
// then add each starter point only when its actual proficiency stat is zero.
COPY ~output/C0PR#C4.SPL~ ~output/CBRTMIG.SPL~
  LPF DELETE_EFFECT INT_VAR match_opcode = 233 END
  LPF CLONE_EFFECT
    INT_VAR match_opcode = 326 match_parameter1 = 0 match_parameter2 = 0 multi_match = 1
    STR_VAR match_resource = ~C0PR#92~ resource = ~C0PR#103~ insert = ~last~
  END
  LPF CLONE_EFFECT
    INT_VAR match_opcode = 326 match_parameter1 = 0 match_parameter2 = 0
            parameter2 = cbr_prof_90_row multi_match = 1
    STR_VAR match_resource = ~C0PR#92~ resource = ~CBRTM90~ insert = ~last~
  END
  LPF CLONE_EFFECT
    INT_VAR match_opcode = 326 match_parameter1 = 0 match_parameter2 = 0
            parameter2 = cbr_prof_92_row multi_match = 1
    STR_VAR match_resource = ~C0PR#92~ resource = ~CBRTM92~ insert = ~last~
  END
  LPF CLONE_EFFECT
    INT_VAR match_opcode = 326 match_parameter1 = 0 match_parameter2 = 0
            parameter2 = cbr_prof_103_row multi_match = 1
    STR_VAR match_resource = ~C0PR#92~ resource = ~CBRTM103~ insert = ~last~
  END
