BACKUP ~weidu_external/backup/cbr_round_clock~
AUTHOR ~Christopher Hermann (github.com/Chrizhermann/chriz-bg-rebalance)~
VERSION ~v0.8.11~
ALWAYS
  INCLUDE ~CBR_ROUND_CLOCK/lib/round_clock.tpa~
END
LANGUAGE ~English~ ~english~ ~CBR_ROUND_CLOCK/languages/english/setup.tra~

BEGIN @361 DESIGNATED 361 LABEL ~cbr_time_jump_round_cooldowns_standalone~
REQUIRE_PREDICATE (GAME_IS ~bgee bg2ee eet iwdee~) @9370
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~M___EEex.lua~) @9371
REQUIRE_PREDICATE NOT (MOD_IS_INSTALLED ~setup-chriz-bg-rebalance.tp2~ 361) @9376
LAF cbr_install_round_clock_component STR_VAR source_dir = ~CBR_ROUND_CLOCK/lua~ END
PRINT @9375
