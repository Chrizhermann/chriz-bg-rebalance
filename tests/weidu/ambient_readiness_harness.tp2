BACKUP ~backup~
AUTHOR ~CBR ambient-readiness synthetic harness~

ALWAYS
  INCLUDE ~%argv[0]%~ // shared weapon-immunity classifier
  INCLUDE ~%argv[1]%~ // ambient manifest compiler under test
END

BEGIN ~compile ambient readiness manifest~
DESIGNATED 0

LAF cbr_compile_ambient_readiness_manifest
  STR_VAR
    spell_table   = EVAL ~%argv[2]%~
    override_table = EVAL ~%argv[3]%~
    resource_dir  = EVAL ~%argv[4]%~
    spell_ids     = EVAL ~%argv[5]%~
    prebuff_map   = EVAL ~%argv[6]%~
    output_file   = EVAL ~%argv[7]%~
  RET
    cbr_test_ambient_count = ambient_count
    cbr_test_urgent_count = urgent_count
END

COPY ~%argv[7]%~ ~%argv[4]%/CBR_TEST.OK~
