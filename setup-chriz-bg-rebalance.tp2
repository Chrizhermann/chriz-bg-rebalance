BEGIN @200 DESIGNATED 200 SUBCOMPONENT @1201 GROUP @1200 LABEL ~cbr_sr_hardiness_40~
REQUIRE_PREDICATE (GAME_IS ~bg2ee eet~) @9200
REQUIRE_PREDICATE NOT ((MOD_IS_INSTALLED ~cbr_sr_hardiness/setup-cbr_sr_hardiness.tp2~ 200)
  OR (MOD_IS_INSTALLED ~cbr_sr_hardiness/setup-cbr_sr_hardiness.tp2~ 201)
  OR (MOD_IS_INSTALLED ~cbr_sr_hardiness/setup-cbr_sr_hardiness.tp2~ 202)) @9203
LAF cbr_install_sr_hardiness INT_VAR physical = 40 extra_resistance = 0 END

BEGIN @201 DESIGNATED 201 SUBCOMPONENT @1201 GROUP @1200 LABEL ~cbr_sr_hardiness_30~
REQUIRE_PREDICATE (GAME_IS ~bg2ee eet~) @9200
REQUIRE_PREDICATE NOT ((MOD_IS_INSTALLED ~cbr_sr_hardiness/setup-cbr_sr_hardiness.tp2~ 200)
