REQUIRE_PREDICATE ((FILE_EXISTS_IN_GAME ~SPELL.IDS~) AND (FILE_EXISTS_IN_GAME ~SPLSTATE.IDS~) AND (FILE_EXISTS_IN_GAME ~SPLPROT.2DA~)) @9407
REQUIRE_PREDICATE ((IDS_OF_SYMBOL (~spell~ ~CLERIC_HOLY_POWER~) >= 1100) AND (IDS_OF_SYMBOL (~spell~ ~CLERIC_HOLY_POWER~) <= 1999)) @9403
