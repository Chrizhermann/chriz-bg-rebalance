    kit_help_strref = cbr_ds_resolved_kit_help
    hp_desc_strref  = cbr_ds_resolved_hp_desc
    cob_desc_strref = cbr_ds_resolved_cob_desc
  STR_VAR resource_dir = ~override~
END

BEGIN @302 DESIGNATED 302 GROUP @1300 LABEL ~cbr_flail_of_ages_rebalance~
REQUIRE_PREDICATE (GAME_IS ~bg2ee eet~) @9480
CLEAR_IDS_MAP
OUTER_SPRINT cbr_f_haste ~~
OUTER_SPRINT cbr_f_improved ~~
OUTER_SET cbr_f_haste_id = IDS_OF_SYMBOL (~spell~ ~WIZARD_HASTE~)
OUTER_SET cbr_f_improved_id = IDS_OF_SYMBOL (~spell~ ~WIZARD_IMPROVED_HASTE~)
ACTION_IF (cbr_f_haste_id >= 2000 AND cbr_f_haste_id < 3000) BEGIN
  OUTER_SET cbr_f_number = cbr_f_haste_id - 2000
  OUTER_SPRINT cbr_f_haste ~SPWI%cbr_f_number%~
END
ACTION_IF (cbr_f_improved_id >= 2000 AND cbr_f_improved_id < 3000) BEGIN
  OUTER_SET cbr_f_number = cbr_f_improved_id - 2000
  OUTER_SPRINT cbr_f_improved ~SPWI%cbr_f_number%~
END
OUTER_SPRINT cbr_f_slow ~~
OUTER_SET cbr_f_slow_id = IDS_OF_SYMBOL (~spell~ ~WIZARD_SLOW~)
ACTION_IF (cbr_f_slow_id >= 2000 AND cbr_f_slow_id < 3000) BEGIN
  OUTER_SET cbr_f_number = cbr_f_slow_id - 2000
  OUTER_SPRINT cbr_f_slow ~SPWI%cbr_f_number%~
END
OUTER_SET cbr_f_haste_movement = 0
// Haste and Slow secondary types are MSECTYPE.2DA rows allocated at install
// time: SR's k1#Haste/k1#Slow on the spells themselves, SCS (without SR) its
// dw_persistent_16/40 on payloads cast by opcode 146 while the spells keep
// generic types. A type counts only if one side carries it and the other side
// removes it, so generic types such as Non-combat or Disabling never count.
LAF cbr_foa_spell_profile STR_VAR source = EVAL ~%cbr_f_haste%~
  RET cbr_f_h_types = types cbr_f_h_removed = removed cbr_f_h_checks = checks cbr_f_h_seen = seen END
LAF cbr_foa_spell_profile STR_VAR source = EVAL ~%cbr_f_improved%~
  RET cbr_f_i_types = types cbr_f_i_removed = removed cbr_f_i_checks = checks cbr_f_i_seen = seen END
LAF cbr_foa_spell_profile STR_VAR source = EVAL ~%cbr_f_slow%~
  RET cbr_f_s_types = types cbr_f_s_removed = removed cbr_f_slow_penalties = penalties END
LAF cbr_foa_set_intersection STR_VAR left = EVAL ~%cbr_f_h_types%%cbr_f_i_types%~ right = EVAL ~%cbr_f_s_removed%~
  RET cbr_f_haste_types = result END
LAF cbr_foa_set_intersection STR_VAR left = EVAL ~%cbr_f_s_types%~ right = EVAL ~%cbr_f_h_removed%%cbr_f_i_removed%~
  RET cbr_f_slow_types = result END
LAF cbr_foa_set_intersection STR_VAR left = EVAL ~%cbr_f_slow_penalties%~ right = EVAL ~%cbr_f_slow_penalties%~
  RET cbr_f_slow_penalties = result END
// Spell states the installed Haste spells check to refuse themselves (SCS:
// HASTE_IMMUNITY on every Haste and payload). Only their own resources count.
LAF cbr_foa_checked_splstates
  STR_VAR checks = EVAL ~%cbr_f_h_checks%%cbr_f_i_checks%~ owners = EVAL ~%cbr_f_h_seen%%cbr_f_i_seen%~
  RET cbr_f_haste_splstates = states END
OUTER_SET cbr_f_haste_immunity = IDS_OF_SYMBOL (~splstate~ ~HASTE_IMMUNITY~)
PRINT ~Flail of Ages: Haste types %cbr_f_haste_types%, Slow types %cbr_f_slow_types%, Slow penalties %cbr_f_slow_penalties%, Haste checks spell states %cbr_f_haste_splstates%.~
// A secondary-type label is not proof that Haste uses movement opcode 176.
// Inspect the actual canonical payloads before diagnosing an immunity conflict.
ACTION_FOR_EACH cbr_f_spell IN ~%cbr_f_haste%~ ~%cbr_f_improved%~ BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME ~%cbr_f_spell%.SPL~ BEGIN
    LAF cbr_foa_classify_resource INT_VAR search_opcode = 176
      STR_VAR source = EVAL ~%cbr_f_spell%~ RET kind END
    OUTER_SET cbr_f_haste_movement = cbr_f_haste_movement BOR kind
  END
END
ACTION_FOR_EACH cbr_f_item IN BLUN14 BLUN30C BLUN30D BLUN30 BEGIN
  OUTER_SET cbr_f_penalty = 4
  OUTER_SET cbr_f_allow = 0
  OUTER_SPRINT cbr_f_save_note @3022
  ACTION_IF (~%cbr_f_item%~ STRING_EQUAL ~BLUN14~) BEGIN
    OUTER_SET cbr_f_penalty = 2
    OUTER_SPRINT cbr_f_save_note @3021
  END ELSE ACTION_IF (~%cbr_f_item%~ STRING_EQUAL ~BLUN30~) BEGIN
    OUTER_SET cbr_f_penalty = 6
    OUTER_SET cbr_f_allow = 1
    OUTER_SPRINT cbr_f_save_note @3023
  END
  OUTER_SPRINT cbr_f_haste_note @3024
  ACTION_IF FILE_EXISTS_IN_GAME ~%cbr_f_item%.ITM~ BEGIN
  COPY_EXISTING ~%cbr_f_item%.ITM~ ~override~
    LPF cbr_foa_patch
      INT_VAR save_penalty = cbr_f_penalty allow_haste = cbr_f_allow haste_movement = cbr_f_haste_movement
        haste_immunity_state = cbr_f_haste_immunity
      STR_VAR haste_resref = EVAL ~%cbr_f_haste%~ improved_haste_resref = EVAL ~%cbr_f_improved%~
        haste_types = EVAL ~%cbr_f_haste_types%~ slow_types = EVAL ~%cbr_f_slow_types%~
        slow_penalties = EVAL ~%cbr_f_slow_penalties%~ haste_splstates = EVAL ~%cbr_f_haste_splstates%~
      RET slow_found
    END
    LPF cbr_foa_description
      INT_VAR allow_haste = cbr_f_allow slow_found
      STR_VAR save_note = EVAL ~%cbr_f_save_note%~ haste_note = EVAL ~%cbr_f_haste_note%~
    END
  BUT_ONLY
  END ELSE BEGIN PRINT ~CBR 302: %cbr_f_item%.ITM is absent; continuing.~ END
END

// Druids train and wield axes and short bows, fighter/druids also long
// bows. Works with and without Artisan's Kitpack permission system.
BEGIN @410 DESIGNATED 410 GROUP @1400 LABEL ~cbr_druid_weapon_access~
REQUIRE_PREDICATE (GAME_IS ~bg2ee eet~) @9490
OUTER_SET cbr_cwa_druid_class = IDS_OF_SYMBOL (~class~ ~DRUID~)
OUTER_SET cbr_cwa_fighter_druid_class = IDS_OF_SYMBOL (~class~ ~FIGHTER_DRUID~)
OUTER_SPRINT cbr_cwa_axe_word @4101
OUTER_SPRINT cbr_cwa_short_bow_word @4102
OUTER_SPRINT cbr_cwa_long_bow_phrase @4103
LAF cbr_apply_druid_weapon_access
  INT_VAR
    druid_class         = cbr_cwa_druid_class
    fighter_druid_class = cbr_cwa_fighter_druid_class
  STR_VAR
    axe_word        = EVAL ~%cbr_cwa_axe_word%~
    short_bow_word  = EVAL ~%cbr_cwa_short_bow_word%~
    long_bow_phrase = EVAL ~%cbr_cwa_long_bow_phrase%~
END

// Yeslick's Alaghor of Clangeddin kit: the cleric weapons plus axes, with
// fighter/cleric caps. Needs Artisan's permission system to allow axes for
// the kit alone, and EEex: for a fighter/cleric with this cleric kit the
// engine reads the FIGHTER_CLERIC limits, and M_CBRKP.lua makes it read the
// kit's own column (lib/class_weapon_access.tpa).
BEGIN @411 DESIGNATED 411 GROUP @1400 LABEL ~cbr_alaghor_weapon_access~
REQUIRE_PREDICATE (GAME_IS ~bg2ee eet~) @9490
REQUIRE_PREDICATE (IDS_OF_SYMBOL (~kit~ ~LK_ALAGHOR~) > 0) @9493
REQUIRE_PREDICATE ((FILE_EXISTS_IN_GAME ~C0PR#CL.SPL~) AND (FILE_EXISTS_IN_GAME ~C0PR#92.SPL~)
               AND (FILE_EXISTS_IN_GAME ~SPLPROT.2DA~)) @9494
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~M___EEex.lua~) @9496
REQUIRE_PREDICATE ((DIRECTORY_EXISTS ~EEex_scripts/extra_pattern_dbs~)
  AND (FILE_CONTAINS_EVALUATED (~EEex_scripts/EEex_Assembly_x86-64.lua~ ~^function[ %TAB%]+EEex_HookConditionalJumpOnSuccess[ %TAB%]*(~))
  AND (FILE_CONTAINS_EVALUATED (~EEex_scripts/EEex_Resource.lua~ ~^function[ %TAB%]+EEex_Resource_Load2DA~))
  AND (FILE_CONTAINS_EVALUATED (~EEex_scripts/EEex_Resource.lua~ ~^function[ %TAB%]+EEex_Resource_Get2DARowTableIterator~))) @9497

// The executable names EEex's loader starts; the hook site must exist there
// before anything is changed.
ACTION_IF (FILE_EXISTS ~Baldur.exe~) BEGIN
  OUTER_SPRINT cbr_cwa_executable ~Baldur.exe~
END ELSE ACTION_IF (FILE_EXISTS ~BaldurII.exe~) BEGIN
  OUTER_SPRINT cbr_cwa_executable ~BaldurII.exe~
END ELSE BEGIN
  FAIL @9498
END
LAF cbr_cwa_preflight_kit_column_hook STR_VAR executable_path = EVAL ~%cbr_cwa_executable%~ END

OUTER_SET cbr_cwa_alaghor_kit = IDS_OF_SYMBOL (~kit~ ~LK_ALAGHOR~)
OUTER_SET cbr_cwa_kit_stat = IDS_OF_SYMBOL (~stats~ ~KIT~)
OUTER_SET cbr_cwa_fighter_cleric_class = IDS_OF_SYMBOL (~class~ ~FIGHTER_CLERIC~)
OUTER_SPRINT cbr_cwa_alaghor_line @4111
LAF cbr_apply_alaghor_weapon_access
  INT_VAR
    kit_value = cbr_cwa_alaghor_kit
    kit_stat  = cbr_cwa_kit_stat
  STR_VAR
    kit_name    = ~LK_ALAGHOR~
    bullet_line = EVAL ~%cbr_cwa_alaghor_line%~
END
LAF cbr_cwa_install_kit_column
  INT_VAR
    class_value = cbr_cwa_fighter_cleric_class
    kit_value   = cbr_cwa_alaghor_kit
END
PRINT @9499

// The provider is independently selectable; it changes no class defaults.
BEGIN @420 DESIGNATED 420 GROUP @1400 LABEL ~cbr_kit_spell_progression_provider~
REQUIRE_PREDICATE (GAME_IS ~bg2ee eet iwdee~) @9470
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~M___EEex.lua~) @9471
REQUIRE_PREDICATE ((DIRECTORY_EXISTS ~EEex_scripts/extra_pattern_dbs~)
  AND (FILE_CONTAINS_EVALUATED (~EEex_scripts/EEex_Assembly_x86-64.lua~ ~^function[ %TAB%]+EEex_HookAfterRestoreWithLabels~))
  AND (FILE_CONTAINS_EVALUATED (~EEex_scripts/EEex_Resource.lua~ ~^function[ %TAB%]+EEex_Resource_Load2DA~))
  AND (FILE_CONTAINS_EVALUATED (~EEex_scripts/EEex_Resource.lua~ ~^function[ %TAB%]+EEex_Resource_Get2DARowTableIterator~))) @9472

// Match the loader's canonical game names; do not probe an unrelated executable.
ACTION_IF (GAME_IS ~iwdee~) BEGIN
  OUTER_SPRINT cbr_sp_executable ~icewind.exe~
END ELSE ACTION_IF (FILE_EXISTS ~Baldur.exe~) BEGIN
  OUTER_SPRINT cbr_sp_executable ~Baldur.exe~
END ELSE ACTION_IF (FILE_EXISTS ~BaldurII.exe~) BEGIN
  OUTER_SPRINT cbr_sp_executable ~BaldurII.exe~
END ELSE BEGIN
  FAIL @9473
END
LAF cbr_sp_preflight_executable STR_VAR executable_path = EVAL ~%cbr_sp_executable%~ END

// A valid API 1 registry can contain registrations from independent adapters.
// Preserve it; never replace it with the shipped blank table during a refresh.
ACTION_IF (NOT FILE_EXISTS_IN_GAME ~CBRSPKIT.2DA~) BEGIN
  COPY ~chriz-bg-rebalance/bard/CBRSPKIT.2DA~ ~override/CBRSPKIT.2DA~
END
COPY ~chriz-bg-rebalance/bard/CBRSPVER.2DA~ ~override/CBRSPVER.2DA~
