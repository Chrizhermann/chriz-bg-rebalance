// Cross-cutting spell audits/fixes (300-399)
// ============================================================

BEGIN @301
DESIGNATED 301
GROUP @1300
LABEL ~cbr_emotion_hope_courage_exclusion~

REQUIRE_PREDICATE (GAME_IS ~bg2ee eet~) @9300
ACTION_FOR_EACH cbr_em_ids IN SPELL.IDS SPLSTATE.IDS MISSILE.IDS PROJECTL.IDS BEGIN
  ACTION_IF NOT FILE_EXISTS_IN_GAME ~%cbr_em_ids%~ BEGIN
    LAF cbr_setup_ids STR_VAR file = EVAL ~%cbr_em_ids%~ END
  END
END
ACTION_IF NOT FILE_EXISTS_IN_GAME ~STATDESC.2DA~ BEGIN
  <<<<<<<< .../cbr-statdesc.2da
2DA V1.0
-1
DESCRIPTION BAM_FILE
>>>>>>>>
  COPY ~.../cbr-statdesc.2da~ ~override/STATDESC.2DA~
END

// A one-process --force-uninstall/--force-install run can retain the IDS map
// loaded by the just-uninstalled component.  Refresh it before classifying
// symbols so stale ADD_SPELL rows cannot masquerade as missing resources.
CLEAR_IDS_MAP

// Existing symbol slots are kept regardless of spell level or prior mechanics.
LAF cbr_setup_spell STR_VAR symbol = ~WIZARD_EMOTION_COURAGE~ RET cbr_em_courage_resref = resref END
LAF cbr_setup_spell STR_VAR symbol = ~WIZARD_EMOTION_HOPE~ RET cbr_em_hope_resref = resref END
OUTER_SET cbr_em_courage_existing = FILE_EXISTS_IN_GAME ~%cbr_em_courage_resref%.SPL~
OUTER_SET cbr_em_hope_existing = FILE_EXISTS_IN_GAME ~%cbr_em_hope_resref%.SPL~

// Distribution anchors and adverse counterparts are optional. Resolve their
// addresses through the final symbol table.
OUTER_SPRINT cbr_em_enchanted_resref ~~
OUTER_SET cbr_em_enchanted_id = IDS_OF_SYMBOL (~spell~ ~WIZARD_ENCHANTED_WEAPON~)
ACTION_IF (cbr_em_enchanted_id >= 0) BEGIN
  LAF cbr_setup_spell STR_VAR symbol = ~WIZARD_ENCHANTED_WEAPON~
    RET cbr_em_enchanted_resref = resref END
END

OUTER_SPRINT cbr_em_fear_resref ~~
OUTER_SET cbr_em_fear_id = IDS_OF_SYMBOL (~spell~ ~WIZARD_EMOTION_FEAR~)
ACTION_IF (cbr_em_fear_id >= 0) BEGIN
  LAF cbr_setup_spell STR_VAR symbol = ~WIZARD_EMOTION_FEAR~
    RET cbr_em_fear_resref = resref END
END

OUTER_SPRINT cbr_em_horror_resref ~~
OUTER_SET cbr_em_horror_id = IDS_OF_SYMBOL (~spell~ ~WIZARD_HORROR~)
ACTION_IF (cbr_em_horror_id >= 0) BEGIN
  LAF cbr_setup_spell STR_VAR symbol = ~WIZARD_HORROR~
    RET cbr_em_horror_resref = resref END
END

OUTER_SPRINT cbr_em_innate_horror_resref ~~
OUTER_SET cbr_em_innate_horror_id = IDS_OF_SYMBOL (~spell~ ~INNATE_HORROR~)
ACTION_IF (cbr_em_innate_horror_id >= 3000 && cbr_em_innate_horror_id <= 3999) BEGIN
  // The standard spell namespace encodes SPIN### with a leading 3.  Let
  // WeiDU perform the symbolic conversion without fixing a resref here.
  LAF cbr_setup_spell STR_VAR symbol = ~INNATE_HORROR~
    RET cbr_em_innate_horror_resref = resref END
END ELSE ACTION_IF (cbr_em_innate_horror_id >= 100 && cbr_em_innate_horror_id <= 999) BEGIN
  // Retain compatibility with older nonstandard IDS rows that store the
  // three-digit SPIN suffix directly.
  OUTER_SPRINT cbr_em_innate_horror_resref ~SPIN%cbr_em_innate_horror_id%~
END

OUTER_SPRINT cbr_em_hopeless_resref ~~
OUTER_SET cbr_em_hopeless_id = IDS_OF_SYMBOL (~spell~ ~WIZARD_EMOTION_HOPELESSNESS~)
ACTION_IF (cbr_em_hopeless_id >= 0) BEGIN
  LAF cbr_setup_spell STR_VAR symbol = ~WIZARD_EMOTION_HOPELESSNESS~
    RET cbr_em_hopeless_resref = resref END
END

OUTER_SPRINT cbr_em_symbol_resref ~~
OUTER_SET cbr_em_symbol_id = IDS_OF_SYMBOL (~spell~ ~CLERIC_SYMBOL_HOPELESSNESS~)
ACTION_IF (cbr_em_symbol_id >= 0) BEGIN
  LAF cbr_setup_spell STR_VAR symbol = ~CLERIC_SYMBOL_HOPELESSNESS~
    RET cbr_em_symbol_resref = resref END
END

OUTER_SET cbr_em_have_fear = !(~%cbr_em_fear_resref%~ STR_EQ ~~)
                           && FILE_EXISTS_IN_GAME ~%cbr_em_fear_resref%.SPL~
OUTER_SET cbr_em_have_horror = !(~%cbr_em_horror_resref%~ STR_EQ ~~)
                             && FILE_EXISTS_IN_GAME ~%cbr_em_horror_resref%.SPL~
OUTER_SET cbr_em_have_innate_horror = !(~%cbr_em_innate_horror_resref%~ STR_EQ ~~)
                                    && FILE_EXISTS_IN_GAME ~%cbr_em_innate_horror_resref%.SPL~
OUTER_SET cbr_em_have_hopeless = !(~%cbr_em_hopeless_resref%~ STR_EQ ~~)
                               && FILE_EXISTS_IN_GAME ~%cbr_em_hopeless_resref%.SPL~
OUTER_SET cbr_em_have_symbol = !(~%cbr_em_symbol_resref%~ STR_EQ ~~)
                             && FILE_EXISTS_IN_GAME ~%cbr_em_symbol_resref%.SPL~

// Read bounded tables. Horror and Innate Horror are cleanse-only: their
// presence is recorded, but BIF-only files stay BIF-only.
ACTION_IF (cbr_em_have_fear = 1) BEGIN
  COPY_EXISTING - ~%cbr_em_fear_resref%.SPL~ nowhere
    LPF cbr_em_validate_adverse
      INT_VAR mechanic_opcode = 24 unconditional = 0
      STR_VAR positive_resref = EVAL ~%cbr_em_courage_resref%~
    END
  BUT_ONLY
END
ACTION_IF (cbr_em_have_hopeless = 1) BEGIN
  COPY_EXISTING - ~%cbr_em_hopeless_resref%.SPL~ nowhere
    LPF cbr_em_validate_adverse
      INT_VAR mechanic_opcode = 45 unconditional = 1
      STR_VAR positive_resref = EVAL ~%cbr_em_hope_resref%~
    END
  BUT_ONLY
END
ACTION_IF (cbr_em_have_symbol = 1) BEGIN
  COPY_EXISTING - ~%cbr_em_symbol_resref%.SPL~ nowhere
    LPF cbr_em_validate_adverse
      INT_VAR mechanic_opcode = 45 unconditional = 0
      STR_VAR positive_resref = EVAL ~%cbr_em_hope_resref%~
    END
  BUT_ONLY
END

OUTER_SET cbr_em_need_courage = 1 - cbr_em_courage_existing
OUTER_SET cbr_em_need_hope = 1 - cbr_em_hope_existing
// Read-only KEY/override scroll discovery by learn target. Shared/reordered
// slices and extra trailing bytes do not affect discovery. Every donor counts.
OUTER_SET cbr_em_courage_scroll_count = 0
OUTER_SET cbr_em_hope_scroll_count = 0
OUTER_SET cbr_em_enchanted_donor_count = 0
OUTER_SET cbr_em_hopeless_donor_count = 0
OUTER_SPRINT cbr_em_enchanted_donor_scroll ~~
OUTER_SPRINT cbr_em_hopeless_donor_scroll ~~
OUTER_SET cbr_em_private_courage = 0
OUTER_SET cbr_em_private_hope = 0
ACTION_PHP_EACH cbr_em_enchanted_donors AS res => value BEGIN OUTER_SET $cbr_em_enchanted_donors(~%res%~) = 0 END
ACTION_PHP_EACH cbr_em_hopeless_donors AS res => value BEGIN OUTER_SET $cbr_em_hopeless_donors(~%res%~) = 0 END
COPY_EXISTING_REGEXP GLOB ~^.*\.[iI][tT][mM]$~ ~override~
  LPF cbr_em_validate_v1_partition INT_VAR ability_size = 0x38
    RET cbr_em_si_valid = readable cbr_em_si_ability_offset = ability_offset
      cbr_em_si_ability_count = ability_count cbr_em_si_effect_offset = effect_offset
      cbr_em_si_effect_count = effect_count END
  SET cbr_em_si_courage = 0
  SET cbr_em_si_hope = 0
  SET cbr_em_si_enchanted = 0
  SET cbr_em_si_hopeless = 0
  SET cbr_em_si_enchanted_cast = 0
  SET cbr_em_si_hopeless_cast = 0
  PATCH_IF (cbr_em_si_valid = 1) BEGIN
    FOR (cbr_em_si_ab = 0; cbr_em_si_ab < cbr_em_si_ability_count; ++cbr_em_si_ab) BEGIN
      SET cbr_em_si_header = cbr_em_si_ability_offset + cbr_em_si_ab * 0x38
      READ_SHORT (cbr_em_si_header + 0x1e) cbr_em_si_count
      READ_SHORT (cbr_em_si_header + 0x20) cbr_em_si_first
      PATCH_IF (cbr_em_si_first + cbr_em_si_count > cbr_em_si_effect_count) BEGIN
        SET cbr_em_si_valid = 0
      END
      PATCH_IF (cbr_em_si_valid = 1) BEGIN
        FOR (cbr_em_si_i = 0; cbr_em_si_i < cbr_em_si_count; ++cbr_em_si_i) BEGIN
          SET cbr_em_si_fx = cbr_em_si_effect_offset + (cbr_em_si_first + cbr_em_si_i) * 0x30
          READ_SHORT cbr_em_si_fx cbr_em_si_opcode
          PATCH_IF (cbr_em_si_opcode = 146
                 || cbr_em_si_opcode = 147
                 || cbr_em_si_opcode = 148) BEGIN
            READ_ASCII (cbr_em_si_fx + 0x14) cbr_em_si_resource (8) NULL
          END
          PATCH_IF (cbr_em_si_opcode = 147) BEGIN
            PATCH_IF (!(~%cbr_em_courage_resref%~ STR_EQ ~~)
                   && ~%cbr_em_si_resource%~ STRING_EQUAL_CASE ~%cbr_em_courage_resref%~) BEGIN
              SET cbr_em_si_courage = 1
            END
            PATCH_IF (!(~%cbr_em_hope_resref%~ STR_EQ ~~)
                   && ~%cbr_em_si_resource%~ STRING_EQUAL_CASE ~%cbr_em_hope_resref%~) BEGIN
              SET cbr_em_si_hope = 1
            END
            PATCH_IF !(~%cbr_em_enchanted_resref%~ STR_EQ ~~)
                   && (~%cbr_em_si_resource%~ STRING_EQUAL_CASE ~%cbr_em_enchanted_resref%~) BEGIN
              SET cbr_em_si_enchanted = 1
            END
            PATCH_IF !(~%cbr_em_hopeless_resref%~ STR_EQ ~~)
                   && (~%cbr_em_si_resource%~ STRING_EQUAL_CASE ~%cbr_em_hopeless_resref%~) BEGIN
              SET cbr_em_si_hopeless = 1
            END
          END
          PATCH_IF (cbr_em_si_opcode = 146 || cbr_em_si_opcode = 148) BEGIN
            PATCH_IF !(~%cbr_em_enchanted_resref%~ STR_EQ ~~)
                   && (~%cbr_em_si_resource%~ STRING_EQUAL_CASE ~%cbr_em_enchanted_resref%~) BEGIN
              SET cbr_em_si_enchanted_cast = 1
            END
            PATCH_IF !(~%cbr_em_hopeless_resref%~ STR_EQ ~~)
                   && (~%cbr_em_si_resource%~ STRING_EQUAL_CASE ~%cbr_em_hopeless_resref%~) BEGIN
              SET cbr_em_si_hopeless_cast = 1
            END
          END
        END
      END
    END
  END
  PATCH_IF (cbr_em_si_valid = 1 && cbr_em_si_courage = 1) BEGIN
    SPRINT $cbr_em_courage_scroll(~%cbr_em_courage_scroll_count%~) ~%SOURCE_RES%~
    SET cbr_em_courage_scroll_count += 1
    PATCH_IF ~%SOURCE_RES%~ STRING_EQUAL_CASE ~CBRCRGSC~ BEGIN SET cbr_em_private_courage = 1 END
  END
  PATCH_IF (cbr_em_si_valid = 1 && cbr_em_si_hope = 1) BEGIN
    SPRINT $cbr_em_hope_scroll(~%cbr_em_hope_scroll_count%~) ~%SOURCE_RES%~
    SET cbr_em_hope_scroll_count += 1
    PATCH_IF ~%SOURCE_RES%~ STRING_EQUAL_CASE ~CBRHOPSC~ BEGIN SET cbr_em_private_hope = 1 END
  END
  PATCH_IF (cbr_em_si_valid = 1 && cbr_em_si_enchanted = 1) BEGIN
    SPRINT cbr_em_enchanted_donor_scroll ~%SOURCE_RES%~
    TO_UPPER cbr_em_enchanted_donor_scroll
    SET $cbr_em_enchanted_donors(~%cbr_em_enchanted_donor_scroll%~) = 1
    SET cbr_em_enchanted_donor_count += 1
  END
  PATCH_IF (cbr_em_si_valid = 1 && cbr_em_si_hopeless = 1) BEGIN
    SPRINT cbr_em_hopeless_donor_scroll ~%SOURCE_RES%~
    TO_UPPER cbr_em_hopeless_donor_scroll
    SET $cbr_em_hopeless_donors(~%cbr_em_hopeless_donor_scroll%~) = 1
    SET cbr_em_hopeless_donor_count += 1
  END
  BUT_ONLY_IF_IT_CHANGES

OUTER_SET cbr_em_make_courage_scroll = cbr_em_need_courage OR cbr_em_courage_scroll_count = 0 OR cbr_em_private_courage
OUTER_SET cbr_em_make_hope_scroll = cbr_em_need_hope OR cbr_em_hope_scroll_count = 0 OR cbr_em_private_hope
ACTION_IF cbr_em_enchanted_donor_count = 0 BEGIN PRINT ~CBR Emotion: Courage distribution anchor is absent; continuing.~ END
ACTION_IF cbr_em_hopeless_donor_count = 0 BEGIN PRINT ~CBR Emotion: Hope distribution anchor is absent; continuing.~ END

// Publish the IWDEE Emotion delivery graph under private names.  IDPRO407 is
// the party-capable area projectile used by the original spells; its linked
// VVC, animation, and sounds are remapped so this component never depends on
// IWDification's public resource names or overwrites another provider.
ACTION_IF (cbr_em_need_courage = 1 || cbr_em_need_hope = 1) BEGIN
  COPY ~chriz-bg-rebalance/resources/emotion_iwdee/IDPRO407.PRO~ ~override/CBR301P.PRO~
    WRITE_ASCII 0x21c ~CBR301V~ #8
  COPY ~chriz-bg-rebalance/resources/emotion_iwdee/#GENENCH.VVC~ ~override/CBR301V.VVC~
    WRITE_ASCII 0x08 ~CBR301A~ #8
    WRITE_ASCII 0x78 ~CBR301W~ #8
  COPY ~chriz-bg-rebalance/resources/emotion_iwdee/ENCHANX.BAM~ ~override/CBR301A.BAM~
  COPY ~chriz-bg-rebalance/resources/emotion_iwdee/#ARE_M21.WAV~ ~override/CBR301W.WAV~
  COPY ~chriz-bg-rebalance/resources/emotion_iwdee/#EFF_E03.WAV~ ~override/CBR301E.WAV~
  ADD_PROJECTILE ~override/CBR301P.PRO~
  OUTER_SET cbr_em_stored_projectile = CBR301P
END

ACTION_IF (cbr_em_need_courage = 1) BEGIN
  COPY - ~chriz-bg-rebalance/resources/emotion_iwdee/IDPRO407.PRO~ ~.../cbr-emotion/courage-seed.spl~
    LPF cbr_em_make_native_seed
      INT_VAR is_courage = 1 stored_projectile = cbr_em_stored_projectile
    END
  ACTION_IF ~%cbr_em_courage_resref%~ STR_EQ ~~ BEGIN
    ADD_SPELL ~.../cbr-emotion/courage-seed.spl~ 2 4 ~WIZARD_EMOTION_COURAGE~
    IF_EXISTING
      LPF cbr_em_make_native_seed INT_VAR is_courage = 1 stored_projectile = cbr_em_stored_projectile END
    END
    LAF cbr_setup_spell STR_VAR symbol = ~WIZARD_EMOTION_COURAGE~ RET cbr_em_courage_resref = resref END
  END ELSE BEGIN
    COPY ~.../cbr-emotion/courage-seed.spl~ ~override/%cbr_em_courage_resref%.SPL~
  END
END

ACTION_IF (cbr_em_need_hope = 1) BEGIN
  COPY - ~chriz-bg-rebalance/resources/emotion_iwdee/IDPRO407.PRO~ ~.../cbr-emotion/hope-seed.spl~
    LPF cbr_em_make_native_seed
      INT_VAR is_courage = 0 stored_projectile = cbr_em_stored_projectile
    END
  ACTION_IF ~%cbr_em_hope_resref%~ STR_EQ ~~ BEGIN
    ADD_SPELL ~.../cbr-emotion/hope-seed.spl~ 2 4 ~WIZARD_EMOTION_HOPE~
    IF_EXISTING
      LPF cbr_em_make_native_seed INT_VAR is_courage = 0 stored_projectile = cbr_em_stored_projectile END
    END
    LAF cbr_setup_spell STR_VAR symbol = ~WIZARD_EMOTION_HOPE~ RET cbr_em_hope_resref = resref END
  END ELSE BEGIN
    COPY ~.../cbr-emotion/hope-seed.spl~ ~override/%cbr_em_hope_resref%.SPL~
  END
END

// Describe each spell from its own final header, read after allocation and
// before any string is resolved: school, spell level, and the first ability
// header's range and casting time.  The two descriptions share the
// placeholder contract documented beside @3012/@3014.  A canonical spell
// (Enchantment, level 4, range 50, casting time 4) resolves to exactly the
// earlier fixed text, so existing installs keep reusing their strings.  The
// area of effect is not derived from the projectile and stays fixed text.
DEFINE_ACTION_FUNCTION cbr_em_describe_spell
  INT_VAR
    is_courage = 0
  STR_VAR
    resref = ~~
  RET
    description
BEGIN
  OUTER_SPRINT cbr_em_dd_resref ~%resref%~
  COPY_EXISTING - ~%cbr_em_dd_resref%.SPL~ nowhere
    LPF cbr_em_description_stats
      RET
        cbr_em_dd_school = school
        cbr_em_dd_level = level
        cbr_em_dd_range = range
        cbr_em_dd_casting_time = casting_time
        cbr_em_dd_agree = headers_agree
    END
    SPRINT cbr_em_dd_school_name ~~
    PATCH_IF (cbr_em_dd_school = 1) BEGIN
      SPRINT cbr_em_dd_school_name @3031
    END ELSE PATCH_IF (cbr_em_dd_school = 2) BEGIN
      SPRINT cbr_em_dd_school_name @3032
    END ELSE PATCH_IF (cbr_em_dd_school = 3) BEGIN
      SPRINT cbr_em_dd_school_name @3033
    END ELSE PATCH_IF (cbr_em_dd_school = 4) BEGIN
      SPRINT cbr_em_dd_school_name @3034
    END ELSE PATCH_IF (cbr_em_dd_school = 5) BEGIN
      SPRINT cbr_em_dd_school_name @3035
    END ELSE PATCH_IF (cbr_em_dd_school = 6) BEGIN
      SPRINT cbr_em_dd_school_name @3036
    END ELSE PATCH_IF (cbr_em_dd_school = 7) BEGIN
      SPRINT cbr_em_dd_school_name @3037
    END ELSE PATCH_IF (cbr_em_dd_school = 8) BEGIN
      SPRINT cbr_em_dd_school_name @3038
    END
    PATCH_IF (~%cbr_em_dd_school_name%~ STR_EQ ~~) BEGIN
      SPRINT cbr_em_desc_school_line ~~
    END ELSE BEGIN
      SPRINT cbr_em_desc_school_line ~(%cbr_em_dd_school_name%)%LNL%~
    END
    SPRINT cbr_em_desc_level ~%cbr_em_dd_level%~
    SPRINT cbr_em_desc_range ~%cbr_em_dd_range%~
    SPRINT cbr_em_desc_casting_time ~%cbr_em_dd_casting_time%~
    PATCH_IF (is_courage = 1) BEGIN
      SPRINT description @3012
    END ELSE BEGIN
      SPRINT description @3014
    END
  BUT_ONLY
END

LAF cbr_em_describe_spell
  INT_VAR is_courage = 1
  STR_VAR resref = EVAL ~%cbr_em_courage_resref%~
  RET cbr_em_courage_desc_text = description
END
LAF cbr_em_describe_spell
  INT_VAR is_courage = 0
  STR_VAR resref = EVAL ~%cbr_em_hope_resref%~
  RET cbr_em_hope_desc_text = description
END

// Publish the original blue IWDEE spell icons and independently extracted
// 13x13 IWDEE heart status sprites under each dynamically allocated name.
ACTION_IF (cbr_em_need_courage = 1) BEGIN
  COPY ~chriz-bg-rebalance/resources/emotion_iwdee/SPWI427A.BAM~ ~override/%cbr_em_courage_resref%A.BAM~
  COPY ~chriz-bg-rebalance/resources/emotion_iwdee/SPWI427B.BAM~ ~override/%cbr_em_courage_resref%B.BAM~
  COPY ~chriz-bg-rebalance/resources/emotion_iwdee/SPWI427C.BAM~ ~override/%cbr_em_courage_resref%C.BAM~
  COPY ~chriz-bg-rebalance/resources/emotion_iwdee/SPWI427D.BAM~ ~override/%cbr_em_courage_resref%D.BAM~
END
ACTION_IF (cbr_em_need_hope = 1) BEGIN
  COPY ~chriz-bg-rebalance/resources/emotion_iwdee/SPWI429A.BAM~ ~override/%cbr_em_hope_resref%A.BAM~
  COPY ~chriz-bg-rebalance/resources/emotion_iwdee/SPWI429B.BAM~ ~override/%cbr_em_hope_resref%B.BAM~
  COPY ~chriz-bg-rebalance/resources/emotion_iwdee/SPWI429C.BAM~ ~override/%cbr_em_hope_resref%C.BAM~
  COPY ~chriz-bg-rebalance/resources/emotion_iwdee/SPWI429D.BAM~ ~override/%cbr_em_hope_resref%D.BAM~
END

OUTER_SET cbr_em_courage_state = IDS_OF_SYMBOL (~splstate~ ~EMOTION_COURAGE~)
OUTER_SET cbr_em_hope_state = IDS_OF_SYMBOL (~splstate~ ~EMOTION_HOPE~)
OUTER_SET cbr_em_courage_name = RESOLVE_STR_REF (@3011)
OUTER_SET cbr_em_courage_desc = RESOLVE_STR_REF (~%cbr_em_courage_desc_text%~)
OUTER_SET cbr_em_hope_name = RESOLVE_STR_REF (@3013)
OUTER_SET cbr_em_hope_desc = RESOLVE_STR_REF (~%cbr_em_hope_desc_text%~)
OUTER_SET cbr_em_courage_status_name = "-1"
OUTER_SET cbr_em_hope_status_name = "-1"
ACTION_IF (cbr_em_need_courage = 1) BEGIN
  OUTER_SET cbr_em_courage_status_name = RESOLVE_STR_REF (@3015)
END
ACTION_IF (cbr_em_need_hope = 1) BEGIN
  OUTER_SET cbr_em_hope_status_name = RESOLVE_STR_REF (@3016)
END

// BG2EE displays opcode 142 through STATDESC rather than IWDEE's monolithic
// STATES.BAM cycles. Allocate first-free extensible rows (200+) only for
// standalone spells; installed providers retain their own rows and BAMs.
OUTER_SET cbr_em_courage_portrait = "-1"
OUTER_SET cbr_em_hope_portrait = "-1"
ACTION_IF (cbr_em_need_courage = 1 || cbr_em_need_hope = 1) BEGIN
  ACTION_PHP_EACH cbr_em_sd_used AS label => value BEGIN OUTER_SET $cbr_em_sd_used(~%label%~) = 0 END
  ACTION_CLEAR_ARRAY cbr_em_sd_used
  COPY_EXISTING ~STATDESC.2DA~ ~override~
    READ_ASCII 0 cbr_em_sd_text (BUFFER_LENGTH)
    SET cbr_em_sd_line = 0 SET cbr_em_sd_desc_col = 0 SET cbr_em_sd_bam_col = 0
    SET cbr_em_sd_cols = 1
    SPRINT cbr_em_sd_header ~~ SPRINT cbr_em_sd_body ~~
    INNER_PATCH ~%cbr_em_sd_text%~ BEGIN
      REPLACE_EVALUATE ~[^%LNL%%MNL%]+~ BEGIN
        SPRINT cbr_em_sd_content ~%MATCH0%~
        SET cbr_em_sd_token = 0
        INNER_PATCH ~%cbr_em_sd_content%~ BEGIN
          REPLACE_EVALUATE ~[^ %TAB%]+~ BEGIN
            PATCH_IF cbr_em_sd_line = 2 BEGIN
              PATCH_IF ~%MATCH0%~ STRING_EQUAL_CASE ~DESCRIPTION~ BEGIN SET cbr_em_sd_desc_col = cbr_em_sd_token + 1 END
              PATCH_IF ~%MATCH0%~ STRING_EQUAL_CASE ~BAM_FILE~ BEGIN SET cbr_em_sd_bam_col = cbr_em_sd_token + 1 END
              SPRINT cbr_em_sd_header ~%cbr_em_sd_header% %MATCH0%~
            END ELSE PATCH_IF cbr_em_sd_line > 2 BEGIN
              SPRINT $cbr_em_sd_cell(~%cbr_em_sd_token%~) ~%MATCH0%~
            END
            ++cbr_em_sd_token
          END ~~
        END
        PATCH_IF cbr_em_sd_line = 2 BEGIN
          SET cbr_em_sd_cols = cbr_em_sd_token + 1
          PATCH_IF cbr_em_sd_desc_col = 0 BEGIN
            SET cbr_em_sd_desc_col = cbr_em_sd_cols ++cbr_em_sd_cols
            SPRINT cbr_em_sd_header ~%cbr_em_sd_header% DESCRIPTION~
          END
          PATCH_IF cbr_em_sd_bam_col = 0 BEGIN
            SET cbr_em_sd_bam_col = cbr_em_sd_cols ++cbr_em_sd_cols
            SPRINT cbr_em_sd_header ~%cbr_em_sd_header% BAM_FILE~
          END
        END ELSE PATCH_IF cbr_em_sd_line > 2 AND cbr_em_sd_token > 0 BEGIN
          FOR (cbr_em_sd_c = 0; cbr_em_sd_c < cbr_em_sd_cols; ++cbr_em_sd_c) BEGIN
            SPRINT cbr_em_sd_value ~****~
            PATCH_IF cbr_em_sd_c = cbr_em_sd_desc_col BEGIN SPRINT cbr_em_sd_value ~-1~ END
            PATCH_IF cbr_em_sd_c < cbr_em_sd_token BEGIN SPRINT cbr_em_sd_value $cbr_em_sd_cell(~%cbr_em_sd_c%~) END
            // SET_2DA_ENTRY counts a leading blank as column zero. Keep
            // row labels flush left so its columns match READ_2DA_ENTRY.
            PATCH_IF cbr_em_sd_c > 0 BEGIN SPRINT cbr_em_sd_body ~%cbr_em_sd_body% ~ END
            SPRINT cbr_em_sd_body ~%cbr_em_sd_body%%cbr_em_sd_value%~
          END
          SPRINT cbr_em_sd_body ~%cbr_em_sd_body%%WNL%~
        END
        ++cbr_em_sd_line
      END ~~
    END
    PATCH_IF cbr_em_sd_desc_col = 0 BEGIN
      SET cbr_em_sd_desc_col = cbr_em_sd_cols ++cbr_em_sd_cols
      SPRINT cbr_em_sd_header ~%cbr_em_sd_header% DESCRIPTION~
    END
    PATCH_IF cbr_em_sd_bam_col = 0 BEGIN
      SET cbr_em_sd_bam_col = cbr_em_sd_cols ++cbr_em_sd_cols
      SPRINT cbr_em_sd_header ~%cbr_em_sd_header% BAM_FILE~
    END
    SPRINT cbr_em_sd_text ~2DA V1.0%WNL%-1%WNL%%cbr_em_sd_header%%WNL%%cbr_em_sd_body%~
    DELETE_BYTES 0 BUFFER_LENGTH
    INSERT_BYTES 0 (STRING_LENGTH ~%cbr_em_sd_text%~)
    WRITE_ASCIIE 0 ~%cbr_em_sd_text%~
    READ_2DA_ENTRIES_NOW cbr_em_sd_rows cbr_em_sd_cols
    FOR (cbr_em_sd_i = 0; cbr_em_sd_i < cbr_em_sd_rows; ++cbr_em_sd_i) BEGIN
      READ_2DA_ENTRY_FORMER cbr_em_sd_rows cbr_em_sd_i 0 cbr_em_sd_label
      PATCH_IF (IS_AN_INT ~%cbr_em_sd_label%~) BEGIN
        SET $cbr_em_sd_used(~%cbr_em_sd_label%~) = 1
      END
    END
    FOR (cbr_em_sd_i = 0; cbr_em_sd_i < cbr_em_sd_rows; ++cbr_em_sd_i) BEGIN
      READ_2DA_ENTRY_FORMER cbr_em_sd_rows cbr_em_sd_i 0 cbr_em_sd_label
      READ_2DA_ENTRY_FORMER cbr_em_sd_rows cbr_em_sd_i cbr_em_sd_bam_col cbr_em_sd_bam
      PATCH_IF (~%cbr_em_sd_bam%~ STRING_EQUAL_CASE ~%cbr_em_courage_resref%D~)
        OR (~%cbr_em_sd_bam%~ STRING_EQUAL_CASE ~%cbr_em_hope_resref%D~) BEGIN
        SET cbr_em_sd_number = (0 - 1)
        PATCH_IF IS_AN_INT ~%cbr_em_sd_label%~ BEGIN SET cbr_em_sd_number = cbr_em_sd_label END
        PATCH_IF cbr_em_sd_number < 0 BEGIN
          SET cbr_em_sd_number = 200
          WHILE (VARIABLE_IS_SET $cbr_em_sd_used(~%cbr_em_sd_number%~)
            AND $cbr_em_sd_used(~%cbr_em_sd_number%~) = 1) BEGIN ++cbr_em_sd_number END
          SPRINT cbr_em_sd_label ~%cbr_em_sd_number%~
          SET_2DA_ENTRY cbr_em_sd_i 0 cbr_em_sd_cols ~%cbr_em_sd_label%~
          SET $cbr_em_sd_used(~%cbr_em_sd_label%~) = 1
        END
      END
      PATCH_IF ~%cbr_em_sd_bam%~ STRING_EQUAL_CASE ~%cbr_em_courage_resref%D~ BEGIN
        SET cbr_em_courage_portrait = cbr_em_sd_label
        SET_2DA_ENTRY cbr_em_sd_i cbr_em_sd_desc_col cbr_em_sd_cols ~%cbr_em_courage_status_name%~
      END
      PATCH_IF ~%cbr_em_sd_bam%~ STRING_EQUAL_CASE ~%cbr_em_hope_resref%D~ BEGIN
        SET cbr_em_hope_portrait = cbr_em_sd_label
        SET_2DA_ENTRY cbr_em_sd_i cbr_em_sd_desc_col cbr_em_sd_cols ~%cbr_em_hope_status_name%~
      END
      PATCH_IF (IS_AN_INT ~%cbr_em_sd_label%~) BEGIN
        SET $cbr_em_sd_used(~%cbr_em_sd_label%~) = 1
      END
    END
    PATCH_IF (cbr_em_need_courage = 1 && cbr_em_courage_portrait < 0) BEGIN
      SET cbr_em_courage_portrait = 200
      WHILE (VARIABLE_IS_SET $cbr_em_sd_used(~%cbr_em_courage_portrait%~)
        AND $cbr_em_sd_used(~%cbr_em_courage_portrait%~) = 1) BEGIN
        ++cbr_em_courage_portrait
      END
      SPRINT cbr_em_sd_row ~%cbr_em_courage_portrait%~
      FOR (cbr_em_sd_c = 1; cbr_em_sd_c < cbr_em_sd_cols; ++cbr_em_sd_c) BEGIN
        SPRINT cbr_em_sd_value ~****~
        PATCH_IF cbr_em_sd_c = cbr_em_sd_desc_col BEGIN SPRINT cbr_em_sd_value ~%cbr_em_courage_status_name%~ END
        PATCH_IF cbr_em_sd_c = cbr_em_sd_bam_col BEGIN SPRINT cbr_em_sd_value ~%cbr_em_courage_resref%D~ END
        SPRINT cbr_em_sd_row ~%cbr_em_sd_row% %cbr_em_sd_value%~
      END
      INSERT_2DA_ROW cbr_em_sd_rows cbr_em_sd_cols ~%cbr_em_sd_row%~
      SET $cbr_em_sd_used(~%cbr_em_courage_portrait%~) = 1
      ++cbr_em_sd_rows
    END
    PATCH_IF (cbr_em_need_hope = 1 && cbr_em_hope_portrait < 0) BEGIN
      SET cbr_em_hope_portrait = 200
      WHILE (VARIABLE_IS_SET $cbr_em_sd_used(~%cbr_em_hope_portrait%~)
        AND $cbr_em_sd_used(~%cbr_em_hope_portrait%~) = 1) BEGIN
        ++cbr_em_hope_portrait
      END
      SPRINT cbr_em_sd_row ~%cbr_em_hope_portrait%~
      FOR (cbr_em_sd_c = 1; cbr_em_sd_c < cbr_em_sd_cols; ++cbr_em_sd_c) BEGIN
        SPRINT cbr_em_sd_value ~****~
        PATCH_IF cbr_em_sd_c = cbr_em_sd_desc_col BEGIN SPRINT cbr_em_sd_value ~%cbr_em_hope_status_name%~ END
        PATCH_IF cbr_em_sd_c = cbr_em_sd_bam_col BEGIN SPRINT cbr_em_sd_value ~%cbr_em_hope_resref%D~ END
        SPRINT cbr_em_sd_row ~%cbr_em_sd_row% %cbr_em_sd_value%~
      END
      INSERT_2DA_ROW cbr_em_sd_rows cbr_em_sd_cols ~%cbr_em_sd_row%~
      SET $cbr_em_sd_used(~%cbr_em_hope_portrait%~) = 1
      ++cbr_em_sd_rows
    END
  BUT_ONLY_IF_IT_CHANGES
END

// Materialize only resources this component owns or rewrites.  The two
// cleanse-only Horror variants deliberately remain at their original layer.
COPY_EXISTING ~%cbr_em_courage_resref%.SPL~ ~override/%cbr_em_courage_resref%.SPL~
  PATCH_IF (cbr_em_need_courage = 1) BEGIN
    READ_LONG 0x64 cbr_em_ci_ability_offset
    WRITE_ASCIIE 0x3a ~%cbr_em_courage_resref%C~ #8
    WRITE_ASCIIE (cbr_em_ci_ability_offset + 0x04) ~%cbr_em_courage_resref%B~ #8
  END
COPY_EXISTING ~%cbr_em_hope_resref%.SPL~ ~override/%cbr_em_hope_resref%.SPL~
  PATCH_IF (cbr_em_need_hope = 1) BEGIN
    READ_LONG 0x64 cbr_em_hi_ability_offset
    WRITE_ASCIIE 0x3a ~%cbr_em_hope_resref%C~ #8
    WRITE_ASCIIE (cbr_em_hi_ability_offset + 0x04) ~%cbr_em_hope_resref%B~ #8
  END
ACTION_IF (cbr_em_have_fear = 1) BEGIN
  LAF cbr_setup_stage STR_VAR file = ~%cbr_em_fear_resref%.SPL~ END
END
ACTION_IF (cbr_em_have_hopeless = 1) BEGIN
  LAF cbr_setup_stage STR_VAR file = ~%cbr_em_hopeless_resref%.SPL~ END
END
ACTION_IF (cbr_em_have_symbol = 1) BEGIN
  LAF cbr_setup_stage STR_VAR file = ~%cbr_em_symbol_resref%.SPL~ END
END

LAF cbr_apply_emotion_hope_courage
  INT_VAR
    courage_spell_state = cbr_em_courage_state
    hope_spell_state = cbr_em_hope_state
    courage_portrait_icon = cbr_em_courage_portrait
    hope_portrait_icon = cbr_em_hope_portrait
    courage_name_strref = cbr_em_courage_name
    courage_desc_strref = cbr_em_courage_desc
    hope_name_strref = cbr_em_hope_name
    hope_desc_strref = cbr_em_hope_desc
    horror_present = cbr_em_have_horror
    innate_horror_present = cbr_em_have_innate_horror
    process_scrolls = 0
  STR_VAR
    resource_dir = ~override~
    courage_resref = EVAL ~%cbr_em_courage_resref%~
    hope_resref = EVAL ~%cbr_em_hope_resref%~
    fear_resref = EVAL ~%cbr_em_fear_resref%~
    horror_resref = EVAL ~%cbr_em_horror_resref%~
    innate_horror_resref = EVAL ~%cbr_em_innate_horror_resref%~
    hopelessness_resref = EVAL ~%cbr_em_hopeless_resref%~
    symbol_resref = EVAL ~%cbr_em_symbol_resref%~
END

// Reuse installed provider scrolls.  Standalone spells receive clean
// IWDification-style scrolls; the discovered donor names are retained only as
// distribution anchors when mirroring existing store rows below.
ACTION_IF (cbr_em_make_courage_scroll = 1) BEGIN
  COPY ~chriz-bg-rebalance/resources/emotion_iwdee/IDPRO407.PRO~ ~override/CBRCRGSC.ITM~
    LPF cbr_em_make_wizard_scroll
      INT_VAR name_strref = cbr_em_courage_name desc_strref = cbr_em_courage_desc
      STR_VAR spell_resref = EVAL ~%cbr_em_courage_resref%~
              icon_resref = EVAL ~%cbr_em_courage_resref%A~
    END
  OUTER_SPRINT $cbr_em_courage_scroll(~%cbr_em_courage_scroll_count%~) ~CBRCRGSC~
  OUTER_SET cbr_em_courage_scroll_count += 1
  ACTION_IF NOT FILE_EXISTS_IN_GAME ~%cbr_em_courage_resref%A.BAM~ BEGIN
    COPY ~chriz-bg-rebalance/resources/emotion_iwdee/SPWI427A.BAM~ ~override/%cbr_em_courage_resref%A.BAM~
  END
END
ACTION_IF (cbr_em_make_hope_scroll = 1) BEGIN
  COPY ~chriz-bg-rebalance/resources/emotion_iwdee/IDPRO407.PRO~ ~override/CBRHOPSC.ITM~
    LPF cbr_em_make_wizard_scroll
      INT_VAR name_strref = cbr_em_hope_name desc_strref = cbr_em_hope_desc
      STR_VAR spell_resref = EVAL ~%cbr_em_hope_resref%~
              icon_resref = EVAL ~%cbr_em_hope_resref%A~
    END
  OUTER_SPRINT $cbr_em_hope_scroll(~%cbr_em_hope_scroll_count%~) ~CBRHOPSC~
  OUTER_SET cbr_em_hope_scroll_count += 1
  ACTION_IF NOT FILE_EXISTS_IN_GAME ~%cbr_em_hope_resref%A.BAM~ BEGIN
    COPY ~chriz-bg-rebalance/resources/emotion_iwdee/SPWI429A.BAM~ ~override/%cbr_em_hope_resref%A.BAM~
  END
END

OUTER_FOR (cbr_em_scroll_i = 0; cbr_em_scroll_i < cbr_em_courage_scroll_count; ++cbr_em_scroll_i) BEGIN
  OUTER_SPRINT cbr_em_scroll_slot ~cbr_em_courage_scroll_%cbr_em_scroll_i%~
  OUTER_SPRINT cbr_em_scroll_resref EVAL ~%%cbr_em_scroll_slot%%~
  COPY_EXISTING ~%cbr_em_scroll_resref%.ITM~ ~override/%cbr_em_scroll_resref%.ITM~
    // Normalize both operational references as well as the two owned strings.
    LPF cbr_em_validate_v1_partition INT_VAR ability_size = 0x38
      RET cbr_em_ts_effect_offset = effect_offset cbr_em_ts_effect_count = effect_count END
    FOR (cbr_em_ts_i = 0; cbr_em_ts_i < cbr_em_ts_effect_count; ++cbr_em_ts_i) BEGIN
      SET cbr_em_ts_fx = cbr_em_ts_effect_offset + cbr_em_ts_i * 0x30
      READ_SHORT cbr_em_ts_fx cbr_em_ts_opcode
      PATCH_IF (cbr_em_ts_opcode = 146 || cbr_em_ts_opcode = 147 || cbr_em_ts_opcode = 148) BEGIN
        READ_ASCII (cbr_em_ts_fx + 0x14) cbr_em_ts_resource (8) NULL
        PATCH_IF (~%cbr_em_ts_resource%~ STRING_EQUAL_CASE ~%cbr_em_courage_resref%~) BEGIN
          WRITE_ASCIIE (cbr_em_ts_fx + 0x14) ~%cbr_em_courage_resref%~ #8
        END
      END
    END
    LPF cbr_em_patch_scroll_text
      INT_VAR courage_name_strref = cbr_em_courage_name courage_desc_strref = cbr_em_courage_desc
              hope_name_strref = cbr_em_hope_name hope_desc_strref = cbr_em_hope_desc
      STR_VAR courage_resref = EVAL ~%cbr_em_courage_resref%~ hope_resref = EVAL ~%cbr_em_hope_resref%~
    END
  BUT_ONLY
END
OUTER_FOR (cbr_em_scroll_i = 0; cbr_em_scroll_i < cbr_em_hope_scroll_count; ++cbr_em_scroll_i) BEGIN
  OUTER_SPRINT cbr_em_scroll_slot ~cbr_em_hope_scroll_%cbr_em_scroll_i%~
  OUTER_SPRINT cbr_em_scroll_resref EVAL ~%%cbr_em_scroll_slot%%~
  COPY_EXISTING ~%cbr_em_scroll_resref%.ITM~ ~override/%cbr_em_scroll_resref%.ITM~
    LPF cbr_em_validate_v1_partition INT_VAR ability_size = 0x38
      RET cbr_em_ts_effect_offset = effect_offset cbr_em_ts_effect_count = effect_count END
    FOR (cbr_em_ts_i = 0; cbr_em_ts_i < cbr_em_ts_effect_count; ++cbr_em_ts_i) BEGIN
      SET cbr_em_ts_fx = cbr_em_ts_effect_offset + cbr_em_ts_i * 0x30
      READ_SHORT cbr_em_ts_fx cbr_em_ts_opcode
      PATCH_IF (cbr_em_ts_opcode = 146 || cbr_em_ts_opcode = 147 || cbr_em_ts_opcode = 148) BEGIN
        READ_ASCII (cbr_em_ts_fx + 0x14) cbr_em_ts_resource (8) NULL
        PATCH_IF (~%cbr_em_ts_resource%~ STRING_EQUAL_CASE ~%cbr_em_hope_resref%~) BEGIN
          WRITE_ASCIIE (cbr_em_ts_fx + 0x14) ~%cbr_em_hope_resref%~ #8
        END
      END
    END
    LPF cbr_em_patch_scroll_text
      INT_VAR courage_name_strref = cbr_em_courage_name courage_desc_strref = cbr_em_courage_desc
              hope_name_strref = cbr_em_hope_name hope_desc_strref = cbr_em_hope_desc
      STR_VAR courage_resref = EVAL ~%cbr_em_courage_resref%~ hope_resref = EVAL ~%cbr_em_hope_resref%~
    END
  BUT_ONLY
END

// Mirror every donor-store entry, including duplicate rows and all raw stock,
// charge, flag, and expiry fields.  Reverse insertion preserves the original
// row indices while each downstream STO section offset is shifted exactly.
ACTION_IF (cbr_em_make_courage_scroll = 1 || cbr_em_make_hope_scroll = 1) BEGIN
  COPY_EXISTING_REGEXP GLOB ~^.*\.[sS][tT][oO]$~ ~override~
    PATCH_IF (BUFFER_LENGTH >= 0x9c) BEGIN
      READ_ASCII 0 cbr_em_st_signature (8)
      READ_LONG 0x34 cbr_em_st_sale_offset
      READ_LONG 0x38 cbr_em_st_sale_count
      SET cbr_em_st_sale_end = cbr_em_st_sale_offset + cbr_em_st_sale_count * 0x1c
      PATCH_IF (~%cbr_em_st_signature%~ STRING_EQUAL ~STORV1.0~
             && cbr_em_st_sale_offset >= 0x9c
             && cbr_em_st_sale_end <= BUFFER_LENGTH) BEGIN
        FOR (cbr_em_st_i = cbr_em_st_sale_count - 1; cbr_em_st_i >= 0; --cbr_em_st_i) BEGIN
          SET cbr_em_st_row = cbr_em_st_sale_offset + cbr_em_st_i * 0x1c
          READ_ASCII cbr_em_st_row cbr_em_st_item (8) NULL
          TO_UPPER cbr_em_st_item
          SPRINT cbr_em_st_output ~~
          SET cbr_em_st_courage = 0 SET cbr_em_st_hope = 0
          PATCH_IF VARIABLE_IS_SET $cbr_em_enchanted_donors(~%cbr_em_st_item%~) BEGIN
            SET cbr_em_st_courage = $cbr_em_enchanted_donors(~%cbr_em_st_item%~)
          END
          PATCH_IF VARIABLE_IS_SET $cbr_em_hopeless_donors(~%cbr_em_st_item%~) BEGIN
            SET cbr_em_st_hope = $cbr_em_hopeless_donors(~%cbr_em_st_item%~)
          END
          FOR (cbr_em_st_kind = 0; cbr_em_st_kind < 2; ++cbr_em_st_kind) BEGIN
          SPRINT cbr_em_st_output ~~
          PATCH_IF (cbr_em_st_kind = 0 && cbr_em_make_courage_scroll = 1 && cbr_em_st_courage = 1) BEGIN
            SPRINT cbr_em_st_output ~CBRCRGSC~
          END ELSE PATCH_IF (cbr_em_st_kind = 1 && cbr_em_make_hope_scroll = 1 && cbr_em_st_hope = 1) BEGIN
            SPRINT cbr_em_st_output ~CBRHOPSC~
          END
          PATCH_IF !(~%cbr_em_st_output%~ STR_EQ ~~) BEGIN
            SET cbr_em_st_insert = cbr_em_st_row + 0x1c
            SET cbr_em_st_already = 0
            FOR (cbr_em_st_child = 1; cbr_em_st_child <= 2
              && cbr_em_st_i + cbr_em_st_child < cbr_em_st_sale_count; ++cbr_em_st_child) BEGIN
              SET cbr_em_st_child_at = cbr_em_st_row + cbr_em_st_child * 0x1c
              READ_ASCII cbr_em_st_child_at cbr_em_st_next (8) NULL
              PATCH_IF (~%cbr_em_st_next%~ STRING_EQUAL_CASE ~%cbr_em_st_output%~) BEGIN
                SET cbr_em_st_already = 1
                SET cbr_em_st_insert = cbr_em_st_child_at
                SET cbr_em_st_child = 2
              END ELSE PATCH_IF NOT ((~%cbr_em_st_next%~ STRING_EQUAL_CASE ~CBRCRGSC~)
                OR (~%cbr_em_st_next%~ STRING_EQUAL_CASE ~CBRHOPSC~)) BEGIN
                SET cbr_em_st_child = 2
              END
            END
            PATCH_IF (cbr_em_st_already = 0) BEGIN
              INSERT_BYTES cbr_em_st_insert 0x1c
              SET cbr_em_st_sale_count += 1
              WRITE_LONG 0x38 cbr_em_st_sale_count
              READ_LONG 0x2c cbr_em_st_section
              PATCH_IF (cbr_em_st_section >= cbr_em_st_insert) BEGIN
                WRITE_LONG 0x2c (cbr_em_st_section + 0x1c)
              END
              READ_LONG 0x4c cbr_em_st_section
              PATCH_IF (cbr_em_st_section >= cbr_em_st_insert) BEGIN
                WRITE_LONG 0x4c (cbr_em_st_section + 0x1c)
              END
              READ_LONG 0x70 cbr_em_st_section
              PATCH_IF (cbr_em_st_section >= cbr_em_st_insert) BEGIN
                WRITE_LONG 0x70 (cbr_em_st_section + 0x1c)
              END
            END
            WRITE_ASCIIE cbr_em_st_insert ~%cbr_em_st_output%~ #8
            FOR (cbr_em_st_b = 0; cbr_em_st_b < 0x14; ++cbr_em_st_b) BEGIN
              READ_BYTE (cbr_em_st_row + 0x08 + cbr_em_st_b) cbr_em_st_value
              WRITE_BYTE (cbr_em_st_insert + 0x08 + cbr_em_st_b) cbr_em_st_value
            END
          END
          END
        END
      END ELSE BEGIN PATCH_PRINT ~CBR Emotion: %SOURCE_FILE% has an unreadable store table; continuing.~ END
    END ELSE BEGIN PATCH_PRINT ~CBR Emotion: %SOURCE_FILE% has an unreadable store header; continuing.~ END
    BUT_ONLY
END

// ============================================================
// Class and kit revisions (400-499)
// ============================================================

BEGIN @400
DESIGNATED 400
GROUP @1400
LABEL ~cbr_cleric_tempus_weapon_training~

REQUIRE_PREDICATE (GAME_IS ~bg2ee eet~) @9410
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~OHTEMPUS.2DA~) @9412
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~C0PR#C4.SPL~) @9413
REQUIRE_PREDICATE ((FILE_EXISTS_IN_GAME ~C0PR#90.SPL~)
               AND (FILE_EXISTS_IN_GAME ~C0PR#92.SPL~)
               AND (FILE_EXISTS_IN_GAME ~C0PR#103.SPL~)) @9414
// Artisan's custom permission stat for longswords must exist in the live
// STATS.IDS; the resolved value parameterizes the migration helper's gate.
REQUIRE_PREDICATE ((IDS_OF_SYMBOL (~stats~ ~C0_PROFICIENCYLONGSWORD~) > 0)
               AND (IDS_OF_SYMBOL (~stats~ ~C0_PROFICIENCYLONGSWORD~) < 65536)) @9416

OUTER_SET cbr_wt_resolved_ls_perm_stat = IDS_OF_SYMBOL (~stats~ ~C0_PROFICIENCYLONGSWORD~)

// Materialize the three file-backed inputs at their canonical override
// paths (same transactional pattern as the Holy Power components).
LAF cbr_setup_stage STR_VAR file = ~WEAPPROF.2DA~ END
LAF cbr_setup_stage STR_VAR file = ~C0PR#C4.SPL~ END
LAF cbr_setup_stage STR_VAR file = ~SPLPROT.2DA~ END

LAF cbr_apply_tempus_weapon_training
  INT_VAR ls_perm_stat = cbr_wt_resolved_ls_perm_stat
  STR_VAR resource_dir = ~override~
END

BEGIN @401
DESIGNATED 401
SUBCOMPONENT @1401
GROUP @1400
LABEL ~cbr_cleric_tempus_holy_power_auto~

REQUIRE_PREDICATE (GAME_IS ~bg2ee eet~) @9400
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~OHTEMPUS.2DA~) @9401
OUTER_SPRINT cbr_tempus_compatibility_mode ~auto~
LAM cbr_install_tempus_holy_power_component

BEGIN @402
DESIGNATED 402
SUBCOMPONENT @1401
GROUP @1400
LABEL ~cbr_cleric_tempus_holy_power_force_double~

REQUIRE_PREDICATE (GAME_IS ~bg2ee eet~) @9400
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~OHTEMPUS.2DA~) @9401
OUTER_SPRINT cbr_tempus_compatibility_mode ~force_double~
LAM cbr_install_tempus_holy_power_component

BEGIN @403
DESIGNATED 403
SUBCOMPONENT @1401
GROUP @1400
LABEL ~cbr_cleric_tempus_holy_power_force_additive~

REQUIRE_PREDICATE (GAME_IS ~bg2ee eet~) @9400
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~OHTEMPUS.2DA~) @9401
OUTER_SPRINT cbr_tempus_compatibility_mode ~force_additive~
LAM cbr_install_tempus_holy_power_component

BEGIN @404
DESIGNATED 404
GROUP @1400
LABEL ~cbr_cleric_tempus_chaos_tides~

REQUIRE_PREDICATE (GAME_IS ~bg2ee eet~) @9430
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~OHTEMPUS.2DA~) @9431
// The three announce lines are this mod's only game-facing strings:
// dialog.tlk grows append-only by at most three entries (WeiDU reuses an
// existing identical string, so a reinstall resolves to the same strrefs).
OUTER_SET cbr_ct_resolved_onslaught = RESOLVE_STR_REF (@4041)
OUTER_SET cbr_ct_resolved_bulwark   = RESOLVE_STR_REF (@4042)
OUTER_SET cbr_ct_resolved_fortune   = RESOLVE_STR_REF (@4043)

LAF cbr_setup_stage STR_VAR file = ~OHTMPS2.SPL~ END
LAF cbr_setup_stage STR_VAR file = ~OHTMPS2D.SPL~ END
LAF cbr_setup_stage STR_VAR file = ~OHTMPS2E.SPL~ END

LAF cbr_apply_tempus_chaos_tides
  INT_VAR
    strref_onslaught = cbr_ct_resolved_onslaught
    strref_bulwark   = cbr_ct_resolved_bulwark
    strref_fortune   = cbr_ct_resolved_fortune
  STR_VAR resource_dir = ~override~
END

BEGIN @405
DESIGNATED 405
GROUP @1400
LABEL ~cbr_cleric_tempus_divination_toll~

REQUIRE_PREDICATE (GAME_IS ~bg2ee eet~) @9420
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~OHTEMPUS.2DA~) @9421

// Discover the installed Divination priest spells (school byte 0x25 == 3)
// across override and BIFs. Reads only: BUT_ONLY writes nothing back.
OUTER_SET cbr_divtoll_count = 0
COPY_EXISTING_REGEXP GLOB ~^sppr[1-7][0-9][0-9]\.spl$~ ~override~
  PATCH_IF (BUFFER_LENGTH > 0x37) BEGIN
    READ_ASCII 0x00 cbr_dt_signature (8)
    PATCH_IF (~%cbr_dt_signature%~ STR_EQ ~SPL V1  ~) BEGIN
      READ_BYTE 0x25 cbr_dt_school
      PATCH_IF (cbr_dt_school = 3) BEGIN
        SPRINT $cbr_divtoll_res(~%cbr_divtoll_count%~) ~%SOURCE_RES%~
        SET cbr_divtoll_count += 1
      END
    END
  END
  BUT_ONLY


LAF cbr_setup_stage STR_VAR file = ~OHTEMPUS.2DA~ END

LAF cbr_apply_tempus_divination_toll
  INT_VAR divination_count = cbr_divtoll_count
  STR_VAR resource_dir = ~override~
END

// The two specialization-APR variants are mutually exclusive subcomponents:
// 406 flips CLSWPBON's CLERIC row (engine table — grants the FULL warrior
// WSPATCK progression, live-verified stronger than the kit advertises),
// 407 ships an EEex derived-stats listener that adds exactly +1/2 attack
// while the selected weapon holds 2+ pips (the advertised behavior).

BEGIN @406
DESIGNATED 406
SUBCOMPONENT @1406
GROUP @1400
LABEL ~cbr_cleric_tempus_spec_apr~

REQUIRE_PREDICATE (GAME_IS ~bg2ee eet~) @9440
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~OHTEMPUS.2DA~) @9442

LAF cbr_setup_stage STR_VAR file = ~CLSWPBON.2DA~ END

LAF cbr_apply_tempus_spec_apr
  STR_VAR resource_dir = ~override~
END

BEGIN @407
DESIGNATED 407
SUBCOMPONENT @1406
GROUP @1400
LABEL ~cbr_cleric_tempus_spec_apr_eeex~

REQUIRE_PREDICATE (GAME_IS ~bg2ee eet~) @9440
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~OHTEMPUS.2DA~) @9442
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~M___EEex.lua~) @9450
REQUIRE_PREDICATE (IDS_OF_SYMBOL (~kit~ ~OHTEMPUS~) > 0) @9451
OUTER_SPRINT cbr_sae_component_tag ~407~
LAM cbr_install_tempus_spec_apr_eeex_component

// Component 409 — tail re-ship of the 407 listener for installs that carry
// the v0.1.0 file (relative write, no idempotence marker → runaway APR,
// research/07). Never reinstall 407 mid-stack: this component overwrites
// override/M_CBRAPR.lua in place, WeiDU-tracked, and its uninstall hands the
// previous listener back. On a fresh install it is a byte-identical no-op.
BEGIN @409
DESIGNATED 409
GROUP @1400
LABEL ~cbr_cleric_tempus_spec_apr_eeex_refresh~
REQUIRE_PREDICATE (MOD_IS_INSTALLED ~setup-chriz-bg-rebalance.tp2~ 407) @9452


REQUIRE_PREDICATE (GAME_IS ~bg2ee eet~) @9440
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~OHTEMPUS.2DA~) @9442
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~M___EEex.lua~) @9450
REQUIRE_PREDICATE (IDS_OF_SYMBOL (~kit~ ~OHTEMPUS~) > 0) @9451
OUTER_SPRINT cbr_sae_component_tag ~409~
LAM cbr_install_tempus_spec_apr_eeex_component

BEGIN @408
DESIGNATED 408
GROUP @1400
LABEL ~cbr_cleric_tempus_descriptions~
REQUIRE_PREDICATE (MOD_IS_INSTALLED ~setup-chriz-bg-rebalance.tp2~ 400) @9462

REQUIRE_PREDICATE (MOD_IS_INSTALLED ~setup-chriz-bg-rebalance.tp2~ 404) @9462

REQUIRE_PREDICATE (MOD_IS_INSTALLED ~setup-chriz-bg-rebalance.tp2~ 405) @9462

REQUIRE_PREDICATE (MOD_IS_INSTALLED ~setup-chriz-bg-rebalance.tp2~ 407) @9462


REQUIRE_PREDICATE (GAME_IS ~bg2ee eet~) @9460
// The text describes the full rework - gate on each sibling's artifact.
// The 401-403 Holy Power family has no unique artifact in auto/doubling
// mode; its presence is assumed and documented, not enforced.
// Append the three new strings (WeiDU reuses identical strings on
// reinstall, so dialog.tlk stays append-stable - the 404 precedent).
OUTER_SET cbr_ds_resolved_kit_help = RESOLVE_STR_REF (@4081)
OUTER_SET cbr_ds_resolved_hp_desc  = RESOLVE_STR_REF (@4082)
OUTER_SET cbr_ds_resolved_cob_desc = RESOLVE_STR_REF (@4083)

LAF cbr_setup_stage STR_VAR file = ~KITLIST.2DA~ END
