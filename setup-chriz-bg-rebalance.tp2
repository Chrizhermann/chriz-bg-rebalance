// existing identical string, so a reinstall resolves to the same strrefs).
OUTER_SET cbr_ct_resolved_onslaught = RESOLVE_STR_REF (@4041)
OUTER_SET cbr_ct_resolved_bulwark   = RESOLVE_STR_REF (@4042)
