BACKUP ~weidu_external/backup/chriz-bg-rebalance~
AUTHOR ~Christopher Hermann (github.com/Chrizhermann/chriz-bg-rebalance)~
VERSION ~v0.2.0~

// Load the tested transformation library and define one installer wrapper for
// all Tempus Holy Power compatibility choices. WeiDU's backup namespace is
// basename-flat, so staging and later publishing the same resource basename
// would make exact uninstall unsafe. Instead, materialize the six file-backed
// inputs at their canonical override paths inside the component transaction,
// then let the shared preflight-first transformation operate there directly.
ALWAYS
  INCLUDE ~chriz-bg-rebalance/lib/tempus_holy_power.tpa~
  INCLUDE ~chriz-bg-rebalance/lib/tempus_weapon_training.tpa~
  INCLUDE ~chriz-bg-rebalance/lib/tempus_chaos_tides.tpa~
  INCLUDE ~chriz-bg-rebalance/lib/tempus_divination_toll.tpa~
  INCLUDE ~chriz-bg-rebalance/lib/tempus_spec_apr.tpa~
  INCLUDE ~chriz-bg-rebalance/lib/tempus_spec_apr_eeex.tpa~
  INCLUDE ~chriz-bg-rebalance/lib/tempus_descriptions.tpa~
  INCLUDE ~chriz-bg-rebalance/lib/scs_weapon_protection_semantics.tpa~

  DEFINE_ACTION_MACRO cbr_install_tempus_holy_power_component
  BEGIN
    // Both floors match cbr_validate_spell_ids' require-mode contract:
    // symbolic ids below 1100/2100 would denote a level-0 spell no EE game
    // defines, so the slot arithmetic below always yields the engine's
    // three-digit SPPR###/SPWI### form and needs no zero padding.
    OUTER_SET cbr_tempus_divine_id = IDS_OF_SYMBOL (~spell~ ~CLERIC_HOLY_POWER~)
    ACTION_IF (cbr_tempus_divine_id < 1100 OR cbr_tempus_divine_id > 1999) BEGIN
      FAIL @9403
    END
    OUTER_SET cbr_tempus_divine_slot = cbr_tempus_divine_id - 1000
    OUTER_SPRINT cbr_tempus_divine_resref ~SPPR%cbr_tempus_divine_slot%~

    OUTER_SET cbr_tempus_haste_id = IDS_OF_SYMBOL (~spell~ ~WIZARD_IMPROVED_HASTE~)
    ACTION_IF (cbr_tempus_haste_id < 2100 OR cbr_tempus_haste_id > 2999) BEGIN
      FAIL @9404
    END
    OUTER_SET cbr_tempus_haste_slot = cbr_tempus_haste_id - 2000
    OUTER_SPRINT cbr_tempus_haste_resref ~SPWI%cbr_tempus_haste_slot%~

    ACTION_IF !(FILE_EXISTS_IN_GAME ~%cbr_tempus_divine_resref%.SPL~) BEGIN
      FAIL @9405
    END
    ACTION_IF !(FILE_EXISTS_IN_GAME ~%cbr_tempus_haste_resref%.SPL~) BEGIN
      FAIL @9406
    END

    // Materialize the six file-backed inputs at their canonical override
    // paths. Do not add BUT_ONLY: an unchanged BIFF-only input still has to
    // exist in override for the file-based production transformer. WeiDU owns
    // every write below transactionally, including rollback on a later FAIL
    // and exact removal/restoration on uninstall.
    // SPELL.IDS stays unstaged: both symbolic resrefs were already resolved
    // against the live game through IDS_OF_SYMBOL above, and copying
    // SPELL.IDS into override would trigger WeiDU's IDS-tracking side file
    // (SPELL.IDS.INSTALLED); the library skips only that one re-validation
    // via spell_ids=skip.
    COPY_EXISTING ~OHTEMPUS.2DA~ ~override/OHTEMPUS.2DA~
    COPY_EXISTING ~OHTMPS1.SPL~ ~override/OHTMPS1.SPL~
    COPY_EXISTING ~%cbr_tempus_divine_resref%.SPL~ ~override/%cbr_tempus_divine_resref%.SPL~
    COPY_EXISTING ~%cbr_tempus_haste_resref%.SPL~ ~override/%cbr_tempus_haste_resref%.SPL~
    COPY_EXISTING ~SPLSTATE.IDS~ ~override/SPLSTATE.IDS~
    COPY_EXISTING ~SPLPROT.2DA~ ~override/SPLPROT.2DA~

    LAF cbr_apply_tempus_holy_power
      STR_VAR
        resource_dir          = ~override~
        compatibility_mode    = EVAL ~%cbr_tempus_compatibility_mode%~
        divine_power_resref   = EVAL ~%cbr_tempus_divine_resref%~
        improved_haste_resref = EVAL ~%cbr_tempus_haste_resref%~
        spell_ids             = ~skip~
        phase                 = ~full~
    END
  END // cbr_install_tempus_holy_power_component

  // Shared body of components 407 (fresh install) and 409 (tail re-ship).
  // Kit ids are allocated per-install by ADD_KIT order — resolve OHTEMPUS
  // from the live KIT.IDS; the listener's idempotence marker is a private
  // spell state allocated in the materialized SPLSTATE.IDS. Both values are
  // stamped into the Lua at install time.
  // Callers set cbr_sae_component_tag (~407~ / ~409~) for the summary line.
  DEFINE_ACTION_MACRO cbr_install_tempus_spec_apr_eeex_component
  BEGIN
    OUTER_SET cbr_sae_resolved_kit_id = IDS_OF_SYMBOL (~kit~ ~OHTEMPUS~)
    COPY_EXISTING ~SPLSTATE.IDS~ ~override/SPLSTATE.IDS~
    LAF cbr_allocate_tempus_spec_apr_state
      INT_VAR planned_value = 242
      STR_VAR resource_dir = ~override~
      RET cbr_sae_marker_state = state_value
    END
    LAF cbr_apply_tempus_spec_apr_eeex
      INT_VAR
        kit_id = cbr_sae_resolved_kit_id
        marker_state = cbr_sae_marker_state
      STR_VAR
        resource_dir = ~override~
        template_file = ~chriz-bg-rebalance/lua/M_CBRAPR.lua~
        component_tag = EVAL ~%cbr_sae_component_tag%~
    END
  END // cbr_install_tempus_spec_apr_eeex_component
END // ALWAYS

AUTO_TRA ~chriz-bg-rebalance/languages/%s~
LANGUAGE ~English~ ~english~ ~chriz-bg-rebalance/languages/english/setup.tra~

// ============================================================
// chriz-bg-rebalance — SCS- & SR-adjacent balance adjustments
//
// 100-199: SCS adjustments
// 200-299: SR adjustments
// 300-399: cross-cutting audits/fixes
// 400-499: class and kit revisions
// ============================================================

// ============================================================
// SCS adjustments (100-199)
// ============================================================

BEGIN @100 DESIGNATED 100 GROUP @1100 LABEL ~cbr_scs_telekinetic_storm_save_fix~
REQUIRE_PREDICATE (IDS_OF_SYMBOL (~spell~ ~WIZARD_TELEKINETIC_STORM~) > 2000) @9100

// SCS allocates the spell slot at install time — resolve the resref via spell.ids.
// spell.ids value 2LNN (2=wizard, L=level, NN=number) maps to SPWI(LNN).spl.
OUTER_SET cbr_tks_num = (IDS_OF_SYMBOL (~spell~ ~WIZARD_TELEKINETIC_STORM~)) - 2000
OUTER_SPRINT cbr_tks_res ~SPWI%cbr_tks_num%~

ACTION_IF NOT (FILE_EXISTS_IN_GAME ~%cbr_tks_res%.spl~) BEGIN
  FAIL ~spell.ids maps WIZARD_TELEKINETIC_STORM to %cbr_tks_res%.spl, but that file does not exist in the game.~
END

// Upstream bug (SCS stratagems/newspell/extra_arcane_spells.tpa, telekinetic_storm):
// the op12 damage effect sets s_save_for_half=1 but omits s_save_vs_spell=1 and
// s_bypass_mirror_image=1 (sibling spells stormbolts/icy_ray in the same file have both).
// With no save-type bits set the engine never rolls a save, so the save-for-half flag is
// inert and the spell always deals full damage, contradicting its description
// ("Saving Throw: 1/2"). Fix: OR save-vs-spell (bit 0) + EE bypass-mirror-image (bit 24)
// into the savetype dword of every save-for-half op12 effect, in all scaled ability headers.
COPY_EXISTING ~%cbr_tks_res%.spl~ ~override~
  READ_LONG  0x64 ext_off
  READ_SHORT 0x68 ext_cnt
  READ_LONG  0x6a fx_off
  FOR (a = 0; a < ext_cnt; ++a) BEGIN
    // empirical ability layout: 0x1e = nFx, 0x20 = first fx index (IESDP documents these
    // two bytes earlier; the empirical layout is what shipping engines/WeiDU use)
    READ_SHORT (ext_off + a * 0x28 + 0x1e) nfx
    READ_SHORT (ext_off + a * 0x28 + 0x20) first
    FOR (e = 0; e < nfx; ++e) BEGIN
      SET eo = fx_off + ((first + e) * 0x30)
      READ_SHORT eo fx_opcode
      PATCH_IF (fx_opcode = 12) BEGIN
        READ_LONG (eo + 0x2c) fx_special
        PATCH_IF ((fx_special BAND 0x100) = 0x100) BEGIN   // save-for-half flag present
          READ_LONG (eo + 0x24) fx_savetype
          WRITE_LONG (eo + 0x24) (fx_savetype BOR 0x1000001)
        END
      END
    END
  END
  BUT_ONLY

BEGIN @101 DESIGNATED 101 GROUP @1100 LABEL ~cbr_scs_freedom_scrolls~
REQUIRE_PREDICATE (GAME_IS ~bg2ee eet~) @9101
// The tweak belongs to SCS's spell-tweak family, but its rationale (liches love
// Imprisonment) also holds for AI-only installs — accept either footprint.
REQUIRE_PREDICATE ((MOD_IS_INSTALLED ~stratagems/setup-stratagems.tp2~ 2000)
                OR (MOD_IS_INSTALLED ~stratagems/setup-stratagems.tp2~ 5900)) @9102
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~ribald.sto~) @9103
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~scrl9z.itm~) @9103

// Upstream: SCS v34.3 spell tweak `freedom_scrolls` put 5 Scrolls of Freedom (scrl9z,
// teaches WIZARD_FREEDOM/SPWI917) into shop08 (Galoomp's Books) AND ribald (Adventurer's
// Mart). The v35 reorganization dropped the tweak's dispatch row from
// spell/data/spelltweaks.2da (so it never runs) and dropped ribald from the dead code too.
// Confirmed unintentional. Restore the Adventurer's Mart half with upstream's own item
// parameters, only if the store doesn't already offer the scroll (idempotent over a
// re-run, a v34 install, or a future fixed SCS). See research/03.
COPY_EXISTING ~ribald.sto~ ~override~
  READ_LONG 0x34 sale_off
  READ_LONG 0x38 sale_cnt
  SET cbr_found = 0 - 1
  SET cbr_avail = 0
  FOR (i = 0; i < sale_cnt; ++i) BEGIN
    READ_ASCII (sale_off + i * 0x1c) cbr_res (8)
    PATCH_IF (~%cbr_res%~ STRING_EQUAL_CASE ~scrl9z~) AND (cbr_found < 0) BEGIN
      SET cbr_found = i
      READ_LONG (sale_off + i * 0x1c + 0x14) cbr_qty   // amount in stock
      READ_LONG (sale_off + i * 0x1c + 0x18) cbr_inf   // infinite-supply flag
      PATCH_IF (cbr_qty > 0) OR (cbr_inf > 0) BEGIN
        SET cbr_avail = 1
      END
    END
  END
  PATCH_IF (cbr_found < 0) BEGIN
    ADD_STORE_ITEM ~scrl9z~ AFTER ~scrla5~ #1 #0 #0 ~IDENTIFIED~ #5
    PATCH_PRINT ~cbr 101: added 5x scrl9z (Scroll of Freedom) to the Adventurer's Mart.~
  END ELSE PATCH_IF (cbr_avail = 0) BEGIN
    WRITE_LONG (sale_off + cbr_found * 0x1c + 0x14) 5
    PATCH_PRINT ~cbr 101: Adventurer's Mart lists scrl9z at zero stock - restocked to 5.~
  END ELSE BEGIN
    PATCH_PRINT ~cbr 101: Adventurer's Mart already sells scrl9z - nothing to do.~
  END
  BUT_ONLY

BEGIN @120
DESIGNATED 120
GROUP @1100
LABEL ~cbr_scs_sr_weapon_protection_semantics~

REQUIRE_PREDICATE (GAME_IS ~bg2ee eet~) @9120
REQUIRE_PREDICATE
  (MOD_IS_INSTALLED ~stratagems/setup-stratagems.tp2~ 6030)
  @9121
// SCS necessarily publishes its final SPELL.IDS to override. The production
// library takes an explicit path so its exact parser is shared with the
// hermetic fixture harness and never relies on a hardcoded SR resref.
REQUIRE_PREDICATE
  ((FILE_EXISTS_IN_GAME ~SPELL.IDS~) AND (FILE_EXISTS ~override/SPELL.IDS~))
  @9122
REQUIRE_PREDICATE
  ((IDS_OF_SYMBOL (~spell~ ~WIZARD_PROTECTION_FROM_MAGIC_WEAPONS~) >= 2000)
   AND (IDS_OF_SYMBOL (~spell~ ~WIZARD_PROTECTION_FROM_MAGIC_WEAPONS~) <= 2999)
   AND (IDS_OF_SYMBOL (~spell~ ~WIZARD_MANTLE~) >= 2000)
   AND (IDS_OF_SYMBOL (~spell~ ~WIZARD_MANTLE~) <= 2999)
   AND (IDS_OF_SYMBOL (~spell~ ~WIZARD_IMPROVED_MANTLE~) >= 2000)
   AND (IDS_OF_SYMBOL (~spell~ ~WIZARD_IMPROVED_MANTLE~) <= 2999)
   AND (IDS_OF_SYMBOL (~spell~ ~WIZARD_MOMENT_OF_PRESCIENCE~) >= 2000)
   AND (IDS_OF_SYMBOL (~spell~ ~WIZARD_MOMENT_OF_PRESCIENCE~) <= 2999)
   AND (IDS_OF_SYMBOL (~spell~ ~WIZARD_ABSOLUTE_IMMUNITY~) >= 2000)
   AND (IDS_OF_SYMBOL (~spell~ ~WIZARD_ABSOLUTE_IMMUNITY~) <= 2999)
   AND (IDS_OF_SYMBOL (~spell~ ~WIZARD_BREACH~) >= 2000)
   AND (IDS_OF_SYMBOL (~spell~ ~WIZARD_BREACH~) <= 2999)
   AND (IDS_OF_SYMBOL (~spell~ ~WIZARD_DISPEL_MAGIC~) >= 2000)
   AND (IDS_OF_SYMBOL (~spell~ ~WIZARD_DISPEL_MAGIC~) <= 2999))
  @9123
REQUIRE_PREDICATE
  (IDS_OF_SYMBOL (~spell~ ~WIZARD_IMPROVED_MANTLE~)
   = IDS_OF_SYMBOL (~spell~ ~WIZARD_MOMENT_OF_PRESCIENCE~))
  @9125

OUTER_SET cbr_120_pfmw_id = IDS_OF_SYMBOL (~spell~ ~WIZARD_PROTECTION_FROM_MAGIC_WEAPONS~)
OUTER_SET cbr_120_mantle_id = IDS_OF_SYMBOL (~spell~ ~WIZARD_MANTLE~)
OUTER_SET cbr_120_improved_id = IDS_OF_SYMBOL (~spell~ ~WIZARD_IMPROVED_MANTLE~)
OUTER_SET cbr_120_mop_id = IDS_OF_SYMBOL (~spell~ ~WIZARD_MOMENT_OF_PRESCIENCE~)
OUTER_SET cbr_120_absolute_id = IDS_OF_SYMBOL (~spell~ ~WIZARD_ABSOLUTE_IMMUNITY~)
OUTER_SET cbr_120_breach_id = IDS_OF_SYMBOL (~spell~ ~WIZARD_BREACH~)
OUTER_SET cbr_120_dispel_id = IDS_OF_SYMBOL (~spell~ ~WIZARD_DISPEL_MAGIC~)
OUTER_SET cbr_120_pfmw_slot = cbr_120_pfmw_id - 2000
OUTER_SET cbr_120_mantle_slot = cbr_120_mantle_id - 2000
OUTER_SET cbr_120_improved_slot = cbr_120_improved_id - 2000
OUTER_SET cbr_120_absolute_slot = cbr_120_absolute_id - 2000
OUTER_SET cbr_120_breach_slot = cbr_120_breach_id - 2000
OUTER_SET cbr_120_dispel_slot = cbr_120_dispel_id - 2000
OUTER_SPRINT cbr_120_pfmw_resref ~SPWI%cbr_120_pfmw_slot%~
OUTER_SPRINT cbr_120_mantle_resref ~SPWI%cbr_120_mantle_slot%~
OUTER_SPRINT cbr_120_improved_resref ~SPWI%cbr_120_improved_slot%~
OUTER_SPRINT cbr_120_absolute_resref ~SPWI%cbr_120_absolute_slot%~
OUTER_SPRINT cbr_120_breach_resref ~SPWI%cbr_120_breach_slot%~
OUTER_SPRINT cbr_120_dispel_resref ~SPWI%cbr_120_dispel_slot%~

ACTION_IF !((FILE_EXISTS_IN_GAME ~%cbr_120_pfmw_resref%.SPL~)
         AND (FILE_EXISTS_IN_GAME ~%cbr_120_mantle_resref%.SPL~)
         AND (FILE_EXISTS_IN_GAME ~%cbr_120_improved_resref%.SPL~)
         AND (FILE_EXISTS_IN_GAME ~%cbr_120_absolute_resref%.SPL~)
         AND (FILE_EXISTS_IN_GAME ~%cbr_120_breach_resref%.SPL~)
         AND (FILE_EXISTS_IN_GAME ~%cbr_120_dispel_resref%.SPL~)) BEGIN
  FAIL @9124
END

// Materialize only the six classifier/counter roots. They are normally
// already loose final resources after SR/SCS; COPY_EXISTING also makes the
// public component work when one originates in a BIFF, while retaining
// normal WeiDU backup and rollback behavior.
ACTION_FOR_EACH cbr_120_root IN
  ~%cbr_120_pfmw_resref%~
  ~%cbr_120_mantle_resref%~
  ~%cbr_120_improved_resref%~
  ~%cbr_120_absolute_resref%~
  ~%cbr_120_breach_resref%~
  ~%cbr_120_dispel_resref%~
BEGIN
  COPY_EXISTING ~%cbr_120_root%.SPL~ ~override/%cbr_120_root%.SPL~
END

LAF cbr_apply_scs_weapon_protection_semantics
  STR_VAR
    resource_dir = ~override~
    script_dir = ~override~
    spell_ids = ~override/SPELL.IDS~
    phase = ~full~
  RET
    cbr_120_mismatch = mismatch_detected
    cbr_120_replacement = replacement_resref
    cbr_120_metadata = metadata_removed
    cbr_120_first = first_round_removed
    cbr_120_renewal = renewal_removed
    cbr_120_chain = chain_replaced
    cbr_120_unknown = unknown_blocks
END

PRINT ~cbr 120: metadata=%cbr_120_metadata%; first-round=%cbr_120_first%; renewal=%cbr_120_renewal%; chain=%cbr_120_chain%; unknown=%cbr_120_unknown%; replacement=%cbr_120_replacement%.~

// ============================================================
// Class and kit revisions (400-499)
// ============================================================

BEGIN @400
DESIGNATED 400
GROUP @1400
LABEL ~cbr_cleric_tempus_weapon_training~

REQUIRE_PREDICATE (GAME_IS ~bg2ee eet~) @9410
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~WEAPPROF.2DA~) @9411
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~OHTEMPUS.2DA~) @9412
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~C0PR#C4.SPL~) @9413
REQUIRE_PREDICATE ((FILE_EXISTS_IN_GAME ~C0PR#90.SPL~)
               AND (FILE_EXISTS_IN_GAME ~C0PR#92.SPL~)
               AND (FILE_EXISTS_IN_GAME ~C0PR#103.SPL~)) @9414
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~SPLPROT.2DA~) @9415
// Artisan's custom permission stat for longswords must exist in the live
// STATS.IDS; the resolved value parameterizes the migration helper's gate.
REQUIRE_PREDICATE ((IDS_OF_SYMBOL (~stats~ ~C0_PROFICIENCYLONGSWORD~) > 0)
               AND (IDS_OF_SYMBOL (~stats~ ~C0_PROFICIENCYLONGSWORD~) < 65536)) @9416

OUTER_SET cbr_wt_resolved_ls_perm_stat = IDS_OF_SYMBOL (~stats~ ~C0_PROFICIENCYLONGSWORD~)

// Materialize the three file-backed inputs at their canonical override
// paths (same transactional pattern as the Holy Power components).
COPY_EXISTING ~WEAPPROF.2DA~ ~override/WEAPPROF.2DA~
COPY_EXISTING ~C0PR#C4.SPL~ ~override/C0PR#C4.SPL~
COPY_EXISTING ~SPLPROT.2DA~ ~override/SPLPROT.2DA~

LAF cbr_apply_tempus_weapon_training
  INT_VAR ls_perm_stat = cbr_wt_resolved_ls_perm_stat
  STR_VAR resource_dir = ~override~
END

BEGIN @401
DESIGNATED 401
SUBCOMPONENT @1401
GROUP @1400
LABEL ~cbr_cleric_tempus_holy_power_auto~

REQUIRE_PREDICATE (GAME_IS ~bg2ee eet~) @9400
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~OHTEMPUS.2DA~) @9401
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~OHTMPS1.SPL~) @9402
REQUIRE_PREDICATE ((FILE_EXISTS_IN_GAME ~SPELL.IDS~) AND (FILE_EXISTS_IN_GAME ~SPLSTATE.IDS~) AND (FILE_EXISTS_IN_GAME ~SPLPROT.2DA~)) @9407
REQUIRE_PREDICATE ((IDS_OF_SYMBOL (~spell~ ~CLERIC_HOLY_POWER~) >= 1100) AND (IDS_OF_SYMBOL (~spell~ ~CLERIC_HOLY_POWER~) <= 1999)) @9403
REQUIRE_PREDICATE ((IDS_OF_SYMBOL (~spell~ ~WIZARD_IMPROVED_HASTE~) >= 2100) AND (IDS_OF_SYMBOL (~spell~ ~WIZARD_IMPROVED_HASTE~) <= 2999)) @9404

OUTER_SPRINT cbr_tempus_compatibility_mode ~auto~
LAM cbr_install_tempus_holy_power_component

