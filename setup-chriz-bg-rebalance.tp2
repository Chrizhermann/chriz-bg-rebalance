BEGIN @405
DESIGNATED 405
GROUP @1400
LABEL ~cbr_cleric_tempus_divination_toll~

REQUIRE_PREDICATE (GAME_IS ~bg2ee eet~) @9420
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~OHTEMPUS.2DA~) @9421

// Discover the installed Divination priest spells (school byte 0x25 == 3)
// across override and BIFs. Reads only: BUT_ONLY writes nothing back.
OUTER_SET cbr_divtoll_count = 0
COPY_EXISTING_REGEXP GLOB ~^sppr[1-7][0-9][0-9]\.spl$~ ~override~
  PATCH_IF (BUFFER_LENGTH > 0x37) BEGIN
    READ_ASCII 0x00 cbr_dt_signature (8)
    PATCH_IF (~%cbr_dt_signature%~ STR_EQ ~SPL V1  ~) BEGIN
      READ_BYTE 0x25 cbr_dt_school
      PATCH_IF (cbr_dt_school = 3) BEGIN
        SPRINT $cbr_divtoll_res(~%cbr_divtoll_count%~) ~%SOURCE_RES%~
        SET cbr_divtoll_count += 1
      END
    END
  END
  BUT_ONLY

ACTION_IF (cbr_divtoll_count = 0) BEGIN
  FAIL @9422
END

COPY_EXISTING ~OHTEMPUS.2DA~ ~override/OHTEMPUS.2DA~

LAF cbr_apply_tempus_divination_toll
  INT_VAR divination_count = cbr_divtoll_count
  STR_VAR resource_dir = ~override~
END

// The two specialization-APR variants are mutually exclusive subcomponents:
// 406 flips CLSWPBON's CLERIC row (engine table — grants the FULL warrior
// WSPATCK progression, live-verified stronger than the kit advertises),
// 407 ships an EEex derived-stats listener that adds exactly +1/2 attack
// while the selected weapon holds 2+ pips (the advertised behavior).

