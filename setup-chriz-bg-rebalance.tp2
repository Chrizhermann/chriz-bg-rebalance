REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~M___EEex.lua~) @9212
REQUIRE_PREDICATE NOT (MOD_IS_INSTALLED ~cbr_sr_antimagic/setup-cbr_sr_antimagic.tp2~ 210) @9213
