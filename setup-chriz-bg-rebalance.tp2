BEGIN @404
DESIGNATED 404
GROUP @1400
LABEL ~cbr_cleric_tempus_chaos_tides~

REQUIRE_PREDICATE (GAME_IS ~bg2ee eet~) @9430
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~OHTEMPUS.2DA~) @9431
REQUIRE_PREDICATE ((FILE_EXISTS_IN_GAME ~OHTMPS2.SPL~)
               AND (FILE_EXISTS_IN_GAME ~OHTMPS2D.SPL~)
               AND (FILE_EXISTS_IN_GAME ~OHTMPS2E.SPL~)) @9432

// The three announce lines are this mod's only game-facing strings:
// dialog.tlk grows append-only by at most three entries (WeiDU reuses an
// existing identical string, so a reinstall resolves to the same strrefs).
OUTER_SET cbr_ct_resolved_onslaught = RESOLVE_STR_REF (@4041)
OUTER_SET cbr_ct_resolved_bulwark   = RESOLVE_STR_REF (@4042)
OUTER_SET cbr_ct_resolved_fortune   = RESOLVE_STR_REF (@4043)

COPY_EXISTING ~OHTMPS2.SPL~ ~override/OHTMPS2.SPL~
COPY_EXISTING ~OHTMPS2D.SPL~ ~override/OHTMPS2D.SPL~
COPY_EXISTING ~OHTMPS2E.SPL~ ~override/OHTMPS2E.SPL~

LAF cbr_apply_tempus_chaos_tides
  INT_VAR
    strref_onslaught = cbr_ct_resolved_onslaught
    strref_bulwark   = cbr_ct_resolved_bulwark
    strref_fortune   = cbr_ct_resolved_fortune
  STR_VAR resource_dir = ~override~
END

BEGIN @405
DESIGNATED 405
GROUP @1400
LABEL ~cbr_cleric_tempus_divination_toll~

REQUIRE_PREDICATE (GAME_IS ~bg2ee eet~) @9420
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~OHTEMPUS.2DA~) @9421

// Discover the installed Divination priest spells (school byte 0x25 == 3)
// across override and BIFs. Reads only: BUT_ONLY writes nothing back.
OUTER_SET cbr_divtoll_count = 0
COPY_EXISTING_REGEXP GLOB ~^sppr[1-7][0-9][0-9]\.spl$~ ~override~
  PATCH_IF (BUFFER_LENGTH > 0x37) BEGIN
    READ_ASCII 0x00 cbr_dt_signature (8)
    PATCH_IF (~%cbr_dt_signature%~ STR_EQ ~SPL V1  ~) BEGIN
      READ_BYTE 0x25 cbr_dt_school
      PATCH_IF (cbr_dt_school = 3) BEGIN
        SPRINT $cbr_divtoll_res(~%cbr_divtoll_count%~) ~%SOURCE_RES%~
        SET cbr_divtoll_count += 1
      END
    END
  END
  BUT_ONLY

ACTION_IF (cbr_divtoll_count = 0) BEGIN
  FAIL @9422
END

COPY_EXISTING ~OHTEMPUS.2DA~ ~override/OHTEMPUS.2DA~

LAF cbr_apply_tempus_divination_toll
  INT_VAR divination_count = cbr_divtoll_count
  STR_VAR resource_dir = ~override~
END

// The two specialization-APR variants are mutually exclusive subcomponents:
// 406 flips CLSWPBON's CLERIC row (engine table — grants the FULL warrior
// WSPATCK progression, live-verified stronger than the kit advertises),
// 407 ships an EEex derived-stats listener that adds exactly +1/2 attack
// while the selected weapon holds 2+ pips (the advertised behavior).

BEGIN @406
DESIGNATED 406
SUBCOMPONENT @1406
GROUP @1400
LABEL ~cbr_cleric_tempus_spec_apr~

REQUIRE_PREDICATE (GAME_IS ~bg2ee eet~) @9440
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~CLSWPBON.2DA~) @9441
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~OHTEMPUS.2DA~) @9442

COPY_EXISTING ~CLSWPBON.2DA~ ~override/CLSWPBON.2DA~

LAF cbr_apply_tempus_spec_apr
  STR_VAR resource_dir = ~override~
END

BEGIN @407
DESIGNATED 407
SUBCOMPONENT @1406
GROUP @1400
LABEL ~cbr_cleric_tempus_spec_apr_eeex~

REQUIRE_PREDICATE (GAME_IS ~bg2ee eet~) @9440
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~OHTEMPUS.2DA~) @9442
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~M___EEex.lua~) @9450
REQUIRE_PREDICATE (IDS_OF_SYMBOL (~kit~ ~OHTEMPUS~) > 0) @9451

// Kit ids are allocated per-install by ADD_KIT order — resolve OHTEMPUS
// from the live KIT.IDS and stamp it into the listener at install time.
OUTER_SET cbr_sae_resolved_kit_id = IDS_OF_SYMBOL (~kit~ ~OHTEMPUS~)

LAF cbr_apply_tempus_spec_apr_eeex
  INT_VAR kit_id = cbr_sae_resolved_kit_id
  STR_VAR
    resource_dir = ~override~
    template_file = ~chriz-bg-rebalance/lua/M_CBRAPR.lua~
END
