BACKUP ~weidu_external/backup/chriz-bg-rebalance~
AUTHOR ~Christopher Hermann (github.com/Chrizhermann/chriz-bg-rebalance)~
VERSION ~v0.5.0~

// Load the tested transformation library and define one installer wrapper for
// all Tempus Holy Power compatibility choices. WeiDU's backup namespace is
// basename-flat, so staging and later publishing the same resource basename
// would make exact uninstall unsafe. Instead, materialize the six file-backed
// inputs at their canonical override paths inside the component transaction,
// then let the shared preflight-first transformation operate there directly.
ALWAYS
  INCLUDE ~chriz-bg-rebalance/lib/tempus_holy_power.tpa~
  INCLUDE ~chriz-bg-rebalance/lib/tempus_weapon_training.tpa~
  INCLUDE ~chriz-bg-rebalance/lib/tempus_chaos_tides.tpa~
  INCLUDE ~chriz-bg-rebalance/lib/tempus_divination_toll.tpa~
  INCLUDE ~chriz-bg-rebalance/lib/tempus_spec_apr.tpa~
  INCLUDE ~chriz-bg-rebalance/lib/tempus_spec_apr_eeex.tpa~
  INCLUDE ~chriz-bg-rebalance/lib/tempus_descriptions.tpa~
  INCLUDE ~chriz-bg-rebalance/lib/bard_progression.tpa~
  INCLUDE ~chriz-bg-rebalance/lib/scs_weapon_protection_semantics.tpa~
  INCLUDE ~chriz-bg-rebalance/lib/ambient_readiness.tpa~
  INCLUDE ~chriz-bg-rebalance/lib/dragon_wing_buffet.tpa~
  INCLUDE ~chriz-bg-rebalance/lib/dragon_vorpal.tpa~
  INCLUDE ~chriz-bg-rebalance/lib/dragon_vorpal_effects.tpa~
  INCLUDE ~chriz-bg-rebalance/lib/emotion_hope_courage.tpa~

  DEFINE_ACTION_MACRO cbr_install_tempus_holy_power_component
  BEGIN
    // Both floors match cbr_validate_spell_ids' require-mode contract:
    // symbolic ids below 1100/2100 would denote a level-0 spell no EE game
    // defines, so the slot arithmetic below always yields the engine's
    // three-digit SPPR###/SPWI### form and needs no zero padding.
    OUTER_SET cbr_tempus_divine_id = IDS_OF_SYMBOL (~spell~ ~CLERIC_HOLY_POWER~)
    ACTION_IF (cbr_tempus_divine_id < 1100 OR cbr_tempus_divine_id > 1999) BEGIN
      FAIL @9403
    END
    OUTER_SET cbr_tempus_divine_slot = cbr_tempus_divine_id - 1000
    OUTER_SPRINT cbr_tempus_divine_resref ~SPPR%cbr_tempus_divine_slot%~

    OUTER_SET cbr_tempus_haste_id = IDS_OF_SYMBOL (~spell~ ~WIZARD_IMPROVED_HASTE~)
    ACTION_IF (cbr_tempus_haste_id < 2100 OR cbr_tempus_haste_id > 2999) BEGIN
      FAIL @9404
    END
    OUTER_SET cbr_tempus_haste_slot = cbr_tempus_haste_id - 2000
    OUTER_SPRINT cbr_tempus_haste_resref ~SPWI%cbr_tempus_haste_slot%~

    ACTION_IF !(FILE_EXISTS_IN_GAME ~%cbr_tempus_divine_resref%.SPL~) BEGIN
      FAIL @9405
    END
    ACTION_IF !(FILE_EXISTS_IN_GAME ~%cbr_tempus_haste_resref%.SPL~) BEGIN
      FAIL @9406
    END

    // Materialize the six file-backed inputs at their canonical override
    // paths. Do not add BUT_ONLY: an unchanged BIFF-only input still has to
    // exist in override for the file-based production transformer. WeiDU owns
    // every write below transactionally, including rollback on a later FAIL
    // and exact removal/restoration on uninstall.
    // SPELL.IDS stays unstaged: both symbolic resrefs were already resolved
    // against the live game through IDS_OF_SYMBOL above, and copying
    // SPELL.IDS into override would trigger WeiDU's IDS-tracking side file
    // (SPELL.IDS.INSTALLED); the library skips only that one re-validation
    // via spell_ids=skip.
    COPY_EXISTING ~OHTEMPUS.2DA~ ~override/OHTEMPUS.2DA~
    COPY_EXISTING ~OHTMPS1.SPL~ ~override/OHTMPS1.SPL~
    COPY_EXISTING ~%cbr_tempus_divine_resref%.SPL~ ~override/%cbr_tempus_divine_resref%.SPL~
    COPY_EXISTING ~%cbr_tempus_haste_resref%.SPL~ ~override/%cbr_tempus_haste_resref%.SPL~
    COPY_EXISTING ~SPLSTATE.IDS~ ~override/SPLSTATE.IDS~
    COPY_EXISTING ~SPLPROT.2DA~ ~override/SPLPROT.2DA~

    LAF cbr_apply_tempus_holy_power
      STR_VAR
        resource_dir          = ~override~
        compatibility_mode    = EVAL ~%cbr_tempus_compatibility_mode%~
        divine_power_resref   = EVAL ~%cbr_tempus_divine_resref%~
        improved_haste_resref = EVAL ~%cbr_tempus_haste_resref%~
        spell_ids             = ~skip~
        phase                 = ~full~
    END
  END // cbr_install_tempus_holy_power_component

  // Shared body of components 407 (fresh install) and 409 (tail re-ship).
  // Kit ids are allocated per-install by ADD_KIT order — resolve OHTEMPUS
  // from the live KIT.IDS; the listener's idempotence marker is a private
  // spell state allocated in the materialized SPLSTATE.IDS. Both values are
  // stamped into the Lua at install time.
  // Callers set cbr_sae_component_tag (~407~ / ~409~) for the summary line.
  DEFINE_ACTION_MACRO cbr_install_tempus_spec_apr_eeex_component
  BEGIN
    OUTER_SET cbr_sae_resolved_kit_id = IDS_OF_SYMBOL (~kit~ ~OHTEMPUS~)
    COPY_EXISTING ~SPLSTATE.IDS~ ~override/SPLSTATE.IDS~
    LAF cbr_allocate_tempus_spec_apr_state
      INT_VAR planned_value = 242
      STR_VAR resource_dir = ~override~
      RET cbr_sae_marker_state = state_value
    END
    LAF cbr_apply_tempus_spec_apr_eeex
      INT_VAR
        kit_id = cbr_sae_resolved_kit_id
        marker_state = cbr_sae_marker_state
      STR_VAR
        resource_dir = ~override~
        template_file = ~chriz-bg-rebalance/lua/M_CBRAPR.lua~
        component_tag = EVAL ~%cbr_sae_component_tag%~
    END
  END // cbr_install_tempus_spec_apr_eeex_component
END // ALWAYS

AUTO_TRA ~chriz-bg-rebalance/languages/%s~
LANGUAGE ~English~ ~english~ ~chriz-bg-rebalance/languages/english/setup.tra~

// ============================================================
// chriz-bg-rebalance — SCS- & SR-adjacent balance adjustments
//
// 100-199: SCS adjustments
// 200-299: SR adjustments
// 300-399: cross-cutting audits/fixes
// 400-499: class and kit revisions
// ============================================================

// ============================================================
// SCS adjustments (100-199)
// ============================================================

BEGIN @100 DESIGNATED 100 GROUP @1100 LABEL ~cbr_scs_telekinetic_storm_save_fix~
REQUIRE_PREDICATE (IDS_OF_SYMBOL (~spell~ ~WIZARD_TELEKINETIC_STORM~) > 2000) @9100

// SCS allocates the spell slot at install time — resolve the resref via spell.ids.
// spell.ids value 2LNN (2=wizard, L=level, NN=number) maps to SPWI(LNN).spl.
OUTER_SET cbr_tks_num = (IDS_OF_SYMBOL (~spell~ ~WIZARD_TELEKINETIC_STORM~)) - 2000
OUTER_SPRINT cbr_tks_res ~SPWI%cbr_tks_num%~

ACTION_IF NOT (FILE_EXISTS_IN_GAME ~%cbr_tks_res%.spl~) BEGIN
  FAIL ~spell.ids maps WIZARD_TELEKINETIC_STORM to %cbr_tks_res%.spl, but that file does not exist in the game.~
END

// Upstream bug (SCS stratagems/newspell/extra_arcane_spells.tpa, telekinetic_storm):
// the op12 damage effect sets s_save_for_half=1 but omits s_save_vs_spell=1 and
// s_bypass_mirror_image=1 (sibling spells stormbolts/icy_ray in the same file have both).
// With no save-type bits set the engine never rolls a save, so the save-for-half flag is
// inert and the spell always deals full damage, contradicting its description
// ("Saving Throw: 1/2"). Fix: OR save-vs-spell (bit 0) + EE bypass-mirror-image (bit 24)
// into the savetype dword of every save-for-half op12 effect, in all scaled ability headers.
COPY_EXISTING ~%cbr_tks_res%.spl~ ~override~
  READ_LONG  0x64 ext_off
  READ_SHORT 0x68 ext_cnt
  READ_LONG  0x6a fx_off
  FOR (a = 0; a < ext_cnt; ++a) BEGIN
    // empirical ability layout: 0x1e = nFx, 0x20 = first fx index (IESDP documents these
    // two bytes earlier; the empirical layout is what shipping engines/WeiDU use)
    READ_SHORT (ext_off + a * 0x28 + 0x1e) nfx
    READ_SHORT (ext_off + a * 0x28 + 0x20) first
    FOR (e = 0; e < nfx; ++e) BEGIN
      SET eo = fx_off + ((first + e) * 0x30)
      READ_SHORT eo fx_opcode
      PATCH_IF (fx_opcode = 12) BEGIN
        READ_LONG (eo + 0x2c) fx_special
        PATCH_IF ((fx_special BAND 0x100) = 0x100) BEGIN   // save-for-half flag present
          READ_LONG (eo + 0x24) fx_savetype
          WRITE_LONG (eo + 0x24) (fx_savetype BOR 0x1000001)
        END
      END
    END
  END
  BUT_ONLY

BEGIN @101 DESIGNATED 101 GROUP @1100 LABEL ~cbr_scs_freedom_scrolls~
REQUIRE_PREDICATE (GAME_IS ~bg2ee eet~) @9101
// The tweak belongs to SCS's spell-tweak family, but its rationale (liches love
// Imprisonment) also holds for AI-only installs — accept either footprint.
REQUIRE_PREDICATE ((MOD_IS_INSTALLED ~stratagems/setup-stratagems.tp2~ 2000)
                OR (MOD_IS_INSTALLED ~stratagems/setup-stratagems.tp2~ 5900)) @9102
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~ribald.sto~) @9103
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~scrl9z.itm~) @9103

// Upstream: SCS v34.3 spell tweak `freedom_scrolls` put 5 Scrolls of Freedom (scrl9z,
// teaches WIZARD_FREEDOM/SPWI917) into shop08 (Galoomp's Books) AND ribald (Adventurer's
// Mart). The v35 reorganization dropped the tweak's dispatch row from
// spell/data/spelltweaks.2da (so it never runs) and dropped ribald from the dead code too.
// Confirmed unintentional. Restore the Adventurer's Mart half with upstream's own item
// parameters, only if the store doesn't already offer the scroll (idempotent over a
// re-run, a v34 install, or a future fixed SCS). See research/03.
COPY_EXISTING ~ribald.sto~ ~override~
  READ_LONG 0x34 sale_off
  READ_LONG 0x38 sale_cnt
  SET cbr_found = 0 - 1
  SET cbr_avail = 0
  FOR (i = 0; i < sale_cnt; ++i) BEGIN
    READ_ASCII (sale_off + i * 0x1c) cbr_res (8)
    PATCH_IF (~%cbr_res%~ STRING_EQUAL_CASE ~scrl9z~) AND (cbr_found < 0) BEGIN
      SET cbr_found = i
      READ_LONG (sale_off + i * 0x1c + 0x14) cbr_qty   // amount in stock
      READ_LONG (sale_off + i * 0x1c + 0x18) cbr_inf   // infinite-supply flag
      PATCH_IF (cbr_qty > 0) OR (cbr_inf > 0) BEGIN
        SET cbr_avail = 1
      END
    END
  END
  PATCH_IF (cbr_found < 0) BEGIN
    ADD_STORE_ITEM ~scrl9z~ AFTER ~scrla5~ #1 #0 #0 ~IDENTIFIED~ #5
    PATCH_PRINT ~cbr 101: added 5x scrl9z (Scroll of Freedom) to the Adventurer's Mart.~
  END ELSE PATCH_IF (cbr_avail = 0) BEGIN
    WRITE_LONG (sale_off + cbr_found * 0x1c + 0x14) 5
    PATCH_PRINT ~cbr 101: Adventurer's Mart lists scrl9z at zero stock - restocked to 5.~
  END ELSE BEGIN
    PATCH_PRINT ~cbr 101: Adventurer's Mart already sells scrl9z - nothing to do.~
  END
  BUT_ONLY

BEGIN @110 DESIGNATED 110 GROUP @1100 LABEL ~cbr_scs_dragon_vorpal~
REQUIRE_PREDICATE (GAME_IS ~bg2ee eet~) @9110
REQUIRE_PREDICATE (MOD_IS_INSTALLED ~stratagems/setup-stratagems.tp2~ 6540) @9111
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~M___EEex.lua~) @9112

PRINT @1110
// Every existing encounter and reserved payload is validated before publishing
// the first runtime file. Native death handling retains anti-chunking settings.
LAF cbr_apply_dragon_vorpal_scripts INT_VAR apply = 0 END
LAF cbr_apply_dragon_vorpal_effects
  STR_VAR phase = ~preflight~ resource_dir = ~override~
          template_file = ~chriz-bg-rebalance/lua/M_CBRDVG.lua~
END
LAF cbr_apply_dragon_vorpal_effects
  STR_VAR phase = ~full~ resource_dir = ~override~
          template_file = ~chriz-bg-rebalance/lua/M_CBRDVG.lua~
END
LAF cbr_apply_dragon_vorpal_scripts INT_VAR apply = 1 END

BEGIN @111 DESIGNATED 111 GROUP @1100 LABEL ~cbr_scs_dragon_wing_buffet~
REQUIRE_PREDICATE (GAME_IS ~bg2ee eet~) @9110
REQUIRE_PREDICATE (MOD_IS_INSTALLED ~stratagems/setup-stratagems.tp2~ 6540) @9111
LAF cbr_apply_dragon_wing_buffet END

BEGIN @120
DESIGNATED 120
GROUP @1100
LABEL ~cbr_scs_sr_weapon_protection_semantics~

REQUIRE_PREDICATE (GAME_IS ~bg2ee eet~) @9120
REQUIRE_PREDICATE
  (MOD_IS_INSTALLED ~stratagems/setup-stratagems.tp2~ 6030)
  @9121
// SCS necessarily publishes its final SPELL.IDS to override. The production
// library takes an explicit path so its exact parser is shared with the
// hermetic fixture harness and never relies on a hardcoded SR resref.
REQUIRE_PREDICATE
  ((FILE_EXISTS_IN_GAME ~SPELL.IDS~) AND (FILE_EXISTS ~override/SPELL.IDS~))
  @9122
REQUIRE_PREDICATE
  ((IDS_OF_SYMBOL (~spell~ ~WIZARD_PROTECTION_FROM_MAGIC_WEAPONS~) >= 2000)
   AND (IDS_OF_SYMBOL (~spell~ ~WIZARD_PROTECTION_FROM_MAGIC_WEAPONS~) <= 2999)
   AND (IDS_OF_SYMBOL (~spell~ ~WIZARD_MANTLE~) >= 2000)
   AND (IDS_OF_SYMBOL (~spell~ ~WIZARD_MANTLE~) <= 2999)
   AND (IDS_OF_SYMBOL (~spell~ ~WIZARD_IMPROVED_MANTLE~) >= 2000)
   AND (IDS_OF_SYMBOL (~spell~ ~WIZARD_IMPROVED_MANTLE~) <= 2999)
   AND (IDS_OF_SYMBOL (~spell~ ~WIZARD_MOMENT_OF_PRESCIENCE~) >= 2000)
   AND (IDS_OF_SYMBOL (~spell~ ~WIZARD_MOMENT_OF_PRESCIENCE~) <= 2999)
   AND (IDS_OF_SYMBOL (~spell~ ~WIZARD_ABSOLUTE_IMMUNITY~) >= 2000)
   AND (IDS_OF_SYMBOL (~spell~ ~WIZARD_ABSOLUTE_IMMUNITY~) <= 2999)
   AND (IDS_OF_SYMBOL (~spell~ ~WIZARD_BREACH~) >= 2000)
   AND (IDS_OF_SYMBOL (~spell~ ~WIZARD_BREACH~) <= 2999)
   AND (IDS_OF_SYMBOL (~spell~ ~WIZARD_DISPEL_MAGIC~) >= 2000)
   AND (IDS_OF_SYMBOL (~spell~ ~WIZARD_DISPEL_MAGIC~) <= 2999))
  @9123
REQUIRE_PREDICATE
  (IDS_OF_SYMBOL (~spell~ ~WIZARD_IMPROVED_MANTLE~)
   = IDS_OF_SYMBOL (~spell~ ~WIZARD_MOMENT_OF_PRESCIENCE~))
  @9125

OUTER_SET cbr_120_pfmw_id = IDS_OF_SYMBOL (~spell~ ~WIZARD_PROTECTION_FROM_MAGIC_WEAPONS~)
OUTER_SET cbr_120_mantle_id = IDS_OF_SYMBOL (~spell~ ~WIZARD_MANTLE~)
OUTER_SET cbr_120_improved_id = IDS_OF_SYMBOL (~spell~ ~WIZARD_IMPROVED_MANTLE~)
OUTER_SET cbr_120_mop_id = IDS_OF_SYMBOL (~spell~ ~WIZARD_MOMENT_OF_PRESCIENCE~)
OUTER_SET cbr_120_absolute_id = IDS_OF_SYMBOL (~spell~ ~WIZARD_ABSOLUTE_IMMUNITY~)
OUTER_SET cbr_120_breach_id = IDS_OF_SYMBOL (~spell~ ~WIZARD_BREACH~)
OUTER_SET cbr_120_dispel_id = IDS_OF_SYMBOL (~spell~ ~WIZARD_DISPEL_MAGIC~)
OUTER_SET cbr_120_pfmw_slot = cbr_120_pfmw_id - 2000
OUTER_SET cbr_120_mantle_slot = cbr_120_mantle_id - 2000
OUTER_SET cbr_120_improved_slot = cbr_120_improved_id - 2000
OUTER_SET cbr_120_absolute_slot = cbr_120_absolute_id - 2000
OUTER_SET cbr_120_breach_slot = cbr_120_breach_id - 2000
OUTER_SET cbr_120_dispel_slot = cbr_120_dispel_id - 2000
OUTER_SPRINT cbr_120_pfmw_resref ~SPWI%cbr_120_pfmw_slot%~
OUTER_SPRINT cbr_120_mantle_resref ~SPWI%cbr_120_mantle_slot%~
OUTER_SPRINT cbr_120_improved_resref ~SPWI%cbr_120_improved_slot%~
OUTER_SPRINT cbr_120_absolute_resref ~SPWI%cbr_120_absolute_slot%~
OUTER_SPRINT cbr_120_breach_resref ~SPWI%cbr_120_breach_slot%~
OUTER_SPRINT cbr_120_dispel_resref ~SPWI%cbr_120_dispel_slot%~

ACTION_IF !((FILE_EXISTS_IN_GAME ~%cbr_120_pfmw_resref%.SPL~)
         AND (FILE_EXISTS_IN_GAME ~%cbr_120_mantle_resref%.SPL~)
         AND (FILE_EXISTS_IN_GAME ~%cbr_120_improved_resref%.SPL~)
         AND (FILE_EXISTS_IN_GAME ~%cbr_120_absolute_resref%.SPL~)
         AND (FILE_EXISTS_IN_GAME ~%cbr_120_breach_resref%.SPL~)
         AND (FILE_EXISTS_IN_GAME ~%cbr_120_dispel_resref%.SPL~)) BEGIN
  FAIL @9124
END

// Materialize only the six classifier/counter roots. They are normally
// already loose final resources after SR/SCS; COPY_EXISTING also makes the
// public component work when one originates in a BIFF, while retaining
// normal WeiDU backup and rollback behavior.
ACTION_FOR_EACH cbr_120_root IN
  ~%cbr_120_pfmw_resref%~
  ~%cbr_120_mantle_resref%~
  ~%cbr_120_improved_resref%~
  ~%cbr_120_absolute_resref%~
  ~%cbr_120_breach_resref%~
  ~%cbr_120_dispel_resref%~
BEGIN
  COPY_EXISTING ~%cbr_120_root%.SPL~ ~override/%cbr_120_root%.SPL~
END

LAF cbr_apply_scs_weapon_protection_semantics
  STR_VAR
    resource_dir = ~override~
    script_dir = ~override~
    spell_ids = ~override/SPELL.IDS~
    phase = ~full~
  RET
    cbr_120_mismatch = mismatch_detected
    cbr_120_replacement = replacement_resref
    cbr_120_metadata = metadata_removed
    cbr_120_first = first_round_removed
    cbr_120_renewal = renewal_removed
    cbr_120_chain = chain_replaced
    cbr_120_unknown = unknown_blocks
END

PRINT ~cbr 120: metadata=%cbr_120_metadata%; first-round=%cbr_120_first%; renewal=%cbr_120_renewal%; chain=%cbr_120_chain%; unknown=%cbr_120_unknown%; replacement=%cbr_120_replacement%.~

BEGIN @121
DESIGNATED 121
GROUP @1100
LABEL ~cbr_eeex_ambient_readiness~

REQUIRE_PREDICATE (GAME_IS ~bg2ee eet~) @9130
REQUIRE_PREDICATE
  (FILE_EXISTS_IN_GAME ~M___EEex.lua~)
  @9134
REQUIRE_PREDICATE
  (MOD_IS_INSTALLED ~stratagems/setup-stratagems.tp2~ 6030)
  @9131
REQUIRE_PREDICATE
  ((FILE_EXISTS_IN_GAME ~SPELL.IDS~) AND (FILE_EXISTS ~override/SPELL.IDS~))
  @9135
REQUIRE_PREDICATE
  (FILE_EXISTS ~weidu_external/data/stratagems/instant_prebuff_spells.2da~)
  @9136

// The install-time compiler resolves every candidate from the final SPELL.IDS,
// validates the installed SPL semantics and SCS cosmetic-free delivery map,
// then stamps exactly one backup-aware M_ autoload module. It does not patch
// SCS scripts or any spell resource, and it remains independent of component
// 120 while importing the same semantic classifier.
LAF cbr_install_ambient_readiness_runtime
  STR_VAR
    spell_table = ~chriz-bg-rebalance/data/ambient_readiness_spells.2da~
    override_table = ~chriz-bg-rebalance/data/ambient_readiness_overrides.2da~
    resource_dir = ~override~
    spell_ids = ~override/SPELL.IDS~
    prebuff_map = ~weidu_external/data/stratagems/instant_prebuff_spells.2da~
    template_file = ~chriz-bg-rebalance/lua/M_CBRRDY.lua~
  RET
    cbr_121_ambient_count = ambient_count
    cbr_121_urgent_count = urgent_count
END

PRINT ~cbr 121: shipped M_CBRRDY.lua (ambient=%cbr_121_ambient_count%; urgent=%cbr_121_urgent_count%; EEex v1.2-first; legacy capability fallback enabled).~

// ============================================================
// Cross-cutting spell audits/fixes (300-399)
// ============================================================

BEGIN @301
DESIGNATED 301
GROUP @1300
LABEL ~cbr_emotion_hope_courage_exclusion~

REQUIRE_PREDICATE (GAME_IS ~bg2ee eet~) @9300
REQUIRE_PREDICATE ((FILE_EXISTS_IN_GAME ~SPELL.IDS~)
               AND (FILE_EXISTS_IN_GAME ~SPLSTATE.IDS~)
               AND (FILE_EXISTS_IN_GAME ~MISSILE.IDS~)
               AND (FILE_EXISTS_IN_GAME ~PROJECTL.IDS~)
               AND (FILE_EXISTS_IN_GAME ~STATDESC.2DA~)) @9301

// A one-process --force-uninstall/--force-install run can retain the IDS map
// loaded by the just-uninstalled component.  Refresh it before classifying
// symbols so stale ADD_SPELL rows cannot masquerade as missing resources.
CLEAR_IDS_MAP

// Resolve every role through its installed symbol.  Existing beneficial
// symbols must already occupy wizard level-four slots; rejecting a bad
// mapping before ADD_SPELL prevents WeiDU from silently relocating it.
OUTER_SET cbr_em_courage_id = IDS_OF_SYMBOL (~spell~ ~WIZARD_EMOTION_COURAGE~)
OUTER_SET cbr_em_hope_id = IDS_OF_SYMBOL (~spell~ ~WIZARD_EMOTION_HOPE~)
OUTER_SET cbr_em_courage_existing = (cbr_em_courage_id >= 2400 && cbr_em_courage_id <= 2499)
OUTER_SET cbr_em_hope_existing = (cbr_em_hope_id >= 2400 && cbr_em_hope_id <= 2499)
ACTION_IF ((cbr_em_courage_id >= 0) && (cbr_em_courage_existing = 0))
       OR ((cbr_em_hope_id >= 0) && (cbr_em_hope_existing = 0)) BEGIN
  FAIL @9302
END

OUTER_SPRINT cbr_em_courage_resref ~~
OUTER_SPRINT cbr_em_hope_resref ~~
ACTION_IF (cbr_em_courage_existing = 1) BEGIN
  LAF RES_NUM_OF_SPELL_NAME
    STR_VAR spell_name = ~WIZARD_EMOTION_COURAGE~
    RET cbr_em_courage_resref = spell_res
  END
  ACTION_IF !(FILE_EXISTS_IN_GAME ~%cbr_em_courage_resref%.SPL~) BEGIN
    FAIL @9303
  END
  COPY_EXISTING - ~%cbr_em_courage_resref%.SPL~ nowhere
    LPF cbr_em_validate_beneficial END
  BUT_ONLY
END
ACTION_IF (cbr_em_hope_existing = 1) BEGIN
  LAF RES_NUM_OF_SPELL_NAME
    STR_VAR spell_name = ~WIZARD_EMOTION_HOPE~
    RET cbr_em_hope_resref = spell_res
  END
  ACTION_IF !(FILE_EXISTS_IN_GAME ~%cbr_em_hope_resref%.SPL~) BEGIN
    FAIL @9303
  END
  COPY_EXISTING - ~%cbr_em_hope_resref%.SPL~ nowhere
    LPF cbr_em_validate_beneficial END
  BUT_ONLY
END

// Standalone donors and adverse counterparts are optional unless a missing
// beneficial spell needs them.  RES_NUM_OF_SPELL_NAME is called only for a
// symbol which IDS_OF_SYMBOL proved present.
OUTER_SPRINT cbr_em_enchanted_resref ~~
OUTER_SET cbr_em_enchanted_id = IDS_OF_SYMBOL (~spell~ ~WIZARD_ENCHANTED_WEAPON~)
ACTION_IF (cbr_em_enchanted_id >= 0) BEGIN
  LAF RES_NUM_OF_SPELL_NAME STR_VAR spell_name = ~WIZARD_ENCHANTED_WEAPON~
    RET cbr_em_enchanted_resref = spell_res END
END

OUTER_SPRINT cbr_em_fear_resref ~~
OUTER_SET cbr_em_fear_id = IDS_OF_SYMBOL (~spell~ ~WIZARD_EMOTION_FEAR~)
ACTION_IF (cbr_em_fear_id >= 0) BEGIN
  LAF RES_NUM_OF_SPELL_NAME STR_VAR spell_name = ~WIZARD_EMOTION_FEAR~
    RET cbr_em_fear_resref = spell_res END
END

OUTER_SPRINT cbr_em_horror_resref ~~
OUTER_SET cbr_em_horror_id = IDS_OF_SYMBOL (~spell~ ~WIZARD_HORROR~)
ACTION_IF (cbr_em_horror_id >= 0) BEGIN
  LAF RES_NUM_OF_SPELL_NAME STR_VAR spell_name = ~WIZARD_HORROR~
    RET cbr_em_horror_resref = spell_res END
END

OUTER_SPRINT cbr_em_innate_horror_resref ~~
OUTER_SET cbr_em_innate_horror_id = IDS_OF_SYMBOL (~spell~ ~INNATE_HORROR~)
ACTION_IF (cbr_em_innate_horror_id >= 3000 && cbr_em_innate_horror_id <= 3999) BEGIN
  // The standard spell namespace encodes SPIN### with a leading 3.  Let
  // WeiDU perform the symbolic conversion without fixing a resref here.
  LAF RES_NUM_OF_SPELL_NAME STR_VAR spell_name = ~INNATE_HORROR~
    RET cbr_em_innate_horror_resref = spell_res END
END ELSE ACTION_IF (cbr_em_innate_horror_id >= 100 && cbr_em_innate_horror_id <= 999) BEGIN
  // Retain compatibility with older nonstandard IDS rows that store the
  // three-digit SPIN suffix directly.
  OUTER_SPRINT cbr_em_innate_horror_resref ~SPIN%cbr_em_innate_horror_id%~
END

OUTER_SPRINT cbr_em_hopeless_resref ~~
OUTER_SET cbr_em_hopeless_id = IDS_OF_SYMBOL (~spell~ ~WIZARD_EMOTION_HOPELESSNESS~)
ACTION_IF (cbr_em_hopeless_id >= 0) BEGIN
  LAF RES_NUM_OF_SPELL_NAME STR_VAR spell_name = ~WIZARD_EMOTION_HOPELESSNESS~
    RET cbr_em_hopeless_resref = spell_res END
END

OUTER_SPRINT cbr_em_symbol_resref ~~
OUTER_SET cbr_em_symbol_id = IDS_OF_SYMBOL (~spell~ ~CLERIC_SYMBOL_HOPELESSNESS~)
ACTION_IF (cbr_em_symbol_id >= 0) BEGIN
  LAF RES_NUM_OF_SPELL_NAME STR_VAR spell_name = ~CLERIC_SYMBOL_HOPELESSNESS~
    RET cbr_em_symbol_resref = spell_res END
END

OUTER_SET cbr_em_have_fear = !(~%cbr_em_fear_resref%~ STR_EQ ~~)
                           && FILE_EXISTS_IN_GAME ~%cbr_em_fear_resref%.SPL~
OUTER_SET cbr_em_have_horror = !(~%cbr_em_horror_resref%~ STR_EQ ~~)
                             && FILE_EXISTS_IN_GAME ~%cbr_em_horror_resref%.SPL~
OUTER_SET cbr_em_have_innate_horror = !(~%cbr_em_innate_horror_resref%~ STR_EQ ~~)
                                    && FILE_EXISTS_IN_GAME ~%cbr_em_innate_horror_resref%.SPL~
OUTER_SET cbr_em_have_hopeless = !(~%cbr_em_hopeless_resref%~ STR_EQ ~~)
                               && FILE_EXISTS_IN_GAME ~%cbr_em_hopeless_resref%.SPL~
OUTER_SET cbr_em_have_symbol = !(~%cbr_em_symbol_resref%~ STR_EQ ~~)
                             && FILE_EXISTS_IN_GAME ~%cbr_em_symbol_resref%.SPL~

// Validate every resource that this component will rewrite before allocating
// a spell slot or resolving a new TLK string.  Horror and Innate Horror are
// cleanse-only: their presence is recorded, but BIF-only files stay BIF-only.
ACTION_IF (cbr_em_have_fear = 1) BEGIN
  COPY_EXISTING - ~%cbr_em_fear_resref%.SPL~ nowhere
    LPF cbr_em_validate_adverse
      INT_VAR mechanic_opcode = 24 unconditional = 0
      STR_VAR positive_resref = EVAL ~%cbr_em_courage_resref%~
    END
  BUT_ONLY
END
ACTION_IF (cbr_em_have_hopeless = 1) BEGIN
  COPY_EXISTING - ~%cbr_em_hopeless_resref%.SPL~ nowhere
    LPF cbr_em_validate_adverse
      INT_VAR mechanic_opcode = 45 unconditional = 1
      STR_VAR positive_resref = EVAL ~%cbr_em_hope_resref%~
    END
  BUT_ONLY
END
ACTION_IF (cbr_em_have_symbol = 1) BEGIN
  COPY_EXISTING - ~%cbr_em_symbol_resref%.SPL~ nowhere
    LPF cbr_em_validate_adverse
      INT_VAR mechanic_opcode = 45 unconditional = 0
      STR_VAR positive_resref = EVAL ~%cbr_em_hope_resref%~
    END
  BUT_ONLY
END

OUTER_SET cbr_em_need_courage = 1 - cbr_em_courage_existing
OUTER_SET cbr_em_need_hope = 1 - cbr_em_hope_existing
// Validate the complete status-table shape before ADD_SPELL or any TLK
// allocation. WeiDU rolls file mutations back on failure, but deliberately
// retains appended TLK strings, so this must remain an early read-only check.
ACTION_IF (cbr_em_need_courage = 1 || cbr_em_need_hope = 1) BEGIN
  COPY_EXISTING - ~STATDESC.2DA~ nowhere
    COUNT_2DA_COLS cbr_em_sd_pre_cols
    PATCH_IF (cbr_em_sd_pre_cols != 3) BEGIN
      PATCH_FAIL @9313
    END
    READ_2DA_ENTRIES_NOW cbr_em_sd_pre_rows cbr_em_sd_pre_cols
  BUT_ONLY
END
ACTION_IF ((cbr_em_need_courage = 1) OR (cbr_em_need_hope = 1))
       && (cbr_em_have_hopeless = 0) BEGIN
  FAIL @9304
END
ACTION_IF (cbr_em_need_courage = 1) && (FILE_EXISTS_IN_GAME ~CBRCRGSC.ITM~) BEGIN
  FAIL @9308
END
ACTION_IF (cbr_em_need_hope = 1) && (FILE_EXISTS_IN_GAME ~CBRHOPSC.ITM~) BEGIN
  FAIL @9308
END
ACTION_IF (cbr_em_need_courage = 1 || cbr_em_need_hope = 1) BEGIN
  ACTION_IF (IDS_OF_SYMBOL (~projectl~ ~CBR301P~) >= 0)
         || FILE_EXISTS_IN_GAME ~CBR301P.PRO~
         || FILE_EXISTS_IN_GAME ~CBR301V.VVC~
         || FILE_EXISTS_IN_GAME ~CBR301A.BAM~
         || FILE_EXISTS_IN_GAME ~CBR301W.WAV~
         || FILE_EXISTS_IN_GAME ~CBR301E.WAV~ BEGIN
    FAIL @9311
  END
END

// Read-only KEY/override scroll discovery.  Unrelated or malformed ITMs are
// ignored after proving exact one-owner coverage of every effect.  Existing
// learning scrolls need opcode 147; standalone donors additionally need a
// matching opcode 146/148 cast path.  Because the patch is read-only,
// BUT_ONLY_IF_IT_CHANGES publishes no unrelated item.
OUTER_SET cbr_em_courage_scroll_count = 0
OUTER_SET cbr_em_hope_scroll_count = 0
OUTER_SET cbr_em_enchanted_donor_count = 0
OUTER_SET cbr_em_hopeless_donor_count = 0
OUTER_SPRINT cbr_em_enchanted_donor_scroll ~~
OUTER_SPRINT cbr_em_hopeless_donor_scroll ~~
COPY_EXISTING_REGEXP GLOB ~^.*\.[iI][tT][mM]$~ ~override~
  SET cbr_em_si_valid = 0
  PATCH_IF (BUFFER_LENGTH >= 0x72) BEGIN
    READ_ASCII 0 cbr_em_si_signature (8)
    PATCH_IF (~%cbr_em_si_signature%~ STRING_EQUAL ~ITM V1  ~) BEGIN
      READ_LONG 0x64 cbr_em_si_ability_offset
      READ_SHORT 0x68 cbr_em_si_ability_count
      READ_LONG 0x6a cbr_em_si_effect_offset
      READ_SHORT 0x6e cbr_em_si_global_first
      READ_SHORT 0x70 cbr_em_si_global_count
      SET cbr_em_si_ability_end = cbr_em_si_ability_offset + cbr_em_si_ability_count * 0x38
      PATCH_IF (cbr_em_si_ability_offset >= 0x72
             && cbr_em_si_ability_end <= BUFFER_LENGTH
             && cbr_em_si_effect_offset >= cbr_em_si_ability_end
             && cbr_em_si_effect_offset <= BUFFER_LENGTH
             && ((BUFFER_LENGTH - cbr_em_si_effect_offset) MODULO 0x30) = 0) BEGIN
        SET cbr_em_si_effect_count = (BUFFER_LENGTH - cbr_em_si_effect_offset) / 0x30
        PATCH_IF (cbr_em_si_global_first + cbr_em_si_global_count
               <= cbr_em_si_effect_count) BEGIN
          SET cbr_em_si_valid = 1
          FOR (cbr_em_si_i = 0; cbr_em_si_i < cbr_em_si_effect_count; ++cbr_em_si_i) BEGIN
            SET $cbr_em_si_coverage(~%cbr_em_si_i%~) = 0
          END
          FOR (cbr_em_si_i = cbr_em_si_global_first;
               cbr_em_si_i < cbr_em_si_global_first + cbr_em_si_global_count;
               ++cbr_em_si_i) BEGIN
            SET $cbr_em_si_coverage(~%cbr_em_si_i%~) =
              $cbr_em_si_coverage(~%cbr_em_si_i%~) + 1
          END
        END
      END
    END
  END
  SET cbr_em_si_courage = 0
  SET cbr_em_si_hope = 0
  SET cbr_em_si_enchanted = 0
  SET cbr_em_si_hopeless = 0
  SET cbr_em_si_enchanted_cast = 0
  SET cbr_em_si_hopeless_cast = 0
  PATCH_IF (cbr_em_si_valid = 1) BEGIN
    FOR (cbr_em_si_ab = 0; cbr_em_si_ab < cbr_em_si_ability_count; ++cbr_em_si_ab) BEGIN
      SET cbr_em_si_header = cbr_em_si_ability_offset + cbr_em_si_ab * 0x38
      READ_SHORT (cbr_em_si_header + 0x1e) cbr_em_si_count
      READ_SHORT (cbr_em_si_header + 0x20) cbr_em_si_first
      PATCH_IF (cbr_em_si_first + cbr_em_si_count > cbr_em_si_effect_count) BEGIN
        SET cbr_em_si_valid = 0
      END
      PATCH_IF (cbr_em_si_valid = 1) BEGIN
        FOR (cbr_em_si_i = cbr_em_si_first;
             cbr_em_si_i < cbr_em_si_first + cbr_em_si_count;
             ++cbr_em_si_i) BEGIN
          SET $cbr_em_si_coverage(~%cbr_em_si_i%~) =
            $cbr_em_si_coverage(~%cbr_em_si_i%~) + 1
        END
        FOR (cbr_em_si_i = 0; cbr_em_si_i < cbr_em_si_count; ++cbr_em_si_i) BEGIN
          SET cbr_em_si_fx = cbr_em_si_effect_offset + (cbr_em_si_first + cbr_em_si_i) * 0x30
          READ_SHORT cbr_em_si_fx cbr_em_si_opcode
          PATCH_IF (cbr_em_si_opcode = 146
                 || cbr_em_si_opcode = 147
                 || cbr_em_si_opcode = 148) BEGIN
            READ_ASCII (cbr_em_si_fx + 0x14) cbr_em_si_resource (8) NULL
          END
          PATCH_IF (cbr_em_si_opcode = 147) BEGIN
            PATCH_IF (cbr_em_courage_existing = 1
                   && ~%cbr_em_si_resource%~ STRING_EQUAL_CASE ~%cbr_em_courage_resref%~) BEGIN
              SET cbr_em_si_courage = 1
            END
            PATCH_IF (cbr_em_hope_existing = 1
                   && ~%cbr_em_si_resource%~ STRING_EQUAL_CASE ~%cbr_em_hope_resref%~) BEGIN
              SET cbr_em_si_hope = 1
            END
            PATCH_IF !(~%cbr_em_enchanted_resref%~ STR_EQ ~~)
                   && (~%cbr_em_si_resource%~ STRING_EQUAL_CASE ~%cbr_em_enchanted_resref%~) BEGIN
              SET cbr_em_si_enchanted = 1
            END
            PATCH_IF !(~%cbr_em_hopeless_resref%~ STR_EQ ~~)
                   && (~%cbr_em_si_resource%~ STRING_EQUAL_CASE ~%cbr_em_hopeless_resref%~) BEGIN
              SET cbr_em_si_hopeless = 1
            END
          END
          PATCH_IF (cbr_em_si_opcode = 146 || cbr_em_si_opcode = 148) BEGIN
            PATCH_IF !(~%cbr_em_enchanted_resref%~ STR_EQ ~~)
                   && (~%cbr_em_si_resource%~ STRING_EQUAL_CASE ~%cbr_em_enchanted_resref%~) BEGIN
              SET cbr_em_si_enchanted_cast = 1
            END
            PATCH_IF !(~%cbr_em_hopeless_resref%~ STR_EQ ~~)
                   && (~%cbr_em_si_resource%~ STRING_EQUAL_CASE ~%cbr_em_hopeless_resref%~) BEGIN
              SET cbr_em_si_hopeless_cast = 1
            END
          END
        END
      END
    END
    PATCH_IF (cbr_em_si_valid = 1) BEGIN
      FOR (cbr_em_si_i = 0; cbr_em_si_i < cbr_em_si_effect_count; ++cbr_em_si_i) BEGIN
        PATCH_IF ($cbr_em_si_coverage(~%cbr_em_si_i%~) != 1) BEGIN
          SET cbr_em_si_valid = 0
        END
      END
    END
  END
  PATCH_IF (cbr_em_si_valid = 1 && cbr_em_si_courage = 1 && cbr_em_si_hope = 1) BEGIN
    PATCH_FAIL ~CBR_EM_ERR_SCROLL_AMBIGUOUS~
  END
  PATCH_IF (cbr_em_si_valid = 1 && cbr_em_si_courage = 1) BEGIN
    SPRINT $cbr_em_courage_scroll(~%cbr_em_courage_scroll_count%~) ~%SOURCE_RES%~
    SET cbr_em_courage_scroll_count += 1
  END
  PATCH_IF (cbr_em_si_valid = 1 && cbr_em_si_hope = 1) BEGIN
    SPRINT $cbr_em_hope_scroll(~%cbr_em_hope_scroll_count%~) ~%SOURCE_RES%~
    SET cbr_em_hope_scroll_count += 1
  END
  PATCH_IF (cbr_em_si_valid = 1
         && cbr_em_si_enchanted = 1
         && cbr_em_si_enchanted_cast = 1) BEGIN
    SPRINT cbr_em_enchanted_donor_scroll ~%SOURCE_RES%~
    SET cbr_em_enchanted_donor_count += 1
  END
  PATCH_IF (cbr_em_si_valid = 1
         && cbr_em_si_hopeless = 1
         && cbr_em_si_hopeless_cast = 1) BEGIN
    SPRINT cbr_em_hopeless_donor_scroll ~%SOURCE_RES%~
    SET cbr_em_hopeless_donor_count += 1
  END
  BUT_ONLY_IF_IT_CHANGES

ACTION_IF (cbr_em_need_courage = 1) && (cbr_em_enchanted_donor_count < 1) BEGIN
  FAIL @9305
END
ACTION_IF (cbr_em_need_hope = 1) && (cbr_em_hopeless_donor_count < 1) BEGIN
  FAIL @9306
END
ACTION_IF (cbr_em_need_courage = 1) && (cbr_em_enchanted_donor_count > 1) BEGIN
  FAIL @9309
END
ACTION_IF (cbr_em_need_hope = 1) && (cbr_em_hopeless_donor_count > 1) BEGIN
  FAIL @9310
END

// Publish the IWDEE Emotion delivery graph under private names.  IDPRO407 is
// the party-capable area projectile used by the original spells; its linked
// VVC, animation, and sounds are remapped so this component never depends on
// IWDification's public resource names or overwrites another provider.
ACTION_IF (cbr_em_need_courage = 1 || cbr_em_need_hope = 1) BEGIN
  COPY ~chriz-bg-rebalance/resources/emotion_iwdee/IDPRO407.PRO~ ~override/CBR301P.PRO~
    PATCH_IF (BUFFER_LENGTH < 0x224) BEGIN
      PATCH_FAIL ~CBR_EM_ERR_IWD_PROJECTILE~
    END
    WRITE_ASCII 0x21c ~CBR301V~ #8
  COPY ~chriz-bg-rebalance/resources/emotion_iwdee/#GENENCH.VVC~ ~override/CBR301V.VVC~
    PATCH_IF (BUFFER_LENGTH < 0x80) BEGIN
      PATCH_FAIL ~CBR_EM_ERR_IWD_VVC~
    END
    WRITE_ASCII 0x08 ~CBR301A~ #8
    WRITE_ASCII 0x78 ~CBR301W~ #8
  COPY ~chriz-bg-rebalance/resources/emotion_iwdee/ENCHANX.BAM~ ~override/CBR301A.BAM~
  COPY ~chriz-bg-rebalance/resources/emotion_iwdee/#ARE_M21.WAV~ ~override/CBR301W.WAV~
  COPY ~chriz-bg-rebalance/resources/emotion_iwdee/#EFF_E03.WAV~ ~override/CBR301E.WAV~
  ADD_PROJECTILE ~override/CBR301P.PRO~
  OUTER_SET cbr_em_stored_projectile = CBR301P
END

// ADD_SPELL is always invoked with IF_EXISTING.  Missing symbols receive a
// canonical inline seed; installed symbols use an inline copy of their own
// current SPL and retain their slot.
ACTION_IF (cbr_em_need_courage = 1) BEGIN
  COPY_EXISTING - ~%cbr_em_hopeless_resref%.SPL~ ~.../cbr-emotion/courage-seed.spl~
    LPF cbr_em_make_native_seed
      INT_VAR is_courage = 1 stored_projectile = cbr_em_stored_projectile
    END
  ADD_SPELL ~.../cbr-emotion/courage-seed.spl~ 2 4 ~WIZARD_EMOTION_COURAGE~
    LPF cbr_em_validate_beneficial END
  IF_EXISTING
    LPF cbr_em_validate_beneficial END
  END
END ELSE BEGIN
  COPY_EXISTING - ~%cbr_em_courage_resref%.SPL~ ~.../cbr-emotion/courage-existing.spl~
  ADD_SPELL ~.../cbr-emotion/courage-existing.spl~ 2 4 ~WIZARD_EMOTION_COURAGE~
    LPF cbr_em_validate_beneficial END
  IF_EXISTING
    LPF cbr_em_validate_beneficial END
  END
END

ACTION_IF (cbr_em_need_hope = 1) BEGIN
  COPY_EXISTING - ~%cbr_em_hopeless_resref%.SPL~ ~.../cbr-emotion/hope-seed.spl~
    LPF cbr_em_make_native_seed
      INT_VAR is_courage = 0 stored_projectile = cbr_em_stored_projectile
    END
  ADD_SPELL ~.../cbr-emotion/hope-seed.spl~ 2 4 ~WIZARD_EMOTION_HOPE~
    LPF cbr_em_validate_beneficial END
  IF_EXISTING
    LPF cbr_em_validate_beneficial END
  END
END ELSE BEGIN
  COPY_EXISTING - ~%cbr_em_hope_resref%.SPL~ ~.../cbr-emotion/hope-existing.spl~
  ADD_SPELL ~.../cbr-emotion/hope-existing.spl~ 2 4 ~WIZARD_EMOTION_HOPE~
    LPF cbr_em_validate_beneficial END
  IF_EXISTING
    LPF cbr_em_validate_beneficial END
  END
END

// Refresh the two symbolic mappings immediately after allocation.
LAF RES_NUM_OF_SPELL_NAME STR_VAR spell_name = ~WIZARD_EMOTION_COURAGE~
  RET cbr_em_courage_resref = spell_res cbr_em_courage_id = spell_num END
LAF RES_NUM_OF_SPELL_NAME STR_VAR spell_name = ~WIZARD_EMOTION_HOPE~
  RET cbr_em_hope_resref = spell_res cbr_em_hope_id = spell_num END

// ADD_SPELL has now selected the final dynamic resrefs, but no new strings
// have been resolved. Reject a pre-owned D-name before TLK mutation; a forced
// reinstall restores this component's previous STATDESC rows before reaching
// this point, so any row still present belongs to another installation layer.
ACTION_IF (cbr_em_need_courage = 1 || cbr_em_need_hope = 1) BEGIN
  COPY_EXISTING - ~STATDESC.2DA~ nowhere
    COUNT_2DA_COLS cbr_em_sd_pre_cols
    READ_2DA_ENTRIES_NOW cbr_em_sd_pre_rows cbr_em_sd_pre_cols
    FOR (cbr_em_sd_pre_i = 0;
         cbr_em_sd_pre_i < cbr_em_sd_pre_rows;
         ++cbr_em_sd_pre_i) BEGIN
      READ_2DA_ENTRY_FORMER cbr_em_sd_pre_rows cbr_em_sd_pre_i 2 cbr_em_sd_pre_bam
      PATCH_IF (cbr_em_need_courage = 1
             && ~%cbr_em_sd_pre_bam%~ STRING_EQUAL_CASE ~%cbr_em_courage_resref%D~) BEGIN
        PATCH_FAIL @9314
      END
      PATCH_IF (cbr_em_need_hope = 1
             && ~%cbr_em_sd_pre_bam%~ STRING_EQUAL_CASE ~%cbr_em_hope_resref%D~) BEGIN
        PATCH_FAIL @9314
      END
    END
  BUT_ONLY
END

// Publish the original blue IWDEE spell icons and independently extracted
// 13x13 IWDEE heart status sprites under each dynamically allocated name.
ACTION_IF (cbr_em_need_courage = 1) BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME ~%cbr_em_courage_resref%A.BAM~
         || FILE_EXISTS_IN_GAME ~%cbr_em_courage_resref%B.BAM~
         || FILE_EXISTS_IN_GAME ~%cbr_em_courage_resref%C.BAM~
         || FILE_EXISTS_IN_GAME ~%cbr_em_courage_resref%D.BAM~ BEGIN
    FAIL @9312
  END
  COPY ~chriz-bg-rebalance/resources/emotion_iwdee/SPWI427A.BAM~ ~override/%cbr_em_courage_resref%A.BAM~
  COPY ~chriz-bg-rebalance/resources/emotion_iwdee/SPWI427B.BAM~ ~override/%cbr_em_courage_resref%B.BAM~
  COPY ~chriz-bg-rebalance/resources/emotion_iwdee/SPWI427C.BAM~ ~override/%cbr_em_courage_resref%C.BAM~
  COPY ~chriz-bg-rebalance/resources/emotion_iwdee/SPWI427D.BAM~ ~override/%cbr_em_courage_resref%D.BAM~
END
ACTION_IF (cbr_em_need_hope = 1) BEGIN
  ACTION_IF FILE_EXISTS_IN_GAME ~%cbr_em_hope_resref%A.BAM~
         || FILE_EXISTS_IN_GAME ~%cbr_em_hope_resref%B.BAM~
         || FILE_EXISTS_IN_GAME ~%cbr_em_hope_resref%C.BAM~
         || FILE_EXISTS_IN_GAME ~%cbr_em_hope_resref%D.BAM~ BEGIN
    FAIL @9312
  END
  COPY ~chriz-bg-rebalance/resources/emotion_iwdee/SPWI429A.BAM~ ~override/%cbr_em_hope_resref%A.BAM~
  COPY ~chriz-bg-rebalance/resources/emotion_iwdee/SPWI429B.BAM~ ~override/%cbr_em_hope_resref%B.BAM~
  COPY ~chriz-bg-rebalance/resources/emotion_iwdee/SPWI429C.BAM~ ~override/%cbr_em_hope_resref%C.BAM~
  COPY ~chriz-bg-rebalance/resources/emotion_iwdee/SPWI429D.BAM~ ~override/%cbr_em_hope_resref%D.BAM~
END

OUTER_SET cbr_em_courage_state = IDS_OF_SYMBOL (~splstate~ ~EMOTION_COURAGE~)
OUTER_SET cbr_em_hope_state = IDS_OF_SYMBOL (~splstate~ ~EMOTION_HOPE~)
OUTER_SET cbr_em_courage_name = RESOLVE_STR_REF (@3011)
OUTER_SET cbr_em_courage_desc = RESOLVE_STR_REF (@3012)
OUTER_SET cbr_em_hope_name = RESOLVE_STR_REF (@3013)
OUTER_SET cbr_em_hope_desc = RESOLVE_STR_REF (@3014)
OUTER_SET cbr_em_courage_status_name = "-1"
OUTER_SET cbr_em_hope_status_name = "-1"
ACTION_IF (cbr_em_need_courage = 1) BEGIN
  OUTER_SET cbr_em_courage_status_name = RESOLVE_STR_REF (@3015)
END
ACTION_IF (cbr_em_need_hope = 1) BEGIN
  OUTER_SET cbr_em_hope_status_name = RESOLVE_STR_REF (@3016)
END

// BG2EE displays opcode 142 through STATDESC rather than IWDEE's monolithic
// STATES.BAM cycles. Allocate first-free extensible rows (200+) only for
// standalone spells; installed providers retain their own rows and BAMs.
OUTER_SET cbr_em_courage_portrait = "-1"
OUTER_SET cbr_em_hope_portrait = "-1"
ACTION_IF (cbr_em_need_courage = 1 || cbr_em_need_hope = 1) BEGIN
  ACTION_CLEAR_ARRAY cbr_em_sd_used
  COPY_EXISTING ~STATDESC.2DA~ ~override~
    COUNT_2DA_COLS cbr_em_sd_cols
    PATCH_IF (cbr_em_sd_cols != 3) BEGIN
      PATCH_FAIL @9313
    END
    READ_2DA_ENTRIES_NOW cbr_em_sd_rows cbr_em_sd_cols
    FOR (cbr_em_sd_i = 0; cbr_em_sd_i < cbr_em_sd_rows; ++cbr_em_sd_i) BEGIN
      READ_2DA_ENTRY_FORMER cbr_em_sd_rows cbr_em_sd_i 0 cbr_em_sd_label
      PATCH_IF (IS_AN_INT ~%cbr_em_sd_label%~) BEGIN
        SET $cbr_em_sd_used(~%cbr_em_sd_label%~) = 1
      END
    END
    PATCH_IF (cbr_em_need_courage = 1 && cbr_em_courage_portrait < 0) BEGIN
      SET cbr_em_courage_portrait = 200
      WHILE (VARIABLE_IS_SET $cbr_em_sd_used(~%cbr_em_courage_portrait%~)) BEGIN
        ++cbr_em_courage_portrait
      END
      INSERT_2DA_ROW cbr_em_sd_rows cbr_em_sd_cols
        ~%cbr_em_courage_portrait% %cbr_em_courage_status_name% %cbr_em_courage_resref%D~
      SET $cbr_em_sd_used(~%cbr_em_courage_portrait%~) = 1
      ++cbr_em_sd_rows
    END
    PATCH_IF (cbr_em_need_hope = 1 && cbr_em_hope_portrait < 0) BEGIN
      SET cbr_em_hope_portrait = 200
      WHILE (VARIABLE_IS_SET $cbr_em_sd_used(~%cbr_em_hope_portrait%~)) BEGIN
        ++cbr_em_hope_portrait
      END
      INSERT_2DA_ROW cbr_em_sd_rows cbr_em_sd_cols
        ~%cbr_em_hope_portrait% %cbr_em_hope_status_name% %cbr_em_hope_resref%D~
      SET $cbr_em_sd_used(~%cbr_em_hope_portrait%~) = 1
      ++cbr_em_sd_rows
    END
  BUT_ONLY_IF_IT_CHANGES
END

// Materialize only resources this component owns or rewrites.  The two
// cleanse-only Horror variants deliberately remain at their original layer.
COPY_EXISTING ~%cbr_em_courage_resref%.SPL~ ~override/%cbr_em_courage_resref%.SPL~
  PATCH_IF (cbr_em_need_courage = 1) BEGIN
    READ_LONG 0x64 cbr_em_ci_ability_offset
    WRITE_ASCIIE 0x3a ~%cbr_em_courage_resref%C~ #8
    WRITE_ASCIIE (cbr_em_ci_ability_offset + 0x04) ~%cbr_em_courage_resref%B~ #8
  END
COPY_EXISTING ~%cbr_em_hope_resref%.SPL~ ~override/%cbr_em_hope_resref%.SPL~
  PATCH_IF (cbr_em_need_hope = 1) BEGIN
    READ_LONG 0x64 cbr_em_hi_ability_offset
    WRITE_ASCIIE 0x3a ~%cbr_em_hope_resref%C~ #8
    WRITE_ASCIIE (cbr_em_hi_ability_offset + 0x04) ~%cbr_em_hope_resref%B~ #8
  END
ACTION_IF (cbr_em_have_fear = 1) BEGIN
  COPY_EXISTING ~%cbr_em_fear_resref%.SPL~ ~override/%cbr_em_fear_resref%.SPL~
END
ACTION_IF (cbr_em_have_hopeless = 1) BEGIN
  COPY_EXISTING ~%cbr_em_hopeless_resref%.SPL~ ~override/%cbr_em_hopeless_resref%.SPL~
END
ACTION_IF (cbr_em_have_symbol = 1) BEGIN
  COPY_EXISTING ~%cbr_em_symbol_resref%.SPL~ ~override/%cbr_em_symbol_resref%.SPL~
END

LAF cbr_apply_emotion_hope_courage
  INT_VAR
    courage_spell_state = cbr_em_courage_state
    hope_spell_state = cbr_em_hope_state
    courage_portrait_icon = cbr_em_courage_portrait
    hope_portrait_icon = cbr_em_hope_portrait
    courage_name_strref = cbr_em_courage_name
    courage_desc_strref = cbr_em_courage_desc
    hope_name_strref = cbr_em_hope_name
    hope_desc_strref = cbr_em_hope_desc
    horror_present = cbr_em_have_horror
    innate_horror_present = cbr_em_have_innate_horror
    process_scrolls = 0
  STR_VAR
    resource_dir = ~override~
    courage_resref = EVAL ~%cbr_em_courage_resref%~
    hope_resref = EVAL ~%cbr_em_hope_resref%~
    fear_resref = EVAL ~%cbr_em_fear_resref%~
    horror_resref = EVAL ~%cbr_em_horror_resref%~
    innate_horror_resref = EVAL ~%cbr_em_innate_horror_resref%~
    hopelessness_resref = EVAL ~%cbr_em_hopeless_resref%~
    symbol_resref = EVAL ~%cbr_em_symbol_resref%~
END

// Reuse installed provider scrolls.  Standalone spells receive clean
// IWDification-style scrolls; the discovered donor names are retained only as
// distribution anchors when mirroring existing store rows below.
ACTION_IF (cbr_em_need_courage = 1) BEGIN
  COPY ~chriz-bg-rebalance/resources/emotion_iwdee/IDPRO407.PRO~ ~override/CBRCRGSC.ITM~
    LPF cbr_em_make_wizard_scroll
      INT_VAR name_strref = cbr_em_courage_name desc_strref = cbr_em_courage_desc
      STR_VAR spell_resref = EVAL ~%cbr_em_courage_resref%~
              icon_resref = EVAL ~%cbr_em_courage_resref%A~
    END
  OUTER_SPRINT $cbr_em_courage_scroll(~%cbr_em_courage_scroll_count%~) ~CBRCRGSC~
  OUTER_SET cbr_em_courage_scroll_count += 1
END
ACTION_IF (cbr_em_need_hope = 1) BEGIN
  COPY ~chriz-bg-rebalance/resources/emotion_iwdee/IDPRO407.PRO~ ~override/CBRHOPSC.ITM~
    LPF cbr_em_make_wizard_scroll
      INT_VAR name_strref = cbr_em_hope_name desc_strref = cbr_em_hope_desc
      STR_VAR spell_resref = EVAL ~%cbr_em_hope_resref%~
              icon_resref = EVAL ~%cbr_em_hope_resref%A~
    END
  OUTER_SPRINT $cbr_em_hope_scroll(~%cbr_em_hope_scroll_count%~) ~CBRHOPSC~
  OUTER_SET cbr_em_hope_scroll_count += 1
END

OUTER_FOR (cbr_em_scroll_i = 0; cbr_em_scroll_i < cbr_em_courage_scroll_count; ++cbr_em_scroll_i) BEGIN
  OUTER_SPRINT cbr_em_scroll_slot ~cbr_em_courage_scroll_%cbr_em_scroll_i%~
  OUTER_SPRINT cbr_em_scroll_resref EVAL ~%%cbr_em_scroll_slot%%~
  COPY_EXISTING ~%cbr_em_scroll_resref%.ITM~ ~override/%cbr_em_scroll_resref%.ITM~
    // Normalize both operational references as well as the two owned strings.
    READ_LONG 0x6a cbr_em_ts_effect_offset
    SET cbr_em_ts_effect_count = (BUFFER_LENGTH - cbr_em_ts_effect_offset) / 0x30
    FOR (cbr_em_ts_i = 0; cbr_em_ts_i < cbr_em_ts_effect_count; ++cbr_em_ts_i) BEGIN
      SET cbr_em_ts_fx = cbr_em_ts_effect_offset + cbr_em_ts_i * 0x30
      READ_SHORT cbr_em_ts_fx cbr_em_ts_opcode
      PATCH_IF (cbr_em_ts_opcode = 146 || cbr_em_ts_opcode = 147 || cbr_em_ts_opcode = 148) BEGIN
        READ_ASCII (cbr_em_ts_fx + 0x14) cbr_em_ts_resource (8) NULL
        PATCH_IF (~%cbr_em_ts_resource%~ STRING_EQUAL_CASE ~%cbr_em_courage_resref%~) BEGIN
          WRITE_ASCIIE (cbr_em_ts_fx + 0x14) ~%cbr_em_courage_resref%~ #8
        END
      END
    END
    LPF cbr_em_patch_scroll_text
      INT_VAR courage_name_strref = cbr_em_courage_name courage_desc_strref = cbr_em_courage_desc
              hope_name_strref = cbr_em_hope_name hope_desc_strref = cbr_em_hope_desc
      STR_VAR courage_resref = EVAL ~%cbr_em_courage_resref%~ hope_resref = EVAL ~%cbr_em_hope_resref%~
    END
  BUT_ONLY
END
OUTER_FOR (cbr_em_scroll_i = 0; cbr_em_scroll_i < cbr_em_hope_scroll_count; ++cbr_em_scroll_i) BEGIN
  OUTER_SPRINT cbr_em_scroll_slot ~cbr_em_hope_scroll_%cbr_em_scroll_i%~
  OUTER_SPRINT cbr_em_scroll_resref EVAL ~%%cbr_em_scroll_slot%%~
  COPY_EXISTING ~%cbr_em_scroll_resref%.ITM~ ~override/%cbr_em_scroll_resref%.ITM~
    READ_LONG 0x6a cbr_em_ts_effect_offset
    SET cbr_em_ts_effect_count = (BUFFER_LENGTH - cbr_em_ts_effect_offset) / 0x30
    FOR (cbr_em_ts_i = 0; cbr_em_ts_i < cbr_em_ts_effect_count; ++cbr_em_ts_i) BEGIN
      SET cbr_em_ts_fx = cbr_em_ts_effect_offset + cbr_em_ts_i * 0x30
      READ_SHORT cbr_em_ts_fx cbr_em_ts_opcode
      PATCH_IF (cbr_em_ts_opcode = 146 || cbr_em_ts_opcode = 147 || cbr_em_ts_opcode = 148) BEGIN
        READ_ASCII (cbr_em_ts_fx + 0x14) cbr_em_ts_resource (8) NULL
        PATCH_IF (~%cbr_em_ts_resource%~ STRING_EQUAL_CASE ~%cbr_em_hope_resref%~) BEGIN
          WRITE_ASCIIE (cbr_em_ts_fx + 0x14) ~%cbr_em_hope_resref%~ #8
        END
      END
    END
    LPF cbr_em_patch_scroll_text
      INT_VAR courage_name_strref = cbr_em_courage_name courage_desc_strref = cbr_em_courage_desc
              hope_name_strref = cbr_em_hope_name hope_desc_strref = cbr_em_hope_desc
      STR_VAR courage_resref = EVAL ~%cbr_em_courage_resref%~ hope_resref = EVAL ~%cbr_em_hope_resref%~
    END
  BUT_ONLY
END

// Mirror every donor-store entry, including duplicate rows and all raw stock,
// charge, flag, and expiry fields.  Reverse insertion preserves the original
// row indices while each downstream STO section offset is shifted exactly.
ACTION_IF (cbr_em_need_courage = 1 || cbr_em_need_hope = 1) BEGIN
  COPY_EXISTING_REGEXP GLOB ~^.*\.[sS][tT][oO]$~ ~override~
    PATCH_IF (BUFFER_LENGTH >= 0x9c) BEGIN
      READ_ASCII 0 cbr_em_st_signature (8)
      READ_LONG 0x34 cbr_em_st_sale_offset
      READ_LONG 0x38 cbr_em_st_sale_count
      SET cbr_em_st_sale_end = cbr_em_st_sale_offset + cbr_em_st_sale_count * 0x1c
      PATCH_IF (~%cbr_em_st_signature%~ STRING_EQUAL ~STORV1.0~
             && cbr_em_st_sale_offset >= 0x9c
             && cbr_em_st_sale_end <= BUFFER_LENGTH) BEGIN
        FOR (cbr_em_st_i = cbr_em_st_sale_count - 1; cbr_em_st_i >= 0; --cbr_em_st_i) BEGIN
          SET cbr_em_st_row = cbr_em_st_sale_offset + cbr_em_st_i * 0x1c
          READ_ASCII cbr_em_st_row cbr_em_st_item (8) NULL
          SPRINT cbr_em_st_output ~~
          PATCH_IF (cbr_em_need_courage = 1
                 && ~%cbr_em_st_item%~ STRING_EQUAL_CASE ~%cbr_em_enchanted_donor_scroll%~) BEGIN
            SPRINT cbr_em_st_output ~CBRCRGSC~
          END ELSE PATCH_IF (cbr_em_need_hope = 1
                          && ~%cbr_em_st_item%~ STRING_EQUAL_CASE ~%cbr_em_hopeless_donor_scroll%~) BEGIN
            SPRINT cbr_em_st_output ~CBRHOPSC~
          END
          PATCH_IF !(~%cbr_em_st_output%~ STR_EQ ~~) BEGIN
            SET cbr_em_st_insert = cbr_em_st_row + 0x1c
            SET cbr_em_st_already = 0
            PATCH_IF (cbr_em_st_i + 1 < cbr_em_st_sale_count) BEGIN
              READ_ASCII cbr_em_st_insert cbr_em_st_next (8) NULL
              PATCH_IF (~%cbr_em_st_next%~ STRING_EQUAL_CASE ~%cbr_em_st_output%~) BEGIN
                SET cbr_em_st_already = 1
              END
            END
            PATCH_IF (cbr_em_st_already = 0) BEGIN
              INSERT_BYTES cbr_em_st_insert 0x1c
              WRITE_ASCIIE cbr_em_st_insert ~%cbr_em_st_output%~ #8
              FOR (cbr_em_st_b = 0; cbr_em_st_b < 0x14; ++cbr_em_st_b) BEGIN
                READ_BYTE (cbr_em_st_row + 0x08 + cbr_em_st_b) cbr_em_st_value
                WRITE_BYTE (cbr_em_st_insert + 0x08 + cbr_em_st_b) cbr_em_st_value
              END
              SET cbr_em_st_sale_count += 1
              WRITE_LONG 0x38 cbr_em_st_sale_count
              READ_LONG 0x2c cbr_em_st_section
              PATCH_IF (cbr_em_st_section >= cbr_em_st_insert) BEGIN
                WRITE_LONG 0x2c (cbr_em_st_section + 0x1c)
              END
              READ_LONG 0x4c cbr_em_st_section
              PATCH_IF (cbr_em_st_section >= cbr_em_st_insert) BEGIN
                WRITE_LONG 0x4c (cbr_em_st_section + 0x1c)
              END
              READ_LONG 0x70 cbr_em_st_section
              PATCH_IF (cbr_em_st_section >= cbr_em_st_insert) BEGIN
                WRITE_LONG 0x70 (cbr_em_st_section + 0x1c)
              END
            END
          END
        END
      END
    END
    BUT_ONLY
END

// ============================================================
// Class and kit revisions (400-499)
// ============================================================

BEGIN @400
DESIGNATED 400
GROUP @1400
LABEL ~cbr_cleric_tempus_weapon_training~

REQUIRE_PREDICATE (GAME_IS ~bg2ee eet~) @9410
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~WEAPPROF.2DA~) @9411
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~OHTEMPUS.2DA~) @9412
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~C0PR#C4.SPL~) @9413
REQUIRE_PREDICATE ((FILE_EXISTS_IN_GAME ~C0PR#90.SPL~)
               AND (FILE_EXISTS_IN_GAME ~C0PR#92.SPL~)
               AND (FILE_EXISTS_IN_GAME ~C0PR#103.SPL~)) @9414
REQUIRE_PREDICATE (FILE_EXISTS_IN_GAME ~SPLPROT.2DA~) @9415
// Artisan's custom permission stat for longswords must exist in the live
// STATS.IDS; the resolved value parameterizes the migration helper's gate.
REQUIRE_PREDICATE ((IDS_OF_SYMBOL (~stats~ ~C0_PROFICIENCYLONGSWORD~) > 0)
               AND (IDS_OF_SYMBOL (~stats~ ~C0_PROFICIENCYLONGSWORD~) < 65536)) @9416

OUTER_SET cbr_wt_resolved_ls_perm_stat = IDS_OF_SYMBOL (~stats~ ~C0_PROFICIENCYLONGSWORD~)

// Materialize the three file-backed inputs at their canonical override
// paths (same transactional pattern as the Holy Power components).
COPY_EXISTING ~WEAPPROF.2DA~ ~override/WEAPPROF.2DA~
COPY_EXISTING ~C0PR#C4.SPL~ ~override/C0PR#C4.SPL~
COPY_EXISTING ~SPLPROT.2DA~ ~override/SPLPROT.2DA~

LAF cbr_apply_tempus_weapon_training
  INT_VAR ls_perm_stat = cbr_wt_resolved_ls_perm_stat
  STR_VAR resource_dir = ~override~
END

